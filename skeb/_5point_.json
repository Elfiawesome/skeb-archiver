r=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa8f7814412cc8d0a18909a78f0f7b78 2x, https://si.imgix.net/26a5fc0f/uploads/origins/cb4be1e9-7e97-474c-93a8-f98527d632c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d1a0ac2a2787ae696f9b6a9914ec735b 3x"}, "body": "こんにちは！ホームページであなたの絵を見て、すぐにそのスタイルに惚れました！\n私のオリジナルキャラクターを描いていただけたらとても嬉しいです。\n- 性格は、元気で、のんきで、いつも満面の笑みを浮かべていて、歌が大好きです。\n- 目は瞳孔が星の形をしていて、光ることができる。\n- 腕は丸く球根状で、透明な硬質プラスチックでできており、中にコンピューターの部品が見える。\n- 胴体は溶岩ランプだが、足は水槽で、中にはカラフルな熱帯魚が泳いでいる。似ているように見えますが、別物です\n- 可能であれば、背景が透明なバージョンもお願いします。\n- より詳細な仕様については、Google Driveのリンク先のメインフォルダ内の画像をご覧ください。\n\n設定やコストの調整が必要な場合は、再送信してください！\n一緒に仕事ができることをとても楽しみにしています。私の依頼を検討していただき、ありがとうございます！\n\nhttps://drive.google.com/drive/folders/1fZbq46i_Wam7fr3CmCmpPfbZHlOxWVwH?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_5point_/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3634677, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a5ee5de/uploads/origins/1b6a42cb-2105-435a-8b4b-964c5c4cc341?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74b744479f9ad54130916498c571a614", "srcset": "https://si.imgix.net/5a5ee5de/uploads/origins/1b6a42cb-2105-435a-8b4b-964c5c4cc341?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74b744479f9ad54130916498c571a614, https://si.imgix.net/5a5ee5de/uploads/origins/1b6a42cb-2105-435a-8b4b-964c5c4cc341?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ac2254237b610b58624b58315a61ac1 2x, https://si.imgix.net/5a5ee5de/uploads/origins/1b6a42cb-2105-435a-8b4b-964c5c4cc341?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=124aa72aee6468408dcb1db55399f6e1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a5e