44-b5f3-6d7ee78c614c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6c059ce28ed538c549d9ffed2ebcfb1", "src_set": ""}, "body": "こんにちは、はじめまして。あなたのアートスタイルが好きで、作品をお願いしたいのですが。\n\n彼女は時間をテーマにした、謎めいた、しかしウィットに富んだ女の子です。左目が時崎くるみのような時計に似ています。顔立ちは色白。髪は漆黒で手入れが行き届いており、右目は赤、時計の目は黄色。\n\n服の色は黒と白で、肌はあまり見せない。胸は平ら。\n\n今後ともよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1q3eC-pO6m3LSZ9o1I6TYnsFEQGDb5Y5x?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@all000_16/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2553189, "client_id": 2486459, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23f64060/uploads/origins/dcbfdbd4-6610-4488-85b6-71b2a65aa6e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5398787d33013e37a098bb7d65783eae", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23f64060/uploads/origins/dcbfdbd4-6610-4488-85b6-71b2a65aa6e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05e924cbd078d3fd1cf06cc6bb72f6e6", "src_set": ""}, "body": "こんにちは！あなたの作品はとても美しいので、ぜひリクエストを送りたいです！\n\n私のOC、Braeを描いてください。彼女は音楽をテーマにしたストイックな半妖の魔法少女です。彼女は魔法のハルバードを魔法の杖と近接武器の両方として使っています。\n\n彼女の描き方は自由。人間の姿でも、悪魔の姿でも。\n\n備考\n- 歳（成人）\n- 180.3cm\n- 顔色は青白い（悪魔の姿になると、肌の彩度が落ちて灰色になる）。\n- 胸が小さい。\n- 笑って感情を表現することができないので、いつも無表情。\n- 後光は重要なディテール！\n- バイオリンはオプション\n- ハルバードはオプション。\n\nご検討ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1A3b3JkL3nkuLO-NjrQYgw_yO8IkFwVfd?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1645985, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "おのこ/wonoko", "screen_name": "wonokokko", "avatar_url": "https://pbs.twimg.com/profile_images/1838018307301285888/H