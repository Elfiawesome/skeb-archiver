top&w=200&h=200&s=d127b6075d1ef3e8b6aa486e087074d4 2x, https://si.imgix.net/5271c17f/uploads/origins/82b4869a-3210-45ed-acc8-a1bb1bd52a26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a9ff9c92d820691727616f35b8c9d07a 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5271c17f/uploads/origins/82b4869a-3210-45ed-acc8-a1bb1bd52a26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de56a4d5e3173fe4f26fd49c72f84271", "srcset": "https://si.imgix.net/5271c17f/uploads/origins/82b4869a-3210-45ed-acc8-a1bb1bd52a26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de56a4d5e3173fe4f26fd49c72f84271, https://si.imgix.net/5271c17f/uploads/origins/82b4869a-3210-45ed-acc8-a1bb1bd52a26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=531eecaa7364838cab31235ce91c3d2d 2x, https://si.imgix.net/5271c17f/uploads/origins/82b4869a-3210-45ed-acc8-a1bb1bd52a26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2f1d6ae794a046200081cd8ea8b39df5 3x"}, "body": "オリジナルで包茎ふたなり女騎士パーティーが触手に搾精されているシチュをお願いします。\n\n触手に捕まった女騎士パーティーが金玉を口型触手にしゃぶられながら色んな責め方をされているような感じで、下記のような感じで搾精している触手が卵袋に繋がっていて、吸い出した精液で卵を受精させているような描写をお願いします。\n・皮を引っ張って広げられ、露わにされた亀頭に搾精触手が覆いかぶさっている\n・搾精触手に皮の中に入られてしまい、搾精触手を皮が覆っている状態になっている。\n\n上記の触手とは別の種類の触手がいて、下記のような責めを受けているふたなり娘もお願いします。\n・皮が余りまくっている巨根チンポの皮の中に複数個の小さな卵を産み付けられていて、皮の先を縛られた状態で竿を扱かれて射精させられ、膨らんでいる皮風船の中で受精カットインが幾つも入っている", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nums_futagirl/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1060290, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f360c71c/uploads/origins/533b5ae1-99b4-4f96-b017-e27088c1ac5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aebbfcf22d3903f5a9b2e5d5bc30dd53", "srcset": "https://si.imgix.net/f360c71c/uploads/origins/533b5ae1-99b4-4f96-b017-e27088c1ac5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aebbfcf22d3903f5a9b2e5d5bc30dd53, https://si.imgix.net/f360c71c/uploads/origins/533b5ae1-99b4-4f96-b017-e27088c1ac5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae2ea69ac34484f67197cd557cb28c39 2x, https://si.imgix.net/f360c71c/uploads/origins/533b5ae1-99b4-4f96-b017-e27088c1ac5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5d3dbc2a2abd31ff3c20974c6a8e2b1 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f360c71c/uploads/origins/533b5ae1-99b4-4f96-b017-e27088c1ac5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9dbd8bf79ed924a98e5c3c54062f0c0", "srcset": "https://si.imgix.net/f360c71c/uploads/origins/533b5ae1-99b4-4f96-b017-e27088c1ac5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9dbd8bf79ed924a98e5c3c54062f0c0, https://si.imgix.net/f360c71c/uploads/origins/533b5ae1-99b4-4f96-b017-e27088c1ac5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a968fd23a827f7e70377b3fe06879224 2x, https://si.imgix.net/f360c71c/uploads/origins/533b5ae1-99b4-4f96-b017-e27088c1ac5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e7263b91e92976bbf6190afa52b5181e 3x"}, "body": "初めまして。skebの新着でイラストをお見かけして、魅力的なイラストを多くお描きになられていたので、ぜひにと思いリクエストに伺いました。\n\nお願いしたいのは、名無双描さんのオリキャラ・いくみんこといくみちゃんのイラストで、いくみんが牛柄ビキニ姿でいろんなミルクを飲まれてしまうシチュエーションで描いていただきたいです。\n\n【詳細】\n\n・牛柄ビキニ姿のいくみんが、「私のおっぱいみるくとおちんぽみるく、いっぱい飲んでほしいな」とおねだりしている\n\n・まずはいくみんのおっぱいみるくをちゅーちゅーゴキュゴキュ飲みまくる(ここでビキニをずらすか脱がすかして、胸を露出してほしいです)。気持ち良さそうないくみん\n\n・しばらくして、「おっぱいだけじゃなくて、こっち(おちんぽ)のみるくも飲んで♡」とちんまりおちんちんを露出\n\n・いくみんのちんまりおちんちんを丸ごと口に入れ、じゅばじゅばしゃぶっておちんぽみるくを飲みまくる\n\n・ひとしきり(30分くらい？)ミルクを飲まれた後も、まだまだ飲んで欲しそうないくみん。「もういいの？まだ飲み足りないでしょ？おっぱいもおちんぽも、私のミルク…全部飲み尽くして♡」\n\n\n一枚のイラストに差分でセリフ等を入れる形での描写か、漫画形式での描写にするかはお任せします。また、牛柄ビキニのデザインもお任せします。\n相手の描写は最低限で、顔などもしっかり描かなくて良いです。\nいくみんのセリフは、上記の通りでなくても良いので、(流れはこのまま)多少アレンジしていただいても構いません。\n母乳や精液の量は多めでお願いします。\n\nお忙しいところ細かいリクエストで恐縮ですが、ご検討いただきますようよろしくお願い申し上げます。", "nc": 34, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nums_futagirl/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1060290, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5e2d635c/uploads/origins/59a7880f-79db-46dc-b1a4-951f28a7d1f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a6c1b9e1e571fa4a9d9181a912e40ef", "srcset": "https://si.imgix.net/5e2d635c/uploads/origins/59a7880f-79db-46dc-b1a4-951f28a7d1f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a6c1b9e1e571fa4a9d9181a912e40ef, https://si.imgix.net/5e2d635c/uploads/origins/59a7880f-79db-46dc-b1a4-951f28a7d1f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=828fd9c93f3152c8f47ceb3868367fbd 2x, https://si.imgix.net/5e2d635c/uploads/origins/59a7880f-79db-46dc-b1a4-951f28a7d1f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be61312d23fa5edf4ba291c37f19c9e8 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5e2d635c/uploads/origins/59a7880f-79db-46dc-b1a4-951f28a7d1f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf61aed023f8743faf633f956f83bddb", "srcset": "https://si.imgix.net/5e2d635c/uploads/origins/59a7880f-79db-46dc-b1a4-951f28a7d1f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf61aed023f8743faf633f956f83bddb, https://si.imgix.net/5e2d635c/uploads/origins/59a7880f-79db-46dc-b1a4-951f28a7d1f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6848aae942c1c653110db39a53ab30cb 2x, https://si.imgix.net/5e2d635c/uploads/origins/59a7880f-79db-46dc-b1a4-951f28a7d1f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b48db061e4358254dabdbe62ff2d1bd8 3x"}, "body": "初めまして。\npixivに初投稿されていたふたなり漫画やふたなりッコ測定中（1，2）が私的に最高でした。\nあのような雰囲気とノリの漫画を描いて頂けないでしょうか？\nページ数の指定はありません。\nテーマとストーリーは以下の通りです。\n\n『ふたなり保健委員VS悪ガキ男の娘』\nふたなりッコ測定中に出てきたメガネ＆おさげの保健委員（体操服ブルマ姿）は小学生の男の娘学級の身体測定を行います。\n教室に入ると悪ガキ男の娘二人（男の娘たちもブルマ姿）に胸をもむ＆ブルマの上からおちんちんをシコシコという悪戯を受けてしまい、ブルマの先が我慢汁で濡れてしまいます。\n男の娘たちに「わーい、おもらしだ！」と笑われたお姉さんはお仕置きを決行。\nイタズラをした二人のブルマの中に手を入れ中でおちんちんの皮を剥いてしまいます。\n（なぜか全員ノーパンブルマという設定でお願いします）\nイタズラっ子はむき出しの亀頭がブルマに擦れてもう足がガクガクです。\n「お姉さん、ごめんなさい！」「もう悪いことしないから許して！」と謝りますが保健委員さんは許してあげずにブルマの上から二人のおちんちんをしごきます。\n男の娘二人はブルマの中に射精。\nお姉さんは「あら？ブルマの中に漏らしちゃったの？」と仕返しをします。\n周りを見るとクラスの男の娘たちはみんなお仕置きの様子を見て勃起しています。\n保健委員さんはクラスの男の娘たちもついでに精通させてあげます。\n（ここのシーンは今までのふたなり漫画のようなカオスを期待してます）\n\n条件等に問題があればまた修正して再送させて頂きます。\n無理でなければどうか宜しくお願い致します。", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nums_futagirl/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1060290, "client_id": 2738577, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f6e9a65/uploads/origins/201c8de7-f807-425b-893e-ec99b70c3299?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=138336d66dc0e4c7b9b984a38e8ac0df", "srcset": "https://si.imgix.net/3f6e9a65/uploads/origins/201c8de7-f807-425b-893e-ec99b70c3299?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=138336d66dc0e4c7b9b984a38e8ac0df, https://si.imgix.net/3f6e9a65/uploads/origins/201c8de7-f807-425b-893e-ec99b70c3299?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df291f17c339961e3be80c456ff823cb 2x, https://si.imgix.net/3f6e9a65/uploads/origins/201c8de7-f807-425b-893e-ec99b70c3299?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ef454ff7d200eb4fe6de257404939388 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f6e9a65/uploads/origins/201c8de7-f807-425b-893e-ec99b70c3299?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db5dff622de0ffb9f3f644de8bd422c9", "srcset": "https://si.imgix.net/3f6e9a65/uploads/origins/201c8de7-f807-425b-893e-ec99b70c3299?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db5dff622de0ffb9f3f644de8bd422c9, https://si.imgix.net/3f6e9a65/uploads/origins/201c8de7-f807-425b-893e-ec99b70c3299?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9119a7bdbd4a7fc7394e8f83abb7c7a5 2x, https://si.imgix.net/3f6e9a65/uploads/origins/201c8de7-f807-425b-893e-ec99b70c3299?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dff6f426d69bf54d83ba34905a37e81c 3x"}, "body": "こんにちは！\n今回は、私の書いている小説の表紙絵を依頼させて頂ければと思い、リクエストさせて頂きました！\n小説のURLは資料URLに載せておきます。\n\nこちらの小説の主人公のみずきとゆうを書いていただきたいです。\n\nどちらも裸で、構図はとまどった表情のゆうに、みずきが後ろから勢いよく抱き着く、といった構図に\nして頂ければと思います。\nまた、右上か左上にタイトルを入れたいと思っているので、あけておいて頂ければと思います。\n\nまた、お手数ではありますが、キャラクターの詳細なデザインについてもお願いしたいと思っています。\n各人物の設定については下記の通りになります。\n\n・ゆう\n　・メインカラー\n　　　青から緑色のどこかにしたいと思っています。（みずきのカラーとの補色にしたいです。）\n　・髪\n　　　色はメインカラーに合わせたいと思っています。\n　　　髪質はふわふわで、髪の長さはボブ～セミロングあたりのどこかかなというイメージです。\n　・肌色\n　　　室内にいることが多いので肌白\n　・体つき\n　　　華奢よりの一般的な体形\n・みずき\n　・メインカラー\n　　　赤からピンクのどこかにしたいと思っています。（ゆうのカラーとの補色にしたいです。）\n　　　メインカラー色の伊達眼鏡とリボンをつけています。\n　　　リボンは紐タイプのものにしてください。（小説中でゆうを縛るというシーンがあるため……）\n　・髪\n　　　色はメインカラーに合わせたいと思っています。\n　　　髪質はつやつやさらさら？で、髪の長さはロングにしたいです。\n　・肌色\n　　　営業職でよく外にいるので、ゆうより濃い肌色\n　・体つき\n　　　ややグラマラスな体形\n\nお忙しいとは思いますが、もし宜しければ、よろしくお願いいたします。\n\nhttps://www.pixiv.net/novel/show.php?id=20020616", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {