.net/114e92f0/uploads/origins/4f31317f-027c-4175-8432-75f8a053585b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5eb4ee25f15cae9a41f56f8290c406ff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/114e92f0/uploads/origins/4f31317f-027c-4175-8432-75f8a053585b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6421f137d8a4f91644dd9a7be3826e5", "srcset": "https://si.imgix.net/114e92f0/uploads/origins/4f31317f-027c-4175-8432-75f8a053585b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6421f137d8a4f91644dd9a7be3826e5, https://si.imgix.net/114e92f0/uploads/origins/4f31317f-027c-4175-8432-75f8a053585b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f0493608e6e626eafb73ac568710d66d 2x, https://si.imgix.net/114e92f0/uploads/origins/4f31317f-027c-4175-8432-75f8a053585b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=498f8e4905e515ae2589e254964b9538 3x"}, "body": "初めまして。個人でVtuber活動をしている、恋小華れるといいます。\nたかはた風嘉様の描くリクエストイラストがとても可愛く、またイラストの雰囲気や色使いがとても好みだったので、私のこともぜひ描いて欲しい！と思いリクエストさせていただきました。\n\n\n【描いて欲しいシチュエーション】\n朝の学校で気になる女の子(私)と挨拶を交わしているシーン\n私＝学級委員長(優等生)という設定\n\n\n【構図について】\n構図は基本的におまかせさせていただきます。\n衣装はデフォルトの物で大丈夫ですが、髪型を鬼滅の刃の甘露寺蜜璃ちゃんの用にアレンジしていただきたいです。また、優等生らしくメガネをかけてみたいです。\n重ねてのお願いになりますが、サムネイルや配信上で使用する都合上、髪の毛と衣装、身体(指先等)が見切れない様にしていただきたいです。\n\n\n【恋小華れるについて】\n魔法界で魔法学校に通う学生魔法使いで、人間界の事を勉強する授業の一環でVtuberとして配信しています。ピンクのツインテールと胸の魔宝石(マジックギア)、髪を縛るリボンがトレンドマークです。性格は普段は丁寧でお淑やかですが、熱が入ると性格が変わることもしばしばあります。\n\n\n【使用用途】\nYouTubeサムネイル、X、動画内での使用。\nまた将来的に収益化した際も使えると嬉しいです。\n(サムネイルでは雑談配信、X等ではタグ等のイラストとして使用する予定です。)\nまた売上の発生しないネットプリント等でも使用させていただきたいです。\n使用不可の用途がございましたら別レイヤーに記載していただけると助かります。\n\n【参考資料】\n資料はURLに添付しておりますので、ご確認をお願いします。\n\n最後になりますが、可能でしたらお手数ではありますがPSDデータにてレイヤー別にしていただけると大変助かります。\nぜひ前向きなご検討をよろしくお願いいたします。\n\nhttps://x.com/rerukoikoga/status/1775148142994010557?s=46", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takahata_fuuka/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 8910, "client_id": 2190184, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e7784340/uploads/origins/c406c023-f83e-4de1-8888-bb488daca0c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64d8454d1787908d776507231602755f", "srcset": "https://si.imgix.net/e7784340/uploads/origins/c406c023-f83e-4de1-8888-bb488daca0c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64d8454d1787908d776507231602755f, https://si.imgix.net/e7784340/uploads/origins/c406c023-f83e-4de1-8888-bb488daca0c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce7ce1258226de2f605cc6fa5c008d67 2x, https://si.imgix.net/e7784340/uploads/origins/c406c023-f83e-4de1-8888-bb488daca0c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14f23288f39343793e42a5cbfe68990d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e7784340/uploads/origins/c406c023-f83e-4de1-8888-bb488daca0c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a45a38ca431894022da97e40b2b4e85b", "srcset": "https://si.imgix.net/e7784340/uploads/origins/c406c023-f83e-4de1-8888-bb488daca0c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a45a38ca431894022da97e40b2b4e85b, https://si.imgix.net/e7784340/uploads/origins/c406c023-f83e-4de1-8888-bb488daca0c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07a46e0d6bbf9de168d7ab8b81a05efc 2x, https://si.imgix.net/e7784340/uploads/origins/c406c023-f83e-4de1-8888-bb488daca0c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=31744228