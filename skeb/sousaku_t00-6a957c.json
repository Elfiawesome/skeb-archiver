ております、鈴とろと申します。\nxにて先生のイラストを拝見し、ぜひ描いていただけたらと思いリクエストさせていただきました。\n髪型やデザインなど基本的に先生に全てお任せしたいです。\nただスズランを使って頂けたらとても嬉しいです。（あくまで希望ですので採用されずつとも構いません）\n\n⚫️使用用途\ntwitchやx等のアイコン、配信関連、個人鑑賞用\n（ただいま配信活動はps5で行っておりpcではございませんが、将来的にサムネ等に使用する可能性もございます）\n物品等の利用や再配布はいたしません。\n\n不慣れにて不備や失礼等ございましたら申し訳ありません。\n機会がございましたら、どうぞ宜しくお願いいたします。\n\nhttps://drive.google.com/file/d/1UBMg8XruX4NknPdz6gs4bykauEU72D7R/view?usp=drivesdk", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sousaku_t00/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4106007, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/18f2bb87/uploads/origins/3a6fce72-e436-44ba-a81a-36221efea693?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=455b3f591d68e9273480c08192b1ff8e", "srcset": "https://si.imgix.net/18f2bb87/uploads/origins/3a6fce72-e436-44ba-a81a-36221efea693?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=455b3f591d68e9273480c08192b1ff8e, https://si.imgix.net/18f2bb87/uploads/origins/3a6fce72-e436-44ba-a81a-36221efea693?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ca4479f1e50bd75c1e59264a3d728a6 2x, https://si.imgix.net/18f2bb87/uploads/origins/3a6fce72-e436-44ba-a81a-36221efea693?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f0d5feaef840178e82ac794f95fb26d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/18f2bb87/uploads/origins/3a6fce72-e436-44ba-a81a-36221efea693?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48fdd43a9cdd9b5a21269e070188cff4", "srcset": "https://si.imgix.net/18f2bb87/uploads/origins/3a6fce72-e436-44ba-a81a-36221efea693?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48fdd43a9cdd9b5a21269e070188cff4, https://si.img