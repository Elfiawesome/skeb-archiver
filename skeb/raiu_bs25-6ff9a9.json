si.imgix.net/79428b70/uploads/origins/d8dd619e-92c3-42c1-82fa-151fd67599cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8dd204ba32b6764c8016e6f79a7b9a45, https://si.imgix.net/79428b70/uploads/origins/d8dd619e-92c3-42c1-82fa-151fd67599cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a88fc3531aa8cc9e6bb87a1fe6e1b945 2x, https://si.imgix.net/79428b70/uploads/origins/d8dd619e-92c3-42c1-82fa-151fd67599cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=23000db8ec02c1f8d8d22cfbd7df7876 3x"}, "body": "こんにちは！もう一つリクエストしてもいいですか？『ビーストウォーズ』のランページと、私の人物オリジナルキャラクター（OC）をまた描いてほしいです。\n\nテーマは水中にしてください。OCが溺れているところをランページが助けるという設定です。二人は敵対関係ですが、ランページはこんな形でOCを失いたくないと思っています。描く際は、お好きなようにシンプルに仕上げてください！\n\nオリジナルキャラ＋ランページ：https://x.com/raiu_bs25/status/2053169854673543382?s=20\nオリジナルキャラ＋ランページ：https://x.com/mouseycometz/status/2051685727109325280?s=20\n\nhttps://x.com/raiu_bs25/status/2053169854673543382?s=20", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@raiu_bs25/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2808391, "client_id": 3575409, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/19ab36f1/uploads/origins/7b0c8918-5845-4f5c-ae1a-f7f7efb3dc47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6386d396dd537ed89386b5195a51c9e4", "srcset": "https://si.imgix.net/19ab36f1/uploads/origins/7b0c8918-5845-4f5c-ae1a-f7f7efb3dc47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6386d396dd537ed89386b5195a51c9e4, https://si.imgix.net/19ab36f1/uploads/origins/7b0c8918-5845-4f5c-ae1a-f7f7efb3dc47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b03d89d53f4e4cf2f084ce6d57f7a0d 2x, https://si.imgix.net/19ab36f1/uploads/origins/7b0c8918-5845-4f5c-ae1a-f7f7efb3dc47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71ec105f5cf8909cd4c19d237abaf4dc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/19ab36f1/uploads/origins/7b0c8918-5845-4f5c-ae1a-f7f7efb3dc47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48c421520a90547f47bd59ef42844761", "srcset": "https://si.imgix.net/19ab36f1/uploads/origins/7b0c8918-5845-4f5c-ae1a-f7f7efb3dc47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48c421520a90547f47bd59ef42844761, https://si.imgix.net/19ab36f1/uploads/origins/7b0c8918-5845-4f5c-ae1a-f7f7efb3dc47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6eb51f702daf879767979c404f246248 2x, https://si.imgix.net/19ab36f1/uploads/origins/7b0c8918-5845-4f5c-ae1a-f7f7efb3dc47?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=38251c8352e2942e4e471d62777b1443 3x"}, "body": "こんにちは！あなたの作品が大好きです！私のオリジナルキャラクター（OC）を、『ビーストウォーズ』のランページと一緒に描いていただけませんか？彼女の名前はソルです！\n\nOCは緑色の目をした大人の女性で、小柄で胸も小さいです。このイラストでは、OCは黒いスーツを着ていて、ショートヘアです。画像を以下に添付しました。 ショートヘアで全身黒のスーツ姿で描いていただきたいので、最後の参考画像は無視していただいて構いません。あくまで参考として、より完成度の高いイメージを掴むためのものです！\n\nランページとOCの間には面白い関係性があります。ランページはOCをからかったり、一緒に遊んだりするのが大好きです。 OCは恥ずかしがり屋ですが、ランページには興味を持っています。イラストでは、OCが彼の胸の上に座っている様子を描いていただけますか？OCは照れくさそうな表情を浮かべ、ランページは彼女の度胸を面白がっている様子です。\n\nOC（参考画像＋ランページ） - https://x.com/mouseycometz/status/2051685727109325280?s=20\nOC（参考画像＋ショートヘア＋黒の衣装） - https://x.com/mouseycometz/status/2052201544402018583?s=20\nOC（追加参考画像） - https://x.com/mouseycometz/status/2005259769104457890?s=20\n\nありがとうございます！\n\nhttps://x.com/mouseycometz/status/2052201544402018583?s=20", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@raiu_bs25/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 280839