ンスにあるようなものを着てほしいです。ゼノスは黒、白、ワインレッド、ゴールドなどのダークカラー、私のキャラはパステルパープル（瞳の色）などソフトなカラーをチョイスしています。  \n\nまた、背景のバナーにはガレマール帝国の徽章を入れてください。必要であれば、変更・調整も歓迎します。ご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1X0-Xde33QDGGzTiHOfkzTKAY49StL_nw?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lira_1224/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1514885, "client_id": 1870399, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb8f5b63/uploads/origins/2fa2feaa-5545-4e01-8059-968cf2eb99fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c9d35e6087d567fb8d0214c24d1e7eb", "srcset": "https://si.imgix.net/eb8f5b63/uploads/origins/2fa2feaa-5545-4e01-8059-968cf2eb99fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c9d35e6087d567fb8d0214c24d1e7eb, https://si.imgix.net/eb8f5b63/uploads/origins/2fa2feaa-5545-4e01-8059-968cf2eb99fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9cede5e68c3df985883022b0f27f9d1f 2x, https://si.imgix.net/eb8f5b63/uploads/origins/2fa2feaa-5545-4e01-8059-968cf2eb99fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac14e929f0b019e8c5cd6023d0a3dac1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb8f5b63/uploads/origins/2fa2feaa-5545-4e01-8059-968cf2eb99fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d50b79629eabf41865295e6d5155caa5", "srcset": "https://si.imgix.net/eb8f5b63/uploads/origins/2fa2feaa-5545-4e01-8059-968cf2eb99fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d50b79629eabf41865295e6d5155caa5, https://si.imgix.net/eb8f5b63/uploads/origins/2fa2feaa-5545-4e01-8059-968cf2eb99fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=t