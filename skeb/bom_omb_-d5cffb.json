44-970bd25107ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=738c84bb7875d4b64e96ba5fe331d6a2", "srcset": "https://si.imgix.net/5581200a/uploads/origins/46bc6777-82ac-4966-a044-970bd25107ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=738c84bb7875d4b64e96ba5fe331d6a2, https://si.imgix.net/5581200a/uploads/origins/46bc6777-82ac-4966-a044-970bd25107ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38609321fdf05c68a3f6e415ac13f3f9 2x, https://si.imgix.net/5581200a/uploads/origins/46bc6777-82ac-4966-a044-970bd25107ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a41e83d64bc6b4bfe3ef9e0733967e5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5581200a/uploads/origins/46bc6777-82ac-4966-a044-970bd25107ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7321bea8cd3e4ab462cee8ab6eabc960", "srcset": "https://si.imgix.net/5581200a/uploads/origins/46bc6777-82ac-4966-a044-970bd25107ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7321bea8cd3e4ab462cee8ab6eabc960, https://si.imgix.net/5581200a/uploads/origins/46bc6777-82ac-4966-a044-970bd25107ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9de2eef180d23060c5f4103ca6e3b872 2x, https://si.imgix.net/5581200a/uploads/origins/46bc6777-82ac-4966-a044-970bd25107ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cd33d4b30c6673ca5738ba8c51aaa73f 3x"}, "body": "いつもお世話になっております！\nイラスト形式のリクエストを再送させていただきます。\n\n\n【キャラ】\n最上静香、北沢志保\n\n【構図】\n静香の主観視点の正常位\n※資料URLをご参照ください。そちらの両手を握っている部分を両手首を掴むように変えていただけますと幸いです\n\n\n【展開】\n①レッスン後の着替え中に、下着姿の志保を押し倒してずらし挿入する静香。静香はそのがっつきっぷりをからかわれるも、志保もすんなり挿入るくらい濡れていたと言い返す\n\n②ピストンを開始するも静香は早漏のため早速1発目を出してしまう。志保は顔色一つ変えずに静香を煽り散らかす\n\n③静香はその煽りに乗ってピストン再開。いつもは1発出したらもう終わりだったので志保は少し訝しむ\n\n④それから10分後。静香は既に5発出している。ここで静香は事前にスパークドリンクを飲んできていることを伝え、志保はそんなのズルじゃないと反発するも頬を紅潮させて余裕が無くなってきている\n\n⑤射精しても止まらない激しいピストンを受け続けて、志保はついに負けを認めて絶頂を宣言する。静香はそれを聞いて興奮しヒートアップ\n\n⑥静香のラストスパート。志保はイく時に表情を崩したくないと必死に堪えているが決壊寸前\n\n⑦静香は腰を奥まで突き入れて膣内射精。志保は必死の我慢も虚しく、直前までの歯を食いしばっていた顔が蕩けて脱力した顔で深く絶頂\n\n⑧事後。志保をイかせることができてご満悦の静香と、いつものように煽りたいもののがっつりイかされたことは事実のため上手く言い返せない志保\n\n\n【備考】\n・志保の下着につきましては、貴方様のこちらのイラストのイメージです。志保がする煽りなどもこのような感じでお願いします\nhttps://www.pixiv.net/artworks/130473770\n\n・セリフについてはほぼ全てお任せしますが、志保の絶頂の直前は「イくイくイぐ…っ　イ゛っ……くぅ……っ」、絶頂の際は「……お゛っ……❤︎❤︎❤︎」という感じで、大声で叫ぶというよりは思わず声が漏れてしまったみたいなイメージです\n\n\n以上です。ご検討のほど、よろしくお願いいたします！\n\nhttps://www.pixiv.net/artworks/109489454", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bom_omb_/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3491449, "client_id": 3736537, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d012453/uploads/origins/290a8da5-f1af-4aaa-be2a-c0aa89f67b89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5538dc3e51f1b34113e0a1c3608ea116", "srcset": "https://si.imgix.net/0d012453/uploads/origins/290a8da5-f1af-4aaa-be2a-c0aa89f67b89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5538dc3e51f1b34113e0a1c3608ea116, https://si.imgix.net/0d012453/uploads/origins/290a8da5-f1af-4aaa-be2a-c0aa89f67b89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b7e9c43ba93213b5af2fb3c410fd2d2 2x, https://si.imgix.net/0d012453/uploads/origins/290a8da5-f1af-4aaa-be2a-c0aa89f67b89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ee03dd46f96e7e48c0f2d05c415c02b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d012453/uploads/origins/290a8da5-f1af-4aaa-be2a-c0aa89f67b89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s