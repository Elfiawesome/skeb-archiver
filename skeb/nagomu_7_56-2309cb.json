/origins/5d4c6f12-efb0-4571-92c4-e8ac26aea804?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0b6115ca7aa79036a41cf530ab33f82, https://si.imgix.net/540e8fbc/uploads/origins/5d4c6f12-efb0-4571-92c4-e8ac26aea804?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ca08b6386145c3484583cb330da4edf 2x, https://si.imgix.net/540e8fbc/uploads/origins/5d4c6f12-efb0-4571-92c4-e8ac26aea804?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2070f0abf0878bb546d8518cc513402a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/540e8fbc/uploads/origins/5d4c6f12-efb0-4571-92c4-e8ac26aea804?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=098b48e789a27e4c9fc58f407aa11fdb", "srcset": "https://si.imgix.net/540e8fbc/uploads/origins/5d4c6f12-efb0-4571-92c4-e8ac26aea804?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=098b48e789a27e4c9fc58f407aa11fdb, https://si.imgix.net/540e8fbc/uploads/origins/5d4c6f12-efb0-4571-92c4-e8ac26aea804?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=517beb6a98c93d1aec79e4a20fdbfe26 2x, https://si.imgix.net/540e8fbc/uploads/origins/5d4c6f12-efb0-4571-92c4-e8ac26aea804?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f2352405d4916bc7d77c0edca01bc23d 3x"}, "body": "前回はアメスク立希ちゃんをありがとうございました。再度リクエストさせていただきます。\n\n○シチュエーション\n資料URLに貼った乳牛立希の続きのような、上半身までの差分イラスト(台詞・効果音あり)\n\n①\n・Xの左のイラスト(搾乳機をつけられている状態)のすぐ後。\n・手は頭の後で組んでいる。\n・搾乳される快楽を我慢しながら、後にいる男性(描写不要)を睨みながら悪態をついている\n\n②\n・後から男の手(手以外の描写は不要)が立希のスペンス乳腺を刺激し始める。\n・知らない快楽(スペンス乳腺)に抗い方も分からず、喘ぎ声が漏れ出てしまう。\n\n③\n・手を止めるように訴えるも、止めてもらえるはずもなくそのまま絶頂。さらに勢いよくミルクを乳射してしまう。\n※アヘ顔には｢しないでください｣。必死に絶頂しないよう我慢するも、堪えきれずにイってしまった感じでお願いします。\n\n○全体を通して\n・搾乳機の中の乳首は、元のイラストのように描写しないでください。\n・男の台詞は不要です。\n\n以上、よろしくお願いいたします。\n\nhttps://x.com/nagomu_7_56/status/2031370882799849952", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nagomu_7_56/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3391383, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f417d81/uploads/origins/05218cd8-963f-499b-9e5c-09f7940d3360?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63c2269f45d396568c10d53a0bb2fe90", "srcset": "https://si.imgix.net/8f417d81/uploads/origins/05218cd8-963f-499b-9e5c-09f7940d3360?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63c2269f45d396568c10d53a0bb2fe90, https://si.imgix.net/8f417d81/uploads/origins/05218cd8-963f-499b-9e5c-09f7940d3360?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5b5c85c8f5f9d9cb51b51739c30792d3 2x, https://si.imgix.net/8f417d81/uploads/origins/05218cd8-963f-499b-9e5c-09f7940d3360?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d70eba52c236673788e99c0b7e026f6a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f417d81/uploads/origins/05218cd8-963f-499b-9e5c-09f7940d3360?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89212b1e38ebae603bebdec44e11a14c", "srcset": "https://si.imgix.net/8f417d81/uploads/origins/05218cd8-963f-499b-9e5c-09f7940d3360?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89212b1e38ebae603bebdec44e11a14c, https://si.imgix.net/8f417d81/uploads/origins/05218cd8-963f-499b-9e5c-09f7940d3360?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f8cdeca6397c150b650c0e4beeb443a6 2x, https://si.imgix.net/8f417d81/uploads/origins/05218cd8-963f-499b-9e5c-09f7940d3360?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8daa142dd74afc585687a96026223bb4 3x"}, "body": "もし可能でしたら、椎名立希がミニスカポリス衣装を着せられた状態で緊縛監禁されローターで責められているイラストをお願いいたします。\n\n衣装：上半身は水色の半袖シャツタイプの警官服で、下半身は紺のタイトミニスカートと黒ストッキングを履いた状態(資料URLを参照)。はだけやスカートのめくれなどの脱衣は無しで、後述するローターは見えなくても大丈夫です。\n\n状況：https://www.pixiv.net/artworks/118123555と同じように上下を挟み込む胸縄ありの後ろ手縛り+脚を閉じて揃えた上で膝を折りたたまれた状態で縛られ床に横倒しにされている状態。口はガムテープで塞がれ、服の中では両乳首とクリトリスをローターで責められ、既に何度か絶頂しているというイメージで太もものあたりは愛液で濡れている状態でお願いいたします。表情は赤面した状態で涙を流しながらレイプ目でこちらを気丈に睨みつけているものでお願いいたします。くぐもった呻き声喘ぎ声や「フーッ……フーッ……」のような呼吸音、性感に体をよじらせているイメージで「ギシッ」のような縄が鳴っている効果音も書いていただけると嬉しいです。\n\n以上です。何卒ご検討よろしくお願いいたします。\n\nhttps://www.pixiv.net/artworks/122791726", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nagomu_7_56/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3391383, "client_id": 82839, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8eed5d6f/uploads/origins/f6786923-a30d-41fc-940c-5f258b5d1bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0a42d60eaf01e7ce60ba196f195e4c5", "srcset": "https://si.imgix.net/8eed5d6f/uploads/origins/f6786923-a30d-41fc-940c-5f258b5d1bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0a42d60eaf01e7ce60ba196f195e4c5, https://si.imgix.net/8eed5d6f/uploads/origins/f6786923-a30d-41fc-940c-5f258b5d1bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=17a327e7ded12119c6e55248a0cf8c57 2x, https://si.imgix.net/8eed5d6f/uploads/origins/f6786923-a30d-41fc-940c-5f258b5d1bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ecc4fc8299558b87a1d8df7418e9d52b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8eed5d6f/uploads/origins/f6786923-a30d-41fc-940c-5f258b5d1bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62baf3101f3667a4d03ba719df255b00", "srcset": "https://si.imgix.net/8eed5d6f/uploads/origins/f6786923-a30d-41fc-940c-5f258b5d1bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62baf3101f3667a4d03ba719df255b00, https://si.imgix.net/8eed5d6f/uploads/origins/f6786923-a30d-41fc-940c-5f258b5d1bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=036b7b3f4900e9489ca6d30eb9c42656 2x, https://si.imgix.net/8eed5d6f/uploads/origins/f6786923-a30d-41fc-940c-5f258b5d1bd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2bebc1e4cbea00ae2bc3129f20300256 3x"}, "body": "なごむ様、初めまして\nXにてブルアカイラストを描かれているのを拝見し、この度リクエストいたしました。\n以下リクエスト内容です。\n\nキャラクター：偽連邦生徒会長(ブルーアーカイブ)\n\nコスチューム：\nなごむ様が描かれた金長手袋+金ニーソックス+金ビキニスタイル(https://x.com/nagomu_7_56/status/2049963813555118424?s=46&t=HLREpzYaC7QiLr5yd12ZQg )\nをベースに、脚部のニーソックスは丈や質感をそのままにピッチリハイサイブーツとした物\n靴底は超厚底+背高ピンヒール(参考：https://item.rakuten.co.jp/sadisticaction/s0000000000000000000000000001745/ )\n金ピカ、艶テカ感マシマシでお願いします。\n\nシチュエーション：\n①\n姿勢は作中立ち絵のような佇まい、下半身はガニ股姿勢\nアングルも正面から全身絵でお願いします。\n凛とした表情\n股間は性液濡れで糸を引きながら性液がトロリと垂れる状態\n\n②\n余白に股間のアップをお願いいたします。\n参考：https://skeb.jp/@nagomu_7_56/works/3\n\n\n下記差分もお願いいたします。(①②に連動するようにお願いします)\n1.ドン引き引き攣り笑顔\n2.ビキニのトップス・ボトムス無し\n3.前穴ファック\n4.アナルファック\n5.両穴に使用済みコンドームが残り精液が垂れる様子\n6.前穴にバイブ、アナルに極太アナルパール挿入し、アナルからはアナルパールが尻尾のように長めにぶら下がっている状態\n7.両穴ともほぐされ、半端にポッカリ口を開け色んな液体が垂れている状態\n8.複数の使用済みコンドームを長手袋やハイサイブーツ、金ビキニへ挟んだり結んだりした状態\n\n笹役先生はチンポや手のみの描写で構いません。\nもし可能であればPSDデータでそれぞれ切替可能だと幸いです。(不可能であれば一任いたします)\n\n以上、何卒よろしくお願いいたします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nagomu_7_56/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3391383, "client_id": 571348, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c606cd1/uploads/origins/b340493d-44fb-4fdc-aa0e-355fe1ee0066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce15f7a4da7700d5f65105afd7eb1922", "srcset": "https://si.imgix.net/0c606cd1/uploads/origins/b340493d-44fb-4fdc-aa0e-355fe1ee0066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce15f7a4da7700d5f65105afd7eb1922, https://si.imgix.net/0c606cd1/uploads/origins/b340493d-44fb-4fdc-aa0e-355fe1ee0066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=766a6de7b43dc38c2b837d9d6c14525c 2x, https://si.imgix.net/0c606cd1/uploads/origins/b340493d-44fb-4fdc-aa0e-355fe1ee0066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=122f0b5aa5edbde97e6ab918c9ad4894 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c606cd1/uploads/origins/b340493d-44fb-4fdc-aa0e-355fe1ee0066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=daab849929f5ceb6f3a590da6e3f9244", "srcset": "https://si.imgix.net/0c606cd1/uploads/origins/b340493d-44fb-4fdc-aa0e-355fe1ee0066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=daab849929f5ceb6f3a590da6e3f9244, https://si.imgix.net/0c606cd1/uploads/origins/b340493d-44fb-4fdc-aa0e-355fe1ee0066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6f41beb9a7a9a6611b6a0cab2456e714 2x, https://si.imgix.net/0c606cd1/uploads/origins/b340493d-44fb-4fdc-aa0e-355fe1ee0066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1956424d918b193bdf44dc63d7ab00e8 3x"}, "body": "なごむ様、こんにちは。\n\n先日は納品いただき本当にありがとうございました。納品いただいたイラストが本当に本当に素敵で、その後の本番シーンは他の方に依頼しようと考えていたのですが、なごむ様のイラストで本番シーンを見たいと強く感じたため、ご依頼させていただきました。\n\n□キャラクター\n先日のリクエストと同じ私のOCです。参考URLも念の為記載しておきます。\n\n□外見等\n基本的には前回のリクエストと同じですが、念の為再掲します。\n・オッドアイとケモ耳は残してください。\n・おっぱいは以下イラストのように大きく垂れるような感じにしてください。\nhttps://www.pixiv.net/artworks/139716509\n・乳首の色は前回のイラストと同じ色でお願いします。\nhttps://skeb.jp/@nagomu_7_56/works/4\n・可能であれば以下イラストのような量で髪色と同じ色の陰毛を生やしてください。\nhttps://skeb.jp/@nagomu_7_56/works/3\n・服装は牛柄ビキニor全裸のどちらかでお願いします。\n\n□構図\n・立ちバックで両乳首を直接カリカリされ、快感を必死に我慢している表情\n・そのままピストンが始まり快感を抑えきれずに喘ぎ始める\n・両乳首をおっぱいが伸びるくらい引っ張られながら射精され、下品な喘ぎ声をあげながら潮吹き\n\n(以降の構図は可能であればお願いします。難しいようであれば対応不要です)\n\n・中に出されて蕩けている所で首を絞めながら挿入され、驚きと快感が半々な感じの表情\n・そのまま首を絞められながら射精、下品な喘ぎ声と蕩けた表情\n\n□備考\n・描くのが難しい、続けての依頼で受けるのが難しい場合はお気軽にキャンセルいただいて大丈夫です。\n・指定金額で描くのが難しい場合は、ご希望金額を指定の上、お気軽に再送申請をいただけると助かります。\n\nお手数お掛けしますが、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/18bDCxjwCgmJrH_Maq9kSHElypbdiArZw", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nagomu_7_56/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b2578c1d/uploads/origins/ff2dbd21-8ff5-42b5-b1e1-dbcff7a2b20f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=10eaa24491639a3240c6fa301387717c", "srcset": "https://si.imgix.net/b2578c1d/uploads/origins/ff2dbd21-8ff5-42b5-b1e1-dbcff7a2b20f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=10eaa24491639a3240c6fa301387717c, https://si.imgix.net/b2578c1d/uploads/origins/ff2dbd21-8ff5-42b5-b1e1-dbcff7a2b20f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=360d784e168aa1f3a6c7b76b510e2d9f 2x, https://si.imgix.net/b2578c1d/uploads/origins/ff2dbd21-8ff5-42b5-b1e1-dbcff7a2b20f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4c479c0025d0a3b122c285765a3bb4d9 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3391383, "client_id": 485904, "nc": 160}, {"path": "/@nagomu_7_56/works/4", "private_thumbnail_image_ur