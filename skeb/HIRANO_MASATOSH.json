ip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@HIRANO_MASATOSH/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3494208, "client_id": 3401865, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8faf85c8/uploads/origins/01eee95c-0927-42e1-a552-31abfeb99ae3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=571f01c17b54d4a671cc0ce3a044d46c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8faf85c8/uploads/origins/01eee95c-0927-42e1-a552-31abfeb99ae3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02b21812769d675f10fa53042d3d1745", "src_set": ""}, "body": "平野 真稔＠Skeb募集中様\n\nいつも素敵なイラストを描いていただきありがとうございます。\n平野 真稔先生のイラストはとてもスタイリッシュでカッコよく。\n背景も合わせて雰囲気もとてもスッキリしていて最高です。\n素敵なイラストをいつも描いてくださる。\n平野 真稔先生にまたイラストを描いていただきたくリクエストを依頼をしにきた次第です\n\n【リクエスト内容】\n今回お願いしたいイラストも無々ひさぎさんのイラストで。\n祝い事に使える、ハッピーで楽し気なイラストをお願いしたいです。\n構図、衣装、背景等。\nその他全ては平野 真稔先生にお任せしたいと思っております。\n\n【参考資料】\nhttps://lit.link/nanahisagi\n\n【用途】\nこちらvtuber無々ひさぎさんへのプレゼントになりますので、𝖸𝗈𝗎𝗍𝗎𝖻𝖾や𝖲𝖭𝖲、グッズ販売等で使用する可能性がある事をご承知おきいただきたいです。\nまた、ファン活動にも使用する可能性がございます。(ヨセッティのイラスト、フラスタのパネル等)\n\n【納品形式】キャラクター、背景、宛名などがレイヤー分けされたPSDデータ、もしくはキャラクターのみの透過差分を含めたPNGファイル。\n\nお忙しいところ誠に申し訳ございませんが、ご検討いただければ幸いです。\nよろしくお願いします", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HIRANO_MASATOSH/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3494208, "client_id": 110124, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/60aac637/uploads/origins/1e8e5302-9af7-4657-bd08-635d8d9dbf75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ac69f1a984a87ec1d4a93a6421707ca", "src_set": ""}, "duration": null, "nsfw": false, "hardcore":