313db/uploads/origins/e7fc8129-9ee2-4be6-baa5-9d53faf637a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2cad1080111912bd9ad1288f45400683 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c7313db/uploads/origins/e7fc8129-9ee2-4be6-baa5-9d53faf637a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2107534745330b6910172aa5668555c5", "srcset": "https://si.imgix.net/9c7313db/uploads/origins/e7fc8129-9ee2-4be6-baa5-9d53faf637a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2107534745330b6910172aa5668555c5, https://si.imgix.net/9c7313db/uploads/origins/e7fc8129-9ee2-4be6-baa5-9d53faf637a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4fa6aa8d7cdcc2cea5e56f65e179167b 2x, https://si.imgix.net/9c7313db/uploads/origins/e7fc8129-9ee2-4be6-baa5-9d53faf637a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=73d7acd89eac7d62995d944673615fd4 3x"}, "body": "たむへいさんいつもお世話になってます！\n先日話題に上がったことで正式に御依頼したいと思い送付しました……\n\n内容としてはたむへいさんが思う私の美少女化像を描いてください！\nたむへいさんが私に対して感じている要素やイメージを自由に取り入れて美少女化して頂きたいです。\nどんなところを重点ポイントにしたか、プロポーションや服装、アクセサリー等の要素にどんな感じに取り入れたかなどを差分のページでいただけたらとても嬉しいです！  \nぜひたむへいさんが思うようにご自由にイメージを取り入れて描いて下さればと思います。\n\n是非よろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@6nasiki/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 340249, "client_id": 19157, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/edec727c/uploads/origins/5b41885f-da65-4c32-83ad-5d2cf8920ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66d5b78590c0a17d74e324c579d99feb", "srcset": "https://si.imgix.net/edec727c/uploads/origins/5b41885f-da65-4c32-83ad-5d2cf8920ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=66d5b78590c0a17d74e324c579d99feb, https://si.imgix.net/edec727c/uploads/origins/5b41885f-da65-4c32-83ad-5d2cf8920ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67375d2e6001b78327ebf01410dc6d51 2x, https://si.imgix.net/edec727c/uploads/origins/5b41885f-da65-4c32-83ad-5d2cf8920ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38ce6a453c49de6dfe101f632781cfb3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/edec727c/uploads/origins/5b41885f-da65-4c32-83ad-5d2cf8920ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=616de8c85f63e1490c4d99b328a9c840", "srcset": "https://si.imgix.net/edec727c/uploads/origins/5b41885f-da65-4c32-83ad-5d2cf8920ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=616de8c85f63e1490c4d99b328a9c840, https://si.imgix.net/edec727c/uploads/origins/5b41885f-da65-4c32-83ad-5d2cf8920ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9da34c8a7927f83df87995a8735f88da 2x, https://si.imgix.net/edec727c/uploads/origins/5b41885f-da65-4c32-83ad-5d2cf8920ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3ad446c2c7f28df7a834b2eb8393e243 3x"}, "body": "こんにちは、屯電兵さんのイラスト/漫画から感じる優しい雰囲気がすごく好きで、いつも嬉しく拝見しています。\n\nリクエストをさせてください！\nシャミ桃を描いていただきたいんです！甘めのやつを！\n内容は屯電兵さんにおまかせで全く問題ありません。が、茫漠としていますので1つテキストを作りました。これに1枚、挿絵を頂けませんでしょうか。不要なら文は無視いただければ。\n\nよろしくお願いいたします！\n\n/\n10/31。学校からの帰り道を二人で歩く。疎い私でも、皆の浮かれた様子を1日も見れば流石に今日がハロウィンらしいことには気づく。というかシャミ子はクラスでお菓子の交換会してたみたいなんだけどなに？私も欲しかったけど？先に言っといてくんないとお菓子なんか持ってないけど？\n\n「もも」\nまずい、私はお菓子なんか……いやしかし来い、シャミ子！\n\n「お願いがあるんです」\nあれ？\n「“今日はなんの日？”と聞いてください、そしたら私がハロウィンと答えますから、“トリックオアトリート”と返してください」\n「なに？」\n「ハイ始め！」\n「き、“今日はなんの日？”」\n「わぁ、今日はハロウィンだあ」\n「“トリックオアトリート”」\n「ああ〜、お菓子は配っちゃって残ってないな〜」\n\nえっ。衝撃。シャミ子のお菓子(※経費を抑えるため手作り)がもうない？\n「もも、何をフリーズしてるんですか、やることがあるでしょう」\nお菓子が……？\n「いや、今日は家で横になります」\n「もう！トリックですよ、イタズラ！」\nなるほど。でもこんな事態は想定してなかったから案がないな、アテがない。\n「全く」\n伸びてきた手が襟元を掴んで、ぐい、頭を下げさせられる。シャミ子の顔が近い。\n「――ここまでお膳立てしないとダメか？」\nささやき声が意識を呼び込む。目線が絡みあうにつれて、シャミ子が何をさせたいか、わかる。\n「よこしままぞくだ」\n「貴様はその眷属だ」\nお互いに息を縺れさせながら、目を閉じて顔を、唇を寄せる……。\nと。不意な甘さ。\nバターと小麦粉の匂い。目当てのものではない。口に押し込まれたものを確認する。\n「カップケーキ？」\n「私からトリートです、桃。イタズラはお預け」\n「残ってないって」\n「へへ！トリックオアトリート！です、何も持ってなさそうなので！\n　先にイタズラをさせてもらいました」\n笑顔。……全く敵わないな。\n/End", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@6nasiki/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 340249, "client_id": 108254, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ca9dd4d4/uploads/origins/ce6d96f1-1f7c-4dc9-9d38-15d669f1d6f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbfc09620736bc2838a1f14b29dda588", "srcset": "https://si.imgix.net/ca9dd4d4/uploads/origins/ce6d96f1-1f7c-4dc9-9d38-15d669f1d6f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fbfc09620736bc2838a1f14b29dda588, https://si.imgix.net/ca9dd4d4/uploads/origins/ce6d96f1-1f7c-4dc9-9d38-15d669f1d6f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=29d9c2423423bbd496bf32eeced67baf 2x, https://si.imgix.net/ca9dd4d4/uploads/origins/ce6d96f1-1f7c-4dc9-9d38-15d669f1d6f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=153e3e8746fc97993cc1142cd09c3704 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca9dd4d4/uploads/origins/ce6d96f1-1f7c-4dc9-9d38-15d669f1d6f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c04e605da7a0aab4829524437234aad5", "srcset": "https://si.imgix.net/ca9dd4d4/uploads/origins/ce6d96f1-1f7c-4dc9-9d38-15d669f1d6f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=20