webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b80d687efe37b639ff5f3713217befe2 3x"}, "body": "前回のゴスロリ美少女のエッチ(https://skeb.jp/@otosume/works/9)が良かったので、また似たのをお願いできるでしょうか？\n\n・ベッドで拘束調教セックス\n・ハードな拘束具を付けられてるが楽しんでおり、積極的、蠱惑的で経験人数豊富になった感じ\n・よりゴスロリぽいヘッドドレス\n・可愛いくもより高めのハイヒールを履き大人の女性アピール。また、履いてる靴全体(特にヒール部分)がはっきり写る\n・前回同様、竿役との体格差や竿は大きめ\n・できれば、他の人もいる\n・できれば、ギャグ差分\n\nご検討のほどよろしくお願いします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@otosume/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 198642, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6cd22ea8/uploads/origins/85898f7b-3f9c-487b-8f29-271d279bc3f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e93bed4a23f19113bc13801050976bb", "srcset": "https://si.imgix.net/6cd22ea8/uploads/origins/85898f7b-3f9c-487b-8f29-271d279bc3f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e93bed4a23f19113bc13801050976bb, https://si.imgix.net/6cd22ea8/uploads/origins/85898f7b-3f9c-487b-8f29-271d279bc3f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7ad5da3b90eadd53166de6a99fa26dd 2x, https://si.imgix.net/6cd22ea8/uploads/origins/85898f7b-3f9c-487b-8f29-271d279bc3f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8134b3b0f0848d948ef8a8a1a6fdc046 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6cd22ea8/uploads/origins/85898f7b-3f9c-487b-8f29-271d279bc3f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=627d0bd9313796aba8d50f080a0d3f71", "srcset": "https://si.imgix.net/6cd22ea8/uploads/origins/85898f7b-3f9c-487b-8f29-271d279bc3f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=627d0bd9313796aba8d50f080a0d3f71, https://si.imgix.net/6cd22ea8/uploads/origins/85898f7b-3f9c-487b-8f29-271d279bc3f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=63f8a8c55a5c0b62890e096c7cac3471 2x, https://si.imgix.net/6cd22ea8/uploads/origins/85898f7b-3f9c-487b-8f29-271d279bc3f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=14912ab4576e8b44f8867583ceeafda4 3x"}, "body": "音棲目るいこ先生の絵柄で、黒のゴスロリ衣装を着た銀髪ロングのロリっ娘のエッチをお願いできないでしょうか？\n\n以下、詳細です\n・ベッドでセックス\n・気持ち良さそうに喘いでいます\n・竿役の片腕で腰を掴まれてます\n・できれば、手枷と鎖付きの首輪を付けられ、鎖は引っ張られてます\n\n・大抵のゴスロリ衣装は細かいと思うので、はだけさせたり余裕がある範囲で描き込む感じで構いません\n・靴にはかなりヒール部分が高めでリボン付きの黒のハイヒールパンプスを履いてます。また、履いてる靴全体(特にヒール部分)がはっきり写るようにお願いします\n\nご検討のほどよろしくお願いします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@otosume/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 198642, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a1140e43/uploads/origins/3c2fce45-07bf-4d72-856e-852d0837d3ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c59347c1ade278e3699845bdd567cfb6", "srcset": "https://si.imgix.net/a1140e43/uploads/origins/3c2fce45-07bf-4d72-856e-852d0837d3ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c59347c1ade278e3699845bdd567cfb6, https://si.imgix.net/a1140e43/uploads/origins/3c2fce45-07bf-4d72-856e-852d0837d3ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d15d33f1b257411a540fa260092f7c65 2x, https://si.imgix.net/a1140e43/uploads/origins/3c2fce45-07bf-4d72-856e-852d0837d3ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1a3545fe11d0d35f5351dbd2d8d870f2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a1140e43/uploads/origins/3c2fce45-07bf-4d72-856e-852d0837d3ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28bc6b491f948258b406c0ece1afcd36", "srcset": "https://si.imgix.net/a1140e43/uploads/origins/3c2fce45-07bf-4d72-856e-852d0837d3ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28bc6b491f948258b406c0ece1afcd36, https://si.imgix.net/a1140e43/uploads/origins/3c2fce45-07bf-4d72-856e-852d0837d3ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b9c29db4c87208e57b3709b5a99c6d9c 2x, https://si.imgix.net/a1140e43/uploads/origins/3c2fce45-07bf-4d72-856e-852d0837d3ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4ebc7f07709c9424b592f75777760e33 3x"}, "body": "こんにちは。\nよろしければカスタムメイド3D2で作成したキャラを描いていただけないでしょうか。\nhttps://drive.google.com/file/d/1rDaLfmyEnifFBcMPftxDHgoVbC0BeW2j/view?usp=sharing\n\n\n・服装等\n黒髪ロングのストレート\n目はたれ目でもツリ目でもない程度\n制服(黒ブレザー+黒or黒に近いグレーのチェックスカート)を脱がさずそのまま\nネクタイを同色のリボンに変更\n胸のサイズは膨らみかけ程度の小さめ\n靴下は膝下丈の黒ハイソックス(画面内に穿いている足を入れて下さい)\n下着はなし\n\n\n・シチュ等\n真正面からの主観視点風(頭部の向きもまっすぐ正面)で\n両手繋ぎ正常位破瓜中出し(根元まで挿れて射精した瞬間)和姦\n二人一緒にイッたイメージ\n大量に中出しされた精液が溢れてスカートやふともも、腹部周辺にまで飛び散っている状態\n結合部や溢れた精液に破瓜の血の描写をお願いします\n表情は両目を見開かない程度に開き、口を「あ」の形に大きく開いて舌は出さないトロトロな絶頂顔\n\n加えて差分で\n1.髪・顔・口内・服・足・黒ハイソックスなどもうかける場所がないくらい全身ドロドロなぶっかけ\n2.モノを引き抜かれて血混じりの精液が開いたままのアソコから溢れてお尻の下のスカートに溜まっている描写\n3.事後イメージの目と口を開いた微笑み\n4.射精前の破瓜のみ\n5.全裸\nをお願いできないでしょうか。\nレイヤーを切り替えて色々なパターンを作れるようにして頂けるととても捗ります。\n厳しい場合は2以降を適宜削って下さい。\n\n\n\n・背景\n自室想定で白いシーツのベッド上\n\n\n・男性\n同年代想定の特徴がない普通の男性\n手とモノ程度\n\n\n\n何卒ご検討下さい。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@otosume/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e93b76ee/requests/251142_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e62134cc1382cd6829da7a128f5bcc57", "srcset": "https://si.imgix.net/e93b76ee/requests/251142_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop