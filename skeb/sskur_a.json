crop=top&w=200&h=200&s=c9e1422bf58cf5986a4ba48c8c7d13b8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b68d6318/uploads/origins/4e83a75b-cc65-4f63-8628-1306ce8d7783?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46a367f3f7a79b4837192df80fc56f86", "src_set": ""}, "body": "今回は艦これの鹿島さんのイラストをリクエストします。\n靴下を履いている最中でそこから見える太ももやパンツが見所な感じで。(もう片方の足は履き終えている)\nこちらの視線に気づいてるけどまんざらでもない表情。\nささくらさんの描くお胸いつも最高なのでいつもの感じでお願いします。\nよろしくお願い致します。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sskur_a/works/460", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 132363, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95a38c70/uploads/origins/1fb5b9ff-2f98-4195-b57b-b99f6bae4f09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74a259578c30166d39cfcdaf7ed18346", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95a38c70/uploads/origins/1fb5b9ff-2f98-4195-b57b-b99f6bae4f09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3427a43ecda69a735ac25cc2ecad5deb", "src_set": ""}, "body": "こんにちは、さくらさん。前回の素敵なアメリアのイラストありがとうございました。今回もホロライブさんにワトソン・アメリアのイラストをお願いしたいと思います。\n\n今回はアメリアの着物姿をお願いします。お風呂上がりのアメリアの髪が濡れている感じがいいですね。ポーズはミッションセックス。\n\nhttps://i.imgur.com/s2uh4rm.jpeg\n\nアメリアの着物が前から開かれ、裸体が露わになる。着物はアメリアの肩にかかる程度。着物の下には白いストッキングを履いている。より都合がよければ、着物を脱いで、アメリアは開いた着物の上に裸で寝そべることもできる。\n\nムードはラブラブ。もし可能なら、男性が片手でアメリアの頬を撫でてほしい。アメリアは男の腕を愛おしそうに握る。問題なければ、アメリアが受精している断面図をお願いしたい。\n\nありがとうございました！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sskur_a/works/459", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7f4d62c4/uploads/origins/e564b2dc-174f-40fc-a42a-6d7