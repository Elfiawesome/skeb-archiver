s/d421326c-7303-45a0-a57b-eca61c3f0564?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5377a57b4a6a0923788399d744001369", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 132363, "client_id": 189687, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sskur_a/works/468", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 132363, "client_id": 3649561, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/96a616bc/uploads/origins/a3a87297-d85d-43d8-bc27-5f7b0e296397?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7179cf62f8ae113fa564d1c5317c7916", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96a616bc/uploads/origins/a3a87297-d85d-43d8-bc27-5f7b0e296397?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ebf43cffc205561d715156fbd8242f89", "src_set": ""}, "body": "※商用利用予定（DLsite販売作品用）\n※全年齢外見／R18作品\n\nすごくえっちなイラストお願いします！\n\nイラストからシナリオ考えて音声作品に使いたいです。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sskur_a/works/467", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 132363, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0e90a1b5/uploads/origins/abf42bb5-44a0-4fa4-a90f-a6a712398ca6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=614eef6d946922466afeda03fd194db1", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0e90a1b5/uploads/origins/abf42bb5-44a0-4fa4-a90f-a6a712398ca6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98c428c8201c0c8409d405a1e5487d0b", "src_set": ""}, "body": "ささくら様\n\nこんにちは、個人でVtuber活動をしている古代紫と申します。\n\n2回目の依頼となります。\n以前は素敵なイラストをありがとうございました。\n柔らかそうな肉感、通常笑顔も色っぽい表情もどちらも大変良かったです。\n\n今回も古代紫を描いていただきたいです。\nhttps://twitter.com/akairo_murasaki\n\n【イラストイメージ】\n寝起きのシチュエーションのイラストが見たいです。\n寝起き想定なので、服装はネグリジェかパジャマ姿。だらしなく、気崩すように肌が少し露出するとなお良しです。\n手、足は今回は人の手でお願いします！\n\n\n【イラスト使用用途】\n・配信での紹介、サムネイルでの使用\n・SNSでの広報用\n\n【その他】\n・人物とそれ以外（背景など）のレイヤー分けされたPSDデータで頂けるとありがたいです。\n・髪や上半身、手など、キャラクターが見切れないようにしていただけるとありがたいです。（足先は切れていても構いません。）\n\n\n以上です。ご検討のほどよろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sskur_a/works/466", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 132363, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/448a5e63/uploads/origins/9590e575-9acb-4d03-87f4-cd125689300a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa9d6416e706914cb864843f5a8e76db", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/448a5e63/uploads/origins/9590e575-9acb-4d03-87f4-cd125689300a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1339f340004cc25a99d42b1021f04cf7", "src_set": ""}, "body": "はじめまして。HLiveマネージャーアカウントからの送付失礼します。\n「音猫とお」からのリクエストを送付させていただきます。\n\n◆キャラクター\n音猫とお\nX：https://x.com/OtonetoO_hlive\n主人が獣医の飼い猫（スコティッシュフォールド）でさみしがり、かまってちゃんなキャラクターです。\n---------------------------------------------------------------\n◆詳細\n・画像比率：16:9(可能であれば横、縦の場合は9:16)\n（サムネイルでぼやけないサイズでしたら大丈夫です〇）\n\n【表情】\n少し挑発的に笑っているような顔\n\n【衣装】\n添付画像のようなマイクロビキニで、できればパンツの局部部分に濡れ後の染みができているように描いてほしいです。\n\n【差分希望】\n・背景透過\n・裸差分\n（可能ならPSDデータもいただけると助かります！）\n---------------------------------------------------------------\n\n以上、リクエスト内容でございます。\nご検討いただけましたら幸いです。\n\nhttps://drive.google.com/drive/folders/1gzvvAN_EqYZ2kpAnsHPLY-qrOKZoXFdR?usp=sharing", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sskur_a/works/465", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 132363, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c4de9e0/uploads/origins/5600c727-1f46-4dd3-80e3-95c282daf728?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27ae6983eacbbde7b84e323ef1e8ca67", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c4de9e0/uploads/origins/5600c727-1f46-4dd3-80e3-95c282daf728?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=037c6f595e75654c42a331d4020e37a4", "src_set": ""}, "body": "以前こちらのリクエストをさせて頂いた者です。\nhttps://skeb.jp/@sskur_a/works/366\nhttps://skeb.jp/@sskur_a/works/338\n\n本当に素晴らしい作品をありがとうございます。\n\nちょうど今アニメも放送中ですので、また久しぶりに黒執事のサリヴァンちゃんのイラストをリクエストさせて下さい。\n\n今回希望するのはルームウェア姿で髪をおろしたサリヴァンちゃん（URL参照）と主観視点でのイチャラブ和姦\n※竿役が夜這いに来てそのままHしたというif\n\n「夜這いにきたのだからボクを満足させてくれよ」等のセリフと簡単な擬音の書き文字もお願いします。\n今回も男性表現は最低限、体位など詳細部分は先生のアレンジにお任せします。\n\n何度も同じキャラでのリクエストで恐縮ですが、また何卒ご検討いただければ幸いです。\n\nhttps://drive.google.com/drive/folders/1-EA3byHsJdcLZ6IdpR5qXRF2sNTKqasH", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sskur_a/works/464", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f377b8f3/uploads/origins/e84e3579-a610-408a-a563-b1bbc57a8ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=67fabc9e44b9167e597b531621fd22f4", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 132363, "clie