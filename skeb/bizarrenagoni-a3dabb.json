19", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bizarrenagoni/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1914453, "client_id": 848832, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f8144013/uploads/origins/9a7d34f2-6d98-4aaf-b214-c453b035f766?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a76ca6ab9640297f5a0037b88ae02802", "srcset": "https://si.imgix.net/f8144013/uploads/origins/9a7d34f2-6d98-4aaf-b214-c453b035f766?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a76ca6ab9640297f5a0037b88ae02802, https://si.imgix.net/f8144013/uploads/origins/9a7d34f2-6d98-4aaf-b214-c453b035f766?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe600147fa12ade7e6888a20f106e016 2x, https://si.imgix.net/f8144013/uploads/origins/9a7d34f2-6d98-4aaf-b214-c453b035f766?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ed86e0d99d295e72c287fa321293bcb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8144013/uploads/origins/9a7d34f2-6d98-4aaf-b214-c453b035f766?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa3776164e1e27939a868d53b6eed7f6", "srcset": "https://si.imgix.net/f8144013/uploads/origins/9a7d34f2-6d98-4aaf-b214-c453b035f766?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa3776164e1e27939a868d53b6eed7f6, https://si.imgix.net/f8144013/uploads/origins/9a7d34f2-6d98-4aaf-b214-c453b035f766?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=23202fc86aa9d85fb5eca7934b8cf010 2x, https://si.imgix.net/f8144013/uploads/origins/9a7d34f2-6d98-4aaf-b214-c453b035f766?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=729d7dd1a12