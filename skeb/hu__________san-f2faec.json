0d6/uploads/origins/02279b94-4cf2-4990-8217-7be8211b2c28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=712a7e02c811c7b904958c8370208450, https://si.imgix.net/2e8070d6/uploads/origins/02279b94-4cf2-4990-8217-7be8211b2c28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1ec3afefa78581e36f65ab50b3a1049f 2x, https://si.imgix.net/2e8070d6/uploads/origins/02279b94-4cf2-4990-8217-7be8211b2c28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cd5e9ec55d790a16c06dfb3baaaf5739 3x"}, "body": "昔さん、Skeb解説おめでとうございます！\n去年の秋ごろ描いていただいた子のイラストをリクエストさせてください！\n\n・季節は秋ごろ\n・部屋着のようにリラックスしたような服装\n・幸せそうな感じで微笑んでいる（口は開いてないと嬉しいです）\n\n構図などはすべてお任せします。\nふわっとしすぎて難しいようであればキャンセルしていただいて大丈夫です！\n\nhttps://drive.google.com/drive/folders/1bAYXnMm1vdpWtA-D5PyrjXz7K9ybyTnl?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@rusdesita/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2556553, "client_id": 2123003, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b45c0e6/uploads/origins/e7f02086-ee56-4960-af52-1a8f5031ce39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f1ac0023b34eb81e213e66017536bff", "srcset": "https://si.imgix.net/8b45c0e6/uploads/origins/e7f02086-ee56-4960-af52-1a8f5031ce39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f1ac0023b34eb81e213e66017536bff, https://si.imgix.net/8b45c0e6/uploads/origins/e7f02086-ee56-4960-af52-1a8f5031ce39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=115816ce76bd03d47bcfac99a660eb7a 2x, https://si.imgix.net/8b45c0e6/uploads/origins/e7f02086-ee56-4960-af52-1a8f5031ce39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85373767ec4fb3d811b2e21aa5cd4c39 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b45c0e6/uploads/origins/e7f02086-ee56-4960-af52-1a8f5031ce39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f7ae58e712d866230698d284734b791", "srcset": "https://si.imgix.net/8b45c0e6/uploads/origins/e7f02086-ee56-4960-af52-1a8f5031ce39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f7ae58e712d866230698d284734b791, https://si.imgix.net/8b45c0e6/uploads/origins/e7f02086-ee56-4960-af52-1a8f5031ce39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=508e3450ed3bae5677232c923faea480 2x, https://si.imgix.net/8b45c0e6/uploads/origins/e7f02086-ee56-4960-af52-1a8f5031ce39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=47098fc48891ecb022dc049406aa996f 3x"}, "body": "こんにちは、昔です。\n「いつか大人っぽい旭を描いてもらいたい…」と考えていたのですが、\n今がその時では…！？と思い立ち、\nリクエストをお送りさせていただきます。\n\n---------------------------------------------------\n\nキャラクター：西浦　旭\n男/22歳/身長177/茶髪(緑のメッシュが前髪にまばらに入っています)\n\n【髪】\nやや跳ねた短髪\n茶髪(緑のメッシュが前髪にまばらに入っています)\n\n【目】\n緑色のつり目\n\n【服装】\n黒シャツ、黒ネクタイ\n上着としてVOID制服\n(こちらの上着ビジュアルをお借りしています。\nhttps://twitter.com/kasute_ra_suzu/status/1399641932943421443?s=21)\n\n【性格】\nよく笑う明るい青年。\n要領良くなんでもできるタイプだが、\n自信家故に調子に乗りやすく、結果痛い目を見る事も多い。\n良くも悪くも「若者！」というイメージ。\n\n\nキャラクタービジュアル\nhttps://drive.google.com/drive/folders/1H3SugHRfwIasYmjG5o_2tgIFa09aMd5a?usp=sharing\n\n\n【シチュエーション希望】\n希望するキャラは「明るい性格」ではありますが、\nそんな男が人の居ない場所ではすんっ…とタバコ吸ってる所が見たい！…という希望です。\n人気のない場所で、大人っぽく、色気があるイメージで描いていただければと思います。\n\n\n---------------------------------------------------\n\n\n不足分がございましたら、お任せ致します…！\nもしご機会があれば、よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MEDAKATABERU/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 48615, "client_id": 2123003, "vtt_url": null, "thu