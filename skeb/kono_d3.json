, "private": false, "genre": "art", "tipped": false, "creator_id": 2543495, "client_id": 1453478, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/32afdc62/uploads/origins/80f604b5-50ab-4e2a-aa24-f5d4613c11b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=710e1c9230cafe648ac3dac3fdac520a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/32afdc62/uploads/origins/80f604b5-50ab-4e2a-aa24-f5d4613c11b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bda0aaadbd6306136650ec673e96c0ce", "src_set": ""}, "body": "Hi, it's nice to meet you. I'm Rena Fenrir.\n\nI like the quality of your work, and they're all so amazing.\n\nI hope you will consider drawing my Vtuber.\n\nDescription:\nI'm a Wolf Vtuber who's an adventurer with a Hamster companion. I'll leave the rest to you, as all the works are so cute! \n\nThe art will be used as follows:\n・ SNS Posting / Promotion\n・ SNS icons and headers\n・ YouTube / Twitch \n・ Online Printing (Commercial) \n・ Stickers (Commercial) \n・ Merchandise (Commercial) \n\nI hope this request is possible!!\n|\nThank you for your time.\n\nI hope I didn't cause any inconvenience.\n\nhttps://drive.google.com/drive/folders/1gHE9qhpxRP14clRAFXhHHcRtd3ijnJ_H?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kono_d3/works/314", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2543495, "client_id": 1517466, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/69267272/uploads/origins/17b9cb89-f7b9-41fb-a9e0-598782904a3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aadc6cebf2a57f4742cbf2f41bcbbfb7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/69267