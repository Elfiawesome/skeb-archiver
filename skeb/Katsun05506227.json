29-464c-8771-4ef88f63b62e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14a371ff718090c11593b5b393a7ee79", "src_set": ""}, "body": "いつもお世話になっております。\nまいっちんぐマチコ先生のマチコ先生をリクエストさせて下さい。\n\n・マチコ先生のグラビア、といったイメージ\n・マチコ先生の衣装は超ミニスカなチアガールコスチューム（デザインはおまかせ）\n・下半身はパンツ着用\n・背景は不要、白一色でOK\n\n●立ち絵\n・1枚絵、正面向きの立ち姿勢でポーズをとっている状態（ポーズはおまかせ）\n・表情は明るい笑顔\n・ちょっとパンチラしている\n\n●パンモロのドアップ\n・チアガールコスチューム着用状態でパンモロしている場面のドアップ画像\n・以下の3パターンをそれぞれ1枚絵で大きくお描き頂きたいです\n①風でスカートがめくれあがってパンモロしているところを真後ろ（お尻方向）から見た感じのドアップ\n②しゃがんでパンモロしているところを正面から見た感じのドアップ\n③脚を開いて立っているところを真下から見た感じの逆さ撮りパンモロのドアップ\n\nもしよろしければ、お引き受け下さると幸いです。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Katsun05506227/works/31", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3300772, "client_id": 328819, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f630475e/uploads/origins/8f828405-242f-41e4-a9ee-8ac05e0c2d81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71fc11892d26854b4e86a92028056217", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f630475e/uploads/origins/8f828405-242f-41e4-a9ee-8ac05e0c2d81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecc7e3ab97f806bd3fa3dd2dc9e2173c", "src_set": ""}, "body": "お久しぶりです。リクエスト募集の再開をお待ちしていました。前回のマチコ先生のイラストは素晴らしかったですし、その後似たようなリクエストをする方が出てくるとは予想外でした。そこで私も再びリクエストいたします。今回は一枚絵で構いません。テーマは前回と同様粘着拘束で、キャラクター及びシチュエーションは、魔法の天使クリィミーマミのクリィミーマミ（森沢優のアイドルとしての姿）が粘着物を使ったドッキリに引っかかるというものです。\nネバネバは前回と同様のピンク色として、https://www.deviantart.com/sugarvoids/art/Trapped-commission-956997459のような体勢にしつつ、「まぁ!」あるいは「ああっ!」と言わんばかりに片手で口を押えているように（https://slii.wordpress.com/2016/06/23/%E6%89%8B%E3%81%A7%E5%8F%A3%E5%85%83%E3%82%92%E9%9A%A0%E3%81%99%E7%BF%92%E6%85%A3%E3%81%8C%E3%81%82%E3%82%8B%E3%81%AE%E3%81%AF%E6%97%A5%E6%9C%AC%E4%BA%BA%E3%81%A0%E3%81%91%EF%BC%9F/のイメージ）してください。またネバネバは靴が見えなくなるくらいに足首まで覆ってください。今回のシチュエーションは「クリィミーマミのサプライズライブ」という体でのドッキリなので、舞台は屋外ステージとしてバックには「クリィミーマミのネバネバライブ」と書かれた種明かし用の吊り物を付け加えてください。さらに舞台袖辺りから「ドッキリ成功!!」というプラカードも出してくだされば幸いです。\n以上設定が多めですがよろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Katsun05506227/works/30", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3300772, "client_id": 8761, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b9b93f0a/uploads/origins/967b1b22-c12a-4e01-85d0-c1463acd85e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eaf06a5610f4c16ab8e0fc46b652d42c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b9b93f0a/uploads/origins/967b1b22-c12a-4e01-85d0-c1463acd85e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e335224f3f1938bf49c90a85ba460ab", "src_set": ""}, "body": "昔コミックボンボンで連載していた「OH!MYコンブ」のパパイヤ・ピーチ先生をお願いします\n\nいつものネグリジェ姿で授業しているところを\n黒板に書いている後ろ姿\n生徒に前かがみで「ここはこうだよ～」って教えている姿の２つが見たいです\n\n以上です、よろしくお願いします", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 363108, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "虚空力士(鳥居姫)", "screen_name": "kokurikishi", "avatar_url": "https://pbs.twimg.com/profile_images/1091280754/twitter.jpg", "header_url": "https://pbs.twimg.com/profile_banners/172627262/1467286091/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 32}, {"id": 697862, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "炎 輝樹(ほむらのてるき)", "screen_name": "HOMRAnoTERUKI", "avatar_url": "https://p