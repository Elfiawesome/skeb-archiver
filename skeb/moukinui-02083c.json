bc 2x, https://si.imgix.net/a9f50d79/uploads/origins/e9f78ea7-e843-4f39-bed7-8a19ac513ab8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=862f03cbda12a159271743b456260a5f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9f50d79/uploads/origins/e9f78ea7-e843-4f39-bed7-8a19ac513ab8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3fafd536f28c6bd3adf86d03d1a35458", "srcset": "https://si.imgix.net/a9f50d79/uploads/origins/e9f78ea7-e843-4f39-bed7-8a19ac513ab8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3fafd536f28c6bd3adf86d03d1a35458, https://si.imgix.net/a9f50d79/uploads/origins/e9f78ea7-e843-4f39-bed7-8a19ac513ab8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8c834057865e6d9889794cb6e2ffefde 2x, https://si.imgix.net/a9f50d79/uploads/origins/e9f78ea7-e843-4f39-bed7-8a19ac513ab8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ceed42ac17a0a3a79dd910018fa6775d 3x"}, "body": "前回のイラスト有難うございました。\n今回もマイキャライラストをお願いしたいのですが、以前描いていただいた（あき・れおな・なつみ・あかり）であきが12月4日誕生日なので皆ががあきを囲って（距離近め）誕生日を祝ってる所を描いてほしいです。\nあきの表情は顔を赤らめてとても喜んでる表情にして頂けるとうれしいです。\nおまかせ要素が多いですがよろしくお願いします。\n\nhttps://mobile.twitter.com/fusosinano/status/1502998724502466565", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@moukinui/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1720956, "client_id": 1078997, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/81a1594c/uploads/origins/1e97c7cc-c691-4732-bdc2-4879dcdc59e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c6910ceb1a4dabdd4b321f8c15a36c7", "srcset": "https://si.imgix.net/81a1594c/uploads/origins/1e97c7cc-c691-4732-bdc2-4879dcdc59e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c6910ceb1a4dabdd4b321f8c15a36c7, https://si.imgix.net/81a1594c/uploads/origins/1e97c7cc-c691-4732-bdc2-4879dcdc59e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32a0cfa96ee9ab60bb2c33c72487a6d5 2x, https://si.imgix.net/81a1594c/uploads/origins/1e97c7cc-c691-4732-bdc2-4879dcdc59e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0eb9b71b137c747452899d05e3451c0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/81a1594c/uploads/origins/1e97c7cc-c691-4732-bdc2-4879dcdc59e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b0fd9a21a7a5ac1bc5826f95e0e6d67", "srcset": "https://si.imgix.net/81a1594c/uploads/origins/1e97c7cc-c691-4732-bdc2-4879dcdc59e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b0fd9a21a7a5ac1bc5826f95e0e6d67, https://si.imgix.net/81a1594c/uploads/origins/1e97c7cc-c691-4732-bdc2-4879dcdc59e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=97308b936f75cadce7406c925fca7b69 2x, https://si.imgix.net/81a1594c/uploads/origins/1e97c7cc-c691-4732-bdc2-4879dcdc59e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4fdcfca701e1ee6351ecbc665a1b43a5 3x"}, "body": "はじめまして。\n今回プリチャン マイキャラのイラストをお願いしたいのですが、シチュは4人で横断歩道を渡る（ビートルズのCDジャケをオマージュ）\nサイズはPCデスクトップ画面サイズか横長でお願いします。\n一枚目の画像\nhttps://mobile.twitter.com/fusosinano/status/1520732910944342016\nキャラはピンクサイドテール（あき）ピンクツインテ（なつみ）黒ぐるぐるツインテ（あかり）ピンクお団子（れおな）\n資料\nhttps://mobile.twitter.com/fusosinano/status/1520741928236507141?cxt=HHwWioCjub-u4ZoqAAAA\n\n順番は右からあき−なつみ−あかり−れおなの順\n\n先頭のあきが振り向くようにしてなつみに「行くよ」という感じに優しい笑顔で。\nなつみはあきを元気よく追いかけるように、手を前にだしてる（あきと距離近め）\nちょっと離れてあかりは安全第一の黄色い小旗を掲げながら楽しそうに\n最後尾で楽しそうな皆を見るように、頭の後ろで手を組む？ようにして歯を見せてニッとわらってるれおな。（チュッパチャップス咥えてる）\n服装\n\nあき　薄いレモン色のニット生地のトップスにハイウエストショートパンツ水色\nなつみ　白のTシャツとハイウエストショートパンツデニム小さいバックからってカービィっぽいのを\nあかり　クリーム色のTシャツ（ワンポイントに桃色ウサギ）濃いめの赤スカート\nれおな　白タンクトップ（へそが見えてる）デニムショートパンツ（ダメージ）　黒のブーツ（長編上げ）\n\n身長はれおなが一番高く次にあき（高校生設定）\nあかりとなつみは小学生高学年でこちらは同じくらいです\n\n体型\nれおなは乳が一番デカイHカップくらい、それ以外は引き締まったモデルスタイルで。\nあきはEカップくらいで尻と太ももを大きめに。\nあかりはCくらいか膨らみがちゃんと見え、将来の可能性を感じる程度。\nなつみは年相応で若干膨らみがある程度でおねがいします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@moukinui/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/69ab8312/uploads/origins/efc73fbf-c655-4494-9af5-aed62ce3c16a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bd8dc8ebf83125449803f5a673b7ed58", "srcset": "https://si.imgix.net/69ab8312/uploads/origins/efc73fbf-c655-4494-9af5-aed62ce3c16a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bd8dc8ebf83125449803f5a673b7ed58, https://si.imgix.net/69ab8312/uploads/origins/efc73fbf-c655-4494-9af5-aed62ce3c16a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3aeb5d645ec02b551e8ce252cb2a93fa 2x, https://si.imgix.net/69ab8312/uploads/origins/efc73fbf-c655-4494-9af5-aed62ce3c16a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=637b880a8674b4bf6105ec7156c23a07 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1720956, "client_id": 292588, "nc": 129}], "sent_works": [], "similar_creators": [{"id": 250526, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "め", "screen_name": "u006d_u0065", "avatar_url": "https://pbs.twimg.com/profile_images/1845476612311232512/cBdFs2Bw.jpg