mgix.net/9fc1aecd/uploads/origins/33a71615-aac3-4cfd-8758-de8e1f83bf7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ab084dbf12bdd07201a0c94f023ef75, https://si.imgix.net/9fc1aecd/uploads/origins/33a71615-aac3-4cfd-8758-de8e1f83bf7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b13b22fd4742147e9e6fd9e16f7f016d 2x, https://si.imgix.net/9fc1aecd/uploads/origins/33a71615-aac3-4cfd-8758-de8e1f83bf7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f7deebe0ca99c7a672bd21282c381932 3x"}, "body": "はじめまして。\n神翔ましろ先生のイラストを拝見し、\n可愛らしい雰囲気に惹かれリクエスト致しました。\nご縁がありましたら幸いです。\n\n今回、VTuberの天結ひいろさんを描いて頂きたいです。\n歌やASMRをメインに活動しています。\nご本人様のXアカウントはこちらになります。\nhttps://x.com/amayui_hiiro\n\n【依頼内容】\n寝起きで眠たそうなシチュエーションで描いて頂きたいです。\n服装：パジャマ姿もしくは部屋着\n髪型：髪飾りは無しで毛先がはねていたり\nシチュエーションに合った髪型に変えて頂いて構いません。\nその他ポーズや構成などはお任せ致します。\n頭部や顔辺りは途切れていないものだと助かります。\n\n＜人物について＞\n147cmの天使の女の子。\n髪の毛は銀髪で水色のメッシュがはいっており、\nインナーカラーが星空（宇宙）になっています。\nハイライトは虹色です。\n\n【使用用途】\n天結ひいろさんご本人様に限り、YouTube（収益化済）の配信画面や\n配信サムネイル、SNS（XやFANBOX、TikTok）の投稿などVTuber活動に使用。\n私自身としては、ご本人様へのプレゼント、SNS（X）での投稿。\n\n可能であれば、人物や背景など分かれたレイヤーのPSDデータでの納品だと助かります。\n\nぜひ、ご検討の程、宜しくお願いします。\n\nhttps://www.dropbox.com/scl/fo/qkl11uaf3i5a16010kx8n/AM9WY69qYN-ihtfkfI4ghao?rlkey=arcqb0k5x94m45qbwwj7mklzc&dl=0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mashiro281/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 43585, "client_id": 1204741, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09fbca3f/uploads/origins/289495a7-b050-454e-98eb-ca9ed72268dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0303c9453d10c6e551009afc867b4c7", "srcset": "https://si.imgix.net/09fbca3f/uploads/origins/289495a7-b050-454e-98eb-ca9ed72268dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0303c9453d10c6e551009afc867b4c7, https://si.imgix.net/09fbca3f/uploads/origins/289495a7-b050-454e-98eb-ca9ed72268dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba267b0a6a793b76c4b3cbb29491e75a 2x, https://si.imgix.net/09fbca3f/uploads/origins/289495a7-b050-454e-98eb-ca9ed72268dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=847003e2be4f4c7a04aa5e92e5e4fadd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/09fbca3f/uploads/origins/289495a7-b050-454e-98eb-ca9ed72268dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8702f65323fee269c01ac14598f55950", "srcset": "https://si.imgix.net/09fbca3f/uploads/origins/289495a7-b050-454e-98eb-ca9ed72268dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8702f65323fee269c01ac14598f55950, https://si.imgix.net/09fbca3f/uploads/origins/289495a7-b050-454e-98eb-ca9ed72268dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ee364391e176b628e252f983c2b6390d 2x, https://si.imgix.net/09fbca3f/uploads/origins/289495a7-b050-454e-98eb-ca9ed72268dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0fd5624a08461c362a0c7aae84fe0a71 3x"}, "body": "はじめまして、神翔ましろ様のイラストに惹かれてリクエスト送らせていただきます。\nPSO2 NGSで使用しているうちの子のイラストを貴方の絵柄で描いてもらえたら嬉しいです。\n\n身長138cmと小柄で、タレ目がちな童顔の女の子、基本はほんわか無垢系で敵をニコニコぶん殴ってる感じで、稀に少しメスガキ風味になるイメージです。\n資料の画像は複数のコスチュームのパターンが下記にまとめてあり、詳しい資料は参考画像と同名のフォルダ内にまとめました。\nこの中から描きたいと思った、描くならこれだと思ったものを描いてもらえたら嬉しいです。\n色んなパターンを入れすぎた感はありますが、どれか描きたいと思ってもらえるといいなと祈ってます。\nhttps://drive.google.com/drive/folders/1kHBU4g0yNlD7x8VZe9v9o8xtquT9gqaf?usp=drive_link\n\n資料の中には愛用の武器の画像が入っているものもあるので、その場合は武器を持ったポーズだとうれしいですが、武器アリでも無しでも好きなように描いてもらえればと思います。\n構図については全身が見きれ無しで画面に収まっているとうれしいです。\n更にぶっちゃけるとうちの子アクスタを作りたいので、アクスタにしたとき映える画だと言う事無しです。\n他の構図やポーズはもちろん、ディテールのアレンジや省略などもご随意にお任せいたします。\n\n納品物のレイヤー分けは、背景、人物、武器、その他、で分かれていると助かります。\n（背景は真っ白でもOK、武器・その他は描かれていなければ無し）\n\n用途：個人鑑賞、個人利用の為のグッズに利用する、skebで描いてもらったと知り合いに見せる\n\n以上、もしよろしければ、ご検討いただけますと幸いです。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mashiro281/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 43585, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc2c3ee7/uploads/origins/2ce831a7-d258-489a-afd1-7312f49b1d64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29c59cd79b1cf09debba90718952ab2a", "srcset": "https://si.imgix.net/bc2c3ee7/uploads/origins/2ce831a7-d258-489a-afd1-7312f49b1d64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29c59cd79b1cf09debba90718952ab2a, https://si.imgix.net/bc2c3ee7/uploads/origins/2ce831a7-d258-489a-afd1-7312f49b1d64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d590022e475fdd94528001c71ec92478 2x, https://si.imgix.net/bc2c3ee7/uploads/origins/2ce831a7-d258-489a-afd1-7312f49b1d64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5770ece4dcea6cf9e7b1e38a5c8d6049 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc2c3ee7/uploads/origins/2ce831a7-d258-489a-afd1-7312f49b1d64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d87fb44b628e032455398a66dd823ad3", "srcset": "https://si.imgix.net/bc2c3ee7/uploads/origins/2ce831a7-d258-489a-afd1-7312f49b1d64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d87fb44b628e032455398a66dd823ad3, https://si.imgix.net/bc2c3ee7/uploads/origins/2ce831a7-d258-489a-afd1-7312f49b1d64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fd68ad1f49e1fed4cf7f93029699811f 2x, https://si.imgix.net/bc2c3ee7/uploads/origins/2ce831a7-d258-489a-