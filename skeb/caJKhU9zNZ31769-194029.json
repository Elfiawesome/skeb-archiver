さん、星、リボンが好きです。 \n\n・元気で可愛らしい感じだと嬉しいです！\n\n【使用用途】\n・ XやTwitchのアイコンやヘッダーへの使用 Xでのポスト(パネル開け、お知らせ当該) \n・Twitch(収益化済み)での使用\n\n【納品形式】\n可能でしたらPSDデータでいただけますと幸いです。\n\n\n金額について不足がありましたら再送要請等いただけますと幸いです。\n何卒ご検討のほどお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1MOCUfMMENiEZXG9Iqn-Tl0AQIr4r6Cmx", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@caJKhU9zNZ31769/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3721967, "client_id": 3744845, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f663d498/uploads/origins/d54b0cdc-596e-448a-bb23-82486b8d1451?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14528b13e2e1a88486b03c7c639b0131", "srcset": "https://si.imgix.net/f663d498/uploads/origins/d54b0cdc-596e-448a-bb23-82486b8d1451?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14528b13e2e1a88486b03c7c639b0131, https://si.imgix.net/f663d498/uploads/origins/d54b0cdc-596e-448a-bb23-82486b8d1451?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10ab79c765070ff69cde12412ee9fbf1 2x, https://si.imgix.net/f663d498/uploads/origins/d54b0cdc-596e-448a-bb23-82486b8d1451?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66ac1bc02b2bb0b6cd49443143fd1718 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f663d498/uploads/origins/d54b0cdc-596e-448a-bb23-82486b8d1451?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c738a25781a74b3ce5ea313cdde86a0d", "srcset": "https://si.imgix.net/f663d498/uploads/origins/d54b0cdc-596e-448a-bb23-82486b8d1451?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c738a25781a74b3ce5ea313cdde86a0d, https://si.imgix.net/f663d498/uploads/origins/d54b0cdc-596e-448a-bb23-82486b8d1451?bg=%23fff&auto=form