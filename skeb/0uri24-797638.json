た受けの魔力を封じ込み、王宮から課せられた自分の目的にために同行させる攻めとの2人パーティです。\n攻めの上から目線の性格はあまり好きではないものの、助けてくれた恩があるので素直に同行しています。\n\nここまで読んでいただきありがとうございました。\nご検討どうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/mobile/folders/17J6YxkD5zi-adiX4_3vyzegajOhu1cKL", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0uri24/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3648217, "client_id": 1174080, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cbaa856c/uploads/origins/582663ee-6839-4f7f-b6e9-9360804d26e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=048ca617828e0eb5643f10499249d783", "srcset": "https://si.imgix.net/cbaa856c/uploads/origins/582663ee-6839-4f7f-b6e9-9360804d26e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=048ca617828e0eb5643f10499249d783, https://si.imgix.net/cbaa856c/uploads/origins/582663ee-6839-4f7f-b6e9-9360804d26e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=623c66d845d2f08bdc2bb56852824e32 2x, https://si.imgix.net/cbaa856c/uploads/origins/582663ee-6839-4f7f-b6e9-9360804d26e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2d4786a20e3b57bf1557de19826cffa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cbaa856c/uploads/origins/582663ee-6839-4f7f-b6e9-9360804d26e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dbdb4195ebea036c87c51e468ee40ada", "srcset": "https://si.imgix.net/cbaa856c/uploads/origins/582663ee-6839-4f7f-b6e9-9360804d26e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dbdb4195ebea036c87c51e468ee40ada, https://si.imgix.net/cbaa856c/uploads/origins/582663ee-6839-4f7f-b6e9-9360804d26e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=