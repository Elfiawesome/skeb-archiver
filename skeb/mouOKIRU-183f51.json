mat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=992d0e50b4e4ce18ee67f49b0474835d 2x, https://si.imgix.net/bc354db0/uploads/origins/a2eb3919-88a3-4a11-aafc-15bdf17c17ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e102ce6ade4be596b17d52b0b7bb1acf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc354db0/uploads/origins/a2eb3919-88a3-4a11-aafc-15bdf17c17ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47d466473c08847fd7c06c98c3e2d2bb", "srcset": "https://si.imgix.net/bc354db0/uploads/origins/a2eb3919-88a3-4a11-aafc-15bdf17c17ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47d466473c08847fd7c06c98c3e2d2bb, https://si.imgix.net/bc354db0/uploads/origins/a2eb3919-88a3-4a11-aafc-15bdf17c17ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a77de1fae83348d5b0f3781dc674c475 2x, https://si.imgix.net/bc354db0/uploads/origins/a2eb3919-88a3-4a11-aafc-15bdf17c17ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a35d3d97936c200e7ee637cfc56b26ae 3x"}, "body": "こんにちは、ペキオ様のミニキャラの絵がとても好きです。私のオリジナルキャラクター2体のミニキャライラストをお願いしたいです。\n\nキャラクターA：身長181cmの立ち姿。前から見ると短い茶髪で、後ろで腰まであるポニーテールに結んでいる。右目は紫、左目は虹色の青。蛇のように切れ長の瞳孔と鋭い犬歯を持つ。明るく人当たりの良い性格。植物の研究者。下半身は蛇のもの。\n\n右耳の白い羽のイヤリングに注目。\n\nキャラクターB 身長186cm。Aより2歳年下で、白いロングヘア。炎のような色の瞳。物静かだが強烈な人。美人でハンサム。京劇の役者。そこそこ筋肉質。秘書の鳥のような翼を持っている。\n\nアイメイクとリップメイク、そして左耳の黒いタッセルイヤリングにご注目ください。\n\nAとBは幼なじみで、恋愛関係にある。一緒に王国を旅している。\n\nありがとうございました。リクエストにそぐわない場合は、遠慮なくお断りください。\n\nhttps://drive.google.com/drive/folders/13oER8K621h27id0z6EH24UJLttvkPe4w", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mouOKIRU/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2341987, "client_id": 1531284, "vtt_url": null, "th