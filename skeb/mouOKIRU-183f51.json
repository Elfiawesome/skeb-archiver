お世話焼き。右目は茶色、左目は青い色。\n\n【２】\n先輩 (ポニーテールの子、180cm)。表はクールと無口、裏は照れ屋さんの性格です。いつも他の人に世話を焼かれるのでなんか面倒くさいな人。耳の飾りは左耳の方だけに付けてお願い致します。\n\n可能ならば、この2人で「神社」に関するモチーフを入れて、一枚のイラストをお願い致します。楽しい雰囲気で描いて頂ければ大変嬉しいです。その他のポーズや構図などはペキォ様にお任せしたいと思っておりますので、お気軽に描いてください！\n\nもし依頼内容に難しい点か問題点があれば、是非断ってください。\nご検討のほど、宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1zme8Lu3By7Ay44m-CSSQKymAQRRT0M-a?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mouOKIRU/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2341987, "client_id": 350566, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2f26d684/uploads/origins/a956e6db-7d18-4680-a520-b4ccfefc529b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97b561a370a335a9e6f8042d9cb2c5c4", "srcset": "https://si.imgix.net/2f26d684/uploads/origins/a956e6db-7d18-4680-a520-b4ccfefc529b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97b561a370a335a9e6f8042d9cb2c5c4, https://si.imgix.net/2f26d684/uploads/origins/a956e6db-7d18-4680-a520-b4ccfefc529b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73f889b2d1cb9099db088500b641145a 2x, https://si.imgix.net/2f26d684/uploads/origins/a956e6db-7d18-4680-a520-b4ccfefc529b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7779935c154074b2749c984f82cb4b9a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f26d684/uploads/origins/a956e6db-7d18-4680-a520-b4ccfefc529b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff31c2695ad11810e42f1272c3729aa1", "srcset": "https://si.imgix.net/2f26d684/uploads/origins/a956e6db-7d18-4680-a520-b4ccfefc529b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff31c2695ad11810e42f1272c3729aa1, https://si.imgix.n