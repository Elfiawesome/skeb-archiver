-KvBi_faMe9p5iboCmLlr7", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@voc30383714/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3110385, "client_id": 1235038, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d59f929a/uploads/origins/be55dc61-5bad-4578-9fa2-1616102658bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bdfbcf1ef1d9e0e073040db98982c52", "srcset": "https://si.imgix.net/d59f929a/uploads/origins/be55dc61-5bad-4578-9fa2-1616102658bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bdfbcf1ef1d9e0e073040db98982c52, https://si.imgix.net/d59f929a/uploads/origins/be55dc61-5bad-4578-9fa2-1616102658bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a4d38d5c86d5b762d892a9cfcbf76f8 2x, https://si.imgix.net/d59f929a/uploads/origins/be55dc61-5bad-4578-9fa2-1616102658bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2caaca7ba467188033b4aea2ef9bd2c6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d59f929a/uploads/origins/be55dc61-5bad-4578-9fa2-1616102658bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6539194d4ee42477bf19c0414ba2f84", "srcset": "https://si.imgix.net/d59f929a/uploads/origins/be55dc61-5bad-4578-9fa2-1616102658bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6539194d4ee42477bf19c0414ba2f84, https://si.imgix.net/d59f929a/uploads/origins/be55dc61-5bad-4578-9fa2-1616102658bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c428bc8f9185fbf1a0bc3d86d8338fa9 2x, https://si.imgix.net/d59f929a/uploads/origins/be55dc61-5bad-4578-9fa2-1616102658bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d93afb34f2554c98691c083b4d76f4e5 3x"}, "body": "こんにちは、voc先生！\n私をあなたの絵のスタイルがとても好きです。あなたの最新作品はとてもきれいです！私のOCを描いてもらえますか？\n\n私はあなたが描いたかわいい食べ物が大好きです。あなたがデザインした甘いものを画面に追加してほしいです。日本の伝統的なものでも洋菓子でもいいです。\n\nできれば、二人のやり取りを描いてもらいたいです！役柄は以下の通りです。\n\n三夕：水色髪と金色の目をした大正時代のメイドです。陽気で活発、古霊精怪、いたずら好き。リボンは赤と白の四角の模様で、赤の四角には縦線が入っている。服装はエプロンと着物。\n\n三沢:水色髪と金色の目、大正時代の男子学生で、楕円形の眼鏡をかけている。あの娘の相手は苦手だ。喫茶店にはよく来ていて、よくミルクを注文する。なぜあの子がいつも自分に悪戯をするのかよく理解できず、少し気にしている。趣味は読書、特技はツッコミ。\n\n三夕はからかうのが好きで、三沢をからかっています。三沢は彼女の行動を理解しておらず、顔を赤くして相手に突っ込みますが、彼女の行動を拒否することは全くありません。\n\n関係する小物はオブジェでもいいし、明治や大正時代の食べ物でもいい（情景を描く必要がある状況：上記の時代の茶店や場所でもいい）\n\nキャラクターの絵の参考は下のURLにあります！\n\n動作と内容はお任せしますが、二人を自由に描いてください！\n\nよろしければ、最後にpsdファイルを渡してください！\n下書きや作業中のスケッチがあれば、一緒に入れてもらえると嬉しいです。とても気に入っています。ありがとうございます。\n\nこの納品を快く引き受けてくださるなら、とてもありがたく、嬉しいです。字が多くてごめんなさい！読んでいただきありがとうございました！\n\n金額が足りない場合は、安心してキャンセルするか、再送を提出することができます ！私はできる限りのことをします！ ありがとうございます！\n\nhttps://drive.google.com/drive/folders/1Qhy_QO50FZEileNqGOUKNCHhVTH6i3QB?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@voc30383714/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5b284d32/uploads/origins/4d537fbb-9297-4e68-8e25-45b4c8bc0fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e9dbb01d236f5a7ffa75a497061ca5d8", "srcset": "https://si.imgix.net/5b284d32/uploads/origins/4d537fbb-9297-4e68-8e25-45b4c8bc0fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e9dbb01d236f5a7ffa75a497061ca5d8, https://si.imgix.net/5b284d32/uploads/origins/4d537fbb-9297-4e68-8e25-45b4c8bc0fa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d9f8bc71d011144ff2