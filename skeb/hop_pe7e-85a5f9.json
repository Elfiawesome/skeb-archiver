n【使用用途】\nskebに依頼したFA絵として、ほっぺて様のお名前を明記した上でXへ投稿いたします。\nルワ♢ruwaさんのYouTubeやSNSを含む活動にて使用する可能性があります\n・SNSでの投稿\n・収益化済YouTubeチャンネルでの使用\n・配信での使用\n・歌ってみた等の動画での使用\n・サムネイル\n・メンバーシップやFANBOX等の加入者特典としての配布\n・グッズ製作\n\n・可能であれば頭部の切れていない背景透過を頂きたいです。\n\n■特徴\n紫色の瞳に水色の光\n髪色は紫がかった薄いグレーに、毛先が紫色\n鎖骨上のほくろ\n\n何卒ご検討のほどよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hop_pe7e/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3839519, "client_id": 2495946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8920a2c1/uploads/origins/12bb27b6-6f45-4367-acc3-0544c538ef28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e125772c8ddc9c45d5acfa17881ca81", "srcset": "https://si.imgix.net/8920a2c1/uploads/origins/12bb27b6-6f45-4367-acc3-0544c538ef28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6e125772c8ddc9c45d5acfa17881ca81, https://si.imgix.net/8920a2c1/uploads/origins/12bb27b6-6f45-4367-acc3-0544c538ef28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d5ee249b6673b535cee5109398bb622 2x, https://si.imgix.net/8920a2c1/uploads/origins/12bb27b6-6f45-4367-acc3-0544c538ef28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3516d2574670cb49e87f06657cd76f5b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8920a2c1/uploads/origins/12bb27b6-6f45-4367-acc3-0544c538ef28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=294bca0811cd6528b73459d24b103354", "srcset": "https://si.imgix.net/8920a2c1/uploads/origins/12bb27b6-6f45-4367-acc3-0544c538ef28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=294bca0811cd6528b73459d24b103354, https://si.imgix.net/8920a2c1/uploads/origins/12bb27b6-6f45-4367-acc3-0544c538ef28?bg=%23fff