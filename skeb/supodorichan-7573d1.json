loads/origins/023658fb-97f3-477e-9eb0-490e3b8bb8f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=196298ba6f31d48a90b61a5de5a2f193, https://si.imgix.net/533b6a36/uploads/origins/023658fb-97f3-477e-9eb0-490e3b8bb8f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28d2e2ad7feb68f42a45eb0097581652 2x, https://si.imgix.net/533b6a36/uploads/origins/023658fb-97f3-477e-9eb0-490e3b8bb8f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e78973676242dcee7514a84d9e6d2237 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/533b6a36/uploads/origins/023658fb-97f3-477e-9eb0-490e3b8bb8f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e31a963c7611e7a42e907b35c09f5ab7", "srcset": "https://si.imgix.net/533b6a36/uploads/origins/023658fb-97f3-477e-9eb0-490e3b8bb8f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e31a963c7611e7a42e907b35c09f5ab7, https://si.imgix.net/533b6a36/uploads/origins/023658fb-97f3-477e-9eb0-490e3b8bb8f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=31913256c6f83e20967098bd236c0a72 2x, https://si.imgix.net/533b6a36/uploads/origins/023658fb-97f3-477e-9eb0-490e3b8bb8f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=86bc6290d64f9893f70fb150185f4b5f 3x"}, "body": "リクエスト失礼します。\nオリジナルキャラクターの絵をお願いしたいです。\nhttps://imgur.com/a/ABwXofc\n\nすぽどり氏さんのこちらのツイート（https://twitter.com/supodorichan/status/1576141551624867841?s=20&t=fj6wu35I6JyuGzj66xIA1g）がとても好みだったので、このような等身、テイストで絵を描いていただきたいです。\n資料にキャラクターが複数いますが全員描く必要はなく、金額的にも難しいと思うので気になった・描きたいキャラだけで大丈夫です。\n表情やポーズなどはおまかせします。色は金額的に厳しければ塗らなくても大丈夫です。\nすぽどり氏さんがこの金額で描いていいと思える範囲内ですべておまかせします。\n\nキャラクター以外のものを別レイヤーに分けた状態のpsdファイルで納品していただけると嬉しいです。\n描いていただいた絵はSNSのアイコンやヘッダー、自分用のグッズ、他の依頼の際の資料として使用させていただくことがあります。\n依頼内容が金額と見合わない、その他不備などがあればお気軽に再送要請してください。できる限り対応させていただきます。\n難しければキャンセルして大丈夫です。\nもし受けていただける場合は、どうぞよろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@supodorichan/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 752079, "client_id": 2044577, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8be97e5f/uploads/origins/03041192-8cd8-4141-88c1-ac776d78cc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5aabc245439d26afcd30badd476299dc", "srcset": "https://si.imgix.net/8be97e5f/uploads/origins/03041192-8cd8-4141-88c1-ac776d78cc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5aabc245439d26afcd30badd476299dc, https://si.imgix.net/8be97e5f/uploads/origins/03041192-8cd8-4141-88c1-ac776d78cc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=455cadde003946f0c6c66db302e173db 2x, https://si.imgix.net/8be97e5f/uploads/origins/03041192-8cd8-4141-88c1-ac776d78cc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=812a76772d5ae3ad3cf5447c6586bf68 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8be97e5f/uploads/origins/03041192-8cd8-4141-88c1-ac776d78cc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fdc0f163c0a1b31d8fef4dcff66476c3", "srcset": "https://si.imgix.net/8be97e5f/uploads/origins/03041192-8cd8-4141-88c1-ac776d78cc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fdc0f163c0a1b31d8fef4dcff66476c3, https://si.imgix.net/8be97e5f/uploads/origins/03041192-8cd8-4141-88c1-ac776d78cc6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b762baf27b90fb0f583c766872d6c2bb 2x, https://si.imgix.net/8be97e5f/uploads/origins/03041192-8cd8-4141-88c1-ac776d78cc6d?bg=%23fff&auto=format%2Ccompres