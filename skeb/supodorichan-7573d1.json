, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@supodorichan/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 752079, "client_id": 27685, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a8912e7/uploads/origins/10e785e9-825c-42a5-afe1-867c39b926f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98bd4f6ea0779c3ae47fe038dbf4e138", "srcset": "https://si.imgix.net/9a8912e7/uploads/origins/10e785e9-825c-42a5-afe1-867c39b926f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98bd4f6ea0779c3ae47fe038dbf4e138, https://si.imgix.net/9a8912e7/uploads/origins/10e785e9-825c-42a5-afe1-867c39b926f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cfcdea8df44a39f0d24be4021a78ced8 2x, https://si.imgix.net/9a8912e7/uploads/origins/10e785e9-825c-42a5-afe1-867c39b926f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7adc2ef06c76924a25d1231e157bb37a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a8912e7/uploads/origins/10e785e9-825c-42a5-afe1-867c39b926f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6441191057aba743b3aee9723e69f84", "srcset": "https://si.imgix.net/9a8912e7/uploads/origins/10e785e9-825c-42a5-afe1-867c39b926f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6441191057aba743b3aee9723e69f84, https://si.imgix.net/9a8912e7/uploads/origins/10e785e9-825c-42a5-afe1-867c39b926f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e481e9989c2d9e7cb8bc8b081223346c 2x, https://si.imgix.net/9a8912e7/uploads/origins/10e785e9-825c-42a5-afe1-867c39b926f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=edc1f9329ec738411dede547a85550ba 3x"}, "body": "すぽどり様\n\nこんばんは、すぽどり様。\nツイッターから可愛いイラストをたくさん拝見させて頂いてファンになったものです。\nウマたちがすっごく可愛くて！またVたちも…！すぽどり様の絵でのにじさんじの皆さん、とても個性があって可愛くて最高でした！\nそんなすぽどり様がスケブを開いていらっしゃることを知り、もしよろしければこちらのオリキャラのことを依頼したいです。\n\nお願い申し上げたいのはこちらのツイッターのプロフ絵とヘッダーにいる狐娘の万里香（まりか）という子です。\n狐耳と尻尾・赤メガネ・アホ毛、そしてちょっぴりツリ目な目つきが特徴的な、160cmくらいの身長の高校生です。\n本とか、動物や花、星空のような自然をぼーっと見るのが大好きな子です。\n性格的には、ちょっと人見知りで照れ屋ですので人前では余計にクールっぷりしてるけどまた寂しがり屋のちょっと面倒くさい感じです。一人の時や知り合いの前では表情が緩めてちょっと豊かになる感じです。\nこれだけではちょっと説明が足りないと思いますので設定と設定画など、ご参考できそうなものを下のURLにまとめております。\n\nこの娘ですぽどり様の絵柄でのイラストをどうかお願いしたいです。\n構図などはご自由におまかせします！\nこの前のタマちゃんの絵のような、ちょっとおもしろみのあるイラストが良いかな、とだけ思っております。\n塗り方はアニメ塗りでお願いします。\nよろしくおねがいします！\nご検討くださいませ。\n\nお忙しい中、要件のみで申し訳ありません。\n応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@supodorichan/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 752079, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/96561b7b/uploads/origins/6397cb7c-276a-41d6-ac74-94bbc56eea2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29ac6877ae0e9c7b66020f1dd0a507c5", "srcset": "https://si.imgix.net/96561b7b/uploads/origins/6397cb7c-276a-41d6-ac74-94bbc56eea2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29ac6877ae0e9c7b66020f1dd0a507c5, https://si.imgix.net/96561b7b/uploads/origins/6397cb7c-276a-41d6-ac74-94bbc56eea2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b8ba82d62fb57cf601ae30fb3d5e4c5 2x, https://si.imgix.net/96561b7b/uploads/origins/6397cb7c-276a-41d6-ac74-94bbc56eea2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8dc1e11f1638bcb7971901d7914baa7a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96561b7b/uploads/origins