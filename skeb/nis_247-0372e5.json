イセルだけ10年前と変わらない姿で再会します。\nふたりは幼少期に白詰草の指輪を交換したり、また、アルカネットは10年前にアルバイトをしてリュイセルにプラチナの指輪を贈ったりしていますので、そのあたりがキーアイテムになります。\n構図など全て全然にお任せいたします。性格・設定に沿って自由に想像していただけると嬉しいです。\nもし、10年前のアルカネットを描かれる場合は、資料のデフォルメイラストのように肩にかかるように髪を結んだ感じで描いてください。\n\n金額等、何か不足している点がございましたらキャンセルをお願いいたします。\nどうぞよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/7lceskvcakqn7scqr7s2a/AB0HndUmM3C6yolGBNmLsHU?rlkey=n3sgjlabmap66kd9jd5rmrjqp&st=mz92oru2&dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ooo_0926/works/500", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1366068, "client_id": 891909, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35a5a52f/uploads/origins/8e05ebae-ad71-4494-a2d7-80349022acb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffb59638c84d9045bb70b8525050e3eb", "srcset": "https://si.imgix.net/35a5a52f/uploads/origins/8e05ebae-ad71-4494-a2d7-80349022acb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffb59638c84d9045bb70b8525050e3eb, https://si.imgix.net/35a5a52f/uploads/origins/8e05ebae-ad71-4494-a2d7-80349022acb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5073f777c9ffdcfc7b368e357ea4b77b 2x, https://si.imgix.net/35a5a52f/uploads/origins/8e05ebae-ad71-4494-a2d7-80349022acb3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=998b2c6b81a8d87d226290c45634db9c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/35a5a52f/uploads/origins/8e05ebae-ad71-4494-a2d7-80349022acb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24e4ec0402a2512dec5a6b28873431fc", "srcset": "https://si.imgix.net/35a5a52f/uploads/origins/8e05ebae-ad71-4494-a2d7-80349022acb3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24e4ec0402a2512