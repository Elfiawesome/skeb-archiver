rc": "https://si.imgix.net/a808e1cc/uploads/origins/c712903a-cc2d-4afc-bbbe-195961df4ecf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=643243060251d68f64d0a54f89376110", "src_set": ""}, "private": true, "genre": "comic", "tipped": false, "creator_id": 297611, "client_id": 2208409, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@konten_F/works/34", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/39a9f8bf/uploads/origins/d4b0395f-b0be-4857-8c9a-2958096c8486?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b07e305b0a1e80bdd3dc956b448f6b86", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 297611, "client_id": 2825662, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@konten_F/works/33", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 297611, "client_id": 1450960, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/63ec2216/uploads/origins/b2aa82e3-4296-4344-b243-27fde100f24a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33609ba65ddb84df4a40704fb1e360eb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/63ec2216/uploads/origins/b2aa82e3-4296-4344-b243-27fde100f24a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=543cde009d32b2321494baaccc4d3a6b", "src_set": ""}, "body": "こんばんは、新着にてマオルガ様の漫画を拝見させていただいたことがあり、イラストが凄く癖に刺さり、是非漫画を描いて頂きたいと思い、リクエストを送らせていただきました。\n\nよろしければ以下のクトゥルフ神話TRPGのオリジナルキャクターの漫画をお願いしたいです。相方がいるキャラクターで、お相手には許可を取っております。\n\nこちらのキャラクター達の漫画をお願いしたいです。詳しい資料はURL先に記載させていただいております。\n\n内容に関しては、お好きに描いていただけましたら幸いです。\n\n使用用途につきましては、個人的な使用、個人的なグッズの作成などに使わせていただきたいと思っております。\n\nまたうちよそ相手との漫画の共有をさせていただきたいと思っております。\n\nよろしければ、お受けしていただけると大変嬉しいです。もし、金額が足りなければ再送要請いただけますと幸いです。\nお忙しい中Skebを開いてくださっていること本当に感謝しております。どうか、ご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-H384NWGUU4PSA7HSR3kOFqMVJ0UXxQo", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@konten_F/works/32", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 297611, "client_id": 2028742, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a5134583/uploads/origins/028cc45f-8ebb-4b98-8195-256b317b7813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c86ef85c478a3cecb25c716d4b4bc97", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5134583/uploads/origins/028cc45f-8ebb-4b98-8195-256b317b7813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a09d364d9149a40e98bb65be95f4337", "src_set": ""}, "body": "マオルガさん、こんばんは。\nマオルガさんの漫画やイラスト、絵柄が大好きで楽しく拝見させていただいております。いつも応援しています！\n\nさて、早速リクエストさせいただきたいものについてなのですが、TRPGの探索者をお願いできたらと思います。私と友人の探索者です。\n金額の範囲内で自由に描いていただけたらと思います。\n\n彼らは『オルタナティヴダブル』というシナリオの2人ですが、今回のリクエストの内容にシナリオのネタバレはありません。\n資料に立ち絵を複数入れておりますが、シナリオ内で季節が巡るため差分があります。\n\n❏キャラクターについて\n黒髪の方が「山奥にひっそり事務所を構えている探偵」の灰塚志度(はいづか しど)\n31歳173cm\n落ち着きがあって余裕そうな笑顔です。\n(補足)\n着るものにこだわりがあり身なりをきちんと整えています。好奇心が暴走しがちで、興味を持った事象に飛びついては飽きてすぐ次に行ってしまうタイプです。\n\nピンクの髪の方が「事務所に転がり込んで助手になった」淤末幸生(おみ こうき)\n28歳185cm\n元気なタイプで表情豊か、元気なでかい犬みたいな感じです。\n(補足)\nその時の気分で派手な髪色や服装になったり、黒髪とモノトーンになったりする気分屋オシャレお兄さんで、その時々でなんでも着ます。\n\n❏その他(加味しなくても構いません)\n小さな雑居ビルの2階を借りて事務所兼家として使用しています。\n山奥にぽつんとある建物なので裏に勝手に畑を作って野菜を育てたり自由に過ごしています。\n山の麓の小さな町に出て2人で買い物したりもします。\n\n金額や資料に不備がありましたら、また改めてリクエストさせて頂きたいと思います。\nご検討よろしくお願いします。\n\n※画面でエラーが出たので再送させていただきました。重複しておりましたら、大変お手数お掛け致しますがキャンセルをお願い致します。\n\nhttps://drive.google.com/drive/folders/1gxfcixB6eLZYqv0WVpIV5MW3bwSb-MUq", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 242816, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "さり👾", "screen_name": "curry0124", "avatar_url": "https://pbs.twimg.com/profile_images/1790708743023513600/PmZNLdb2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3890866993/1758630880/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 177}, {"id": 529427, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🦔おてん🦔", "screen_name": "if959u", "avatar_url": "https://pbs.twimg.com/profile_images/1406272195551055876/lM_zqnxg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/790832008561692672/1687880086/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 0}, {"id": 967254, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ap1os", "screen_name": "ap1os", "avatar_url": "https://pbs.twimg.com/profile_images/1886313677911203840/_so3PRYs.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1345180934077702144/1715133409/1500x500", "appeal_receivable": true, "popular_creator_rank": 95, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptabl