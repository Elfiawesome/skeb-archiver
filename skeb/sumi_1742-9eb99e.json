をかざし、光魔法の玉を手のひらに収め、今にも敵に発射しそうな感じでお願いします。\nその他、ポーズはあまりこだわらず、トモコの正面が視聴者の方を向いていればOKです。\n魔法を使うトモコをカッコよく演出してください\n\n石川智子参考\nhttps://imgur.com/a/zjCOEhH\n\nhttps://imgur.com/a/zjCOEhH", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sumi_1742/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2497625, "client_id": 18708, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d428b61f/uploads/origins/68166603-0f1e-460f-8d6f-976b88536923?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b84a19bda390a8cee2714995bc20ffc", "srcset": "https://si.imgix.net/d428b61f/uploads/origins/68166603-0f1e-460f-8d6f-976b88536923?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b84a19bda390a8cee2714995bc20ffc, https://si.imgix.net/d428b61f/uploads/origins/68166603-0f1e-460f-8d6f-976b88536923?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ded97f384e954fca1782c54b825a1f67 2x, https://si.imgix.net/d428b61f/uploads/origins/68166603-0f1e-460f-8d6f-976b88536923?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f9cd02adeffc8f8d946fd2401152f42 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d428b61f/uploads/origins/68166603-0f1e-460f-8d6f-976b88536923?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34ade0c428e6c18466283d72990e7e19", "srcset": "https://si.imgix.net/d428b61f/uploads/origins/68166603-0f1e-460f-8d6f-976b88536923?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=34ade0c428e6c18466283d72990e7e19, https://si.imgix.net/d428b61f/uploads/origins/68166603-0f1e-460f-8d6f-976b88536923?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1b541a58d28ab272b63a2f30e560ec18 2x, https://si.im