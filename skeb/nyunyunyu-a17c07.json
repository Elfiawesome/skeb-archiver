at%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6c8ecc1e4b47d9e0f72980139ba633af 3x"}, "body": "こんにちは！\n私のキャラクター「リア」を描いていただけませんか？\n彼女は陰気な学者タイプのダークエルフです。長くて乱れた緑色の髪、疲れたような目、胸は小さめ（Bカップ）で、全体的に細身の体型です。\n\nお好きなように描いてください。\nこれをSNSに使いたいと思っています。\n\n参考画像を添付しました。\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1eCO5-FmPcPOFzeLQzPLdPT5l5hmWzbco?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nyunyunyu/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3950349, "client_id": 731969, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c978dbc2/uploads/origins/75bb8cdc-d08b-4f03-b363-50de273b6f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd3880073addb9e732c645f1a5510bce", "srcset": "https://si.imgix.net/c978dbc2/uploads/origins/75bb8cdc-d08b-4f03-b363-50de273b6f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd3880073addb9e732c645f1a5510bce, https://si.imgix.net/c978dbc2/uploads/origins/75bb8cdc-d08b-4f03-b363-50de273b6f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7105cce44489ea72382346b9b267e7b9 2x, https://si.imgix.net/c978dbc2/uploads/origins/75bb8cdc-d08b-4f03-b363-50de273b6f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09de1f7d6eb0668320e522386be3fc6f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c978dbc2/uploads/origins/75bb8cdc-d08b-4f03-b363-50de273b6f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a065a67d6957cedf1ce35f3abaa1b19", "srcset": "https://si.imgix.net/c978dbc2/uploads/origins/75bb8cdc-d08b-4f03-b363-50de273b6f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a065a67d6957cedf1ce35f3abaa1b19, https://si.imgix.net/c978dbc2/uploads/origins/75bb8cdc-d08b-4f03-b363-50de273b6f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6712eb53a7c8029225388dd785958c9d 2x, https://si.imgix.net/c978dbc2/uploads/origins/75bb8cdc-d08b-4f03-b363-50de273b6f5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f7a5e8cf576483011d064a80a2738005 3x"}, "body": "こんにちは。資料のキャラクターを描いていただきたいです！\n投稿されている絵の雰囲気で、尖っててギラギラしたメカの描き方が好きなので、\nカッコ良い邪悪な暗黒騎士っぽい雰囲気全振りで描いて欲しいです！\n細部のディティールは変えていただいて大丈夫です。その他は特に指定はありません。\n\n以下キャラ設定\n\n名前：墓守\n墓地を徘徊している黒い鎧をまとった兎の亡霊。\n毎日決まったルートで墓地を巡回しており、墓守と呼ばれている。\n\n生者には全くを興味を示さない。\n逢魔時、墓地に発生する悪霊を剣で切り裂き炎で焼き払う。\n\n日が昇ると墓地の丘の上に生えている木で\n崩れ落ちるように寄りかかり、休む。\n\n稀に戦闘が長く続いた結果、己の炎が暴走して止まらなくなることがあるが、\n対象を燃やし尽くした後に、体に巻き付くベルトでぐるぐるに縛られて\n封印状態に入り、しばらく動かなくなる。\n\n墓地の中の一番大きい墓の前で\n跪いている様子をしばしば目撃されている。\n\nhttps://drive.google.com/drive/folders/1JU8KyUgusKriMyLliy2h9UMU08pY0_4p?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nyunyunyu/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d074fa08/uploads/origins/ec941e32-dcd2-42fb-92f7-48df563865a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7fb7906f70f687229361566588d81990", "srcset": "https://si.imgix.net/d074fa08/uploads/origins/ec941e32-dcd2-42fb-92f7-48df563865a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7fb7906f70f687229361566588d81990, https://si.imgix.net/d074fa08/uploads/origins/ec941e32-dcd2-42fb-92f7-48df563865a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8026e0d0a05aac7fecca48b4a04d8e60 2x, https://si.imgix.net/d074fa0