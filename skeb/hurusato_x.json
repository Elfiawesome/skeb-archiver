の上にロゴや画像を追加する可能性があります)\n・チャンネルは収益化予定です(今はまだ目標です)\n\n◎その他◎\n・PSDデータでキャラクターと背景のレイヤーを分けていただけると嬉しいです。\n・PSDが厳しければ、背景ありのものと、背景透過したキャラクターのＰＮＧの画像をいただけると助かります。\n\nご検討、よろしくお願いいたします。\n\n大粒グミエナ", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hurusato_x/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b368110b/uploads/origins/d98cda2c-aae7-4c99-85fd-2c179d5825c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=18dab937a2da72614a5e0616bf69204c", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2064005, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hurusato_x/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2064005, "client_id": 2557791, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f71d747/uploads/origins/141fcbec-2d2d-4d53-8367-5caa6ceaf44a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7857dc77b0bbfba7173434b4d1f93b65", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f71d747/uploads/origins/141fcbec-2d2d-4d53-8367-5caa6ceaf44a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f78fb7d22e573d1d68b561bc2bc3fd2f", "src_set": ""}, "body": "こんにちは、先生、私は台湾の Vtuber、蝶の修道女です。Twitter で先生の透明感のある美しい画風に惹かれました。先生に全身イラストを描いてもらいたいと思いました。表情や動きを使ってください。ご自由に、導いていただければ幸いです シンプルな背景でのご利用：SNS、YouTube、Twitter、商品制作などに使用します キャラクターと背景のPSDレイヤーを分けていただければ幸いです キャラクター設定上の注意点：白いハイライトと蝶に注目してください日本語が分からず数も少ないので髪にアンテナが立っています。skebを使用してください。不配慮な点がありましたらご