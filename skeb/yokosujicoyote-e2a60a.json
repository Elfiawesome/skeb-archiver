ばモザイクはかけないでください。\n\n宜しくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@pm9e5QWzMk/works/68", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3190900, "client_id": 1181479, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b056d38a/uploads/origins/5e1bdbb7-548a-4ce3-95f0-93b35bbb3592?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48209352e69ee3804f2c5318b8aa3247", "srcset": "https://si.imgix.net/b056d38a/uploads/origins/5e1bdbb7-548a-4ce3-95f0-93b35bbb3592?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48209352e69ee3804f2c5318b8aa3247, https://si.imgix.net/b056d38a/uploads/origins/5e1bdbb7-548a-4ce3-95f0-93b35bbb3592?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1c0e13e01db154c1ee3758bf0c201074 2x, https://si.imgix.net/b056d38a/uploads/origins/5e1bdbb7-548a-4ce3-95f0-93b35bbb3592?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c2e64fa26b2ec116a2090dd8dc1a612 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b056d38a/uploads/origins/5e1bdbb7-548a-4ce3-95f0-93b35bbb3592?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ccf43cf59879dc630fa3893aca94cc3", "srcset": "https://si.imgix.net/b056d38a/uploads/origins/5e1bdbb7-548a-4ce3-95f0-93b35bbb3592?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ccf43cf59879dc630fa3893aca94cc3, https://si.imgix.net/b056d38a/uploads/origins/5e1bdbb7-548a-4ce3-95f0-93b35bbb3592?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dc8b6b00513c840901f3d5b36e1f549e 2x, https://si.imgix.net/b056d38a/uploads/origins/5e1bdbb7-548a-4ce3-95f0-93b35bbb3592?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&cro