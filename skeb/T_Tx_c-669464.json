◎イラスト概要\n可能であれば、背景透過のものも頂きたいです。\n表情は、口を閉じてほほえんでいるものでお願いします。\nポーズは、おしとやかで女の子らしいものでおまかせさせて下さい。\n\n◎キャラクター詳細\n・髪は、表面が青、インナーが焦げ茶のアンブレラカラー(表面の青色部分多め)\n・前髪は眉下パッツン気味で、触角以上姫カット未満の髪がある。長さは胸の下あたりまであり、ゆるく巻いてある。\n・並行下がり眉\n・丸目\n・焦げ茶色の瞳に青色のカラコン\n・両耳に小さめのリングピアス(シルバー)🐱\n\nhttps://twitter.com/omuraisu_mmm/status/1667197726646480897?s=46&t=wEEZNWy1o8ABF7BFNzT6KQ", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@T_Tx_c/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1251601, "client_id": 2274908, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bfe71839/uploads/origins/458e197d-1814-43fc-869c-7155a06cfdbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0fa5cf9ebc65150ee07818a334d6f09", "srcset": "https://si.imgix.net/bfe71839/uploads/origins/458e197d-1814-43fc-869c-7155a06cfdbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0fa5cf9ebc65150ee07818a334d6f09, https://si.imgix.net/bfe71839/uploads/origins/458e197d-1814-43fc-869c-7155a06cfdbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f45b67aed09a0bbe7d7042495a13e18a 2x, https://si.imgix.net/bfe71839/uploads/origins/458e197d-1814-43fc-869c-7155a06cfdbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b19ef3cd03b8756fd6df4748ba0b08f6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bfe71839/uploads/origins/458e197d-1814-43fc-869c-7155a06cfdbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb8ad691a8259620c2ed1135384a2891", "srcset": "https://si.imgix.net/bfe71839/uploads/origins/458e197d-1814-43fc-869c-7155a06cfdbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb8ad691a8259620c2ed1135384a2891, https://si.imgix.net/bfe71839/uploads/origins/458e19