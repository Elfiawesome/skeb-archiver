ただければと思い、PSDファイルでいただければと思います。\n\n特殊な構図ですので難しければ申し訳ありません。\n\n是非よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1ti9Ohf1nMcxhaH1yKyJmrDD89TXvn0jP", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mariyo_siki/works/40", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2606481, "client_id": 3647603, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a935e0c8/uploads/origins/8721eb1a-5c6a-48a0-9aa1-0cf885a3aef8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41ca3d657ae520d35cd523881cf6486b", "srcset": "https://si.imgix.net/a935e0c8/uploads/origins/8721eb1a-5c6a-48a0-9aa1-0cf885a3aef8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41ca3d657ae520d35cd523881cf6486b, https://si.imgix.net/a935e0c8/uploads/origins/8721eb1a-5c6a-48a0-9aa1-0cf885a3aef8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff71b68047c58599f076082e275f4df8 2x, https://si.imgix.net/a935e0c8/uploads/origins/8721eb1a-5c6a-48a0-9aa1-0cf885a3aef8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28a8c51f9c2ba70966a1d653e0de3bb0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a935e0c8/uploads/origins/8721eb1a-5c6a-48a0-9aa1-0cf885a3aef8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03782c749a9260435e07d16ac5416328", "srcset": "https://si.imgix.net/a935e0c8/uploads/origins/8721eb1a-5c6a-48a0-9aa1-0cf885a3aef8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=03782c749a9260435e07d16ac5416328, https://si.imgix.net/a935e0c8/uploads/origins/8721eb1a-5c6a-48a0-9aa1-0cf885a3aef8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c097cb654ca2f89c03c8b25a87f31b7a 2x, https://si.imgix.net/a935e0c8/upload