で、少し生意気なタイプです。お世話焼き。右目は茶色、左目は青い色。\n\n【２】\n先輩 (ポニーテールの子、180cm)。表はクールと無口、裏は照れ屋さんの性格です。いつも他の人に世話を焼かれるのでなんか面倒くさいな人。耳の飾りは左耳の方だけに付けてお願い致します。\n\n可能ならば、この2人で「春」のモチーフを入れて、一枚のイラストをお願い致します。穏やかな雰囲気で描いて頂ければ大変嬉しいです。その他のポーズや構図などはれも様にお任せしたいと思っておりますので、お気軽に描いてください！\n\nもし依頼内容に難しい点か問題点があれば、是非断ってください。\nご検討のほど、宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1zme8Lu3By7Ay44m-CSSQKymAQRRT0M-a?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@lemo_backyard/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2424496, "client_id": 193145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/40efe138/uploads/origins/b688eb6e-5ba9-45e7-879c-9aae6fff82d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d20538e5bb610c23525e8b9656918e2", "srcset": "https://si.imgix.net/40efe138/uploads/origins/b688eb6e-5ba9-45e7-879c-9aae6fff82d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d20538e5bb610c23525e8b9656918e2, https://si.imgix.net/40efe138/uploads/origins/b688eb6e-5ba9-45e7-879c-9aae6fff82d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e9fa32c864da908cb3306a394cb55a1e 2x, https://si.imgix.net/40efe138/uploads/origins/b688eb6e-5ba9-45e7-879c-9aae6fff82d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ce4d4d687bcf806ec0e1d817a005a0c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/40efe138/uploads/origins/b688eb6e-5ba9-45e7-879c-9aae6fff82d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b9327f855e13da23a7f73777d721d21", "srcset": "https://si.imgix.net/40efe138/uploads/origins/b688eb6e-5ba9-45e7-879c-9aae6fff82d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b9327f855e13da23a7f73777d721d21, ht