了直後に撮影したら何故かそこそこ広範囲に広がってた謎の恥ずかしい黄色いシミ(※同じくレイヤー分けで、絶対NGでない限り是非入れて頂きたいです・・・！！)\n・同じくクロッチにほんの数本、縮れた抜け陰毛の差分\n\nパンツはダヴィちゃんが穿いてそうなもの、あるいは脱衣テトリスのような白紐パンで、紐パンの場合、解けた両端の紐をつまんで旗のように掲げてほしいです\n(ネームプレートネタをやって頂くならこちらの方がやりやすいかも知れません)\n衣装も、おしがまリングフィットの直後感が出るようにあの配信のサムネのようなウェアがよいですが必須ではないです\nまた、できればボトムスを脱いだノーパンの下半身がMtUウィルス構図のようにローアングルでアナルまで丸見えだととてもたすかります(ハロウィンのような陰毛あり/なし差分ありますとありがたいです)\n\n\n以上、何卒ご検討のほどよろしくお願いいたします！！", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Arato02/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1958, "client_id": 154780, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d5bd234/requests/101874_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fb9532ae1b9e3ecc8b9ecc82caa192e", "srcset": "https://si.imgix.net/3d5bd234/requests/101874_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fb9532ae1b9e3ecc8b9ecc82caa192e, https://si.imgix.net/3d5bd234/requests/101874_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ce340b3b425f40fd5f7022935d64a9c3 2x, https://si.imgix.net/3d5bd234/requests/101874_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7b82c13aa2afb7726ea5971d555ce5f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d5bd234/requests/101874_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=125df5bbdf922a3bb3bd9a3d58269b88", "srcset": "https://si.imgix.net/3d5bd234/requests/101874_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=125df5bbdf922a3bb3bd9a3d58269b88, https://si.imgix.net/3d5bd234/requests/101874_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=133bd835c2d9bcb3a0ed9a22208a82b1 2x, https://si.imgix.net/3d5bd234/reques