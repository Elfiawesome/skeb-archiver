 false, "total_appeals_count": 0, "received_works": [{"path": "/@nendo_n/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3823982, "client_id": 1740302, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/adac37f0/uploads/origins/8f934acf-ce7b-4104-80f8-d6f46fc7b323?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14c46e1e3938b6fced0628adc893ea16", "srcset": "https://si.imgix.net/adac37f0/uploads/origins/8f934acf-ce7b-4104-80f8-d6f46fc7b323?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14c46e1e3938b6fced0628adc893ea16, https://si.imgix.net/adac37f0/uploads/origins/8f934acf-ce7b-4104-80f8-d6f46fc7b323?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9201ddd985cd68bf475ddc375af1aa47 2x, https://si.imgix.net/adac37f0/uploads/origins/8f934acf-ce7b-4104-80f8-d6f46fc7b323?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8916e2ffb6edaabe02874ff89afcf713 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/adac37f0/uploads/origins/8f934acf-ce7b-4104-80f8-d6f46fc7b323?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2329be5dc097d31e2befc6b69fd71d72", "srcset": "https://si.imgix.net/adac37f0/uploads/origins/8f934acf-ce7b-4104-80f8-d6f46fc7b323?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2329be5dc097d31e2befc6b69fd71d72, https://si.imgix.net/adac37f0/uploads/origins/8f934acf-ce7b-4104-80f8-d6f46fc7b323?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a814650c9c2adf40659e2b1cb7cc1cf9 2x, https://si.imgix.net/adac37f0/uploads/origins/8f934acf-ce7b-4104-80f8-d6f46fc7b323?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a0d21fca7fff8e7b63cd20b00bb4dfd0 3x"}, "body": "円藤エヌ先生、こんにちは\n先生の漫画が好きので、このリクエストを送りました。  もし宜ければOCカップルのイラストをお願いしたいです。 \n\nイラスト使用目的としては私的利用の範囲内となります。イラストを使ってグッズ(カード、コースター）作りますが、販売するわけではなく、自分で使うだけです。   \n\nキャラクター:  \n攻め  \n晃(あき)、21歳、181cm、理学部、ジブリ好き、写真を撮るのが好き  優しく、気持ちが安定している人です。 周りの世話をすることに慣れています。親切だが、実際には人との間に界線があり、誰もが本当の彼にアクセスできるわけではありません ゲイではないが、知らないうちに悠真を好きになってしまった。   \n\n受け  \n悠真(ゆうま)、20歳、178cm、商学部、ドラム好き、旅行が好き  ゲイです。 髪が赤いので、男性たちから見ると近づきにくく、ちょっと危険な人です。でも、顔がかわいい、女の子たちの間ではよく話題になっています、人気が高いです。  少し内向的だが、自分の考えを誠実に表現します。 一度決心したら実現に努力します。   \n\n資料：\nhttps://drive.google.com/drive/folders/1-2FjRC3vjaElyMN9qXnj1GDVmD8D2qMf\n (petitster先生がアップした自用テンプレートを使ったocイメージ図、petitster先生の許可を得ました）\n\nシーン:\n喫茶店でデザートを一緒に食べる二人\n\n服、構図、ポーズなとは自由に決めてください。\nよろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nendo_n/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3823982, "client_id": 3824303, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/261662d8/uploads/origins/e4264bfe-2962-4d62-8607-e501161e5ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f513a1d972d5c752c339f7fc69fc6cf0", "srcset": "https://si.imgix.net/261662d8/uploads/origins/e4264bfe-2962-4d62-8607-e501161e5ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f513a1d972d5c752c339f7fc69fc6cf0, https://si.imgix.net/261662d8/uploads/origins/e4264bfe-2962-4d62-8607-e501161e5ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a737a2a0c23bd02fdfa91952d914ade 2x, https://si.imgix.net/261662d8/uploads/origins/e4264bfe-2962-4d62-8607-e501161e5ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e9f38f8b57be0500641a79826a8c13a9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/261662d8/uploads/origins/e4264bfe-2962-4d62-8607-e501161e5ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42c55a0fedea1c1d9675f055dedc5e21", "srcset": "https://si.imgix.net/261662d8/uploads/origins/e4264bfe-2962-4d62-8607-e501161e5ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42c55a0fedea1c1d9675f055dedc5e21, https://si.imgix.net/261662d8/uploads/origins/e4264bfe-2962-4d62-8607-e501161e5ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=872a6ee9cf8ae291f3193221c508dea3 2x, https://si.imgix.net/261662d8/uploads/origins/e4264bfe-2962-4d62-8607-e501161e5ec5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5c41efe85bc205a6ae6a2a5987d6da98 3x"}, "body": "エヌさん、こんにちは。\nスケブ受けてくださってありがとうございます。\nどういう風に依頼していいのか分からないので、不適切な点があったらごめんなさい。\nまた分かりにくかったり面倒だったら適当に変えていただいても問題ありません。\nエヌさんに描いていただいた絵が欲しい!!というのが一番なので…\n\n希望はずばりエヌさんの壁を詰めたカプが見たいです!!\n\nそういう漠然としたものはNGでしたら、樹＆光か「ひばりが鳴いたらつかまえて」の榎本＆志村のどちらか描きやすいほうでお願いします。\n1人限定であれば、樹か榎本でお願いしたいです！\n\n服装などは自分で考えると決まりきったものしか出てこないので、それもお任せでお願いしたいです💦\n強いて言うならリンクコーデとかしミラールックとか…\n\n全てぼんやりですが、どうぞよろしくお願いします。\n公開非公開などその他細かいことはエヌさんのいいようにしていただければ…\nもたもたしているうちに締め切りになりませんように!!\n\n随分寒くなってきたので(北はもっとでしょうね)温かくしてお過ごしくださいね。\nずっと大好きです🩷", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 27173, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ダムるし🐣", "screen_name": "e_damurushi", "avatar_url": "https://pbs.twimg.com/profile_images/1622962311001669632/h4idMXf0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3678953592/1749384859/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 161}, {"id": 1290605, "creator": true, "nsfw_acceptable": false, "acc