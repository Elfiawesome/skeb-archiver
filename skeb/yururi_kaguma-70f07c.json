ものを掲載したいです。\n・制作していただいたデザインを自分で描きたいです。未明様のデザインをできるだけ忠実に再現していきますが、若干の調整が入ってしまうことをご了承ください。商用利用も検討しています。その際は必ず未明様のデザインであることを明記いたします。\n\n◆納品形式、サイズについてはお任せいたします。\n\nご検討のほどよろしくお願いします。\n\nhttps://x.com/yururi_kaguma/status/1985873435776762220?s=61&t=ylPu7eQGbjkdy4a-CEciOw", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@orishiga9/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3285324, "client_id": 3652240, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a5a42b25/uploads/origins/082afa32-4709-433b-9e3f-ba4a0771f061?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70a50bf610459704780944e8dc9a8720", "srcset": "https://si.imgix.net/a5a42b25/uploads/origins/082afa32-4709-433b-9e3f-ba4a0771f061?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70a50bf610459704780944e8dc9a8720, https://si.imgix.net/a5a42b25/uploads/origins/082afa32-4709-433b-9e3f-ba4a0771f061?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9d60d5238f8549c2948bfa06152fb90 2x, https://si.imgix.net/a5a42b25/uploads/origins/082afa32-4709-433b-9e3f-ba4a0771f061?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f5187ee0915c78afe01c824c812e1338 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5a42b25/uploads/origins/082afa32-4709-433b-9e3f-ba4a0771f061?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df140abefa7998a583f2314d792df628", "srcset": "https://si.imgix.net/a5a42b25/uploads/origins/082afa32-4709-433b-9e3f-ba4a0771f061?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df140abefa7998a583f2314d792df628, https://si.imgix.net/a5a42b25/uploads/origins/082afa32-4709-433b-9e3f-ba4a0771f061?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2