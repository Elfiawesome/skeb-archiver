es.catbox.moe/hmkq9i.png\n名前は \"エンノイア\"\n\"ゼリア \"同様、特徴のない体型のままです。うまく伝わるかわからないが、体と髪は光るようになっている。正確にはグレーではない。今回はシルバーに近い配色のはずだ。\n見ての通り、オレンジ色のスカーフを巻いていて、髪は後ろで2回編み込んでいる。まるで「アグネス」のようだ！\nhttps://files.catbox.moe/huax0a.jpg\n彼女の背後には虹がかかっている。彼女の神聖な力が投影されている。\nいつもありがとうございます！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ss01764669/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3469532, "client_id": 1169301, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5a7b031/uploads/origins/6dc6fbe3-fe04-44eb-b054-5984b9ed8d21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67e90257e34b666a822e38eb94af17df", "srcset": "https://si.imgix.net/d5a7b031/uploads/origins/6dc6fbe3-fe04-44eb-b054-5984b9ed8d21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67e90257e34b666a822e38eb94af17df, https://si.imgix.net/d5a7b031/uploads/origins/6dc6fbe3-fe04-44eb-b054-5984b9ed8d21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=210928fc878cc006c58eb7f2ff61c429 2x, https://si.imgix.net/d5a7b031/uploads/origins/6dc6fbe3-fe04-44eb-b054-5984b9ed8d21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72a8bd0b1fa3fe372291bb2b86abd953 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5a7b031/uploads/origins/6dc6fbe3-fe04-44eb-b054-5984b9ed8d21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c8a9b9495d3859a6667996a4a082a61", "srcset": "https://si.imgix.net/d5a7b031/uploads/origins/6dc6fbe3-fe04-44eb-b054-5984b9ed8d21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c8a9b9495d3859a6667996a4a082a61, https://si.imgix.net/d5a7b031/uploads/origins/6dc6fbe3-fe04-44eb-b054-5984b9ed8d21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2