ls_count": 0, "received_works": [{"path": "/@Japaneseumbrell/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3462528, "client_id": 2756128, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8271ec28/uploads/origins/0e98685d-86d4-485f-9258-1741ebf89608?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b91942f53a052f30a1594a6849bc859", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8271ec28/uploads/origins/0e98685d-86d4-485f-9258-1741ebf89608?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47eda55699b35175e3cee2c220cd6b7c", "src_set": ""}, "body": "お世話になっております。リクエストさせていただきます。\n現在ニコニコ動画にあげているカフェ巡りの動画にアイキャッチとして使用するイラストの依頼をお願いしたいのですが可能でしょうか？\nご検討お願いいたします。\n参考URL：https://www.nicovideo.jp/series/464934\nリクエスト詳細としては下記になります。\n\n・キャラクター：京町セイカ\n・珈琲を飲んでいる構図(詳細はお任せしたいです)\n・服装はお任せします\n・縁有メガネ着用\n・背景の一部にタイトルを載せていただきたいです(タイトルは「セイCafe Tour」となります)\n・アス比を16：9となるサイズ", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Japaneseumbrell/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3462528, "client_id": 3740162, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c064808d/uploads/origins/b18fcfbc-e32d-477a-8086-e33afc805c0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70306aefac96493b7b7b81a5ffe1e984", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c064808d/uploads/origins/b18fcfbc-e32d-477a-8086-e33afc805c0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b091ccf19f97e0785c39b751d201099d", "src_set": ""}, "body": "拝啓　近年稀に見る宝石の様な和傘（@Japaneseumbrell）様こんにちわ！\n　最近休日が増えたので久々に拝見したところ、イラストや動画編集にグラインダーで磨きをかけたが如く輝きが増した事に感動して今回はお願いに参りました。\n　もう随分古いのですが【Frostpunk】きりたんと素敵なユートピアをつくりましょう。【Part１】というニコニコ動画に投稿されている動画の３分４０秒からはじまる小話の下り、東北きりたんが味のしないスープを提供してくれるシチュエーションのイラストを描いて欲しいです。\n　\n　当時私は恥ずかしがり屋でパブリックにSNSを公開していなかった事が一因か、ファンアートを頂いた経験がございません。\n　そこで私の大好きな和傘（@Japaneseumbrell）様から頂ければ大変嬉しく思います。\n　これからも応援しております。　敬具", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Japaneseumbrell/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3462528, "client_id": 1716292, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c0d1e0f/uploads/origins/7d599727-d4cb-4862-942a-bc8783806581?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5efed86309ee6d0a43e35f6d9bb456c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c0d1e0f/uploads/origins/7d599727-d4cb-4862-942a-bc8783806581?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c69bc98132296671cad0db8b2df4c488", "src_set": ""}, "body": "こんにちは。普段ニコニコ動画で動画を投稿しているFujiと申します。\n\n今回リクエストさせていただきたいのが、双葉湊音のイラストをお願いしたいです！\n\n●構図\n制服に野球帽でメガホンを持って応援している双葉湊音\n\n●使用用途\n双葉湊音でMrs. GREEN APPLEさんの曲「ライラック」のカバー曲を作成しているので、そちらの動画とサムネで利用させていただきたいです。\n\nこちらの楽曲です\nhttps://www.youtube.com/watch?v=-NFhRWhkp7I\n\nお忙しいところ、お手数ですが、ご検討いただけますと幸いです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Japaneseumbrell/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3462528, "client_id": 2772246, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a5568bba/uploads/origins/72354e34-64f4-416d-bfc1-377b0db760a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a7f0f6df89f3620123dbb4372c7c29b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5568bba/uploads/origins/72354e34-64f4-416d-bfc1-377b0db760a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2323b04dbe93c439c0f32aa8fc22c2c3", "src_set": ""}, "body": "またまたこんにちは！あなたのスケブが好調で本当に嬉しいです^_^ ！また作品を依頼してもよろしいでしょうか？\n\n僕とパートナーのアキを主人公にした日本のお正月の作品をお願いします。私は日本に行ったことがないので、お正月の習慣に詳しくないんです。自由にシーンを描いて、お正月にふさわしい服装を選んでください。\n\nお正月までに描く必要はないので、焦らず、無理をせず、ゆっくり描いてください！\n\nこのアイデアを楽しんでください！\n\nhttps://drive.google.com/drive/folders/1IFBkw29PHQJ9wPRs9HhuQ7uCQmAPmC2L", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Japaneseumbrell/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3462528, "client_id": 1921440, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4fd7a9db/uploads/origins/9c8742a3-82de-4edf-9195-0a42c3c0607a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34f71fedd2dac5a5b30cddb334776d28", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4fd7a9db/uploads/origins/9c8742a3-82de-4edf-9195-0a42c3c0607a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b5580b4f7fc204d455a01647c58d084e", "src_set": ""}, "body": "こんにちは、たくさんのキャラクターのかわいいアートワークを拝見しました！FF14の私のOCキャラクターのアートワークを作ってくれたら嬉しいです。私のOCの名前はアキ。お姉さんオーラを出している女性です。趣味はお茶と日本酒と読書。絵のイメージは特にないので、お任せします。\n\nhttps://drive.google.com/file/d/1QECOUfX-fU3t5JhGlIKFP2COSQg9y0K6/view?usp=drive_link", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Japaneseumbrell/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3462528, "client_id": 2030372, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a02a59cd/uploads/origins/3ce0d052-9d00-4dc4-ae3c-2f5b354b6047?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ccf8db719250ab430df19b70c67b3d5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a02a59cd/uploads/origins/3ce0d052-9d00-4dc4-ae3c-2f5b354b6047?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38d9fec589e820cc724c8129be07609a", "src_set": ""}, "body": "こんにちは！\n\nあなたの絵はとてもかわいいです！私の友達のピンクのキツネを描いてほしいです！とても小悪魔でいたずら好きです。表情は参考資料のような感じでお願いします！ポーズや背景はお任せします。ありがとうございました！\n\nhttps://drive.google.com/file/d/1Rqs73_9PfZ7HzxZ8uAy78OtoDuwl4ob7/view?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Japaneseumbrell/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3462528, "client_id": 3360156, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d4b89d45/uploads/origins/8e5df4df-49e7-4a8a-bb8a-29975065d7ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f99d6267edd0db60e888c277449acf03", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d4b89d45/uploads/origins/8e5df4df-49e7-4a8a-bb8a-29975065d7ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db2ac5f9a2dae69728ec6d331db20133", "src_set": ""}, "body": "こんにちは、あなたの画風はとてもかわいいと思いました！\n七草なずな」（コール・オブ・ザ・ナイトより）のバニーガール姿と、クラシカルな髪型、そしてできれば缶ビール「サッポロ」を持っている姿を描いてほしいです。\nその他、絵に似合いそうなものがあれば、何でも追加してください！\n絵を見るのが楽しみです！\nハッピーホリデー", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Japaneseumbrell/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3462528, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b02f77e/uploads/origins/d132761e-4cb9-42e0-93c1-559634175943?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc8f852b724dc11c8a700f0e1dfe8233", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b02f77e/uploads/origins/d132761e-4cb9-42e0-93c1-559634175943?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2db1d8f4887b599efeb7d094d360fc75", "src_set": ""}, "body": "Xなどで使用できるアイコンを依頼したいです。\n\n髪色は薄ピンクで、ふわふわとしたミディアムショートの女の子でお願いします。\nグレーのフード付きパーカーを着用。\n少しやさぐれてるようなイメージで、タバコなどを持たせていただけると嬉しいです。\n\n瞳の色は緑でお願いします。\n\n背景やポーズなどはお任せいたします。\nぜひよろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Japaneseumbrell/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3462528, "client_id": 313621, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb1dbcf2/uploads/origins/16c1119b-7c1f-4786-bc36-c39273eaef7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58de06468dfcfac0c33935dc7f3b557b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cb1dbcf2/uploads/origins/16c1119b-7c1f-4786-bc36-c39273eaef7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=697a8f4d27837bbc5e5fb26003357372", "src_set": ""}, "body": "はじめまして！クアルと申します。\nよければ私のVRCのアバターでご自由に一枚お願いいたします。\n\n画像資料\nhttps://drive.google.com/file/d/1dJtCQ2VEymM_gNFYHnqKXxsLraDDyKDq/view?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Japaneseumbrell/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3462528, "client_id": 3146262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5ee935cc/uploads/origins/25137c54-f476-4310-9e0d-213e7b4aa6ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=87b19831b5541450e0a59650e6503e1c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5ee935cc/uploads/origins/25137c54-f476-4310-9e0d-213e7b4aa6ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f90b55358e55e0eb91ddc7a8dc5f9c05", "src_set": ""}, "body": "こんにちは！あなたのハンバーガーを食べているキャラクターの最初のスケブを見ました！私の2人のOC、JossalineとJaycoのコミッションをぜひお願いしたいです。\n\n-Jossalineはコヨーテの耳と尻尾を持つカウガールで、いたずら好きだけど根は心優しい。\n-ジェイコはコヨーテの耳と尻尾を持つカウボーイで、内気で控えめだが、密かに人を思いやることを楽しんでいる。\n\nポーズや表情、セッティングはアーティストにお任せします！\n依頼をご検討いただき、ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1SBCilDOVGhj1yurmFwp_xiVT7jH-Awhy?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Japaneseumbrell/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3462528, "client_id": 300145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c0010ad/uploads/origins/53defb62-bda7-460a-8b55-e0debbc7197f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e81faa95e067b5265869eb5b38d4914e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8c0010ad/uploads/origins/53defb62-bda7-460a-8b55-e0debbc7197f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b3bb010394371496b7f0e9cdd37fc05", "src_set": ""}, "body": "オレンジ色のビキニを着た私のオリジナルキャラクターを描いてください。セクシーなポーズで。\n目の色：グレー\n\n身長: 5'9 \"\n\n年齢: 20\n\n犬耳\n\nアクセサリー：赤い首輪\n\n背景: ビーチ\n\nポーズ: セクシー\n\n表情：浮気\n\n私のオリジナルキャラクターの参考文献はこちら: https://www.deviantart.com/citrusanime/art/My-Offical-DA-Mascot-290687270\n\n他のアーティスト 1. https://sta.sh/023ht6z36vqf 2. https://sta.sh/0278r2mg6ixd 3. https://sta.sh/0k1ja8v3adq\n\nポーズの参考文献 1. https://sta.sh/0ufsyy8di0d 2. https://sta.sh/0sozjsty4p7 3. https://sta.sh/01hzsy3ciyyy\n\nセクシーに描いてください。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Japaneseumbrell/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3462528, "client_id": 2772246, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2ffe3a7c/uploads/origins/8bddb997-7335-481b-a359-9b9501addea9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d312b9e0751a5c619d5a8b4ef7f521f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2ffe3a7c/uploads/origins/8bddb997-7335-481b-a359-9b9501addea9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4b2a9bfbec9f578c297bbc9656e08f1", "src_set": ""}, "body": "こんにちは、はじめまして。\n\n私のマチを描いていただけませんか？\n\nマチはライオンのような尻尾を持った、かわいくて自信に満ちた猫娘です。彼女はヘテロクロミア（異色症）で、片目がピンク、片目がブルー、そしてピンクの目の下に赤いスジがあります。遊び好きで元気いっぱいだが、すぐに照れてしまう。\n\n楽しいことが大好きで、みんなと一緒にいることを楽しんでいるが、シャイな一面もあり、その場に立たされると赤面してしまう。甘くお茶目な雰囲気が、彼女をチャーミングで愛らしくしている。内心ちょっと恥ずかしがり屋なところもあるが、彼女の自信は輝いている。\n\nポーズや全体的なデザインはお任せしたいです！私はあなたの芸術的なビジョンを信頼し、あなたが彼女の個性をどのように解釈し、彼女に命を吹き込むかを見るのが楽しみです。あなたのセンスと創造性を作品に自由に加えてください！\n\nご検討ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1DV0JGH7KKG4pdMn8mVHq0_1nlilXQNHn", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 106153, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "鰐三てあむ", "screen_name": "RAIKAN_RIKANTO", "avatar_url": "https://pbs.twimg.com/profile_images/1959157445345124356/k6ixvJ84.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2367402313/1715426725/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_a