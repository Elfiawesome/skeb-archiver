15-451f-b748-24d4559050ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a54901179e55967adb66ccc2a75a5c2, https://si.imgix.net/4abb040e/uploads/origins/6dfb14a4-5215-451f-b748-24d4559050ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d782de3b8f76b793b2775297b47df3d 2x, https://si.imgix.net/4abb040e/uploads/origins/6dfb14a4-5215-451f-b748-24d4559050ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60e1de39b5401610ddcd01c159d29009 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4abb040e/uploads/origins/6dfb14a4-5215-451f-b748-24d4559050ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4202a87cd3a905b6eaf370a4cf92fac", "srcset": "https://si.imgix.net/4abb040e/uploads/origins/6dfb14a4-5215-451f-b748-24d4559050ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4202a87cd3a905b6eaf370a4cf92fac, https://si.imgix.net/4abb040e/uploads/origins/6dfb14a4-5215-451f-b748-24d4559050ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3425e6e5ca2bbf66917da9e27118b52c 2x, https://si.imgix.net/4abb040e/uploads/origins/6dfb14a4-5215-451f-b748-24d4559050ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=79e89d90c53a089ae81471ec469d9bd6 3x"}, "body": "はじめまして、みりゃるLv.1様。先生の描く体格差のある構図に惹かれリクエストを出しました。\nよろしければ花騎士で書いていただきたいキャラクターがいます。\nご一考いただけると嬉しいです。\n【作品】\nフラワーナイトガール(花騎士)\n【登場キャラ】\n容姿はURLをご参照ください。\n①クコ\nhttps://ro.luluroom.info/data/0342.html\n②ヘナ\nhttps://ro.luluroom.info/data/0448.html\n【服装】\n全裸\n【シチュ】\n風呂でクコとヘナが団長に体洗い奉仕プレイをする絵をお願いしたいです。\n詳細は【要件】をご参照ください。\n\n【要件】\n・団長はバスチェアまたは浴槽などに座っており、クコとヘナは団長のそれぞれの足に乗っている密着感のある構図。\nただこの要件はできれば程度なので難しければ別の構図にしていただいて構いません。\nイメージ例\nhttps://www.pixiv.net/artworks/83885298\nhttps://www.pixiv.net/artworks/94799946\n\n・奉仕のやり方にはいろいろあると思います(手コキ・体をこすり合わせるなど)\n　クコとヘナにどのような奉仕をさせるかは先生のご裁量におまかせいたします。\n\nその他不明点などあれば先生のご裁量におまかせいたします。\nご検討宜しくお願い致します。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miryaru1/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1149, "client_id": 115971, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e74a7f35/uploads/origins/8238304f-4646-43e1-80cb-ad76ea17545a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ce8869e5a65e5bf9657ca2eafb94973", "srcset": "https://si.imgix.net/e74a7f35/uploads/origins/8238304f-4646-43e1-80cb-ad76ea17545a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ce8869e5a65e5bf9657ca2eafb94973, https://si.imgix.net/e74a7f35/uploads/origins/8238304f-4646-43e1-80cb-ad76ea17545a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=872f3a78b1668c2b337798334cd6e9e0 2x, https://si.imgix.net/e74a7f35/uploads/origins/8238304f-4646-43e1-80cb-ad76ea17545a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4ec64bc511ecdda98f6be9e57e15ce8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e74a7f35/uploads/origins/8238304f-4646-43e1-80cb-ad76ea17545a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7ebb9af917f18b9cc057b024b4f352d", "srcset": "https://si.imgix.net/e74a7f35/uploads/origins/8238304f-4646-43e1-80cb-ad76ea17545a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7ebb9af917f18b9cc057b024b4f352d, https://si.imgix.net/e74a7f35/uploads/origins/8238304f-4646-43e1-80cb-ad76ea17545a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6c9c8c80cc6814f8b4ed6de6527ad0a9 2x, https://si.imgix.net/e74a7f35/uploads/origins/8238304f-4646-43e1-80cb-ad76ea17545a?bg=%23fff&auto=form