mage_urls": {"src": "https://si.imgix.net/7fd885b6/uploads/origins/89eeda53-5217-427a-a123-6f0fb715f3c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f8a60f5cab5f7b9897c74465841c8e9", "srcset": "https://si.imgix.net/7fd885b6/uploads/origins/89eeda53-5217-427a-a123-6f0fb715f3c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f8a60f5cab5f7b9897c74465841c8e9, https://si.imgix.net/7fd885b6/uploads/origins/89eeda53-5217-427a-a123-6f0fb715f3c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8a2330709048cac856980deda44a49ef 2x, https://si.imgix.net/7fd885b6/uploads/origins/89eeda53-5217-427a-a123-6f0fb715f3c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e1f5a463f9a85cde8462c7be52ea11a7 3x"}, "body": "いつもお世話になっております！\nにじいろさんの描くコミカルな勢いがある物語や、表情、その繋げ方が好きで、いつもTLに上がる作品を楽しく拝見させていただいております。\nあのような雰囲気で、自創作『死体に至る』の登場人物である、宝良と蝉籠を見てみたいと思い、今回の依頼に参りました！\n\n宝良と蝉籠が手話で話している様子を見ている第三者視点での話  という内容を読んでみたいです。\n表情も、手の動きの強弱もコロコロ変わるものの、やり取り自体はずっと静かなので(それはどういう感情？)(どんな話をしてたら、そんな顔になる？)みたいな勢いのある描写が見られると嬉しいです\n\n例:\n\nすごく不穏な表情で、不穏な仕草を混じえて話しているものの、実際の内容は聾者演劇で演じる芝居の練習に付き合っていただけ\n\n神妙に考えて話していたように見えたが、実際の内容は『たわしって何ゴミなんだろう？』くらいの呑気な内容だった\n\nなど\n\n四コマ漫画でも、一本で繋がった短編でも、作品形態の指定はありません。\n第三者は名も無きモブでも、にじいろさん宅のキャラクターでも、描きやすさに応じてお任せします！\n\n季節の変わり目ですので、何かとご自愛くださいませ。\n体調とご都合に差し支えなければ、ぜひよろしくお願い致します……！\n\nhttps://drive.google.com/drive/folders/1aM_8RnL9G9Spb8JVn1FnCPvQ9OJizpeE", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nijiirononanika/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 1710702, "client_id": 2986492, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/45743bca/uploads/origins/16c1b3d6-d804-416b-8c48-f0932c496799?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23b7a5c8a6a9ba7a0d6eea07dac