0f-4d86-a3b8-59043b13a63a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83721aaa90d23209c4fc6bde562e9532", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fb51a384/uploads/origins/ce94198d-2c0f-4d86-a3b8-59043b13a63a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0add7aa552fc6da113d76c2c76a78481", "src_set": ""}, "body": "こんにちは！\n私のマスコットのデザインを手伝ってほしい。\n黒いメガネをかけていて、目は黒く、唇の左隅にほくろがあり、睡眠不足で目の下に大きなクマがあります。胸はぺったんこ。耳は大きく、尻尾もある。銃とお酒とチーズとネズミが好き。黒いシャツには \"brat \"の文字。ジャケットはオーバーサイズ。\n\nVtuber ref : https://drive.google.com/drive/folders/1poSraUedyg2YUibGOBY1H7k2UmFSz4B8?usp=drive_link\n\n私のデザインに合うネズミのぬいぐるみマスコットが欲しいです。他のデザインはお任せします。\n\nありがとうございます！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@orochitai061/works/238", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2621348, "client_id": 3539613, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/06f5b023/uploads/origins/87ab45a1-a274-476b-ad6c-e5dd3d83a12d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2dd1086ed55d728c653ce7d297bf9931", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/06f5b023/uploads/origins/87ab45a1-a274-476b-ad6c-e5dd3d83a12d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46abde8f55d63b1caef779bd8c652bff", "src_set": ""}, "body": "こんにちは！あなたのアートは本当に素晴らしいです！私のキャラクター、チェルをポケモンにアレンジしたアートをお願いしたいです！彼女は明るい色と光るものが大好きなエイリアンの猫です。彼女のポケモンのデザインは二足歩行でも四足歩行でもお好きな方にしてください。この依頼にもっと借りがある場合は再送を依頼してください！ありがとうございました！\n\nhttps://drive.google.com/file/d/1bWCqZXVdB9nkwEBRgmdnEUAf14yKC6ht/view?usp=drive_link\nhttps://drive.google.com/file/d/12esi9MZWTpl8dkLi7GVS6XdU3DcUErwq/view?usp=drive_link", "nc": 144, "word_count": 0