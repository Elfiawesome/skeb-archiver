er活動に使用させていただきたいです。\n納品時、背景透過もしくはpsdでいただけると嬉しいです....!\n\nご縁があればよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1wXyWYLUB0F6Uta0yNrA2eElXulneT1FK", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 331358, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "水月とーこ", "screen_name": "mizukitoko", "avatar_url": "https://pbs.twimg.com/profile_images/2004727522794373120/a_2dCm9h.jpg", "header_url": "https://pbs.twimg.com/profile_banners/14624691/1659080388/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "novel"}, {"genre": "correction"}], "banned": false, "nc": 0}, {"id": 685670, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "猫巳屋.", "screen_name": "neco3ya_TM", "avatar_url": "https://pbs.twimg.com/profile_images/2048336729703333888/rClZDJ6l.jpg", "header_url": "https://pbs.twimg.com/profile_banners/792270473228726272/1721634796/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 1366068, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "お、", "screen_name": "ooo_0926", "avatar_url": "https://pbs.twimg.com/profile_images/1976456505617678337/k4n0GrRE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1393369213792751620/1768864254/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiratio