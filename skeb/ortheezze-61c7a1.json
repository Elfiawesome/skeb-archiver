auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fbe4a62610570acbf34db4ba34e9407d, https://si.imgix.net/a8c63768/uploads/origins/5d7e73b7-7119-44d7-b1c6-fe5fd099e627?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=caa1ecc8a4f400b0bc024e176f1c3a7a 2x, https://si.imgix.net/a8c63768/uploads/origins/5d7e73b7-7119-44d7-b1c6-fe5fd099e627?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=61389eae11ffb469083c30279d3db361 3x"}, "body": "はじめまして。\nロイヤルファミリーさんのイラストを拝見し、とてもドラマティックでエモいな雰囲気に惹かれました。もし可能でしたら当方の幻覚ウマ娘を描いていただけないでしょうか。\n（中等部/フランス出身のウマ娘ちゃんです）\n\nシチュエーション、構図などはお任せいたします。\n指定が有った方が宜しいようでしたら、とってもエモいこぼれそうな笑顔を浮かべさせて頂けたら喜びます。\nまた、もし可能であれば、スミレの花を描画頂けると幸いです。（花冠、花束、花輪など何でも大丈夫です。スミレ以外のお花が混じっても大丈夫です）\n\n参考資料\n（立ち絵とお顔回り詳細）\nhttps://hstorage.io/dl/PCSY0k7JvM4P.png\n（三面図）\nhttps://hstorage.io/dl/pVYsa3KLp8kq.png\n\n参考資料は勝負服ですが、トレセン学園の制服でも問題ございません。\nもし宜しければご検討お願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ortheezze/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 308705, "client_id": 639858, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/64300d65/uploads/origins/8ac9152c-4fa9-419d-a7e2-e098f5e02c9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45da03a3e79835a2035ba469ba78dd56", "srcset": "https://si.imgix.net/64300d65/uploads/origins/8ac9152c-4fa9-419d-a7e2-e098f5e02c9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45da03a3e79835a2035ba469ba78dd56, https://si.imgix.net/64300d65/uploads/origins/8ac9152c-4fa9-419d-a7e2-e098f5e02c9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b205bb05266eaa6a32056ef9f2b59071 2x, https://si.imgix.net/64300d65/uploads/origins/8ac9152c-4fa9-419d-a7e2-e098f5e02c9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb726ca8963807a14553f37952a5abb4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/64300d65/uploads/origins/8ac9152c-4fa9-419d-a7e2-e098f5e02c9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c48d0eec918951f7caffc733368e30d", "srcset": "https://si.imgix.net/64300d65/uploads/origins/8ac9152c-4fa9-419d-a7e2-e098f5e02c9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7c48d0eec918951f7caffc733368e30d, https://si.imgix.net/64300d65/uploads/origins/8ac9152c-4fa9-419d-a7e2-e098f5e02c9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=72e3f1972cf51afd89ab73c98ad75092 2x, https://si.imgix.net/64300d65/uploads/origins/8ac9152c-4fa9-419d-a7e2-e098f5e02c9e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4f4b1274c7784977fc8d1a712f27ba24 3x"}, "body": "前回はロイヤルファミリーの素敵なイラストを描いていただきましてありがとうございました。\nまたリクエストお願いします。\n\n【キャラクター】\nロイヤルホープ (『ザ・ロイヤルファミリー』)\n→コラボのウマ娘の姿でお願いします\n\n【シチュエーション】\nドラマ版『ザ・ロイヤルファミリー』第6話でロイヤルホープ引退レースとなった有馬記念のレース後をウマ娘の姿で描いていただけたらと思います。\n雨降る中で引退レースに臨むも惜しくも2着となってしまい、天を見上げて悔しがってる雰囲気でお願いします。\n自身の引退だけでなく病に伏した山王社長の想いも背負ってのレースだったので…\n\n前回に引き続きドラマのワンシーンをウマ娘の姿で描いていただくという変則的なリクエストとなりますが、ご検討よろしくお願いいたします。\n\nhttps://x.com/umamusu_animeCG/status/1972281584415129608", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ortheezze/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 308705, "client_id": 639858, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/196acbf5/uploads/origins/31bd8a98-7a08-4a23-85e8-d039f93ac375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=296c4896a39aed0571cf39b4d66d4320", "srcset": "https://si.imgix.net/196acbf5/uploads/origins/31bd8a98-7a08-4a23-85e8-d039f93ac375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=296c4896a39aed0571cf39b4d66d4320, https://si.imgix.net/196acbf5/uploads/origins/31bd8a98-7a08-4a23-85e8-d039f93ac375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8686d52782b6667c75ef89e7fda6ad16 2x, https://si.imgix.net/196acbf5/uploads/origins/31bd8a98-7a08-4a23-85e8-d039f93ac375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10487ab0775d508dc02962fb54b7739a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/196acbf5/uploads/origins/31bd8a98-7a08-4a23-85e8-d039f93ac375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=adc632781160c642204f75f617c98d15", "srcset": "https://si.imgix.net/196acbf5/uploads/origins/31bd8a98-7a08-4a23-85e8-d039f93ac375?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=adc632781160c642204f75f617c98d15, https://si.imgix.net/196acbf5/uploads/origins/31bd8a98-7a08-4a23-85e8-d039f93ac375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=703b131ced3e68ccacfb8a1307422a2f 2x, https://si.imgix.net/196acbf5/uploads/origins/31bd8a98-7a08-4a23-85e8-d039f93ac375?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d29d3c602d179eb0ec37274c5add3cd3 3x"}, "body": "以前クロノジェネシスのイラストを描いていただいた者です。\nまたリクエストお願いします。\n\n【キャラクター】\nロイヤルファミリー (『ザ・ロイヤルファミリー』)\n→コラボのウマ娘の姿でお願いします\n\n【シチュエーション】\nドラマ版最終話で2025年の有馬記念で2着に終わった後、ロイヤルファミリーの現役続行か引退かを決めかねてるときにファミリーが悔しそうに、あるいは奮い立てるかのように嘶くシーンがありましたが、そのシーンをウマ娘の姿で描いていただけないでしょうか？\nドラマのワンシーンをウマ娘の姿で描くという変則的なリクエストになりますが、どうかご検討よろしくお願いします。\n\nhttps://x.com/umamusu_animeCG/status/1983133699479937299", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ortheezze/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "ti