.com/drive/folders/1hJuSyFOF8CjU-Xq7bhGpiwedoGNr_zeG\n\n(DeepL)\n\nhttps://drive.google.com/drive/folders/1hJuSyFOF8CjU-Xq7bhGpiwedoGNr_zeG", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Cactus_004/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1207933, "client_id": 1377994, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a4646ea/uploads/origins/4e4e4e24-1977-4b3b-8cc9-673a4f276303?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=829c641d692f9e441fdfabdc746c5e8d", "srcset": "https://si.imgix.net/7a4646ea/uploads/origins/4e4e4e24-1977-4b3b-8cc9-673a4f276303?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=829c641d692f9e441fdfabdc746c5e8d, https://si.imgix.net/7a4646ea/uploads/origins/4e4e4e24-1977-4b3b-8cc9-673a4f276303?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=63c2ed58086664d4ed3147b0a1aa1afc 2x, https://si.imgix.net/7a4646ea/uploads/origins/4e4e4e24-1977-4b3b-8cc9-673a4f276303?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72b08763c116c7018d3256983d7caf3c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a4646ea/uploads/origins/4e4e4e24-1977-4b3b-8cc9-673a4f276303?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecc7a5400bfe9a39a297a0d550137e72", "srcset": "https://si.imgix.net/7a4646ea/uploads/origins/4e4e4e24-1977-4b3b-8cc9-673a4f276303?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecc7a5400bfe9a39a297a0d550137e72, https://si.imgix.net/7a4646ea/uploads/origins/4e4e4e24-1977-4b3b-8cc9-673a4f276303?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f44723c4c71d8e9d29bede82e6d8ea35 2x, https://si.imgix.net/7a4646ea/uploads/origins/