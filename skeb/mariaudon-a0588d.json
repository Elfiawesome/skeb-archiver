df-8c80-29db5bcd186b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9954e0ff764a9c8f7395389c83b6022d", "srcset": "https://si.imgix.net/b558e6d2/uploads/origins/fbd60a3d-900c-48df-8c80-29db5bcd186b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9954e0ff764a9c8f7395389c83b6022d, https://si.imgix.net/b558e6d2/uploads/origins/fbd60a3d-900c-48df-8c80-29db5bcd186b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8e5697484455ea72542129f3908d084a 2x, https://si.imgix.net/b558e6d2/uploads/origins/fbd60a3d-900c-48df-8c80-29db5bcd186b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ca18c0a32c65793ba846839103b469eb 3x"}, "body": "●希望のキャラクター\n『アイドルマスターシンデレラガールズ』の大槻唯と、当方の創作P（オリジナルの女性プロデューサー）\n\nビジュアルのあるプロデューサーに拒否感がある場合はこの時点でキャンセルしてください\n大丈夫そうでしたら下記の内容をご検討ください\n\n\n●リクエスト詳細\nデレステの唯ちゃんのフェス限定SSR［ソル・パライソ］に、「おそろいの着て、歩こーよ♪　パレオとか巻いてー。で、腕組んでさー？」というセリフがあります\nこのセリフを元ネタに、唯ちゃんと女性プロデューサーが水着姿（お揃いパレオ）で海辺を歩くツーショットイラストをお願いします\n唯ちゃんはぐいぐい距離を詰めて楽しそうに腕を絡めている。胸が当たっているくらいの距離感\nPは唯ちゃんの陽キャっぷりに押されつつ困り眉で微笑んでいる\n\n水着のデザインはお任せしますが、パレオはお揃いにしてください。色違いは可。水着本体はお揃いじゃなくてもいいです\n麦わら帽子やサングラスといった付属品、ヘアアレンジはお好みで\n\n\n●創作P補足\n具体的な容姿については資料URLをご参照ください\n・設定名は九重宮子（ここのえ みやこ）\n・日本人女性、20代中盤。やや垂れ目。瞳の色はダークブラウン\n・キリっとしたかっこいいキャリアウーマンではなく、少し押しが弱そうで穏やかな雰囲気\n・茶髪のセミロング。仕事中は一つ結び（ローポニーテール）でまとめている\n・バストは平均的。並。大きすぎず小さすぎず\n・身長167cm。唯ちゃんより12cm高い\n\n以前別のコミッションで描いて頂いた一例\nhttps://www.pixiv.net/artworks/96249450\nhttps://skeb.jp/@kopperion/works/11\n\nhttps://drive.google.com/drive/folders/1pFiF-9YUJyuiDW8-ND6fzpTjADNXbiXZ", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mariaudon/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 22901, "client_id": 977975, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa291d35/uploads/origins/37002574-bd79-4dcf-b61b-6294ff1c931b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ed23369463531f4ecf9b721a64b66da", "srcset": "https://si.imgix.net/fa291d35/uploads/origins/37002574-bd79-4dcf-b61b-6294ff1c931b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ed23369463531f4ecf9b721a64b66da, https://si.imgix.net/fa291d35/uploads/origins/37002574-bd79-4dcf-b61b-6294ff1c931b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c53ae5604181f06f78b7e5544d96eec 2x, https://si.imgix.net/fa291d35/uploads/origins/37002574-bd79-4dcf-b61b-6294ff1c931b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=18ee83166529840d3beac5df6d6be7af 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa291d35/uploads/origins/37002574-bd79-4dcf-b61b-6294ff1c931b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6d7ebf833e6818b51a13c66e470778e", "srcset": "https://si.imgix.net/fa291d35/uploads/origins/37002574-bd79-4dcf-b61b-6294ff1c931b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6d7ebf833e6818b51a13c66e470778e, https://si.imgix.net/fa291d35/uploads/origins/37002574-bd79-4dcf-b61b-6294ff1c931b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=051ec3c968a7f2dbdc9141dbedd9bfdc 2x, https://si.imgix.net/fa291d35/uploads/origins/37002574-bd79-4dcf-b61b-6294ff1c931b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8ab1da3572434a23adc99977c484a4c9 3x"}, "body": "一ノ瀬志希さんとライラさんのイラストを描いていただけませんでしょうか。\n\n構図は、ライラさんがマッサージベッドでうつ伏せになって顔を横にしてこちらを見ている状態で、背中に塗った脂を志希にゃんがストリジル(垢すりヘラ)で拭ってるという姿です。\n\nシュチュエーションは、志希にゃんがライラさんの香りを抽出した精油を作るところです。\n\n花びらの精製したラードに置いて香りを脂に移してその脂から香りの精油を抽出するアンフルラージュという抽出方法を応用し、ライラさんにラードを塗りたくって香りを移してからその脂ををストリジル(垢すりヘラ)で集めています。\n\n服装などは、ライラさんは腰の辺りから下はタオルで隠して髪は脂でアップにまとめてます。うつ伏せですが胸の膨らみも見えないようにお願いします。\n志希