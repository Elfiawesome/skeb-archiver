しなどはおまかします。資料のフォルダー色んな衣装をまとめています、ご好みの方を選んで書いていただければと思います（小物やデザインを全部厳守する必要はないです、組み合わせの変換や、新しいデザインとかもぜひ）。\nもしくは完全にご好みの衣装や武器を描いていただければと思います。\n\nレイヤ分けのｐｓｄと宛名有り無し差分もお願いします。\nでは、ぜひご検討宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1dJfHI6XfIQhrg2055qu-3jgqIfZhcQWR?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Rita_Lilie/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2719473, "client_id": 2693108, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3413f3de/uploads/origins/3e62f05d-7536-4841-adac-37c62dea64c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b37d348ea3796ea4c3407a27f24ed325", "srcset": "https://si.imgix.net/3413f3de/uploads/origins/3e62f05d-7536-4841-adac-37c62dea64c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b37d348ea3796ea4c3407a27f24ed325, https://si.imgix.net/3413f3de/uploads/origins/3e62f05d-7536-4841-adac-37c62dea64c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d0c2104c0dd13d95072f0aae76874d6 2x, https://si.imgix.net/3413f3de/uploads/origins/3e62f05d-7536-4841-adac-37c62dea64c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af63c326b19ee40930bdf0f40a79452a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3413f3de/uploads/origins/3e62f05d-7536-4841-adac-37c62dea64c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4792c53261e42a39a9631c999b152db3", "srcset": "https://si.imgix.net/3413f3de/uploads/origins/3e62f05d-7536-4841-adac-37c62dea64c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4792c53261e42a39a9631c999b152db3, https://si.imgix.net/3413f3de/uploads/origins/3e62f05d-7536-4841-adac-37c62dea64c8?bg=%23fff&auto=format%2Ccompres