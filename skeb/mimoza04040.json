n\n【使用用途】\n個人観賞用、友人間への共有、SNSへの掲載と紹介、アイコンやヘッダーへの使用、グッズの作成(いずれも個人利用かつ非商用)\n\n金額に見合わない場合は再送やキャンセルをして頂いて構いません。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1yYdDw87ff9LC_MKLVXXou3Q3ryQo1zyn?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mimoza04040/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a120fe98/uploads/origins/40c927de-665d-4044-bc67-3b649125f236?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae28e3f85e5dad2e8806db24076564af", "srcset": "https://si.imgix.net/a120fe98/uploads/origins/40c927de-665d-4044-bc67-3b649125f236?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ae28e3f85e5dad2e8806db24076564af, https://si.imgix.net/a120fe98/uploads/origins/40c927de-665d-4044-bc67-3b649125f236?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5bac1ba01e9f85c51883db11ed42be1e 2x, https://si.imgix.net/a120fe98/uploads/origins/40c927de-665d-4044-bc67-3b649125f236?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f08422fe714b6a58b59a420725b578ed 3x"}, "private": true, "genre": "correction", "tipped": true, "creator_id": 2057227, "client_id": 3396210, "nc": 0}, {"path": "/@mimoza04040/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2057227, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d5a789d/uploads/origins/e71df31a-2736-40d6-a9f0-e77d3b91eecc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=