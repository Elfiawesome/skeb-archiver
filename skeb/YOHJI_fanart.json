b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2aba24831562d35bc186e7fcd792e54 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/de480ee8/uploads/origins/20417c3c-227b-4f79-b97b-47a60ea54c6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9582f710876fc798418b0eb034c94f9f", "srcset": "https://si.imgix.net/de480ee8/uploads/origins/20417c3c-227b-4f79-b97b-47a60ea54c6b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9582f710876fc798418b0eb034c94f9f, https://si.imgix.net/de480ee8/uploads/origins/20417c3c-227b-4f79-b97b-47a60ea54c6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8fee6f34d993cfe9e86dadb961e3cd23 2x, https://si.imgix.net/de480ee8/uploads/origins/20417c3c-227b-4f79-b97b-47a60ea54c6b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2966e5b2bc6d6066976b9cf5d1f71918 3x"}, "body": "こんにちは、私のOC、エデルをリクエストしてもいいですか？私が開発している乙女ゲーム（ant-san.itch.io/villainotome）の恋敵なんだ。\n\nエデルはゲームの恋愛オプションの一つです。主人公の婚約者の執事だが、内心は暗殺者。日焼けした肌に乱れた髪（アホ毛あり）。目の色は紫と赤で、目の下に2つのほくろがある。上のほくろの方が少し大きい。\n\n他人をからかったり、人生を難しくするのが好き。初期のバッドエンドのほとんどは、彼が主人公を殺したことによるもの。\n\nただ、彼をクールでハンサムに、たぶんドヤ顔で登場させてほしい。\n\n用法：\nゲームには入れません。\n\n開発ブログ（https://itch.io/devlogs）やSNSの投稿にイラストを使うかもしれません。\n\nhttps://drive.google.com/drive/folders/1nURkFqYSotKMGBfACAyqfTZloHZUO7ga?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YOHJI_fanart/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3174606, "client_id": 2424897, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c5660f83/uploads/origins/2b76fe07-dd1a-41ee-8bfb-789d39c7bc13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa65918309732f94308de5d1f7406ca4", "srcse