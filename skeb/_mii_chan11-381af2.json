がら読書をすること。\n\n【参考資料】\n・衣装設定2026\nhttps://drive.google.com/file/d/1LO_pDo2TFP8WubqfIFfBJWFM-0abzUh8/view?usp=sharing\n\n・表情イメージ（衣装は最新の2026版を参考にしてもらえると幸いです！）\nhttps://drive.google.com/file/d/1DTUZY0b5KcsjCYxUxQ69EAjdSygongiY/view?usp=sharing\n\n\n【使用用途】\n個人鑑賞用\n\nご検討のほど、よろしくお願いいたします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_mii_chan11/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2912097, "client_id": 30699, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1afa8cd6/uploads/origins/44300494-863c-4589-9f1b-ad6744016d31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbf3773e3876be0de450159b47fca042", "srcset": "https://si.imgix.net/1afa8cd6/uploads/origins/44300494-863c-4589-9f1b-ad6744016d31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbf3773e3876be0de450159b47fca042, https://si.imgix.net/1afa8cd6/uploads/origins/44300494-863c-4589-9f1b-ad6744016d31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=537f4352baad936371e6f79fec404512 2x, https://si.imgix.net/1afa8cd6/uploads/origins/44300494-863c-4589-9f1b-ad6744016d31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5b303f376729ae8cdd6c867e29c0d6c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1afa8cd6/uploads/origins/44300494-863c-4589-9f1b-ad6744016d31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7bd43a89a6812d103991b025401c5053", "srcset": "https://si.imgix.net/1afa8cd6/uploads/origins/44300494-863c-4589-9f1b-ad6744016d31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7bd43a89a6812d103991b025401c5053, https://si.imgix.net/1afa8cd6/uploads/origins/44300494-863c-4589-9f1b-ad6744016d31?bg=%23fff&auto=format%2Ccompr