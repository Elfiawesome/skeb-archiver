あり、顔の良さを武器にしている。\nでもウインクが昔からできない。（普段はごまかしてる）\n\n笑顔やドヤ顔がデフォルト。  \n実は寂しがり。甘えるのが得意。\n\n・好きな物事\nお金、褒められる事\n食べ物…お菓子全般、あん肝（たまに食べるのが好き）\n\n「氷花がかわいいのは当たり前でしょー？」\n「輝く海の天使！しーえんじぇる とは…氷花のことだっ！氷花だよ～よろしくね☆」\n\n\n●イラスト使用用途\n・個人観賞\n・個人使用のグッズ作成（頒布を行わない）\n\n\n●さいごに\nここまで読んでくださりありがとうございます。\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1zkdouqsGoMiSUlfU4OY0Ytin0sRSkplN?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_mii_chan11/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2912097, "client_id": 2945837, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/00d13a51/uploads/origins/157e0188-5602-4805-920d-84dc65be550b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88822be1d2ed166c9b90f0bc387fe009", "srcset": "https://si.imgix.net/00d13a51/uploads/origins/157e0188-5602-4805-920d-84dc65be550b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88822be1d2ed166c9b90f0bc387fe009, https://si.imgix.net/00d13a51/uploads/origins/157e0188-5602-4805-920d-84dc65be550b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ed2bc05654f32421a53bc8e225049da 2x, https://si.imgix.net/00d13a51/uploads/origins/157e0188-5602-4805-920d-84dc65be550b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bb2d5ba1e4bbe27587b11e9667e50ebe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/00d13a51/uploads/origins/157e0188-5602-4805-920d-84dc65be550b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07c93ed2d855cb5e240ea2cbb8f6ecc8", "srcset": "https://si.imgix.net/00d13a51/uploads/origins/157e0188-5602-4805-920d-84dc65be550b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07c93ed2d855cb5e240ea2cbb8f6ecc8, https://si.i