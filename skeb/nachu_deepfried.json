200&h=200&blur=200&s=806fa28482e133848cb52f5dc189654f", "src_set": ""}, "body": "前回は素敵なゆかりさんと葵ちゃんのイラストをありがとうございました。\n大変好みでしたので、また依頼させていただきました。\n\n雪の降る夜にデートする琴葉葵と結月ゆかりのイラストを描いていただきたいです。\n\n■キャラクター\n琴葉葵、結月ゆかり\n\n■要望\n・背景に星空が見える\n\n以上の内容でお願いいたします。\n指定していない部分はお任せいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nachu_deepfried/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3cdd118f/uploads/origins/b7b936c5-ac3a-419c-b548-a870d33aad41?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e3c8f294ef8ffccb3c65ce557ea17dc", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3018111, "client_id": 311947, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@nachu_deepfried/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3018111, "client_id": 1417523, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/96af9043/uploads/origins/c2100981-2d49-48c9-b309-ea21732e4789?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=de7609a1f9f3e3b2cbf08f1383f4b80c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96af9043/uploads/origins/c2100981-2d49-48c9-b309-ea21732e4789?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5d0a429a2caf2326224d727bdab5c6c", "src_set": ""}, "body": "初めまして。\nTwitterで投稿された葵ちゃんのイラストを見て、\n内容がとても好みでしたので依頼させていただきました。\n\n日差しの下で、ゆかりさんも泳ごうと誘おうと手を伸ばす琴葉葵と、\nビーチパラソルの下の日陰で、誘われて困っている結月ゆかりのイラストを描いていただきたいです。\n\n■キャラクター\n琴葉葵、結月ゆかり\n\n■服装\n結月ゆかり：水着+パーカー\n琴葉葵　　：水着\n\n■要望\n・葵ちゃんは一泳ぎした後で髪や身体が濡れている\n\n以上の内容でお願いいたします。\n指定していない部分はお任せいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nachu_deepfried/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3018111, "client_id": 785376, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/84915a4a/uploads/origins/fa5e25c8-8dcc-4f83-941a-d89dfe8036a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2f76f024b8d140eced6a20f68ef6c95", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/84915a4a/uploads/origins/fa5e25c8-8dcc-4f83-941a-d89dfe8036a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b67a20df38757ff8d84c377ff6b892d9", "src_set": ""}, "body": "こんにちは。VOICEROIDの琴葉葵さんのイラストをお願いしたいです。\n\n■キャラクター\n　・琴葉葵さん\n　・(可能な範囲で構いません)衣装は私服で、上は肩とお腹の部分がシースルー、下はミニスカート\n\n■シチュエーション(イメージの参考です。この通りでなくて構いません)\n　・初夏の晴れた日の散歩中、道に生えてる花を眺めている\n\n上記以外はすべてお任せします。\n\nなお、描いて頂いたイラストの使用について\nニコニコ動画やX(Twitter)等のSNSにて、アイコンやヘッダーに使用させて頂く可能性があることをご了承ください。\n\nよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nachu_deepfried/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3018111, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ec450afe/uploads/origins/3e387ba2-50de-4d57-9d9a-f26ffe18870f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=236533273eecf730cca1b77ae7a8db51", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ec450afe/uploads/origins/3e387ba2-50de-4d57-9d9a-f26ffe18870f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=432893afa7e5f