b-94a3dd50839b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3403e67630fb9ba1c5d278bd294cfac4 2x, https://si.imgix.net/561d36b7/uploads/origins/b90d5050-917d-4b66-8c4b-94a3dd50839b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=991f8d3e94354aac8e68d7ea9a961f05 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/561d36b7/uploads/origins/b90d5050-917d-4b66-8c4b-94a3dd50839b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f91ed3a6f281e1fde717f19a027952f", "srcset": "https://si.imgix.net/561d36b7/uploads/origins/b90d5050-917d-4b66-8c4b-94a3dd50839b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f91ed3a6f281e1fde717f19a027952f, https://si.imgix.net/561d36b7/uploads/origins/b90d5050-917d-4b66-8c4b-94a3dd50839b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fe57b05f7ec0cfb9c5b0392c4f7805b4 2x, https://si.imgix.net/561d36b7/uploads/origins/b90d5050-917d-4b66-8c4b-94a3dd50839b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a5d7e03b6daa6b7d227e16ba4f59bd48 3x"}, "body": "北欧ゆう先生、こんばんは！\n『高橋さんが聞いている。』からファンになり、作品を楽しませていただいております。\n先に描かれていたコミックがとても面白かったので、ぜひ私のOCのコミックをリクエストしたいのですが、いかがでしょうか？\n（コミックは初めてなので、不手際がありましたらすみません）\n\n■特徴\n名前:キャンディス・アコニット(Candice Aconite)\n職業:魔法薬の自作販売、冒険者\n年齢:設定は13～18歳（後述）ですが、薬でもっと成長した姿になることもできますので、年齢感は20代までの間でおまかせいたします。\n身長:低め（145cm～）\n髪型:左目側にサイドテール、毛先は肩より上、後髪は短め\n髪色:ルビーレッド、前髪に白のメッシュ\n目元:中くらいの大きさで黄色い瞳、ツリ眉\n口:ギザ歯（控えめ）\n服装:先生におまかせします！特になければ、[サイドテール部分にリボンと、ケープ、スカート（全て深い紫系）とショートブーツ（これ以外の部分は自由）]が普段の服装です。\n\n■内面的性質\n呪い:13～18歳の間しか生きられず、死亡時には13歳の身体に戻り、全く別の場所でリスポーン。持ち物は死亡時から2分間近くにあれば引き継ぎ可能。\n呪いの影響:「永遠に旅をして知識を蓄えられる」とポジティブに捉えているが、好奇の目を避けるため他人には隠している。\n性格:それなりに誠実だが、知識の獲得にはとても貪欲。大雑把でいたずら好き。やや幼い面や負けず嫌いな部分もある。死んでも平気だと考えており、無鉄砲。\n魔法の使い方:詠唱、または自分で書いた魔導書の文字に魔力を流し込むことで使用。\n製薬技術:生物が口にしないような原料や雑な製法で見る人を不安にさせるが、それでも薬師としては一流。\n魔法:400年近く生き死にを繰り返しており、知識や経験が豊富。ただ、魔力の保持量を薬で補強しなければ大きな魔法は使えない。\n\n資料として、今までに描いて頂いた同じキャラクターのイラストを参考としてURLに提示しております。\n\n外面のいい薬師としての一面を見せつつ、実は結構いい加減という感じを、面白おかしく描いていただければなと思っております…！\nキャラクターを伝えるためにたくさん書いてしまいましたが、全てを盛り込まなくても大丈夫です！\n\n以上です。ご検討よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1mQh1qNKx-4fE_djRh1ka9PwdmEX9fbue", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hk_ou_yu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1646411, "client_id": 1123200, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b4aec74/uploads/origins/bf4af3b3-122e-4ec4-999d-c5ea25b0500a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d33052d4df75a134f99d3943ffae09e1", "srcset": "https://si.imgix.net/6b4aec74/uploads/origins/bf4af3b3-122e-4ec4-999d-c5ea25b0500a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d33052d4df75a134f99d3943ffae09e1, https://si.imgix.net/6b4aec74/uploads/origins/bf4af3b3-122e-4ec4-999d-c5ea25b0500a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7037cba65379d38ae6fd85b2809f0337 2x, https://si.imgix.net/6b4aec74/uploads/origins/bf4af3b3-122e-4ec4-999d-c5ea25b0500a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ce461ce488fd33ad3fdfc650e5caa2e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b4aec74/uploads/origins/bf4af3b3-122e-4ec4-999d-c5ea25b0500a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=587969a90e712cacc16d9cf81919ec24", "srcset": "https://si.imgix.net/6b4aec74/uploads/origins/bf4af3b3-122e-4ec4-999d-c5ea25b0500a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=587969a90e712cacc16d9cf81919ec24, https://si.imgix.net/6b4aec74/uploads/origins/bf4af3b3-122e-4ec4-999d-c5ea25b0500a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a12e2476161577ca1879d7070339d99c 2x, https://si.imgix.net/6b4aec74/uploads/origins/bf4af3b3-122e-4ec4-999d-c5ea25b0500a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8cb3588a0b142a96a04562802335fb68 3x"}, "body": "こんにちは！！！\n高橋さんが聞いている。の御影君お願いしたいです！！！！！！何卒よろしくお願いします！！！！！！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hk_ou_yu/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1646411, "client_id": 88241, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1bd7eee4/uploads/origins/181201bc-382f-4b7c-a876-ef8e93310544?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17aa8a98714eb5efd8c370058d50a587", "srcset": "https://si.imgix.net/1bd7eee4/uploads/origins/181201bc-382f-4b7c-a876-ef8e93310544?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17aa8a98714eb5efd8c370058d50a587, https://si.imgix.net/1bd7eee4/uploads/origins/181201bc-382f-4b7c-a876-ef8e93310544?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be6050b98074e752bb043369a1881ee9 2x, https://si.imgix.net/1bd7eee4/uploads/origins/181201bc-382f-4b7c-a876-ef8e93310544?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=54a5c148fc73e52ea1aa60dc067ba0c7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1bd7eee4/uploads/origins/181201bc-382f-4b7c-a876-ef8e93310544?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a84708559492ae3cb790fa47a5801844", "srcset": "https://si.imgix.net/1bd7eee4/uploads/origins/181201bc-382f-4b7c-a876-ef8e93310544?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a84708559492ae3cb790fa47a5801844, https://si.imgix.net/1bd7eee4/uploads/origins/181201bc-382f-4b7c-a876-ef8e93310544?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e7bdd5e36712e7796201d60a9d9787e2 2x, https://si.imgix.net/1bd7eee4/uploads/origins/181201bc-382f-4b7c-a876-ef8e93310544?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=15c001a1e0fb3f09ef378695a0ece2ea 3x"}, "body": "北欧ゆう先生、はじめまして！\n高橋さんからファンになり、いつも面白い漫画を楽しませていただいております！\n先生の漫画はいつも表情豊かで読んでいる間にこちらも色んな表情になってしまうので、すごく大好きです！\n\nさて、本題ですがこの度はキャラクターデザインをお願いに参りました。\nこれまでキャラクリができるゲームで共通して作っていたキャラクターモチーフがあります。\nそれを元にしてキャラクターシートのようなものを制作して欲しいです。\n用途は主にskebの依頼の資料で、その他にはトリミングして私のXやMisskey.io、Discordのアイコンへの使用が考えられます。\n当方キャラデザの資料については素人なため、どういった内容かはお任せしたいのですが、\n立ち絵と表情集的なものがあれば良いのかな？と考えております。\n\n参考にして欲しいキャラクターのスクリーンショットを資料URLに張り付けてありますので、ご確認をお願いいたします。\nFF14とToSで使っていたキャラクター、その他コミッションで描いていただいた絵があります。\n考えている設定ですが、以下の通りで足りますでしょうか。\n\n世話焼きだけど悪戯好き、黙っていればクールな感じのファンタジーな猫耳娘\n身長は165程度目安\n髪色は青みがかった銀色\n髪型は全体がふわっとした癖のあるハネ毛で、\n長めのもみあげと後頭部の上の方でまとめて肩甲骨あたりまであるポニーテール\n狐っぽいふわふわで少し大き目な猫耳と猫尻尾\n吊り上がり気味な眉と少しジトっとした目つきだけど、表情がよく顔に出る感じ\n瞳の色は明るめの赤紫、ほぼピンクでも差し支えないです\n身体は全体を通して肉づきがよく細くは見えないくらいに\nお胸はそこそこ大きく、君華さんくらいの大きさで\n\nわがままなのですが、北欧ゆう先生の描くジト目がすごく好きなのと、\n個人的にぐるぐる目が好きなので、\nその二つの表情を描いていただけませんでしょうか。\n\nシートの構成等細かい部分はプロである先生にお任せするのが一番だと考えておりますが、\nもし制作にあたり情報が不足している部分があれば、再送機能を使用していただけたら幸いです。\nまた、金額が不足していると感じた場合にも遠慮なく再送依頼いただければと思います。\n\nそれでは、よろしくお願いいたします！\n\nhttps://imgur.com/a/TGPWYac", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hk_ou_yu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 1646411, "client_id": 582059, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/01dcf4a5/uploads/origins/f789c31d-48e4-445b-8764-449dab40d7b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0281df78c4f0a0767b239388baa6