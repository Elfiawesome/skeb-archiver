: {"nsfw": true}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@hk_ou_yu/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1646411, "client_id": 3155831, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3971bfa8/uploads/origins/236ac602-793a-44c5-800d-0604bb9eb193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa7311c17b481bafa05b8e6c466c8edb", "srcset": "https://si.imgix.net/3971bfa8/uploads/origins/236ac602-793a-44c5-800d-0604bb9eb193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa7311c17b481bafa05b8e6c466c8edb, https://si.imgix.net/3971bfa8/uploads/origins/236ac602-793a-44c5-800d-0604bb9eb193?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34b5e91b9bd0ff416051bb4587035d57 2x, https://si.imgix.net/3971bfa8/uploads/origins/236ac602-793a-44c5-800d-0604bb9eb193?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7eceff46068a7fd78926aa1f96735262 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3971bfa8/uploads/origins/236ac602-793a-44c5-800d-0604bb9eb193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0210e0850b296a324180ff157761ffba", "srcset": "https://si.imgix.net/3971bfa8/uploads/origins/236ac602-793a-44c5-800d-0604bb9eb193?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0210e0850b296a324180ff157761ffba, https://si.imgix.net/3971bfa8/uploads/origins/236ac602-793a-44c5-800d-0604bb9eb193?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d76d5ac9de0ae9431cec5f6ff31c2a0a 2x, https://si.imgix.net/3971bfa8/uploads/origins/236ac602-793a-44c5-800d-0604bb9eb193?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=98952daa93d40fe4ddf62195f02fcef3 3x"}, "body": "先日はアイコンのリクエストを承認いただきありがとうございました。\n2回目の依頼となりますが、ご迷惑でなければご一読いただけますと幸いです。\n\n----------\n\n【概要】\nボスらしい風格を持った、若い見た目のダークエルフ。\n\n【用途】\nTRPGのキャラクター立ち絵、SNSのアイコンやヘッダー、長時間眺めて自分の口元を吊り上げる行い\n\n【容姿】\n・若い見た目の、グレーに近い肌の色をした、細めのダークエルフ\n・黒や緑を基調としたマント\n・骨やガイコツを用いたアクセサリ\n・こちら(画面手前)に向けて毒の魔法を放とうとしている構図\n\n\n【詳細】\n友人と行っているTRPG(ダンジョンズ&ドラゴンズ)において、自分の作ったキャンペーンが完結しそうなので、そのラスボスとして北欧ゆう先生の絵を使わせていただけたら嬉しいな、と思って依頼いたしました。\n次のセッションはずっと先なので、ご無理のないペースで作成いただければと思います。\nまた、北欧ゆう先生に絵を描いてもらえるととても嬉しいので、SNSの自アカウントのヘッダーやアイコンへ流用する場合があります。\n\n\n【キャラクターの細かい設定】\n(※細かい設定がある方が描きやすいな、という場合に目を通してくださると幸いです)\n毒と病の神様を信奉しているダークエルフのお兄さんです。\n毒の塊を放ったり、毒の霧をマントから放ったり、ゾンビやスケルトンを召喚して操ったりします。\n\n昔、悪い神様を信奉している自分も分け隔てなく受け入れてくれた強くて偉い人が、病気に倒れてしまいました。\nその事で『強くて偉い人でも病気には逆らえない！　毒や病によってみんな倒れるのが真の平等なんだ！』という偏った考えを持ち、一つの町に病気を蔓延させようとします。\nプレイヤーはそれを止めるために冒険を続け、ついに黒幕のダークエルフと相対する……という感じです。\n\n----------\n\n本業がお忙しくなってきているかもとの事なので、余裕が無ければキャンセルしていただいても大丈夫です。\nよろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hk_ou_yu/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 1646411, "client_id": 582059, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/67e02c67/uploads/origins/4c268d40-b9d2-4366-a1fc-1471b1dc569f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42c1b342d5c8f45b5db471066d9e421f", "srcset": "https://si.imgix.net/67e02c67/uploads/origins/4c268d40-b9d2-4366-a1fc-1471b1dc569f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42c1b342d5c8f45b5db471066d9e421f, https://si.imgix.net/67e02c67/uploads/origins/4c268d40-b9d2-4366-a1fc-1471b1dc569f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e42784d663e4c711c37ebbcdde61974b 2x, https://si.imgix.net/67e02c67/uplo