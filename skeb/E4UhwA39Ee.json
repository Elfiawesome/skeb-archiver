y_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@E4UhwA39Ee/works/25", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3211458, "client_id": 1032626, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9880e307/uploads/origins/86783109-c8ab-409b-91fc-c0c2a993acab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22cba637aa49a3b588099ad730e4314f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9880e307/uploads/origins/86783109-c8ab-409b-91fc-c0c2a993acab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a65447b171c7003dfe2b876357c7575e", "src_set": ""}, "body": "こんにちは！あなたのアートスタイルがとても好きなので、私のスプラトゥーンキャラクターを描いてもらえないかお願いしたいのです！私のスプラトゥーンのキャラクターを描いていただけませんか？彼女は化学者で、とてもリラックスしてのんびりしています。あなたのスタイルで、白衣を着てこのポーズをとってほしいです！\n\nhttps://de.pinterest.com/pin/7740630605379986/\n\nhttps://toyhou.se/27651490.mev\n\n私の要望を考慮していただき、ありがとうございます！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@E4UhwA39Ee/works/24", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/12d21b2f/uploads/origins/1cfff948-d5cb-4b45-b892-431c450577ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=afb7f25ec7a0e8e496b86d3f33eb5ff8", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3211458, "client_id": 913401, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@E4UhwA39Ee/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3211458, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/826596bb/uploads/origins/4430c4c8-afcf-43f9-99fa-e11324512a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=19488e98ce85892b2e8226e06882735c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/826596bb/uploads/origins/4430c4c8-afcf-43f9-99fa-e11324512a07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0df01f80c27abfbe32f4905fd113a10c", "src_set": ""}, "body": "あなたのアートはとてもダイナミックですね！  今回は、大天使の第三の目と大天使の腕を盗んだ、私の4mの巨女キャラクターの画像を探しています。   彼女は筋肉質な体、大きな胸、幅広の体格、緑色の髪、緑色の目、そしてマジックアイを持つ金色の傷のついた片手を持っています。額の下には光り輝く強力な緑色の目がある。襟には黒と金の特別なピンメダルをつけている。\n\n私は彼女が \"大天使 \"の手にエネルギーの特異点を発生させ、それを封じ込めようと少し奮闘している姿を探している。  その他の詳細はすべてあなたにお任せします。\n\nご考察ありがとうございました！\n\n参考文献\nhttps://imgur.com/a/zs5VgqY\nhttps://pbs.twimg.com/media/GlDFv4ZXkAAtvg7?format=jpg&name=4096x4096\nhttps://skeb.jp/@anagumasan_/works/228", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@E4UhwA39Ee/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3211458, "client_id": 431003, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df36d0b7/uploads/origins/d50d0bc8-595d-450a-ab86-7e1fc330e76c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a3e258c0d505d2f72c0c294b70b6f501", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df36d0b7/uploads/origins/d50d0bc8-595d-450a-ab86-7e1fc330e76c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=41326386ed6bd92dceec2f1d525afa1f", "src_set": ""}, "body": "前回は私の白いオリキャラを描いてくださりありがとうございました。\n今回もリクエストはオリキャラの全身イラストになります。\n\nシチュエーション構図解説\nhttps://drive.google.com/file/d/1YdKZOf19oTksDGeME7lD_j8ocdXrNzyi/view?usp=sharing\n斜めハイアングルで両腕を画像のように構えたイラストになります。\n背景や体の周りから出ている黒いエフェクトが特徴です。雨のようなエフェクトです。\nオリキャラのエフェクトは赤黒くお願いします。\nhttps://www.pixiv.net/artworks/91943434　（エフェクトカラー参考）\n\n表情\nhttps://drive.google.com/file/d/1FFu7LAKwNTxIOONLbKTZGTBsHqjbXSj5/view?usp=sharing\n表情は顔がシワだらけに成るぐらい歪ませた表情でお願いします。\n右目が開き、左目が細くなっています。眉間にもシワがあります。\n\nオリキャラ・衣装設定\nhttps://postimg.cc/gallery/Vwx2B3r \n特徴は金髪ボブ。真っ白な肌。目が黒白目。爪が黒い。筋肉質。180以上の高身長。人外系悪女をイメージしています。\n肌の色は白い肌でお願いします。爪は黒いです。\n黒白目を描く際はこちらをご参考に。\nhttps://drive.google.com/drive/folders/1XeNa1rtwq35FeczkjHfDZNNYArQNkdzm?usp=drive_link　 \n衣装は上と下ですう種類の参考画像があります。\n黒いタンクトップ、アームカバーとエグいほどのスリットの入ったローライズでお願いします。\n・https://www.pixiv.net/artworks/133563754　（タンクトップ＋アームカバー）\n・https://drive.google.com/file/d/1uj0sCSQUIruIOCTmUgA0gwlKgItWTBTd/view?usp=sharing　（下の参考ズボン）\n\n以上となりますよろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@E4UhwA39Ee/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3211458, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ae6814d/uploads/origins/76403016-70c2-471c-8b55-f0c01dd0e5d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6175022294731398df1a74e85742abfe", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3ae6814d/uploads/origins/76403016-70c2-471c-8b55-f0c01dd0e5d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84dbd6f9bf664a02bd9911c9d5d93716", "src_set": ""}, "body": "この溶けた金色の肌をした核の火の女神が、巨大な炎のオーブを頭上に準備しているのを見ることは可能だろうか？\n\n\nご検討のほど、よろしくお願いいたします。\n\n参考文献\nhttps://vgen.co/Dejovanna/portfolio/showcase/halfbody/0e623832-30ca-4e5e-a92b-1c63e5a7a14c\nhttps://x.com/JeremyMomu/status/1900571535519228147", "nc": 145, "word_count": 0, "transcoder": "image", "cre