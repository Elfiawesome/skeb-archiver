て、私のキャラクターにカスタムアウトフィットをしてもらえないかと思いました。\n\n私のキャラクターはペンギンで、世界を支配したいと思っています。しかし、私は彼が海賊であることを前もって知っておきたかったので、それに合わせたカスタムメイドの衣装を提供していただけないでしょうか？\n\nまずは、黒いアイパッチ（リンク先を参照してください）をつけてもらいたいですね。また、海賊帽も参考リンクのようなものですが、よりカスタムされたデザインで、未来に世界を支配しようとしている超悪人に似合うようなものにしたいと思っています。(帽子に王冠をつけるなど）。)\n\nあとは、腰に太いロープを巻いていたり、赤いマントの裾がボロボロになっていたりするのもいいですね。\n\n背景は、自分の船のカラスの巣の梁の上にぶら下がって、ペンギンのくちばしをデザインしたガードのついた大きな刃を持っているような感じにしたいですね。\n\nお読みいただきありがとうございました。\n\nhttps://imgur.com/a/TmemtRM", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@dormir_mm/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 446357, "client_id": 1345956, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0207dad5/uploads/origins/6e9a0d9c-2ad5-4c1b-90dc-504e274ffac5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef34192637cf3ebfede4015559fd81cb", "srcset": "https://si.imgix.net/0207dad5/uploads/origins/6e9a0d9c-2ad5-4c1b-90dc-504e274ffac5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef34192637cf3ebfede4015559fd81cb, https://si.imgix.net/0207dad5/uploads/origins/6e9a0d9c-2ad5-4c1b-90dc-504e274ffac5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3641fad46d8cb1ac42ba6a24bd772e13 2x, https://si.imgix.net/0207dad5/uploads/origins/6e9a0d9c-2ad5-4c1b-90dc-504e274ffac5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=80be196d893e9b2f2cfed73d76a3ec9d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0207dad5/uploads/origins/6e9a0d9c-2ad5-4c1b-90dc-504e274ffac5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0185d702e7562bf51b8aaf4527cbb1e", "srcset": "https://si.imgix.net/0207dad5/uploads/origins/6e9a0d9c-2ad5-4c1b-90dc-504e274ffac5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop