451d-a52b-c99ca8863354?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=066b92409e50106c786926fb4c228b0d", "srcset": "https://si.imgix.net/e62e4dc3/uploads/origins/19359541-4c92-451d-a52b-c99ca8863354?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=066b92409e50106c786926fb4c228b0d, https://si.imgix.net/e62e4dc3/uploads/origins/19359541-4c92-451d-a52b-c99ca8863354?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eb0883aa8101b8aa043907c95a1dbf5a 2x, https://si.imgix.net/e62e4dc3/uploads/origins/19359541-4c92-451d-a52b-c99ca8863354?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=317ff82bbaaf292cf7f47254eb88a7d9 3x"}, "body": "アピールありがとうございました。\n宜しければ、下記のイラストお願いできないでしょうか。\n\n【キャラ】\n以下の中で描きやすいものをどうぞ。\n①「光翼戦姫エクスティア３」より、エクスティア（変身後・変身スーツ）\n②「光翼戦姫エクスティア３」より、葛城真理奈（私服 or 制服）\n③「艦隊これくしょん」より、鈴谷改二\n④「ユニコーンオーバーロード」より、スカーレット\n⑤「DEAD OR ALIVE」より、こころ\n\n【シチュエーション・構図】\n全てお任せいたします。（グロ系以外なら大丈夫です。）\n\n【その他】\n●背景、エフェクトや汗などは、レイヤーでオン・オフできるようお願いします。\n\n以上、何卒ご検討下さいますよう宜しくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1onxKqVHkI5QUTU0VXrSifJM6pHSfnTrh?usp=drive_link", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@KenG21873956/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3805168, "client_id": 1763248, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eabf2693/uploads/origins/fabe4c02-d9ac-4636-b50f-ee58edb93d19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6bf43307f8f272310bdbbc48b781aa38", "srcset": "https://si.imgix.net/eabf2693/uploads/origins/fabe4c02-d9ac-4636-b50f-ee58edb93d19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6bf43307f8f272310bdbbc48b781aa38, https://si.imgix.net/eabf2693/uploads/origins/fabe4c02-d9ac-4636-b50f-ee58edb93d19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad7c5b22c928497be5a0fbc864b11eee 2x, https://si.imgix.net/eabf2693/uploads/origins/fabe4c02-d9ac-4636-b50f-ee58edb93d19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2830f2901e8404128da737ea94068f3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eabf2693/uploads/origins/fabe4c02-d9ac-4636-b50f-ee58edb93d19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0431e571618aa49e84bc7fc114100473", "srcset": "https://si.imgix.net/eabf2693/uploads/origins/fabe4c02-d9ac-4636-b50f-ee58edb93d19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0431e571618aa49e84bc7fc114100473, https://si.imgix.net/eabf2693/uploads/origins/fabe4c02-d9ac-4636-b50f-ee58edb93d19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ef1efbbdc2fdb55f339f4b3b4771109f 2x, https://si.imgix.net/eabf2693/uploads/origins/fabe4c02-d9ac-4636-b50f-ee58edb93d19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=60e23f10c4020afe1b0309bb58b6b232 3x"}, "body": "お声がけしていただき誠にありがとうございます。\nケケ先生の可愛い絵で是非ともニーソコキをお願いします。\n詳細を下記に記します↓\n\nキャラ：ブルーアーカイブより「ニヤニヤ教授」\n\n服装：完全着衣の通常衣装でタイツではなく黒ニーソをお願いします。\n\n構図、構成\nニヤニヤ教授に片脚を上げてもらい、裏もものニーソの履き口からチンチンを挿入して腰を打ち付ける。\n教授はニーソからチンチンが抜けないようにニーソの端を両指で摘まんで押さえてもらいます。\n一度ニーソの中に射精した後、抜かずにそのまま二回戦目のニーソコキを開始しニーソの中に再度大量に射精する。\n表情はからかう様な小悪魔チックな感じだと嬉しいです。\nマニアックなリクエストですが、採用されたら幸いです。何卒お願いします…。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@KenG21873956/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3805168, "client_id": 2137364, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bbde3310/uploads/origins/1f821a92-3c4a-44ff-be93-61995f8f3777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcc567ed7507f72f7d4bfaafd1444d9e", "srcset": "https://si.imgix.net/bbde3310/uploads/origins/1f821a92-3c4a-44ff-be93-61995f8f3777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fcc567ed7507f72f7d4bfaafd1444d9e, https://si.imgix.net/bbde3310/uploads/origins/1f821a92-3c4a-44ff-be93-61995f8f3777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f7df07b3cf931a42dfcb038914bd44db 2x, https://si.imgix.net/bbde3310/uploads/origins/1f821a92-3c4a-44ff-be93-61995f8f3777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e18c52b8cad3cd3881cf736e171c521 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bbde3310/uploads/origins/1f821a92-3c4a-44ff-be93-61995f8f3777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bdbf3d60706444f5a2236b2633caca7b", "srcset": "https://si.imgix.net/bbde3310/uploads/origins/1f821a92-3c4a-44ff-be93-61995f8f3777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bdbf3d60706444f5a2236b2633caca7b, https://si.imgix.net/bbde3310/uploads/origins/1f821a92-3c4a-44ff-be93-61995f8f3777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7eff98bff2700b6e285ce6e07471ecb4 2x, https://si.imgix.net/bbde3310/uploads/origins/1f821a92-3c4a-44ff-be93-61995f8f3777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a1b9a81a0204675a953a7349199a0453 3x"}, "body": "こんにちわ。\n\n早速ですが、二次創作の依頼をさせていただきます。\n恐らくケケ様が御存知ないタイトルだと思いますが、対応可能ならばお願い致します。\n\n\n【作品名】\nティンクルスターナイツ\n\n\n【対象キャラクター】\n桜十路 エルデリーゼ\n\n\n【対象キャラクターのキャラ設定について】\nお金持ちのお嬢様で、箱入り娘として大切に育てられた清楚系な少女です。\n今まで屋敷に籠って育ったため世間知らずで、作品の舞台となる学園で初めて外の世界を見た為か、好奇心旺盛な性格です。\n尚、物語の主人公とは年下(主人公は学園2年生(＝高校生相当)で、エルデリーゼは学園よりも若い生徒たちが通う附属校の3年生(＝中学生相当))なキャラクターです。\nまた、エルデリーゼの個別シナリオでは主人公と恋仲の関係であったりします。\n\n\n【服装】\n制服(資料URL内参照)\n\n\n【胸の大きさ】\n絶壁であり膨らみがほぼ無いです\n\n\n【シチュエーション】\n１．スカートをたくし上げているシチュエーションでお願いします。\n(参考：https://www.pixiv.net/artworks/135676080)\n\n２．シチュエーションのイメージ的には想い人である主人公の前に立って、恥ずかしがりつつも可愛くエッチに誘惑している感じです。\n\n\n【下着の色について】\n対応可能ならば下着の差分を希望します。\n尚、金額・工数に見合わなければ１を優先して下さい。\n\n１．純白のフリルとレース付き\n\n２．薄ピンクのフリルとレース付き\n\n\n【備考】\n可能ならば正面から全身が見える感じの構図でお願いします。\nそれ以外の構図等はお任せします。\nもし金額・工数に見合わなかったり、シチュエーション等で内容が描きずらい等あれば「再送依頼」もしくはキャンセルまたは、ケケ様の裁量で変更・アレンジしてOKです。\n\n\n対応可能でしたら何卒よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/101Mx-2tLlIuO9EnHNG9NR0hQOM6csDYG?usp=sharin", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@KenG21873956/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3805168, "client_id": 3379465, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/32d593d7/uploads/origins/a6001cf4-66d6-49fd-bc0c-d7f2ab4776d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8defdfc6cfe23e721b1f0249bbd9c54f", "srcset": "https://si.imgix.net/32d593d7/uploads/origins/a6001cf4-66d6-49fd-bc0c-d7f2ab4776d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8defdfc6cfe23e721b1f0249bbd9c54f, https://si.imgix.net/32d593d7/uploads/origins/a6001cf4-66d6-49fd-bc0c-d7f2ab4776d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9330f876c14d91d43c1eb23023f34960 2x, https://si.imgix.net/32d593d7/uploads/origins/a6001cf4-66d6-49fd-bc0c-d7f2ab4776d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eccd09e885f5ecda9874d3dc1ab8c1d7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/32d593d7/uploads/origins/a6001cf4-66d6-49fd-bc0c-d7f2ab4776d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffcd4e68dade3375c44f50a4951b5bfa", "srcset": "https://si.imgix.net/32d593d7/uploads/origins/a6001cf4-66d6-49fd-bc0c-d7f2ab4776d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffcd4e68dade3375c44f50a4951b5bfa, https://si.imgix.net/32d593d7/uploads/origins/a6001cf4-66d6-49fd-bc0c-d7f2ab4776d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ea0b1940b6b896bd20d1622717a05554 2x, https://si.imgix.net/32d593d7/uploads/origins/a6001cf4-66d6-49fd-bc0c-d7f2ab4776d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=837f56d6580dbe7f0285a9385af0e174 3x"}, "body": "ケケ様アピールありがとうございます。是非リクエストさせて下さい。\nキャラは勿論ブルアカの空崎ヒナちゃん(可愛いので！)\n\n【シチュ】\n・エッチなネココス着て先生とエッチ\n・先生は普段は原作通り優しいけどエッチの時は欲望に素直。ヒナもその性格を理解していて好き放題されちゃった後に「バカ♡」とか「ケダモノ♡」とか小言を言うぐらいで許してくれる信頼関係がある感じのイチャラブ関係\n・描く必要ありませんが激務で泣き言を言っている先生に今日中に終われば「何でもしてあげる」と言った後にやる気全開で仕事片付けて先生が用意したエッチなネココスを着せられた。というイメージで\n\n【内容】\n・カラーイラスト\n・修正は可能なら線タイプで\n・可能なら宛名を落書きというイメージでお尻に描いて下さい\n・お尻の描き方が魅力的でしたのでお尻がアップ+表情が見える構図を希望します。\n細かいところはお任せですが資料URL作品の様にワイプ形式で表情を挟む等を希望\n・肉球グローブありで資料URLと同じくらいの細い1本の紐にしか見えない様なもの且つ途中からV字に分かれていてお尻の穴が見える下着でお肉に食い込んでいて欲しいです。\n・お尻にはバイブ付きの尻尾を入れられています。そしてスイッチはヒナに持たせてくれていますが小さいスライド式なので肉球グローブのヒナはオフに出来ません。\n\n・上記内容でバックハメ+バイブをオフに出来ず沢山イッちゃうヒナお願いします。\n先生に気持ちいいところを突かれている、バイブを止められずお尻も気持ちよくなっちゃってる様なセリフをお願いします。\n\n【差分】\n可能でしたら以下の差分をお願いします。\n・射精時により一層深く絶頂\n・事後、尻尾外したぽっかりア⚪︎ル\n・スライド式ではなく押しボタン式のスイッチ(ダミー本物は先生が持ってる)で押してるけどグローブ越しなので押してる、押してるのにぃと言うセリフ\n\nhttps://www.pixiv.net/artworks/126278622", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@KenG21873956/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6105a366/uploads/origins/43dd5e1c-6773-4fd1-ad33-458d3c095241?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=416b1010f157735b07630e706e3821c7", "srcset": "https://si.imgix.net/6105a366/uploads/origins/43dd5e1c-6773-4fd1-ad3