s://www.pixiv.net/artworks/131902713\n\nまた、元の画像の首輪をそのまま残した上で、縄で彼女を緊縛してください。上半身では、縄で胸と腕を巻きつけ、両手を背中で縛ってください。下半身では、太ももとふくらはぎを一緒に縛ってください。参考：https://www.pixiv.net/artworks/138079831\n\nもし可能であれば、彼女がボールギャグを装着した差分も追加していただけると嬉しいです。それ以外の部分は、お任せいたします。\n\nご検討いただけると幸いです。\nよろしくお願いします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@KenG21873956/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3805168, "client_id": 692000, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/78f5b8bb/uploads/origins/397d3a78-7700-47e3-9aa1-4148451a86d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3b39b0660d84bdf0982aed350ff3bfa", "srcset": "https://si.imgix.net/78f5b8bb/uploads/origins/397d3a78-7700-47e3-9aa1-4148451a86d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3b39b0660d84bdf0982aed350ff3bfa, https://si.imgix.net/78f5b8bb/uploads/origins/397d3a78-7700-47e3-9aa1-4148451a86d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f7eedbf86de600f28d4281612e11e8ec 2x, https://si.imgix.net/78f5b8bb/uploads/origins/397d3a78-7700-47e3-9aa1-4148451a86d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=64441038ce9ba9cf2780c0eca7ef4619 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/78f5b8bb/uploads/origins/397d3a78-7700-47e3-9aa1-4148451a86d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ee04b915c43b2761013c2e725df35ab", "srcset": "https://si.imgix.net/78f5b8bb/uploads/origins/397d3a78-7700-47e3-9aa1-4148451a86d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ee04b915c43b2761013c2e725df35ab, https://si.imgix.net/78f5b8bb/uploads/origins/397d3a78-7700-47e3-9aa1-4148451a86d5?bg=%23fff&auto=format%2Ccompress&fm=webp