0&h=200&blur=200&s=fc80efd3f0e668cc8ddbb95238b79874 3x"}, "body": "Skeb開放ありがとうございます。\nまた依頼させていただきます。\n\n【キャラクター】\n女王ニア(ゼノブレイド3)\nhttps://appmedia.jp/wp-content/uploads/2022/08/b0716f0e8673caec46d9c6696f9eb5d4.webp\n※戦闘衣装でお願いします。\n\n【シチュエーション】\nニアがバランドに上体の胸まで取り込まれて、感覚遮断でいつの間にか取り返しのつかない程に開発されて、エーテル吸収の苗床にされるシチュになります。\n\n【内容】\n①暗い水辺を仲間とは別行動中に探索する女王ニアは、足下にいたバランドに気づかずに踏んだことで、そのまま体内に体が取り込まれてしまう。\nバランド\n(蕾の部分に上体が出るイメージです)\nhttps://img.game8.jp/7026331/31757663252eac86a51c4792820b45d2.png/show\n感覚遮断穴の構図\nhttps://www.pixiv.net/artworks/108947788\n\n②エーテルが使えないことに気づき、アルストにはなくアイオニオンで産まれた生態だと考察するニア。\n仲間の助けを待つことに。\n\n③ニアは退屈そうに余裕の表情。\nしかしその裏ではニアの体は開発されており、「感覚遮断」「耐性無効」「衣服除去」が発動されている。\n針のような触手をおっぱいに刺されて「膨乳化」クリにも注入されて「媚薬注入」。\n\n④乳首に触手を刺されて「母乳体質化」継続でクリに注入「感度上昇」\n\n⑤母乳がピュっと出る「母乳エーテル噴出」触手をズポズポされて潮吹き中「絶頂体質」\n\n⑥両乳首に吸盤のような触手で母乳が吸われ、お○んこはズポズポ激しくカリでか触手で体液からエーテル摂取。\n\n⑦仲間を発見して、近づいてくる仲間に助けを求めるニア。\n全ての工程が完了して「エーテル製造タンク化」\nあと秒読みで感覚遮断解除\n\n⑧ニアに全ての快楽が襲い掛かる。娘もいる仲間の前で激しいのけぞり絶頂。\n\nエロデバフのステータスをゲームのようなダイアログボックス表記でまとめていただきたいです。\n\n長らく書かせていただきましたが以上となります。\nよろしければご検討のほどよろしくお願いします。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ya2taic/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a4029010/uploads/origins/9a596747-c6d3-47e1-8c8a-700a309f87f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=756572e4710ebcde6b945b569790a99e", "srcset": "https://si.imgix.net/a4029010/uploads/origins/9a596747-c6d3-47e1-8c8a-700a309f87f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=756572e4710ebcde6b945b569790a99e, https://si.imgix.net/a4029010/uploads/origins/9a596747-c6d3-47e1-8c8a-700a309f87f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=907a77bed38aa04e0cfedc6ef34b8934 2x, https://si.imgix.net/a4029010/uploads/origins/9a596747-c6d3-47e1-8c8a-700a309f87f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a9900cfc95775e3db377660d6cb5831 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 116768, "client_id": 998158, "nc": 50}, {"path": "/@ya2taic/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 116768, "client_id": 473379, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/deb78663/uploads/origins/cfa6b808-6469-473d-84ec-459b042dc606?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e90b302cc790db950bf25455b30b1e00", "srcset": "https://si.imgix.net/deb78663/uploads/origins/cfa6b808-6469-473d-84ec-459b042dc606?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e90b302cc790db950bf25455b30b1e00, https://si.imgix.net/deb78663/uploads/origins/cfa6b808-6469-473d-84ec-459b042dc606?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=172741b9e2dc55a5cf393ba5f9afc3b7 2x, https://si.imgix.net/deb78663/uploads/origins/cfa6b808-6469-473d-84ec-459b042dc606?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b741bd19360a134cd0f700bcad3aeb88 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/deb78663/uploads/origins/cfa6b808-6469-473d-84ec-459b042dc606?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1844af78ce285a21d74e234e86740845", "srcset": "https://si.imgix.net/deb78663/uploads/origins/cfa6b808-6469-473d-84ec-459b042dc606?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1844af78ce285a21d74e234e86740845, https://si.imgix.net/deb78663/uploads/origins/cfa6b808-6469-473d-84ec-459b042dc606?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9b0d5dc3c8d62a9d3538ea5fedb53423 2x, https://si.imgix.net/deb78663/uploads/origins/cfa6b808-6469-473d-84ec-459b042dc606?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=658bfa72ef696cfd485666d30c699d73 3x"}, "body": "すみません、金額を間違えていたので一旦キャンセル、再送させて頂きました。\n\nキャラ:魔装戦姫アルティミシア\n\nシチュエーション\nスライムに纏わり付かれ、倒れたまま身動きが出来ない状態。\nスライムは触れているだけでもエネルギーを吸い上げるほか、スライム自体が強力な神経毒(麻痺作用と副作用として性感度が強烈に上昇する)の塊のため、纏わり付かれているだけで身体が痺れて動けなくなり、徐々にエネルギーが奪われている状態。\nその内スライムが体内に入れる穴(陰部と尻穴)を見つけ、そこから体内に侵入。体内に入られた事でエネルギーの吸収スピードが急激に上がると共に、纏わり付かれている時とは比べ物にならない程に感度が上昇し、最後には尻穴から侵入したスライムが口から出てきて、無様なオホ顔を晒し、陰部からは愛液の潮吹きと一緒にスライムを噴出し、スライムが去った後にもひたすら愛液をぷしぷしと吹き出し、母乳も垂れ流しながらビクビクと痙攣し、その場に倒れて放置されている状態。\n\nオリキャラでのリクエストになります。\n衣服はある程度スライムに溶かされていて、胸は両胸とも露出(前の紐を切れば簡単にポロリする様な構造です。)、スカートは陰部が見えるぐらいに溶けている状態です。靴も両方脱げて(或いは溶けて)いる状態でお願いします。\nタイツについてスライムが侵入している陰部、尻穴、及び恥丘周辺のみ穴が空けられていて、それ以外はノーダメージでお願い出来ればと思います。(愛液や汗、スライムなどでグショグショにする分には問題ありません。)\nタイツは100デニールの様な透け感が殆ど無い、割りとしっかりめな物を着用しています。\n設定上下着は一切着用していないので、ノーパンノーブラ状態になります。\n陰毛は無し、スライムが体内にいますがボテ腹なども無しでお願いします。\n\n長身でグラマーなモデル体型キャラで、設定上は自信家でクールな性格なので、泣き顔などは見せたりしませんが、性経験が一切無いため、快楽に耐性が無く、割りと無様に絶頂してしまう様なキャラになります。\n首の宝石はエネルギー残量によって紫(正常)→赤(残量低下)→黒(エネルギー切れ)に変わります。\n\n\nオリキャラかつ変身モノ、エナドレなどフェチ度高めかつ大変ご面倒なリクエストになってしまい申し訳ありません…。ご一考頂けると幸いです。よろしくお願いします。\n\nhttps://x.com/kusodacho_san/status/1916807934962700756?t=QTk0DFxCIzUGI7wKEDhoSQ&s=19", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ya2taic/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 116768, "client_id": 478303, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea165d66/uploads/origins/67758705-1528-4792-b4d6-be15d9a636c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f5d618c0a88e05cf530ec770a9d4e6c", "srcset": "https://si.imgix.net/ea165d66/uploads/origins/67758705-1528-4792-b4d6-be15d9a636c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5f5d618c0a88e05cf530ec770a9d4e6c, https://si.imgix.net/ea165d66/uploads/origins/67758705-1528-4792-b4d6-be15d9a636c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=65579d6c33c92af14070a507af2492a7 2x, https://si.imgix.net/ea165d66/uploads/origins/67758705-1528-4792-b4d6-be15d9a636c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c91731d961cd037f0ca0d8829fd978e6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea165d66/uploads/origins/67758705-1528-4792-b4d6-be15d9a636c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=598bc47382181db1db493332d0e4c798", "srcset": "https://si.imgix.net/ea165d66/uploads/origins/67758705-1528-4792-b4d6-be15d9a636c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=598bc47382181db1db493332d0e4c798, https://si.imgix.net/ea165d66/uploads/origins/67758705-1528-4792-b4d6-be15d9a636c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=773d5884c5991716285ddbde3e0a43ff 2x, https://si.imgix.net/ea165d66/uploads/origins/67758705-1528-4792-b4d6-be15d9a636c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=45f31c137b7e3bf55756b6e3d1dfb219 3x"}, "body": "こんにちは！ゼノブレ２のイラストを見たきっかけで同人誌を購入するほど現在もやたいさんの虜になっております。早速ですがコミックのSKeb依頼させていただきます。\n【キャラ】\n・ナエル（ゼノブレイド３）&カギロイ（ゼノブレイド３）\n・ホムラ （ゼノブレイド２）&ヒカリ（ゼノブレイド２）\n・フィオルン（ゼノブレイド）&フィオルン（ゼノブレイド）\nどちらか１組をお願いします。\n【内容】\n敵の捕虜となるor弱みを握られるor子孫繁栄という名目で複数人に乱交（受難）に遭うコミックをお願いします。\n\n①服が破れるもしくは裸になった１組が周りの見世物にされて焦り混じりで睨みつける。\n②正面から胸を揉む・乳舐め・パイズリ・クンニ・手マン等で前戯を行い１組の反応を楽しむ。\n③隣に向かい合わせるように、「入って．．」「そんなの入らない！」と相手の大きさにたじろぐも無理やり上書きされるように正常位で乱交される。\n④両腕を乱暴に掴まえて後背位の体勢になり、乳合わせの状態でディープキスを行い中出しフィニッシュ\n\nのようなコミックをお願いします。金額に見合っていなければキャラ１人もしくは簡略化にしてもらっても大丈夫です！\nご検討よろしくお願いします！", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ya2taic/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e52c7786/uploads/origins/018159a4-8ba6-4b17-825d-2b1cdcd70a6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99138a62047385c5dd5a76ea6f5d9fca", "srcset": "https://si.imgix.net/e52c7786/uploads/origins/018159a4-8ba6-4b17-825d-2b1cdcd70a6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=99138a62047385c5dd5a76ea6f5d9fca, https://si.imgix.net/e52c7786/uploads/origins/018159a4-8ba6-4b17-825d-2b1cdcd70a6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ded0609eb84809c3ffdba38b337ae0da 2x, https://si.imgix.net/e52c7786/uploads/origins/018159a4-8ba6-4b17-825d-2b1cdcd70a6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=70759c00f55b86341be20fe621b0837b 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 116768, "client_id": 2235683, "nc": 162}, {"path": "/@ya2taic/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 116768, "client_id": 2928790, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/64345898/uploads/origins/3524a73a-78d6-4b80-b9e7-96621d49732f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13983b664d2aba88ac7b8b281d9111ce", "srcset": "https://si.imgix.net/64345898/uploads/origins/3524a73