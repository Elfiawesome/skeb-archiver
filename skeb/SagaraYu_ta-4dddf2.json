xiv.net/en/artworks/108246402、https://www.pixiv.net/en/artworks/110076065。\n\n巴の巨乳を触りやすいように、もう少し背を高くしてください。巴は、例のピックと同様、彼女のマスターよりもまだ背が高い。二人ともヌードで、巴はアヘ顔でお願いします。よろしくお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@SagaraYu_ta/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dd621229/uploads/origins/f247540d-a095-4308-a450-e081e623e7d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f2057ac9832f8e5749c15a1aeeb9847", "srcset": "https://si.imgix.net/dd621229/uploads/origins/f247540d-a095-4308-a450-e081e623e7d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f2057ac9832f8e5749c15a1aeeb9847, https://si.imgix.net/dd621229/uploads/origins/f247540d-a095-4308-a450-e081e623e7d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cdca858dc59388524bb7c2a718e33f36 2x, https://si.imgix.net/dd621229/uploads/origins/f247540d-a095-4308-a450-e081e623e7d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1aebe08a497e1a3614a45524c4ff56ab 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2656651, "nc": 49}, {"path": "/@SagaraYu_ta/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2656651, "client_id": 44251, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34bc76cc/uploads/origins/cfe0fce3-1919-47cd-ae1c-335f906a3c17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3e2955d543092ae6c31856b005ef77f", "srcset"