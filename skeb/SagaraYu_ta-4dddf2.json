enre": false}, {"path": "/@SagaraYu_ta/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2656651, "client_id": 1366155, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a0d3369/uploads/origins/3d18ed5e-c094-4635-9da9-ddc6256ce550?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf4b7362539dd82ce73e2f4734a15b52", "srcset": "https://si.imgix.net/1a0d3369/uploads/origins/3d18ed5e-c094-4635-9da9-ddc6256ce550?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf4b7362539dd82ce73e2f4734a15b52, https://si.imgix.net/1a0d3369/uploads/origins/3d18ed5e-c094-4635-9da9-ddc6256ce550?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b7abde45e6e2e52ea2e2ab2da46e40f 2x, https://si.imgix.net/1a0d3369/uploads/origins/3d18ed5e-c094-4635-9da9-ddc6256ce550?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc2408daf3315131aab96efa074dc6d0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a0d3369/uploads/origins/3d18ed5e-c094-4635-9da9-ddc6256ce550?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=496456c0909a47cf970232c53f2eab37", "srcset": "https://si.imgix.net/1a0d3369/uploads/origins/3d18ed5e-c094-4635-9da9-ddc6256ce550?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=496456c0909a47cf970232c53f2eab37, https://si.imgix.net/1a0d3369/uploads/origins/3d18ed5e-c094-4635-9da9-ddc6256ce550?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=70aba8a439ed5fc8a8d4e5cc4566da35 2x, https://si.imgix.net/1a0d3369/uploads/origins/3d18ed5e-c094-4635-9da9-ddc6256ce550?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0d70777a0269b84ca642c821b3d178b0 3x"}, "body": "遊戯王のRAI-MEIとトリックスター・リリーベルのフタナリレズセックスをリクエストさせて頂きます\n\n竿役:リリーベル。ロリ体型かつ腹ボコ出来そうなサイズの巨根付。\n\n受け:RAI-MEI。生えてない。全身むちむちで乳のサイズは頭より大きくへそまでが隠れるくらいの爆乳(=腹から股間が見えるように)\n\n服装は2人とも元のカードのイラストで着ている物で、RAI-MEIは股間部のみ露出、リリーベルはドロワーに穴が開き陰茎がスカートを持ち上げて露出した状態です。体位は立ちバックでキャラの正面が良く見えるアングルでお願いします。\n\n1枚目：挿入前。リリーベルがRAI-MEIに挿入しようとし、RAI-MEIがそれに対し抵抗or誘惑(お好きなシチュをお選び下さい)している。\n\n2枚目：挿入後。激しくピストンしながら二人とも軽めのアへ顔でオホ声混じりの淫語を連発しよがっている。\n\n3枚目：膣内射精&絶頂。二人とも汚い口調で淫語を絶叫しながらイき、ここ一番の変顔に片足突っ込んだアへ顔になる。\n\nという差分と、それぞれに二人のセリフをテキストで付けて頂きたいです。キャラの性格や口調は2人ともそれぞれお好きなイメージで設定して頂いて構いません。\n\nかなり細かく指定してしまいましたが何卒宜しくお願い致します。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@SagaraYu_ta/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2656651, "client_id": 44251, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/13cdb720/uploads/origins/e0c57b79-ba7a-418b-b43c-affbed6b7a98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25b9255a06c1d9437acad7ff1620d639", "srcset": "https://si.imgix.net/13cdb720/uploads/origins/e0c57b79-ba7a-418b-b43c-affbed6b7a98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25b9255a06c1d9437acad7ff1620d639, https://si.imgix.net/13cdb720/uploads/origins/e0c57b79-ba7a-418b-b43c-affbed6b7a98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1460724400b58b12c656cb8c2dabf420 2x, https://si.imgix.net/13cdb720/uploads/origins/e0c57b79-ba7a-418b-b43c-affbed6b7a98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b16613887f91f77de9513dce265c1233 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/13cdb720/uploads/origins/e0c57b79-ba7a-418b-b43c-affbed6b7a98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66e4a89113b5c22a4515225b3ca66036", "srcset": "https://si.imgix.net/13cdb720/uploads/origins/e0c57b79-ba7a-418b-b43c-af