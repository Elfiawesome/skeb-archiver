muimi)です。\nとても可愛らしく透明感のあるイラストが大好きで、ぜひまたご依頼させていただきたく失礼致します……！\n\n自創作のうちの子「彗月(はづき)」をお願いしたいです。\n資料：資料URLの15枚目「星宿 彗月」とあるもの\n「生命の樹」という神樹の神託を受ける、守護者とよばれる巫女のような役割の少女です。\n幼めの見た目をしており、いつも優しく微笑んでいます。感情は発展途上です。\nステラと呼ぶ星の妖精を連れており、星の魔法を使います。\nポーズや構図等はお任せします。資料にもざっくりとしたキャラクター設定を載せているので、てまり様のイメージで自由に描いて頂けますと嬉しいです。\n\nもしよろしければ、ご検討いただけると幸いです。\nよろしくお願いいたします！\n\nhttps://www.pixiv.net/artworks/84561489", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@smksugger/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b1502c95/uploads/origins/245657a3-6437-4023-a645-f34b705a9f1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad5b33b5ce9981737730120a13f6bd10", "srcset": "https://si.imgix.net/b1502c95/uploads/origins/245657a3-6437-4023-a645-f34b705a9f1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad5b33b5ce9981737730120a13f6bd10, https://si.imgix.net/b1502c95/uploads/origins/245657a3-6437-4023-a645-f34b705a9f1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de29a8daee1816774b178ff2f983427f 2x, https://si.imgix.net/b1502c95/uploads/origins/245657a3-6437-4023-a645-f34b705a9f1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c24042e34c6eafa8ccfd88ef6aea674 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2079554, "nc": 17}, {"path": "/@smksugger/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2079554, "client_id": 2764555, "vtt_url": null, "thumbnail_image