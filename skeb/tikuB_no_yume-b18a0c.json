0&blur=200&s=dd33d80de510fb32866eb8c1a7598182, https://si.imgix.net/6ca6d4f7/uploads/origins/ee012340-167a-44d9-9395-e2c8c3ab8bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3e13a2ef8e49344be05c769cc02dad9c 2x, https://si.imgix.net/6ca6d4f7/uploads/origins/ee012340-167a-44d9-9395-e2c8c3ab8bf7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=08567fe6a362ba7d4380edfa8f1be48d 3x"}, "body": "今回は自創作のリアム・ブルーベリーとドール・ブルーベリー(リアムの幼少期)の同一人物カプのイラストをお願いしたいです！\n構図はお任せします。カプといっても別に恋愛感情はないですが、密接な距離感でイチャイチャしてる構図でもそれはそれで営業してくれてる感あって興奮するので何でも大丈夫です！\n\n詳細\nhttps://drive.google.com/drive/folders/1-nJGv4s4acOVnvYvTjOYTe2RAXqH3fhP\n\n⬆️上記の補足\nドールは親から成長を惜しまれ、(その親にとって)一番美しい時期である7歳の頃に成長を止める魔法にかけられます。著名人形作家の親は、ドールを“生きる人形”として自分の最高傑作のように扱っていました。その頃のドールは意思などはほぼ存在せず、いかに理想的な美しい所作を続けていられるかだけを気にして生きており、人間性はほとんど空っぽです。\nそんなドールは恩師と出会ったことで意思が芽生え、初めて親に反抗し、女装もやめ、自分の名前を「リアム」と改名して家族と縁を切りました。その後リアムは自分の好きなように生きるようになり、恩師と同じ学校の教師となりました。\n\nリアムはドールという自分の過去を黒歴史としてはいますが、その一方でドールに似た哀愁のある生徒を見ると放って置けないところもあり、どこかで愛情を抱いています。\nドールがもしリアムと別人として出会ったら、「かっこいい生き物だな」というような感情をぼんやり抱くと思います。", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 1688710, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "KiiKo @アニメ原画風skeb", "screen_name": "Kiiko_clip", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fd4b360a8-1c07-44f9-b59a-94c6982e2227.gif&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/fb207f67-3c6c-47bb-9795-c6d4b3977f4a.webp", "appeal_receivable": false, "popular_creator_rank": 34, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 8, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 2003450, "creator": true, "nsfw_acceptable": false, "acceptable":