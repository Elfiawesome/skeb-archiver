包まれた小さな閉ざされた町。町外れには昭和末期の施設跡が残り、不思議な噂がある場所です。\n\nどうぞよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/ro6jz4rzm3y1pzflz7r1k/APxGHKwy42TOi1gVUhP3Rl8?rlkey=jt5c9anrp5cxgwlejq5v70gdr&st=ikvxbxqw&dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@it_oxq/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3075660, "client_id": 2424157, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23750521/uploads/origins/78ed5c04-61db-4bf9-a9c6-9923e16d7c74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95908521caf558f1642b0c83f6d522b4", "srcset": "https://si.imgix.net/23750521/uploads/origins/78ed5c04-61db-4bf9-a9c6-9923e16d7c74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95908521caf558f1642b0c83f6d522b4, https://si.imgix.net/23750521/uploads/origins/78ed5c04-61db-4bf9-a9c6-9923e16d7c74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f31a66812f536dbff8c50905541d1a7 2x, https://si.imgix.net/23750521/uploads/origins/78ed5c04-61db-4bf9-a9c6-9923e16d7c74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39d0ab5b7cc7f4efc8770d26f8713701 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23750521/uploads/origins/78ed5c04-61db-4bf9-a9c6-9923e16d7c74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=360174642ab2c91e8c6e94659aa5167a", "srcset": "https://si.imgix.net/23750521/uploads/origins/78ed5c04-61db-4bf9-a9c6-9923e16d7c74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=360174642ab2c91e8c6e94659aa5167a, https://si.imgix.net/23750521/uploads/origins/78ed5c04-61db-4bf9-a9c6-9923e16d7c74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1598f48058af25ab95cbe444af97c79c 