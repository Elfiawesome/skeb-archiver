補佐をしている囚人。明るくてうるさくて元気で生意気で小さい。アルビーを揶揄うのが趣味。馬鹿。\n\n・二人はバディです。表には出さないようにしていますがお互いがお互いに依存気味です。\n\n・出来れば二人で星空の下にいるような雰囲気だと嬉しいな～と思いますが、詳細はおまかせ致します。\n\n服装や髪型の簡略化省略改変等、特に問題ありません。描きやすいように描いていただければと思います。\n\nまた、金額等に問題などありましたら気兼ねなく再送要請をお願いします！\n\n以上になります。是非よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1u3wF0y8VkO9DqC7QBLiNnSWjkKNjJWTe", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@9ch1ko/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2320664, "client_id": 2771878, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/80d58387/uploads/origins/4b911c6d-ce31-4a8e-a9c0-15d77feab701?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8f240a3071764ba93e155d77e8bf73f", "srcset": "https://si.imgix.net/80d58387/uploads/origins/4b911c6d-ce31-4a8e-a9c0-15d77feab701?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8f240a3071764ba93e155d77e8bf73f, https://si.imgix.net/80d58387/uploads/origins/4b911c6d-ce31-4a8e-a9c0-15d77feab701?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bdc94a37b3679c235987d1fdf10fc169 2x, https://si.imgix.net/80d58387/uploads/origins/4b911c6d-ce31-4a8e-a9c0-15d77feab701?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b35b8b10018bad85fc49ef5630d2ab9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80d58387/uploads/origins/4b911c6d-ce31-4a8e-a9c0-15d77feab701?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f20c1fcf2a868f9c2286890fbf8fd1d", "srcset": "https://si.imgix.net/80d58387/uploads/origins/4b911c6d-ce31-4a8e-a9c0-15d77feab701?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f20c1fcf2a868f9c2286890fbf8fd1d, https://si.imgix.net/80d58387/uploads/origins/4b911c6d-ce31-4a8e