=top&w=200&h=200&s=80dd6c8cc1c1c79d17591ad4d5f5a11a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5079976/uploads/origins/5e17d3c5-0059-49ca-9562-3ad404f66d10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2dc23f9c7ce9f9e1b6d5ed1ba822a907", "srcset": "https://si.imgix.net/a5079976/uploads/origins/5e17d3c5-0059-49ca-9562-3ad404f66d10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2dc23f9c7ce9f9e1b6d5ed1ba822a907, https://si.imgix.net/a5079976/uploads/origins/5e17d3c5-0059-49ca-9562-3ad404f66d10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c091ab73edb0aa13a922d28805c77f2a 2x, https://si.imgix.net/a5079976/uploads/origins/5e17d3c5-0059-49ca-9562-3ad404f66d10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8fb3aab2c78d9a753c33381796b1bf90 3x"}, "body": "こんにちは！あなたの作品はとても美しくて魅力的なので、ぜひあなたの作品をお願いしたいです！\n私の眠たそうなドラゴンの女の子を、好きなスタイルと方法で描いてもらいたいです！彼女はとても眠そうですが、おてんばでもあります！鋭い歯とウロコを持っています！その他はお任せします！楽しく描いてください、ありがとうございました！\n\nhttps://imgur.com/a/1QZf4M7", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@3_rftt/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2702354, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/47e6d50f/uploads/origins/b476a2ff-1e20-482f-96f9-0bfd53ca00eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41bec9f13c30c712744b314490b90d0c", "srcset": "https://si.imgix.net/47e6d50f/uploads/origins/b476a2ff-1e20-482f-96f9-0bfd53ca00eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41bec9f13c30c712744b314490b90d0c, https://si.imgix.net/47e6d50f/uploads/origins/b476a2ff-1e20-482f-96f9-0bfd53ca00eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=