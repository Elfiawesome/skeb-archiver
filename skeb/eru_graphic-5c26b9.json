43bcfd6f247?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c222c25c2cf97449539ae5d67fd6867e", "srcset": "https://si.imgix.net/61f75e3b/uploads/origins/c1ae5af3-8293-4b7c-b5be-f43bcfd6f247?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c222c25c2cf97449539ae5d67fd6867e, https://si.imgix.net/61f75e3b/uploads/origins/c1ae5af3-8293-4b7c-b5be-f43bcfd6f247?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ec99fe9457c8e20ffab3375f0c94fe82 2x, https://si.imgix.net/61f75e3b/uploads/origins/c1ae5af3-8293-4b7c-b5be-f43bcfd6f247?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7789eb5b1606f2ce6f7ff52d41e23ab5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61f75e3b/uploads/origins/c1ae5af3-8293-4b7c-b5be-f43bcfd6f247?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bba0d66d22d2f381323db9b37e63d62d", "srcset": "https://si.imgix.net/61f75e3b/uploads/origins/c1ae5af3-8293-4b7c-b5be-f43bcfd6f247?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bba0d66d22d2f381323db9b37e63d62d, https://si.imgix.net/61f75e3b/uploads/origins/c1ae5af3-8293-4b7c-b5be-f43bcfd6f247?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=33f7c78de4a8002b0e49c4ca06248310 2x, https://si.imgix.net/61f75e3b/uploads/origins/c1ae5af3-8293-4b7c-b5be-f43bcfd6f247?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=51ddf8c9b4c8962b37ca5719cb198c5f 3x"}, "body": "初めまして、\n「ジューンブライド（エロ）」のイラストでえるん様のことを知りました。\n他にも「ペットの調教師さん」のような無理矢理調教される展開も好きです。\n良ければそんな依頼をさせて頂けないでしょうか\n\n〇エッチなウェディングドレスを着て、好きでもない人と結婚させられているjkちゃんのイラストをお願いします。\n\n～～設定～～\nペットの調教師さんの展開と同様、今まで普通の高校生活を送っていたjkちゃんが、\n監禁、調教され販売され結婚させられてしまった…という設定。\n結婚式の途中、大勢の前で妻になることを誓わされている場面を描いていただきたいです。\nまた描写する必要はありませんが、これもペットの調教師さんと同様、\n彼氏とは手もつないだこともなかったが、知らない相手とは裸を見られ結婚させらている\nという設定だと嬉しいです。\n\n～～構図～～\n髪色は黒。髪型などはお任せします。\n「ジューンブライド（エロ）」のように胸を露出したウェディングドレスを着ており、\nペット用の首輪をつけている。胸は調教の末に大きくなっている。\n正面に立っている夫となる相手に片胸を揉まれており、それを大勢の参加者に見られている状態。\n涙目になっているが抵抗はせずされるがまま。\n\n何卒よろしくお願いします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 6654, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "せつにゃん＠DMのURLに飛ばないでください！", "screen_name": "hardcrom", "avatar_url": "https://pbs.twimg.com/profile_images/1359411948345958400/NhpWh9pU.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": 43, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 160}, {"id": 227910, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "九重みすい", "screen_name": "msi12c", "avatar_url": "https://pbs.twimg.com/profile_images/1646116847924944901/3A3tCTKw.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 49}, {"id": 455677, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "五味むみ", "screen_name": "hakumaiteacher", "avatar_url": "https://pbs.twimg.com/profile_images/1725477525886062592/zMcBT113.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1186255326875504642/1717073109/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 161}, {"id": 1176015, "creator": true, "nsfw_acceptable": true, "acceptab