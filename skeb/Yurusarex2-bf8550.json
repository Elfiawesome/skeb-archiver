e_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@Yurusarex2/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 555502, "client_id": 69378, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e5e97502/uploads/origins/a5e2f6d9-a986-4fc1-8f3f-be9d8cbf1f2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d43500e90887c55efbe537f0e0738732", "srcset": "https://si.imgix.net/e5e97502/uploads/origins/a5e2f6d9-a986-4fc1-8f3f-be9d8cbf1f2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d43500e90887c55efbe537f0e0738732, https://si.imgix.net/e5e97502/uploads/origins/a5e2f6d9-a986-4fc1-8f3f-be9d8cbf1f2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d55e69006b5dd97d21b9699b8b30e2f9 2x, https://si.imgix.net/e5e97502/uploads/origins/a5e2f6d9-a986-4fc1-8f3f-be9d8cbf1f2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf4b059dc6350fd1b110450855e1ab50 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e5e97502/uploads/origins/a5e2f6d9-a986-4fc1-8f3f-be9d8cbf1f2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6fc7dae7b1080aa072b7f8d7d3c6ed8", "srcset": "https://si.imgix.net/e5e97502/uploads/origins/a5e2f6d9-a986-4fc1-8f3f-be9d8cbf1f2a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6fc7dae7b1080aa072b7f8d7d3c6ed8, https://si.imgix.net/e5e97502/uploads/origins/a5e2f6d9-a986-4fc1-8f3f-be9d8cbf1f2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=26df74df03dbfc82639f1636c543db4d 2x, https://si.imgix.net/e5e97502/uploads/origins/a5e2f6d9-a986-4fc1-8f3f-be9d8cbf1f2a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=278b7fed1a0c1c255d31190ee83756c8 3x"}, "body": "募集再開とのことでリクエストさせていただきます！\nお願いしたいのは対魔忍RPGxの舞華姐さん（RONIN）で、https://skeb.jp/@Yurusarex2/works/3 \nこちらで描かれていらしたデカチンの剣聖オークがあまりにも素晴らしすぎて、同じようなシチュで舞華姐さんがチンポに完全屈服するシチュをお願いしたいです…！！\n\n構図も同じようなものを希望で蹲踞の姿勢フェラ、正常位セックス中出しを希望\n\n眼前に凶悪なデカチンを突きつけられ内心これでヤられたらヤバいのはわかりつつもオークに対し、テメーみたいな粗チンじゃ何も感じねーよと挑発\n頭を掴まれてイラマで喉を犯され絶頂の波が何度も押し寄せる中喉と腹に無慈悲な大量射精をされる\n\n喉を犯されただけでこれだけイっちまうならと期待が止まらず、オークに対しわざと暴言を吐きながらチン媚び挑発発言を繰り返し、竿キスをしまくる\n\nいざチンポがマンコの前に添えられると、完全に終わってしまうのが肌でわかってしまい、やっぱりやめてくれと言おうとするがその前に正常位でデカチンを根元までぶち込まれて一発敗北、クソクソ言いながらもこのチンポ愛しちまう❤️と自分がチンポに負けてる事を自覚しながら、子宮を全力でチンポで腹がボッコンボッコンも浮き上がるほどブン殴られながらピストンされ続けイカされまくり、お腹がボンっと膨らむほど大量のザーメンをブチ込まれチンポのお嫁さんになる宣言しながら絶頂、射精が終わると同時に即ピストン開始、やめろっ❤️まだイってる❤️死ぬっ❤️死んじまうぅっ❤️と懇願するが止まるはずもなく、そのまま暗転…数時間後ぐったりしながらアヘアヘとイきまくるだけの舞華姐さん\nしばらくのち、蹲踞で亀頭を下品に舌先でチロチロと鈴口をほじくり回しながら私の負けだからもっとズボズボしてザーメンくれよぉ❤️と懇願、オークの性処理お嫁さんエンド\n\n希望のシチュは以上です\n\nツャンバーさんの凶悪なデカチン描写、ザーメン量の多さ、見てるだけで熱が伝わるセリフと隠語の数々、そしてあまりに可愛くエロすぎるチンポに負ける女の子、全ての描写が大好きです…特にこの凛子絵は本当に素晴らしすぎました…\n\nほとんど似たような内容でキャラ違いの形になってしまいましたが、是非ツャンバーさんのデカチンに負ける舞華姐さんが見たいので、ご検討くだされば幸いです…！！！", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Yurusarex2/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 555502, "client_id": 123750, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d01b339/uploads/origins/64bbd815-05e0-41ef-86a9-dfaf70e8ace0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3e9e4773ede4621b50e4a4f0e54bf07", "srcset": "https://si.imgix.net/3d01b339/uploads/origins/64bbd815-05e0-41ef-86a9-dfaf70e8ace0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3e9e4773ede4621b50e4a4f0e54bf07, https://si.imgix.net/3d01b339/uploads/origins/64bbd815-05e0-41ef-86a9-dfaf70e8ace0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f4df75a0b6161a5aebf4e467dab60a6 2x, https://si.imgix.n