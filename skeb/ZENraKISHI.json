_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 2, "received_works": [{"path": "/@ZENraKISHI/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 60811, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e50faac/uploads/origins/d9829552-f9a2-4b15-a8bf-bb9efb0e0a10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddf427c1f2f188d088317a89280dc288", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7e50faac/uploads/origins/d9829552-f9a2-4b15-a8bf-bb9efb0e0a10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2907e4561553ba942cc3ac06959e2af2", "src_set": ""}, "body": "お忙しいところリクエスト失礼いたします。\n「ビーチで昼寝するサイレンススズカとスペシャルウィーク」をお願いします。\n\n・服装は\nサイレンススズカ→波間のエメラルド\nスペシャルウィーク→ほっぴん♪ビタミンハート\n\n・シチュエーションは砂浜で２人がレジャーシートの上で仰向けで寝ている。\n・スペはスズカの方に顔を向けて微笑んでいる。スズカの表情はお任せします。\n\n何卒ご検討の程よろしくお願い致します。\nhttps://drive.google.com/drive/folders/1xZsi6iwICGjpcSLPkWjYUaHVRotIXXQY?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ZENraKISHI/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 60811, "client_id": 639858, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd437575/uploads/origins/917427c8-37c0-4c9f-bb2a-8a2efe097f21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef40432c7810c993291e162f7797f363", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dd437575/uploads/origins/917427c8-37c0-4c9f-bb2a-8a2efe097f21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9bff08f90de26c919d9781f99c96e72c", "src_set": ""}, "body": "いつもpixivでイラストや漫画を拝見してます。\nリクエストお願いします。\n\n【キャラクター】\nワラクルチェーラ (ウマ娘)\n→善騎士先生がpixivで公開されていたオリジナルウマ娘のワラクルチェーラさんに一目惚れしましたのでこの子のイラストをお願いします。\n\n【服装】\nビキニの水着姿でお願いします。\n水着の色やデザインはおまかせいたします。\n\n【表情・ポーズ・構図など】\n抜群のスタイルを見せつけるようなセクシーなポーズ・構図でお願いします。\n表情は挑発的な雰囲気でお願いします。\n\n\nリクエスト内容は以上です。\nご検討よろしくお願いいたします。\n\nhttps://www.pixiv.net/artworks/130470749", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ZENraKISHI/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 60811, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51a928d6/uploads/origins/9b6d0ae5-7891-4cc9-88c2-96104475fa5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ab28aa90fd1759ea9be3befcb87792b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51a928d6/uploads/origins/9b6d0ae5-7891-4cc9-88c2-96104475fa5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=098b806c4617cc7fd15bce19f1e4a254", "src_set": ""}, "body": "ギャルウィークキングをぜひもう一度お願いします…！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ZENraKISHI/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 60811, "client_id": 2599757, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb920e17/uploads/origins/19bb22ba-11bf-4358-9d36-910d8a32dcee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c797061de7650c7acc0c1daa68d4c6b0", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bb920e17/uploads/origins/19bb22ba-11bf-4358-9d36-910d8a32dcee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61e83f44159e7a6ffb7fddd78f5ce0b4", "src_set": ""}, "body": "初めまして善騎士先生、もしよろしければ私の推しキャラのイラストを描いて頂きたくリクエストしました。\n\n■キャラは魔法少女リリカルなのはシリーズのヴィータちゃんともう一人お好きなリリカルなのはシリーズのキャラを\n\n■衣装は他版権コスか　変身衣装ベースで脱衣状態はお任せします\n\n〇罰ゲームか何かで他版権コスを着て恥ずかしがっている姿か　変身衣装でのヒロピンイラストのどちらかを希望します、また私の依頼傾向から惹かれる案があればそちらでも構いませんお任せします。　\n\n☆KENZENイラストか成年向けイラストかはお任せします\n\nもしよければ検討して頂けると嬉しいです、よろしくお願いいたします。\nhttps://drive.google.com/drive/folders/1-zs3qEOEPDO5WmRCNEOXFbmpSG8mkEQZ?usp=drive_link", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ZENraKISHI/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 60811, "client_id": 3342082, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d42b9b8f/uploads/origins/83ca8215-55c3-44fc-a8fd-cfee3dc778ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=315a612bb95aff2be30f5ee4e25abcd7", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d42b9b8f/uploads/origins/83ca8215-55c3-44fc-a8fd-cfee3dc778ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7cfb5f9e206ff28e631f726fa95abd4", "src_set": ""}, "body": "こんにちは、私のVTuberキャラクターの絵をお願いしたいのですが。\n彼女は人間の耳を持っていて、サキュバスの角、翼、尾を持っています。\n\nどんなポーズ、服装、表情でも自由に描いてください。\nセクシーでも生意気でも何でも。\n\nDiscordやBlueskyなどのSNSで使いたい。\n参考画像はURLにて！\n\nhttps://drive.google.com/file/d/1yEW9cGqXvnV6CtpQ13xpwU858gkmAzon/view", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ZENraKISHI/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/39067e3f/uploads/origins/0ed08794-06bd-404e-9d02-e557b283070e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=20d47a2f3549a6de4bda7e8942c1f031", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 60811, "client_id": 3146551, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@ZENraKISHI/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 60811, "client_id": 3146551, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe58f971/uploads/origins/1c389d97-ff1e-4c9f-8a1c-9744786a1457?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f22efac7d887a914656abd0675abad09", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe58f971/uploads/origins/1c389d97-ff1e-4c9f-8a1c-9744786a1457?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a09412c00d78be6b8f7a7563b409805", "src_set": ""}, "body": "前回はありがとうございました！\nまたお願いしたいので依頼させていただきました。\n\nお願いしたいキャラはアンジュ・ユナイトに登場する【椎名あずさ】で以下のシチュエーションを希望します。\n・シチュエーションはプール掃除\n・学校の水抜き済のプールの中で天気は晴天\n・快活な女性で青春の1ページのイメージ\n・中央にあずさを配置\n\n・服装は学生服で上は白シャツで腕まくり(肘が出ない程度にまくる)\n※黒い制服はなしでお願いします。\n・下はスカートで中は下着ではなくスクール水着\n・第一ボタンは開けている状態で青のリボンを緩く\n・スカートの中にシャツはいれないで、裸足\n・髪は縛らない\n・手に水がでるホースを持っていてこちらに水をかけてくるイメージ\n・両手でホースをもって水をかけるか、片手にホースで水をかけ、片手にプール掃除で使う長いブラシを所持(可愛くてしっくりくるほうでお願いします。)\n・表情は超笑顔で元気\n・上は水でスクール水着が透けていると嬉しい\n・胸の大きさは画像準拠(あまり大きすぎるのはNG)\nhttps://imgur.com/a/57QgYv0\n\n・プレイマットにする予定なので縦380mm×横630mm 解像度350dpi、納品に必要なのでpsdファイルもいただけますと幸いです。\n\n以上でございます。\n詳細に関しては画像で共有させていただきましたのでご確認いただけますと幸いです。\n※最下部に水をかけるイメージを共有させていただきます。\n引き続きよろしくお願いいたします。\n\nhttps://imgur.com/a/57QgYv0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ZENraKISHI/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 60811, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/700decb8/uploads/origins/1fe1422d-dca4-4b4b-9222-9eac230e950a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81eb9f6d46f544a7b04d6a025c8378a1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/700decb8/uploads/origins/1fe1422d-dca4-4b4b-9222-9eac230e950a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7612905761e553cd76fb200c828a575b", "src_set": ""}, "body": "リクエスト失礼いたします。\n中の人繋がりになりますが、ウマ娘のサイレンススズカとFGOのメリュジーヌがお互いの水着衣装を交換しあい、着た上でのツーショットイラストをお願いします。\n\nスズカのは「波間のエメラルド」の衣装でお願いします。\n\nhttps://imgur.com/a/NTBBFVa\n\nメリュジーヌのは「水着霊器での第一再臨」の格好でお願いします。\nまた、着けているマスクは、外すか下げたりして口元が見えている感じでお願いします。\n\nhttps://imgur.com/a/wuakSUf\n\n顔やお腹が写る感じであれば、詳細な背景や表情、ポージングなどはお任せします。\n\n大体こんな感じのイラストを差し支えなければ、お願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ZENraKISHI/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 60811, "client_id": 420175, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/094e0259/uploads/origins/0b648e20-c5d0-4569-aca0-a388997a4503?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcf9e3f97fa83776e116b5f2366c44b4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/094e0259/uploads/origins/0b648e20-c5d0-4569-aca0-a388997a4503?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c5b552336cf21cb6cf1d87071b7fc05", "src_set": ""}, "body": "こんにちは、はじめまして\nファンタシースターオンライン2のマトイを描いてほしいです\n\nhttps://i.imgur.com/nod2NTN.jpeg\n\n毛先にピンクのハイライトを入れてください。\n- ピンクのハイライトを少し光らせてください。\n- ピンクのハイライトを星でキラキラにできますか？\n\nもし問題なければ、https://www.pixiv.net/en/artworks/92812865 のようなポーズ/シチュエーションにしていただけませんか？\n\n無理なお願いでなければ、表情を変えたバリエーションをいくつか作っていただけませんか？\n- 初めてプレイするときや失敗したときのような、顔を赤らめた優しい照れ笑い。\n- 勝ったばかりのような、ちょっとドヤ顔やからかうような表情。\n- 負けた時のような、少し口を尖らせた表情\n\n参考画像\nhttps://drive.google.com/drive/folders/1CaR7Q9x6NTruCbxMzyEmfT9-J6WFY832?usp=sharing\n\n貴重なお時間を割いていただき、ありがとうございました！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ZENraKISHI/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 60811, "client_id": 1764535, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1eee7f05/uploads/origins/30bbf408-f531-422a-b282-1f39bc160fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dae4ca1dfb349e0efe1dab9c962f3b9d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1eee7f05/uploads/origins/30bbf408-f531-422a-b282-1f39bc160fd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca0382244ec334580b972ca99f6faa6e", "src_set": ""}, "body": "はじめまして。普段イラストなどで楽しませて頂いてます。\nウマ娘のスペシャルウィーク・サイレンススズカ・トウカイテイオー・セイウンスカイの４人がゲーム「Fate/grand order」で同じ声優が担当してるキャラのコスプレをしてる絵をお願いします。\nシチュは以前善騎士様が描かれていたプリコネ水着を着てるウマ娘のイラストと同じ感じです。\nキャラの配置や表情などはお任せいたします。\n\n配役は\nセイウンスカイ→宇津見エリセ\nスペシャルウィーク→バーヴァンシー(妖精騎士トリスタン)\nサイレンススズカ→メリュジーヌ(妖精騎士ランスロット)\nトウカイテイオー→謎の蘭丸X\n該当キャラのイラストは下記ＵＲＬに添付します\nhttps://www.tumblr.com/reioh15060/762955879442169856/%E5%AE%87%E6%B4%A5%E8%A6%8B%E3%82%A8%E3%83%AA%E3%82%BB?source=share\n\nご検討いただけますと幸いです。\n何卒宜しくお願い致します。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ZENraKISHI/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 60811, "client_id": 3146551, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3b8adc0a/uploads/origins/597f090b-9a9c-4002-8cc5-dfc50dae2cab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=caa1b7705f7940cb88c903359b23b2ef", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3b8adc0a/uploads/origins/597f090b-9a9c-4002-8cc5-dfc50dae2cab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7bf4334b5446d244e2744dfd8eb23ba3", "src_set": ""}, "body": "コミケの時期でお忙しいとおもいますので、お時間余裕あればぜひお願いします。\n\nお願いしたいキャラはアンジュ・ユナイトに登場する【エルエル】で以下のシチュエーションを希望します。\n・シチュエーションは風呂上りでパジャマパーティー\n・服装はパジャマ\n色はピンクがメイン\n上はボタン式で第一ボタンを外して、少し谷間が見えそうな感じ\n下は長ズボン\n靴下なし\n可愛い女子でいい香りがする感じ\n・風呂上りなので頭は湿っているorタオルで拭いている\n・プレイマットにする予定なので縦380mm×横630mm 解像度350dpi、納品に必要なのでpsdファイルもいただけますと幸いです。\n・場所は部屋\n・床に脱ぎ捨てたニーハイソックス\n・構図は床に座ってすこし崩した感じの座り方でお願いします。\n※ブルアカのイロハが一番近いかもです。\n\n以上でございます。\n引き続きよろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ZENraKISHI/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 60811, "client_id": 257349, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9947c23/uploads/origins/16a284ad-c759-455b-8912-2318a009efbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b0b1f9c8331d9e549551cb3fd0c54ad4", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9947c23/uploads/origins/16a284ad-c759-455b-8912-2318a009efbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a6f554a0b446d7b067a0efce1fe1526", "src_set": ""}, "body": "先日はアピールを頂きありがとうございました！\nFE聖魔の光石のルーテのイラストをリクエストさせて頂きたく思います。\n\nクールな雰囲気をしたマイペース・不思議系の魔導士の少女です。\n\n【リクエスト内容】\n引き裂かれた服が宙を舞う中、魔導書を片手に生まれたままの姿で戦っているルーテのイラストをお願いします。\n\n善騎士様が以前描かれた閃乱カグラの華風の服ビリ絵（https://www.pixiv.net/artworks/90419584）の様な状況がイメージです。\n\nまた、ルーテの全裸は髪留め以外の一切合切の衣装・アクセサリを剥ぎ取られ、辛うじて服の残骸が腕に引っかかっている程度の状態でお願いします。\n\n【体形】\n貧乳・スレンダー・無毛で描いて頂けると嬉しいです。\n\n【ポーズ】\n胸と股関が丸見えなのも気にせず、魔法を発動しながら戦っている感じのポーズで描いて頂けると嬉しいです。\n\n【表情】\n赤面しつつも、表情はあまり崩さず静かに此方を睨みつけている感じのものをお願いします。\nまた、もしリクエスト金額で可能でしたら、恥じらいを見せずに冷静なままの表情差分をお願いします。\n\nご対応可能な際はどうぞ宜しくお願いします！\n\nhttps://imgur.com/a/RSNGpHf", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ZENraKISHI/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 60811, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/063e817d/uploads/origins/10c66642-58f6-4056-a3ac-5cece427d83d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=885000277ab38246503f2796d399fc31", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/063e817d/uploads/origins/10c66642-58f6-4056-a3ac-5cece427d83d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6927681cf30611348b9f8f9aa4ae182f", "src_set": ""}, "body": "とてもイラストがお上手で絵柄が好みで依頼させて頂きます。細かな部分お任せしますのでご検討をお願い致します。\n・人物\nイシュタル(Ishtar)：雷神と呼ばれるほど強いが、密かに子供達を助ける優しい性格。巨乳。\nhttps://w.atwiki.jp/aniwotawiki/pages/39541.html\nラインハルト(Reinhardt)：忠実で優秀な部下だが、主君イシュタルを死の運命から変えるため泥酔した際に暴走。\nhttps://w.atwiki.jp/aniwotawiki/pages/19968.html\n・シチュエーション\n原作とは異なる世界の設定で、主君イシュタルの死の運命を変えるために、泥酔したラインハルトが妊娠させようと襲ってしまう。\nイシュタルは驚き抵抗するが泥酔して力が出ず、巨根に感じてしまい顔が赤い。抵抗の表情、観念した表情＋受精描写の差分があると幸いです\n男性の描写は部分的、省略して大丈夫です。\n・構図ご参考\nhttps://skeb.jp/@he_be_/works/100", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ZENraKISHI/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 60811, "client_id": 255335, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/33f19259/uploads/origins/2bc371ce-ed02-4658-bc61-09cf38ce5846?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f364534fa4ba38cbb97f7b5a43ca4f3b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/33f19259/uploads/origins/2bc371ce-ed02-4658-bc61-09cf38ce5846?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67fe81c42805150ca6129f205b79599e", "src_set": ""}, "body": "ファイアーエムブレム ヒーローズのスカビオサを描いてください。\nhttps://i.imgur.com/Hb1w5Y9.png\nこれをもとに情景を描いてください。夕暮れの城下町です。\nhttps://feheroes.fandom.com/wiki/Special_Orb_Packs_Available!_(Jan_2024)_(Notice)?file=Bg_DetailedStatus_AskCastleTown_Reliance.webp\n例としては、\"食べ物の入ったバスケットを持ったスカビオサ \"や \"リンゴを差し出すスカビオサ \"などがある。夜のデートの後という印象を与える。彼女は立っていても、浮いていても、小道具の上に座っていてもいい。ポーズやディテールは自由に選んでください。\n\nスカビオサはクールですが、キュートでもあります。羽や髪のツル、メイクを描きましょう。肌はとても青白く、耳は尖っていますが、耳は普段は見えません。翼にはハートの形があり、ひび割れているので、必ず入れてください。彼女のスタイルは暗くてよそよそしいが、イメージの中では喜んでいるように見えるはずだ。ありがとう。\n\nhttps://fireemblem.fandom.com/wiki/Triandra/Gallery", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ZENraKISHI/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 60811, "client_id": 1350963, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6d628061/uploads/origins/cc61a648-df26-4b50-8817-646c5fb8d792?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23c843e9955080897c390c131cd85837", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6d628061/uploads/origins/cc61a648-df26-4b50-8817-646c5fb8d792?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64c8b0b0b72515a23f801264f3804bbf", "src_set": ""}, "body": "前回のイラストが大変すばらしかったので、またご依頼させていただきたくご連絡いたしました。\nコミケの時期でお忙しいとおもいますので、お時間余裕あればぜひお願いします。\n\nお願いしたいキャラは【サトノクラウン】で以下のシチュエーションを希望します。\n・シチュエーションはウイニングライブで踊っているシーン\n・服装は勝負服\n・ポーズは胸元で手でハートを作っていて、表情は笑顔だけれど少しはにかんでいる、視線は観客席最前列にいるトレーナと合っている状態。\n　構図はサポカのスマートファルコン・パワー・SSRのように観客席から見ている感じでお願いします。\n・PCの壁紙にしたいので可能でしたら1920×1080だと嬉しいです。\n　また、スマートファルコンパワーSSRは観客席から見て、舞台左側からセンターを見上げている状態だと思うのですが、今回は逆に右側からセンターにいるクラウンを見上げているような状態が嬉しいです。\n　（壁紙で使用するディスプレイが左にあるのでちょうどいい感じになります・・・）\n\n細かい希望が多く、恐縮ですがぜひご検討いただけますと幸いです。\n以上、よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ZENraKISHI/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 60811, "client_id": 557012, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c45e22c0/uploads/origins/5ca42f9f-6669-4758-a386-1de4c2d761ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae5d5960235e7e0e2cff9b7a532883c5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c45e22c0/uploads/origins/5ca42f9f-6669-4758-a386-1de4c2d761ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71b4bb78073152d5d1baa40fdf9943a7", "src_set": ""}, "body": "初めまして。善騎士さんの描かれるセイウンスカイが好きでリクエストさせていただきました。\n少し困り顔で赤くなっている時のセイちゃん絵が特に好きなので、夏をテーマにそういう表情のシチュエーションを1つ描いていただけないでしょうか。\n漠然としたリクエスト内容で申し訳ないのですが、ご検討の程よろしくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ZENraKISHI/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 60811, "client_id": 1350963, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62b7fc9c/uploads/origins/690c2ebf-7cfa-4bc2-ba75-60edd94dd91b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f28e094fa767caf0c38865efabe3fea8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62b7fc9c/uploads/origins/690c2ebf-7cfa-4bc2-ba75-60edd94dd91b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc014f69bac0698347706a21108ef6c6", "sr