unt": 8000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@biwa27/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3716861, "client_id": 1431040, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7443c4ea/uploads/origins/228faa55-ffd4-4eda-9c15-3ebb8dc97825?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdd4b953909a4593b9d7e5b48933117c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7443c4ea/uploads/origins/228faa55-ffd4-4eda-9c15-3ebb8dc97825?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4c444b29815f601d3cab17227a7b5f5", "src_set": ""}, "body": "こんにちは。劇場版忍たま乱太郎ドクタケ忍者隊最強の軍師の劇中に登場した『ドクタケ忍者隊巻ノ一』内の鬼娘ユキちゃんとトモミちゃん(指は５本で)をお願いしたいのですが宜しいでしょうか?\nhttps://drive.google.com/drive/folders/1O9o5Ez3WjleDhATwvvncX0RHXua4KDAk\n\nhttps://drive.google.com/drive/folders/1MW1EocZNqnu1RN6LQI1-JbEMrB66uC8Q", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@biwa27/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3716861, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/59f41d0d/uploads/origins/f5476f52-8cb2-43d3-9717-b2958a88d0d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=925ad5adcf038ebad30b6308a7504a77", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/59f41d0d/uploads/origins/f5476f52-8cb2-43d3-9717-b2958a88d0d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5eecc58f4fa20bf920759168f11eac2c", "src_set": ""}, "body": "びわこさん初めまして！\nリクエストなのですがキュアミラクルの衣装をした元高木さんをお願いします(中の人繋がり)、ポーズなどはおまかせします。\n\nご検討のほど宜しくお願いします", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@biwa27/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3716861, "client_id": 3736684, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eae8496b/uploads/origins/0180469f-60ab-4281-98bc-abe2131a0a19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2dd0b4711d4947d5da17a3405f5abbda", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eae8496b/uploads/origins/0180469f-60ab-4281-98bc-abe2131a0a19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=272f87e110426a5dcf96f7d3e63734b3", "src_set": ""}, "body": "初めまして、プリキュアみたいな大きいハイライトの可愛いイラストに惹かれました!\n現在IRIAMで活動中のH.N陰キャ姫ちゃん(Twitter@HN_inkyahime)をお願いしたいです!\n陰キャ姫ちゃんはプリキュアがだいすきなので、ぜひびわこ様の絵柄で、プリキュアみたいに変身させてほしいです…!\n陰キャ姫ちゃんであるとわかるように、髪型はそのままで、衣装のみプリキュアのようなドレスに改変していただきたいです。\n(現存するプリキュアのコスプレではなく、新しく衣装を創作していただきたいです。)\n衣装のデザインまでお任せしてしまって難しいリクエストだと思いますので、厳しければキャンセルしてください…!\n【使用用途】\nH.N陰キャ姫ちゃん本人によるSNSアイコン、SNSにあげるおはVや予定表での使用、サムネイルの使用の可能性があります。\nぜひよろしくお願いします…!\n\nhttps://x.com/HN_inkyahime/status/1911910354898309464?t=a28VZRBNtGEdahTeb8ZEJA&s=19", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@biwa27/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3716861, "client_id": 1807877, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28654554/uploads/origins/7b28934e-d8f7-4142-8809-ee8b650207d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dac220d789ac94c3ce9f051f757c2591", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28654554/uploads/origins/7b28934e-d8f7-4142-8809-ee8b650207d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6789b2afde20a06e630f0ec86c389816", "src_set": ""}, "body": "こんにちは！ 先日のイラストありがとうございました。今回もうちの子のイラストリクエストをお願い致します…！\n『メーテライト・ルミエーラ』という変身ヒロインの女の子です。詳細は資料URLをご参照ください。\n「人懐っこい・優しい・可愛らしい・清楚」モチーフの、少女から少し大人びた雰囲気の女の子です。\nデザインの要素に以下のものがあります。\n・瞳の中には小さな黄色い星のハイライトがある。\n・頭部の髪飾りやティアラ、白いもふもふの装飾はそれぞれ独立してついている。\n・後髪は首元で内側にまとまってから、背中辺りから分け目が外側にふわっと広がる。後髪半ばのシルエットが天使の羽根のようにも見える意図。\n・胴のドレスと二の腕のフリルとはそれぞれ独立した装飾。脇下は繋がっていません。\n\n今回は資料デザインの変身姿で描いていただきたいです！\nちょっと頬が赤い照れや恥じらう表情のイラストが可愛らしくて、その雰囲気で構図やポーズ等すべておまかせ致します！\nキャライメージは可愛らしさに加えて、優しくも凛としたお姉さんみのある魔法少女です。\n上記希望はあくまで提案くらいのゆるい指定で、構図やポーズ・資料から読み取れる細かなキャラ解釈はすべておまかせ致します。\n\n使用用途はTwitter(X)やMastodon、Misskey含む外部SNSでのアイコン、ヘッダー使用・イラスト紹介・紹介ツイートをtogetter(min.t)などの自身のまとめへ追加。\nリクエストする際に上記まとめのURLを引用する場合があります。\n\nPSD形式希望で、恐縮ですが宛名とキャラと背景のレイヤー分けをお願いします。分離不可の場合は統合状態を問いません。\nどうぞよろしくお願いします！\n\nまとめ一覧\nhttps://min.togetter.com/FfDRT8U\n\n資料URL\nhttps://drive.google.com/drive/folders/1ihjKCXY4RJREGyeVWG7U-1Gj8qlnE2Bm\n\nhttps://drive.google.com/drive/folders/1ihjKCXY4RJREGyeVWG7U-1Gj8qlnE2Bm", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@biwa27/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3716861, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/edcf6b46/uploads/origins/424204d3-950e-4c87-b450-88bfd9cb21e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=31913c7e7fa9101b2cc5cf68a9bd771c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/edcf6b46/uploads/origins/424204d3-950e-4c87-b450-88bfd9cb21e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad91b47c1c437d1a7dd4f5f8b745849f", "src_set": ""}, "body": "キミプリから\n恋人同士のカイトさん、うたちゃんで\n\nうたちゃんが積極的にカイトさんにキスして大いにガチ照れするレジェンドと、好き好きオーラ全開かつちょっと小悪魔ぽいうたちゃんが見たいです…‼︎\n\nそんなラブラブかつ、ちゅーしまくりの二人をどうかお願い致します…🙇‍♀️\n(このうたちゃん多分本編軸より2歳くらい年齢上がってる)\n\nびわこ先生の描くガチ照れカイト氏を是非拝みたいです…‼︎", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@biwa27/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3716861, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc29b3b5/uploads/origins/a95b0710-fc0f-4a78-978f-5df724208ae4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=232a862ec79a689938b992aa15df6e19", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc29b3b5/uploads/origins/a95b0710-fc0f-4a78-978f-5df724208ae4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b9bbe07ae02f7ab0e845a4a27f37d95", "src_set": ""}, "body": "お疲れ様です…!!\n\n最近水着イラストをよく上げているのを拝見して、リクエストしようか迷っていたのですが…やっぱり出来ることなら見たいな……と思いまして……\n\nキミプリから、夏らしいカイトさんとうたちゃんが見たいです！！\n\n場所は海で二人とも水着姿でお願いしたいです(カイトさんの上裸が難しければパーカーとか何か羽織っていてもOKです🙆‍♀️)\n\nシチュエーションと致しましては…\n一つのトロピカルジュースをハートストロー(所謂、２本のストローが絡まっている形のアレです)で向かい合わせになって照れながら飲んでる所が見たく…！！\n\nカイトさんは、照れながらもうたちゃんの方見て愛おしそうに微笑んでいたらいいなぁ。\nうたちゃんに関しては、イメージ出来ると思うので…w\n\n\n宜しければご検討の方、よろしくお願いします🙇‍♀️", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@biwa27/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3716861, "client_id": 1807877, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a7a4fe98/uploads/origins/1c244aec-dff7-46ac-90f5-9c9a42fd4500?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3c01b5834c3ac08d3abf2f6b68fe76f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a7a4fe98/uploads/origins/1c244aec-dff7-46ac-90f5-9c9a42fd4500?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ada25cf8c897c5fdd1545a561e4d5d2", "src_set": ""}, "body": "こんにちは！ 一目で惹かれる可愛らしいイラストの子たちが大変素敵で、今回うちの子のイラストリクエストをお願い致します…！\n『メーテライト・ルミエーラ』という変身ヒロインの女の子です。詳細は資料URLをご参照ください。\n「人懐っこい・優しい・可愛らしい・清楚」モチーフの、少女から少し大人びた雰囲気の女の子です。\nデザインの要素に以下のものがあります。\n・瞳の中には小さな黄色い星のハイライトがある。\n・頭部の髪飾りやティアラ、白いもふもふの装飾はそれぞれ独立してついている。\n・後髪は首元で内側にまとまってから、背中辺りから分け目が外側にふわっと広がる。後髪半ばのシルエットが天使の羽根のようにも見える意図。\n・胴のドレスと二の腕のフリルとはそれぞれ独立した装飾。脇下は繋がっていません。\n\nこの子が変身した姿をイメージした一枚イラストを描いていただきたいです！\n少し目を細めて微笑む、優し気なお姉さんに憧れてしまいそうな質感を希望したいのですが、全面的におまかせもしたいので自由にしていただけますと幸いです！\nキャライメージは可愛らしさに加えて、優しくも凛とした(ちょっとネコ目気味かも)お姉さんみのある魔法少女です。\n上記希望はあくまで提案くらいのゆるい指定で、構図やポーズ・資料から読み取れる細かなキャラ解釈はすべておまかせ致します。\n\n使用用途はTwitter(X)やMastodon、Misskey含む外部SNSでのアイコン、ヘッダー使用・イラスト紹介・紹介ツイートをtogetter(min.t)などの自身のまとめへ追加。\nリクエストする際に上記まとめのURLを引用する場合があります。\n\nPSD形式希望で、恐縮ですが宛名とキャラと背景のレイヤー分けをお願いします。分離不可の場合は統合状態を問いません。\nラフや下書きなどの途中経過を見せても良い場合は、レイヤー下に残していただけますととても嬉しいです。\nどうぞよろしくお願いします！\n\nまとめ一覧\nhttps://min.togetter.com/FfDRT8U\n\n資料URL\nhttps://drive.google.com/drive/folders/1ihjKCXY4RJREGyeVWG7U-1Gj8qlnE2Bm\n\nhttps://drive.google.com/drive/folders/1ihjKCXY4RJREGyeVWG7U-1Gj8qlnE2Bm", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@biwa27/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fc7208b9/uploads/origins/1f4053a2-2e52-44be-ae47-44488618b0f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4159cf2a9321bfb60f42e69a377962d4", "src_set": ""}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3716861, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_ac