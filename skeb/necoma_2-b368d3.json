ニング、ベイキング、読書、執筆\n\n【関係性】\n双子のような間柄で、妹に手を焼くお兄ちゃん × 天才的で自由奔放な妹、といった感じです。\n\nこの二人の日常的な様子が見たいです。その他の部分（シーンや衣装など）は自由にアレンジして追加していただいて構いません。二人のやりとりが伝わればそれで大丈夫です。\n可能であれば、psdファイル内の別のレイヤーにサインをお願いします\n依頼内容に何か難しい点か問題点があれば、お気になさらずこの依頼をキャンセルしてくださいご検討のほど、何卒よろしくお願いします！\n\n【形象参考】\nhttps://weibo.com/4035135622/5322452697355142", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@necoma_2/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3152048, "client_id": 3958193, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a82388fa/uploads/origins/216107d8-1709-4ffe-84bd-045b1a7ab47e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad3c2618df369de180fa02013544a229", "srcset": "https://si.imgix.net/a82388fa/uploads/origins/216107d8-1709-4ffe-84bd-045b1a7ab47e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad3c2618df369de180fa02013544a229, https://si.imgix.net/a82388fa/uploads/origins/216107d8-1709-4ffe-84bd-045b1a7ab47e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=041df5bdb72858307a0cdd4631d624a7 2x, https://si.imgix.net/a82388fa/uploads/origins/216107d8-1709-4ffe-84bd-045b1a7ab47e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ba28499115efbfa82a08319ed09c4bf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a82388fa/uploads/origins/216107d8-1709-4ffe-84bd-045b1a7ab47e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=adcd7403d01ba00df5c4db335ee1f470", "srcset": "https://si.imgix.net/a82388fa/uploads/origins/216107d8-1709-4ffe-84bd-045b1a7ab47e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=adcd7403d01ba00df5c4db335ee1f470, https://si.imgix.net/a82388fa/uploads/origins/216107d8-1709-4ffe-84bd-045b1a7ab47e?bg