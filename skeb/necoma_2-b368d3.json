f-fa3b4980b3ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44548b7215b622c12faf288b9367878c, https://si.imgix.net/ba020975/uploads/origins/495ea22c-dac1-4054-92ef-fa3b4980b3ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c62f6edbed58fa11348d11a39a84ca9c 2x, https://si.imgix.net/ba020975/uploads/origins/495ea22c-dac1-4054-92ef-fa3b4980b3ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=98af4741081acd389b439575a368649f 3x"}, "body": "はじめまして、necoma先生。\n先生の作風や作品が大好きで、私のキャラクターの2人きりのイラストを描いていただけないでしょうか！\n\n以下が私のオリジナルキャラクターの紹介です。お任せしていただいた情報をもとに、自由に描いていただければ幸いです。\n【ファルビティス／シェフ】紫色のアップヘアで、色白の少女。料理を一つひとつに笑顔を浮かべて紹介し、客が食べ終わるとすぐに感想を求めます。不満な答えを聞くと、とても怒ります。\n\n【アイリス／店主】紫色のショートヘアの少女。仕事中は常に淡い笑みを浮かべており、喜怒哀楽が読み取れない。シェフが怒っている時は優しく諭すが、その言葉の内容からすると、客思いの良き店主とは言い難い。\n\n【ストーリー背景】小さな町に突如として現れた茶館は、まるで双子のような二人が経営しているようだ。訪れた客は皆、味が良いと口を揃える。特に看板メニューのチャーシュー包は、食通たちでさえ「不思議な風味がある」と評しており、その美味しさの秘密は原材料にあるらしい。\n噂によると、茶館の厨房は立ち入り禁止で、食材が漏れてしまうからだという。シェフはまるで生身の人間には見えない。彼女を店主が作った紙人形だと言う者もおり、店主も実は表面上ほど温厚ではないらしい。\n（URLに彼女たちの参考画像があります）\n\n金額が足りない場合は追加で送ります！翻訳に不正確な点があるかもしれませんが、ご一読いただき誠にありがとうございます。皆様の生活が充実したものになりますようお祈り申し上げます！\n\nhttps://drive.google.com/drive/folders/1vvokEYQ99wNmTrK9Z9rj8dvK2Khr3T8D", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@necoma_2/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3152048, "client_id": 3704824, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0768387e/uploads/origins/0eb4ea65-c66e-480a-9f0f-201ddd7a5a05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5917e907ae2ab376cb77edaeb36c55fa", "srcset": "https://si.imgix.net/0768387e/uploads/origins/0eb4ea65-c66e-480a-9f0f-201ddd7a5a05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5917e907ae2ab376cb77edaeb36c55fa, https