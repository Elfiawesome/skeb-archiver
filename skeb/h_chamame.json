2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=03e6e29c8df87bec43fbe6e6fd8b3087 2x, https://si.imgix.net/58cfc5fa/uploads/origins/ab1c51a6-8cc7-4d60-9c16-c5012b59a462?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=acabce4b08974f1b6a6dbf916c2be70d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/58cfc5fa/uploads/origins/ab1c51a6-8cc7-4d60-9c16-c5012b59a462?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5dee68516e489dd024b9622c738ff96", "srcset": "https://si.imgix.net/58cfc5fa/uploads/origins/ab1c51a6-8cc7-4d60-9c16-c5012b59a462?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5dee68516e489dd024b9622c738ff96, https://si.imgix.net/58cfc5fa/uploads/origins/ab1c51a6-8cc7-4d60-9c16-c5012b59a462?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fa7c378a53926f3a025da700c8b99c9a 2x, https://si.imgix.net/58cfc5fa/uploads/origins/ab1c51a6-8cc7-4d60-9c16-c5012b59a462?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=184850f054f9fd5294be28f38bb072f4 3x"}, "body": "私のocの以前の絵が本当に好きです！彼女の全身刺青の似顔絵に感動しました！そして最高の彫刻！あなたのデザインもとても良いので、あなたの描いた美少女のタトゥーがもっと見られることを期待しています！\nまず、彼女はまだ \"胸カットり九分袖 \"であり、そしてまた、日本の入れ墨の背中とお尻全体をカバーする必要があります。可能であれば、アソコとケツの穴にも入れ墨を描いていただけませんか？\n写真では、元のタトゥーのデザインを維持することができ、背中、お尻の入れ墨と入れ墨の他の部分は1つであり、彫りの追加部分は首尾一貫しています。(要するに、伝統的な日本のボディタトゥーのデザインに基づいて、一般的にすべてインクで覆われています（笑）。\n背中やお尻のタトゥーのデザインは自由です！\nピアスの部分はできれば舌のスタッズをつけたい。\n\nあなたのスケブ依存デッサン5と同じようなポーズをしてほしい。\nポーズ。彼女は頭を後ろに向けて、後方入場の準備をしているポーズをとる。\nそして、彼女の隣にセーラー服とハイヒールが投げられていて、それらはベッドの上に散らかっています。ハイヒールについては写真を参照してください。\n差分1：スケブ依存デッサン5で描いた表情と似ていますが、もう少しエロティックで挑発的です（彼女の愛の瞳は最高です、そのままでお願いします）、絵1の表情を参考にしてください。\n差分2：男の巨大なハングにアソコを貫かれ、上目遣いで犯される彼女の表情が素晴らしい。\n差分3: 差分2と比較して、いくつかのダイナミクスを加える。\n差分4：彼女の背中と尻は白い液体に覆われ、マンコからは白い液体が流れ続けている。彼女は気が狂いそうなほど犯されている表情を見せる。舌も出ている。\n差分5～8：差分1～4と比べると、アナルプラグが追加さ