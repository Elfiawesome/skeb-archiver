eator_acceptable_same_genre": false}, {"path": "/@h_o_r_i_e_r_o_s/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2242563, "client_id": 2059157, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/16ebe8f4/uploads/origins/779da802-9272-4f70-8b69-240b44c53f1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a27767fb238205761242d60f2df8de3", "srcset": "https://si.imgix.net/16ebe8f4/uploads/origins/779da802-9272-4f70-8b69-240b44c53f1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a27767fb238205761242d60f2df8de3, https://si.imgix.net/16ebe8f4/uploads/origins/779da802-9272-4f70-8b69-240b44c53f1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14666940c0dd3c54adf55d55d6d410f8 2x, https://si.imgix.net/16ebe8f4/uploads/origins/779da802-9272-4f70-8b69-240b44c53f1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3082e5c3a282abf0601c28e318914f1 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/16ebe8f4/uploads/origins/779da802-9272-4f70-8b69-240b44c53f1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04f1778e01c745468fcfa7038f04c1b5", "srcset": "https://si.imgix.net/16ebe8f4/uploads/origins/779da802-9272-4f70-8b69-240b44c53f1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=04f1778e01c745468fcfa7038f04c1b5, https://si.imgix.net/16ebe8f4/uploads/origins/779da802-9272-4f70-8b69-240b44c53f1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=959ddf0ce1a35d8d1922f7377d4947ec 2x, https://si.imgix.net/16ebe8f4/uploads/origins/779da802-9272-4f70-8b69-240b44c53f1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=532c441640d1c027ea1c5c1e4135cd13 3x"}, "body": "初めまして！\nいつも素敵なイラストをありがとうございます。ほりえろす先生にリクエストできる機会を頂けるなんてまるで夢のようです。\n\nリクエストですが、こちらの小説の挿絵を一枚お願い致します。詳細は後述します。\nhttps://www.pixiv.net/novel/show.php?id=18049234\n\nまず小説の概要ですが以下の通りです。\n\nヤリチンの不良くんがオタクを虐めていたが、逆襲され催眠術で自意識を女の子に変えられた挙句、恋心を植え付けられる。\n↓\n豊胸その他もう色々と取り戻せない肉体改造を受けた状態で結婚式を挙げ、催眠解除。自意識を取り戻した不良くん絶望。\n↓\n最後は「イった瞬間に永遠にオタクのことを愛するようになる」という暗示をかけられ泣きながら射精し、ラブラブお嫁さん化。\n↓\nハッピーエンド♥\n\n以上です。\n挿絵をお願いしたいのは最後の「催眠解除！絶望のメス堕ち結婚式！！」のシーンです。\nここは不良くんの男としての最後の虚しい抵抗が見られる、最高のシーンなんですよ。\n以下本文からメス化させられた不良くんの見た目、該当シーンのセリフを抜粋致します。\n\n・メス堕ちした不良くんの見た目\n>ウェディングドレスの要素は頭に被ったベールのみ。下はほとんど全裸で、両腕につけたレースの白い長手袋を除きほぼ完全にきめ細やかな素肌を晒していた。\n>豊胸手術と開発を同時に進めた結果、並の女性などでは比較にならない程の雄を誘惑する歩くたびにたゆんと弾む乳房や、過剰な投薬でだらしなく雌化し柔らかく丸みを帯びた元は筋肉質だった淫らな肢体。\n>チクニ―のしすぎでそよ風で腰が抜ける程の本気アクメをキメるクソ雑魚感度になってしまった乳首を、花嫁というコンセプトに基づいた白い二プレスで覆っている。\n>女ホルや雌化暗示で徹底的に叩きのめされ生殖機能を失ってしまった短小包茎の子供ちんぽをフラット貞操帯で奥の奥に押し込められ、小さな穴からたらたらとカウパーを垂れ流し、絨毯に黒いシミを作っていた。\n※補足：不良くんは北欧ハーフの美少年で金髪碧眼です。\n\n・該当シーンのセリフ\n竿役のオタクに正常位のお嫁さん挿入をされて（竿役のオタクは巨大おちんぽのみの描写でOKです。あくまでも不良くんを中心とした痴態を堪能したいので。）\n>「やだぁ♡そんなのやだぁ…私、じゃないわた、私、女の子じゃないもん…っ♡男の子だもん…っ♡ 豚夫なんかのお嫁さんになんて絶対ならないんだからぁ…っ♡──ん゛お゛っほぉぉっっ♡」\n\nリクエストの詳細は以上となります。 skebでリクエストをするのは初めてなもので文章にまとまりがなく申し訳ございません。\n完成を楽しみにしておりますので、何卒よろしくお願い申し上げます。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@h_o_r_i_e_r_o_s/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2242563, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d953bff/uploads/origins/19b7b955-ba9b-42fd-8c6f-f3fcf671aab2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30d81e63daa8554d3bd2c70858bc19b9", "srcset": "https://si.imgix.net/0d953bff/uploads/origins/19b7b955-ba9b-42fd-8c6f-f3fcf671aab2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30d81e63daa8554d3bd2c70858bc19b9, https://si.imgix.net/0d953bff/uploads/origins/19b7b955-ba9b-42fd-8c6f-f3fcf671aab2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200