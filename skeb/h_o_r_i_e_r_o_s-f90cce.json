Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26e28e7f3f13e6288d86d630c39a7ac2", "srcset": "https://si.imgix.net/2568656c/uploads/origins/a1973732-b1ed-4ca2-9773-cac2319ccb67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26e28e7f3f13e6288d86d630c39a7ac2, https://si.imgix.net/2568656c/uploads/origins/a1973732-b1ed-4ca2-9773-cac2319ccb67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb38eeea3cfb2c9e9d0008812545c6b9 2x, https://si.imgix.net/2568656c/uploads/origins/a1973732-b1ed-4ca2-9773-cac2319ccb67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f68557e16cf6be33c6497cd5a0a1ea3 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2568656c/uploads/origins/a1973732-b1ed-4ca2-9773-cac2319ccb67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da33a97f7bdfdea68f45af04cc35f980", "srcset": "https://si.imgix.net/2568656c/uploads/origins/a1973732-b1ed-4ca2-9773-cac2319ccb67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da33a97f7bdfdea68f45af04cc35f980, https://si.imgix.net/2568656c/uploads/origins/a1973732-b1ed-4ca2-9773-cac2319ccb67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=da9f3529a95670ce9cd8a8f998765bd3 2x, https://si.imgix.net/2568656c/uploads/origins/a1973732-b1ed-4ca2-9773-cac2319ccb67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0b86caf15e84bf28b0172ecb077e755e 3x"}, "body": "モノクロ漫画をお願いします。\n\n内容\n普通の男性サラリーマンが死後、生前にエロゲやエロ漫画や妄想の中で2次元の女の子を陵辱してきた罪で地獄に落ち、黒髪ロング美少女にTSさせられ、2次元の女の子にしてきたことを罰として何百年もされ続ける話をお願いします。\n\n入ってほしい場面\n①目が覚めると全裸の美少女にTSしている。地獄の鬼の刑吏(美少女)に罪状と刑罰について説明されるシーン。\n②反抗的な態度を取るも、子宮の位置に刻まれてる淫紋によって、普通の人間が味わったら死亡する快楽を子宮と女性器に直接叩き込まれてわからされる。１時間の間、休むことなく絶頂し続けて潮を吹き続ける。途中で絶頂で気絶するが絶頂で叩き起こされる。地獄では決して死ぬことはないし発狂することもできない。トラウマを刻み込まれて命令に逆らえなくなる。\n③これからの刑のために肉体改造される。首から下を箱に入れられ、感覚遮断されて首から下の感覚がなくなる。以下の状態になってる体を鏡で見せられる。\n\n手足は磔のように大の字で固定されてる。\nクリトリスは親指ほどのサイズに肥大化させた後、感度を数千倍にする薬を練り込みながら吸引タイプの触手ブラシで磨き続ける。首から上には伝わらないが、体は毎秒絶頂して潮を吹き続ける。体が条件反射で腰を高速でヘコヘコさせて必死に逃れようとする。\n女性器とお尻の穴に、神経を鋭敏化する薬を練り込みながらいぼいぼの極太触手で高速ピストンを行い子宮口、膣壁、腸壁をいじめまくる。\nおっぱいはMカップほどの爆乳に改造された上で搾乳機をつけられて、射精の数百倍強力な噴乳アクメを毎秒させ続ける。\n\n箱の参考画像\nhttps://www.pixiv.net/artworks/94479540\nhttps://www.dlsite.com/maniax/work/=/product_id/RJ01186127.html/?utm_campaign=chobit&utm_medium=inhouse&utm_content=RJ01186127\n\n④感覚遮断を解除されて毎秒絶頂し続ける。\n\nページ数に余裕があれば、ふたなり鬼っ娘に輪姦されるところをお願いします。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@h_o_r_i_e_r_o_s/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f5cb771d/uploads/origins/6d40f959-03eb-4d99-aeeb-a4ef9a4c72d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=72639552e07459a0988f31caa506400d", "srcset": "https://si.imgix.net/f5cb771d/uploads/origins/6d40f959-03eb-4d99-aeeb-a4ef9a4c72d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=72639552e07459a0988f31caa506400d, https://si.imgix.net/f5cb771d/uploads/origins/6d40f959-03eb-4d99-aeeb-a4ef9a4c72d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed4cec9c64196c01bc4d5eb628712025 2x, https://si.imgix.net/f5cb771d/uploads/origins/6d40f959-03eb-4d99-aeeb-a4ef9a4c72d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4aa29caf726fa0e1c3e5fceb8c1bfcea 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 2242563, "client_id": 2593765, "nc":