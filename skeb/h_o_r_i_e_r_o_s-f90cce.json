4236-abe6-0769638770a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc8b22ccf54806ec31862d41124433d5 3x"}, "body": "フルダイブ系のオンラインゲームで、モンスターに敗北し肉体改造された短髪活発系ショタが、実は現実世界にも身体の変化が反映されていた、というイラストをお願いします。\n普段は活発でクラスでもリーダー的なポジションにいる少年ですが、クラスメイトと五感全てが再現されるフルダイブ型のオンラインゲームを遊んでいたところ、1人だけモンスターに敗北し、チンポ短小化や胸の肥大化など滅茶苦茶に肉体改造をされる。その後、ログアウトすると、ゲーム上の身体の変化が現実世界に反映されており、学校では1日にしてクラスカーストの最下層となり、クラスメイト達に全裸を見られおっぱいや小さな情けないちんちんをからかわれます。\nもしよろしければ、お願いいたします。", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@h_o_r_i_e_r_o_s/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2242563, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/52f85ed2/uploads/origins/6efbd61f-49f5-4951-aaae-a42653af7879?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d19f373a148f4f4bce161c15168c785b", "srcset": "https://si.imgix.net/52f85ed2/uploads/origins/6efbd61f-49f5-4951-aaae-a42653af7879?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d19f373a148f4f4bce161c15168c785b, https://si.imgix.net/52f85ed2/uploads/origins/6efbd61f-49f5-4951-aaae-a42653af7879?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed1fb9a145d73ae75b9357df2a746523 2x, https://si.imgix.net/52f85ed2/uploads/origins/6efbd61f-49f5-4951-aaae-a42653af7879?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7529436d9051d343bd9145a22daa9b26 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/52f85ed2/uploads/origins/6efbd61f-49f5-4951-aaae-a42653af7879?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2cda204a98a8bd10d40a2baff085ae7", "srcset": "https://si.imgix.net/52f85ed2/uploads/origins/6efbd61f-49f5-4951-aaae-a42653af7879?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2cda204a98a8bd10d40a2baff085ae7, https://si.imgix.net/52f85ed2/uploads/origins/6efbd61f-49f5-4951-aaae-a42653af7879?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c7353d58ceb3ec2772a4f6278597bb98 2x, https://si.imgix.net/52f85ed2/uploads/origins/6efbd61f-49f5-4951-aaae-a42653af7879?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d48331dfdd234160e22dfbef0019e661 3x"}, "body": "レベル100のツンツンクール系少年凄腕冒険者が、オークのチンポへの興味を押さえられずに、あえて扇状的なドスケベ装備を着けた上でわざとオークに敗北するイラストをお願いします。\n少年冒険者は、普段は自身よりも幼いショタ勇者とパーティを組んでおり、彼に頼りにされています。一方で、以前から自身の可愛らしいメスチンポとは異なる、オークの逞しく力強い巨根に興味があり、低レベルのオーク相手ならいざという時にもすぐ逃げ出せると考えて、1人の時にわざと雑魚オークに敗北します。オークの巨根でアナルをオークチンポ専用サイズにまで拡張され、メスホルモンの影響で胸には膨らみがつき、ただでさえ大きくなかったチンポは小指サイズで情けなく薄いザーメンをチョロチョロと垂れ流すだけの可愛らしいものとなり、お腹はオークの濃厚ザーメンでボテ腹、オークチンポに逆らえなくなる淫紋をはじめとした不可逆的なデバフを多数付与されても、その気になればすぐ逃げられるからと言い訳してオークの巨根でアナルを耕されています。\nもし、よろしければお願いいたします。", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@h_o_r_i_e_r_o_s/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2242563, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a960a74/uploads/origins/ed424b64-e237-441b-94e5-87fd4faf1cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28220865b7e7c36e024d9a877643831d", "srcset": "https://si.imgix.net/8a960a74/uploads/origins/ed424b64-e237-441b-94e5-87fd4faf1cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28220865b7e7c36e024d9a877643831d, https://si.imgix.net/8a960a74/uploads/origins/ed424b64-e237-441b-94e5-87fd4faf1cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b2f9937f1683b66a6deb00a526e1901 2x, https://si.imgix.net/8a960a74/uploads/origins/ed424b64-e237-441b-94e5-87fd4faf1cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d65385b1720c696d8be3a80129320935 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8a960a74/uploads/origins/ed424b64-e237-441b-94e5-87fd4faf1cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c62213555c77066c5b79204b83fbdc4e", "srcset": "https://si.imgix.net/8a960a74/uploads/origins/ed424b64-e237-441b-94e5-87fd4faf1cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c62213555c77066c5b79204b83fbdc4e, https://si.imgix.net/8a960a74/uploads/origins/ed424b64-e237-441b-94e5-87fd4faf1cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f102d777964dbfa2789b2be7da444722 2x, https://si.imgix.net/8a960a74/uploads/origins/ed424b64-e237-441b-94e5-87fd4faf1cc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3c6b92380658d91c83e2518a90f737e2 3x"}, "body": "はじめてリクエストします。\nほりえろすさんの単行本『恋する乙女の堕とし方 』に収録されている『生徒会、赤ちゃんになるってよ』の前日譚を描いてほしいです。こうだったらいいなという妄想です。\n3ページ前後のモノクロ漫画の形式でお願いします。\n\n《登場キャラ》\n・花園美咲さん\n・香坂カリンさん\n2人は制服です。\n\n《内容》\nカリンさんが美咲さんに捕まって、赤ちゃん化調教が始まる直前のやり取りです。\n\n①カリンさんを抱き寄せて妖しく舌なめずりする美咲さん。青ざめるカリンさん。\n\n②「最初はおしゃぶりの練習」と言い、嫌がるカリンさんにディープキスをする美咲さん。抵抗するも拘束で逃げられないカリンさん。\n\n③唇で吸いつくブチュキスから始まり、舌を吸う・口内を舐め回す・下唇をしゃぶる…といった様々なキスで責め立てる美咲さん。徐々に力が抜けていくカリンさん。\n\n④トドメにカリンさんの口元全体をバキュームキスで吸い上げる美咲さん。白目をむいて絶頂するカリンさん。本編のカリンさんのバキュームはここで刷り込まれました。\n\n⑤唾液ブリッジと共に唇を離し、満足そうに舌なめずりする美咲さん。再び抱き寄せられながら、未知の体験に怯えるカリンさん。ダメ押しの美咲さんのキス顔で終了です。\n\nほりえろすさんの『冒険者はメスイキするほど強くなるがバカになる剣を手にいれた!』での描写のように、ひたすらねちっこく相手を堕とすキス責めのイメージです。\n花園美咲さんは、唇を艶っぽく描いてほしいです。\n\n長くなって申し訳ありません。どうかよろしくお願いします。", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@h_o_r_i_e_r_o_s/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2242563, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f0bbbbe/uploads/origins/86c1