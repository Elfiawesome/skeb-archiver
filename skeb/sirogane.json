op=top&w=200&h=200&s=d2d5beeceeadb1df82f8d4651f2c40b7", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a583fa63/uploads/origins/6a6ad46f-cfaa-4f47-8d70-e24ec4e48c80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9bf82943d224b689bd01812ebfdff103", "src_set": ""}, "body": "こんにちは。\n\nうちの子NSWFイラストをお願いします。\nコスチューム、シチュエーション等、内容は問いませんので好き勝手に描いて頂きたいです。\n癖（ヘキ）が詰まったものが見てみたいです。\n\nご検討、よろしくお願いします。\n\nhttps://drive.google.com/drive/u/1/folders/1yAoJasYmsxiPTrTlkrOqQGq8wdY636f5", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sirogane/works/164", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 95254, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5623abd9/uploads/origins/d0fa5fbb-f796-40e6-9c52-4c6711666be7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b500487b5d77afe9db9b0ab803b3245f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5623abd9/uploads/origins/d0fa5fbb-f796-40e6-9c52-4c6711666be7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3954faa68a3d63e631b390fc8036fe9b", "src_set": ""}, "body": "こんばんは。匿名のズリキチです。\nしろがねさんのRTでに○さんじの笹○咲ちゃんが大人の姿になっておっぱいがデカくなっていたのを知りいてもたってもいられず今こうして依頼文を書いております。\n\nシチュとしては、竿役に「デカくなったおっぱいで挟んでほしい」と頼み込まれ、最初は「大人になって最初にやるのがこれかよぉ！？」的な憤りを感じつつもパイズリしていたが、自分の体で気持ち良くなってくれる竿役の姿に悦びを覚えてしまう…というイメージで、バストサイズとカップ数の申告セリフ・射精差分もお願いします。\n\nよろしくお願いします。\n\nhttps://x.com/saku_sasaki/status/1946533099690758633", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sirogane/works/163", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 95254, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/66361bce/uploads/origins/6e4328c0-a85e-404d-8cd5-504e03388998?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae84f6f29f7c57564610fe95e4762cc7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66361bce/uploads/origins/6e4328c0-a85e-404d-8cd5-504e03388998?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bad7628134f759cb1a36a379fcbc368", "src_set": ""}, "body": "初めまして。絵柄が好みなのでリクエストを送らせていただきます。\n\nキャラクター\n牛久花和(アニマエール)\n\n衣装\n添付画像の衣装・髪型\n(きららファンタジアのホワイトデー星5進化前の衣装です)\n\n構図\n胸の谷間を強調した構図・ポーズ\nそれ以外の部分はお任せします。\n\n背景\n白1色でなければなんでも構いません。\n\n納品していただいた絵はSkebの印刷サービスを使い個人的に鑑賞しようと思っています。\nその他指定していない部分や判断に迷う部分があれば好きに描いていただいて構いません。\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1CTpY9qbeiZQfVHEfsZoeMQ0Occ0N4HfU", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sirogane/works/162", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 95254, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5d0c22f/uploads/origins/658d3adf-36c3-4782-83ee-6412b3374da2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6f3df8096663d0c61fe8d86ca84388c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5d0c22f/uploads/origins/658d3adf-36c3-4782-83ee-6412b3374da2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3290a8490855ad7002424416c434efec", "src_set": ""}, "body": "初めまして。\nVtuberの羽奏こはくさんのR18イラストを描いて頂きたくリクエストしました。\n\n■シチュエーション\n・https://skeb.jp/@sirogane/works/151 のような感じで、全裸で拘束され、尿道バイブで激しく責められて絶頂しているシチュをお願いします。\n・可能であれば、事前・最中・事後の差分を描いていただけると嬉しいです。\n\n■三面図等\nhttps://kohaku-wakana.fanbox.cc/posts/5051503\n\nご検討のほどよろしくお願いいたします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sirogane/works/161", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 95254, "client_id": 1883274, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9be6e01f/uploads/origins/7f4b4ba6-fdad-418f-b505-9c08597de79e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92be5ba4d331f9cba80874a172c0b1e5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9be6e01f/uploads/origins/7f4b4ba6-fdad-418f-b505-9c08597de79e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e65a2f4fff13da14b6aad3645aabd4d", "src_set": ""}, "body": "こんにちは。Youtubeにて、EDに使用するイラストを描いていただきたく、依頼させていただきます。\n\nうちの子ニラちゃんのイラストを２枚描いて欲しいです。\n\n１枚目:ニラちゃんが懐中電灯を片手に暗い空間を怖がりながら懐中電灯を向けてるイラスト\n２枚目:ニラちゃんがベットで気持ちよさそうによだれを垂らして枕を抱きしめて背中を丸くして寝てる構図\n\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/12mzvoutb5tEp9ujJPR9PPhj1Re3Pl_qt", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sirogane/works/160", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 95254, "client_id": 779252, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d4975ed/uploads/origins/24940d94-9968-466c-8d68-48e17d39c264?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1ee9be00ddb52e1abbc562bf610269a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d4975ed/uploads/origins/24940d94-9968-466c-8d68-48e17d39c264?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9980fc374196e0dc70e2c0062592e35", "src_set": ""}, "body": "いつも素敵なイラスト拝見しています。\n私のオリジナルキャラクター「フィム」のNSFWイラストをお願いします。\n\n【シチュエーション】\nベッドの上で足を広げた状態、スカートや下着は無し、上着は捲っているか無しでお願いします。\nうちの子自身でくぱぁしてる差分、手マンされて潮吹きしてる差分をいただけると幸いです。\n\n 【資料】\n立ち絵、設定 \nhttps://www.pixiv.net/artworks/131783541\nhttps://www.pixiv.net/artworks/131783645", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sirogane/works/159", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 95254, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a43ce5b6/uploads/origins/31f0146c-7c58-4149-9af3-6364cda89697?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4a2f23b25440067bacf1ae15ace1b33", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a43ce5b6/uploads/origins/31f0146c-7c58-4149-9af3-6364cda89697?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81aaba6a7c9c5d10fe803cc3fd63b2ff", "src_set": ""}, "body": "以前からしろがねさんの絵が好きだったので依頼させていただきます\n\n・キャラ\n新条アカネ（下記URLの衣装、ネグリジェだけ着てノーブラノーパン、胸露出、メガネ必須）\n\n・内容\n女性上位的なイメージで挿入されながら中出しされている姿。\n体位は正常位あるいは騎乗位、いずれにしても結合部（女性器）が画面手前に大きく描かれてるイメージ。\n処女喪失の出血有り（必須）\n表情は涙目だが嬉しそうな感じの笑み（Sっ気あるとなお良）\n可能なら竿役の姿は透明人間状態（無理なら同年代の少年相手イメージ）\n可能なら挿入前、中出し後の差分有（無くても良いです）\n\n以上、よろしくお願いいたします。\n\nhttps://tsutaya.tsite.jp/editor_files/article/000/001/924/article_body/img_20231211153740_002.jpeg", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sirogane/works/158", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 95254, "client_id": 1360269, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c1c6075f/uploads/origins/7e3f9d07-d056-4668-a577-cb0161356d19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=82cbb78ede455cae28479fa30d0bc0c9", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c1c6075f/uploads/origins/7e3f9d07-d056-4668-a577-cb0161356d19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a6b7a79fa7df45b1815676e8e378a06a", "src_set": ""}, "body": "お疲れさまです。リクエストさせて頂きます\n\n●作品\nフラワーナイトガール\n（二次創作ガイドラインはこちら→https://imgur.com/YLzjyCX）\n\n●キャラ\nイソギク\n（キャラ資料文末）\n\n●シチュ・構図\n「ラブラブあまあま台無し射精無限パイズリ御奉仕」をお願いします\n\n服装は文末キャラ資料上段にまとめた物の内好きな物を、先生の裁量で脱衣、簡略化・省略した物\n可能であれば左手薬指（中指と間違えられがちです）に結婚指輪（ゲーム中の誓いの指輪というアイテム）を着けさせて下さい\n\n希望するシチュは以下の流れです。先生のこちらの作品（https://skeb.jp/@sirogane/works/150）の様に４枚に分けて下さい\n\n①\n甘々な雰囲気ながら陰茎を擦り潰す超乳圧＋激しいパイズリ。イソギクは「団長さんは本当にパイズリがお好きですね」「こんなに喜んで頂けると、胸が大きくて良かったと思っちゃいます」「もう出そうですか？遠慮は要りませんからね」「せーのっ……！」と射精させようとする\n\n②\n射精の瞬間に「はいっ♡」と言いつつパイズリを止め、乳圧を緩めて亀頭が出る程度まで胸を開く（描き分けが難しければ止めるだけで大丈夫です）\n射精寸前で刺激が止まり、上がってきた精液を出せない陰茎が激しく震える\n\n③\n寸止め失敗の様に精液がトロっと出る中途半端な射精。イソギクはニッコリ笑い「ふふ、上手にできました」「これ、ルインドオーガズムって言うんです」「こうするとおちんちんが萎えなくて、何回でも射精できるそうです」と説明\n\n④\n「今日はせっかくの『8月13日』（「パイズリの日」のルビを振って下さい）ですからね。すぐ終わったら勿体ないです」「最後の一滴まで出し切れる様に御奉仕しますから」「今夜は頑張りましょうね、団長さん♡」と言い放ち、射精が収まり次第また激しいパイズリを開始し、終了\n\n●補足事項\nSNS上でのシェアの際、機械学習防止ノイズを加えます。御了承下さい\n\n見ての通りのロリ爆乳キャラです。顔つきや手は幼‎めに、胸に関しては盛り過ぎた所から更に一回りデカくするつもりでお願いします\nその他、以下の身体的特徴に留意して作画して下さい\n・泣きボクロ（特に忘れられがちです）\n・アホ毛\n\n以上です\nご検討頂けると幸いです\n\nhttps://i.imgur.com/yIUYKDC\n\nhttps://flowerknightgirl.game-info.wiki/d/%a5%a4%a5%bd%a5%ae%a5%af", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sirogane/works/157", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 95254, "client_id": 44650, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e2056ee9/uploads/origins/2f058fca-cc41-4132-a549-2aaa39ae513a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5adbbf83af28e1ed444260ffbcb121c7", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e2056ee9/uploads/origins/2f058fca-cc41-4132-a549-2aaa39ae513a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c73c050a9e1d4a119f8035caf30d310", "src_set": ""}, "body": "白銀さんこんにちは。\n今回のリクエストですが結城さくなちゃんのHなイラストを描いて欲しいです。\n\nシチュは触手による吸淫責め。\n触手に開脚拘束され、搾乳機(牛用)を小さく細くしたようなカップ型の触手でクリ・乳首・尿道口を4点吸引されるシチュを、差分込みで5枚ほど描いて欲しいです。\n\nポーズはお任せしますが尿道口がよく見えるアングルで描いて欲しいです。\nまた頭から足先までの全身が画角に入るようにお願いします。\n\n触手のカップ部分はガラスのように透明で、吸引されて盛り上がる尿道口や膨らむ突起がよく見えるように描いて欲しいです。\nカップのサイズは小さめで尿道口や突起より少し大きい程度のサイズ感をお願いします。\n\n服装は初期衣装から靴を脱がせて胸をはだけさせた格好を希望しますが、コストがかかる場合は全裸でも問題ありません。全裸の場合でもヘアアクセや靴下は残して貰えると嬉しいです。\n\nその他の要点として、4本の細い触手でアソコを拡げて愛液でどろどろの穴の中を奥まで丸見えにして欲しいです。\nまたおもらしする時におっぱいも噴射させるかはお好みにお任せします。\nさく盛りするかどうかもお好みでお願いします。\n\n差分としては、\n①触手に開脚拘束＆胸とアソコを丸見えにされて恥ずかしがるさくたん\n②カップ触手に4点吸引されて、おしっこ漏らさないように、歯を食いしばったり足の指をギュッと丸めて必死に我慢するさくたん\n③クリに吸い付いたカップの中から歯ブラシのような極細触手が2本現れクリを挟んで錐揉みするよう研磨責め＆尿道に吸い付いたカップからもイボイボだらけのゴーヤみたいな細触手が現れ尿道ピストン責めされ、オシッコも絶頂も我慢の限界寸前なさくたん\n④尿道触手を引き抜かれ勢い良くおしっこを漏らしながら絶頂するさくたん\n⑤おしっこを吸い尽くされて絶頂余韻でガクビク痙攣しながら放心するさくたん※吸引はしたまま\n\n\nさく盛りならぬさく漏りをぜひよろしくお願いします。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sirogane/works/156", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 95254, "client_id": 3649561, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b20e003a/uploads/origins/c05e8a63-44e5-4100-8fef-c4fa3e9d8817?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dbf4baa300a53d33222997422da6950", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b20e003a/uploads/origins/c05e8a63-44e5-4100-8fef-c4fa3e9d8817?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6cad893ebe9e073ddb9200bd0d4ba8ac", "src_set": ""}, "body": "※商用利用予定（DLsite販売作品用） ※R18作品  \nすごくえっちなシチュエーションのイラストお願いします！ \n何でも可能○  \nイラストからシナリオ考えて音声作品を作りたいと考えています。\nよろしければ承認お願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sirogane/works/155", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 95254, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/981c6c19/uploads/origins/ac21d997-9e7d-43ac-9f93-71a4c5cfca43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56cb957f0d4c810a4a845faf1eb8495a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/981c6c19/uploads/origins/ac21d997-9e7d-43ac-9f93-71a4c5cfca43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d724f81a5e151752ec28376f3aa69123", "src_set": ""}, "body": "新しくお披露目されたサイバー衣装でもやっぱりパイ〇リをお願いされてしまうラ〇ィちゃん", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sirogane/works/154", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 95254, "client_id": 751755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6271eb70/uploads/origins/75155c58-857f-41c9-8924-d2e1259890a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12b1dcd3176232a16b31b6a66f7fd624", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6271eb70/uploads/origins/75155c58-857f-41c9-8924-d2e1259890a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11993340ab618c7d9c6d4dc606d7ab82", "src_set": ""}, "body": "※前回の期限切れキャンセルの再送となっております、本文に変更はございません。\nよろしければ御一考お願いいたします。\n\nしろがね先生はじめまして、牛の王子様でち＠86kと申します。\nskebの新着で先生のイラストを見まして、いつかはイラストをリクエストしたいなと思っておりました。\n恐らくは先生がご存じないであろう作品のキャラクターでのリクエストで申し訳ございませんが、リクエストをお受けいただけますと幸いです。\n\n【作品】フラワーナイトガール\n【キャラクター】ハツユキソウ(花騎士)\n【衣装】通常衣装進化後\nhttps://i.imgur.com/uM2Hvyp.png\n【参考】\nキャラクターの体型はこちらの方がわかりやすいと存じます\nhttps://i.imgur.com/ketEKFQ.png\n腰まである白髪ストレートロングでやや小ぶりのおっぱいに大きめのお尻の子です\n【参考】\n・長いもの（団長さん）には自ら巻かれに行くスタイルの子です、直球派の団長さんラブ勢です\n・雪女のような名前と恰好をしていますが、寒いのが苦手です\n・持ち前の不幸体質で何故か言動が面白くなってしまう子でもあります\n\n【用途】\n鑑賞時はスマホで見ますので縦長の構図ですと嬉しいです。\n\n【シチュエーション】\n先生のこちらのイラスト(https://skeb.jp/@sirogane/works/145)の様な感じでおまんこをくぱぁ＋尿道バイブ責めされるハツユキソウを描いてください、お願いします。\n\n衣装は半脱ぎで（上部をはだけて乳首が見えるようにしてください）、 ぱんつは白の綿タイプのシンプルなものを脚に引っ掛ける形で描写していただきますと嬉しいです。\n\nまた、可能であれば事前、最中、事後の差分を描いていただけますと嬉しいです。\n\n以上が私の要望ですが、難しい点や不明な点などございましたら先生のやりやすい様にアレンジしていただいて構いません。\nよろしくお願いいたします。\n\nhttps://xn--eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%83%8F%E3%83%84%E3%83%A6%E3%82%AD%E3%82%BD%E3%82%A6", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sirogane/works/153", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8f1f91a1/uploads/origins/ae985c76-a612-4763-bfae-ff14ae3217f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92ae98f6179f93d0e62bdf36fffe7da8", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 95254, "client_id": 816449, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sirogane/works/152", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 95254, "client_id": 1883274, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c985cc73/uploads/origins/f7440c1b-bdc5-4d54-8327-fb75ce09421b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ab715747f83367f31f979a8bff3ee91", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c985cc73/uploads/origins/f7440c1b-bdc5-4d54-8327-fb75ce09421b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c53dd9041b5fa19f4500019eab99cafa", "src_set": ""}, "body": "リクエストします。\nうちの子アカツキちゃんの馬乗りパイズリイラストを描いて欲しいです。\n\nシチュ\n・ベットの上でよだれを垂らしながら気持ちよく寝ている（健全）\n・寝込みからいきなりパイズリをしてびっくりしてるけど満更でもないお顔\n・射精後二度目のパイズリ→精液ドロドロでハート目でのパイズリ→射精\n・おっぱいの大きさは特盛\n・更にスライムをぶっかけられてるシチュ（こちらもハート目）\n\nよろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sirogane/works/151", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 95254, "client_id": 44650, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0b79e4db/uploads/origins/24e10b0a-080b-466f-86fa-eb5add2e4073?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2412d88b50384989c7e4c95a64baf65", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0b79e4db/uploads/origins/24e10b0a-080b-466f-86fa-eb5add2e4073?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d729cb617081ec7e1e381d66aa673159", "src_set": ""}, "body": "しろがねさんこんにちは。\n早速ですが先日描いていただいたシオンちゃんの続きをリクエストさせてください。\n\nシチュは前回イラストの最後からの続きで、展開は\n『更に激しく尿道バイブ責め』『尿道バイブの上から電マ責め』\n『尿道バイブを吹き飛ばすように潮吹き』『イボ付き指サックで尿道指マン責め』の４つ\n差分数としては６～７点ほどお願いしたいです。\n\n◆差分\n①尿道バイブピストン\n・バイブは↓のような見た目で、太さ1.5cm長さ20cmくらい（膀胱内でぐるっと一回りするくらいの長さ）\n　http://p-rim-e.com/monster-ikacel/\n・先端だけ挿入してる描写と根本まで挿入してる描写を合成した残像ピストン描写\n・力を込めてギュッと窄まるアナル\n・既にイキっぱなしで心も体も限界で「もうやめて」と必死に懇願するシオンちゃん\n\n②尿道バイブの上から電マを押し当てる\n・バイブを根本までねじ込むように電マを強く押し付ける\n・電マと尿道バイブの振動がぶつかり合う衝突音\n・限界を超えた快楽と尿意にガチ泣きするシオンちゃん\n・ドロドロと溢れてくる愛液や壊れたように引き攣るアナル\n\n③電マを退かして尿道バイブごと潮吹き\n・尿道口がめくれ上がるほど勢い良く吹き飛ぶバイブ\n・天井に届くほど真っ直ぐ噴き出る潮と画面(レンズ)に水滴が付着する描写\n\n④イキ疲れてグロッキーなシオンちゃん\n・絶頂余韻で引き付けを起こしたようにガクビク痙攣する身体\n・弛緩と緊張の繰り返しでくぱくぱと開閉するアナルやオマンコ\n・虐められすぎて赤く腫れた尿道口\n\n⑤イボ付き指サックをハメた中指で見せ槍\n・女性のような細長い指で尿道口を小突いたりなぞったりするような焦らし責め\n・息も絶え絶えなか弱い声で「指は挿入んない…指は無理ぃ…」とやだやだ懇願するシオンちゃん\n\n⑥中指を付け根まで一気に挿入\n\n⑦尿道指マンしながら電マでクリ責め\n\n◆その他\n・細かいセリフや表情はお任せします。\n・気持ち良すぎて苦しんでたりイクのを嫌がったりしてる限界な様子をお願いします。\n・火照ったホカホカ描写やガクビク痙攣や頭パチパチしてるエフェクト（漫符）やオノマトペ等を多めに描いて欲しいです。\n\nいつにも増してハードで変態的ですが是非宜しくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sirogane/works/150", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 95254, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d3f2e2c/uploads/origins/aa7e96ee-b679-4032-b6db-7f35a664d473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=63c3bfcdef16e05be99c7537a2b73d4d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d3f2e2c/uploads/origins/aa7e96ee-b679-4032-b6db-7f35a664d473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42f8416d262064cf8c9f97719dbe1f71", "src_set": ""}, "body": "私服衣装（ツーサイドアップのやつ）が見たい！とお願いされて気合入れておめかししてきたら結局パイズリさせられたあげくにぶっかけられてしまうlmyちゃんをお願いします", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sirogane/works/149", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 95254, "client_id": 44650, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e692b8be/uploads/origins/1094a404-bf0b-4410-8688-1b686673d897?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7e9f784356db5395070e53de5ed471f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e692b8be/uploads/origins/1094a404-bf0b-4410-8688-1b686673d897?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b61b709c9058f89b7f58fd640babb4d3", "src_set": ""}, "body": "白銀さんこんにちは、再開お待ちしておりました。\n早速のリクエストですがホロライブの紫咲シオンちゃんのえっちなイラストをお願いしたいです。\n\nシチュは前回と同じく尿道責め。シオンちゃんに着けた貞操帯の鍵穴にバイブを挿し込んでピッキングするような感じで尿道責めするシチュを差分形式で描いてほしいです。\n前回描いて頂いたイラストの差分で良いので、その分たくさん差分を描いて貰えると嬉しいです。\n\n細かい点としては\n・貞操帯はハート型でファウルカップのように股間に被せるタイプ（外れる時はハートが割れるように）\n・尿道バイブはロールブラシのように全面にイボイボ突起が生えたタイプ\n・フックの付いたベルト３本でアソコをくぱぁ（膣口がハート型に広がるように）\n\n差分は\n①貞操帯を見せながら「残念でしたーｗえっちできませ～～～んｗ」とメスガキ煽り（鍵穴から尿道口チラ見え）\n②貞操帯の鍵穴に極細バイブをねじ込まれて「んひぃっ？！ちょ、そこ違っ ！！」と驚く\n③尿道を掻き混ぜるようにほじくり回されて悶える\n④鍵穴や貞操帯の周りから吹きこぼすように潮吹きしながら絶頂\n⑤貞操帯が外れた後も尿道をほじられ続けて「ねえええ！もう開いたじゃん！おまんこ使っていいから！！おしっこの穴もう弄んないで！」と懇願\n※セリフは適当です、シオンちゃんが言いそうなセリフをお好みでお願いします\n※尿道責めの激しさに合わせてクリやアソコやお尻の穴をヒクヒク＆ビクビクと悶えさせてほしいです\n※金額の見合う範囲で良いので尿道責め差分を細分化してたくさん描いて貰えると嬉しいです\n\n色々ありますがいつもと変わらずこれからも推しっ子のおしっこの穴を目一杯かわいがってあげてください。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sirogane/works/148", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c4d38191/uploads/origins/6698c188-a468-47c0-bd17-000e5a3a1493?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=053e9c7d5ef73af39a7ff02e45a4c4ab", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 95254, "client_id": 1883274, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sirogane/works/147", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 95254, "client_id": 10243, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e26807a8/uploads/origins/ebe30dcb-00b4-4b8d-b245-01c8b241ab03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b00fab9c4becfcf453080c58a41ea8d8", "src_set": ""}, "duration": null, "nsfw": false, "h