2%2FaMMNibLh.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_Ymc9NjAwMDIyMjgmdHh0NjQ9YkdsMGJYVnpLdWFubUEwS0RRcmpnWXJrdUpib3FiSGpnYXZqZ2FyamdvcmpnYjdqZ1puamdJTHBwNFRvajVQbHJaQlA1WjZMNDRHbjQ0R1o0NENDRFFyamdaUGpnYTdsdXFiamdhOXpheTR1TGcmdHh0c2l6ZT0zMCZ0eHRhbGlnbj1jZW50ZXIlMkNtaWRkbGUmdHh0Y2xyPWZmZiZ3PTM2MCZoPTM2MCZzPTljMDcwNDAyZjk1YmYzMTlmODk5NDNmN2NmNjYyZTRh&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8609e905c4dc9769c70e610a85a7613f 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1815758502872358912%2FaMMNibLh.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_Ymc9NjAwMDIyMjgmdHh0NjQ9YkdsMGJYVnpLdWFubUEwS0RRcmpnWXJrdUpib3FiSGpnYXZqZ2FyamdvcmpnYjdqZ1puamdJTHBwNFRvajVQbHJaQlA1WjZMNDRHbjQ0R1o0NENDRFFyamdaUGpnYTdsdXFiamdhOXpheTR1TGcmdHh0c2l6ZT0zMCZ0eHRhbGlnbj1jZW50ZXIlMkNtaWRkbGUmdHh0Y2xyPWZmZiZ3PTM2MCZoPTM2MCZzPTljMDcwNDAyZjk1YmYzMTlmODk5NDNmN2NmNjYyZTRh&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8fefe600faf8263d3d4d91357b7fc40d 3x"}, "body": "駄菓子O型様、\nお世話になっております、私はlitmus*と申します。\n\n今回、ボカコレ2024冬に「超有名になりたいっ！」という曲でさんかしました。\nhttps://youtu.be/vJ06Gf2GvEU\n\n次のボカコレの投稿のため、恐縮ですが、今回の楽曲「超有名になりたいっ！」の改善点などを相談したいと思います。\n\n主に相談したい内容は次となります。\n1. 主題の選定が間違っているのですか？\n最初、楽曲を制作するときには、「ボカコレで注目されるためには主題が重要」だと思い、今回の楽曲の主題にしました。\nしかし、SNSやニコニコ動画でバズらなかったことはこの主題があまり魅力がなかったからだと思います。\n実際に、ニコ動とYoutubeのコメントを見たら大体「かわいい」という感想だけで、私が意図した反応ではありませんでした。私が予想した反応は「Vtuberの中の人を会いたいなんてキモい」みたいな感じで、歌詞の内容に触れる反応でした。このような反応がなかったのは主題の伝えに失敗したことだと思いました。\n\n2. 楽曲のジャンル\nボカロ界隈ではリスナーさんたちによくアピールされるジャンルがあると思います。そのジャンルの楽曲を作るとよく注目される方ですか？それともトレンドより、自分の普段のスタイルで制作する方がいいですか？\n\n3. ボカロ楽曲の作り方\n普通の(人間向けの)歌ものとボカロ楽曲の違いと、ボカロ楽曲とPVを制作する際に特に留意すべき点を知りたいです。私が思うには、普通の(人間向けの)歌ものと比べて音階の使用がはるかに自由だという感じでした。\n\n今回の自分の楽曲はいろいろ不足だったことが多いと思います。\nまだボカロPとしての活動は初めてなので、今まで活動していた方のご意見を聞きながら学びたいと思います。\n\nよろしくお願い致します。\nlitmus*", "nc": 137, "word_count": 5003, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1299394, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "イヌガミユキ@犬系作曲家", "screen_name": "hac_white1253", "avatar_url": "https://pbs.twimg.com/profile_images/1812669185261977601/cL3UdxMC.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1199106930830004225/1725092395/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "music"}, {"genre": "voice"}], "banned": false, "nc": 17}, {"id": 1299786, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "西島尊大", "screen_name": "thorndique", "avatar_url": "https://pbs.twimg.com/profile_images/1886046023145172992/EPIgDgwK.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 30, "skills": [{"genre": "correction"}, {"genre": "music"}], "banned": false, "nc": 145}, {"id": 1803009, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "N", "screen_name": "N_noirloup", "avatar_url": "https://pbs.twimg.com/profile_images/1346838514999074820/cXR8tBUU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1341247371397591041/1668315737/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "voice"}], "banned": false, "nc": 144}, {"id": 2348131, "creator": true, "nsfw_accep