=top&w=200&h=200&blur=200&s=9bc90b105a275cd16dc8d484581a483d", "src_set": ""}, "body": "キャラ　伊原さん\n\nシチュエーション　\n・目隠し\n・M字開脚でディルドにまたがるオナニー\n・撮影されながら", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fjk_illust/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3548156, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d126b2ba/uploads/origins/99efa9af-a3d4-4a65-883f-3b1dc22ee079?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=343c712dc81b49fd999fc4e943193856", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d126b2ba/uploads/origins/99efa9af-a3d4-4a65-883f-3b1dc22ee079?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b78a4308ae09c37ad7fe89af7cad27e5", "src_set": ""}, "body": "ここに来てまた申し訳ないのですが、伊原さんのおしっことくぱぁが見たくて依頼させて頂きました。\n件の依頼は大変失礼ながら、大スカばかりはちょっとイマイチかなと思いましたので取り下げております。\n\nシチュはお任せしますので、下記要素取り入れていただければと思います。\n\n・伊原さんは普段着。靴下はあり(くるぶし以下の丈はNG。それより長ければなんでも可。)\n・修正はモザイクではなく黒線でお願いします(Skebくんに怒られたらしょうがない)。\n・伊原さんは、はだける感じで胸は露出。\n・パンツはクロッチが見えておりおしっこやおりもののシミがついている。\n・伊原さんはくぱぁをしている。\n・(できれば)出る前〜出た後の流れで差分をお願いします。\n・(本当にできれば)ついでに脱糞差分を…\n\n以上、ご検討よろしくお願いいたします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fjk_illust/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3548156, "client_id": 3676586, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/56888631/uploads/origins/a6ff553d-80cb-47ca-9d33-f70d7de0761d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a4cd47a713a53e1c6463ffdb773d62b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/56888631/uploads/origins/a6ff553d-80cb-47ca-9d33-f70d7de0761d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75640f201684704e888bb74f193815a8", "src_set": ""}, "body": "夜明け星の諸星茜さん\n\n作中に出てきた乳首ピアスを付けていた時のセクシー衣装で、村人のショタガキとエッチをしている所が見たいです。(主人公に見られて戸惑いながらも、ショタ相手なので優しく困った顔でエッチをしているという設定)\n\nアプデで追加されたようなテカテカな塗表現でお願いしたいです！", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fjk_illust/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3548156, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6fcf8f60/uploads/origins/dabcc929-d057-47fb-a5b0-e8c3baa317ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=756323c3cc189722b68938aa2909c482", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6fcf8f60/uploads/origins/dabcc929-d057-47fb-a5b0-e8c3baa317ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=221d594c844b2597cf6828a9fb094049", "src_set": ""}, "body": "やっぱりこれも投げさせてください。\n\n「溺れるサキュバス。」の「伊原芽衣」のスカトロプレイ過去回想のアナルビーズのシーンの差分をお願いしたく。\n\n・アナルビーズを抜かれて脱糞する差分\n・脱糞後の差分\n・スチルと同じ感じでオノマトペあり\n・(できれば) 「伊原芽衣」と客のセリフもいい感じに考えてつけてもらえませんか？\n\n以上、ご検討よろしくお願いいたします。", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fjk_illust/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3548156, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6597437b/uploads/origins/7f4805ea-825f-4415-b3dc-3a76154dded8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c603906286b92ef57112a1552920a1dc", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6597437b/uploads/origins/7f4805ea-825f-4415-b3dc-3a76154dded8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4447d910a3e9c9ef2b268a73751f62c", "src_set": ""}, "body": "キャンセル申し訳ありません。どうせなら別のシチュでとおもったので依頼内容の変更とそれに伴う金額の調整したしました。\n\nSkebの新着クリエイター欄を眺めていたらめっちゃ見覚えある絵と名前を見つけてびっくりしました！ \n\n ふじき先生のゲームは全部プレイさせて頂いてます。 詰め込まれた性癖と、それを差し置いても最高と言わざるを得ないストーリにいつも楽しませて頂いてます。  \n\n直近発売された「溺れるサキュバス。」プレイさせて頂きました。 \n毛深いところや陥没乳首などエロかったです．．． \nそして、伊原さんの過去や体質に対する葛藤を経てハッピーエンドと呼べるストーリが最高でした！  \n\n依頼ですが、この「溺れるサキュバス。」の「伊原芽衣」のスカトロシーンで出す時の描写がどうせなら見たかったなーと思っていたので、「伊原芽衣」の脱糞後のイラストをお願いします。\n 但し、先生のゲームでスカトロプレイを直接的に描かれている場面はなかった記憶なので、実際に描かれるのは無理という事情等があればキャンセルください。  \n\n以下、詳細です。\n・ベッドに仰向けになっており脱力しているような感じでM字開脚した体勢。\n・白いベットシーツの尻の周りには軟便が広がっている。\n・引き抜かれたであろう便まみれのアナルビーズが転がっており、便が垂れシーツに染みを作っている。\n・「伊原芽衣」の表情は事後の余韻で朦朧としている感じ。\n・精液飲んだ後でこぼれた精液が胸元に垂れている。\n・(これはできればで)客の要求でJKのコスプレをしており、完全に前がはだけたカッターシャツ、緩んだ胸元のリボン、黒ハイソックスを着用。\n\n以上、ご検討のほどよろしくお願いします。", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "from_archive": true}