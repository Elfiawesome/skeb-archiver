tps://www.pixiv.net/artworks/42741974\n\n紫さんの格好は↑の絵と同じで、またもスリットの隙間に左手を突っ込まれてぐちゅぐちゅ弄られているのに加え、痴漢の右手に胸を揉みしだかれている格好となります。\n太ももにはずり下ろされたパンティーが見えていると個人的に嬉しいです。\n胸の揉み方は服の上から揉んでいるか、服の隙間に手を突っ込んでるかのどちらかでお願いします。\n紫さんは以前と違って掴める柱がなく、右手で自分の口を押えて必死に我慢していますが、それでも喘ぎ声などが漏れてしまい、心の中で「どうして私ばかり……」と嘆きつつもされるがまま状態となっています。\n\n以上で宜しければご検討をお願いします！", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nakatsukuniaki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2488, "client_id": 790928, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fae386ec/requests/277318_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df5a93174166a16dc12ab3a215b7142e", "srcset": "https://si.imgix.net/fae386ec/requests/277318_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df5a93174166a16dc12ab3a215b7142e, https://si.imgix.net/fae386ec/requests/277318_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d424318a03c26009fbcd2d9b6f35ed8 2x, https://si.imgix.net/fae386ec/requests/277318_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de7e2a0ae6af7d76c97b3ee0c692fd61 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fae386ec/requests/277318_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dfc2bf5c518becde4748aadb790cd8f8", "srcset": "https://si.imgix.net/fae386ec/requests/277318_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dfc2bf5c518becde4748aadb790cd8f8, https://si.imgix.net/fae386ec/requests/277318_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8c4946932bce91330c888a3c2c65033b 2x, https://si.imgix.net/fae386ec/requests/277318_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=t