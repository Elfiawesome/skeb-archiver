でしょうか。\n\nアゼムの髪は濃い緑色で、青いハイライトが入っています。とても長く、太く、カールしています。頭の両脇に三つ編みの髪があります。頬にはソバカスがある。右耳にはピアスをつけています。エメット・セルシュは左の耳にも同じピアスをつけています。\n\nアゼムは、優しく、軽薄で、情熱的で、大胆で、のんきな性格です。エメット・セルシュは、厳格で不愛想、感傷的、そして思いやりがある。\n\nご検討ありがとうございました。\n\nhttps://imgur.com/a/xtWeTpu", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sjsju0/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 110832, "client_id": 991142, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a74ca23/uploads/origins/2cebcf77-8ca5-4e26-a8c2-6360acb33c8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9b02592e817f1226f33b762378a9afe", "srcset": "https://si.imgix.net/9a74ca23/uploads/origins/2cebcf77-8ca5-4e26-a8c2-6360acb33c8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9b02592e817f1226f33b762378a9afe, https://si.imgix.net/9a74ca23/uploads/origins/2cebcf77-8ca5-4e26-a8c2-6360acb33c8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1cd9caf790950ecb8e8fb4f8e434b3b1 2x, https://si.imgix.net/9a74ca23/uploads/origins/2cebcf77-8ca5-4e26-a8c2-6360acb33c8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=920db3d074bb2d01ee85c3711f9f46fa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a74ca23/uploads/origins/2cebcf77-8ca5-4e26-a8c2-6360acb33c8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=073f65e7952a8b0608d7b1d6c1f73550", "srcset": "https://si.imgix.net/9a74ca23/uploads/origins/2cebcf77-8ca5-4e26-a8c2-6360acb33c8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=073f65e7952a8b0608d7b1d6c1f73550, https://si.imgix.net/9a74ca23/uploads/origins/2cebcf77-8ca5-4e26-a8c2-6360acb33c8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=20