": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3225139, "client_id": 3610722, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/26993887/uploads/origins/1c702a3c-90b9-4487-b39a-5ee0cb2ec6d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b702b5a67a9f177589810d686383d71e", "srcset": "https://si.imgix.net/26993887/uploads/origins/1c702a3c-90b9-4487-b39a-5ee0cb2ec6d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b702b5a67a9f177589810d686383d71e, https://si.imgix.net/26993887/uploads/origins/1c702a3c-90b9-4487-b39a-5ee0cb2ec6d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1bf02862dc2aa0ece040975192e6a1a3 2x, https://si.imgix.net/26993887/uploads/origins/1c702a3c-90b9-4487-b39a-5ee0cb2ec6d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a2db5895c0736469fe4d98f67768fa3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/26993887/uploads/origins/1c702a3c-90b9-4487-b39a-5ee0cb2ec6d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=76f83b55cc5a955f14d9d4f007ce29d8", "srcset": "https://si.imgix.net/26993887/uploads/origins/1c702a3c-90b9-4487-b39a-5ee0cb2ec6d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=76f83b55cc5a955f14d9d4f007ce29d8, https://si.imgix.net/26993887/uploads/origins/1c702a3c-90b9-4487-b39a-5ee0cb2ec6d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c4fb818439d6d1dc6e0e2725dc4bdd87 2x, https://si.imgix.net/26993887/uploads/origins/1c702a3c-90b9-4487-b39a-5ee0cb2ec6d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9268bc63ad6a3bee91dc3667c5c0c307 3x"}, "body": "ばろさん、こんにちは！霜牙と申します。\nずっとばろさんの絵が大好きで、ぜひ一枚描いていただきたくてリクエストをお送りしました！\n私のキャラクターはアプリコット色のクマで、ぽっちゃりと肉付きの良い（がっしりした）体格と、非常に太い（本当に太いです！）眉毛がチャームポイントです。\n赤いマフラーを巻き、腕には包帯を巻いていて、顔には少し照れたような赤みが差しています。腰には小さなペンギンのチャームを下げており、頭のてっぺんには水色のアホ毛が一本あります。\n彼は保護欲があって温かく頼もしい雰囲気ですが、少しだけ粗削りで不器用なところもあります。\n今回は、彼が六尺褌を締め、これからお風呂に入ろうとしている姿をお願いしたいです。\nばろ様のタッチで、彼の雄々しく大きな体ガッチリとした肉感大らかで愛嬌のある雰囲気を表現していただければ嬉しいです。\nばろさんのタッチで描かれる彼を見られるのを、とても楽しみにしています。よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1nG-1YyrgqIZWcPPQ_sb8aEZontcj3wMR?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@barontoko/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3225139, "client_id": 1111768, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5c04adf8/uploads/origins/9c61310a-cc9b-49be-bf42-3b03f4dd7811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=457c61472d7dbdfb0a6fb924c5f42b5a", "srcset": "https://si.imgix.net/5c04adf8/uploads/origins/9c61310a-cc9b-49be-bf42-3b03f4dd7811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=457c61472d7dbdfb0a6fb924c5f42b5a, https://si.imgix.net/5c04adf8/uploads/origins/9c61310a-cc9b-49be-bf42-3b03f4dd7811?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9116969661a61120483ddb914b5dca7d 2x, https://si.imgix.net/5c04adf8/uploads/origins/9c61310a-cc9b-49be-bf42-3b03f4dd7811?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1dbec201b5957dde7b0313fa12ade5f3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5c04adf8/uploads/origins/9c61310a-cc9b-49be-bf42-3b03f4dd7811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6838222d9ca381f79fa34bc204c7ad4b", "srcset": "https://si.imgix.net/5c04adf8/uploads/origins/9c61310a-cc9b-49be-bf42-3b03f4dd7811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6838222d9ca381f79fa34bc204c7ad4b, htt