るのどちらでも良いです)\n\nhttps://twitter.com/YuKiASxm/status/1520283572082421760?s=20&t=QkaLR1qn9X7iIE6jublrQw", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 54918, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "yam", "screen_name": "yamaP_mako", "avatar_url": "https://pbs.twimg.com/profile_images/1844153513003319296/WQIl0DOO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/764698612093681664/1708339406/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 597656, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "紫色の柿子@Skeb募集中", "screen_name": "kakiko228", "avatar_url": "https://pbs.twimg.com/profile_images/1493236362321207296/2h-EdKrI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/862883037280849920/1779297653/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 2197011, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "GON skeb &お仕事募集中", "screen_name": "GON09243510", "avatar_url": "https://pbs.twimg.com/profile_images/1949423023888691200/QwE18RNG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4888167803/1753613654/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"