t=PRIVATE&s=f9add7d55f4567f68416f16ff6c27687 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2174617, "client_id": 2729188, "nc": 144}, {"path": "/@amenohachi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2174617, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0fb15a66/uploads/origins/2ddf6015-323a-40fc-8342-901c6abfb768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c832ea161d0fdf5fa22c0b70cd4b0575", "srcset": "https://si.imgix.net/0fb15a66/uploads/origins/2ddf6015-323a-40fc-8342-901c6abfb768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c832ea161d0fdf5fa22c0b70cd4b0575, https://si.imgix.net/0fb15a66/uploads/origins/2ddf6015-323a-40fc-8342-901c6abfb768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb54cde93dec5ad303e388ec530c90f9 2x, https://si.imgix.net/0fb15a66/uploads/origins/2ddf6015-323a-40fc-8342-901c6abfb768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35a856ccef23c083fa14be3e08daaf8d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0fb15a66/uploads/origins/2ddf6015-323a-40fc-8342-901c6abfb768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=717c1dd05e6a086bb73257f5785d03e4", "srcset": "https://si.imgix.net/0fb15a66/uploads/origins/2ddf6015-323a-40fc-8342-901c6abfb768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=717c1dd05e6a086bb73257f5785d03e4, https://si.imgix.net/0fb15a66/uploads/origins/2ddf6015-323a-40fc-8342-901c6abfb768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8f618244ef15826cb723e123d48eb766 2x, https://si.imgix.net/0fb15a66/uploads/origins/2ddf6015-323a-40fc-8342-901c6abfb768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4948633a669674e0f8db81c37c5a5330 3x"}, "body": "あめのはち様\n\nはじめまして、こんにちは！！\nあめのはち様の絵柄や世界観が大好きで、いつもTwitter(X)や Pixivの更新を楽しみにしています。\nLINEスタンプもお気に入りで、毎日のように愛用しています。\n好きな作品はたくさんありますが、かなり昔に掲載されていた入院レポ漫画を1番よく読み返しています。\nわたしが過去に大病を患ったとき、病名は全く違いましたが病気が見つかるまでの不安感や入院中の様子など、共感できる場所が多く、時折当時のことを思い出して無性に読みたくなるときがあります。\n漫画越しに応援してもらっているようで、お守りのように大切に抱きしめて過ごしています。\n\n前置きが長くなってしまいましたが、今回リクエスト内容は「わたしの愛犬のイラスト」です。\n\nわたしの愛犬ゼロは、ボーダーコリーのブルーマールという毛色をしているオス犬です。\n体は大きいですが、まだ0歳8ヶ月の子犬になります。\nボーダーコリーのグッズは探せば見つかるのですが、わたしの愛犬と同じブルーマールのグッズはなかなか見つからないため、是非大好きなあめのはち様の絵柄のブルーマールを見たいと思い、リクエストをお送りしました。\n\n資料用にわたしの愛犬ゼロ専用Twitter(X)アカウントを掲載しておきます。\nhttps://twitter.com/tinju_zero\n※資料URLにわたしの普段使いしているTwitter(X)アカウントのURLも掲載しておきます。\n\nポーズは描きやすいポーズを自由に描いていただいても、写真を参考に描いていただいても構いません。\nもし可能であれば、以前掲載されていた「くまちゃんイラスト」のような絵本のような素朴で可愛い雰囲気にしていただけますと嬉しいです。\n\n参考になるかわかりませんが、ゼロの特徴を書いておきます。\n・凛々しい顔つきをしているけれど、かなりの甘えん坊\n・りんご大好き\n・人間大好き\n・ぬいぐるみ大好き\n・お気に入りはIKEAの大きなサメのぬいぐるみとライオンのぬいぐるみ\n・青い瞳がチャームポイント\n・雪遊びが好き\n・笑うとアザラシのように耳が倒れる\n・名前の由来はDisney映画のナイトメアー・ビフォア・クリスマスの幽霊犬ゼロから\n\n描いていただけたイラストで個人で楽しむ範囲内でグッズをいくつか作りたいと思っているのですが、よろしいでしょうか？\nまた、SNSなどで友達や家族に自慢をしたいと思っています！\n\nお手隙の際で構いませんので、ご検討頂けましたら幸いです。\nよろしくお願いします！\n\nちんぢう\n\nhttps://twitter.com/tinjuxxx/status/1756635081094095206?s=46&t=FDazENgy8PqtXmWvPmwU8Q", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@amenohachi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2174617, "client_id": 841482, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c5094bae/uploads/origins/03646930-c721-4795-ac30-8e958b04c84c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4f246b645d51e15e3c1520de8dff10f", "srcset": "https://si.imgix.net/c5094bae/uploads/origins/03646930-c721-4795-ac30-8e958b04c84c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4f246b645d51e15e3c1520de8dff10f, https://si.imgix.net/c5094bae/uploads/origins/03646930-c721-4795-ac30-8e958b04c84c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30cc348a9cb79a0059a660363cf6e02f 2x, https://si.imgix.net/c5094bae/uploads/origins/03646930-c721-4795-ac30-8e958b04c84c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=070ea9d1e4d913126287eab0d757d317 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c5094bae/uploads/origins/03646930-c721-4795-ac30-8e958b04c84c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b41fecf3fb4988f9f39321dea4ec3fb", "srcset": "https://si.imgix.net/c5094bae/uploads/origins/03646930-c721-4795-ac30-8e958b04c84c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b41fecf3fb4988f9f39321dea4ec3fb, https://si.imgix.net/c5094bae/uploads/origins/03646930-c721-4795-ac30-8e958b04c84c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6184ebeef0bb66bb9d313f7f8f46aa6f 2x, https://si.imgix.net/c5094bae/uploads/origins/03646930-c721-4795-ac30-8e958b04c84c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa7cf67ca4e30552d8c7093eed5c99f8 3x"}, "body": "あめのはち様\n\nはじめまして、漫画家のいまい野しゃると申します。\n\nくまちゃん夫婦漫画をはじめ、いつも楽しく拝見しとても癒されております。\nあめのはち様の可愛くて優しいイラストが大好きです。\n特に口元の動きが大変愛らしくて見ているだけでニコニコしてしまいます。\n\n今回は自分の自画像（代理キャラクター）をリクエストさせていただきたく存じます。\nテイストとしてはくまちゃんに近いというか、くまちゃんの隣にいても違和感のないぷにっとした感じを希望します。\n-------------------------------------------------------------------------\n【特徴】\n・サイズの合わない中折れ帽子or黒麦わら帽子をかぶった（乗せた）コツメカワウソ\n・無地の黒のTシャツor長袖\n・下半身は服を着ない\n・いつも楽しそうにニコニコしている\n\n以下のURLも併せて参照ください。\n※ファンアートを含みますが自画像はオリジナルキャラクターです\nhttps://twitter.com/_lool_hello/status/1668470077103149061/video/1（実写）\nhttps://twitter.com/_lool_hello/status/1682514510182244353/photo/1（実写）\nhttps://twitter.com/_lool_hello/status/1731603501267161498/photo/1\nhttps://twitter.com/_lool_hello/status/1683019707266527234/photo/1\nhttps://twitter.com/_lool_hello/status/1665740466414026753/photo/1（側面）\n-------------------------------------------------------------------------\nポーズのリクエストも可能でしたら描きやすいものを、下記からお選びいただけますととても嬉しいです。\n\n・原稿に追われてぐるぐる目になっている\n・楽しくお絵描きしている\n・シャインマスカットを食べている\n・綿菓子を食べている\n・ブラックコーヒーを飲んでいる\n・キャリーケース（カラーコード#3bccbe）をコロコロして旅に出ている\n・ごろごろしながらスマホ（YouTube）を見て笑ってる\n・推し活をしている（デコうちわにLOVE❤等？）\n・水族館、特にシャチやアザラシ等の海獣が大好きなのでそのぬいぐるみを持っている\n\n上記に無理に従わずお心のままに描かれましても、もちろんとっても嬉しいです！\n-------------------------------------------------------------------------\n描いていただけたイラストは、紙やアクリルへの印刷を含む個人観賞、各種SNSのアイコンにしたく思います。あとはSNSでめちゃくちゃ自慢します。\n\nもしリクエストをお受けいただけましたら一生の宝物にいたします。\nご検討のほど、何卒よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@amenohachi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2174617, "client_id": 3132147, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/faf6ffc4/uploads/origins/f73beb51-5f20-4f92-8113-4150ee2c1bb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c6b7bbef6b5710493a9db667d835d71", "srcset": "https://si.imgix.net/faf6ffc4/uploads/origins/f73beb51-5f20-4f92-8113-4150ee2c1bb9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c6b7bbef6b5710493a9db667d835d71, https://si.imgix.net/faf6ffc4/uploads/origins/f73beb51-5f20-4f92-8113-4150ee2c1bb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b1d3e1e46e168cca180be84ba9779af 2x, https://si.imgix.net/faf6ffc4/uploads/origins/f73beb51-5f20-4f92-8113-4150ee2c1bb9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d04f99e59f04c23e90f879cbfb77a216 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/faf6ffc4/uploads/origins/f73beb51-5f20-4f92-8113-4150ee2c1bb9?bg=%23fff&au