lient_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@CloseDoorstar/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2392056, "client_id": 441269, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4007d9d0/uploads/origins/b264127a-6c3f-43e0-a994-885d05cfaf5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3de46db106a85fed3873c19914ce6933", "srcset": "https://si.imgix.net/4007d9d0/uploads/origins/b264127a-6c3f-43e0-a994-885d05cfaf5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3de46db106a85fed3873c19914ce6933, https://si.imgix.net/4007d9d0/uploads/origins/b264127a-6c3f-43e0-a994-885d05cfaf5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b13ed3368b509f4e0922c6968362280b 2x, https://si.imgix.net/4007d9d0/uploads/origins/b264127a-6c3f-43e0-a994-885d05cfaf5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cb292c730dea1e857412e21ff1e39eda 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4007d9d0/uploads/origins/b264127a-6c3f-43e0-a994-885d05cfaf5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32cc57d156144bda934b747fb289bfbf", "srcset": "https://si.imgix.net/4007d9d0/uploads/origins/b264127a-6c3f-43e0-a994-885d05cfaf5d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32cc57d156144bda934b747fb289bfbf, https://si.imgix.net/4007d9d0/uploads/origins/b264127a-6c3f-43e0-a994-885d05cfaf5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ff88eeed6d9ca38a8be6b045058e5a0 2x, https://si.imgix.net/4007d9d0/uploads/origins/b264127a-6c3f-43e0-a994-885d05cfaf5d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eeb7c254f9dfd0d45f60bd82e7aef63c 3x"}, "body": "前回承認していただきありがとうございました！\n今回もイラストというよりコミックな内容ですがよろしくお願いします！内容として前回の続きみたいな感じです。\n\n概要\n仲間達に助け出され、ヴィオレと再戦する真輝\n「前のようにはいかねぇぞヴィオレ！」と言い放つが、ヴィオレがチンポを見せた瞬間アナルが疼きスーツ越しにもわかるほどチンポと乳首が勃ち動揺する真輝\nその隙を突かれ、魔種によって爪先立ちガニ股腋見せ体勢で固定され、乳首や竿、玉、尿道、アナルや腋を掘られ舐められ吸われ揉まれ弄られる。\nさらにヴィオレの腋を顔に押し付けられ、「俺の腋を舐めろ」言われ、拒絶したもののヴィオレの身体操作魔術で顔を動かさせられ丁寧に腋を舐めさせられ、身体をガクガクさせながら射精してしまう。\nさらにブーツを脱がされそれを顔に押し付けられ自身の足臭を嗅がされた上ヴィオレの雄臭い腋を交互に嗅がされる。\n臭い筈なのにガニ股で腰ヘコをし、「身体は堕ちたまんまじゃねぇかこの雑魚メス」と言葉責めもされメスイキ。\nさらに舌をちらつかせながら「固定や魔種は解除してやるから早く逃げないと『捕まえてキス』しちまうぜ？」と言うヴィオレ\nあのベアハッグとキスだと予感したが、身体に力が入らずそれどころか、腰はヘコヘコ、チンポはたらたらと汁を垂れ流し、スーツ越しなのに何かを欲するようにアナ○もクパクパ♡と閉じたり開いたり、そしてついにベアバックの舌を突き出してヴィオレの口付けを受け入れてしまう。\n口内を激しく長くねっとりと蹂躙するキスの快感にほぼ白目を向いていたり、足ピンやだいしゅきホールドなど忙しなく足を動かしさらにチンポや乳首を擦り付け連続射精をしてそのまま倒れてアヘ顔晒しながら気を失ってしまい、そんな真輝にヴィオレは真輝のチンポを踏みながら「で？前のお前となにが違うって？」という問いかけに、気を失っているのにこれが答えと言わんばかりにピュ♡と雑魚射精をする真輝。\n\nエピローグ\nまたまたヴィオレと対峙している真輝だがどこかおかしく。\n身体やスーツのあちらこちらに下品な落書きが描かれていたり、すでにスーツ越しにチンポや乳首はビンビン、アナルはクパクパさせ顔も何か期待しているのか下品な顔持ちで興奮していたりとどこかおかしい真輝\n次の瞬間「喰らえ俺の必殺技！！....チンハメ媚びフェラ素振りエロ蹲踞を♡♡♡！！！」と言い放つ片手でフェラ素振り片手でアナニーをしている真輝\nあの後ヴィオレにお持ち帰りされ、ヴィオレの日々の性欲や加虐を発散するための玩具に堕ちてしまったのである。\nそうして要望通りヴィオレのチンポをひょっとフェラで奉仕する真輝の顔を写してお終いです。\n\n\nというのが見てみたいです！可能でしたらよろしくお願い致します！", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@CloseDoorstar/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2392056, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/32506ab0/uploads/origins/8b584edd-0bf0-4bcc-bc3c-dc39fc9f14c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9116dc68d5173b8aef1fab81613df80d", "srcset": "https://si.imgix.net/32506ab0/uploads/origins/8b584edd-0bf0-4bcc-bc3c-dc39fc9f14c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9116dc68d5173b8aef1fab81613df80d, https://si.imgix.net/32506ab0/uploads/origins/8b584edd-0bf0-4bcc-bc3c-dc39fc9f14c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&f