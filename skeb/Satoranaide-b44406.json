ormat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b8cf63da736807d0921ff55c2e9d91e 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1982406042064494592%2FGovLA4Nw.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2397bf038a8671b6add99e630810b811 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1982406042064494592%2FGovLA4Nw.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7de6b4daee35888e72adc3b85f702f50", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1982406042064494592%2FGovLA4Nw.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7de6b4daee35888e72adc3b85f702f50, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1982406042064494592%2FGovLA4Nw.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4dd64bff32d19a6a42a4c334ae836bf7 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1982406042064494592%2FGovLA4Nw.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2734b8b4780817f628c58f9ee09ac35c 3x"}, "body": "お世話になっております！\nアイドルマスターSideMの眉見鋭心と夢主（後述）との小説をお願いしたいです。\n10thCDストーリー内に出てくる眉見鋭心含めたC.FIRSTが演じるミツフルという恋愛モノにハマった夢主がその後も同事務所内の恋愛モノの物語や雑誌の特集に乗っているデートプランやプロポーズの言葉などを見てはしゃいでるのを見て嫉妬心を抑えきれなくなった鋭心が自宅のシアタールームに連れ込んで強引に犯すシチュエーションでお願いします！\n嫉妬に狂うところが好きなのでそのあたりメインだと助かります。\n下品のレベル？が3割くらい？で……控えめだとありがたいです！（ここら辺主観なのでだいたいの感覚で大丈夫です！すいません上手く伝えられず……）\n以下夢主の設定です。\n照井 叶夢\n鋭心と同じ剣羽高校に通う18歳（同級生）\n中学の頃から仲がいい。最初はあまり喋らないがいちど仲良くなればスキンシップが多くなる。あんまり賢くはない。\nオタクではない、性別も性的指向もフラットなため恋愛特集で同性からの告白とかも自分が言われてときめく！という捉え方をするタイプです。\n金髪で前髪は自分で切っているためガタガタ。くせっ毛でふわふわしている。襟足は刈り上げている。瞳は緑。意外とガタイがしっかりしてるので別に女装は似合わないタイプ\n一人称：俺\n口調：仲良い人だとテンションが高く軽い喋り方。「○○だよね！」「これすっごい良くってさあ！」「え？なんで？そんなに？」ただ、めちゃくちゃ、よりはすごいを使ったりマジ、よりはほんとを使うように砕けても言葉はあまり崩さないところがあります。\n興味が先行しすぎたりとか興奮してたり、あとテンパったりすると口数が多くなる傾向があります。\n信頼度低めだとそもそも口数が少なく、テンションもやや低め。「そうだね」「うん」といった相槌が多く、それ以外は質問されたら答えだけを伝え話を広げられないような感じ。\nちゃんと話を聞かないところがあるため適当にうんうんと返事をしていることが8割。\n声が大きいのをすこし気にしているので最中に声を抑えようとするところがあります。\n\nNG等は特にないです！すいませんはじめてでどこまで書けばいいのか分からず過不足あったら申し訳ないです！\nよろしくお願いします！", "nc": 43, "word_count": 10736, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@Satoranaide/works/3", "private_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1982406042064494592%2FGovLA4Nw.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b133c9d20aa6d195f7781b744ac0068c", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1982406042064494592%2FGovLA4Nw.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=