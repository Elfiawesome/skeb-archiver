ーンの差分をお願いしたいです。\n\n・こちらも可能なら、擬音や適当なセリフをつけていただけるととても嬉しいです。\n\n以上になります。\nよろしければ、検討いただければ幸いです。\n\nhttps://photos.app.goo.gl/q9F5LBFWbZ6RbW9U7", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kanameyeah/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/86f62d4a/uploads/origins/d570eabe-5b82-4810-b1cf-1aca70b706b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2224d8b0c0b6edeb878a4b2760355f52", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1796981, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kanameyeah/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1796981, "client_id": 383862, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fe0598af/uploads/origins/9dd67789-6fec-4781-aaca-3729b0441137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42e077110c9dc02099265d47895b2c34", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fe0598af/uploads/origins/9dd67789-6fec-4781-aaca-3729b0441137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1198493bdad8f7fae4d7fbd93838bdb7", "src_set": ""}, "body": "光翼戦姫エクスティア3という作品からセレスティアというキャラクターを依頼できますでしょうか。\n内容としては、Hなポーズをして主人公を誘惑している様子でお願いします。\nその他の構図・アレンジ等は全てお任せしますがご検討よろしくお願いします。\n\nhttps://imgur.com/a/BrzV2Gk", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kanameyeah/works/2", "private_thumbnail_image_urls": null, "private": 