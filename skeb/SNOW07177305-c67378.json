op=top&w=200&h=200&blur=200&s=7c210a07d4c0d9b53fb5a610e52dacbc 2x, https://si.imgix.net/f56e6e48/uploads/origins/0240af02-2587-4ced-9daa-c864005ceaf6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b4b9a3c861561110a32b7e868d238613 3x"}, "body": "あんどうさん、こんにちは。skebで初めてご依頼させていただきます。\n以前『OO1/138』にHO1教祖として通過させていただきまして、END-Dでシナリオを終えた者です……。\nダイス面で負けたことへの悔しさはとてもありますが！それでも、ダブオワの世界観や神話/神話生物と人々との距離感、2PLシナリオとしての面白さの全てに心惹かれ、TRPGで遊んできた中でも特に心に残るセッションの一つとなりました。この世に『OO1/138』という作品を生み出してくださり本当にありがとうございます……心からの感謝を申し上げます。\n\n◆依頼内容について\n今回依頼させて頂きたいのは『OO1/138』自陣(HO1教祖とHO2吟遊詩人)の一枚絵です。\n\n◆シチュエーションについて\nセッションの際、END-Dが確定しHO1が変貌後にHO2に致命傷を与えるシーンを描写後にKPが最後に少しだけRPの場を設けてくださりHO2の死ぬ間際に話をすることが出来たのですがその時のシーンをイラストで描いていただきたいです。HO2の傍で涙を零している異形化したHO1と致命傷を負って死ぬ間際でもHO1に優しく声を掛けるHO2という構図だと嬉しく思います。異形化したHO1のデザインはあんどうさんのお好きに描いていただいて構いません！(私自身が異型のデザインが上手でないのとせっかくなのであんどうさんの異型デザインが見たいため......)(顔はある程度原型があると嬉しいです)HO2に関しても流血具合に関してお好きに書いていただいて構いません。\n\n説明の不足や金額が相応でないなどがあればキャンセルしていただいても構いません、何卒ご検討の程よろしくお願いいたします。\n\n▼依頼したい人物の資料\n【キャラクターシート】\nHO1教祖CS\nhttps://iachara.com/view/12322665\nHO2吟遊詩人CS\nhttps://charasheet.vampire-blood.net/5427992\n\n【画像など】\nhttps://drive.google.com/drive/folders/194NglMP3H3sGxjFStJ-pNTwwyNL_tTj_?usp=sharing\n※以下HO2の立ち絵に使用していたピクルー(規約確認済み)\nhttps://picrew.me/ja/image_maker/2741711\n\nhttps://drive.google.com/drive/folders/194NglMP3H3sGxjFStJ-pNTwwyNL_tTj_?usp=sharing", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rarirureroppai/works/97", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 832718, "client_id": 1385073, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/26a72597/uploads/origins/96a232f3-d1a2-49cb-bc90-a6323d05300e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b4dcab7049d31d436aea8d9fb8c5d89", "srcset": "https://si.imgix.net/26a72597/uploads/origins/96a232f3-d1a2-49cb-bc90-a6323d05300e?b