at%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6dc4c9f18262e2c2ad8b8aac3c7d7bdb", "srcset": "https://si.imgix.net/9f0ed07f/uploads/origins/7574892d-9a4e-4a3d-a798-021b606729eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6dc4c9f18262e2c2ad8b8aac3c7d7bdb, https://si.imgix.net/9f0ed07f/uploads/origins/7574892d-9a4e-4a3d-a798-021b606729eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=97b0e1e6b3345af36946e6bcd5fe9887 2x, https://si.imgix.net/9f0ed07f/uploads/origins/7574892d-9a4e-4a3d-a798-021b606729eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3912fa11e3ad5a303398ae4b87326a9d 3x"}, "body": "お世話になっております。\nいつも素敵なイケメンイラストを拝見させて頂いております。\n以前依頼させて頂いたpurpleくんとyellowくんもすごく素敵でした。\n今でも見てはキュンとしています。\n\n今回のリクエストですが、もう一度purpleくんをお願いしたいです。\nなんだかアンニュイな雰囲気でバーのカウンターらしき場所に突っ伏してるような、そんなpurpleくんをお願いします。\n\nなんかこんな感じのポーズ……な参考資料を添付します。（フリー素材を参考にしています）\nもちろん変えて頂いて構いません。\n\n連続での依頼かつ同じキャラの依頼ですみません。\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1fqO9ZgZjgUjeAEmi6Eto6lwCKRmKQiDL/view?usp=drivesdk", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@murou_ei/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2873917, "client_id": 2496306, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a8dadba/uploads/origins/1f493780-6232-4781-bedc-1e3998097ed3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=506c09738eb8131ca9b99b4eb56446e1", "srcset": "https://si.imgix.net/5a8dadba/uploads/origins/1f493780-6232-4781-bedc-1e3998097ed3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=506c09738eb8131ca9b99b4eb56446e1, https://si.imgix.net/5a8dadba/uploads/origins/1f493780-6232-4781-bedc-1e3998097ed3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8a297437f500d20c86880ac8a7938ef6 2x, https://si.imgix.net/5a8dadba/uploads/origins/1f493780-6232-4781-bedc-1e3998097ed3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8fdb42d9c8dab6f9afffe93bff8b3159 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a8dadba/uploads/origins/1f493780-6232-4781-bedc-1e3998097ed3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=187659924397074571f3f6078225c3e8", "srcset": "https://si.imgix.net/5a8dadba/uploads/origins/1f493780-6232-4781-bedc-1e3998097ed3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=187659924397074571f3f6078225c3e8, https://si.imgix.net/5a8dadba/uploads/origins/1f493780-6232-4781-bedc-1e3998097ed3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4a5daec6c36d00d6b51bf497352f2d76 2x, https://si.imgix.net/5a8dadba/uploads/origins/1f493780-6232-4781-bedc-1e3998097ed3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ec704c0af5c299708d68ab37fe463288 3x"}, "body": "えいむろう先生、はじめまして。\n\n私のOCのイラストをお願いしたいです。表情や雰囲気など、下記のプロフィールをご参考いただければ幸いです。\n\n依頼内容：オリジナルキャラクター「デヴォン・アッシュボーン (英：Devon Ashborn)」\n\nデヴォンは占術を専門とするティーフリングのウィザード（魔法使い）で、現在35歳です。普段はフォーマルな場面では巻物やカードを使って占いを行い、プライベートでは本とお茶を楽しめるカフェを経営しています。カフェではお客さんに茶葉占いをしており、いつも穏やかでよく笑う、親しみやすい性格の持ち主です。\n\nポーズやシチュエーションはすべてお任せしますので、自由に実験していただければ嬉しいです。\n\n外見の特徴：\n\n年齢：35歳\n身長：約180cm\n肌：やや日焼けした色\n髪：短めのブラウン\n目：青色\n角：茶色から赤茶色のグラデーションで、金色または真鍮のリングアクセサリー付き\n尾：角と同じグラデーションカラー\n\n両腕には**魔法的・天体的なモチーフのタトゥー（スリーブ状）**があります。デザインは正確でなくても大丈夫で、同じ雰囲気であれば十分です。占術をしている時には、赤っぽく光る演出があります。\n\n彼はヘビースモーカーでもあります。\n\n服装については、参考イラストのディテールを簡略化していただいて構いませんし、もしよければ全く新しい現代風のカジュアルな服装で描いていただいても大丈夫です。描きやすい方でお願いします。\n\n彼のイラストは数点しかないので、参考程度にしていただければと...\n\nXであなたの作品を拝見して以来、ずっと依頼したいと思っていましたので、今回こうしてお願いできる機会をいただけて本当に嬉しいです。どうかご検討いただけますと幸いです。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/14X50_4id2KvD7Ku0bjK--Ln3avcZ2ibC?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@murou_ei/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2873917, "client_id": 3447595, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fed967e9/uploads/origins/68f6dd93-e729-44e2-9621-99f1fd055ef5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a1a3fbeeaf7ce4397799d79bb00a5fc", "srcset": "https://si.imgix.net/fed967e9/uploads/origins/68f6dd93-e729-44e2-9621-99f1fd055ef5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a1a3fbeeaf7ce4397799d79bb00a5fc, https://si.imgix.net/fed967e9/uploads/origins/68f6dd93-e729-44e2-9621-99f1fd055ef5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cde6b6a9598d947736803f32ed6c106c 2x, https://si.imgix.net/fed967e9/uploads/origins/68f6dd93-e729-44e2-9621-99f1fd055ef5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dde6a90dc69cbf47eeccd3b7e6017e7f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fed967e9/uploads/origins/68f6dd93-e729-44e2-9621-99f1fd055ef5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30a7dc0b2c643e6c2eb6fb23592c4119", "srcset": "https://si.imgix.net/fed967e9/uploads/origins/68f6dd93-e729-44e2-9621-99f1fd055ef5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30a7dc0b2c643e6c2eb6fb23592c4119, https://si.imgix.net/fed967e9/uploads/origins/68f6dd93-e729-44e2-9621-99f1fd055ef5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd46ba13c2b05b1987f4dab2aac826ae 2x, https://si.imgix.net/fed967e9/uploads/origins/68f6dd93-e729-44e2-9621-99f1fd055ef5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f3278af79a82b0a467e2139ebcc4b4bf 3x"}, "body": "匿名でしたが以前purpleくんを依頼した者です。\nその際は色気たっぷりでカッコいい最高のpurpleくんをありがとうございました。\n大事に大事に眺めては幸せを感じています。\n本当に素敵です、ありがとうございます。\n\n\n以下依頼文です。\n\n今度はyellowくんがもう一度見たいです！\n↓念の為この子です。\nhttps://bsky.app/profile/eimurou.bsky.social/post/3l6vwkmnvy72a\n\nyellowくんのイタズラっぽいニッとした微笑み、大好きです。\npurpleくんのときと同じように構図などほとんどえいむろうさんにおまかせさせて頂きたいのですが、また１つだけお願いしたいです。\n小物としてサングラスを着けていただけないでしょうか。\n季節外れですみません。（夏っぽくなくて大丈夫です。）\n目にかけてても、頭に乗せてても、服に引っ掛けてても、手に持っていてもかまいません。\nおしゃれメガネをかけているのが可愛かったのでサングラスバージョンが見たいという気持ちです。\nただえいむろうさんの描かれる男子の目力も好きなので、サングラスで目が完全に見えなくなっているのは避けていただけると嬉しいです。\n\nどうかご検討のほどよろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@murou_ei/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5f753cbf/uploads/origins/dec2e820-14ce-4654-9c85-e116d540cd08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8784657bfbc0d1132022e06d96dc304b", "srcset": "https://si.imgix.net/5f753cbf/uploads/origins/dec2e820-14ce-4654-9c85-e116d540cd08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8784657bfbc0d1132022e06d96dc304b, https://si.imgix.net/5f753cbf/uploads/origins/dec2e820-14ce-4654-9c85-e116d540cd08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a1c5f567b13a83045c89197a67b53771 2x, https://si.imgix.net/5f753cbf/uploads/origins/dec2e820-14ce-4654-9c85-e116d540cd08?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b7b39c7034dbc32c064ec0602fea79b3 3x"}, "private": true, "genre": "art", "ti