人でデート中」という感じで、しかも2人が微笑みで楽しそうにしているところを描いてほしいです。\n\n\n可能でしたら宛名とサインはpsdレイヤーでon/offできると嬉しいです。\n日本人ではないので、失礼なことを言ったら申し訳ありません。どうかよろしくお願いします！もし、お気に召さない場合は、キャンセルしても構いませんです。\n金額的に無理でしたら、変更して下っさて構いません\n\nhttps://drive.google.com/drive/folders/1GwFqpSocexm0YLGxAfv_HBt8hd5mdCtI", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ydasige11/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2269930, "client_id": 946151, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ab5d9934/uploads/origins/ea15bcfd-4d78-4461-be97-5e716b4cdfed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51077bb6d6678b9a78a97b4bd0ddab9b", "srcset": "https://si.imgix.net/ab5d9934/uploads/origins/ea15bcfd-4d78-4461-be97-5e716b4cdfed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51077bb6d6678b9a78a97b4bd0ddab9b, https://si.imgix.net/ab5d9934/uploads/origins/ea15bcfd-4d78-4461-be97-5e716b4cdfed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d97386e1730aeca9cbb37a0591543cc 2x, https://si.imgix.net/ab5d9934/uploads/origins/ea15bcfd-4d78-4461-be97-5e716b4cdfed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6cc6edaad4960bd06a66581797ec9124 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ab5d9934/uploads/origins/ea15bcfd-4d78-4461-be97-5e716b4cdfed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=177c0d39b1bcce7ef92307d8d24951a6", "srcset": "https://si.imgix.net/ab5d9934/uploads/origins/ea15bcfd-4d78-4461-be97-5e716b4cdfed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=177c0d39b1bcce7ef92307d8d24951a6, https://si.imgix.net/ab5d9934/uploads/origins/ea15bcfd-4d78-4461-be97-5e716b4cdfed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2