format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=baadd21c15ab7a72c4efbff3d01bb913", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 624345, "client_id": 2874920, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@gurivinesyu/works/244", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 624345, "client_id": 460168, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a12b4896/uploads/origins/0302b54e-8598-4e5a-9d8c-b1e6c15f209b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e58a23049d807b20df69681afff5a088", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a12b4896/uploads/origins/0302b54e-8598-4e5a-9d8c-b1e6c15f209b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da6c884a1ef5dc4132e8ee80c2e202e8", "src_set": ""}, "body": "初めまして、カッキーと申します！\n\n今回、自分のYouTube活動のアバターである照月風葉をリクエストさせていただきます。\n\n以下こちらからの希望になります。\n・衣装は資料にある衣装\n・サムネイル等で使用する為、上と左右が切れないよう描いていただきたいです。\n・同じくサムネイル等で使用する為、背景透過差分があると助かります。\n・この予算で余裕があれば、表情差分(驚き顔、不満顔、等)作っていただけると嬉しいです。\n\n細かい構図などはおまかせします。\nサムネイルで透過差分を使うことが多いと思うので、背景は簡易的なもの、もしくは白背景で問題ありません。\n\nまた、これは不都合がなければですが、Twitterに投稿する場合はメンションを、pixivに投稿する場合は「照月風葉」のタグをつけて投稿していただけるととても喜びます。\n\nお時間ありましたら是非よろしくお願い致します。\n\n【使用用途(主にゲーム配信のサムネイルでの使用が主ですが、他使いそうなものも書かせてもらってます)】\n・YouTubeサムネイル、コミュニティへの投稿\n・各告知(今週のスケジュール等)画像\n・各SNSアイコン、ヘッダー\n・配信内での使用\n\nhttps://x.com/kakki0707/status/1795075064427167848", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gurivinesyu/works/243", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5a329a34/uploads/origins/0d623987-50e7-4f16-a543-e234d8f3ee1b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41fede4b6728b5fc8e64509e57cfbbab", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 624345, "client_id": 2874920, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@gurivinesyu/works/242", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 624345, "client_id": 2282583, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/82890f12/uploads/origins/d7befcd9-963c-4e6d-842e-09fb2380f0bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f332e5a100822018c495e541416ee989", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/82890f12/uploads/origins/d7befcd9-963c-4e6d-842e-09fb2380f0bf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1d89b27d170181426d1d82126012700", "src_set": ""}, "body": "初めまして。\n個人Vtuberのルミア•ローズと申します！\n八代明日華様の絵柄でぜひ私を描いていただきたいと思い、リクエストいたしました！\n\n【希望のイラスト】\n巫女服を着たルミア•ローズ のイラスト\n構図や髪型等もお任せします！\n(神無月の巫女というアニメを同時視聴する際のサムネイルに使用予定です)\n\n【キャラクターについて】\n●設定￤精霊の森の主の妖精。少女のような見た目ですがとても長く生きています。\n●性格￤気まぐれでマイペース。歌を歌ったり、踊ったり、食べるのが好き。\n●容姿￤身長120cm。(羽やティアラは自由に出し入れできるので、無くても大丈夫です！)\n\n【使用用途】 VTuber活動\n・収益化済YouTubeチャンネルでのサムネイルに使用 \n・Xでの告知画像等で使用 \n・ファンクラブ加入者向け特典としての配付\n・ネットプリント(無償)\n\n【その他】\n・背景透過データがあると嬉しいです。\n・可能であれば表情差分があると嬉しいです。\n・八代明日華様の絵柄で自由に描いてください！\n\nご検討よろしくお願いいたします‍！\n\nhttps://drive.google.com/file/d/1mFNz5f3Ui61Hzufe-cqG1ke0sWzQd98u/view?usp=drivesdk", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gurivinesyu/works/241", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 624345, "client_id": 3353371, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/915b4171/uploads/origins/58155f8d-73b3-493a-a0e3-22f4687ef895?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b55d5484bb6068e05f6dd6469020f1f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/915b4171/uploads/origins/58155f8d-73b3-493a-a0e3-22f4687ef895?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=753887000365f1eafa03b21f3c9cd790", "src_set": ""}, "body": "黄色のショートヘアで、ピンクのセーターを着ているOCが欲しい。セーターの真ん中には大きなハートがあるはず。大きなハートの中には1と0があるはず。OCは微笑んでいて、リラックスしているように見えます。また、もし可能であれば、同じような小さなハートをヘアピンのようにつけてほしい。背景は明るく活気のあるものを希望します。\n\nヘアスタイルは参考資料1のような感じにしてほしい。\nセーターのハートの \"1と0 \"は参考資料2に似ていてほしいのですが、数字はもっとまとまりのある配色にしてください。\n\n宛先の名前は「GF」とし、「あり」と「なし」のファイルを1つずつ用意するのが望ましい。\n\n参考画像はAIで申し訳ありませんが、他に良い表現方法が思いつきませんでした。\n\nhttps://drive.google.com/drive/folders/1inreOtoFYZH4Lu8fKsmNgGyGHndQJ7x_?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gurivinesyu/works/240", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 624345, "client_id": 1159318, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c70988a4/uploads/origins/68a17e6d-e592-4128-91e9-19c90cac9b82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea42435e1fd5c7242be415bf2c0f6198", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c70988a4/uploads/origins/68a17e6d-e592-4128-91e9-19c90cac9b82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99a741ce04f3733a1998aad42552d6e9", "src_set": ""}, "body": "こんばんは。\n\nイラストのプレゼントを考えておりまして、\n人物は八代さんも何度か描いておられます仁瀬みすみさんのイラストとなります。\n\nポージング参考がガンダムのキャラクターである東方不敗をイメージして作成してもらえたらと…\n\n・服装はデフォルトの制服\n・足を上げるのでその際の丈などはいい感じで！\n・画角や写る範囲などは参考画像のサクラバクシンオーが好ましいです。\n・表情などはお任せします！多分ノリノリでやってくれるのかな（笑）\n\n上記の内容となります！\n背景はお任せで本人がサムネで使用できるように透過素材をお願いしたく思います。\n\nhttps://drive.google.com/drive/folders/1VNoEiQnpc6CVTdiem4gdp5zoedfdqbaF?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1239771, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "布施龍太⭐︎アニメ「強くてニューサーガ」放送中", "screen_name": "chameleonrock", "avatar_url": "https://pbs.twimg.com/profile_images/1243072639/________.jpg", "header_url": "https://pbs.twimg.com/profile_banners/100000616/1556390769/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "skills": [{"genre": "art"}], "nc": 144}, {"id": 1619895, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "クロユリ@skeb募集中", "screen_name": "SakuraYuki_Lily", "avatar_url": "https://pbs.twimg.com/profile_images/1865355493134503936/GsUbsnxA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1419722656287379471/1747043222/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "novel"}, {"genre": "video"}, {"genre": "correction"}], "nc": 33}, {"id": 1782328, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "Catgrass", "screen_name": "Catgrass00", "avatar_url": "https://pbs.twimg.com/profile_images/1588277090553499648/KBQEWmy4.jpg", "header_url": "https://pbs.twimg.com/profile_banner