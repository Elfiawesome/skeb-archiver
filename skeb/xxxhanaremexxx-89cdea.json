1f0/uploads/origins/0751b83b-2b0f-4d71-9e78-5d587f7ee183?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=935e8d09fd06f58603c6619ffe9b755d", "srcset": "https://si.imgix.net/2a5411f0/uploads/origins/0751b83b-2b0f-4d71-9e78-5d587f7ee183?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=935e8d09fd06f58603c6619ffe9b755d, https://si.imgix.net/2a5411f0/uploads/origins/0751b83b-2b0f-4d71-9e78-5d587f7ee183?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=62b70e6679e660d9075bf2162ac41182 2x, https://si.imgix.net/2a5411f0/uploads/origins/0751b83b-2b0f-4d71-9e78-5d587f7ee183?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=52e794728e8216f2cbcb224813b8a882 3x"}, "body": "はなれめさんのとても素敵な作品にいつも感動している者です。\n岡崎泰葉ちゃん・乙倉悠貴ちゃんのPで、いつかは泰葉ちゃんや乙倉ちゃんをお願いさせていただきたいと思っておりますが、今回は黒埼ちとせちゃんと白雪千夜ちゃんをお願いしたく存じます。\n先日の大阪公演で、お二人が披露された圧巻のパフォーマンス、特にそれぞれのソロ曲で大変感銘を受けまして、その感動を残したく。（特に白雪千夜ちゃんがとても刺さりました）\n\n大阪公演のワンシーンをそのまま再現いただく必要はございません。あの公演での二人の熱量、あるいは感情を感じられるような、はなれめさんならではのシチュエーションや表情ですと嬉しいです。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@xxxhanaremexxx/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1215384, "client_id": 747794, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4841a7b/uploads/origins/c2d60630-3d86-4b24-9f56-b90fca0e7894?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96d291c55f54f7013528f48d10bd4823", "srcset": "https://si.imgix.net/f4841a7b/uploads/origins/c2d60630-3d86-4b24-9f56-b90fca0e7894?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96d291c55f54f7013528f48d10bd4823, https://si.imgix.net/f4841a7b/uploads/origins/c2d60630-3d86-4b24-9f56-b90fca0e7894?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9652d4db25a0dbb83382ecc8