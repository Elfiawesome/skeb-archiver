path": "/@tetikun/works/63", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 62906, "client_id": 553809, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/366b1039/uploads/origins/3397c75f-af85-4154-a365-62405d2b1d08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45c268f876a855f4e933468589d6d0f0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/366b1039/uploads/origins/3397c75f-af85-4154-a365-62405d2b1d08?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=496c103ccbe7c81420b501980d936b71", "src_set": ""}, "body": "個人VTuberの天沢もみじさん(@momi_amasawa)さんのイラストをお願いしたいです。\n白のノースリーブニット姿で、頭の上で手を組んでいるポーズ(いろいろありますが描きやすい形で構いません)でお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tetikun/works/62", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/098c773b/uploads/origins/548a39b2-c865-4d3c-9111-a4ce388d0787?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=741084d77145e4d03dd09ad1e3a89e4b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 62906, "client_id": 2092051, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tetikun/works/61", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 62906, "client_id": 177608, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54f2c45e/uploads/origins/2bda03a0-ce53-499c-b737-a837dea66473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1283c294f2162a8f90227322bce20808", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54f2c45e/uploads/origins/2bda03a0-ce53-499c-b737-a837dea66473?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66ad30c44f3f931a9127a3c63a38f71c", "src_set": ""}, "body": "初めまして、以前よりTwitterにて素敵な\nイラストを拝見させていただいており \n特に光の加減や表情の表現がとても好きで\nぜひ依頼をしたいと思いました。\n\nVライバーの九蘭澪さん(@0kuranmio0)で\n衣装はメイド服で\n下記のリンクでの画像を参考にお願いします。\n（1枚目の右下の衣装）\n手でハートを作っているポーズで\nお願いしたいです。\nハートの作り方はお任せします。\n表情は笑顔の物と\nもし金額の範囲内で可能であれば\n差分で照れ顔も描いて頂けると\nありがたいです。\nそれ以外は特に指定は無いので\nteti様にお任せします。\nあまり具体的でなくすみません。\n（九蘭澪さんは左目元に泣きボクロがありるので参考までに。\n\n本人のアイコン、サムネイル、ネットプリント\n（非商用です）\nでの使用許可も頂けるとありがたいです。\n\nhttps://x.com/0kuranmio0/status/1417465011056746497?t=lZLAqRzHX2YwL8vEs_ypHQ&s=19", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tetikun/works/60", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 62906, "client_id": 2838293, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/33fba314/uploads/origins/2c86a00b-65d8-4c8a-aec3-1bcfa04e816f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7faf7bcf45117c49c921b2f337a7b9ae", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/33fba314/uploads/origins/2c86a00b-65d8-4c8a-aec3-1bcfa04e816f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbb013404319606258e53fd929470a89", "src_set": ""}, "body": "teti先生いつも素敵なイラストありがとうございます。\nまたteti先生にイラストをお願いしたく連絡させていただきました。\n\n描いて欲しいイラストは\n個人VTuberの「赤紫あいく」さんのFAをお願いしたいです。\n\n詳細は\nあいくさんが部屋着姿でストレッチしているところをお願いします。\n部屋着はタンクトップにショートパンツみたいな感じが良いです。\nhttps://images.app.goo.gl/ooKbYKyRFU88s3Xc6\nこんな感じに腕のストレッチしている感じにお願いしたいです。\n変になりそうな場合は変えてもらって大丈夫です。\n髪型はポニテか、お団子みたいな感じが似合いそうなので似合う方でお願いします！\nその他のところはteti先生にお任せ致します。\n可愛く、セクシーな感じに仕上げていただければ幸いです。\n\n使用用途は\nファンアートタグをつけての投稿、また配信活動でのサムネイルやX(旧Twitter)等での投稿で使用される可能性があります。\n\n人物・背景・宛名等がレイヤー分け出来るPSDデータで頂けると有難いです。\n\nお忙しいと思いますが検討の程宜しくお願い御致します。\n\n赤紫あいくさん資料\nhttps://x.com/akashiaiku?s=20\nhttps://youtube.com/@akashiaiku?si=53bId9V33CoO3tHh", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tetikun/works/59", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3fb525b7/uploads/origins/cfd3466b-eedb-46d2-bf58-383a29935ead?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e66513e3d2ade61504efcc157edcfbdb", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 62906, "client_id": 3093901, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tetikun/works/58", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/66907cf2/uploads/origins/10ea78cd-5a21-4790-9fab-4134b22a61dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41ef00339048b497f29535b5716e5c65", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 62906, "client_id": 1011642, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tetikun/works/57", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 62906, "client_id": 2861205, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f27106e5/uploads/origins/9f0735a6-b2e2-4135-ad18-36eb9e34310d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c863853a4a067e373b0d575ca8a6682", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f27106e5/uploads/origins/9f0735a6-b2e2-4135-ad18-36eb9e34310d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b843b296612668bb32560f105ea61d9", "src_set": ""}, "body": "VTuberの本多ぽこと申します\n前回は素敵なイラストを描いていただき本当にありがとうございました…！\n是非またteti様に素敵なイラストを描いて頂けたらと思いリクエストさせて頂きました\n\nお受けいただいた場合、イラストはTwitterのアイコンやヘッダー、\nYouTubeのサムネイルや、チャンネルアート、有料支援サイトのヘッダー等、広報活動に使用させていただきたいと考えております。\n\n【概要】\nYoutubeの配信用サムネイルイラスト　頭の周辺が見切れないように描いて頂けますと助かります\n可能であれば人物と背景を分けたpsdと表情差分を頂きたいです\n金額の範囲内で可能であればよろしくお願いいたします\n\n【立ち絵】\nチャイナ服三面図：https://gyazo.com/b9823a4eadd4ae79dde004c433f4e5dd\n髪型差分一覧：https://gyazo.com/1316bd397ea7daaf575f53764a92cd03 \n髪型の指定は無いので描きやすいものを選んで頂けたらと思います\n\n【構図・ポーズ】\n今回もteti様に全てお任せで描いて頂けたらと思います\n服装や装飾等も描きやすいように変えていただいても問題ありません\n\nご検討のほど、何卒よろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tetikun/works/56", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/688e2b9d/uploads/origins/2a1258cc-ee96-4f00-a0a4-e625afd5b44a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c11eb0cfe8f11fee261482b647bddc2b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 62906, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tetikun/works/55", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 62906, "client_id": 179456, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f2ffc6a/uploads/origins/6f4e2612-8265-4867-8e4b-9115c6c81991?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3209cddc96f96d6534dc9ce7f58ef2dd", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f2ffc6a/uploads/origins/6f4e2612-8265-4867-8e4b-9115c6c81991?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90b4acdcacdf80fb51638804bbc30f86", "src_set": ""}, "body": "声優活動をしております森野めぐむと申します。\n他のクライアント様が依頼しておられたteti様のイラストがとても素敵でしたので、\nぜひご依頼したくリクエストさせていただきました。\n\n依頼内容や使用用途に問題ないようでしたらお受けいただけると嬉しく思います。\nご検討のほどお願い申し上げます。\n\n【サイズ】他のご依頼主様と同様のサイズでお願いします\n\n【使用用途】有料支援サイト、Youtubeサムネ、SNSでの使用、小規模のグッズ使用(現状予定ありませんが可能性として)\n\n【ポーズ・表情】\n画面の向こう側のリスナーさんに向かって内緒話をするように口元に手を添えているイメージ\n\n分身キャラとしてのテーマが「距離感の近い明るい年上のお姉さん(JD-OLさんイメージ)」なので、\nにこやかだったりファンサなどの愛想を感じさせる表情をお願いしたいです。\nhttps://skeb.jp/@tetikun/works/52\nhttps://skeb.jp/@tetikun/works/44\n\n◆イメージ情報\n160cm\nバスト　F-Gくらいの大きめ\n髪はゆるふわパーマ\n前髪とアホ毛の形が「M」\n前髪や下ろした髪などにグラデーションでサーモンピンク系のインナーカラー\n\n【衣装】\n決まった衣装はありませんので、お好きに描いていただいてかまいません。\n一応想定としましては、女子大生～20代前半のお姉さんが着ている可愛くてキレイ・ちょいセクシーな洋服を着せていく予定です。\n\n【描写範囲＆納品形式】\nサムネやアイコンが主な使用用途ですので、髪や頭や体が切れていない状態で描いていただけると大変助かります。\n特にMのアホ毛は画角に収めるのが大変難しいとは思うのですが、\n若干引きで描いていただいて、使用時にトリミングさせていただきたいので、\n納品時は切れていないのが望ましいです…！\n(ややこしいお願いで申し訳ありません）\n\n【キャラクターデザイン】三面図などのわかりやすい資料がなく恐れ入りますが、\n下記Googleドライブにラフなどを置いておりますのでご参考ください。\nhttps://drive.google.com/drive/folders/1qVT9ZPa_ZRtBMYwY9AqE9KL3X741HiiT?u", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tetikun/works/54", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/205c8b21/uploads/origins/f5aca992-f72b-49ae-8b3d-e2cae9d900d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da345398b566843beee184407c13ea92", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 62906, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tetikun/works/53", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 62906, "client_id": 3079302, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/06d62708/uploads/origins/40b057c1-98eb-4d50-aafa-250ead2f0492?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d99aa5c1858a25f61c35c3db8c91b48", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/06d62708/uploads/origins/40b057c1-98eb-4d50-aafa-250ead2f0492?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3da3ce812b412f5708d7771bcf4f2cad", "src_set": ""}, "body": "前回は大変素敵なイラストをありがとうございました！\nまたぜひteti様に私のイメージイラストを描いていただきたく、\nリクエストを送らせていただきます。\n\n【内容】\n・ポーズや構図はお任せ\n・キャラクターの上部と左右が切れていないイラストだと助かります\n\n【使用用途】\n・主にYouTubeでのASMR配信サムネ、配信画面、動画（※収益化済み）\n・SNS（アイコン/ヘッダー/投稿）\n・クリエイター支援サイト投稿記事のサムネなど、活動にて使用させていただきます。\n\n【キャラデザイン】\n以下をご参照ください。\nhttps://www.dropbox.com/s/vc6f1i005mvf79p/%E6%B5%85%E8%A6%8B%E3%82%86%E3%81%84%E3%83%87%E3%82%B6%E3%82%A4%E3%83%B3.png?dl=0\n\n【衣装】\n女神衣装でお願いできればと思っております。\nhttps://www.dropbox.com/scl/fi/hvl3c399qoc28pfrsqdtn/.png?rlkey=doxmyn99vpxuc609rm3ag5z4i&st=9jvi3h3o&dl=0\n\n以上となります。\n条件など合いましたら、どうぞよろしくお願いいたします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tetikun/works/52", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 62906, "client_id": 0, "vtt_url": null, "thumbnail_im