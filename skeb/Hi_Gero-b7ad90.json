ix.net/8e56985a/uploads/origins/d2230c71-e5d3-462e-a431-36b24b37d2ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c2c09fd88ab9a8f8f02e2e521375ac9b 3x"}, "body": "前回はありがとうございました！\n以下のようなイラストを描いていただきたいです。\n\n■人物\n萬弥子\n服装　上の服がYシャツ(色は何でもいいですが、柄話でお願いします)、下は黒ズボンでお願いします。足が映るかどうかはわかりませんが、裸足です。\n\n■イラストの要望\n鼻血、腫れるほどではない痣など軽い外傷(内容はお任せします)があり、Yシャツがはだけてお腹が見えている状態。胸はあまり露出していないのがいいです。\n表情・状態としては少しぐったりしているような、もうろうとしている感じのイラストが見たいです。\n\n宛名については有り無しの差分画像でいただきたいです。\nよろしくお願いいたします。\n\n■資料\nプロフィール\nhttps://drive.google.com/drive/folders/1X8KzzfpNskdya0oBZ3e4hmBBiafcOB95?usp=sharing\n\n参考画像\nhttps://drive.google.com/drive/folders/179QJItE4fWYij8-TIwBJhB-dbKwGjsXb?usp=sharing", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Hi_Gero/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1194663, "client_id": 123509, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/daad78a1/uploads/origins/c1e3b919-b03d-4c58-9a6b-a86043d4e9ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a174570894c456aaf7de9740692871fe", "srcset": "https://si.imgix.net/daad78a1/uploads/origins/c1e3b919-b03d-4c58-9a6b-a86043d4e9ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a174570894c456aaf7de9740692871fe, https://si.imgix.net/daad78a1/uploads/origins/c1e3b919-b03d-4c58-9a6b-a86043d4e9ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2b48e878f1170b71d1f58966c552aea8 2x, https://si.imgix.net/daad78a1/uploads/origins/c1e3b919-b03d-4c58-9a6b-a86043d4e9ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6744114a21196f56172eeab562f0acd2 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/daad78a1/uploads/origins/c1e3b919-b03d-4c58-9a6b-a86043d4e9ff?bg=%23fff&auto=format%