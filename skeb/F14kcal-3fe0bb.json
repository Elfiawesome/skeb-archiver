et/0125a34b/uploads/origins/d2eba039-9933-4971-b1fe-e1c317b40f40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d59336814ad0a88252f74023f12ed99", "srcset": "https://si.imgix.net/0125a34b/uploads/origins/d2eba039-9933-4971-b1fe-e1c317b40f40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d59336814ad0a88252f74023f12ed99, https://si.imgix.net/0125a34b/uploads/origins/d2eba039-9933-4971-b1fe-e1c317b40f40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4c3cc3403e0939d35f3e37a9f74b77c 2x, https://si.imgix.net/0125a34b/uploads/origins/d2eba039-9933-4971-b1fe-e1c317b40f40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e5e7503d410efa786c5d5439459b6d1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0125a34b/uploads/origins/d2eba039-9933-4971-b1fe-e1c317b40f40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd745feeabe17421cac3c2ec0ae8c9a2", "srcset": "https://si.imgix.net/0125a34b/uploads/origins/d2eba039-9933-4971-b1fe-e1c317b40f40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd745feeabe17421cac3c2ec0ae8c9a2, https://si.imgix.net/0125a34b/uploads/origins/d2eba039-9933-4971-b1fe-e1c317b40f40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c71a336ee1494bde0d760c4097313793 2x, https://si.imgix.net/0125a34b/uploads/origins/d2eba039-9933-4971-b1fe-e1c317b40f40?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8781191aa1ad9f1b6c118aac08e3aa86 3x"}, "body": "はじめまして！ \nアピールありがとうございます☺️\n個人V Liverのせせりと申します。\nkaro様の作品を拝見しまして、ぜひ立ち絵のご依頼がしたいと思いご連絡しました！\nskebを初めて間もないので不慣れな事も多いのですが、スムーズにやり取りができるよう心がけていきたいと思いますので宜しくお願いいたします！\n\n🌼キャラクターの特長\n•キャラコンセプト：明るい、元気で可愛らしい、赤ずきん、メルヘン、お花\n•髪色:少し栗色かかった茶髪\n•髪型:ゆるめ三つ編みおさげ\n• 瞳:黄緑色、目の中に鈴蘭\n•目の形:やや丸目\n•小物類:丸メガネ（左端に花の飾り）、左眼下に涙黒子、右頬に白いマーガレット（散った花びら部分は描かなくてOK）、鳥と鈴蘭のピアス、狐耳、狐尻尾（参考資料のものは狼尻尾ですが、狐尻尾に描き変えて欲しいです）\n\n•備考：一部資料にある、鈴蘭を背負ったものがデフォルトアバターになっています。（システム上 同時に鈴蘭と尻尾をつけられないため、イラスト依頼の時のみ尻尾足してもらっています）。背負い鈴蘭とリボン鳥のモチーフは、絵の構図に組み込めそうであれば入れていただけると幸いです。優先順位低めで大丈夫です。\n\n🌼構図：キャラコンセプトに合ったものだと嬉しいです☺️\n\n🌼使用用途：SNSに投稿、ファンボックスでリスナーさんに公開\n\n初めての立ち絵依頼でとても楽しみです☺️\nよろしくお願い致します(❁ᴗ͈ˬᴗ͈)⁾⁾⁾\n\nhttps://drive.google.com/drive/folders/1iM-E029m3ebxrWz2jUQI3MLQa7fdmw9A", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@F14kcal/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1798309, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5d9d032/uploads/origins/76880660-8c00-4f93-abaf-434c9bcf3eb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92f1acab0abeee9b106f1eb9f618f2d7", "srcset": "https://si.imgix.net/d5d9d032/uploads/origins/76880660-8c00-4f93-abaf-434c9bcf3eb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92f1acab0abeee9b106f1eb9f618f2d7, https://si.imgix.net/d5d9d032/uploads/origins/76880660-8c00-4f93-abaf-434c9bcf3eb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e2a568c621322afe5d604ea5eff16027 2x, https://si.imgix.net/d5d9d032/uploads/origins/76880660-8c00-4f93-abaf-434c9bcf3eb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6deeed42df89fd99b7b9e1654e5cc491 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5d9d032/uploads/origins/76880660-8c00-4f93-abaf-434c9bcf3eb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=badbc549d6bd4925b6cbcdf2ae83d895", "srcset": "https://si.imgix.net/d5d9d032/uploads/origins/76880660-8c00-4f93-abaf-434c9bcf3eb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=badbc549d6bd4925b6cbcdf2ae83d895,