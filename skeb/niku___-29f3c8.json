配信等のサムネイルでの使用を主に考えておりますので、可能であればウエストアップ～バストアップで頭の見切れがないものが嬉しいです。(資料参照)\n\n●構図など\nもし可能であればクイズやお勉強配信のサムネイルに使用したいので\n眼鏡をかけていたり、勉強している風のイラストだと嬉しいです。\n\n●使用用途：\n(1)YouTube/Twitchでの使用(サムネイル、蓋絵、OP/EDなど)\n(2)配信活動での使用(各種SNSでの使用)\n※イラストに直接加筆は絶対に致しませんが、使用する際に文字や加工が被ってしまう可能性があります。\n\n●納品形式\n人物が透過されたPSD、またはpngデータを頂けますと幸いです。\n\n●備考\n下記データを参考に描いていただけますと幸いです。\nhttps://drive.google.com/drive/folders/1DuGSzE0VlylCsAnkDIQl60m94lQs0wCr?usp=drive_link\n\n\n※本文に記載したすべての内容は、駅下さまのご都合によりすべて変更してくださって問題ありません。\nもしご縁がありましたらよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1DuGSzE0VlylCsAnkDIQl60m94lQs0wCr?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@niku___/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3911433, "client_id": 2413787, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c5c5815/uploads/origins/6b9420ef-f14d-41e6-beea-cb5717c73f53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c135fc3e4772c33080c2ad0d5ecdd35c", "srcset": "https://si.imgix.net/0c5c5815/uploads/origins/6b9420ef-f14d-41e6-beea-cb5717c73f53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c135fc3e4772c33080c2ad0d5ecdd35c, https://si.imgix.net/0c5c5815/uploads/origins/6b9420ef-f14d-41e6-beea-cb5717c73f53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44123553ad0ac6a25b5f61d4a72fa7e3 2x, https://si.imgix.net/0c5c5815/uploads/origins/6b9420ef-f14d-41e6-beea-cb5717c73f53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c61625f698801a03c9940511a69a47b5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c5c5815/uploads/origins/6b9420ef-f14d-41e6-beea-cb5717c73f53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4dc45a7880921f2293c82bb6471cacf", "