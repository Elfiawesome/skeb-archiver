8b34b3c1-e1d1-44c4-84c4-6fbaae2a1e49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63305ab818f92a48036ef30b27ac8786, https://si.imgix.net/c73fcff7/uploads/origins/8b34b3c1-e1d1-44c4-84c4-6fbaae2a1e49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=40caba4dd05aa8882a7fcab1ed72dc5a 2x, https://si.imgix.net/c73fcff7/uploads/origins/8b34b3c1-e1d1-44c4-84c4-6fbaae2a1e49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=745be8b825bf22fc17dca5ef83776a85 3x"}, "body": "ななし先生、こんにちは。先生の「ひふみちゃん」がとても気に入ったので、また作品をお願いします。ブルーアーカイヴのアキラ（清澄アキラ）が3人の変態ショタに犯されている。誰が彼女を妊娠させることができるか、交代しているのです（できれば、台詞にそのことを書いてください）。\n\nアキラの服は引き裂かれ、胸と腹が露わになる。一人目のショタの手は、彼女を犯しながら腰に当てている。二人目のショタは横で、彼女の胸をつかみながらディープキスをしている。三人目は手コキを強要している。その他、詳細はあなた次第。\n\nよろしくお願いします！", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nanashi2059063/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2971362, "client_id": 2928790, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/534c4cf8/uploads/origins/98344b35-80a6-4cbe-8d91-e636b3513bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6155fea263778224477984f7fcf56f50", "srcset": "https://si.imgix.net/534c4cf8/uploads/origins/98344b35-80a6-4cbe-8d91-e636b3513bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6155fea263778224477984f7fcf56f50, https://si.imgix.net/534c4cf8/uploads/origins/98344b35-80a6-4cbe-8d91-e636b3513bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e8581ce273afb4f0204da7908238e06 2x, https://si.imgix.net/534c4cf8/uploads/origins/98344b35-80a6-4cbe-8d91-e636b3513bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6591de8964613d53f171534b0d7325f4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/534c4cf8/uploads/origins/98344b35-80a6-4cbe-8d91-e636b3513bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=738d22b6ef12d170290a26a44ccbdaaf", "srcset": "https://si.imgix.net/534c4cf8/uploads/origins/98344b35-80a6-4cbe-8d91-e636b3513bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=738d22b6ef12d170290a26a44ccbdaaf, https://si.imgix.net/534c4cf8/uploads/origins/98344b35-80a6-4cbe-8d91-e636b3513bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d90e12d6aa5d042f2c4449f87a17cd21 2x, https://si.imgix.net/534c4cf8/uploads/origins/98344b35-80a6-4cbe-8d91-e636b3513bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1b999c4fa51fb0825e6f3501ad3a801a 3x"}, "body": "ショタおねイラストに惹かれました。\nリクエストさせていただきます。\n\n【キャラクター】\n七神リン(ブルーアーカイブ)\n衣装は通常立ち絵でお願いします。\n\n【シチュエーション】\n職務中にショタからエッチをせがまれるリンをお願いします。\n\n【構図】\n・リンはメガネをクイっと直すポーズです。\n・ショタはリンの足下にくっついて、股に手を入れて手マンをしています。\n・リンはクールな表情でありながら、エッチへの期待で頬を赤くさせて欲しいです。\n\n【差分】\n可能でしたら、同じ構図でリンの衣服が乱れてコンドームを腰蓑のように付けられている、事後のNTR差分をお願いします。\n\n【台詞】\nリン「了解しました、時間調整をしますのでいつもの休憩室で待っていてください」\n「それとリンちゃんと呼ばないでください」\n\n事後\nリン「先生、本日の業務は滞りなく終了しました♡それでは失礼しますね」\n\nショタの台詞はお任せでよろしくお願いします。\nリンの台詞も変えていただいても大丈夫です。\n\n以上となります。\nよろしければご検討の程よろしくお願い致します。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nanashi2059063/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2971362, "client_id": 166544, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/45374f94/uploads/origins/ee7b3c30-8a72-421f-b927-1c9d216b49cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=630cba4a8523b9589ae0b166c19f3b47", "srcset": "https://si.imgix.net/45374f94/uploads/origins/ee7b3c30-8a72-421f-b927-1c9d216b49cf?bg=%23fff&auto=format%2Ccomp