gins/e54be1f3-924a-4c16-bc90-b2fdeb3f4a7a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=99c7259458768aae20593f529be66377 3x"}, "body": "初めまして。\nイラストを見せていただき、お願いをできれば、と思いました。\nテーマがかぶって申し訳ないのですが「アスラ斬魔伝の羅刹」コスチュームのリムルルの「素手格闘シーン」です。\n相手は緋雨閑丸でお願いします。衣装は最新作または斬紅郎無双剣、どちらでも大丈夫です。\n二人とも１Pカラーでお願いします。\n\n2コマ漫画風にお願いって出来ますでしょうか？\n1コマ目\nリムルルのとどめの一撃（ひじ打ちか膝蹴りか蹴り）が閑丸のみぞおちに決まるシーン。\nリムルル「えいっ！」\n閑丸「うっ！うぅ…。」\n\n2コマ目\n倒れている、または崩れ落ちている閑丸の目の前で勝ちポーズのリムルル。\n閑丸「負けられないのに…」\nリムルル「えへへっ♪あたしの勝ち！」\n\nという感じでお願いできればと思います。\n真剣勝負というよりはちょっとした鍛錬のような平和な空気でお願いできればと思います。\n以上、ご検討いただけますと嬉しいです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kozuka_docoro/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 794134, "client_id": 1857049, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/88718d66/uploads/origins/999f79db-d547-4bb8-b2b8-9c90079183a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfab781913cc610731a6509236061357", "srcset": "https://si.imgix.net/88718d66/uploads/origins/999f79db-d547-4bb8-b2b8-9c90079183a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfab781913cc610731a6509236061357, https://si.imgix.net/88718d66/uploads/origins/999f79db-d547-4bb8-b2b8-9c90079183a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7bad21cae192ceee22d882ddc38d624a 2x, https://si.imgix.net/88718d66/uploads/origins/999f79db-d547-4bb8-b2b8-9c90079183a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c9931c11840eb9832ab4ad329c55a70 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/88718d66/uploads/origins/999f79db-d547-4bb8-b2b8-9c90079183a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71ff610697ffe1dcca12f7eb43b960f2", "srcse