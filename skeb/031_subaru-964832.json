ってみたいな...！ということでまたリクエストを送らせて頂きました！\n\nもしよろしければ、秋か冬のぼくを描いていただきたいです…！！\n秋だったらあたまのはっぱがもみじやイチョウになってたり…！鼻先にはっぱがふれたり...！！\n冬だったらふわもこ手ぶくろしたたぬ吉だったり…！！\nあくまで例なのでこういうのよさそう！があれば秋冬からぜんぜんちがうのとか、イベントとか、すきに描いていただいてかまわないです！\nたぬ吉のSNSなど本垢やサブ垢のプロ画やヘッダー\n配信サイトでの使用等VTuber活動で活用させていただく可能性がございます…！！\n\n条件などむずかしければキャンセルしていただいてかまいません！\nここまで読んでいただきありがとうございました…！！\nもしよろしければおねがいします…！！\n\nhttps://drive.google.com/drive/folders/1CKApritYcX926zx5vFZ1DtoBfCglm6TW", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@031_subaru/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 115095, "client_id": 2502171, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a39c069/uploads/origins/7c519ad1-6be6-4358-9f45-cd47ae28ce20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=528c2a4e718ca8c3d8e054cbcb0c6f56", "srcset": "https://si.imgix.net/4a39c069/uploads/origins/7c519ad1-6be6-4358-9f45-cd47ae28ce20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=528c2a4e718ca8c3d8e054cbcb0c6f56, https://si.imgix.net/4a39c069/uploads/origins/7c519ad1-6be6-4358-9f45-cd47ae28ce20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a0a21fb6fcc54ca64e2c986dec177d8 2x, https://si.imgix.net/4a39c069/uploads/origins/7c519ad1-6be6-4358-9f45-cd47ae28ce20?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e973c1acefdc2d83be5ca8f6f2f0509c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4a39c069/uploads/origins/7c519ad1-6be6-4358-9f45-cd47ae28ce20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=169ad2b153417498bd1f057219c1ec83", "srcset": "https://si.imgix.net/4a39c069/uploads/origins/7c519ad1-6be6-4358-9f45-cd47ae28ce20?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200