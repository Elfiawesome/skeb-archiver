Dファイルがあれば最高ですが、なくても構いません。\nサインがある場合は、私の試験がうまくいくようお祈りいただければ大変嬉しく思います。なくても構いません。\n\n言語の問題で表現が不適切な点があるかもしれませんが、何卒ご容赦ください。お互いの意図を誤解することのないよう、心から願っています。\n\n本当に、本当にあなたの作品が大好きです。このプラットフォームであなたと出会えたことを光栄に思います。ここまでお読みいただきありがとうございます。改めて、私の敬愛の念をお伝えします。\n\nhttps://drive.google.com/drive/folders/1hjUdNmLAsbW_SDsyagq9LOwSBMzw31kU", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1222785, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "竹花ノート🎍C108・15日(土)・西め21b", "screen_name": "nano_phan", "avatar_url": "https://pbs.twimg.com/profile_images/1377485491273015301/EexBM1db.jpg", "header_url": "https://pbs.twimg.com/profile_banners/595473140/1627735524/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 1596329, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "もりを", "screen_name": "snow_morio3", "avatar_url": "https://pbs.twimg.com/profile_images/2031921489931550720/wfwW6Vtg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/825217158430892032/1784339214/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 7, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 2034307, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "∴", "screen_name": "there_4e", "avatar_url": "https://pbs.twimg.com/profile_images/1534546869149630465/hvUMVmiJ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1510956801407451141/1681828230/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "