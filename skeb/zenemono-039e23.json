=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f1b89884523728cdaf0a5830690717b1 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 119465, "nc": 48}, {"path": "/@zenemono/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 119465, "client_id": 3624632, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ccca84d1/uploads/origins/c2d5f32c-7678-4eca-851a-948edebf9ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=090a02d34d3e4e6cf1a43e16cc5fc1a9", "srcset": "https://si.imgix.net/ccca84d1/uploads/origins/c2d5f32c-7678-4eca-851a-948edebf9ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=090a02d34d3e4e6cf1a43e16cc5fc1a9, https://si.imgix.net/ccca84d1/uploads/origins/c2d5f32c-7678-4eca-851a-948edebf9ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=efc85a1388c34401a0669c44d633c0cc 2x, https://si.imgix.net/ccca84d1/uploads/origins/c2d5f32c-7678-4eca-851a-948edebf9ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6dac864c0983520c255ab65130c5f4e1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ccca84d1/uploads/origins/c2d5f32c-7678-4eca-851a-948edebf9ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0973b2e2b320482b4640f170da4d96f3", "srcset": "https://si.imgix.net/ccca84d1/uploads/origins/c2d5f32c-7678-4eca-851a-948edebf9ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0973b2e2b320482b4640f170da4d96f3, https://si.imgix.net/ccca84d1/uploads/origins/c2d5f32c-7678-4eca-851a-948edebf9ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ecf4b001d3530af03416923b16941016 2x, https://si.imgix.net/ccca84d1/uploads/origins/c2d5f32c-7678-4eca-851a-948edebf9ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3b5c85a5880c50c65322afd6041e261a 3x"}, "body": "ゼネモ様 \n\nいつも素敵なイラストをありがとうございます。 \n\nもし内容が金額に見合わないと感じられた場合は、再送いただけますと幸いです。ご都合が難しいようでしたら、キャンセルしていただいて問題ございません。  \n\nご検討いただければ嬉しく思います。\n\n  ◾️キャラクター：ツヴァイちゃん \n\n ◾️シチュエーション \n\n・両手を上に拘束されている状態で、攻め手が彼女のへその前に人差し指を構える 。\n\n ・後ろから別の人間に体を押され身を捩って抵抗するも、力に抗えずお腹が指に近づき、へそにずぶずぶと入っていってしまう。  \n\n・突然指が動き、前と後ろから限界まで押され、一際大きい声が出てしまい、そのまま底の皺をぐりぐりと撫でられてしまう。  \n\n◾️お腹が指に近づくにつれ「そんなにほじってほしいのか？」のような、まるで彼女が自らへそを差し出してきているかのようなニュアンスの言葉責めがあると嬉しいです。  \n\n・指が底まで入っていく時、真横からの視点を入れていただけると嬉しいです。  \n\n・そのほかの描写やセリフに関しては、ゼネモ様にお任せいたします。  \n\n・責め手の描写なども最低限で大丈夫です  。\n\nよろしくお願いいたします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zenemono/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5b55272b/uploads/origins/26dac7d8-1bcf-42dc-9546-d52cc41cb618?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad96f0369ead540ead472e68df9ee1aa", "srcset": "https://si.imgix.net/5b55272b/uploads/origins/26dac7d8-1bcf-42dc-9546-d52cc41cb618?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ad96f0369ead540ead472e68df9ee1aa, https://si.imgix.net/5b55272b/uploads/origins/26dac7d8-1bcf-42dc-9546-d52cc41cb618?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fcd74bf58632e1d2d8288e6163d4613e 2x, https://si.imgix.net/5b55272b/uploads/origins/26dac7d8-1bcf-42dc-9546-d52cc41cb618?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a5cfb85