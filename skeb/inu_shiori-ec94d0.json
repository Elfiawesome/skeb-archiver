しいです！\n\nぜひまたイラストを依頼させていただきたいです。私のVTuberは、人々を幸せにするのが大好きなドルイドの森林レンジャーです。今回のイラストでは、自然の中で何かをしている姿を描いていただけないでしょうか。木の下で横になっている、湖のほとりに座っている、花畑に座っている、といった感じのシーンで構いません。髪型は自由にお任せします。短いおさげ、花をあしらった三つ編み、あるいは長くたなびく髪など、お好きなスタイルで結構です。 \n\nマスコットのバークも、もし可能であればイラストに何らかの形で描いていただけると嬉しいです。\n\nVTuberの顔のそばかすにもご注意ください。\n\n参考画像はこちらです：https://imgur.com/a/gTJgF93\n\nよろしくお願いします！\n\nhttps://imgur.com/a/gTJgF93", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inu_shiori/works/105", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1102656, "client_id": 3500701, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3270838c/uploads/origins/d8406e0e-9c64-4783-9a79-44104af0e712?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=648a5295e4d53cc79e22e47d7ee08f28", "srcset": "https://si.imgix.net/3270838c/uploads/origins/d8406e0e-9c64-4783-9a79-44104af0e712?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=648a5295e4d53cc79e22e47d7ee08f28, https://si.imgix.net/3270838c/uploads/origins/d8406e0e-9c64-4783-9a79-44104af0e712?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c91c6adaeb1559bfcdebe6b0c95e6841 2x, https://si.imgix.net/3270838c/uploads/origins/d8406e0e-9c64-4783-9a79-44104af0e712?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=687f6584a0f1fa3074d4ea00d3df11df 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3270838c/uploads/origins/d8406e0e-9c64-4783-9a79-44104af0e712?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12c93ed4b8a9a6332d0382c2dcf6ac38", "srcset": "https://si.imgix.net/3270838c/uploads/origins/d8406e0e-9c64-4783-9a79-44104af0e712?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12c93ed4b8a9a6332d0382c2dcf6ac38, https://si