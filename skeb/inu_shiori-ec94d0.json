ん)\n・正面から見て左側口元に黒子\n・青のショートウルフ(インナー水色)\n・水色ノースリーブセーラー(基本ベース)\n・海月モチーフ\n\n【その他希望】\n・構図や雰囲気、表情、服装はイメージにそってお任せいたします。\n・人物、背景を分けたデータで納品いただけると大変助かります。\n・小物や毛先は描写範囲に収めてください。\n・その他好きなイメージ\n└海、夏、鯨等海獣\n\n【使用用途】\n・X等各種SNS、収益化予定の配信アプリやYouTubeでの使用\n(使用の際は概要欄等にXアカウントをクレジットさせていただきます。)\n・グッズ、デジタルグッズ等商用利用\n\nご検討の程、よろしくお願いいたします。\n金額等不備がございましたらキャンセルくださいませ。\n\nhttps://drive.google.com/drive/folders/1D7Elhp0xaoqCMJ-kZtQo4Vs_fx7mwWcX", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@inu_shiori/works/95", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b3524145/uploads/origins/27ffc133-2e07-48f3-afa2-ed3211be9efa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6c906f724ff4290e52fff1b5a6c3e7c", "srcset": "https://si.imgix.net/b3524145/uploads/origins/27ffc133-2e07-48f3-afa2-ed3211be9efa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6c906f724ff4290e52fff1b5a6c3e7c, https://si.imgix.net/b3524145/uploads/origins/27ffc133-2e07-48f3-afa2-ed3211be9efa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=602f924429cbe25cd465e6d9ea0653c7 2x, https://si.imgix.net/b3524145/uploads/origins/27ffc133-2e07-48f3-afa2-ed3211be9efa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba3fd380bf77c3f2151af6fb5f17a328 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1102656, "client_id": 3176754, "nc": 145}, {"path": "/@inu_shiori/works/94", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1102656, 