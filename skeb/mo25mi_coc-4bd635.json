m=webp&fit=crop&crop=top&w=200&h=200&s=4dfb23bc436a624efd26f7f210b0e3bb, https://si.imgix.net/73970aca/uploads/origins/9514975b-e844-4332-b651-100ebcd1246a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f69902d13acdc75cd811e1f1fdae769 2x, https://si.imgix.net/73970aca/uploads/origins/9514975b-e844-4332-b651-100ebcd1246a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a71ef9274d51d8a61fcaec8728a480f3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/73970aca/uploads/origins/9514975b-e844-4332-b651-100ebcd1246a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c0e81159af00a28bf8a4c8d8edcbafd", "srcset": "https://si.imgix.net/73970aca/uploads/origins/9514975b-e844-4332-b651-100ebcd1246a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c0e81159af00a28bf8a4c8d8edcbafd, https://si.imgix.net/73970aca/uploads/origins/9514975b-e844-4332-b651-100ebcd1246a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c41888c6c960c386f9977ddcca573290 2x, https://si.imgix.net/73970aca/uploads/origins/9514975b-e844-4332-b651-100ebcd1246a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=320ffea4a8b65703ef496a3ede350c8a 3x"}, "body": "はじめまして！\n先生の絵柄が大好きでして、ぜひ私と友人のキャラクターを描いていただきたくリクエストさせていただきました！\n\n内容についてですが、TRPGシナリオの探索者(OC)2人をお願いしたいです。\n\n以下、キャラクターの説明になります。\n容姿についてはリンク先の資料を見ていただければと思います。\n(リンク先、依頼文ともにネタバレはありません)\n\n────\n\n✦大廻 慧汰（先輩）\n\n怪奇事件を専門に扱う事務所の所長。\n口が悪くぶっきらぼうで、後輩に対しても遠慮のない態度を取る。負けず嫌いなところもあり、ゲームで負けると勝つまで付き合わせようとするような大人気ない一面もある。\n\n一方で仕事に対しては真面目で、危険な場面では状況を冷静に判断し、後輩にも細かく指示を出すタイプ。\n霊感が強く、普通の人間には見えない霊を認識できる。怪異への知識も豊富。\n\n後輩には雑な扱いをしつつも、危険があれば咄嗟に止めたり気にかけたりと、面倒見はいい。\n\n\n✦纐纈 紫呉（後輩）\n\n大廻の事務所で働いている後輩。\n普段は飄々としていて、やや気の抜けた話し方をする。口数も多めで、先輩相手にも軽口や文句を遠慮なく言うタイプ。\n\n面倒事や疲れることはなるべく避けたがるところがあり、仕事中でも隙あらば休もうとする。ただし金銭には割と素直で、給料分は働くという意識はしっかりある。\n\n普段の態度に反して、いざ危険な状況になれば真面目に仕事をするタイプ。\n刀を扱うことができ、力仕事や戦闘では大廻より前に出ることも多い。\n\n霊感はなく霊を見ることはできないため、その辺りは大廻を頼りにしている。\n普段は仮面を着けて生活している。\n\n────\n\n\n恋愛関係ではありません。\n\n\n\n具体的な構図や二人のポーズなどはお任せします。\n\n金額など不備がありましたら再送して頂けると幸いです\n\nhttps://drive.google.com/drive/folders/13xMKcVmUAMwj8o1jagh13VopVct2X5YS", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 193087, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "アオイシカク | 青井芝画", "screen_name": "Ao_4kaku", "avatar_url": "https://pbs.twimg.com/profile_images/1366347812649111555/_cp-8q3b.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1006841860554289155/1644461221/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 128}, {"id": 2694773, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ごみん🫧", "screen_name": "530_Il", "avatar_url": "https://pbs.twimg.com/profile_images/2065855774275039232/tjBARmSe.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1596047132007763968/1776269302/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 3104729, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "森は生きている", "screen_name": "BOLSTUMP", "avatar_url": "https://pbs.twimg.com/profile_images/1129472127/____.png", "header_url": "https://pbs.twimg.com/profile_banners/39969742/1767797297/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_mas