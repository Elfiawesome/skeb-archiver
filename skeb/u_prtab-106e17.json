稿に使用させていただけたらと思います\nそのためキャラクターのみなど差分が含まれるpsdファイルをいただけますと幸いです\nまた他の素材と組み合わせたりする可能性もございます(いわゆるおはようvtuberタグへの投稿)\n\n以上となります\nお忙しいところ恐縮ですが、ご検討いただけますと幸いです\nよろしくお願いいたします", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@u_prtab/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3055005, "client_id": 3732954, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e5bf44cb/uploads/origins/d3da0497-3649-4e7f-9443-0beeeecbde06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5085881c9784e4a712a4dd66cd2cfea4", "srcset": "https://si.imgix.net/e5bf44cb/uploads/origins/d3da0497-3649-4e7f-9443-0beeeecbde06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5085881c9784e4a712a4dd66cd2cfea4, https://si.imgix.net/e5bf44cb/uploads/origins/d3da0497-3649-4e7f-9443-0beeeecbde06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad299d2168671d94a0941cef416a4016 2x, https://si.imgix.net/e5bf44cb/uploads/origins/d3da0497-3649-4e7f-9443-0beeeecbde06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1786b0bcc2dd9d47b5680590108ea3e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e5bf44cb/uploads/origins/d3da0497-3649-4e7f-9443-0beeeecbde06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84dbd36b3b14c60b9edd553d941ff9be", "srcset": "https://si.imgix.net/e5bf44cb/uploads/origins/d3da0497-3649-4e7f-9443-0beeeecbde06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84dbd36b3b14c60b9edd553d941ff9be, https://si.imgix.net/e5bf44cb/uploads/origins/d3da0497-3649-4e7f-9443-0beeeecbde06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8251e3c70fc1d4aa5aaa01dd8b63878f 2x, https://si.imgix.net/e5bf44c