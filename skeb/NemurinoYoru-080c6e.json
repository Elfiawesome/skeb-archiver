に暗すぎない感じでお願いいたします。\n\n前回同様、構図、表情等その他不明点は全てお任せいたします。アレンジも歓迎です。\nサイズは横長の16：9の比率で、人物のみ・背景のみでも使用できるように背景等とキャラクターを分けたデータをいただけるとありがたく存じます。\n（また、まだ予定は未定ですが、もしかしたら将来的に部屋の内装をlive2dで動かす可能性がございます。NGの場合はPDF内にご記載いただけますと幸いです。）\n\nご検討いただけますと幸いです。\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1iUqt9Fpj48YBJVYsL_RTyTuMZLuXEICz?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@siki_MHR/works/133", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1738259, "client_id": 2262537, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f48cc715/uploads/origins/786e53ce-a891-4256-9777-d16eaea46e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4362e744e9d29fd05fd22e64e8a8c32", "srcset": "https://si.imgix.net/f48cc715/uploads/origins/786e53ce-a891-4256-9777-d16eaea46e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4362e744e9d29fd05fd22e64e8a8c32, https://si.imgix.net/f48cc715/uploads/origins/786e53ce-a891-4256-9777-d16eaea46e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5a1f73bce1fddbefc076330e3888c15 2x, https://si.imgix.net/f48cc715/uploads/origins/786e53ce-a891-4256-9777-d16eaea46e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84fdd328f858c2cc026223d210ae9731 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f48cc715/uploads/origins/786e53ce-a891-4256-9777-d16eaea46e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f37a16c3f0b8d7e0982a264126d35322", "srcset": "https://si.imgix.net/f48cc715/uploads/origins/786e53ce-a891-4256-9777-d16eaea46e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f37a16c3f0b8d7e0982a264126d35322, https://si.imgix.net/f48cc715/uploads/origins/786e53ce-a8