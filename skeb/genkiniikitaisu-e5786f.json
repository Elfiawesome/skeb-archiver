ive/folders/1-VcMe74rRsNdllaMMigps7VKBKlUaecn?usp=sharing\nバトルや日常など、どんなシーンでも自由に描いてください！あなたの想像力を存分に発揮してください。\n\nまた、彼らの前世の物語も以下にリンクされています。\nhttps://drive.google.com/drive/folders/1ZcEnw4JKAKjpbL2oP8kyN0_KcH90_kcX?usp=sharing\n\n本当にありがとうございました！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@genkiniikitaisu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2760711, "client_id": 667554, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5ce0146d/uploads/origins/84514b73-380f-4009-87be-e011b52243cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7115cac91454211a7847efc574c70c41", "srcset": "https://si.imgix.net/5ce0146d/uploads/origins/84514b73-380f-4009-87be-e011b52243cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7115cac91454211a7847efc574c70c41, https://si.imgix.net/5ce0146d/uploads/origins/84514b73-380f-4009-87be-e011b52243cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=57dae3a45fe08578c54dd49a6aea755a 2x, https://si.imgix.net/5ce0146d/uploads/origins/84514b73-380f-4009-87be-e011b52243cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=713f8e648be622c93b457b059bf1aa13 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5ce0146d/uploads/origins/84514b73-380f-4009-87be-e011b52243cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23c5092d9c7f746c267718e6a87cc8fb", "srcset": "https://si.imgix.net/5ce0146d/uploads/origins/84514b73-380f-4009-87be-e011b52243cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23c5092d9c7f746c267718e6a87cc8fb, https://si.imgix.net/5ce0146d/uploads/origins/84514b73-380f-4009-87be-e011b52243cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&