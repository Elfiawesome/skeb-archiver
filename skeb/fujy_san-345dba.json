TXXVA&s=09", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fujy_san/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 625380, "client_id": 1007291, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/43516570/uploads/origins/7103bac9-7d22-4bd5-9328-a1583d06684e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e05d66cbd4bf0f3343611b3aeeefe0e", "srcset": "https://si.imgix.net/43516570/uploads/origins/7103bac9-7d22-4bd5-9328-a1583d06684e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e05d66cbd4bf0f3343611b3aeeefe0e, https://si.imgix.net/43516570/uploads/origins/7103bac9-7d22-4bd5-9328-a1583d06684e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe21f828d7129d89306c5d83622f3aa4 2x, https://si.imgix.net/43516570/uploads/origins/7103bac9-7d22-4bd5-9328-a1583d06684e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f538be1926247afe1aff46212e0df5a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/43516570/uploads/origins/7103bac9-7d22-4bd5-9328-a1583d06684e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24ac03fb8b5045d9306e1a06a177f72c", "srcset": "https://si.imgix.net/43516570/uploads/origins/7103bac9-7d22-4bd5-9328-a1583d06684e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24ac03fb8b5045d9306e1a06a177f72c, https://si.imgix.net/43516570/uploads/origins/7103bac9-7d22-4bd5-9328-a1583d06684e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=95acf7231f18bd41807f8a83562ca9f2 2x, https://si.imgix.net/43516570/uploads/origins/7103bac9-7d22-4bd5-9328-a1583d06684e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c67f2d221fc7647a7664d75155c35cc6 3x"}, "body": "以前は素敵な高森藍子ちゃんを頂きまして本当にありがとうございました。そこで同様のシチュエーションで再びリクエストさせて頂きたく今回リクエスト致します。\n\nモデルはアイドルマスターシンデレラガールズの五十嵐響子ちゃん。\n全裸でモブ男に両脚をまっすぐ立てたV字開脚の状態で抱え上げられ、立位で前後の穴に同時挿入させてください。\n両手でピースサインを出し、満面の笑顔を見せて状況を楽しんでいる様子を表現してもらいたいです。\n胸および前の結合部が見える状態の角度で描写、もしレイアウト的に厳しければ手前のモブ男の挿入された竿以外を半透明にするといったような響子ちゃんの前面が見える描写を是非お願いします。\nそして前回同様、結合部から溢れる中出し汁および顔面等から糸を引くぶっかけ汁と、順番待ちモブ男さんに周囲を囲んで頂いて藍子ちゃんと同じような閉鎖空間での乱交種付けパーティーを演出してください。\n\nそれでは、今回も少し指定が細かくなってしまったかと思いますがご検討をよろしくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fujy_san/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 625380, "client_id": 248141, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d2209d02/uploads/origins/727d14c3-2512-4b36-881b-b6248d8c426c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33e5587ff54846950613c26b5b4109b5", "srcset": "https://si.imgix.net/d2209d02/uploads/origins/727d14c3-2512-4b36-881b-b6248d8c426c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33e5587ff54846950613c26b5b4109b5, https://si.imgix.net/d2209d02/uploads/origins/727d14c3-2512-4b36-881b-b6248d8c426c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f00651e349a7800c0385d61d55eb570b 2x, https://si.imgix.net/d2209d02/uploads/origins/727d14c3-2512-4b36-881b-b6248d8c426c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de5618190c171b8084cdee76768c6edd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d2209d02/uploads/origins/727d14c3-2512-4b36-881b-b6248d8c426c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=630ccbecf74af2ecd99a7c7016d22d51", "srcset": "https://si.imgix.net/d2209d02/uploads/origins/727d14c3-2512-4b36-881b-b6248d8c426c?bg=%23fff&auto=format%2