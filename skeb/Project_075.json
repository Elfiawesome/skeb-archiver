: 9000}, {"genre": "novel", "default_amount": 3000}, {"genre": "correction", "default_amount": 3000}], "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@Project_075/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1075903, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c72f50a/uploads/origins/35be6aff-c86e-45a8-833e-331607a7dfc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=514cc547e23c9e505e1d3d16b241238d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c72f50a/uploads/origins/35be6aff-c86e-45a8-833e-331607a7dfc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e50dfd68b261508ba20c39c8bb211a6d", "src_set": ""}, "body": "https://x.com/Project_075/status/1926956497637880243?t=UmKxz5bK0UdvAUeVe0sIUQ&s=19\n以前リクエストで描かれていた、↑の「アフロヘアになった保健の先生」がとても素敵でした！\nまたアフロな先生が見たくてイラストをリクエストしたく存じます。詳細は下記の通りです。\n\n(登場人物)\n①アフロになった保健の先生。\n②先生を見て影響されて、同じくアフロになった女子生徒。\n\n(内容)\n女子生徒にアフロをアレンジされる先生。オシャレな感じにはなったが、沢山いじられまくったせいで先生は目を回してフラフラになってしまう。\n\n(詳細)\n2人とも正面を向いてる感じの構図、先生は目を回して目がぐるぐるの渦巻きになってる描写を希望したいです。その他の構図等についてはお任せします。ご検討くださりますと幸いです。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Project_075/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1075903, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0668e2c0/uploads/origins/126c4132-8c53-4274-bcec-75b0782e820c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3334ed35d87ddf54c3c56013bc9a8db7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0668e2c0/uploads/origins/126c4132-8c53-4274-bcec-75b0782e820c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad57dd82db780709630625b7e9511bb8", "src_set": ""}, "body": "はじめまして。なごかわ様が何度か描かれていました「保健の先生」https://x.com/Project_075/status/1924419774018412931?t=iI6-DAaqK7dOSmpgCU24JA&s=19\nが好きで、先生のイラストのリクエストを依頼したくお声がけしました。\n\nマニアックな内容で恐縮ですが「ビッグサイズなアフロヘアーになった保健の先生」の絵をリクエストしたいです。ご検討いただけますと幸いです。\n\n(詳細)\nアフロヘアのサイズは先生の地毛の色の紫で、サイズはhttps://store.shopping.yahoo.co.jp/sanrapitan/l-0622-jiafa325.html　くらいの感じの大きさをリクエストしたいです。\n服装は保健医の白衣を希望したいです。その他のポーズや表情等はご一任いたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Project_075/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1075903, "client_id": 7900, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ae3272f7/uploads/origins/0b3d6f17-7781-463c-bc02-eb6faa977b52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d09c2116a9f4fed0e906735d6960bfcf", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ae3272f7/uploads/origins/0b3d6f17-7781-463c-bc02-eb6faa977b52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4f31594fe27a695cc405d736a454a5c", "src_set": ""}, "body": "https://x.com/project_075/status/1897965454292930885?s=46\nはじめまして。\nこのニットお姉さんに惚れました。\n私はこのお姉さんにデレデレしていて、一目惚れしました。\n優しそうな雰囲気が可愛いです。\nイラストリクエスト失礼します。\n\nhttps://x.com/project_075/status/1897965454292930885?s=46\nこちらのニットお姉さんを描いていただければ幸いです。\n\n下記リンクのこの絵のように優しく膝枕を誘うポーズをお願いします。\nhttps://drive.google.com/file/d/1TJurvGal90jH8dGYkTE07vF6C2IR_0Em/view?usp=drivesdk\n\nイラストリクエスト、お受けしていただければ幸いです。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Project_075/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix