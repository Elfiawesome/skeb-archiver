71ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25c485aeaf1c3b90c69e2f4e44d41d03 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/128413a0/uploads/origins/7c0cb831-988d-492a-927e-44fad64071ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4e97f708f03c4ffa28cec9196dc2521", "srcset": "https://si.imgix.net/128413a0/uploads/origins/7c0cb831-988d-492a-927e-44fad64071ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4e97f708f03c4ffa28cec9196dc2521, https://si.imgix.net/128413a0/uploads/origins/7c0cb831-988d-492a-927e-44fad64071ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6ab8e1c664aba2ee2d08a9a2b29c869b 2x, https://si.imgix.net/128413a0/uploads/origins/7c0cb831-988d-492a-927e-44fad64071ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3d70bfa46dc13c9398c55461bc9b8c52 3x"}, "body": "アピールありがとうございます。\nキャラクター(うちの子)に興味をもっていただきありがとうございます。\n\nアピール元と同様の女の子のイラストをお願いできればと思います。\nこちらは参考画像ですが、セーラー服のデザイン・表情・ポーズ・構図は自由です。\nhttps://drive.google.com/drive/folders/1RIJ2bUUoPHZDhYmSZ5NlFco0yYrqRyDg?usp=sharing\n\n以下、リクエスト内容です。\n頬の絆創膏と右腕のギプス＋三角巾が維持されていれば、あとは自由となります。\n\n■女の子\n・艶やかな黒髪の前髪ぱっつん、少し内巻きのショートボブ、横髪・後ろ髪は口のラインくらいで切り揃えている、襟足はソフトに刈り上げ(構図次第で見えなくてもOK)\n・半袖のセーラー服\n・元気な感じ\n■シチュエーション\n・右腕にケガでギプスをしていて、三角巾で首から吊っている\n　‐首と肘のところの三角巾の結び目を見える位置にお願いします(資料URLご参照ください)\n　　(細かいですが…首の方は結び目1つ、三角巾の端が2つ、肘の方は結び目1つ、三角巾の端が1つ、という違いがあります)\n　‐右腕が画面に入るような構図でお願いします\n・ほっぺたに絆創膏１枚\n・ケガをしてても暗くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ebikatsu_17/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 26418