ればと思っています。 キャラクターの詳細 - ドイツと日本の血を引く高貴な尋問官で、国内で最も寒い国境地帯を担当しています。 性格: 表面的には穏やかですが、気分は予測不可能で、撫でたくなるような優雅な猫のようですが、実際に撫でると噛みつきます。 髪の色: 黒っぽい青色の髪で、毛先は灰色がかった白のグラデーションになっています。 目: 青緑色の輪がある灰色の目 (正しくは2つの輪)。 [見落としやすい特徴] これらを描くのを忘れないように助けてください。本当にありがとうございます! 1- 目の2つの青緑色の輪。 2- 髪のグラデーションの色。 あなたに自由に楽しく作品とテーマを描いていただけたら嬉しいです。 描いていただけたらとても嬉しいです〜ありがとうございます! https://drive.google.com/drive/folders/1peVZsGuYiWlWSCfKbNm1W8ktI37Ad7Kt", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@otonashi00002/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3988586, "client_id": 3254798, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d70915b8/uploads/origins/01ce536d-d0df-4bf6-9907-75238772f9d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1e6ffbd533bff1f371763ed5242038d", "srcset": "https://si.imgix.net/d70915b8/uploads/origins/01ce536d-d0df-4bf6-9907-75238772f9d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1e6ffbd533bff1f371763ed5242038d, https://si.imgix.net/d70915b8/uploads/origins/01ce536d-d0df-4bf6-9907-75238772f9d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44505a694b46a5d9aa210c4f7d6f7823 2x, https://si.imgix.net/d70915b8/uploads/origins/01ce536d-d0df-4bf6-9907-75238772f9d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f4b594502621c98cdbbc97aac20d457 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d70915b8/uploads/origins/01ce536d-d0df-4bf6-9907-75238772f9d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=368428a580a517a7dd90d3a4e009e17d", "srcset": "https://si.imgix.net/d70915b8/uploads/origins/01ce536d-d0df-4bf6-9907-75238772f9d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=368428a580a517a