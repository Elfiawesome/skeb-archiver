や金銭面で不明点や問題がある場合は、遠慮なく再送・キャンセルしてくださいませ。\nご多忙のところ恐れ入りますが、ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1rgYSATJw8mpebrRGlsFzXCUWoEWs_x0a", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1466887, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "𝗮𝗺𝗲", "screen_name": "I71YO", "avatar_url": "https://pbs.twimg.com/profile_images/2084648794738802688/LXMiYCau.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1513801822485778435/1785854003/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 40, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 1844279, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "平安. ᵗ ᵒ ᵐ ᵃ ᵗ ᵒ", "screen_name": "heiantomato", "avatar_url": "https://pbs.twimg.com/profile_images/1851114963341017088/uAgC75Lz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1252937639352610816/1727544542/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 2247249, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "モカ", "screen_name": "daruma___Owl", "avatar_url": "https://pbs.twimg.com/profile_images/1213815618551500801/YU8LEEfc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/943772740674248704/1589815994/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days