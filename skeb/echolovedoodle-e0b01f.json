t=crop&crop=top&w=200&h=200&blur=200&s=f3aca2f57a6b805e980c015d711047c7 3x"}, "body": "こんにちは、先生のイラストが好きで依頼させていただきました！\n私のオリキャラの絵を描いてもらえますか？\n\n◆キャラクター設定：\n- 一見優しそうで実は腹黒な魔女。\n- 薄い金髪 / タレ目\n- 趣味：鉱石コレクション、魔法薬作り\n\nポーズ等はお任せします、ご自由に描いてください！\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1igXPpsxXG5Squ1QCFJDtLjV9HBRhaj6u?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@echolovedoodle/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1538278, "client_id": 674760, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c7c1120/uploads/origins/dbccf031-b8a0-41cd-982a-4117f0483f24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cd7205faf590c5e9f930ab295db78ce", "srcset": "https://si.imgix.net/0c7c1120/uploads/origins/dbccf031-b8a0-41cd-982a-4117f0483f24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1cd7205faf590c5e9f930ab295db78ce, https://si.imgix.net/0c7c1120/uploads/origins/dbccf031-b8a0-41cd-982a-4117f0483f24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=142badf76dc494aead6ee7650ac71fd7 2x, https://si.imgix.net/0c7c1120/uploads/origins/dbccf031-b8a0-41cd-982a-4117f0483f24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70f903153586d1728d5a899d0b0efe3c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c7c1120/uploads/origins/dbccf031-b8a0-41cd-982a-4117f0483f24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ae7f531b6a7effde3d96c819b301c5f", "srcset": "https://si.imgix.net/0c7c1120/uploads/origins/dbccf031-b8a0-41cd-982a-4117f0483f24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ae7f531b6a7effde3d96c819b301c5f, https://si.imgix.net/0c7c1120/uploads/origins/dbccf031-b8a0-41cd-982a-4117f0483f24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8008ad9fb3ac5e6970f0d6a115023ec5 2x, https://si.imgix.net/0c7c1120/uploads/origins/dbccf031-b8a0-41cd-982a-4117f0483f24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2b8999dbd7b91d5117d1936ee934b4ef 3x"}, "body": "かかし陽太先生、こんにちは。\n先生が描いた明るさあふれるイラストが好きです。\nもしよろしければ、うちのオリジナルキャラクターの描き下ろしをお願いしたいと思います。\n\nこの子は好奇心旺盛な召喚士だ。\nファンタジーJRPGのような世界観の中にいるキャラクターです。\nフードをかぶっているかどうか、リュックを肩にかけているかどうか、好きな状態を選んでください。\nフードをかぶっていない状態では、背中の長いおさげが見えてしまうので注意してください。黒い羽は彼女のシュシュです。\n\nご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1kFCz6id6FcZqEA5VTOul-LnzQvY6KqHj?usp=share_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@echolovedoodle/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/67182d5c/uploads/origins/b8afbb1c-3589-40f3-8100-482c41edfea8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a93f157f252d3acc822f340cfc962994", "srcset": "https://si.imgix.net/67182d5c/uploads/origins/b8afbb1c-3589-40f3-8100-482c41edfea8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a93f157f252d3acc822f340cfc962994, https://si.imgix.net/67182d5c/uploads/origins/b8afbb1c-3589-40f3-8100-482c41edfea8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d91438b88606bf7895a8aba8966db9e 2x, https://si.imgix.net/67182d5c/uploads/origins/b8afbb1c-3589-40f3-8100-482c41edfea8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0381ae011929cbd680ab1342e0ef3177 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1538278, "client_id": 1223350, "nc": 129}, {"path": "/@echolovedoodle/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1538278, "client_id": 1640849, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20c507e3/uploads/origins/500fce9d-dec7-43e8-878f-392e33e5cbca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8eeba0990eac3950a68498424dc87c30", "srcset": "https://si.imgix.net/20c507e3/uploads/origins/500fce9d-dec7-43e8-878f-392e33e5cbca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8eeba0990eac3950a68498424dc87c30, https://si.imgix.net/20c507e3/uploads/origins/500fce9d-dec7-43e8-878f-392e33e5cbca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6cbdc16a763d02ce18622383f3cec412 2x, https://si.imgix.net/20c507e3/uploads/origins/500fce9d-dec7-43e8-878f-392e33e5cbca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd9c5acff7c0cc85d4e1a35f3985f72c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20c507e3/uploads/origins/500fce9d-dec7-43e8-878f-392e33e5cbca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd8c60f0b4d46d67ce528b0adcd65c50", "srcset": "https://si.imgix.net/20c507e3/uploads/origins/500fce9d-dec7-43e8-878f-392e33e5cbca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd8c60f0b4d46d67ce528b0adcd65c50, https://si.imgix.net/20c507e3/uploads/origins/500fce9d-dec7-43e8-878f-392e33e5cbca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a82d02c2909c5e1a22abcfaa5baadc8d 2x, https://si.imgix.net/20c507e3/uploads/origins/500fce9d-dec7-43e8-878f-392e33e5cbca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ab3bcaf140e61219b472a1a12f8cc576 3x"}, "body": "かかし陽太様\n\nご検討頂けますと幸いです\n\nオリジナルキャラクターを、下記のテーマに合わせてかかし陽太様のテイストでアレンジしたイラストを希望します。\n外見資料として、お手数ですが資料URLに記載のTwitterアカウントの固定ツイート及び、ツリーをご確認ください。\n詳細、不明点等はお任せ\n\n▼テーマ\nお茶会の準備。\n大好きな家族と一緒に和やかなひとときを過ごすため\nお花を飾り、お菓子を焼いて、紅茶を選んで、ティーセットを準備する。\nとても嬉しそうに、幸せなその情景。\n\n▼キャラクター設定\nキャラクターモチーフ：シャム猫\n髪：白色\n・髪型アレンジもお好きな形でお任せ\n瞳：サファイアブルー\n肌：褐色\n・肌は褐色とわかる色彩であれば、濃淡は特に問わず全体のイメージに合わせて変えて問題ありません。\n年齢：14〜15\nイメージ：細身で軽やか、しなやかな所作\n性格：真面目で良いことを好む。\n※猫の擬人化ではないため猫目や猫耳、尻尾等は不要。\n\n▼背景（読み飛ばして頂いて構いません）\n・裕福な老齢の夫婦に養い育てられた娘\n・幼い頃から血の繋がりはないと認識してるが、そのようなことは些事です、と構わず養父母のことが大好きで敬愛している\n・養父母の前では、いい子であろうととてもお淑やか、でも甘えたがり。\n・養母の影響で植物が好き。特に、名の由来となった山茶花は特に好きな花。\n・養父母から溺愛され、クローゼットには贈られた服でいっぱい\n\n以上となります\n\nhttps://twitter.com/Sasanqua_ykmr", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@echolovedoodle/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1538278, "client_id": 2582276, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4f8663a2/uploads/origins/91b78cdf-d3f1-4b21-a48b-2091688fad00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=958b324c5a785f85e62db1ec11253dd0", "srcset": "https://si.imgix.net/4f8663a2/uploads/origins/91b78cdf-d3f1-4b21-a48b-2091688fad00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=958b324c5a785f85e62db1ec11253dd0, https://si.imgix.net/4f8663a2/uploads/origins/91b78cdf-d3f1-4b21-a48b-2091688fad00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56ba6b4623129ee87a7e6eed407468da 2x, https://si.imgix.net/4f8663a2/uploads/origins/91b78cdf-d3f1-4b21-a48b-2091688fad00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f540a154e03bb47eb0c470bf8f77e2f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_