き出せそうなものを選んでいただけますととても嬉しいです。\n（ただしその指定は絶対ではありません、貴方が描きやすいように描いてください）\n\nまた、サンプルが正面画しかなくて恐縮です。斜め、後姿、などを検討頂ける場合は\nその姿の補完は想像で構いません。\n\n\nよろしくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fujidai_s/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1576915, "client_id": 1396980, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a6aafeab/uploads/origins/9ce910ca-6e18-4d69-a9bc-26da9e646f44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29895a5f7996c5fae7ecf35e75c130c3", "srcset": "https://si.imgix.net/a6aafeab/uploads/origins/9ce910ca-6e18-4d69-a9bc-26da9e646f44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29895a5f7996c5fae7ecf35e75c130c3, https://si.imgix.net/a6aafeab/uploads/origins/9ce910ca-6e18-4d69-a9bc-26da9e646f44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76422be9eb8d3cfc94bffd83e64d7c03 2x, https://si.imgix.net/a6aafeab/uploads/origins/9ce910ca-6e18-4d69-a9bc-26da9e646f44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f18b40f7c24019742f151c0009bde10c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a6aafeab/uploads/origins/9ce910ca-6e18-4d69-a9bc-26da9e646f44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf658a8819d576b80576e48fc884e75d", "srcset": "https://si.imgix.net/a6aafeab/uploads/origins/9ce910ca-6e18-4d69-a9bc-26da9e646f44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf658a8819d576b80576e48fc884e75d, https://si.imgix.net/a6aafeab/uploads/origins/9ce910ca-6e18-4d69-a9bc-26da9e646f44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8481806f1ab1acf2e4749b9af8e2293f 2x, https://si.imgix.net/a6aafeab/uploads/ori