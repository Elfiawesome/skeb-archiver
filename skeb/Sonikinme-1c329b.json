腋汗や先走り汁など恥ずかしい染みを作って見せ物にされ、ゲス貴族たち嘲笑され、無様敗北しまう…というものです。\n\nリクエストが難しい場合はキャンセルでかまいません！\nよろしくお願いします！", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sonikinme/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2938536, "client_id": 1180046, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c27c845/uploads/origins/d9a8fc74-0087-4722-b9a7-e9bfd081c33f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c595ee838728a86fa21e967a1c3abf5d", "srcset": "https://si.imgix.net/1c27c845/uploads/origins/d9a8fc74-0087-4722-b9a7-e9bfd081c33f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c595ee838728a86fa21e967a1c3abf5d, https://si.imgix.net/1c27c845/uploads/origins/d9a8fc74-0087-4722-b9a7-e9bfd081c33f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a830b54389012541b55348b5bc95a27 2x, https://si.imgix.net/1c27c845/uploads/origins/d9a8fc74-0087-4722-b9a7-e9bfd081c33f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=47855b7bb54a3d78b7d3003db7ea7dc3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c27c845/uploads/origins/d9a8fc74-0087-4722-b9a7-e9bfd081c33f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4822b70489bc6288bbe55a983a811971", "srcset": "https://si.imgix.net/1c27c845/uploads/origins/d9a8fc74-0087-4722-b9a7-e9bfd081c33f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4822b70489bc6288bbe55a983a811971, https://si.imgix.net/1c27c845/uploads/origins/d9a8fc74-0087-4722-b9a7-e9bfd081c33f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=87ea2a9c09e32db997c262df139775d4 2x, https://si.imgix.net/1c27c845/uploads/origins/d9a8fc74-0087-4722-b9a7-e9bfd081c33f?bg=%23fff