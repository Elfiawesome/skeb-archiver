を捧げることに安堵しているような感じでお願いします\n結局、カルロスはこのような扱いを受けることが癖になり、次があるなら、この依頼を受けて独白するのです\n\nカルロスの屈服敗北宣言と二人の濁点んほぉ喘ぎ声が欲しいです\n\n他の詳細はｵﾆｷﾝﾒさんに任せます！！\n\nhttps://drive.google.com/drive/folders/1xTCI2YdXAP6plQO6QVlrotqPTCvTxX3z?usp=drive_link", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sonikinme/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d55c2e60/uploads/origins/960f3826-1418-468d-a2c5-bb1f8297e72f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed21150af4bbb97d11345fcf3fd9b622", "srcset": "https://si.imgix.net/d55c2e60/uploads/origins/960f3826-1418-468d-a2c5-bb1f8297e72f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ed21150af4bbb97d11345fcf3fd9b622, https://si.imgix.net/d55c2e60/uploads/origins/960f3826-1418-468d-a2c5-bb1f8297e72f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=68a3a7d67353b18b161f27a6e6a3bdb6 2x, https://si.imgix.net/d55c2e60/uploads/origins/960f3826-1418-468d-a2c5-bb1f8297e72f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5c8cb5a1a673149e19bb532c69e02ebf 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2938536, "client_id": 56566, "nc": 33}, {"path": "/@Sonikinme/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2938536, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bbbb9c18/uploads/origins/416b0124-5e37-41e0-a662-eaf07c210667?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=