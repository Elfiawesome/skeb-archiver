t": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hayashida_rnt/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2199184, "client_id": 1577889, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d6dc8f06/uploads/origins/08988004-0c26-4dbd-94a5-b19e16071560?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f5f47a1bd868434598b26d9f612367d", "srcset": "https://si.imgix.net/d6dc8f06/uploads/origins/08988004-0c26-4dbd-94a5-b19e16071560?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f5f47a1bd868434598b26d9f612367d, https://si.imgix.net/d6dc8f06/uploads/origins/08988004-0c26-4dbd-94a5-b19e16071560?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c81dedcdc2e76b69ba616df522b4b83e 2x, https://si.imgix.net/d6dc8f06/uploads/origins/08988004-0c26-4dbd-94a5-b19e16071560?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=518cafd5922e77e906a8ed65b1f8a4e7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d6dc8f06/uploads/origins/08988004-0c26-4dbd-94a5-b19e16071560?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=691bc78fa6751d3603cadc9c07934793", "srcset": "https://si.imgix.net/d6dc8f06/uploads/origins/08988004-0c26-4dbd-94a5-b19e16071560?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=691bc78fa6751d3603cadc9c07934793, https://si.imgix.net/d6dc8f06/uploads/origins/08988004-0c26-4dbd-94a5-b19e16071560?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cbdb7d6049078596965170b513a7adba 2x, https://si.imgix.net/d6dc8f06/uploads/origins/08988004-0c26-4dbd-94a5-b19e16071560?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5d934c4afdb7eb063a21fcf13ea903ab 3x"}, "body": "林田様、初めまして。\nかわいらしい絵を拝見し、依頼をしたい！と思いましたのでリクエストを送らさせていただきます。\n\n【依頼内容】\n内容:デフォルメイラスト\n人数:TRPGの探索者2人\n時代背景:19世紀ロンドン\n\nホームズとワトソンで探偵業をやっています。\n\n【１】\nホームズ(長髪)\n性別：男\n身長：182cm\n職業：探偵\n性格：このような初歩的なこともわからないのかい？って言ってきそう。興味があるものにはとことん掘り下げる\n\n【２】\nワトソン (短髪)\n性別：女(男装女子)\n身長：164cm\n職業：探偵助手\n性格：しっかりめ、長女気質\n\n\n「19世紀ロンドン、シャーロックホームズの雰囲気」を要素として入れてもらえると嬉しいです。\n\nポーズ・構図等は何でも構いません、服装も新しくデザインして着させるのでも全然大丈夫です、お任せ致します。\n\n2人写っている一枚のデフォルメ絵(背景有と背景無しで2人が個々で透過されているもの計3枚で納品していただけると幸いです。)\n\nご検討のほど、宜しくお願い致します。\n\n詳細はURLで共有させていただきます。\n\nhttps://drive.google.com/drive/folders/1Tm802xXoz6MB1AbGboJ9rGg6UL_NXZcm?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hayashida_rnt/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2199184, "client_id": 1531284, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/421a68ec/uploads/origins/05f5d39d-7052-47ec-89d1-f19db263a378?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b821f6ca58e0db08549bec9426c146ad", "srcset": "https://si.imgix.net/421a68ec/uploads/origins/05f5d39d-7052-47ec-89d1-f19db263a378?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b821f6ca58e0db08549bec9426c146ad, https://si.imgix.net/421a68ec/uploads/origins/05f5d39d-7052-47ec-89d1-f19db263a378?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19db6c90f10e3cb36c7b501afddc73dd 2x, https://si.imgix.net/421a68ec/uploads/origins/05f5d39d-7052-47ec-89d1-f19db263a378?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=323679ae3ba17953b54dbecd32273318 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/421a68ec/uploads/origins/05f5d39d-7052-47ec-89d1-f19db263a378?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f69578f407c6f9f69e8ccdb6