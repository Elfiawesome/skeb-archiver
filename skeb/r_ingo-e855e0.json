0&s=e9fed47efe728a315bacb60fb3228a86", "srcset": "https://si.imgix.net/2abbd324/uploads/origins/b8d2daa7-4fb6-4a70-a474-2cd0bc77cf56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9fed47efe728a315bacb60fb3228a86, https://si.imgix.net/2abbd324/uploads/origins/b8d2daa7-4fb6-4a70-a474-2cd0bc77cf56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=21878acfcd2fb95907a2e53899f5a204 2x, https://si.imgix.net/2abbd324/uploads/origins/b8d2daa7-4fb6-4a70-a474-2cd0bc77cf56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7ac44cbff5f2cfb45d8fd7e63c238ff7 3x"}, "body": "こんにちは！あなたの作品が大好きです。もし可能であれば、私のキャラクターであるセリーヌ（https://drive.google.com/drive/folders/1dApjjxx6angigPxbHwRhgPSgLpjN3LiG?usp=sharing）の、新しいファンタジー風の衣装姿のイラストをお願いしたいです！\n\nhttps://drive.google.com/drive/folders/1mLdtq-363TMtvyVpFUKb0cwkiV2BHc3N?usp=sharing\n\n色は画像と同じままで構いませんが、もしインスピレーションが湧いて色を変えたい場合は、どうぞご自由にどうぞ。 可能であれば、衣装に少し手を加えたり、要素を追加して、完全に同じではなく、よりファンタジー寄りの仕上がりになるようお願いできれば嬉しいです。\n\n可能であれば、イラストは全身像を1点以上描いていただけると幸いです。\n\nそれ以外はすべてお任せしますので、ポーズや構図はご自由に決めてください。\n\nご検討いただきありがとうございます！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@r_ingo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1102975, "client_id": 2168110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/37c2530c/uploads/origins/58bdc30e-6e11-4379-b932-80b6908262b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a5bc80a7f7cdc04269cb563964b7913", "srcset": "https://si.imgix.net/37c2530c/uploads/origins/58bdc30e-6e11-4379-b932-80b6908262b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a5bc80a7f7cdc04269cb563964b7913, https://si.imgix.net/37c2530c/uploads/origins/58bdc30e-6e11-4379-b932-80b6908262b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b2caf19b77d2ea1b5b528731867181b2 2x, https://si.imgix.net/37c2530c/uploads/origins/58bdc30e-6e11-4379-b932-80b6908262b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e8d9b7dfa587a0b0ba52d31bdcf2c03b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/37c2530c/uploads/origins/58bdc30e-6e11-4379-b932-80b6908262b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e86db0e4810c58c95444c71a203395f", "srcset": "https://si.imgix.net/37c2530c/uploads/origins/58bdc30e-6e11-4379-b932-80b6908262b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e86db0e4810c58c95444c71a203395f, https://si.imgix.net/37c2530c/uploads/origins/58bdc30e-6e11-4379-b932-80b6908262b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9c9a01436bf9b46290eeaf84da0b9428 2x, https://si.imgix.net/37c2530c/uploads/origins/58bdc30e-6e11-4379-b932-80b6908262b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=97bdc12d25a3982cc243218c1d2fa81a 3x"}, "body": "はじめまして。\n\nこの度は私のオリキャラの\"∅（エル）\"のイラストをお願いできればと思いリクエストさせていただきました。\n－\n<∅（エル）>\n【外見】\n・小柄で痩せた少女。輪郭と目鼻立ちが精巧に整った顔立ちで、見た目は14～16歳くらい。\n・脱色したような灰ベージュのブロンド色のストレートヘア。長さは肩から背中にかかるくらい。\n・瞳は少し赤みががったトープ色。\n・天使のような翼が背中にあったと思われる。\n\n【迷宮地下実験室で目覚めた時の状態】\n・自分の名前、家族、出身地、過去の生活に関する一切の記憶がない。\n・ドイツ語のほかに、カルテや記録に印字されたラテン語由来の医療用語の一部を理解できる。\n・右目は眼球破裂のあとがあり、厚い包帯で覆われていた。\n・左腕は肘から先がなく、包帯で巻かれている。\n・背中の肩甲骨のあいだに、弧を描くように左右へ伸びる太い縫合痕がある。（翼は切除されている）\n・胸元あたりに「Ø」と刻印されている。\n※一見悲惨な状態ですが、NSFWになるようなイラストは希望してません。\n\n【服装】\n・煤けた墨黒のノースリーブワンピース。裾は段になっていて、不揃いに裂けている。\n・背中側がやや大きく開き、肩甲骨のあいだの縫合痕がそのまま見える。\n・右目は厚い包帯で覆われ、左腕の断端も白い包帯で巻かれている。\n・足元は裸足。\n－\n状態、構図、シチュエーションなどの詳細については、お任せいたします。\n\n使用用途：個人活動全般\n  ・動画配信：待機画面やエンディング画面などでの使用。\n  ・ウェブサイトおよびSNS：個人サイトやSNSでの小説の挿絵、キャラクター紹介、活動告知。\n  ・グラフィック要素：アイコン、ヘッダー、バナーとしての使用。バナー使用時には、サイト名やキャンペーン名を追加する場合があります（必要に応じてトリミング加工を行うこともあります）。\n  ・参考資料：他のイラストレーターへの依頼時における参考資料としての提示。\nこれらの用途において、無断使用防止のためにウォーターマークを適宜付けて、イラストを使用させていただく場合があるので、ウォーターマークについてもご提供いただけますと幸いです。\nなお、商業利用や第三者への再配布は行いません。\n\nご確認のほど、よろしくお願いいたします。\nもしもご縁がありましたら、どうかよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1RnRks6JaodiN9ZqGEVaQb3GdVrx6mOEy", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1130, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "稲守竜砂", "screen_name": "Inamori_Ryusa", "avatar_url": "https://pbs.twimg.com/profile_images/1010552511785156608/Zfpib9D8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/108972298/1718201504/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 325358, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "小粒乃 白虎@お絵描きするマン", "screen_name": "byakkok99", "avatar_url": "https://pbs.twimg.com/profile_images/1560987913076510720/H4Tmqt5t.jpg", "header_url": "https://pbs.twimg.com/profile_banners/317612015/1582791669/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 33}, {"id": 1068592, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "364ing(多忙)", "screen_name": "364ing01", "avatar_url": "https://pbs.twimg.com/profile_images/1887917803405238272/cID8bDBv.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1363152561675493383/1632964948/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_ran