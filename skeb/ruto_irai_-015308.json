です！\n\n清志郎はクールでやんちゃな半妖の半人間です。彼の主な特徴やアクセサリーは、片方の角、「VII」のヘアクリップ、片方にスペードのついた耳のピアス、「VII」と書かれた黒い包帯、2つの指輪です。主な色は白、グレー、黒、赤。\n\nポーズや表情はお任せします！服装は自由です！\n\nTwitch/YouTubeやSNSのサムネイルに使いたいと思います。背景あり、なしのPSDファイルもお願いしたいです。ちゃんとクレジットはアーティストであるあなたにお渡しします。\n\nご検討のほど、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1FRiRhrZqsj-z3HBAmyZZsksR0OhUPwgX?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ruto_irai_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3314906, "client_id": 2737988, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42e5a55a/uploads/origins/c403c7e9-b4bf-4e04-ba97-daaa84ec4094?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cff4b1cf57ed2ebacd9fb7000321e2dd", "srcset": "https://si.imgix.net/42e5a55a/uploads/origins/c403c7e9-b4bf-4e04-ba97-daaa84ec4094?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cff4b1cf57ed2ebacd9fb7000321e2dd, https://si.imgix.net/42e5a55a/uploads/origins/c403c7e9-b4bf-4e04-ba97-daaa84ec4094?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf133d99511c40fdff1540efc7899e72 2x, https://si.imgix.net/42e5a55a/uploads/origins/c403c7e9-b4bf-4e04-ba97-daaa84ec4094?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06683d594ba096eb0176c4544f53d1d3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42e5a55a/uploads/origins/c403c7e9-b4bf-4e04-ba97-daaa84ec4094?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e73396a549211d5afeb2f1d0fe88bab0", "srcset": "https://si.imgix.net/42e5a55a/uploads/origins/c403c7e9-b4bf-4e04-ba97-daaa84ec4094?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e73396a549211d5afeb2f1d0fe88bab0, https://si.imgix.net/42e5a55a/uploads/origi