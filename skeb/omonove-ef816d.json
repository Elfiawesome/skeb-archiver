compress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=618f78a2b7d35ed8a7cc506f091efe29 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/76305444/uploads/origins/7b31d49c-2c82-4c24-ac9f-2febe3ff1b97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a699776a83801aa84bf595c6a6d42b8", "srcset": "https://si.imgix.net/76305444/uploads/origins/7b31d49c-2c82-4c24-ac9f-2febe3ff1b97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5a699776a83801aa84bf595c6a6d42b8, https://si.imgix.net/76305444/uploads/origins/7b31d49c-2c82-4c24-ac9f-2febe3ff1b97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a140baf52563b0db991082cdfe56f008 2x, https://si.imgix.net/76305444/uploads/origins/7b31d49c-2c82-4c24-ac9f-2febe3ff1b97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=45b401c5b0721cfa21337d4370b93880 3x"}, "body": "失礼します。もう一度依頼してもよろしいですか？\n\nhttps://skeb.jp/@omonove/works/6 といったダンジョンの依頼です。 ダンジョンは階があり、その階は8階で、今回の依頼は3階です。\n\n登場人物はおねしょた2人そのままでお願いします。\n\nB3\n花中でくすぐりの刑\n3 階で敗北した冒険家たちは、壁尻のポーズで花に拘束されお仕置きされます。\nhttps://www.pixiv.net/artworks/126574290\n上記のような感じで2人が花で拘束されている構図です。2人とも全裸です。\n\nその状態で足裏、お尻の肉、アナル、性器を葉やブラシのつるでくすぐられます。\n\nもしかして、前のように差分1枚をお願いしてもいいですか？\n\nその後、お仕置きを受けて気持ちを良くするために意図的に敗北した2人組をさらに厳しくお仕置きする内容です。\n\nお尻と性器にかゆみを感じさせる花粉をつけた後、放置される内容です。\n\n花粉にはくすぐりの感度を永久的に開発する効果があり、そのお仕置きを長く受けるほどくすぐったさに弱くなります。 アナルに吸収されることにより全身例外なく開発されます。\n\nダンジョン共通設定\nダンジョンの内部は時間が流れず、空腹や疲れを感じず、非常に長い時間お仕置きを受けます。\nお仕置きされる時間は1日X現在の階数です。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@omonove/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1408450, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f9dad214/uploads/origins/ef337632-5f49-4abd-bcb9-47a19d4ecc42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b3e45fc94a61bfcbd0ced009f3114f9", "srcset": "https://si.imgix.net/f9dad214/uploads/origins/ef337632-5f49-4abd-bcb9-47a19d4ecc42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b3e45fc94a61bfcbd0ced009f3114f9, https://si.imgix.net/f9dad214/uploads/origins/ef337632-5f49-4abd-bcb9-47a19d4ecc42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db736e4a43179ed21b801d85bf3a7037 2x, https://si.imgix.net/f9dad214/uploads/origins/ef337632-5f49-4abd-bcb9-47a19d4ecc42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8af4bd8daf5d723e7481aea645d8987e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f9dad214/uploads/origins/ef337632-5f49-4abd-bcb9-47a19d4ecc42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5bef010f02d4bf02d5583257ad426f7f", "srcset": "https://si.imgix.net/f9dad214/uploads/origins/ef337632-5f49-4abd-bcb9-47a19d4ecc42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5bef010f02d4bf02d5583257ad426f7f, https://si.imgix.net/f9dad214/uploads/origins/ef337632-5f49-4abd-bcb9-47a19d4ecc42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1d24e55ce0b8edebdde8a6a39f7adf1b 2x, https://si.imgix.net/f9dad214/uploads/origins/ef337632-5f49-4abd-bcb9-47a19d4ecc42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f5e3e4ce95c4ca5fc4bad0522e5ec041 3x"}, "body": "こんにちは、作家先生。 依頼したい絵があります。\n\nシチュエーションはお仕置きを与えるダンジョンです。\n爆乳お姉さんとショタで構成されたおねショタパーティーが新しいダンジョンを探検しています。\nダンジョンは平凡でしたが、当該ダンジョンを探検するには弱すぎるおねショタコンビなので、平凡にモンスターに倒されてから起こる出来事の絵です。\n\n気絶したおねショタが起きた場所は正体不明の小さな肉壁でいっぱいの部屋で、おねショタは肉壁を背に四肢を拘束され、エビのように股間を突き出しています。\nそれに姉には巨大なペニスが育ってふたなりになっている状況、そして起きたことに気づいたダンジョンはおねショタにお仕置きを与えます。\n\nおねショタの股間で、肉壁からブラシの触手が飛び出し、二人の亀頭、股間、アナールまで媚薬を通してぐちゅぐちゅとくっつき、前後にガーゼの拷問を始めます。\nそんなにお尻をぴくぴくさせて、連続絶頂を超えて男の潮吹きをしてしまう二人の絵を描いてほしいです。\n\nまた、気が向いたら、該当事件の後、もしおねショタがお仕置きを受けるために故意に捕まる場合、ダンジョンでまた別のお仕置きを与える差分を描いてほしいです。\nもう一つのお仕置きの内容は、以前と同じ構図で拘束した後、ブラシの代わりに媚薬ガスを通じて二つの勃起を最大に維持したまま放置します。\n絶頂しないままエビのように腰が曲がって勃起によって感じられる股間筋肉の興奮を強制的に感じながら、数時間放置されるお仕置きを受けるおねショタを描いていただければ幸いです。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@omonove/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1408450, "client_id": 226339, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2bff7156/uploads/origins/d8c2873b-5140-418f-8548-f7456aa9e051?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10e83cca909bb832241181c5c99c0ddf", "srcset": "https://si.imgix.net/2bff7156/uploads/origins/d8c2873b-5140-418f-8548-f7456aa9e051?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10e83cca909bb832241181c5c99c0ddf, https://si.imgix.net/2bff7156/uploads/origins/d8c2873b-5140-418f-8548-f7456aa9e051?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6683574ef7f6e8a49582731c1b3e5aea 2x, https://si.imgix.net/2bff7156/uploads/origins/d8c2873b-5140-418f-8548-f7456aa9e051?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=01b7c454cbe5ad72733d3795238d93c4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2bff7156/uploads/origins/d8c2873b-5140-418f-8548-f7456aa9e051?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=885a50479c8413e4b01b43f01fb3e2a5", "srcset": "https://si.imgix.net/2bff7156/uploads/origins/d8c2873b-5140-418f-8548-f7456aa9e051?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=885a50479c8413e4b01b43f01fb3e2a5, https://si.imgix.net/2bff7156/uploads/origins/d8c2873b-5140-418f-8548-f7456aa9e051?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cd7265ed61ecccd55e73402a157ab0e4 2x, https://si.imgix.net/2bff7156/uploads/origins/d8c2873b-5140-418f-8548-f7456aa9e051?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b22b4a20cab2d02d30677c04522e71df 3x"}, "body": "前回は悪の組織幹部の綿棒クリ責めを描いて頂きありがとうございます。\n\n※周りのバカにしてる人たち全員同じ目に遭ったことあります。\nの設定もよかったので、イエローと全く同様の綿棒クリ責めのお仕置きをレッドが受けているシーンをリクエストしたいです。\n悪の組織四天王の腕自慢。乱暴な性格、戦闘能力は1番高いけどバカとされる悪の組織幹部レッドのことです。\n背景含め構図もイエローの時と同じ希望します。\n\nその他の希望\n・綿棒クリ責めを行っているのは同じく戦闘員で、上半身だけ拘束で開脚維持などお仕置き内容はイエローと全く一緒\n・見られている幹部はリーダーのブルーのみ。グリーンとイエローには見られずに済んでいる。（リーダーのブルーのキャラデザの有無までは問いませんのでお任せします。前回同様に彼女はシルエット描写だけでも構いません）\n・レッドはイエローよりかはクリ綿棒責めに頑張って耐えられている描写だと嬉しい（例えばですが、辛くても足を閉じようとまではしてないなど）\n・レッドは陰毛あり\n・イエローの時と同様に全裸ではなく股間以外の露出は無い。できればレッドの服は基本的にイエローの色違いみたいだと嬉しい。\n・レッドの足元には脱いだビキニパンツが落ちている。イエローは紫のブラ衣装を着てますがそれのパンツ版。（水着のビキニパンツっぽい見られても構わないような、いわゆるパンツ見せ衣装的な幹部服なイメージ）\n\nシチュエーションのイメージとしては\n・シーン的にイエローがあのお仕置きを受けた以前の話\n・ローションは媚薬成分なし。普通のローション。\n\nご検討のほどよろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@omonove/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 1408450, "client_id": 91485, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fb6c4e40/uploads/origins/03838e50-529a-44a6-bcbb-09fabfeeaefd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=527a91cc5bf60a71f8c6c1f853e8d2c4", "srcset": "https://si.imgix.net/fb6c4e40/uploads/origins/03838e50-529a-44a6-bcbb-09fabfeeaefd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=527a91cc5bf60a71f8c6c1f853e8d2c4, https://si.imgix.net/fb6c4e40/uploads/origins/03838e50-529a-44a6-bcbb-09fabfeeaefd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=369c08e8a9ae5051ef004d5b1d917901 2x, https://si.imgix.net/fb6c4e40/uploads/origins/03838e50-529a-44a6-bcbb-09fabfeeaefd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7326f161db2a7a6b4a7d334d2bca974d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fb6c4e40/uploads/origins/03838e50-529a-44a6-bcbb-09fabfeeaefd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=755ca455a24a42739fe256dd50d7f864", "srcset": "https://si.imgix.net/fb6c4e40/uploads/origins/03838e50-529a-44a6-bcbb-09fabfeeaefd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=755ca455a24a42739fe256dd50d7f864, https://si.imgix.net/fb6c4e40/uploads/origins/03838e50-529a-44a6-bcbb-09fabfeeaefd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0e5681eace0951cc3fe4ef5277f6aecb 2x, https://si.imgix.net/fb6c4e40/uploads/origins/03838e50-529a-44a6-bcbb-09fabfeeaefd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fa78be85efd9151b605406f2ad064999 3x"}, "body": "淫魔討伐のために立ち上がった少年勇者による、聖なる加護(守護天使のお姉さん達によるくすぐり調教)の旅という話をリクエストします。本作では主に三つのシーンを描いていただきたく、それぞれの詳細を以下に並べますので参考にしてください。\n\n①旅立つ日の前夜：はじめてのくすぐり調教\n　淫魔討伐の前日に少年が天使に祈りを捧げると、その晩に二人の守護天使のお姉さんが光臨する。二人は「淫魔の誘惑に負けないように加護を授ける」と言いながら少年の服を脱がせて光輪で拘束し、四本の手で少年をくすぐり責めにかける。たまらず笑い悶える少年のペニスにもくすぐりの手が及び、くすぐりの快楽を植え付けられ何度も射精させられる\n\n②旅のある日の晩：お仕置き寸止め羽くすぐり\n　毎晩施される聖なる加護により淫魔との闘いが有利に進み、何体もの淫魔を退治しながら順調に旅が続いていたある日、ある淫魔が苦し紛れにみせたちんカリ(服の上から爪で引っ掻くようにペニスを刺激する)のくすぐったさの混じる快楽に少年の心が乱されてしまう。その晩に守護天使たちからお仕置きとして、淫魔にはない天使の羽で射精させてもらえないくすぐり責めにかけられる。延々と続くお仕置きに少年が涙を流し蕩けた表情で射精をおねだりすると、愛らしさに心を射貫かれた二人は彼を許し、最後に気持ちよく射精させる\n\n③旅の最終日：楽園のくすぐりハーレム\n　遂に淫魔の本拠地に辿り着き、少年は淫魔女王の討伐に成功する。二人の守護天使が少年を褒め称え彼を楽園へと招待すると、そこでは見目麗しい無数の天使達が一糸纏わぬ姿で出迎えていた。守護天使二人を含めた彼女たちは勇気ある少年に永遠に奉仕するために、彼に楽園への永住を持ち掛ける。戸惑う少年に見せつけるように天使たちが両手をワキワキとくすぐるように蠢かせると、聖なる加護によりくすぐられないと射精できなくなっていた少年は天使の誘惑をはねのける事ができず首を縦に振ってしまう。彼は二人の守護天使に代わる代わる犯されながら何人もの天使にくすぐられ、愛され称えられながらくすぐったい毎日を過ごす\n\n\n二人の守護天使を含む天使たちのスタンスは基本的に甘々で、少年が可愛くて仕方ないという愛情たっぷりのものでおねがいします。\n上記以外の設定は全てお任せします。長くなってしまい申し訳ありません、キャンセルはお気軽にお願いします", "nc": 185, "word_count": 26336, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@omonove/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1408450, "client_id": 226339, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46e96ac7/uploads/origins/dc21ec0c-8d29-4aed-8bd7-c0fecb2e49b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=774eccb0014829bcc068519fb1b02397", "srcset": "https://si.imgix.net/46e96ac7/uploads/origins/dc21ec0c-8d29-4aed-8bd7-c0fecb2e49b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=774eccb0014829bcc068519fb1b02397, https://si.imgix.net/46e96ac7/uploads/origins/dc21ec0c-8d29-4aed-8bd7-c0fecb2e49b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32c806cc458b9a2143ca70f7d09ef5a1 2x, https://si.imgix.net/46e96ac7/uploads/origins/dc21ec0c-8d29-4aed-8bd7-c0fecb2e49b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0f3546baf0febe8d9a6b6d2dc3f6e93 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46e96ac7/uploads/origins/dc21ec0c-8d29-4aed-8bd7-c0fecb2e49b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92fc0f3d6c7b51a4e9348d668e783b8c", "srcset": "https://si.imgix.net/46e96ac7/uploads/origins/dc21ec0c-8d29-4aed-8bd7-c0fecb2e49b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92fc0f3d6c7b51a4e9348d668e783b8c, https://si.imgix.net/46e96ac7/uploads/origins/dc21ec0c-8d29-4aed-8bd7-c0fecb2e49b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d05421b2f09bcc3cc226a69f39e05205 2x, https://si.imgix.net/46e96ac7/uploads/origins/dc21ec0c-8d29-4aed-8bd7-c0fecb2e49b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=766d6213bf054fa8d186c511af7fc5a0 3x"}, "body": "「だらしない体で陰キャな彼女ができたので綿棒でクリトリスを開発する」の責めや構図などが良かったので、別のキャラクターが同じような責めを受けているイラストというのは可能でしょうか。\n\nシチュエーションとしては、\n「だらしなくない体の陽キャな悪の組織のお姉さんが任務失敗のペナルティとして綿棒でクリトリス責めをされている」イラストをお願いしたいです。\nガニ股でローションをたっぷりまとわせた二本の綿棒で、彼女のクリトリスを挟み込んでしごき続けるや\n全身絵の上コマと股間アップの下コマなど、基本的に構図は既存の綿棒クリ責めのイラストと全く一緒で構いません。\n\n・人物以外の変更点として、\n背景を彼氏の自室→組織のアジトの懲罰室\n逃げたり抵抗されないように、上半身と腕を拘束されている。足は未拘束。\nだと嬉しいです。\n\nあくまで出来れば希望するイメージとしては（出来ればで構いません）\n恥ずかしかったりクリ責めが辛くても自らガニ股開脚をキープしないといけないみたいなイメージ。クリ責めが効いていて相当辛いが、必死に耐えている。\n\nどうか、ご検討のほどよろしくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@omonove/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 1408450, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42b387a5/uploads/origins/47db9b17-0297-41ae-9fdd-9d2d3381bbf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8c29614e2948421dd297cc6228ae9da", "srcset": "https://si.imgix.net/42b387a5/uploads/origins/47db9b17-0297-41ae-9fdd-9d2d3381bbf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8c29614e2948421dd297cc6228ae9da, https://si.imgix.net/42b387a5/uploads/origins/47db9b17-0297-41ae-9fdd-9d2d3381bbf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=de9920067152424c41bf34c3a3726a17 2x, https://si.imgix.net/42b387a5/uploads/origins/47db9b17-0297-41ae-9fdd-9d2d3381bbf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a09bd92ac94c6a5d3f13206bacf4620e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42b387a5/uploads/origins/47db9b17-0297-41ae-9fdd-9d2d3381bbf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c84eed5b4f67e305ef4517741bc4fa7", "srcset": "https://si.imgix.net/42b387a5/uploads/origins/47db9b17-0297-41ae-9fdd-9d2d3381bbf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c84eed5b4f67e305ef4517741bc4fa7, https://si.imgix.net/42b387a5/uploads/origins/47db9b17-0297-41ae-9fdd-9d2d3381bbf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6ed4be25a3118feb559584d6e27c50dc 2x, https://si.imgix.net/42b387a5/uploads/origins/47db9b17-0297-41ae-9fdd-9d2d3381bbf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=05885c6dde2b9f3ec9356366e6bf42c9 3x"}, "body": "お世話になっております。リクエスト失礼します。\nスパイの少女が捕まり、終わらないくすぐり尋問を受ける...というシチュエーションのSSをお願いします。\n内容としては以下の感じです。\n\n・全裸で分娩台のようなものに拘束されており、尋問官と対面している。\n・尋問が始まり、マジックハンドで軽めにくすぐられる。\n・軽めのくすぐりに耐えられるかと油断していたが、いきなりマジックハンドの動きが速くなり、耐えられずに笑いだしてしまう。\n・「情報を話したくなったらいつでも呼びなよ」と少女を残してどこかへ行ってしまう。\n・数時間後、心が折れてしまった少女は尋問官を呼んでしまうが、その瞬間ボールギャグを付けられ話せなくなってしまう。\n・更にくすぐりが強くなり、股間に電マが当てられ尋問が続くが情報を話すことはできない。尋問官に「話せば楽になれるぞ」などと軽く煽られるが話すことはできない。延々と尋問は続いていく...\n\nという感じになります。\n具体的な内容や設定は書きやすいように一部改変していただいても構いません。\n\n内容としては以上になります。長くなりましてすみませんがご検討のほどよろしくお願いいたします。", "nc": 41, "word_count": 16366, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@omonove/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 1408450, "client_id": 91485, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fb86003e/uploads/origins/e9d8009a-fac2-48ef-91db-54b6c7961662?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b1f6d39ca8923e77fb2462f1cfae6af", "srcset": "https://si.imgix.net/fb86003e/uploads/origins/e9d8009a-fac2-48ef-91db-54b6c7961662?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b1f6d39ca8923e77fb2462f1cfae6af, https://si.imgix.net/fb86003e/uploads/origins/e9d8009a-fac2-48ef-91db-54b6c7961662?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11124e8cec3