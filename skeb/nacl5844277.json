ike to request illust for my oc ! \n\nIllust like a Lightcone from HSR \n\nCHARACTER \n\nLumina is elegant and peaceful girl. She is a cellist so I would like you to draw she playing cello or she sitting with her cello with sad eyes in her own room. \n\nThe atmosphere in the room looks lonely at night.\n\nI'd like to have another picture of her smiling\n\nThank you!\n\nReference : https://drive.google.com/file/d/1X_JAjLKckPF3AHvzzFh_c-5p4yY5qcqo/view \ndress : https://drive.google.com/file/d/1tmFuyUg5f-woR7LyuTjECCpmTiOw9dFV/view", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nacl5844277/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a022445b/uploads/origins/b4d124c3-5e33-4571-bfd6-99829bdad8f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b9fc68db37ce8539b5193efc69302ff8", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2764532, "client_id": 3060099, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@nacl5844277/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2764532, "client_id": 2685550, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a1d16006/uploads/origins/9a3dfce0-6f55-4914-a925-6f76340ee4c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96841b70682546b319c65507783e949f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a1d16006/uploads/origins/9a3dfce0-6f55-4914-a925-6f76340ee4c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=