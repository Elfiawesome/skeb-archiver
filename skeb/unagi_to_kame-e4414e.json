erでの活動、ファンクラブで時々配布しているデジタルグッズ(壁紙やネットプリント等)に使用させて頂きたいです。\n使用の際は、先生のTwitterアカウントをYouTubeの概要欄、もしくはTwitterのツイート文にクレジットさせて頂きます。\n\n■構図や要望\nYouTubeのサムネイルに使用させていただきたいので、お顔が良く見える構図だと嬉しいです。\n頭の先や髪の毛は、先端まで作画頂けますと大変嬉しいです。\n\n何卒、よろしくお願いします。\n\nhttps://lit.link/JxOdWfScAoZUfCvMyZN3T7Echer1", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unagi_to_kame/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3924906, "client_id": 3727055, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4cb7f576/uploads/origins/d28cdc52-ffa0-4eb5-9c22-4141d0b59066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc0c0caad95bfc26f42e914e18f4225f", "srcset": "https://si.imgix.net/4cb7f576/uploads/origins/d28cdc52-ffa0-4eb5-9c22-4141d0b59066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc0c0caad95bfc26f42e914e18f4225f, https://si.imgix.net/4cb7f576/uploads/origins/d28cdc52-ffa0-4eb5-9c22-4141d0b59066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7eb2a96763dbc99405e95f2e05df133f 2x, https://si.imgix.net/4cb7f576/uploads/origins/d28cdc52-ffa0-4eb5-9c22-4141d0b59066?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a9fcc81402d0b42390293988a1289b0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4cb7f576/uploads/origins/d28cdc52-ffa0-4eb5-9c22-4141d0b59066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e434c87798e8085eab43c1fb1c1dad02", "srcset": "https://si.imgix.net/4cb7f576/uploads/origins/d28cdc52-ffa0-4eb5-9c22-4141d0b59066?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e434c87798e8085eab43c1fb1c1dad02, https://si.imgix.net/4cb7f576/uploads/origins/d28cdc52-ffa0-4eb5-9c22-4141d0b59066?bg=%23fff&auto=format%2Ccompre