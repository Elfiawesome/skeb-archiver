gins/8aba340a-786c-4ab9-8fe4-2ae728be2151?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=06ba0818be9b3e9cb34d9e7fc72c1181 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71d1957b/uploads/origins/8aba340a-786c-4ab9-8fe4-2ae728be2151?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd3bbfabfdb0b980fe3d822c9b6ba46c", "srcset": "https://si.imgix.net/71d1957b/uploads/origins/8aba340a-786c-4ab9-8fe4-2ae728be2151?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd3bbfabfdb0b980fe3d822c9b6ba46c, https://si.imgix.net/71d1957b/uploads/origins/8aba340a-786c-4ab9-8fe4-2ae728be2151?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4c4ff5d50d8f2e866d754845c977d06a 2x, https://si.imgix.net/71d1957b/uploads/origins/8aba340a-786c-4ab9-8fe4-2ae728be2151?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7c974b863c9939d53d18d5baf8325aec 3x"}, "body": "はじめまして。\nタイムラインに流れてきたイラストが素晴らしく好みだったのでリクエストさせていただきます！\n\n描いていただきたいのは私のOCです。\nポーズ、構図、服装アレンジ等は全てお任せします。\n資料の女の子をお好きなように描いてください。\n\n使用用途は主にｱｲｺﾝ、ﾍｯﾀﾞｰへの使用です。\n\nお手数をお掛けしますがご検討頂けますと幸いです。\n\nhttps://drive.google.com/drive/folders/1hbPJQjOj9hMzmuPvto-sXdW8m8h1c3sn", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cosRUTAU/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3675634, "client_id": 1558477, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3aa90a3a/uploads/origins/2d916efb-d3ae-4b38-89d9-ed127763db6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=420056a458fc84f6dd2be468953623fa", "srcset": "https://si.imgix.net/3aa90a3a/uploads/origins/2d916efb-d3ae-4b38-89d9-ed127763db6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=420056a458fc84f6dd2be468953623fa, https://si.imgix.net/3aa90a3a/uploads/origins/2d916efb-d3ae-4b38-89d9-ed127763db6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2702ea6dacb519ef6e3e5cd97f100e26 2x, https://si.imgix.net/3aa90a3a/uploads/origins/2d916efb-d3ae-4b38-89d9-ed127763db6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=603e7b6283a792cf43daff422d557d07 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3aa90a3a/uploads/origins/2d916efb-d3ae-4b38-89d9-ed127763db6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0eccf0fc926fd0691c7014ba21df37cc", "srcset": "https://si.imgix.net/3aa90a3a/uploads/origins/2d916efb-d3ae-4b38-89d9-ed127763db6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0eccf0fc926fd0691c7014ba21df37cc, https://si.imgix.net/3aa90a3a/uploads/origins/2d916efb-d3ae-4b38-89d9-ed127763db6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2969b497f6557e9f600d46b44572a1df 2x, https://si.imgix.net/3aa90a3a/uploads/origins/2d916efb-d3ae-4b38-89d9-ed127763db6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=77c9419fa1b7de6ae4774366ec1ca489 3x"}, "body": "こすあーる様、こんにちは。この度は是非こすあーる様の絵柄で見たいと思ったキャラがいたので、ご依頼に参りました！ \nさて、今回は私のTRPG探索者「繭淵 うつつ（まゆぶち うつつ）」のイラストをご依頼したく存じます。用途は印刷物含む個人での鑑賞目的です。 具体的にはスマートフォンやPCの壁紙にしたり、部屋に飾ったりして楽しませて頂く所存です。\n\nキャラクターの詳細については下記に記載いたします。外見については資料URLをご覧ください。\n\n◇\n\n繭淵 うつつ（まゆぶち うつつ）\n男性/年齢22歳/172cm\n薄い色素の茶髪（潤色）/ややブラウン寄りの緑の瞳（亜麻色）\n\nとても虚弱な文系大学生。\n一般的な家庭に生まれ、ごく普通の人生を送ってきた。\n普通の、幸せな日々をおくるなかで何処か刺激が足りないと思っている。\n高校の頃、少しはみ出してみようとピアスを開けてみたが、何も変わらなかった。\n今も日々何かしらを求めて散歩をしている。\n\n「刺激を求めている」と言う割にビビりで臆病、拒絶の反応をだすが、裏面では喜んでいるかもしれない。なんかジェットコースターを泣きながら何回も乗りたがるやつ。Mではない。途中倒れるくせして毎年持久走大会に参加する奴。Mではない。\n\n一人称は“おれ”。\n\n（補足：『初恋性ストックホルム症候群』というシナリオのPCです。\n※書くにあたりシナリオを読むなどしなくて大丈夫です！知ってたらこの子についてわかりやすくなるだろうなという為の補足です！）\n\n服装は自由でも、フォルダ内にある「立ち絵」の服をそのまま書いても良いです！おまかせします。\n（自由に書く場合、できれば露出は控えめでお願いします。）\n\n◇\n\n等身かデフォルメかはおまかせします！\n可能であればキャラクターの透過PNGがあると嬉しいです。\n\nお忙しいところ恐縮ですが、何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/15iqnSigxC6VAcvgrCwVpYeEXEj-lE0FR?usp=share_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cosRUTAU/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3675634, "client_id": 1684532, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57bd2a25/uploads/origins/9b9adcaf-5258-4d50-8e53-e59e2cd0a1f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab074796411610fdc75b0d415c7c77fb", "srcset": "https://si.imgix.net/57bd2a25/uploads/origins/9b9adcaf-5258-4d50-8e53-e59e2cd0a1f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab074796411610fdc75b0d415c7c77fb, https://si.imgix.net/57bd2a25/uploads/origins/9b9adcaf-5258-4d50-8e53-e59e2cd0a1f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46078148ff2fb62b8aa1be7129904d90 2x, https://si.imgix.net/57bd2a25/uploads/origins/9b9adcaf-5258-4d50-8e53-e59e2cd0a1f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78032da39de7a877018db95e2f6b9235 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57bd2a25/uploads/origins/9b9adcaf-5258-4d50-8e53-e59e2cd0a1f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3f4765d3ad77e62cb5c11bae02fb0bb", "srcset": "https://si.imgix.net/57bd2a25/uploads/origins/9b9adcaf-5258-4d50-8e53-e59e2cd0a1f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3f4765d3ad77e62cb5c11bae02fb0bb, https://si.imgix.net/57bd2a25/uploads/origins/9b9adcaf-5258-4d50-8e53-e59e2cd0a1f4?bg=%23fff&auto=