x.net/20ae6069/uploads/origins/5057a264-1eab-4fa6-a58a-56ad67ba1fb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=866e047d03ec0dc746f0383b347b2a00, https://si.imgix.net/20ae6069/uploads/origins/5057a264-1eab-4fa6-a58a-56ad67ba1fb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f59cc32689d57a4a0d078cfa1a312eb 2x, https://si.imgix.net/20ae6069/uploads/origins/5057a264-1eab-4fa6-a58a-56ad67ba1fb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3e5b3453546d3ab34c5d56edc21cf50b 3x"}, "body": "お世話になっております！\nTS人魚系Vtuberのハルフゥ・ローレ・スカーライトと申します。\n本日ハロウィン風のイラストを依頼したいのですが具体的な案はなく前回海賊風でやったのでそれ以外の感じでお願いしたいです！\n全身イラストでポーズとかはお任せします(できれば棒立ち以外)\nサムネやおはブイなどで使いたいので背景透過もいただきたいです", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@I_love_TRPG/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 472548, "client_id": 757544, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6430f7ad/uploads/origins/6bd641d8-3e23-4f8c-bc79-3949fad83b56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12325cbcd18099ec4cf5d608d8e13518", "srcset": "https://si.imgix.net/6430f7ad/uploads/origins/6bd641d8-3e23-4f8c-bc79-3949fad83b56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12325cbcd18099ec4cf5d608d8e13518, https://si.imgix.net/6430f7ad/uploads/origins/6bd641d8-3e23-4f8c-bc79-3949fad83b56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ffe7bcbe378cbb7364d18cce9707907 2x, https://si.imgix.net/6430f7ad/uploads/origins/6bd641d8-3e23-4f8c-bc79-3949fad83b56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c00adce93f5151d98a3e9390a4a997ca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6430f7ad/uploads/origins/6bd641d8-3e23-4f8c-bc79-3949fad83b56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=411b833c20611dc6b7328b6e537b6c71", "srcset": "https://si.imgix.net/6430f7ad/uploads/origins/6bd641d8-3e23-4f8c-bc79-3949fad83b56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=411b833c20611dc6b7328b6e537b6c71, https://si.imgix.net/6430f7ad/uploads/origins/6bd641d8-3e23-4f8c-bc79-3949fad83b56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=79bcb03904623557836141ac483343a0 2x, https://si.imgix.net/6430f7ad/uploads/origins/6bd641d8-3e23-4f8c-bc79-3949fad83b56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b5e69b4dbb9a11bdcae01192fc729310 3x"}, "body": "れ･ω･そーさん、こんにちは。Skebでは初めまして。ShuāngyèWŭです。\n今回は私の持ちキャラであるツィト(ツィトロニア・K・アブリコート)の立ち絵を描いていただいたく、依頼させていただきます。\n\n以下、キャラ造形の詳細です。胸の大きさ以外は後述のキャラシの立ち絵画像を参照していただければ幸いです。\n・髪色はクロムイエロー。参考色は#fac40c。髪型は横髪のみ伸ばし、後は短く整えている。立ち絵参照。\n・瞳の色は右眼が紅色、左眼が青碧色。参考色は右眼が#d4143f、左眼が#45806b。\n・身長は166cm。スタイルは比較的良い。\n・バストはN~Oカップ。片胸が大体頭と同じ大きさが目安。\n・頭に近未来的なバイザーのようなものを着用している。キャラシの立ち絵画像のような感じで大丈夫です。\n・服装の詳細は立ち絵参照。多少アレンジしても構いませんが、身体にフィットした服であること、へそ出しであること、服の上にジャケットを羽織っていることは必須です。\n・ポーズは棒立ちでなければ自由です。キャラシの立ち絵画像のようでも大丈夫です。\n・表情は自然な微笑。キャラシの立ち絵画像のような感じです。\n\nその他、指定のない部分は自由にしてもらって構いません。よろしくお願いします。\n\n参考キャラシ:https://yutorize.2-d.jp/ytsheet/dx3rd/?id=KPh6Dj\n\nhttps://yutorize.2-d.jp/ytsheet/dx3rd/?id=KPh6Dj", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@I_love_TRPG/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 472548, "client_id": 1068618, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/68392b1c/uploads/origins/c29ff27c-4f17-45e7-8f98-c5caad5da305?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=031b99ad2892fb4209698754f85fe197", "srcset": "https://si.imgix.net/68392b1c/uploads/origins/c29ff27c-4f17-45e7-8f98-c5caad5da305?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=031b99ad2892fb4209698754f85fe197, https://si.imgix.net/68392b1c/uploads/origins/c29ff27c-4f17-45e7-8f98-c5caad5da305?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=555d523a4a3a220fd93e7c9e71cbc5c6 2x, https://si.imgix.net/68392b1c/uploads/origins/c29ff27c-4f17-45e7-8f98-c5caad5da305?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6b215bd106ffd1083ab93644a46e7fb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/68392b1c/uploads/origins/c29ff27c-4f17-45e7-8f98-c5caad5da305?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55a5ac232050d02b1cc6d2bd43d5f879", "srcset": "https://si.imgix.net/68392b1c/uploads/origins/c29ff27c-4f17-45e7-8f98-c5caad5da305?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55a5ac232050d02b1cc6d2bd43d5f879, https://si.imgix.net/68392b1c/uploads/origins/c29ff27c-4f17-45e7-8f98-c5caad5da305?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=516913c53318ebeb43b54318b0760696 2x, https://si.imgix.net/68392b1c/uploads/origins/c29ff27c-4f17-45e7-8f98-c5caad5da305?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0ca3020d1a34aed7bd58fa168cf3af27 3x"}, "body": "れ･ω･そー様、初めまして。\nいつもイラスト楽しませてもらっています。\n今回は私の新規PCである「石黒　伊織(イシグロ　イオリ)」の立ち絵を描いていただきたく、依頼させてもらいました。\n【今回依頼させていただく立ち絵の詳細】\n・黒い中折れ帽\n・黒いコート\n・OLとかが着てる感じの事務服\n・緑のシニヨンヘア\n・片目隠れ(対面から見て左側)\n・隠れた方の目にモノクル\n・青い目\n・ちょっと胡散臭い笑み\n\n指定していない部分は自由にしてもらって構いませんので、よろしくお願いいたします。\n\nhttps://x.com/yonetsuka_/status/1967966222705918053?s=46&t=dtoCMului9ga3dTpAk4y1Q", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@I_love_TRPG/works/3", "private_thumbnail_