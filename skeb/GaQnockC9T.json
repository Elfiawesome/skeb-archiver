ivate": false, "genre": "art", "tipped": false, "creator_id": 3480697, "client_id": 3255920, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a3ed8b08/uploads/origins/5ebb963b-5d1f-4506-ae63-b5cfc1e9854a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=baf613eb9fb5deb2f6e9410c8dca3c48", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a3ed8b08/uploads/origins/5ebb963b-5d1f-4506-ae63-b5cfc1e9854a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1295d132bda9cddf47d0c3f693182e3", "src_set": ""}, "body": "水晶体さま\n\nはじめまして！\nskebの新着で拝見したイラストがとても素敵でしたので、OCのイラストをリクエストさせていただけませんでしょうか。\n\n【キャラクター】\n資料：https://drive.google.com/drive/folders/1R5SrAqROYAMp-48L_SCO4BJI7dCTZwco?usp=drive_link\n一度怪物によって滅ぼされた世界で、人類のために怪物と戦う軍人の少女です。\nモチーフはタロットカードの審判、音楽、二面性、天使です。\n\n服装や構図等はお任せします。資料衣装に変更を加えていただいても構いません。\n使用用途としては、SNSでのアイコン・ヘッダー使用、個人的鑑賞の範囲での印刷、他のリクエスト時の資料提出を考えています\n\n依頼内容・金額に不足があれば、キャンセル・再送依頼いただければと思います。\nご検討よろしくおねがいいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@GaQnockC9T/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3480697, "client_id": 3486041, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dbc6de6e/uploads/origins/9857df1e-3409-485c-866b-f78ed04a413f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fd3ef3fc568be101ca51736262140a3e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dbc6de6e/uploads/origins/9857df1e-3409-485c-866b-f78ed04a413f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3540aa2658b79a09f8512c6c771ae119", "src_set": ""}, "body": "こんばんは依頼失礼します🙏\n水晶体さんのイラストがものすごくほんとにいろんな絵師さんがいる仲で1番大好きです。\n\nそれで初めて人に有償依頼をするので色々とおかしい点があると思いますがお許しください🙇\n\n今回依頼させていただくのはスマホの壁紙用に水晶体さんのイラストを貼りたく鑑賞用として依頼をしております。\n\nなにかリクエストとかをするらしいですがそう物がわからない全体的におまかせでお願いします🙏\n\nサイズは9:19.5でお願いします🙏\n\nデザイン資料はちゃんとしたのがなくて申し訳ないのですがこの様な感じの子です🙏\n\n水晶体さんのイラスト楽しみにしてます!!!!\n\nhttps://oran.ski/notes/9ytt49l2rg", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 14979, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "space kyo | skeb募集中", "screen_name": "kyotyanehh", "avatar_url": "https://pbs.twimg.com/profile_images/1470587419778949123/KvGbkFrp.jpg", "header_url": "https://pbs.twimg.com/profile_banners/367709020/1635944341/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 16}, {"id": 1843330, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "333", "screen_name": "dai210924", "avatar_url": "https://pbs.twimg.com/profile_images/1517161999523741701/7plkxBLL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1390248900267708419/1747811102/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 176}, {"id": 2017661, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "セリザワ4%(2)", "screen_name": "0u0_mgmgtime", "avatar_url": "https://pbs.twimg.com/profile_images/1647393638614437888/RPsZXMzy.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1521119675358228482/1703944659/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre