ins/9c503c2d-fdf9-4df9-88c7-51701424e491?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5a642c7ea210f6b02a11daf6cf917db5 2x, https://si.imgix.net/6ddf2b09/uploads/origins/9c503c2d-fdf9-4df9-88c7-51701424e491?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a7afba51807d011dd4338f04074ed8a6 3x"}, "body": "初めまして、キャラ指名込みかつ、とても描いてみたいという熱意の籠ったアピールを頂いたので、リクエストさせていただきます。\n\n\n・キャラクター\nご指名頂いたコミッション用のオリジナルキャラです。\n想夜\n\nhttps://seesaawiki.jp/ageha_commission/d/%c1%db%cc%eb\n\nキャライメージはヴィジュアル系女形（女装男子）。\n見た目や仕草、声は女性的だが口調は男。\n\n\n・シチュエーション\n着衣状態で男の上に跨っているアナル騎乗位の構図で、結合部はスカートで隠れているため見えない、所謂「見えないけど絶対入ってるよね」なシチュエーション。\nイメージはグーグル画像検索で「着衣　騎乗位　イラスト」で出てくる様な物のうち、完全に着衣でおっぱいはもちろん、下着も見えていないタイプのものです。\n想夜には妖艶かつエッチな表情と、やはりエッチな仕草をさせて頂けると幸いです。\n構図は可能であれば画像検索で出てくるものの様に騎乗位されてる男からの主観視点を希望ですが、描きやすい形で構いません。\n服装は、制服姿でもステージ衣装姿でも大福黒団子さんが描きたいと思った方の服装で構いませんし、この服が似合いそうっていう服があれば新たにデザインして頂いても構いません。\n\n・その他\n不明点、不自然な点は自由にアレンジしていて構いません。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kk63599947/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1412691, "client_id": 1572219, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/71233162/uploads/origins/91ba1216-0fc3-44c0-b907-7f52adcca2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=263c49e3b71d53916b293b216f0178fa", "srcset": "https://si.imgix.net/71233162/uploads/origins/91ba1216-0fc3-44c0-b907-7f52adcca2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=263c49e3b71d53916b293b216f0178fa, https://si.imgix.net/71233162/uploads/origins/91ba1216-0fc3-44c0-b907-7f52adcca2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5856f3c10df9dec5371142dcb0a8aa3a 2x, https://si.imgix.net/71233162/uploads/origins/91ba1216-0fc3-44c0-b907-7f52adcca2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e16739d411f4e09162446c13a72f2071 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71233162/uploads/origins/91ba1216-0fc3-44c0-b907-7f52adcca2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52feaa60b4a7a1cb11eff80c30175e5a", "srcset": "https://si.imgix.net/71233162/uploads/origins/91ba1216-0fc3-44c0-b907-7f52adcca2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52feaa60b4a7a1cb11eff80c30175e5a, https://si.imgix.net/71233162/uploads/origins/91ba1216-0fc3-44c0-b907-7f52adcca2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=025be18a1f226801d9e8061718cacdfb 2x, https://si.imgix.net/71233162/uploads/origins/91ba1216-0fc3-44c0-b907-7f52adcca2e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=174b7b0b630afb2aa7e9c1c20a0b6b9f 3x"}, "body": "アピールありがとうございます。私のキツネの男の子「いろは」と「夜空」の絵をお願いしたいです。\n\n二人がセックスしているところを描いてほしいです。いろはは自己主張が強い性格で、自分からセックスを仕掛けることが多いのですが、される側の方が好きなようです。夜空は従順な性格で、挿入される側を好みますが、いろはにいじられすぎると主導権を握られることもあるようです。具体的にはお任せします。夜空がいろはにつけたキスマークも見てみたいです。\n\nありがとうございます。\n\nhttps://imgur.com/a/6mLCqrn", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kk63599947/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1412691, "client_id": 1736458, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0ce921ab/uploads/origins/f0cf7d90-376f-4b46-a7f8-89fc88c6c00c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7493812c680dce41439d851a1bb1e814", "srcset": "https://si.imgix.net/0ce921ab/uploads/origins/f0cf7d90-376f-4b46-a7f8-89fc88c6c00c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7493812c680dce41439d851a1bb1e814, https://si.imgix.net/0ce921ab/uploads/origins/f0cf7d90-376f-4b46-a7f8-89fc88c6c00c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3be68553eee373569100663b7dc9fd63 2x, https://si.imgix.net/0ce921ab/uploads/origins/f0cf7d90-376f-4b46-a7f8-89fc88c6c00c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2240292156609515ebb9797d67cdcdc 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0ce921ab/uploads/origins/f0cf7d90-376f-4b46-a7f8-89fc88c6c00c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1639715cb6a45f1a5d1226072e798218", "srcset": "https://si.imgix.net/0ce921ab/uploads/origins/f0cf7d90-376f-4b46-a7f8-89fc88c6c00c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1639715cb6a45f1a5d1226072e798218, https://si.imgix.net/0ce921ab/uploads/origins/f0cf7d90-376f-4b46-a7f8-89fc88c6c00c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2c5203c69a82093423a656cac0e9a901 2x, https://si.imgix.net/0ce921ab/uploads/origins/f0cf7d90-376f-4b46-a7f8-89fc88c6c00c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6df6aed5b9b39c52419f0162387e99af 3x"}, "body": "かなり性癖の強いリクエストになりますがよろしいでしょうか。\nうちの子（女装したはしござけ）がハゲデブのおっさんの妻にさせられて、教会で参列者の眼前でおっさんに公開SEXするというテーマでお願いします。おっさんはハゲデブで脂ぎっててキモそうというのが伝われば（参列者も）ラフスケッチ程度でかまいません。背景もチャペルっぽいということが伝わる最低限のもので構いません。うちの子は資料のレオタード（色は純白、胸の文字も再現）を着用し、白のウェディングヴェール、グローブ、ストッキングを着用。レオタードの布越しに勃起した乳首が浮いて出てます。おっさんに背面座位（幼児のおしっこポーズ）で抱きかかえられ、レオタードの股間の布をずらされ（淫紋がちら見え）、アナルにおっさんのぶっとい一物をねじ込まれています。うちの子のペニスはぎんぎんに勃起し（絵師さんの過去絵より一回り大きく）、先端からはところてんでダラダラと射精し続けています。それをシャンパングラスで受け止め、おっさんはSEXしながら美味しそうにうちの子の精液を味わっています。\nうちの子は両脚を大きく開かれているので結合部が参列者に丸見えで「皆が見てる…恥ずかしい」という感情と「憧れのお嫁さんになれた」という感情が入り混じった恍惚とした表情と虚ろな目（♡）をしています。\nもし差分が可能であれば、背景をチャペルの玄関前に統一していただき、チャペルから結合したまま外へ出てきたところを参列者のフラワーシャワーならぬ顔面シャワーで祝福され、見知らぬ他人の精液まみれになって幸せそうにイクところも追加できれば幸いです。「こんなにいっぱい・・・誰の精液で妊娠したのか、分からなくなっちゃう・・・♡」\n資料は自分の女装写真です、局部とかは写っていませんが三次女装ですのでお嫌でしたら見ずに依頼を拒否して頂いても構いません。\n\nhttps://www.dropbox.com/scl/fo/aq46iim9b3tm0i6y05x4j/h?dl=0&rlkey=ewmoawt4sqfyv0ziaunhss1l4", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kk63599947/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1412691, "client_id": 82435, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a3b45196/uploads/origins/dfbd8d7f-5db6-4ee4-8c92-e8feca50b97e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=744a101807292907e69da87bdaee8107", "srcset": "https://si.imgix.net/a3b45196/uploads/origins/dfbd8d7f-5db6-4ee4-8c92-e8feca50b97e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=744a101807292907e69da87bdaee8107, https://si.imgix.net/a3b45196/uploads/origins/dfbd8d7f-5db6-4ee4-8c92-e8feca50b97e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c21bbc32c4ef23bd51aeb69162325e0 2x, https://si.imgix.net/a3b45196/uploads/origins/dfbd8d7f-5db6-4ee4-8c92-e8feca50b97e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c212e7daded3fac56ff8107de61326e0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a3b45196/uploads/origins/dfbd8d7f-5db6-4ee4-8c92-e8feca50b97e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf0106f64e25e4bbb89acac0bfd00286", "srcset": "https://si.imgix.net/a3b45196/uploads/origins/dfbd8d7f-5db6-4ee4-8c92-e8feca50b97e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf0106f64e25e4bbb89acac0bfd00286, https://si.imgix.net/a3b45196/uploads/origins/dfbd8d7f-5db6-4ee4-8c92-e8feca50b97e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f743b1236891d586c7280f5c287b9bbc 2x, ht