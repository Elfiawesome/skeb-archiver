de16b715677ce19abc 2x, https://si.imgix.net/2488994f/uploads/origins/0fed4897-68b2-4868-af09-961f40f5b176?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4f521b6e7dab8dfd8a9594d6d94a0ff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2488994f/uploads/origins/0fed4897-68b2-4868-af09-961f40f5b176?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d33a300cc6aedbe3b4700c5230bb278", "srcset": "https://si.imgix.net/2488994f/uploads/origins/0fed4897-68b2-4868-af09-961f40f5b176?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d33a300cc6aedbe3b4700c5230bb278, https://si.imgix.net/2488994f/uploads/origins/0fed4897-68b2-4868-af09-961f40f5b176?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2b3fa886eba5a2fcc08a4c2951e5563f 2x, https://si.imgix.net/2488994f/uploads/origins/0fed4897-68b2-4868-af09-961f40f5b176?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=61deaea3451973f2bf3f3f020b607977 3x"}, "body": "しみこみ山様、こんばんは。\n前回は素敵な作品をありがとうございました！何度見返しても美しいタッチにうっとりしてしまうほどで、ずっと大事にさせて頂いています。\nそこで、再度しみこみ山様にOCを描いて頂きたいと思い今回またお願いに上がりました。\n\n可能であれば、しみこみ山様が描きやすい方を雪鶴・駒鳥からどちらか選んで頂ければと思います。\nどちらも是非ともしみこみ山様のイラストで見てみたい！と思っているので、本当にどちらを選んで頂いても構いません。\nもしもこういった選んで頂く形式が不可であれば、遠慮なく再送・キャンセルを頂ければと思います。\n\n資料に関して、数が多いので全て見ずとも必要に応じて利用なさってください。\n\n着色に関しても、カラー・モノクロどちらも大変好みで魅力的だと思っているのでどちらでも大丈夫です！しみこみ山様のやりやすい形式や表現したいものに合致する形を取って頂ければ嬉しいです。\n\nもしも金額や資料の不備不足、あるいはなにか不手際がございましたらお手数ではありますがキャンセル・再送をいただけると助かります。\n何卒ご検討をよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1MBSaOyBxXJu0aMi8fnWeLdXTrT4LxzNV", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Shimikomi_yama/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3759711, "client_id": 3775497, "vtt_ur