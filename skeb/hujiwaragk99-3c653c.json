ads/origins/e40d0fd1-5c4c-47c2-aafc-7bf9eb7ae7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cedc736a3d857a39ebcdbb71624430f5", "srcset": "https://si.imgix.net/97474c64/uploads/origins/e40d0fd1-5c4c-47c2-aafc-7bf9eb7ae7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cedc736a3d857a39ebcdbb71624430f5, https://si.imgix.net/97474c64/uploads/origins/e40d0fd1-5c4c-47c2-aafc-7bf9eb7ae7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7b2939088146b7e329bcea8e82ea0dc8 2x, https://si.imgix.net/97474c64/uploads/origins/e40d0fd1-5c4c-47c2-aafc-7bf9eb7ae7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eb1fe7616f3bfe065074fc42426fed62 3x"}, "body": "リクエストおねがいします。\n前回の肥満化強制施設ありがとうございます。\n\n今回は使ったスパイをスイーツ責めによる中毒化で再起不能にする施設。\nある時から捕まったスパイは、数ヶ月後に無傷で解放する事になっている。\n再発を防ぐため収容している間にスパイを太らせ、かつスイーツがないとダメな感じなってしまい、その後のダイエットも非常に難しい。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hujiwaragk99/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3466644, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0bfbe626/uploads/origins/128fbbd1-1cf2-43bb-9dce-b4c04a1317f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e41ac260bcbe510f4d4904319edd5521", "srcset": "https://si.imgix.net/0bfbe626/uploads/origins/128fbbd1-1cf2-43bb-9dce-b4c04a1317f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e41ac260bcbe510f4d4904319edd5521, https://si.imgix.net/0bfbe626/uploads/origins/128fbbd1-1cf2-43bb-9dce-b4c04a1317f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=84006a626598e9bd9fedb5b0b0f7dd56 2x, https://si.imgix.net/0bfbe626/uploads/origins/128fbbd1-1cf2-43bb-9dce-b4c04a1317f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b06efdeaf86bb91975caeb5301068727 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0bfbe626/uploads/origins/128fbbd1-1cf2-43bb-9dce-b4c04a1317f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b26721a0a3b3a2f2e8c61587fc6389a", "srcset": "https://si.imgix.net/0bfbe626/uploads/origins/128fbbd1-1cf2-43bb-9dce-b4c04a1317f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b26721a0a3b3a2f2e8c61587fc6389a, https://si.imgix.net/0bfbe626/uploads/origins/128fbbd1-1cf2-43bb-9dce-b4c04a1317f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=05df86b9a0a05738ef5dd26c2a1d4c74 2x, https://si.imgix.net/0bfbe626/uploads/origins/128fbbd1-1cf2-43bb-9dce-b4c04a1317f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4de10f1180f9ec33d13daeae0e080ccb 3x"}, "body": "はじめまして、藤原さん。\nあなたの癖が気になり、自分の性癖と合わせたいと思いリクエストさせていただきます。\n\n【キャラ】\n花嫁（20代、黒髪短髪。おだやかそうに見えるが守銭奴な性格。罪状：結婚詐欺、横領、公務執行妨害）\nウェディングドレスは以下のイメージ（https://i.pinimg.com/1200x/65/e2/04/65e204ec9bf47c04849598e0c35faafc.jpg）\n【内容】\n控え室で幸せそうに佇む花嫁。そこに警察が入ってきて上記の罪状を読み上げる。怖くなった花嫁は警察に危害を加え、ご祝戯袋の入ったバッグを抱えて逃走。住宅街まで逃げるが、女性警官に捕まり、地面に倒されてしまう。\n手錠をかけられ、泣きながらパトカーに押し込まれ、ドレスのまま檻の中に入れられる。\nその後、ニュースで結婚式中の花嫁、結婚詐欺で逮捕と報道され、写真も載せられる。\n\n可能なら、セリフなし差分もお願いしたいです。\n\nhttps://i.pinimg.com/1200x/65/e2/04/65e204ec9bf47c04849598e0c35faafc.jpg", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hujiwaragk99/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3466644, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e4f8e71f/uploads/origins/0feffa09-d6a4-45f5-959a-42255da90872?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2c8592cbccd4fa9658603c3019aa13d", "srcset": "https://si.imgix.