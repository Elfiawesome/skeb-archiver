氏名：烏兎院　彗（うといん　けい）\n年齢：18歳\n\n[ストーリー］\n私のOCは、誰もいないオフィスで機密書類を盗むというミッションを遂行中です。 その書類を手に入れた時、突然警察が現れる。抵抗して逃げようとするが、結局逮捕されてしまう。その後、彼女は囚人服を強制的に着せられ、投獄されるのストーリー。\n\nマンガの詳細は先生にお任せします！できれば、囚人ファイルのページで、私のOCのマグショットに色を塗っていただけませんか？ お忙しい中、本当にありがとうございました！", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hujiwaragk99/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3466644, "client_id": 1371313, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3917c183/uploads/origins/29ba1950-5d0a-407c-a084-93700fed4262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bd908e948c42b3555355eba05ad99fd", "srcset": "https://si.imgix.net/3917c183/uploads/origins/29ba1950-5d0a-407c-a084-93700fed4262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9bd908e948c42b3555355eba05ad99fd, https://si.imgix.net/3917c183/uploads/origins/29ba1950-5d0a-407c-a084-93700fed4262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9cfbb6bc473115394ee0757305c33476 2x, https://si.imgix.net/3917c183/uploads/origins/29ba1950-5d0a-407c-a084-93700fed4262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41b16f71fc5db0b82e8673fd012c3691 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3917c183/uploads/origins/29ba1950-5d0a-407c-a084-93700fed4262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c83ceb7dfd755d3fca683dcfaa54b224", "srcset": "https://si.imgix.net/3917c183/uploads/origins/29ba1950-5d0a-407c-a084-93700fed4262?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c83ceb7dfd755d3fca683dcfaa54b224, https://si.imgix.net/3917c183/uploads/origins/29ba1950-5d0a-407c-a084-93700fed4262?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=2