n\n◎依頼内容\nつくよちゃんと私の関係性のある二人組(あおりる・会長補佐・ゆるふわ・沢樫兄妹)を一枚に収めてほしいです…！\n書いててむちゃくちゃな依頼だなと思ったので、構図的に難しそうだったら2枚(あおりると会長補佐・ゆるふわと沢樫兄妹)とかそれぞれバラバラとかに分けてもらえたら嬉しいです…！描きやすいように描いてください！\n資料は一応あのココフォリア部屋に全部あるけど、多分見るのが大変だと思うから自探索者の分だけでもまとめたリンクも貼っておきます！\n・構図、背景の有無はお任せします！でもつくよちゃんのカラフルで可愛くてキラキラした絵が好きなので、明るい雰囲気のイラストだと嬉しい！\n・サイズはPCのデスクトップにしたいので横長(16:9)がいいな…！と思っていますが、縦長でもスマホの壁紙にするので問題ないです！\n\n不都合あったらキャンセルお願いします！\nみんな大好きだからまた遊んでね～～～～～～～～！！！！！😭😭\n\nhttps://drive.google.com/drive/folders/17HK8X-sYaoPt92s8By985dxCz4urC0hr", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 256, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "筆禍＠ぴかすすちゃん発売中", "screen_name": "hikka06", "avatar_url": "https://pbs.twimg.com/profile_images/2062499802882232320/REN7JKt9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/85097065/1737786245/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 90, "skills": [{"genre": "comic"}], "banned": false, "nc": 32}, {"id": 1314046, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ゆれ", "screen_name": "mr_ayarabbit", "avatar_url": "https://pbs.twimg.com/profile_images/1663553167748104194/ibT862Ug.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 35, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 2724903, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "1ch10@skeb✍️", "screen_name": "1ch10_one", "avatar_url": "https://pbs.twimg.com/profile_images/1654346322768699392/ikO85uip.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1