200&s=535f24a0b78effd9cf5c150757f1b32d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c71c242/uploads/origins/7a93c8f5-9265-4b02-ae0d-2a9c344ccf49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c61cd479b06ae81fdfa75abf9235814", "srcset": "https://si.imgix.net/2c71c242/uploads/origins/7a93c8f5-9265-4b02-ae0d-2a9c344ccf49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c61cd479b06ae81fdfa75abf9235814, https://si.imgix.net/2c71c242/uploads/origins/7a93c8f5-9265-4b02-ae0d-2a9c344ccf49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e7f43d12f83b6b9690bc4b5d8b457456 2x, https://si.imgix.net/2c71c242/uploads/origins/7a93c8f5-9265-4b02-ae0d-2a9c344ccf49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5ffc0af57d3ae6fede5932816c63ac91 3x"}, "body": "はじめまして！\nずっとぬりえさんの絵が好きで描いていただきたいと思っていました！\n\n顔立ち…細めのタレ目でまつ毛が長めで、目の色は黒か紫(おまかせ)、眉は平行なタレ眉\n髪…前髪は目くらいのぱっつん、横毛は耳くらいの姫カット、後ろ髪は胸上くらいまでの長さ、黒髪\n体型…身長普通くらいで体型は少しむちむち、平均より少し大きい(Dカップくらい？)胸のサイズで\n服装…白ドレス、デザインはお任せします\nアクセサリー…耳たぶに1つピアス、他の部分は多めについてると嬉しいです\nイラストのテーマ…失恋をテーマにおまかせしたいです\nポーズ…おまかせ\n\nおまかせが多くてすみません。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nurie_7/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3850216, "client_id": 115183, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b3702468/uploads/origins/5673852f-8f4c-4e38-98a4-fb2e27b06106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3349c91eb835eb04aafe86d2c14f9c7d", "srcset": "https://si.imgix.net/b3702468/uploads/origins/5673852f-8f4c-4e38-98a4-fb2e27b06106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3349c91eb835eb04aafe86d2c14f9c7d, https://si.imgix.net/b3702468/uploads/origins/5673852f-8f4c-4e38-98a4-fb2e27b06106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=307c67cc30caad93ccf8f267cabcf458 2x, https://si.imgix.net/b3702468/uploads/origins/5673852f-8f4c-4e38-98a4-fb2e27b06106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3dc6dec126887639f177e564129cd545 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3702468/uploads/origins/5673852f-8f4c-4e38-98a4-fb2e27b06106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3564a59f3b44f68bc5419924ad92a47", "srcset": "https://si.imgix.net/b3702468/uploads/origins/5673852f-8f4c-4e38-98a4-fb2e27b06106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3564a59f3b44f68bc5419924ad92a47, https://si.imgix.net/b3702468/uploads/origins/5673852f-8f4c-4e38-98a4-fb2e27b06106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a78da7bfdd4920cc5b2d7a72a3e54c7b 2x, https://si.imgix.net/b3702468/uploads/origins/5673852f-8f4c-4e38-98a4-fb2e27b06106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d1adfeac09aacc16dc70a06fae378baf 3x"}, "body": "はじめまして。えーじぇんとと申します！\nぜひ、うちの娘をリクエストさせていただきたいです。\n\n大正ロマンを彷彿とさせる和服を着た、ジト目パッツン黒髪の物静かな娘です！\n\n【キャラクターの性格など】\n・ハイカラなものが好き\n・無表情だけど様々なものに関心がある\n・人柱として生贄に捧げられた過去を持つ。今は人々のちいさな願い事を叶える神様のような存在\n\n上記のような設定もありますが思いのまま描いて頂けると嬉しいです！\nどうぞご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1MOrTrvMFxGZ-CqtlMP6iinYm1cURwlaC?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nurie_7/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3850216, "client_id": 2940141, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/881a6793/uploads/origins/b150c853-4c25-44e8-bff5