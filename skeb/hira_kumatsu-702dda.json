gix.net/85e5f0f4/uploads/origins/3292e2fd-c180-4bc3-9a7a-978846d01ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79e525ec155b0d32de9cc07520ac935a 2x, https://si.imgix.net/85e5f0f4/uploads/origins/3292e2fd-c180-4bc3-9a7a-978846d01ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bbc5d50df10f9a5318fc825251f7bd50 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/85e5f0f4/uploads/origins/3292e2fd-c180-4bc3-9a7a-978846d01ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8dedb510b2a3419ec341135716b7998d", "srcset": "https://si.imgix.net/85e5f0f4/uploads/origins/3292e2fd-c180-4bc3-9a7a-978846d01ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8dedb510b2a3419ec341135716b7998d, https://si.imgix.net/85e5f0f4/uploads/origins/3292e2fd-c180-4bc3-9a7a-978846d01ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=27175a4263174f6631d801a9c5f37a00 2x, https://si.imgix.net/85e5f0f4/uploads/origins/3292e2fd-c180-4bc3-9a7a-978846d01ddc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=50f1195a8107bb106bfe64247985adcd 3x"}, "body": "初めまして！\n𝘩𝘪𝘳𝘢𝘮𝘢𝘵𝘴𝘶さんの素敵な黒の使い方と絵の表現にとても惹かれ、この度是非とも𝘩𝘪𝘳𝘢𝘮𝘢𝘵𝘴𝘶さんの作風でTRPGのオリジナルキャラクターを2人描いて頂きたくリクエストに参りました。（シナリオのネタバレはありません）\n\n▼詳細\n・シン（金髪の男）\n35歳　身長は182cm、夜目が利く金の瞳。\n優れた軍人であり、国の為に動くストイックさと統率力、状況判断力に長けていると同時に、頼りがいがあり、面倒見の良い兄のような一面も兼ね備えている。\n精神が強くそう簡単に折れないが、ルカの策略に振り回され、大切な物を失っていく。\n呪いをかけられたとて、進み続けなければいけない男。\n\n・ルカ（ピンク髪の男）\n34歳　身長は178cm、右目は青い宝石の義眼。\n表情は笑顔が多く、芝居がかった喋り方をする事も多い。\n非常に頭が良いギフテッドであり、自身の目的達成の為であれば手段を選ばない。\nリスクとリターンを天秤にかけた際、リターンが大きい場合自身を害する事も辞さない。\nまた他人を凋落することが上手く、甘言で相手を誘いこちらの手足とするなど言葉に寄る他者操作能力に長けている。\n\nシンと対峙する事が何より好ましく、その為に戦争を引き起こしていることがある。\nどちらかと言えば呪いをかけて勝ち逃げする側。\n\n\n▼イメージ参考要素\n・狼と魔術師、フェンリルとオーディン、血と戦争、悪魔\n\n因果に囚われ共に堕ちていく戦争の獣と悪魔のような2人です…\n\n＿＿＿＿＿＿\n\nポーズやシチュエーション等の指定はありません。\n細かな装飾なども省いていただいて構いません。\n𝘩𝘪𝘳𝘢𝘮𝘢𝘵𝘴𝘶さんのイラストと世界観が大好きなので、どうか好きなように描いて頂けたらと思います！\nPSD納品の際、宜しければ宛名は別のレイヤーに記入して頂けると嬉しいです…！\n\n使用用途としては個人的な鑑賞や携帯の待受に使用したいと考えています。\n何か失礼がありましたら申し訳ありません、もし難しいようでしたら断わって頂いて構いません！\nご検討の程、何卒宜しくお願いします。\n\nhttps://drive.google.com/drive/folders/1KfhvNBfsHtZDmOO4k4qgP1JGSi58ZKnk?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hira_kumatsu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2248994, "client_id": 645977, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fd39a5d3/uploads/origins/886b3c5c-82a3-4323-8bc3-79560d5d76c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7863c84eca32b67ca041f79213262f6a", "srcset": "https://si.imgix.net/fd39a5d3/uploads/origins/886b3c5c-82a3-4323-8bc3-79560d5d76c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7863c84eca32b67ca041f79213262f6a, https://si.imgix.net/fd39a5d3/uploads/origins/886b3c5c-82a3-4323-8bc3-79560d5d76c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=365bbb295890ec0e76248b08a700bf51 2x, https://si.imgix.net/fd39a5d3/uploads/origins/886b3c5c-82a3-4323-8bc3-79560d5d76c7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af9fcfb06df887d59a8d3f02b19a2b12 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fd39a5d3/uploads/origins/886b3c5c-82a3-4323-8bc3-79560d5d76c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa1d20972843f45efa86709dadd4bf88", "srcset": "https://si.imgix.net/fd39a5d3/uploads/origins/886b3c5c-82a3-4323-8bc3-79560d5d76c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa1d20972843f45efa86709dadd4bf88, https://si.imgix.net/fd39a5d3/uploads/origins/886b3c5c-82a3-4323-8bc3-79560d5d76c7