op&w=200&h=200&s=3c7c338d16c690bcb756a23d5e5f7919", "srcset": "https://si.imgix.net/ba8ab3eb/uploads/origins/f4f6ee98-eeff-4779-9e13-ade2d3265347?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c7c338d16c690bcb756a23d5e5f7919, https://si.imgix.net/ba8ab3eb/uploads/origins/f4f6ee98-eeff-4779-9e13-ade2d3265347?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40679dff04cab2bd0f380be1a2e7dc57 2x, https://si.imgix.net/ba8ab3eb/uploads/origins/f4f6ee98-eeff-4779-9e13-ade2d3265347?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea7d204d85702ace25376d0be13718da 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba8ab3eb/uploads/origins/f4f6ee98-eeff-4779-9e13-ade2d3265347?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de6ffea70d8ba1969d8f873ec476eb92", "srcset": "https://si.imgix.net/ba8ab3eb/uploads/origins/f4f6ee98-eeff-4779-9e13-ade2d3265347?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de6ffea70d8ba1969d8f873ec476eb92, https://si.imgix.net/ba8ab3eb/uploads/origins/f4f6ee98-eeff-4779-9e13-ade2d3265347?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=22173503c2873fc04cd81cf4bde06b3c 2x, https://si.imgix.net/ba8ab3eb/uploads/origins/f4f6ee98-eeff-4779-9e13-ade2d3265347?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1cb3f5edfc00f13a069701640b46067c 3x"}, "body": "凪海さん、こんにちは.エンディング後のスピンオフを作ってみましょう！というわけで、リクエストはこちらです：\n\n小悪魔が紅魔館の住人たちに状況を伝えなかった罰として、レミリア・スカーレットは小悪魔を紅魔館の住人たちの便器にすることに決めた。これからは永遠に、レミリア・スカーレット、\n紅美鈴、そしてパチュリー・ノーレッジが小悪魔を便器として使うことになる！ レミリア・スカーレット、\n紅美鈴、パチュリー・ノーレッジは、十六夜が彼女たちの最愛の友人であるため、小悪魔に怒り、小悪魔に小便や大便、おならを食べさせる。しかし、彼女たちが日常の活動の中でそれを行っている設定にしよう。例えば、紅美鈴を見てみると、彼女は門番をしている最中に小悪魔を使っている。パチュリー・ノーレッジは、本を読んでいる時や図書館で小悪魔を使っている。パチュリー・ノーレッジは、くつろいでお茶を飲んでいる時などに小悪魔を使っている。\n\n特に、おなら、アナル舐め、排便のシーンに重点を置きましょう。おしっこのシーンも作れますが、3人のふたなり娘たちが一斉に「小悪魔」に自分たちのおしっこを飲ませるという短いシーンに留め、あまりスペースを取らないようにしましょう。また、セックスシーンの時間を確保するために、ストーリー部分は削りましょう！\n\nいつものように、ふたなり娘たちは得意げな様子で、小悪魔に腹を立てているため少し怒っている。一方、小悪魔は絶望的でショックを受けている。\n\nよろしくお願いします！", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nagi1_4/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3885604, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1ae4b4ed/uploads/origins/afd7211a-2ce7-429e-a9ed-00ba6ca812bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1dc050aa7fa31ef0948a9cce50775f7", "srcset": "https://si.imgix.net/1ae4b4ed/uploads/origins/afd7211a-2ce7-429e-a9ed-00ba6ca812bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1dc050aa7fa31ef0948a9cce50775f7, https://si.imgix.net/1ae4b4ed/uploads/origins/afd7211a-2ce7-429e-a9ed-00ba6ca812bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f8877ca53d6c25419fc2a27c5550550 2x, https://si.imgix.net/1ae4b4ed/uploads/origins/afd7211a-2ce7-429e-a9ed-00ba6ca812bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ad5194fdec9f26f458f57e1890fd34c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ae4b4ed/uploads/origins/afd7211a-2ce7-429e-a9ed-00ba6ca812bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1398c2eab13488dd613490f5c8f073a", "srcset": "https://si.imgix.net/1ae4b4ed/uploads/origins/afd7211a-2ce7-429e-a9ed-00ba6ca812bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1398c2eab13488dd613490f5c8f073a, https://si.imgix.net/1ae4b4ed/uploads/origins/afd7211a-2ce7-429e-a9ed-00ba6ca812bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9e6d74ed0a31769575c3