ル立ち絵\nhttps://drive.google.com/file/d/1in-K_Jv_0KKnjQqpPo6QBea6CQGuuK1D/view?usp=drivesdk\n\nワンダフルと仲間たち（木漏れ日の中で過ごす情景）\nhttps://drive.google.com/file/d/1EREJAdzVOckrODALcbzII2Dfb3TxBA8U/view?usp=drivesdk", "nc": 1, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@Biscuit_rma/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": false, "creator_id": 2716618, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1924347180288000000%2FmaYjxJk8.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d0bb2e7098d1c13917964e14a2ebe37", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1924347180288000000%2FmaYjxJk8.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d0bb2e7098d1c13917964e14a2ebe37, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1924347180288000000%2FmaYjxJk8.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a5c09a1ac6b7f9a929be11d070cb8bc 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1924347180288000000%2FmaYjxJk8.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a7476eaf53e68d0e0fccd95ecefbc84 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/31f292d4-79dc-460f-8a65-3a1db73832c5?response-content-disposition=inline&Expires=1782997419&Signature=ocxQk1dSeqBN7iNJ2FUlB~Z1bHFGJelX0Ydft5O5v3HstI8w97BPN3YfeGSQiQaOsnwZ7oj6uldDE44O5ezas67Ab3f6gwBNXVz75xGLirdmZ3MNxieYno-IEsx6krgzBTvItAsgTiHe2SAGdjW9FRBuHVd2mvCUsSpyzzWaUsArMeKm4FEgKqRdnppdmcMm6FGRJloscEakjM-TTTbIrJ2h55cTZ7RCsy2v~Wq~uvGoVxHuVAhdRrFHXDg2fNbl2-dpYVf1MMc37azG2ICYZfXiNcr2DOWjDHZPmeEaei2i~KOv8glka9MhJLuOSBxao0iCITkSqMosSrciVB~1uQ__&Key-Pair-Id=K1GS3H53SEO647", "duration": 157, "nsfw": false, "hardcore": false, "consored_thumbnail_