had=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ffe17bf8c61350dfe6ee5e62b9e38d26", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2976938, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@poroporosiisan/works/88", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2976938, "client_id": 2634929, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fd0534fd/uploads/origins/4213fe0e-c8e4-4a35-a967-a7059d081f38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7f6e2ce6200209274de47d157a208bf", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fd0534fd/uploads/origins/4213fe0e-c8e4-4a35-a967-a7059d081f38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bac45f9316280e7ce85c27ee0a1a8580", "src_set": ""}, "body": "こんばんわ!!\n絵柄がとても素敵でリクエストさせていただきました!!\n\nこちら2人分の依頼になります。同じ一枚のイラストでもいいですが\n個別で透過PNGを頂けたら嬉しいです…!!\n構図はお任せします。\n衣装に関しては和風の衣装を希望します！デザインは二人とも近しい物がうれしいです！\n可能であれば全身入れていただけますと幸いです。\n難しい場合はサムネイル使用の際に髪の毛などが切れないようにしていただけると助かります!!\n顔回りなど雰囲気は下記URLにて添付いたします。\n\n\n配信のサムネイルや、SNSで使用させて頂きたいと思っています!!\n可能であれば透過データも頂けると嬉しいです！\n\nよろしければご検討宜しくお願い致します~!!\n\nhttps://drive.google.com/file/d/1dj1jv0gV5YNx9Wblf6-x8PDkEXZZfpZH/view?usp=sharing\n\nhttps://drive.google.com/file/d/1dj1jv0gV5YNx9Wblf6-x8PDkEXZZfpZH/view?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@poroporosiisan/works/87", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2976938, "client_id": 802499, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c66b6ddf/uploads/origins/eb0cc3f6-dc00-4a85-80b8-38bf8541a32d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4884e951975f8369faef6cd0fe864435", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c66b6ddf/uploads/origins/eb0cc3f6-dc00-4a85-80b8-38bf8541a32d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=509f727aecf2bb09c18221ea380463c0", "src_set": ""}, "body": "Hello! I think ぽろぽろ-sensei's art is so beautiful, I love the bright and soft colors! I would love it if you could draw an illustration of my Vtuber character to be used for a song cover of \"ルーマー\" by Police Piccadilly. It will be a non-monetized Youtube video. I will of course credit ぽろぽろ-sensei.\n\nHere is a link to the original song: [ https://youtu.be/DWwFK2gjwa8?si=zTTtlHLQPPV-weV5 ]\n\nNahi is a vampire Vtuber. She is tomboyish and likes to tease others. To suit the song, I would love it if you could draw her in a playful and lighthearted way. I would like to express a summery feeling, so feel free to change her outfit as you see fit.\n\nAs for the pose and composition, I will leave it to you. Thank you for your consideration!\n\nhttps://drive.google.com/drive/folders/1gATQt_GxAm4bnpVoomRP2aS7NJJrPfMD?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@poroporosiisan/works/86", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2976938, "client_id": 3118697, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f15fe5cd/uploads/origins/38fe7741-927c-4de7-b4d9-76d91f7d740e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77a274ea496a7031d2bc426bae8f9bc4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.im