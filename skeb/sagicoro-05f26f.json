先生、\n\nまたイラストの依頼をさせてください。\n\n裸のミニガールが、親友の巨女の舌の上に仰向けに寝ている。ミニガールは脚を広げ、自分の股間を口蓋垂に押し付けている。彼女はこれを存分に楽しみ、オッパイをもてあそんでいる。ミニガールは巨女の喉に足をぶらぶらさせる。\n一方、巨大な少女は何が起こっているのかわからないが、この感覚が好きなようだ。\n\n二人の女の子のデザインはお任せします。\n\n改めまして、ご検討ありがとうございました。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sagicoro/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2173088, "client_id": 1632689, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/18f1ab84/uploads/origins/c11ab6a0-b60d-4d29-a3fb-22f91fb33e2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddbdbd08e3e3055bd7590a0e4365496a", "srcset": "https://si.imgix.net/18f1ab84/uploads/origins/c11ab6a0-b60d-4d29-a3fb-22f91fb33e2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddbdbd08e3e3055bd7590a0e4365496a, https://si.imgix.net/18f1ab84/uploads/origins/c11ab6a0-b60d-4d29-a3fb-22f91fb33e2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=510bb2b470721bf50f61ba9e2fd9509d 2x, https://si.imgix.net/18f1ab84/uploads/origins/c11ab6a0-b60d-4d29-a3fb-22f91fb33e2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=158450868afefc88bbb0d919943eb401 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/18f1ab84/uploads/origins/c11ab6a0-b60d-4d29-a3fb-22f91fb33e2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6985ab7e78247fc76a04186a26049651", "srcset": "https://si.imgix.net/18f1ab84/uploads/origins/c11ab6a0-b60d-4d29-a3fb-22f91fb33e2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6985ab7e78247fc76a04186a26049651, https://si.imgix.net/18f1ab84/uploads/origins/c11ab6a0-b60d-4d29-a3fb-22f91fb33e2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=84f14