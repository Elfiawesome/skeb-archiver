うな雰囲気があります。\n人物のイメージ：小花、ドライフラワー、はさみ、冬、雪、氷、喪（必ず描き入れて頂きたいモチーフというわけではなく、人物の雰囲気の参考として記載しました。もし装飾など人物以外に描かれるものがありましたら、内容はお任せします）\n\nキャラクターの指定が細かくなってしまい、すみません。\n参考資料として、自サイト内のイラストへのリンクを記載しておきますので、よろしければご参照ください。お手数おかけします。\nイラストの仕様につきましては、塔間様のペン画や鉛筆画の雰囲気が個人的に好みなので、できれば線画イラストや白黒イラストでお願いしたいです。作品のサイズ、デジタルかアナログか等はお任せします。\n作品は個人観賞で楽しませていただきます。よろしくお願いします。\n\nhttps://n-yuri.kim/wp-content/uploads/2020/07/shiryou-noto.jpg", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MotoiTohma/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3836, "client_id": 290555, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/39b051f7/requests/44734_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2454bbfb831a5026b0d7cc8321d89707", "srcset": "https://si.imgix.net/39b051f7/requests/44734_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2454bbfb831a5026b0d7cc8321d89707, https://si.imgix.net/39b051f7/requests/44734_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e400f81c4eb99d828dfe97de5df12a5b 2x, https://si.imgix.net/39b051f7/requests/44734_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bae0dbb19671313e2b17bc00e4db6e00 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/39b051f7/requests/44734_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1522bbb24728a49946b67048bd2e58e", "srcset": "https://si.imgix.net/39b051f7/requests/44734_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1522bbb24728a49946b67048bd2e58e, https://si.imgix.net/39b051f7/requests/44734_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6d661d9c36bbd94e3e121c96f4608432 2x, https://si.imgix.net/39b051f7/r