e feel free to pick the short hair or long according to the character sheet! \n\nhttps://drive.google.com/drive/folders/18mrmGB43tDlPR5x710pVE_7VFkYveSwl\n\nThank you🙏🙏\n\nhttps://drive.google.com/drive/folders/18mrmGB43tDlPR5x710pVE_7VFkYveSwl", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@uoooo0u/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2587153, "client_id": 1807287, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e1a1b0e/uploads/origins/aab7f3b2-4544-48bd-bef5-bb59c0f1da65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=092e3d6c00b46250af9db42de6faaa5a", "srcset": "https://si.imgix.net/3e1a1b0e/uploads/origins/aab7f3b2-4544-48bd-bef5-bb59c0f1da65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=092e3d6c00b46250af9db42de6faaa5a, https://si.imgix.net/3e1a1b0e/uploads/origins/aab7f3b2-4544-48bd-bef5-bb59c0f1da65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a51bedcfebd0880b7625dff343a7d595 2x, https://si.imgix.net/3e1a1b0e/uploads/origins/aab7f3b2-4544-48bd-bef5-bb59c0f1da65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7257f174d98687eb071cf522f7303f5b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e1a1b0e/uploads/origins/aab7f3b2-4544-48bd-bef5-bb59c0f1da65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8dabfb5b7f334d51886067928b5fc54f", "srcset": "https://si.imgix.net/3e1a1b0e/uploads/origins/aab7f3b2-4544-48bd-bef5-bb59c0f1da65?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8dabfb5b7f334d51886067928b5fc54f, https://si.imgix.net/3e1a1b0e/uploads/origins/aab7f3b2-4544-48bd-bef5-bb59c0f1da65?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=