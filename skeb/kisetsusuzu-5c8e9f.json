top&w=200&h=200&blur=200&s=4c0399263a00a624b5e48457d13b0d3e 2x, https://si.imgix.net/35be573a/uploads/origins/55241fa4-9eec-4603-9a32-e1a3dc2c988e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ba618a38084b3badc73affadde1b6829 3x"}, "body": "初めまして。\nVtuber準備中のガウンと申します。\n良かったら私のオリジナルキャラクターを描いていただけないでしょうか？\n\n私のキャラクターは鏡の妖精なのですが\n鏡の中で眠ってる姿を描いていただけたら嬉しいです。\n鏡の中は夜空のような水のようなイメージです。\n\nもしできたら16：9でサインをレイヤー分けしていただけると嬉しいです。\nダメな場合はリクエストを拒否してくださって大丈夫です！\n\n宜しくお願いします！\n\nキャラクター資料：https://imgur.com/a/oLGwSSK\n　　　　　　　　　https://imgur.com/a/ZC9hPCC\n住んでる場所のイメージ（配信の背景などで使用してます）：https://imgur.com/a/2jvXMLx", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kisetsusuzu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 415988, "client_id": 626297, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/33d5a982/uploads/origins/05026207-7814-4ee3-a319-742f3ea004a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4830095e3da98d27ea031670c2d57862", "srcset": "https://si.imgix.net/33d5a982/uploads/origins/05026207-7814-4ee3-a319-742f3ea004a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4830095e3da98d27ea031670c2d57862, https://si.imgix.net/33d5a982/uploads/origins/05026207-7814-4ee3-a319-742f3ea004a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3dfc0e0d2f6cdf0f4966c46ec869e656 2x, https://si.imgix.net/33d5a982/uploads/origins/05026207-7814-4ee3-a319-742f3ea004a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fbf6d9b898164a37931c9c2c11d79d02 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/33d5a982/uploads/origins/05026207-7814-4ee3-a319-742f3ea004a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9dd5d10187275655b597bb0afb5c29c", "srcset": "https://si.imgix.net/33d5a982/uploads/origins/05026207-7814-4ee3-a319-742f3ea004a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9dd5d10187275655b597bb0afb5c29c, https://si.imgix.net/33d5a982/uploads/origins/05026207-7814-4ee3-a319-742f3ea004a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7e80751cd8d0692c3519c5661be7b61c 2x, https://si.imgix.net/33d5a982/uploads/origins/05026207-7814-4ee3-a319-742f3ea004a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=32bd5afca7f8dabd66af91e62d4f9be6 3x"}, "body": "すずしな綺雪様\n\nはじめまして、ありのみと申します。\n先生に東方projectのチルノさんと大妖精さんをリクエストしてもよろしいでしょうか？\n\n念のため２人の資料画像を用意しましたので、よろしければ下記URLをご参照下さい。\nhttps://twitter.com/ARINOMI7/status/1298301216884047872\n羽のデザインなどその時々で異なりますが、ある程度可変(自由)だと思っております。\n個人的な印象ではありますが\n２人とも幼い容姿で、どちらも薄い体型。\n身長も同じぐらい（チルノさん≧大妖精さん）で想像しております。\n\n構図や衣装、シチュエーションなどはお任せでお願いしたく存じます。\n\nもしよろしければ、ご検討のほど何卒お願い申し上げます。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kisetsusuzu/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 415988, "client_id": 541150, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b38e074e/uploads/origins/555c68a9-64ff-4587-a9ed-f21f9ec1731a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3f131076ce7d79497d8c15caf3b2219", "srcset": "https://si.imgix.net/b38e074e/uploads/origins/555c68a9-64ff-4587-a9ed-f21f9ec1731a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3f131076ce7d79497d8c15caf3b2219, https://si.imgix.net/b38e074e/uploads/origins/555c68a9-64ff-4587-a9ed-f21f9ec1731a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1a829fe72ec622c31a7ba100c0da98a5 2x, https://si.imgix.net/b38e074e/uploads/origins/555c68a9-64ff-4587-a9ed-f21f9ec1731a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b5d67356320ada8ac8123a7e5957898 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b38e074e/uploads/origins/555c68a9-64ff-4587-a9ed-f21f9ec1731a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dcbc915b22b7e0ba4ae0c926b39df0ef", "srcset": "https://si.imgix.net/b38e074e/uploads/origins/555c68a9-64ff-4587-a9ed-f21f9ec1731a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dcbc915b22b7e0ba4ae0c926b39df0ef, https://si.imgix.net/b38e074e/uploads/origins/555c68a9-64ff-4587-a9ed-f21f9ec1731a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=947de32df13eb094d3f1b96a8e5dd54e 2x, https://si.imgix.net/b38e074e/uploads/origins/555c68a9-64ff-4587-a9ed-f21f9ec1731a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dd366fc43c798d2cde07b1d428de515c 3x"}, "body": "色の指定を間違えた、再送信すいません。はじめまして。すずしなさんの絵の雰囲気と色塗りがとても好きです！書いている百合小説のメインな二人を是非描いてもらいたくててリクエストさせていただきました。\n\nメージ：\n外見：小柄。白いストレートロングな髪と（彩度が低い）グレーブルーの瞳。１３歳ほどだがもっと幼く見える\n服：深いか沈んだ青い色の長めな、フリル付きスカート。　上はシンプルな白いドレスシャツと、その上に何らかのケープレット。服の質感はさらさらで着心地良さそうです。ドレスシャツなど、上品より可愛らしい印象が強い。\n髪アクセサリーの指定はない。\n\n印象：従順で可愛らしい。時として目を引くほどの純真。\n性格：純真で寂しがり屋。何も知らないが好奇心と向上心が強い。\n\n参考画像：https://drive.google.com/file/d/1rB2B4ZoyKxAJgM_froA26q_XDpTFz6p4/view\nスカートはこのタイプです。\n\nパチェラ\n外見：中背。長い*ラベンダー色*の髪（メージより短い）と明るい青い色の瞳。１４歳ほど。\n服：外の運動を意識した少し動きやすい服。多分スカートかドレスに黒いストッキングです。\n\n印象：知的で好奇心のある眼。容姿が綺麗だけれど、グループというものが苦手で周りを遠ざけています。\n性格：孤独な冒険研究少女。\n\n参考画像：https://skeb.jp/@hijiri_rst/works/12\n目、髪の色、飄々とした雰囲気が似てます。\n\n二人はよく一緒に見物に行くし、「屋敷」の仮説について延々と語れるパチェラにメージが興味津々に聞く。\n\n構図：\nビクトリア朝風屋敷の廊下を歩いているところで、メージが体を寄せてパチェラにハグしてきます。本当に楽しくてパチェラと一緒にいることが好きな表情をしています。パチェラは困ったような、笑顔こそ控え目だけれども楽しそうです。雰囲気は日常的でとてもハートフル。\nhttps://www.pixiv.net/artworks/88204082　の３番目の絵みたいなポースです！まだ友達なので恋人繋ぎではなく普通の手繋ぎです。\n\n指定がないところや描きにくい部分があったらメインな色以外好きにデザインしてください。可能でしたら宛名とサインはpsdレイヤーでon/offできると嬉しいです。\nよろしくお願い致します。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kisetsusuzu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 415988, "client_id": 1311718, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ddccb980/uploads/origins/f1f62f8c-1150-4960-84ef-a9a0ab3f0f29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3db6b03be30ba582cb6666b6f4c0088a", "srcset": "https://si.imgix.net/ddccb980/uploads/origins/f1f62f8c-1150-4960-84ef-a9a0ab3f0f29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3db6b03be30ba582cb6666b6f4c0088a, https://si.imgix.net/ddccb980/uploads/origins/f1f62f8c-1150-4960-84ef-a9a0ab3f0f29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bee22cc91e4d1fb16624d215cf3330b3 2x, https://si.imgix.net/ddccb980/uploads/origins/f1f62f8c-1150-4960-84ef-a9a0ab3f0f29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=017e350fd9182cf174df2ea2866d0978 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ddccb980/uploads/origins/f1f62f8c-1150-4960-84ef-a9a0ab3f0f29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a0e8df8ce425780ac6b29959b433098", "srcset": "https://si.imgix.net/ddccb980/uploads/origins/f1f62f8c-1150-4960-84ef-a9a0ab3f0f29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0a0e8df8ce425780ac6b29959b433098, https://si.imgix.net/ddccb980/uploads/origins/f1f62f8c-1150-4960-84ef-a9a0ab3f0f29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4c4482656391734e38488da84733499c 2x, https://si.imgix.net/ddccb980/uploads/origins/f1f62f8c-1150-4960-84ef-a9a0ab3f0f29?bg=%23fff&auto=format