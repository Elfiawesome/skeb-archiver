same_genre": true}, {"path": "/@kisetsusuzu/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 415988, "client_id": 507423, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/426a5c7a/uploads/origins/d6db9fab-6f4b-492d-b521-c30e307300f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b40bc1962d9c18198f2924c6efde0fd", "srcset": "https://si.imgix.net/426a5c7a/uploads/origins/d6db9fab-6f4b-492d-b521-c30e307300f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b40bc1962d9c18198f2924c6efde0fd, https://si.imgix.net/426a5c7a/uploads/origins/d6db9fab-6f4b-492d-b521-c30e307300f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c5d7305ad1ad77c5a0944cb5fdb7dd3 2x, https://si.imgix.net/426a5c7a/uploads/origins/d6db9fab-6f4b-492d-b521-c30e307300f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=20bb00df4ce5a4e954a8e95529beb9a3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/426a5c7a/uploads/origins/d6db9fab-6f4b-492d-b521-c30e307300f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33c3a437cc39265840cdd0665b6ec7a1", "srcset": "https://si.imgix.net/426a5c7a/uploads/origins/d6db9fab-6f4b-492d-b521-c30e307300f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33c3a437cc39265840cdd0665b6ec7a1, https://si.imgix.net/426a5c7a/uploads/origins/d6db9fab-6f4b-492d-b521-c30e307300f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9e561c0f991f8d849d9d5b94f51f8432 2x, https://si.imgix.net/426a5c7a/uploads/origins/d6db9fab-6f4b-492d-b521-c30e307300f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f8bdaa479ea59b04f8d484954ce1a332 3x"}, "body": "すずしな綺雪様\n\n犬耳、尻尾の巫女の女の子が種子島(鉄砲)で射撃姿勢を取っている、もしくは射撃している絵を描いていただけないでしょうか。\n\n詳細\n犬種　柴犬、秋田犬、北海道犬、甲斐犬、紀州犬、四国犬の中からお願いします。\n髪、瞳の色　上記で選んだ犬種を基準にお願いします。(髪型と長さは任せます)\n射撃姿勢　立ち射ち、膝射ち、座り射ち、寝射ちの中からお願いします。指を引き金にかけて、今にも射撃をしそうな状況、あるいは射撃している状況をお願いします。\n種子島　一般的な大きさである小筒のほか、大型である中筒、士筒のどれを使っていても構いません。\n巫女装束　巫女装束は丈が短かったり肩に切れ込みがある創作特有のものではなく、正規の物をお願いします。また、損傷していても構いません。\n表情　恐怖で怯えている以外でしたら好きに描写して構いません。(例　落ち着いた感じで淡々としている、不敵な笑みを浮かべている、穏やかに微笑んでいる、戦闘狂染みている、自我を失っている等)\n胸部　貧から爆までの範囲でお任せします。\nその他　早合「http://www.xn--u9j370humdba539qcybpym.jp/part1/archives/35」、「https://www.meihaku.jp/arquebus-basic/matchlock-launchmethod/」を首から下げている。(または袈裟懸けで下げている)\n負傷描写等　一切なくても構いませんし、軽傷または重傷でありながらも堪えている、ないしはものともしないような描写でも構いません。また、土や泥の汚れについても任せます。\n巫女装束が損傷していても構いませんが、下着等が露出することがないようにお願いします。\n場所　委任しますが、宇宙空間等のSF要素を感じさせるものは却下でお願いします。\nセリフ等差分\n内容等に合うものを委任します。\n\nすずしな様の発想に頼るところが大きいですが、何卒よろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kisetsusuzu/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 415988, "client_id": 1765701, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9602f11f/uploads/origins/aa69af30-b963-4498-aacd-47d377a31dfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5bbb5536bf61d05b8745e7c2984ad85", "srcset": "https://si.imgix.net/9602f11f/uploads/origins/aa69af30-b963-4498-aacd-47d377a31dfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5bbb5536bf61d05b8745e7c2984ad85, https://si.imgix.net/9602f11f/uploads/origins/aa69af30-b963-4498-aacd-47d377a31dfe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9fd1d110deef69252c4016e7bff7089f 2x, https://si.imgix.net/9602f11f/uploads/origins/aa69af30-b963-4498-aacd-47d377a31dfe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e114f430b096a048e932ec07e65815e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": 