描いていただきたいです。\nきくおさんの「舞台性ナニカ」という曲をなんとなくイメージしたキャラクターです。\nキャラクターの設定資料はURLからお願いします。世界設定の説明、他のキャラクターの資料などもありごちゃごちゃしていて申し訳ないです。5,6がシェーミー・ステラに関する資料なのでその2つの資料に目を通していただければ大体は大丈夫です。ただ少々説明不足で5,6の資料だけではわかりにくい部分があるかもしれません💦。もしイラストに困る場合は御手数ですが1～4の資料も見ていただければと思います🙇‍♀️\n画質が悪く見づらい資料ですみません。🙇‍♀️\n\n○イラストについて\n明るいけどどこか狂気を感じる絵をお願いします。モチーフが星、月、海なので、背景など描かれる場合は参考にしていただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/108c9f3O3JmdoyT25n2bb504Ph2E8Koav", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yooooooobo/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/89358910/uploads/origins/6fd45adc-7c84-4317-8145-c5c540c0934c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=25bc078a128b5e1876fb79569f72ed3e", "srcset": "https://si.imgix.net/89358910/uploads/origins/6fd45adc-7c84-4317-8145-c5c540c0934c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=25bc078a128b5e1876fb79569f72ed3e, https://si.imgix.net/89358910/uploads/origins/6fd45adc-7c84-4317-8145-c5c540c0934c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a496633131cd90f76dc414e57b54cbea 2x, https://si.imgix.net/89358910/uploads/origins/6fd45adc-7c84-4317-8145-c5c540c0934c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=58c7d123c6485595e850f239a03a9390 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1836219, "client_id": 1260937, "nc": 1}, {"path": "/@yooooooobo/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id"