=crop&crop=top&w=200&h=200&blur=200&s=14cc9accf9b82694640ce956b82e8c6a, https://si.imgix.net/c7c701e0/uploads/origins/d597a3c5-ea12-4359-90f9-423468be7046?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bac82a9d47219b86629a149a5391bf9e 2x, https://si.imgix.net/c7c701e0/uploads/origins/d597a3c5-ea12-4359-90f9-423468be7046?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=777fc78691c71c61d2dbe6688969e19c 3x"}, "body": "はじめまして。\nアズールレーンのシグニット×クレセントの百合キスイラストをリクエストさせていただきます。\n真横からのアングルで、指を絡ませながらお互いに胸を押し付けあってキスをしている構図をお願いします。\n服装は両者とも改造後の服装でお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mika3253x/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1316572, "client_id": 1136053, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b6bfc2b/uploads/origins/bfc262c2-ec6c-422c-a899-a4a5ccb73cba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9dfe2d1499b38e8919e3a7e399bd5fed", "srcset": "https://si.imgix.net/8b6bfc2b/uploads/origins/bfc262c2-ec6c-422c-a899-a4a5ccb73cba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9dfe2d1499b38e8919e3a7e399bd5fed, https://si.imgix.net/8b6bfc2b/uploads/origins/bfc262c2-ec6c-422c-a899-a4a5ccb73cba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92d97b86e51722a8447b184cc3b9602e 2x, https://si.imgix.net/8b6bfc2b/uploads/origins/bfc262c2-ec6c-422c-a899-a4a5ccb73cba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=869baf2258e216101ccfe0f6ad1caca1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b6bfc2b/uploads/origins/bfc262c2-ec6c-422c-a899-a4a5ccb73cba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bed0767a31fa55eadedd325e91dafe6", "srcset": "https://si.imgix.net/8b6bfc2b/uploads/origins/bfc262c2-ec6c-422c-a899-a4a5ccb73cba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bed0767a31fa55eadedd325e91dafe6, https://si.imgix.net/8b6bfc2b/uploads/origins/bfc262c2-ec6c-422c-a899-a4a5ccb73cba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=206e35a9642a3cd700d19367139ea57f 2x, https://si.imgix.net/8b6bfc2b/uploads/origins/bfc262c2-ec6c-422c-a899-a4a5ccb73cba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ed44045338af1b120a88aaf605f31b1a 3x"}, "body": "アズールレーンのアンカレッジを描いてほしいです。\n頬を染めて自分の胸を持ち上げる姿です。\n一枚の絵で上半身いっぱいに描いて欲しいです！(全てないしほとんど上半身で、アンカレッジの可愛い顔と胸を大きく、胸を下から支える手を表現してほしい)\n\n指揮官と対面で胸を頬を染めて持ち上げ、顔は少し左を向く(恥かしげに)\n胸は数滴ほど汗がついており、胸の布はぎりぎりの大きさで。\n\n私はまだアンカレッジをお迎えしてないのでセリフは分かりません。\nそのため、セリフ欄に「・・・・・」と書いて、ただただお胸を指揮官に差し出す感じで描いて欲しいです！！！\n\nお胸を指揮官に差し出す感じが一番大事なので、そこを何卒よろしくお願い致します。\nだから、下から支える手でお胸を少し上げる感じかな？\n\n背景は可愛い背景か、差し出す感じを際立たせる背景のどちらかをお願いしたいです。\n\nお胸を差し出す感じの具体的な印象ですが、\n指揮官のを挟むというより、アンカレッジは両手で下の方を\nを支えている間に指揮官の両手が上の方をそれぞれ両手でふれる、直前のシーンな印象でお願いします。\n指揮官イラストに手も影も含めて全くイラスト上にいない状態でお願いします。\nあくまでも指揮官が揉む直前の状態を描いて欲しいです。\n\nもし描き上げたら、Twitterで私の名前(Kanshinn、または@Kanshinn1)と一緒にあげて欲しいです。\nタイトルは「恥ずかしげに指揮官に向き合うアンカレッジ」でお願いします！！\n私の価値観を表現してもらった絵を、みんなに見てもらいたいので！\n\n以上何卒よろしくお願いします！！", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mika3253x/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1316572, "client_id": 513074, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8407c7a3/uploads/origins/4bc13a3b-4e5c-42b4-bb9a-0522be348d07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5afd43969948a183732c39da863f1c10", "srcset": "https://si.imgix.net/8407c7a3/uploads/origins/4bc13a3b-4e5c-42b4-bb9a-0522be348d07?bg=%23fff&auto=format%2Ccompress&fm=webp&f