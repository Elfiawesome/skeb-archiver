省略などしていただいても構いません。\n・キャラクター単体で、背景が透過されたものを合わせて納品していただけると嬉しいです。PSD形式での納品でも問題ありません。\n・サイズを1920x1080（16：9）でお願いしたいです。\n\n『参考資料（アバターデザイン）』\n三面図が無く申し訳ありません。\nhttps://drive.google.com/drive/folders/1FNdoApzVj_p6z3N2oSWavdYXp-NitVkM?usp=drive_link\nhttps://lit.link/w6CTxoWHEePX4TZWFAQczntZzL32\n\n利用用途・条件などご確認いただき是非ご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1FNdoApzVj_p6z3N2oSWavdYXp-NitVkM?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@petitTLT/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2477226, "client_id": 1971658, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4a434d5/uploads/origins/8cf5bbed-4804-49ee-93ec-87b288a4c328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72f80b351a8cdda1a550d484345d0ede", "srcset": "https://si.imgix.net/f4a434d5/uploads/origins/8cf5bbed-4804-49ee-93ec-87b288a4c328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72f80b351a8cdda1a550d484345d0ede, https://si.imgix.net/f4a434d5/uploads/origins/8cf5bbed-4804-49ee-93ec-87b288a4c328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4d905770e68db7be28756cf25e074fe7 2x, https://si.imgix.net/f4a434d5/uploads/origins/8cf5bbed-4804-49ee-93ec-87b288a4c328?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5af86e2c32fa145bd3bc243e8926f7f4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4a434d5/uploads/origins/8cf5bbed-4804-49ee-93ec-87b288a4c328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=385d3b8a70ce7757dd557ab5b3a210a4", "srcset": "https://si.imgix.net/f4a434d5/uploads/origins/8cf5bbed-4804-49ee-93ec-87b288a4c328?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=385d3b8a70ce77