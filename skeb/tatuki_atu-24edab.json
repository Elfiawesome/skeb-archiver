45a97e70c2d78ac2cea 2x, https://si.imgix.net/04d23ff2/uploads/origins/5d06dedc-5d89-4f09-be06-4650f886ce2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=47668be61d8afe0b9b5203a1bd1fb471 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/04d23ff2/uploads/origins/5d06dedc-5d89-4f09-be06-4650f886ce2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb98c092f6c5d9de9e07f51530504fcc", "srcset": "https://si.imgix.net/04d23ff2/uploads/origins/5d06dedc-5d89-4f09-be06-4650f886ce2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb98c092f6c5d9de9e07f51530504fcc, https://si.imgix.net/04d23ff2/uploads/origins/5d06dedc-5d89-4f09-be06-4650f886ce2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=58c69c1b58bdf32e4825f6648146f969 2x, https://si.imgix.net/04d23ff2/uploads/origins/5d06dedc-5d89-4f09-be06-4650f886ce2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3a210c5fd4f759259d888d9f03d49fff 3x"}, "body": "はじめまして。\n先日のtwitterで見かけた鹿子田くんがタイプすぎて、是非エロいイラストも見たく依頼させていただきます。柔道部のがっしりした体格に、豪快な性格。黒色短髪も鼻バンも全部最高です。\n個人的に夜這いモノが大好きなので、こんなシチュエーションは可能でしょうか。\n※木羽さんの設定と合わない部分は削って構いません。\n\n前提\n○柔道部の合宿中。オナ禁で溜まった鹿子田くんは、夜中こっそり布団の中でシコろうとするも、練習疲れで途中で寝落ちしてしまう。朝起きて来ないので牛島主将が部屋に入ると…。\n\n希望\n○服装はお任せします。\n○布団からはみ出るくらい寝相が悪いと嬉しいです（一人部屋、雑魚寝部屋どちらでも構いませ\nん。）。\n○スヤスヤ寝ているというよりは、大いびきかいて爆睡している感じでお願いします。よだれ垂らしてたり、枕によだれの跡があると最高です。\n○ずり下げたパンツからギンギンの朝勃ちが直立。サイズ感やかぶっているかどうかはお任せします。\n○手元に使うはずだったティッシュがあると嬉しいです。\n\n今後の柔道部やクラスメートなどの展開も楽しみにしています（あと養護教諭なのに赤ジャージの工口先生も大好きです。）。\nよろしくお願いいたします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tatuki_atu/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b7eee5ee/uploads/origins/bc403719-a6e2-47c3-bd8f-b7ae65c09f92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop