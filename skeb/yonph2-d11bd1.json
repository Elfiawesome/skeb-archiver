ねてより私はよんはさんの表現する光と闇の虜なのですが、前回、光代表としてあめねずちゃんをリクエストさせていただいたので、今回は闇代表としえばくめ〜ちゃんをお願いできればと思っております。\n\nシチュエーション等はよんはさんにお任せいたします。描きやすいように描いていただけると幸いです。\n描きにくかったらリクエスト無視してばくめ〜ちゃん以外でも何でも好きに描いてもらって大丈夫です。\n\nどうかご無理なく、お手隙の際に気軽に描いていただけると嬉しいです！\nよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yonph2/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bbfedc1f/uploads/origins/a571b59e-8194-4827-a059-a31594fa390b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b0ebb3cce3a68c1276b8424b1500196", "srcset": "https://si.imgix.net/bbfedc1f/uploads/origins/a571b59e-8194-4827-a059-a31594fa390b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b0ebb3cce3a68c1276b8424b1500196, https://si.imgix.net/bbfedc1f/uploads/origins/a571b59e-8194-4827-a059-a31594fa390b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=db1cbaeaffe5e05d0a71c08886902166 2x, https://si.imgix.net/bbfedc1f/uploads/origins/a571b59e-8194-4827-a059-a31594fa390b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c4285c41e3d7ec4d2288c45971a8a4a 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1154032, "client_id": 3349785, "nc": 128}, {"path": "/@yonph2/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1154032, "client_id": 1063116, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/53d6c587/uploads/origins/e7fa3bc5-5c31-48ae-a545-dbcfb2b2d599?bg=%23fff&auto=format%2Ccompr