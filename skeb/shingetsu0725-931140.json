助かります。\n・背景・差分がある場合はPSDファイルでの納品、または背景・キャラクターのみの透過pngイラストを分けていただけますと幸いです。\n・キャラクターひとりひとり、レイヤーを分けていただきたいです。\n\nお忙しいところ恐縮ですが、ご検討よろしくお願いいたします。  \n\n天草フラン", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shingetsu0725/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3955351, "client_id": 2783825, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9fb2e38d/uploads/origins/28a346cc-c48b-457d-a6f1-334ab50ed8f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4fa7f628d055770ef5a151027acf10c", "srcset": "https://si.imgix.net/9fb2e38d/uploads/origins/28a346cc-c48b-457d-a6f1-334ab50ed8f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4fa7f628d055770ef5a151027acf10c, https://si.imgix.net/9fb2e38d/uploads/origins/28a346cc-c48b-457d-a6f1-334ab50ed8f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=439a7ecc04ef125fd843803dacdac236 2x, https://si.imgix.net/9fb2e38d/uploads/origins/28a346cc-c48b-457d-a6f1-334ab50ed8f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13639830b537e0e8afc6403a58052976 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9fb2e38d/uploads/origins/28a346cc-c48b-457d-a6f1-334ab50ed8f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80e404b45985d6eb0c74cf17c533eb75", "srcset": "https://si.imgix.net/9fb2e38d/uploads/origins/28a346cc-c48b-457d-a6f1-334ab50ed8f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80e404b45985d6eb0c74cf17c533eb75, https://si.imgix.net/9fb2e38d/uploads/origins/28a346cc-c48b-457d-a6f1-334ab50ed8f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c47b5fc115f1cc3be686824b92f4a648 2x, https://si.imgix.net/9fb2e38d/uploa