o=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb52075bf8236cb5184580b3633a411a, https://si.imgix.net/770531bb/uploads/origins/431aa78e-e243-404f-bd26-ce9878cfe600?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=106f0039c474d92d78f08b5e73bd788e 2x, https://si.imgix.net/770531bb/uploads/origins/431aa78e-e243-404f-bd26-ce9878cfe600?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=efa11b5546758b31a076e805c8dde0c0 3x"}, "body": "新月様\n\nお世話になっております。\n個人勢Vtuberの天草フランと申します。 \n新月様のイラストが大好きです…！\nご縁がございましたら、ぜひ天草フランと友人の個人VTuberである乙羽スピカを描いてくださると嬉しいです！\n\n 【希望のポーズ、服装】\n2キャラクターを1枚のイラストに描いていただきたいです。\n可能であれば、ポーズはそれぞれ1人でも成立するようなもの・ヴァンパイアイメージで描いていただけますと幸いです。\nヘアアレンジに関しましてはお任せいたします！\n\n【キャラクターについて】 \n①天草フラン(白髪) \nhttps://drive.google.com/drive/folders/149RO-jUqoHM3DZlCFTn2xgfSp4YSH_IE?usp=sharing\n髪型：ロングヘア。前髪はぱっつんですが後ろ髪はぱっつんではありません。\n髪色：白色\n目：紫色に、下は黄色みがかっています。瞳孔が四葉のクローバーです。\n\n②乙羽スピカ(金髪) \nhttps://docs.google.com/spreadsheets/d/1jjh_UV9Tq7RXanIUqTGzERNX6IdgSV57OZfNS4XDdMg/edit?usp=sharing\n髪型：腰までのストレートロングのハーフアップ\n髪色：金色\n目色：ゴールド、オリーブ\n\n 【使用用途】 \n・SNS、youtubeのサムネイル、配信画面、歌ってみた動画等プロモーション全般 \n・ファンクラブ、メンバーシップ内での使用 \n(天草フラン、乙羽スピカの2名が使用させていただきます)\n\n【お願い】\n ・サムネイルに使用したいため、髪の毛・頭周りは見切れていない構図だととても助かります。\n・背景・差分がある場合はPSDファイルでの納品、または背景・キャラクターのみの透過pngイラストを分けていただけますと幸いです。\n・キャラクターひとりひとり、レイヤーを分けていただきたいです。\n\nお忙しいところ恐縮ですが、ご検討よろしくお願いいたします。  \n\n天草フラン", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shingetsu0725/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3955351, "client_id": 2783825, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9fb2e38d/uploads/origins/28a346cc-c48b-457d-a6f1-334ab50ed8f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4fa7f628d055770ef5a151027acf10c", "srcset": "https://si.imgix.net/9fb2e38d/uploads/origins/28a346cc-c48b-457d-a6f1-334ab50ed8f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c4fa7f628d055770ef5a151027acf10c, https://si.imgix.net/9fb2e38d/uploads/origins/28a346cc-c48b-457d-a6f1-334ab50ed8f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=439a7ecc04ef125fd843803dacdac236 2x, https://si.imgix.net/9fb2e38d/uploads/origins/28a346cc-c48b-457d-a6f1-334ab50ed8f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13639830b537e0e8afc6403a58052976 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9fb2e38d/uploads/origins/28a346cc-c48b-457d-a6f1-334ab50ed8f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80e404b45985d6eb0c74cf17c533eb75", "srcset": "https://si.imgix.net/9fb2e38d/uploads/origins/28a346cc-c48b-457d-a6f1-334ab50ed8f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80e404b45985d6eb0c74cf17c533eb75, https://si.imgix.net/9fb2e38d/uploads/origins/28a346cc-c48b-457d-a6f1-334ab50ed8f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c47b5fc115f1cc3be686824b92f4a648 2x, https://si.imgix.net/9fb2e38d/uploads/origins/28a346cc-c48b-457d-a6f1-334ab50ed8f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f9f51538f568f571c069d7989b9ef4b9 3x"}, "body": "新月先生、エイイウと申します。\nいつも新月先生素敵なイラストを拝見してSkeb依頼できる機会をお待ちしておりました\nずっと新月先生の温かみのある優しい塗り方が大好きです。特に目の描き方がとても魅力的で、キャラクターの感情が伝わってきて、思わず見入ってしまいます\n今回ご依頼したいのは、僕の推しVTuber「天草フラン」さん（@amakusa_fran）のイラストです\nご縁があればとても嬉しいです\n\n【使用用途】\n・SNS投稿\n・本人希望時に配信サムネイルや配信内での使用\n・個人使用（PC壁紙やpixivFACTORYでのグッズの作成…の可能性）\n\n【内容】\n天草フランさんのイラストを、新月先生にご自由に描いていただけましたら幸いです\nまた、新月先生がデザインされた衣装も拝見できましたら、とても嬉しく思います\n\n【お願い】\n・サムネイルに使用したいので、髪の毛や頭まわりが切れていない構図ですと非常に助かります…！\n・背景や差分がある場合、PSDファイルでの納品、もしくは背景とキャラクターのみの透過PNGイラストを分けていただけますと幸いです\n\n【キャラクターについて】\n・リスナーさんに甘い幸せを届けるために活動している、ケーキが大好きな女の子です\n・見た目よりも元気めな性格です！\n・白くさらさらふわふわの髪の毛\n・瞳の中に四つ葉のクローバーがあり、基本は紫色で、下の方が黄色がかっています\n\nご多忙の中お手数おかけいたしますが，ご検討の程よろしくお願いいたします\n\nhttps://drive.google.com/drive/folders/149RO-jUqoHM3DZlCFTn2xgfSp4YSH_IE?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2272913, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Pamera@skeb受付中", "screen_name": "8mera_art", "avatar_url": "https://pbs.twimg.com/profile_images/1780896007473295360/9hdvsyRR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1551171151535017984/1665907902/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 2925740, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "命メモ", "screen_name": "nigakute_kusa", "avatar_url": "https://pbs.twimg.com/profile_images/1713313322181988352/av0DOT2N.jpg", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 3470564, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ほや煮", "screen_name": "hoyani_888", "avatar_url": "https://pbs.twimg.com/profile_images/1869412465882300416/COo5-Rby.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1869258255010308096/1745583843/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_d