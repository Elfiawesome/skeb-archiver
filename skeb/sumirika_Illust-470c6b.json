=311568f499d715b9ae9ebe72f7125cb4", "srcset": "https://si.imgix.net/fc7a323b/uploads/origins/9c8bc580-d271-4ef9-9a4f-053f4ccacf0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=311568f499d715b9ae9ebe72f7125cb4, https://si.imgix.net/fc7a323b/uploads/origins/9c8bc580-d271-4ef9-9a4f-053f4ccacf0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a58daf7e116768fd03efc43b32b91e37 2x, https://si.imgix.net/fc7a323b/uploads/origins/9c8bc580-d271-4ef9-9a4f-053f4ccacf0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f07a67ebe448167f87b64395b0338534 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc7a323b/uploads/origins/9c8bc580-d271-4ef9-9a4f-053f4ccacf0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=243785037b2253345444967f4650ad7c", "srcset": "https://si.imgix.net/fc7a323b/uploads/origins/9c8bc580-d271-4ef9-9a4f-053f4ccacf0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=243785037b2253345444967f4650ad7c, https://si.imgix.net/fc7a323b/uploads/origins/9c8bc580-d271-4ef9-9a4f-053f4ccacf0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5e85065a9f71cb87cf3666c8ce606a1d 2x, https://si.imgix.net/fc7a323b/uploads/origins/9c8bc580-d271-4ef9-9a4f-053f4ccacf0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1305a5cf542004efc7ebb727086f3e9a 3x"}, "body": "あるふ先生様\n\n初めまして、イラストレーター兼TRPGプレイヤーの絵角リカと申します。\ndiscordの『起きろ！！創作の時間だ！！』サーバーにてあるふ先生様のskeb募集を拝見し、\nとても素敵で可愛らしくどこか闇めいた絵柄に惹かれ、是非私のうちの子を描いて頂きたいと思いリクエストさせて頂きました！\n\n◇依頼内容\ndiscordに掲載されていたサンプルイラストの様な詰め込みイラスト形式で、\n全身立ち絵、顔アップ、SDを一枚に纏めて描いて頂きたいです。\n資料URLに通常衣装、戦闘衣装とそれぞれに髪型差分がありますので、いずれかをご自由にお描き頂けると嬉しいです。\n全身、顔アップ、SDでそれぞれ衣装や髪形を変更しても構いませんし、一枚纏めて同じビジュアルで統一して下さっても構いません。\n衣装問わず、髪型①の物は必ず含めて下さると大変嬉しいです。\nまた可能であれば、それぞれの透過版のデータも頂けますと助かります。\n\n◇キャラクター設定\n髪型①の時と髪型②の時で振る舞いや表情、仕草等が大きく異なります。\n髪型①の際は口元に手をやったり妖艶な笑みを浮かべたりが多く、性格の悪い振る舞いが目立ちます。頬を染める事は殆どありません。\n髪型②の際はあどけなく大人しい少女の様な振る舞いになります。控えめながらも笑い、穏やかな表情を浮かべます。平常時は少しキョトンとした顔をしています。\n\n◇ビジュアル設定補足\n・髪型①\n三つ編みで輪を作ったポンデリングヘアに細いツインテールが足されたものです。\n・通常衣装\n背中の赤いリボンは裾に向かって徐々に半透明になっています。根元に向かうにつれ白っぽく。\n・メイク\nどちらの衣装も赤いアイシャドウをしています。上瞼、下瞼両方に結構ガッツリと塗っています。\n\n◇参考資料\nhttps://drive.google.com/drive/u/1/folders/1GL-t77Pu0ftBtCMBhc-3nEB8bZP3xDuT\n\n私のうちの子の中でも特にお気に入りのキャラクターで、あるふ先生の素敵な絵柄に物凄く似合うと思いリクエストさせて頂きました。\nご検討の程よろしくお願い致します！\n\nhttps://drive.google.com/drive/u/1/folders/1GL-t77Pu0ftBtCMBhc-3nEB8bZP3xDuT", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 66054, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "きま", "screen_name": "livideal", "avatar_url": "https://pbs.twimg.com/profile_images/1976497550963433472/iVMHYa5j.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1030177734595510272/1787016066/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 118534, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ルヲ", "screen_name": "fukutaro01", "avatar_url": "https://pbs.twimg.com/profile_images/1835955783810646016/MpuDopp3.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1125002901976256513/1726560762/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 144}, {"id": 663892, "creator": true, "nsfw_acceptable": false, "acceptable": true,