でご自由にお描き頂ければと思います。\n興味がおありでしたらご検討頂ければ幸いです。宜しくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 77920, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "露木佑太郎（Yutaro Tsuyuki）", "screen_name": "tsuyuki_tk", "avatar_url": "https://pbs.twimg.com/profile_images/1960726643326246919/ySI6s0VJ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3116737830/1746017856/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 531722, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "しろまめ", "screen_name": "nekomame39", "avatar_url": "https://pbs.twimg.com/profile_images/1326379993878945794/6yDzqu01.jpg", "header_url": "https://pbs.twimg.com/profile_banners/884288981512273921/1631701098/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 781741, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ななヴな", "screen_name": "nnvnice", "avatar_url": "https://pbs.twimg.com/profile_images/1436587872857968642/BC4Vb4ZA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1278575462357200896/1667488438/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 20, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 1839461, "creator": true, "nsfw_acc