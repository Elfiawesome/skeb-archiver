公の部屋は散らかっており、デスク上にはゲーム、空のドリンク、萌えフィギュアなどがある。\n\nデザイン資料はリンク先Xの固定画像になります。(見えないところは想像で描いて頂いても大丈夫です！)\nわからない箇所はお任せで、無理のない範囲でよろしくお願いいたしますᴗ  ̫ ᴗ \n\n簡単なプロフィール\nむのーちゃんは宇宙から来た猫耳天使型生物、レトロゲーム、ホラー、ドーナツが大好きです。裏ではインターネットから人々を支配したいという計画があります。普段はぼーっとしている事が多い。無邪気な顔で笑う。エプロンの下はスクールみたいな水着です。\n\nhttps://twitter.com/muno_channel", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kanijima_net/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2116838, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/009eae01/uploads/origins/60021360-630e-48ee-8bd3-04ca24b29cdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d4142da0f8b4c410d014e8e43f44705", "srcset": "https://si.imgix.net/009eae01/uploads/origins/60021360-630e-48ee-8bd3-04ca24b29cdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d4142da0f8b4c410d014e8e43f44705, https://si.imgix.net/009eae01/uploads/origins/60021360-630e-48ee-8bd3-04ca24b29cdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=43c717358f9798766e381ae11b45a339 2x, https://si.imgix.net/009eae01/uploads/origins/60021360-630e-48ee-8bd3-04ca24b29cdb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ea8667d0fe7ba1918806ef54e4fcb58 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/009eae01/uploads/origins/60021360-630e-48ee-8bd3-04ca24b29cdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8bea2bc407877cbb1ab3c62c341e47b", "srcset": "https://si.imgix.net/009eae01/uploads/origins/60021360-630e-48ee-8bd3-04ca24b29cdb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8bea2bc407877cbb1ab3c62c341e47b, https://si.imgix.net/009eae01/uploads/origins/60021360-630e-48ee-8bd3-04ca24b29cdb?bg=%23fff&auto=format%2C