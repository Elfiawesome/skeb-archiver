b9e-4cbb-965b-f9ed577fd634?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a756f55ef162d389a66bd27063289553", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/122748f3/uploads/origins/77ba043a-fb9e-4cbb-965b-f9ed577fd634?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9dc3778db628e04815b87ec622fe02af", "src_set": ""}, "body": "色々な方の塗り方やメイキングを見てコロコロ画風を変えながら練習している初心者です。\n作業時間のわりにクオリティが高くないのが悩みですが、解決の方向としては作業が低コストで、遠目から見れば「え、綺麗じゃん」って見えるラフな描き方・塗り方のコツを知りたいです。（単色ベタ塗りでも〇）\nまた、一部人体の構造に説得力に欠けていると自覚しています（主に顔と手足）。おすすめの教材があれば教えてください。\n大変厚かましいとは存じますが、おすすめのブラシ・筆圧・キャンバスサイズ/ブラシサイズ設定があればぜひ教えてください。\n\nhttps://twitter.com/zange_photo/status/1427285810856878080?s=20\nhttps://twitter.com/zange_photo/status/1408410344502923266?s=20\nhttps://twitter.com/zange_photo/status/1360586276487929856?s=20\nhttps://twitter.com/zange_photo/status/1351184669690224644?s=20\nhttps://twitter.com/zange_photo/status/1346816269312430080?s=20", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@neco28/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 482334, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c6fb266/uploads/origins/eb18ee02-aac7-4785-bd46-8358cbdd4cf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0302efb03115f164f18e7f526bd48fc9", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c6fb266/uploads/origins/eb18ee02-aac7-4785-bd46-8358cbdd4cf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=023bbe517be381c6efd4d3ead2cd5406", "src_set": ""}, "body": "にじさんじ所属のVtuberであるCrossick（健屋花那嬢と白雪巴嬢）のイラストをお願いできないでしょうか？\nシチュエーションは二人とも大きめのYシャツだけ羽織ってベッドの上でいちゃついている感じでお願いします。\n一応NFSWのチェックは入れておきますが、直接的なHよりも、恋人がじゃれ合ってたりいちゃついてたりする感じがいいと思います（Crossickお二人の配信そのままな感じのいちゃつき具合がステキです）", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@neco28/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 482334, "client_id": 854157, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/121fd1a1/uploads/origins/cd425112-5b7e-4947-836d-f2289f18d34c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7deb8c57c666612ed585f0b488b03d9f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/121fd1a1/uploads/origins/cd425112-5b7e-4947-836d-f2289f18d34c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a165313021d222a466e43ec7f6ee5df", "src_set": ""}, "body": "初めまして、こんにちは。\nイラストの依頼をさせて頂くのが初めての経験のため、何か不手際がありましたら申し訳ございません。\n\nにじさんじ白雪巴様をショートヘア、新衣装で描いて頂きたいです。\n\nよろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@neco28/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 482334, "client_id": 340687, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7d59ddc3/requests/183347_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ad916d09fe62d10a7111b9d416fa5d1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7d59ddc3/requests/183347_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ded32f5422634976fce32c13aaeaca46", "src_set": ""}, "body": "はじめまして、猫村さん。外国人だから韓国語でお答えいたします申し訳ありません...！ 5月のエアコミケに描かいただいたSSSS.GRIDMANに続いて、また一度レットカーあかね描いていただきたいという願いに申請してみました。構図は茜がリッカーの肩に期待しながら、片方の手だけポッドを挟んその上キスをすることに恥ずかしがるレットカーを見たいと思います。最後に、猫村さんの絵はいつもよく見ています。とてもクール！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@neco28/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 482334, "client_id": 27185, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/53a6c3ea/requests/183352_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12760155ecd19f431f2a9a27302f8146", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/53a6c3ea/requests/183352_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db946fc40b80e6940911f8f1cc20d966", "src_set": ""}, "body": "こんにちは！\n\n私の友達「山根ちいか」と「朝比奈智恵」二人のVtuberキャラにリクエストしたいです。互いに結婚しています。問題なければ 、あなたのCrossickの絵に似たシーンをリクエストしたいですけど、キスのポーズをください！他にも細かいことはお任せします。よろしくお願いします！\n\n二人の参照：\nhttps://twitter.com/asahinaChie\nhttps://imgur.com/a/uJNwIfK\n\nhttps://skeb.jp/@chiikadayo\nhttps://twitter.com/chiikadayo", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@neco28/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 482334, "client_id": 52205, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/40b97d21/requests/115006_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=306e37192cc9583f08a2c06d54392e7b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/40b97d21/requests/115006_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d143aafc862b14e02ab99384da1896f", "src_set": ""}, "body": "はじめまして\nシャニマスの樋口円香、浅倉透を描いていただきたいです。\nもし料金にそぐわない場合はどちらか片方でも構いません。\n構図など服装はおまかせしますが少し百合を感じるようなイラストをお願いしたいです。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@neco28/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 482334, "client_id": 106946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8cf63e41/requests/86625_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c6956d8c0a584ea3707d70125528c18", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8cf63e41/requests/86625_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0c0355e5d5a2f1e9a603f5834c7d18a", "src_set": ""}, "body": "はじめまして！\nリズの同人誌から猫村様のファンになりました。\n濃厚な百合絵をリクしようと思いましたが、今回はTRPGのオンラインセッションで使用する自キャラのデザインを依頼いたします。\n\n使用用途：TRPGセッションの自キャラの立ち絵\nTRPGのシステム：ダブルクロス The 3rd Edition　(現代日本を舞台にした異能バトル物です)\n\n\n\n▼キャラ設定\n名前：蒲池　いづみ\n年齢：26歳\n性格：優柔不断で主体性の無い性格\n体型：スタイル良し、大きすぎない巨乳\n出身：日本\n星座：蠍座\n身長：170cm程度\n血液型：A型\n\nその他：\n・薄幸の女性\n・異能力者を輩出している厳しい実家を飛び出して、現在は飲食店で働いている\n・左眼の目尻の横に泣き黒子\n・瞳は琥珀色\n・髪色はピンクアッシュ\n・髪型は両サイドを少し垂らして、後ろで1つ縛り\n・モチーフ元はZARDの坂井泉水さん\n・幸が薄そうだが、どこか色気のある表情\n\n\n▼服装\n・ややおとなしめの雰囲気だが、お洒落な感じでお任せします\n・『大人のお姉さん』イメージでまとまっていると嬉しいです\n\n▼その他\n・バストアップ～腰あたりまでの範囲の描写で構いません\n\n\n以上の内容でお願いします。\nその他の駒かい所は猫村様におまかせします。\n\nご検討よろしくお願い致します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@neco28/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 482334, "client_id": 400528, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62557b7a/requests/88677_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=74e2b44a61103efd8d455539c13afd90", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62557b7a/requests/88677_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7fe6a2182719fdc08744ed7ce7e1fb5", "src_set": ""}, "body": "はじめまして。何時も猫村先生の素晴らしいイラストをありがとうございます。この度skebイラスト依頼をお願いしたいです。\n\nVtuberにじさんじ所属ライバー健屋花那と白雪巴のコンビ\"Crossick\"(旧にじさんじ性癖コンビ)が大好きなので、よろしければイラストを描いて頂けたら嬉しいです！  \n\nウェディングドレスの姿を希望ですが、もちろん描きたいと思えるシチュエーションや、モチベーションが上がりやすいデザイン・構図等でも大丈夫です！\n\nお受け頂けて、イラストが完成しましたら、twitterに、#Crossick、#巴絵 と #いらすこや をつけて投稿して頂けたら嬉しいです！\n\n依頼の仕方として不備・不足等ありましたら申し訳ありません。  \n何卒よろしくお願いいたします。  \n\nキャラクター参考：\n白雪巴さん\nhttps://twitter.com/Tomoe_Shirayuki/status/1201045405472944128?s=19\n\n健屋花那さん\nhttps://twitter.com/sukosuko_sukoya/status/1175417960376098817?s=19", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@neco28/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 482334, "client_id": 20063, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4e45def7/requests/86036_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fd1ff32e1957fd7ff65d892083b37da", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4e45def7/requests/86036_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=701cf0b365530bdbf73228815b0eec73", "src_set": ""}, "body": "響け！ユーフォニアム・リズと青い鳥より、なかよし川の2人をスーツ姿で描いていただけないでしょうか？\nスーツの種類はどういったものでも構いません。\nよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@neco28/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 482334, "client_id": 6637, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/270acd4c/requests/82749_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6eff4f8903cf4f63e37bfe7bf873ab39", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/270acd4c/requests/827