b4df3e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b5817a319b9d4309e6e1c5729e0b4b5 2x, https://si.imgix.net/ba15b5c8/uploads/origins/161f9bfa-5588-49af-9f6b-8d56bb4df3e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d351c2a0ff4d185500651eaa90a4c906 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba15b5c8/uploads/origins/161f9bfa-5588-49af-9f6b-8d56bb4df3e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82524e8b07d64d0802901fda1acb1a82", "srcset": "https://si.imgix.net/ba15b5c8/uploads/origins/161f9bfa-5588-49af-9f6b-8d56bb4df3e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82524e8b07d64d0802901fda1acb1a82, https://si.imgix.net/ba15b5c8/uploads/origins/161f9bfa-5588-49af-9f6b-8d56bb4df3e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2527b1ee7cb12fcfd9585a817aa30b6a 2x, https://si.imgix.net/ba15b5c8/uploads/origins/161f9bfa-5588-49af-9f6b-8d56bb4df3e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=892c17d7d4f785c3e96f23936e4e22e6 3x"}, "body": "はじめまして、新着で拝見した絵柄が好みでしたので依頼を送らせていただきます。\n（オリキャラの依頼となりますので、オリキャラが無理と言う場合はこのあと全て読み飛ばしキャンセルしていただいて大丈夫です）\n\n○キャラ\n私の精神擬人化「九頭(くず)　くるみ」となります\nデザインは下記納品物をご参照いただければと思います\n(まだ参考物が少ないため、難しければキャンセルして構いません)\nhttps://skeb.jp/@jaco_zil/works/22\nhttps://skeb.jp/@NIM_n00/works/3\n性格など\n・料理やプロレス、音ゲーなどが好きな多趣味人間\n・少し神経質で活発、清楚な美人系 \n・身長は160cm台前半程度、20代前半くらいの見た目、とても大きな胸とお尻（体型イメージは参考画像をお送りします）\n・性格は割と図太い、少しクズ気味\n\n○キャラの口調・セリフサンプル（キャラクター像の一助になれば幸いです）\n落ち着いた口調、機嫌悪くなるとやや荒くなる。\n-「よっし、今日は海外から取り寄せた食材、試してみよっかな」\n-「これ2日前のやつだけど……ま、大丈夫だよね」\n-「ラスボスに全回復搭載してるなんておかしいでしょ！？」\n\n○シチュなど\n・部屋でコスプレ自撮りをしていて、悪そうなポーズを模索している感じ（出来が良ければそのまま写真を売り飛ばそうと画策している）\n（キャラクター・衣装・ポーズは参考資料のほうをご参照お願いします）\n・髪型はコスプレとわかるようそのままでお願いします\n・宛名などはレイヤー分けしていただきたいです\n\n細部や構図、表情などは絵師様に一任します\n難しいかもしれませんが、ご検討の程をよろしくお願いいたします\n\nhttps://www.dropbox.com/s/doefjajllov5rm9/pai3.jpg?dl=0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mawarutikuwa/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 888159, "client_id": 530336, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/840deea8/uploads/origins/ebca8dae-021f-4248-bb2f-65bfc4666173?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e0150dfe9c3c85e82612e595c39e5b8", "srcset": "https://si.imgix.net/840deea8/uploads/origins/ebca8dae-021f-4248-bb2f-65bfc4666173?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e0150dfe9c3c85e82612e595c39e5b8, https://si.imgix.net/840deea8/uploads/origins/ebca8dae-021f-4248-bb2f-65bfc4666173?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=31c4af4a86ab6fd97af41ce10cbcaccf 2x, https://si.imgix.net/840deea8/uploads/origins/ebca8dae-021f-4248-bb2f-65bfc4666173?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=656ac41cc62134a2fbf86e591ff4fd54 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/840deea8/uploads/origins/ebca8dae-021f-4248-bb2f-65bfc4666173?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=287fa8bbfa2927c984826dfd6d890b93", "srcset": "https://si.imgix.net/840deea8/uploads/origins/ebca8dae-021f-4248-bb2f-65bfc4666173?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=287fa8bbfa2927c984826dfd6d890b93, https://si.imgix.net/840deea8/uploads/origins/ebca8dae-021f-4248-bb2f-65bfc4666173?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=465682920669c52a74ac102d664f146c 2x, https://si.imgix.net/840deea8/uploads/origins/ebca8dae-021f-4248-bb2f-65bfc4666173?bg=%23fff&auto=format%2Ccompre