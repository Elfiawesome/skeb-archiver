特徴】\nギザギザの歯、舌先が裂けています。\n髪は白で毛先が水色になっています。\n白蛇と人間のキメラ。\n目が特徴的で、黒く細長い瞳孔の中に白い線があります。\n黄色い部分はハート型になっています。\n\n【使用用途】\n・X等のSNSアイコンヘッダー\n・YouTubeサムネ等\n・SNSで紹介\n\n【納品形式】\nPSDデータで、分けていただけますと幸いです。\n\nhttps://drive.google.com/file/d/1izgqH36zl8n8Lv2Top04hYecbFPoLfew/view?usp=drive_link\nhttps://drive.google.com/file/d/1uffMTj2EIn_tCYyzQtv8p-waOaY5iVAh/view?usp=drive_link\nhttps://x.com/uradagui/status/1814799699108634881", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hat_30/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3431566, "client_id": 3109475, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9aa0b4b/uploads/origins/1d647cb7-75de-4e68-8c7e-7755d883471e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2189bbe0bca366e4c320f2f521aaebb3", "srcset": "https://si.imgix.net/d9aa0b4b/uploads/origins/1d647cb7-75de-4e68-8c7e-7755d883471e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2189bbe0bca366e4c320f2f521aaebb3, https://si.imgix.net/d9aa0b4b/uploads/origins/1d647cb7-75de-4e68-8c7e-7755d883471e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1874ccd38ec8ba30c64b89a7efde6538 2x, https://si.imgix.net/d9aa0b4b/uploads/origins/1d647cb7-75de-4e68-8c7e-7755d883471e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0bc98b04ab21ce5d191ff7dca7fc48a4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9aa0b4b/uploads/origins/1d647cb7-75de-4e68-8c7e-7755d883471e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f681e6312a708d0a99901e1e3382e405", "srcset": "https://si.imgix.net/d9aa0b4b/uploads/origins/1d647cb7-75de-4e68-8c7e-7755d883471e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f681e6312a708d0a999