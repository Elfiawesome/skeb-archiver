＋チャイナの方のデザインで描いていただけますと幸いです。\nお色味は絵柄に合わせて調整していただいて問題ございません。\n（肌の色は褐色マストでお願いします）\n\n----------------------\n\n●使用用途\nYouTube配信サムネイル（収益化済み）\n各種ＳＮＳ（Ｘ・インスタ・TikTok）での利用。\nグッズ販売等の商用利用。\n※使用不可の項目がございましたらレイヤーでご教授いただけますと幸いです。\n\n●形式\nキャラとレイヤーを分けた形式でいただけると大変ありがたいです。\nデータはPSDデータまたはPNGデータでお願いしたいです。\nサムネイルで使用する場合がございますため、キャンバスから見切れないようにしていただけると大変ありがたいです。\n\nぜひよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1nhyqLLUvR262SPDGxgUrcPwRjAD6Fwk6", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hat_30/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3431566, "client_id": 3391930, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3452321/uploads/origins/c8e54281-31ee-4fbc-84c6-3fb4fb7520eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a425f6af4ce9ad2db469741100b6e02", "srcset": "https://si.imgix.net/e3452321/uploads/origins/c8e54281-31ee-4fbc-84c6-3fb4fb7520eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a425f6af4ce9ad2db469741100b6e02, https://si.imgix.net/e3452321/uploads/origins/c8e54281-31ee-4fbc-84c6-3fb4fb7520eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad0400956d14d4dd06d049dc8a6d442c 2x, https://si.imgix.net/e3452321/uploads/origins/c8e54281-31ee-4fbc-84c6-3fb4fb7520eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f03a83cacb98b5e159ccb0036160dcf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e3452321/uploads/origins/c8e54281-31ee-4fbc-84c6-3fb4fb7520eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0188c2221ce431545252eab3c559d11e", "srcset": "https://si.imgix.net/e3452321/uploads/origins/c8e54281-31ee-4fbc-84c6-3fb4fb7520eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur