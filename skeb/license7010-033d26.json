able_same_genre": true}, {"path": "/@license7010/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1620516, "client_id": 1528956, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/491631c0/uploads/origins/ba024a9d-9112-4340-bdfa-abc8ea0872c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c738e5fd6f699a1988a752a98ac4fc88", "srcset": "https://si.imgix.net/491631c0/uploads/origins/ba024a9d-9112-4340-bdfa-abc8ea0872c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c738e5fd6f699a1988a752a98ac4fc88, https://si.imgix.net/491631c0/uploads/origins/ba024a9d-9112-4340-bdfa-abc8ea0872c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e7d3b2cb598dba3015037d16e8b8763 2x, https://si.imgix.net/491631c0/uploads/origins/ba024a9d-9112-4340-bdfa-abc8ea0872c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da051a0153d8a923f4adce45a77d7941 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/491631c0/uploads/origins/ba024a9d-9112-4340-bdfa-abc8ea0872c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66caa9abf13c30c0771b23c80f5c7c6b", "srcset": "https://si.imgix.net/491631c0/uploads/origins/ba024a9d-9112-4340-bdfa-abc8ea0872c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66caa9abf13c30c0771b23c80f5c7c6b, https://si.imgix.net/491631c0/uploads/origins/ba024a9d-9112-4340-bdfa-abc8ea0872c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b0d4b45d7dd48c28ba40f86b71830302 2x, https://si.imgix.net/491631c0/uploads/origins/ba024a9d-9112-4340-bdfa-abc8ea0872c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0174bc673e7b4b4b57c9dd0fafae0e15 3x"}, "body": "はじめまして\n\nスカ要素を含む依頼なので、NGであればキャンセルしてください。\n\n漫画怨み屋シリーズに登場する怨み屋の差分形式のイラストをお願いします。\n漫画が元ですが、キャラクターデザインは下記URLの怨み晴らしRUSH　ドSで\n登場するミニスカ姿でお願いします。\nhttps://pachist.jp/pachi/514/2447/\n\n自身も怨みを買っていた怨み屋が電車内で体を押さえられてスカートをめくられ、\nイチジク浣腸をされてパンツの中に脱糞お漏らしをする様を見世物にされている\nイラストを、差分形式でお願いします。\n（基本絵で浣腸挿入、差分でおもらし）\n料金が合わなければ、漏らした後のイラストをお願いします。\n漏らした後の表情は羞恥心で泣き叫んでいるものでお願いします。\n\nどうぞよろしくお願いします。", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@license7010/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1620516, "client_id": 698483, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f7349576/uploads/origins/fe384424-b9e9-492d-8e78-b0433ccb2d3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffbeaeeee776db46ba5e9f411d9d036b", "srcset": "https://si.imgix.net/f7349576/uploads/origins/fe384424-b9e9-492d-8e78-b0433ccb2d3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffbeaeeee776db46ba5e9f411d9d036b, https://si.imgix.net/f7349576/uploads/origins/fe384424-b9e9-492d-8e78-b0433ccb2d3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee0240d9e46fc72084f8b8d3d5730d63 2x, https://si.imgix.net/f7349576/uploads/origins/fe384424-b9e9-492d-8e78-b0433ccb2d3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b34777fe55a09fd68edffea3990f167 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f7349576/uploads/origins/fe384424-b9e9-492d-8e78-b0433ccb2d3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8947ef315b3b0218297e47b9f597dc30", "srcset": "https://si.imgix.net/f7349576/uploads/origins/fe384424-b9e9-492d-8e78-b0433ccb2d3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8947ef315b3b0218297e47b9f597dc30, https://si.imgix.net/f7349576/uploads/origins/fe384424-b9e9