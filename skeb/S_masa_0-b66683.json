猫\n・身長150センチ（耳を含まない）\n・猫耳としっぽがあり、人間の耳がありません\n\n【参考資料】\nhttps://drive.google.com/drive/folders/12YJ1-uparnq_s7hCfYaCiP4sSk9bZMpW?usp=sharing\n\nご検討いただけますと幸いでございます。\nどうぞよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@S_masa_0/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3387704, "client_id": 2589127, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a16ad3a/uploads/origins/2d4dbfeb-858d-44f2-910f-c534e36dd6fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c013a26bb3be3da77d8e5b92d6a0d0f", "srcset": "https://si.imgix.net/1a16ad3a/uploads/origins/2d4dbfeb-858d-44f2-910f-c534e36dd6fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c013a26bb3be3da77d8e5b92d6a0d0f, https://si.imgix.net/1a16ad3a/uploads/origins/2d4dbfeb-858d-44f2-910f-c534e36dd6fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6977eaca539146188f101f9a9175ea78 2x, https://si.imgix.net/1a16ad3a/uploads/origins/2d4dbfeb-858d-44f2-910f-c534e36dd6fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68e00e1aa1ed775e52ac4270d00ddd59 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a16ad3a/uploads/origins/2d4dbfeb-858d-44f2-910f-c534e36dd6fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=330831b5f48144f10f3c9394e8a663e7", "srcset": "https://si.imgix.net/1a16ad3a/uploads/origins/2d4dbfeb-858d-44f2-910f-c534e36dd6fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=330831b5f48144f10f3c9394e8a663e7, https://si.imgix.net/1a16ad3a/uploads/origins/2d4dbfeb-858d-44f2-910f-c534e36dd6fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3b7d33794de09c1562c7c102137783cf 2x, https://s