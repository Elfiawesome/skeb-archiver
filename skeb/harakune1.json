it=crop&crop=top&w=200&h=200&blur=200&s=7f427c9f0c7291bb57f31497ebaf60b7", "src_set": ""}, "body": "こんにちは！ お元気ですか？ リクエストなのですが、ナズーリンをカウガールで描いていただけませんか？ ウ 全てお任せします！ いつもありがとうございます！  \n\nHello! I hope you are doing well! For my request, would you be able to draw Nazrin as a cowgirl? I'll leave everything up to you! Thank you very much always!", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@harakune1/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2554351, "client_id": 708175, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a20e1f92/uploads/origins/24eb06db-4c5e-4ac9-8df3-ff750f4a75f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ddb9bfb623110e409f53e241d322697", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a20e1f92/uploads/origins/24eb06db-4c5e-4ac9-8df3-ff750f4a75f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd49920221e4e6ad287943d357bd523c", "src_set": ""}, "body": "ハラクネさん初めまして！\nバーチャルYotuberで活動しております、星見悠と申します。\n色彩鮮やかな可愛いイラストをXで拝見して、ぜひ描いて頂けたらと思いリクエストを送りました！\n\n【ご依頼内容】\nおとこの娘キャラクターの星見悠くん\n自信満々なポーズのイラストを描いて頂けると嬉しいです！\n髪のインナーカラーをピンクでお願いします！\nスカートの下はスパッツをはいています！\n\n参考の立ち絵などを入れたグーグルドライブのURLを載せております！\nhttps://drive.google.com/drive/folders/1AcsyuhkYijIItPs4PHLnWqdR7YfJEN6E?usp=sharing\n\n【データ内容】\nサムネイルで使用したい為、文字や背景とキャラクターが透過されたデータ（PSDデータ等）を頂けると嬉しいです！\n\n【サイズ】\nA4サイズ以上でお願いします。\n\n【イラストの用途】\nYoutubeのサムネイル、動画等\nＸ（旧Twitter）での告知等\n\nお忙しいところ恐れ入りますが、ご検討の程、何卒宜しくお願い致します！！\n\nhttps://drive.google.com/drive/folders/1AcsyuhkYijIItPs4PHLnWqdR7YfJEN6E?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@harakune1/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2554351, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/af4e94b1/uploads/origins/75ca6093-1475-4bc8-a5b9-fce198b803a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a31fcd48600d974915e196880fa5a9a8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/af4e94b1/uploads/origins/75ca6093-1475-4bc8-a5b9-fce198b803a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=595ecb167ad7cc0853e41b1ec0cd846a", "src_set": ""}, "body": "こんにちは！最初のBBのイラストがとても気に入ったので、他のイラストもお願いしたいのですが！\n\n今度はナース服を着て、参考にしたのと同じポーズで描いてほしいです。今回も、ロングヘア、胸、お尻、太もも、ガーターストラップなど、特に参考にしていただいたような部分を強調してお願いしたいです。背景はシンプルな色で構いません。表情はキュートな笑顔と、自信に満ちたにっこり笑顔のバリエーションでお願いします。\n\nキャラクター：https://imgur.com/a/3155R74\nコスチューム：https://catbox.moe/c/ttn9nf\nポーズとインスピレーション: https://files.catbox.moe/xxvajk.jpg\n表情1: https://files.catbox.moe/38kc3h.png\n表情2： https://files.catbox.moe/n4tlcq.png または https://files.catbox.moe/tddnjf.jpg\n\nぜひご検討ください。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@harakune1/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2554351, "client_id": 731765, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e3b9502/uploads/origins/a894bb57-58be-4946-968a-ddee3be7aadb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c0be53ed944c94b0055ee5a8b56e493e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e3b9502/uploads/origins/a894bb57-58be-4946-968a-ddee3be7aadb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f176e0d48b536811be3b3e59f1d56290", "src_set": ""}, "body": "はじめまして！ずっと前からハラクネさんのイラストがとても好きなので依頼を送らせて頂きます！\n\n特にハラクネさんが描いた表紙用の聖白蓮が好きだったんですが、東方のキャラの中では白蓮が私の一番好きなキャラです！それで、聖白蓮のイラストをお願い出来るのでしょうか。\n\n宜しかったら、衣装は競泳水着とパーカーをお願いしますが、もし他の風に描きたいのならご自由に変更しても構いません！他の構図も好きな様に描いて頂けたら幸いですが、一つの提案として照れてる表情が良いと思います。\n\nもし興味があれば、是非宜しくお願い致します！ご検討をよろしくお願いいたします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@harakune1/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2554351, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aec5bdb5/uploads/origins/e8d8bcdc-79c6-4d91-98c9-1feaeb823b05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=711a7ec8a8cc2fc209c9d668fcfb2ec0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aec5bdb5/uploads/origins/e8d8bcdc-79c6-4d91-98c9-1feaeb823b05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d704c2eb24a736eaf5317c77d40b23d", "src_set": ""}, "body": "こんにちは。\n\nフェイト/エクストラCCCのBBをお願いしたいです。このhttps://skeb.jp/@harakune1/works/2のためにあなたが描いたポーズに本当に感心しています。片手を腰に当てて、もう片方はこのhttps://imgur.com/5GoJEnK。\n\nhttps://imgur.com/7n0E9DL、https://imgur.com/a/UU03vHz。\n\nできれば、ウインクしているバージョンと、両目を開けているバージョンも欲しいです。また、https://imgur.com/a/jbg5Tae。\n\n背景はシンプルなピンクかオレンジでお願いします。\n\nよろしくお願いします。\n\nhttps://imgur.com/a/3155R74", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@harakune1/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2554351, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/60ea4449/uploads/origins/874eefdf-2f99-4486-a8c6-5bbbb230e9ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c95ea4e48179ed8cab1594bc9f2c4f40", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/60ea4449/uploads/ori