=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02c151900162ef99c392f54afcf2a6c2", "src_set": ""}, "body": "キャラクターは、みすちーで\n衣装を制服の下にスク水を着込んでいて、凄く汗をかいてる\nシチュエーションでお願いいたします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@harakune1/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2554351, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/997b0554/uploads/origins/6f94dda8-80cb-45bc-b278-285109bc669d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3fdf5f96c8807175c64d0d775e1446a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/997b0554/uploads/origins/6f94dda8-80cb-45bc-b278-285109bc669d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f395857ab88482278a467a4351f9e537", "src_set": ""}, "body": "Hello! I was wondering if you can draw Nazrin from Touhou Project! If so, please draw her cutely! I'll leave everything up to you!\n\nこんにちは。 東方Projectのナズーリンを描いていただけませんか! 可愛く描いてください 全部おまかせします", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@harakune1/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2554351, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ca31705/uploads/origins/dd7cac22-1ea2-44c1-a13a-f6bea9e32578?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=effc95859f8426f019f12df5ea876cd9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ca31705/uploads/origins/dd7cac22-1ea2-44c1-a13a-f6bea9e32578?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=709e69be25f124875de5400523481808", "src_set": ""}, "body": "ウインクしながらドヤ顔をしていて、胸元が少しはだけている宮古芳香をリクエストします\nギザ歯でおっぱいは大きめでよろしくお願いします", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@harakune1/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2554351, "client_id": 68057, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2d41bdf3/uploads/origins/4f257604-02ed-45e8-b558-6084f6df6242?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13a3079487e3f1608cbe90c8f734df99", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d41bdf3/uploads/origins/4f257604-02ed-45e8-b558-6084f6df6242?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15fd44d06e0ed26b6c0299ff7fb840f9", "src_set": ""}, "body": "こんにちは。\n東方キャラを中心としたイラスト楽しませて頂いております！\nこの度は自分の創作キャラクター「牡丹」のイラストをお願いしてもよろしいでしょうか。\n設定や資料は以下に記載いたします。何卒、よろしくお願いいたします！\n\n・明るく真面目ですが、天然で行き当たりばったりな性格のレトロな女学生です。\n・服装はピンク色の矢絣の着物、紫色の袴とリボン、牡丹の花の髪飾り、濃茶色の編み上げブーツです。\n・実は人間と宇宙人のハーフで、色々便利なUFOを呼び出すことができます。\n・身長は大体160cm強のイメージです。\n・構図や表情等はお任せしますが、茶色のロングヘアが靡き目立つような構図にして頂けますと嬉しいです。\n\n・https://drive.google.com/drive/folders/1J2lw_FhEwqzKsQzlls8Ii95CpesyBcQ8\n・https://drive.google.com/drive/folders/1KgPOZ1bvZsUK2zmQ0SnP9uCTEnp2tFXw", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@harakune1/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2554351, "client_id": 1097808, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b4d491f/uploads/origins/de100438-51d8-4afd-a91f-5d66d3e7dbd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1153ac00b5e6603d82e0d70dc3081a25", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_th