お任せいたしますので、先生の個人のスタイルで自由に描いていただけたら嬉しいです。 \n\n 【使用用途】 \n個人観賞用・個人使用の範囲での少部数印刷・SNSアイコン・ヘッダー等\n\n  ポイント不足がございましたら、再度リクエストを送らせていただきます。 ご縁がございましたら、どうぞよろしくお願いいたします！  \n\nhttps://drive.google.com/drive/folders/1vIh5xcaFmIC02X7p_5uNKjbx9L9WRK50", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@s_obig/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3905950, "client_id": 2662310, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1cc6d427/uploads/origins/324c8c4c-1190-4f0f-b08f-767c03747afc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d74fae09fe364468963c6e2e50fb6166", "srcset": "https://si.imgix.net/1cc6d427/uploads/origins/324c8c4c-1190-4f0f-b08f-767c03747afc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d74fae09fe364468963c6e2e50fb6166, https://si.imgix.net/1cc6d427/uploads/origins/324c8c4c-1190-4f0f-b08f-767c03747afc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=684e9219b928cba663f845ad695b337c 2x, https://si.imgix.net/1cc6d427/uploads/origins/324c8c4c-1190-4f0f-b08f-767c03747afc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b347b33d85c58a51346d27b673002a9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1cc6d427/uploads/origins/324c8c4c-1190-4f0f-b08f-767c03747afc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7130d5bd84d3f6d7e628f79b0532aff6", "srcset": "https://si.imgix.net/1cc6d427/uploads/origins/324c8c4c-1190-4f0f-b08f-767c03747afc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7130d5bd84d3f6d7e628f79b0532aff6, https://si.imgix.net/1cc6d427/uploads/origins/324c8c4c-1190-4f0f-b08f-767c03747afc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&bl