7464/uploads/origins/46f838b4-12a0-4dbb-af13-9bc2e47bab2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24334f15da50c45d681e45d92e876401", "srcset": "https://si.imgix.net/d0807464/uploads/origins/46f838b4-12a0-4dbb-af13-9bc2e47bab2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24334f15da50c45d681e45d92e876401, https://si.imgix.net/d0807464/uploads/origins/46f838b4-12a0-4dbb-af13-9bc2e47bab2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6725ab7bab385c1d6e91eb650d47092d 2x, https://si.imgix.net/d0807464/uploads/origins/46f838b4-12a0-4dbb-af13-9bc2e47bab2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a25d8e9d826c88da75e372f6a963f72f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d0807464/uploads/origins/46f838b4-12a0-4dbb-af13-9bc2e47bab2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ca159c82ae718c85c0dfb484bbc4479", "srcset": "https://si.imgix.net/d0807464/uploads/origins/46f838b4-12a0-4dbb-af13-9bc2e47bab2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ca159c82ae718c85c0dfb484bbc4479, https://si.imgix.net/d0807464/uploads/origins/46f838b4-12a0-4dbb-af13-9bc2e47bab2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=df64b0d62963d08e96a6ed6dc31c2511 2x, https://si.imgix.net/d0807464/uploads/origins/46f838b4-12a0-4dbb-af13-9bc2e47bab2f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=46dde9f3b796e5caef3356527867982c 3x"}, "body": "こんにちは！フィクション・ポッドキャスト『Escaping Denver』のファンキャラクターを描いていただけませんか？\n\nデブスは非常に神経質な人物です。目は大きく見開いていて、とても弱々しく見えます。しかし、実はデブスは、人間を実験材料にする秘密の邪悪な政府組織の、非常に高い地位にある兵士なのです。その組織で、デブスは分隊長だったパーマーと出会い、彼に恋をしました。パーマーはデブスとは正反対の性格で、強靭でサディスティックであり、自分の楽しみのためにデブスを弄ぶことを好んでいます。 それは毒のような関係だ。二人はともに狼男である。\n\n参考画像は以下の通り：\nデブス：https://i