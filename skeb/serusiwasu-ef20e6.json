\nどうぞよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1p_SC-xaGSeJAapGUPl6JZr6chU118eRV", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@serusiwasu/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "correction", "tipped": false, "creator_id": 2324780, "client_id": 1138007, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f620de85/uploads/origins/c1024f7f-310c-4b18-a370-fe2b0d1220ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1606f6b1a0efb4407ae94fc041c0e07", "srcset": "https://si.imgix.net/f620de85/uploads/origins/c1024f7f-310c-4b18-a370-fe2b0d1220ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1606f6b1a0efb4407ae94fc041c0e07, https://si.imgix.net/f620de85/uploads/origins/c1024f7f-310c-4b18-a370-fe2b0d1220ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b56b9b8ff305c21ecd360040ded95303 2x, https://si.imgix.net/f620de85/uploads/origins/c1024f7f-310c-4b18-a370-fe2b0d1220ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3e6d3779bf9966b0d80324351633db88 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f620de85/uploads/origins/c1024f7f-310c-4b18-a370-fe2b0d1220ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=916c24d072c04587cda4c15579f7544c", "srcset": "https://si.imgix.net/f620de85/uploads/origins/c1024f7f-310c-4b18-a370-fe2b0d1220ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=916c24d072c04587cda4c15579f7544c, https://si.imgix.net/f620de85/uploads/origins/c1024f7f-310c-4b18-a370-fe2b0d1220ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f28db892c36eb4ff7971c750beacdd1a 2x, https://si.imgix.net/f620de85/uploads/origins/c1024f7f-310c-4b18-a370-fe2b0d1220ee?bg=%