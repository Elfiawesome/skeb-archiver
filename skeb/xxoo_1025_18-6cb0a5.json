&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0495936706557283b357cf0e33598a2f 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3599742, "client_id": 3634627, "nc": 32}, {"path": "/@xxoo_1025_18/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3599742, "client_id": 3251590, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1b2995ac/uploads/origins/2ed90a71-6336-47ac-8023-2d1a028e034f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfce340d45c055ec49ed00f708b23819", "srcset": "https://si.imgix.net/1b2995ac/uploads/origins/2ed90a71-6336-47ac-8023-2d1a028e034f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfce340d45c055ec49ed00f708b23819, https://si.imgix.net/1b2995ac/uploads/origins/2ed90a71-6336-47ac-8023-2d1a028e034f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=419359141e933576b51c4697ef92f658 2x, https://si.imgix.net/1b2995ac/uploads/origins/2ed90a71-6336-47ac-8023-2d1a028e034f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bc723d8081a5617a0b9b2451107abdba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b2995ac/uploads/origins/2ed90a71-6336-47ac-8023-2d1a028e034f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69111e746cbd95819626926c7379ea3a", "srcset": "https://si.imgix.net/1b2995ac/uploads/origins/2ed90a71-6336-47ac-8023-2d1a028e034f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69111e746cbd95819626926c7379ea3a, https://si.imgix.net/1b2995ac/uploads/origins/2ed90a71-6336-47ac-8023-2d1a028e034f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7164ef722b9fa3cdcc02c6d3e314633c 2x, https://si.imgix.net/1b2995ac/uploads/origins/2ed90a71-6336-47ac-8023-2d1a028e034f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f814df4bdf3f9a053ea34d1314d68dc5 3x"}, "body": "初めまして。いつもこっそりイラスト拝見させて頂いております！\n今回、クトゥルフ神話TRPG四季送りで通過させて頂いたHO秋、春のCP漫画を描いていただきたいと思い、リクエスト送らせて頂きました！\n\n-キャラ詳細-\nHO春 女 (名前)鬼灯杏子-ほおずき あんず-《攻め》\nギャル。みんな平等に話しかけ、いつもテンションが高く、ニコニコしているオタクに優しいギャル。\nしかし、彼女の本性は家族以外誰も信頼していない拗らせ女。HO秋のことは最初殺したいほど嫌いだったが、とある事件がきっかけでHO秋を自分のものにしたいという気持ちが芽生えてきた。\n\nHO秋 男 (名前)神咲 竜胆-かみさき りんどう-《受け》\n一言で言えば赤ちゃん。\n家族愛しか知らないので結婚と言われてもぽかんとしてるタイプ。\nHO春のアタックには「なにを言っているんだろう」って思われている。\nHO春のことは仲間として好き。恋愛感情はない(分からない)\n※どちらも同じ喫茶店で働く同僚＆裏稼業で殺し屋をしています。\n\n-書いて欲しい内容-\nHO秋がモブ女と楽しそうに話しているのを目撃したHO春。\n怒りのあまりモブ女を殺めて\nHO春「鈍感にも程があるよ？」と言いながら無理やりHO秋の腕を押さえつけて\nHO春「私以外見れないように開発してあげる」\nと言い放つHO春\nというような感じのが見たいです！\n\n表情や言動などはどんなものでも特に気にしないです！！\n\n\nTwitterにて自慢ツイートをさせて頂く、相方に共有する場合があります。\nどちらにしても〇〇ちゃん様に描いていただけたとわかるように表記致します。\n\nご検討頂けると幸いです。\n\nhttps://drive.google.com/drive/folders/1ptA20B1WGmHM4d14XoTHhaldC2-yfxHp?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@xxoo_1025_18/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3599742, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c74f7727/uploads/origins/acab080c-fe04-40f6-a964-6c4d0cbcb7ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75694effff45e26cea60f62b2e778c74", "srcset": "https://si.imgix.net/c74f7727/uploads/origins/acab080c-fe04-40f6-a964-6c4d0cbcb7ef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75694effff45e26cea60f62b2e778c74, https://si.imgix.net/c74f7727/uploads/origins/acab080c-fe04-40f6-a964-6c4d0cbcb7ef?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6bf90bdf38f3f2f6976df52b1f01725e 2x, https://si.imgix.net/c74f7727/uploads/origins/acab080c-fe04-40f6-a964-6c4d0cbcb7ef?bg=%23fff&a