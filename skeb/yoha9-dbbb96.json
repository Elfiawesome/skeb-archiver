の程、よろしくお願いいたします。\n\nご本人リットリンク（正面姿、後ろ姿）\nhttps://lit.link/PSjlIsL1oWZssbV2VRD63lasXdw1\n\nhttps://x.com/usd_mochiko/status/2039552344208339122", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 3623, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ねるぞう", "screen_name": "_neruzou", "avatar_url": "https://pbs.twimg.com/profile_images/2003307404952518656/G6L91diq.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2258884646/1768659653/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 28722, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "鈴穂ほたる🐾", "screen_name": "suzuhohotaru", "avatar_url": "https://pbs.twimg.com/profile_images/1637008471030923264/5pCZRGnr.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2597740807/1689432149/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 40, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 656953, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "たいふぉ@お絵描き", "screen_name": "CTypho", "avatar_url": "https://pbs.twimg.com/profile_images/1507417491492196352/GKD1GDTn.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1058937544706973696/1652525235/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"g