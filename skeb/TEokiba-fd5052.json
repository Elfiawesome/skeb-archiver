_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TEokiba/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3866974, "client_id": 3895868, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62fbe5dd/uploads/origins/0cd30ea9-16ea-436c-a846-8185c437881e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcb026ad883c30ab88b771a9d625e11d", "srcset": "https://si.imgix.net/62fbe5dd/uploads/origins/0cd30ea9-16ea-436c-a846-8185c437881e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcb026ad883c30ab88b771a9d625e11d, https://si.imgix.net/62fbe5dd/uploads/origins/0cd30ea9-16ea-436c-a846-8185c437881e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db41a821d886c9624b193f72aaa0344d 2x, https://si.imgix.net/62fbe5dd/uploads/origins/0cd30ea9-16ea-436c-a846-8185c437881e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a24aab45c5fb777650a750c12e82adac 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62fbe5dd/uploads/origins/0cd30ea9-16ea-436c-a846-8185c437881e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f385b3b6184ae9064409f0757a0be8f", "srcset": "https://si.imgix.net/62fbe5dd/uploads/origins/0cd30ea9-16ea-436c-a846-8185c437881e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f385b3b6184ae9064409f0757a0be8f, https://si.imgix.net/62fbe5dd/uploads/origins/0cd30ea9-16ea-436c-a846-8185c437881e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=21f2b2661f43b53e0f45cd8bfbcefcec 2x, https://si.imgix.net/62fbe5dd/uploads/origins/0cd30ea9-16ea-436c-a846-8185c437881e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c8edc88e2a176833f44c453f2ac276fa 3x"}, "body": "つみぎる様\n\n初めまして。個人でデザイナー兼配信活動をしているのだめろんと申します。\nつみぎるさんのイラストを拝見しまして、とても素敵だなと思い今回リクエスト送らせていただきました…！\nもしリクエスト内容、使用用途が問題なければ、是非私のイラストを描いていただければなと思っております…！\n\n【参考資料】\nhttps://www.dropbox.com/scl/fo/x2wguxrqjbg0i43hazsd7/AJpGPHqr_LZfUUFx8mbKkCM?rlkey=xqy4ik9v1t4k7kxwd2k4nu3f0&dl=0\n\n特にこちらのイラストの振り向き構図がとても可愛かったので、私もこのように振り向いて可愛い感じに描いていただけないでしょうか？\n（ただ…私のKV三面図がまだないので💧衣装等で難しそうであれば、構図も服装も全てお任せでお願いしたいです…！）\nhttps://skeb.jp/@TEokiba/works/4\n\n世界観は異世界なので…現代風というよりは中世ヨーロッパ風な衣装で描いていただけると嬉しいです（でも、がちがちなコンセプトではないので、描きづらければ気にせずにお描きください！）\n\n・構図や表情、ポーズなどは全てお任せ致します。\n・服装・アクセサリー等はキャラデザのものでなくても構いません。（帽子をトルなど、装飾品を減らしたり、全く別の服装になっても構いません。雰囲気等の希望はキャラシに記載しておりますが…基本お好きに描いていただければなと思っております…！）\n・宣伝等に使用予定のため、頭部や髪の毛、腕などが見切れていないと嬉しいです！（←構図的に椅子などで隠れたりする場合、気にしないでください！）\n\n【使用用途】\n・収益化をしているTwitch・Youtubeチャンネル等のサムネイル・配信バナー\n・SNSのアイコン、ヘッダー、投稿等\n・PCデスクトップ壁紙\n・グッズ制作（個人観賞のみ）\n\n\n\n・納品形式は可能であれば…人物・背景・小物（←もしあれば）を分けたpsdデータもしくは透過画像での納品だと大変助かります。\n\n\n何卒、ご検討のほど宜しくお願い致します。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TEokiba/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ea400f26/uploads/origins/57ad9752-b95e-467c-8744-b1f1965b4990?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a403fa31f4b7f386285e62b8eaee625e", "srcset": "https://si.imgix.net/ea400f26/uploads/origins/57ad9752-b95e-467c-8744-b1f1965b4990?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a403fa31f4b7f386285e62b8eaee625e, https://si.imgix.net/ea400f26/uploads/origins/57ad9752-b95e-467c-8744-b1f1965b4990?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=624b75871d565f0406660e75a59b8659 2x, https://si.imgi