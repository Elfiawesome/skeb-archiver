96a6faa46d8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=684e384784bfa1390c4fc1bc6cf2b352, https://si.imgix.net/8b6d9699/uploads/origins/3f91de7b-04c0-42ad-b203-96a6faa46d8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=86eaf3584db322d7769fe7bc0a31b5d6 2x, https://si.imgix.net/8b6d9699/uploads/origins/3f91de7b-04c0-42ad-b203-96a6faa46d8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81a85dbf163a8632bc9775c5d6ed8222 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b6d9699/uploads/origins/3f91de7b-04c0-42ad-b203-96a6faa46d8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99d130b3bbda7dff4ed3fad60e4b1f3e", "srcset": "https://si.imgix.net/8b6d9699/uploads/origins/3f91de7b-04c0-42ad-b203-96a6faa46d8f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99d130b3bbda7dff4ed3fad60e4b1f3e, https://si.imgix.net/8b6d9699/uploads/origins/3f91de7b-04c0-42ad-b203-96a6faa46d8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0906d3b8a8c59185a70dd5b83c57a80b 2x, https://si.imgix.net/8b6d9699/uploads/origins/3f91de7b-04c0-42ad-b203-96a6faa46d8f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2a4db1e44e80144a17e71bc315fbfde5 3x"}, "body": "前田 塩様\n\n初めまして。「お米」と申します。\n先日新着にて前田 塩様のイラストを拝見し、絵柄と絵の雰囲気に惹かれ、この度はオリジナルキャラクター2人を描いて頂きたくリクエスト失礼しました。\n大変お忙しいとは思われますが、ご検討いただけますと幸いです。\n\n---------------------------\n【内容】\n下記リンク先のキャラクターイラストをお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/cyjkrmbdki8gb22m7d992/AN4PGY0S2-Ii1rk3X50hZsY?rlkey=cl4pdauggtwvjsaipc5b47n58&dl=0\n\n【使用用途】\n･個人鑑賞/使用\n･個人用に印刷\n\n◆キャラ1\n【名前】陸梁 逢嵐(ろくばり あらん)\n【年齢】27\n【性別】男性\n【職業】マフィア(ボス)\n【イメージカラー】ピンク(マゼンタ寄り(目の色))\n【性格】見た目や年齢とそぐわない幼い性格。好きなものは好き、嫌いなものは嫌い。物事を自分にとって邪魔か否かで判断し、やることなすこと豪快。一見人懐っこく取っ付きやすい性格だが単純かつ非倫理。手の付けられない暴れ馬とも言える。飽き性。よく笑う。\n【好きな物】時雨(相棒)、喧嘩、酒、楽しいこと\n【その他】\n・頭脳派/ダウナーのような見た目だが、難しいことは何も分からない根っからの馬鹿。加えて馬鹿力の持ち主であり身体が丈夫。脳筋の破壊神。\n・無痛症であるため自分が傷つくことを恐れていない/相手がどれほどで致命傷になるかも分かっていない。無知な戦闘兵器として育てられてきた。(相棒と出会い人の感情を知った)\n・普段から笑っており喜怒哀楽の怒と哀を感じたことが少ない。笑い方も大胆かつ声がでかい。主張が激しい。\n・モチーフ▶︎嵐、拳銃\n\n◆キャラ2\n【名前】空使 時雨(うろつか じう)\n【年齢】27\n【性別】男性\n【職業】情報屋\n【イメージカラー】水色(目の色)\n【性格】冷静で常識的。情が深く倫理観もあるが、その上で必要とあればそれらを切り捨てられる冷酷さもある。努力家。常識の範囲内であれば祭りのように楽しいことが好き。世話焼き。\n【好きな物】ウケるもの(ツボが浅い)、カフェイン、わかりやすい利益\n【その他】\n・武闘派のような見た目だが身体が弱くほとんど戦えない。反面頭がとても良く、言葉だけで人を殺すこともできる。\n・全身が傷だらけであり、手足に欠損がある。傷付くことを恐れていない。\n・精神的に非常に強い。\n・逢嵐に対してなんだかんだ甘やかしてしまうことが多い。\n・身体が弱いため酒やタバコは苦手。\n・モチーフ▶︎時雨\n\n◆関係性\n・所謂反社会の相棒関係\n・お互いがお互いの足りないところを補い合っているような関係 互いの出来ないものを互いが出来るようなイメージ(外見だけでは性格や役割が真逆に見えるが実は、というのがこの2人のモチーフです)\n・一見陸梁逢嵐の一方的感情に見えるが、空使時雨からの感情は同等/それ以上で返している\n・お互いに本音を言い合い、唯一素を見せられる相手\n・距離感は相棒にしては近め 逢嵐からのスキンシップが多めで、時雨はあしらいつつも拒むことはない\n・仄暗い反社会の中でも笑いながら非倫理行為を行えるような二人です。\n\n◆イラストのテイスト、構図やシチュエーションなど全てお任せいたします。\n好きなように解釈していただけると幸いです！\n\n◆お手数で無ければ透過画像もいただけますと幸いです。\n\n---------------------------\n\n金額等不備などございましたら、再送ください。\n\n何卒よろしくお願いいたします。", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@asy_nm/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3293858, "client_id": 3236953, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c00ecd8e/uploads/origins/dd7b4bf3-de73-4219-890a-2eed33cef2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b8614f04bfc9f9e14186c26e14058b8", "srcset": "https://si.imgix.net/c00ecd8e/uploads/origins/dd7b4bf3-de73-4219-890a-2eed33cef2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b8614f04bfc9f9e14186c26e14058b8, https://si.imgix.net/c00ecd8e/uploads/origins/dd7b4bf3-de73-4219-890a-2eed33cef2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c95fca2e20a105522569ceca6332c34 2x, https://si.imgix.net/c00ecd8e/uploads/origins/dd7b4bf3-de73-4219-890a-2eed33cef2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c89e7ed71432bba008ee39759c114778 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c00ecd8e/uploads/origins/dd7b4bf3-de73-4219-890a-2eed33cef2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb2a2150cf7b6fc27794cccbe185fe3a", "srcset": "https://si.imgix.net/c00ecd8e/uploads/origins/dd7b4bf3-de73-4219-890a-2eed33cef2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb2a2150cf7b6fc27794cccbe185fe3a, https://si.imgix.net/c00ecd8e/uploads/origins/dd7b4bf3-de73-4219-890a-2eed33cef2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c627a2041e1ffd1ecc0550a4bebbae45 2x, https://si.imgix.net/c00ecd8e/uploads/origins/dd7b4bf3-de73-4219-890a-2eed33cef2c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1789f553f8b77c9246fdb26b38e494ff 3x"}, "body": "こんばんは。いつもお世話になっております、罪人と申します。\n\n前田塩さんのイラストの全てが本当に素敵で、雰囲気から線の描き方色デザイン全てが大好きです。\nこの度スケブを開いていらっしゃる！？ということで依頼をさせていただきました。可能でしたら、TRPGの自キャラクターを描いていただけると嬉しいです。\n\n□描いていただきたいキャラクター\nシナリオ「SEVENSTARS＆PEACE」の自キャラクターを描いていただきたいです。\n\nもし可能でしたら2人の楽しそうな雰囲気のイラスト、金額的に足りなければ片方(茶髪の男の方)でよろしくお願い致します…！！\n\n□キャラクターについて(シナリオバレ等はなし、こちらは全て公開情報となります)\n車を使って旅をしている。2人とも喫煙者であり、SEVENSTARSとPEACEを吸っている。\nキャンプカーに乗り、色んなところを愉快に走り回っている二人。🚗³₃(主に楽しそうなのは茶髪)\n\n愛車はフォルクスワーゲンのワーゲンバス(赤)\n\n\n☆テオ・ル・エトワール (HO：SEVENSTARS)\nフランスと日本のハーフ。28歳  183cm\n髪：茶髪        目の色：茶色\n\n車を運転している方。基本的にはご機嫌で子供のようにはしゃいでいる。構って貰えないと拗ねる。常に年上とは思えないような振る舞いであり、笑ったり泣いたりいじけたりする。ふとした時に影が見える。\n\n\n☆砂埜 なずな  (いさの なずな)\n日本人。21歳  178cm\n髪：白髪     肌の色：褐色     目の色：青緑\n\n白髪褐色なのに日本人。ナビゲート兼暴力担当。基本的に表情は動かず、口数も少ない。うるさすぎるテオに呆れたり、ため息をついたり、ほぼ無視したりしている。一見非常に冷たいが、実はテオにひっそりと恋をしている。\n\n□関係性\n基本的にテオ(茶髪)がなずな(白髪褐色)にニコニコ近づいてはしゃいで喋りまくり、なずなはそれを聞いているのか聞いていないのか微妙な態度で過ごしていたり呆れていたりする。テオがみていない時になずなは微笑んでいる。\n→テオがニコニコ！なずなはスン…(ﾁﾍﾞｽﾅ)\n\n「なず！ねえねえこの間俺が作った料理どうだった？！また作ろっか！？」\n「…………テオさんが焦がしまくった料理はもう結構です」\n\nという感じです。\n\n□使用用途\n個人観賞用。\n\n□イラストについて\nふたりが楽しそうにしている(主に楽しんでいるのはテオですが、なずなの方は微笑みorスン…としている)イラストを描いていただきたいです。明るいテイストのイラストであれば嬉しいです！！構図や服装は好きにアレンジしてくだされば幸いです。\n\n以上となります。\n金額やスケジュール的に難しければ、お気軽にお伝え下されば幸いです。\n重ねてになりますが、以前から前田塩さんのイラストの大ファンです。これからも創作活動を応援しております！！\n\nhttps://drive.google.com/drive/u/0/mobile/folders/1Wy3nmt2PoYJniCKJUdwgRWyiVSRaqVxX", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 547578, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Shima natsuho", "screen_name": "shima_natsu35", "avatar_url": "https://pbs.twimg.com/profile_images/1840056560867053569/fy8Lx1hG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/734937819643154434/1727538681/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 160}, {"id": 715075, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "K.", "screen_name": "K256tb", "avatar_url": "https://pbs.twimg.com/profile_images/2038836294265315328/_85wfyE-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/354923373/1738462431/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 20, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 32}, {"id": 888873, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "めんちり塩", "screen_name": "Occimentalis", "avatar_url": "https://pbs.twimg.com/profile_images/2036296446350336000/GqPKi51I.jpg", "header_url": "https://pbs.twim