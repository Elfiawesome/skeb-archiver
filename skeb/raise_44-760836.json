p&crop=top&w=200&h=200&blur=200&s=48c0782523fbb3d2482a357117750b10 2x, https://si.imgix.net/73616913/uploads/origins/adce834b-59dd-4b20-ac81-1d598f616628?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f6bad4a0ec55b94539daa5f79b919fcf 3x"}, "body": "来世さんこんにちは、かわいらしいイラストの大ファンです。\n今回は私の一時創作の男女カップルを描いていただこうと思い依頼しました。\n\n男性側\nお嬢様の執事。茶髪、襟足部分がちょっとだけ跳ねている、赤茶の優しい目、高身長、穏やかな人柄。赤茶のスーツに赤いネクタイ、赤薔薇のラペルピンをつけています。\n\n女性側\n貴族のお嬢様。銀髪ロング、青色のおっとりした瞳、華奢、ふわふわお上品な子です。頭の両側に白百合の刺繍が入った白いリボンをつけています。お洋服は白と青メインで中世のお嬢様風なものをお任せしたいと思います。\n\n来世さんの素敵な絵柄で見られるのが楽しみです。よろしくお願いします。以下、殴り書きですがイラストのURLを貼らせていただきます。\n\nhttps://x.com/8102Apple/status/1867179450317824193?t=NtSIRIKPToVEM-4ttObEMg&s=19 \n\n\nhttps://x.com/8102Apple/status/1868624403753574753?t=tgL_WPDSK3u7SDxvvV9duw&s=19", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@raise_44/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3128779, "client_id": 97931, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65111824/uploads/origins/a18df73e-bd5c-4aa2-8512-439bb2e142bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d357ef282d777701f4f0e27c8b7d4680", "srcset": "https://si.imgix.net/65111824/uploads/origins/a18df73e-bd5c-4aa2-8512-439bb2e142bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d357ef282d777701f4f0e27c8b7d4680, https://si.imgix.net/65111824/uploads/origins/a18df73e-bd5c-4aa2-8512-439bb2e142bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e28d79cb305c93bff9a19d9655715983 2x, https://si.imgix.net/65111824/uploads/origins/a18df73e-bd5c-4aa2-8512-439bb2e142bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08081655a11cd7cd95f282bc5c800b4d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.n