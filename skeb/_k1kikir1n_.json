ivate_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3722842, "client_id": 1208881, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa0b21cb/uploads/origins/a7b23a0a-3b93-4f39-9acc-c53b7d664ecf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ba4794fb0cf444930090ebfd0e6c3c5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa0b21cb/uploads/origins/a7b23a0a-3b93-4f39-9acc-c53b7d664ecf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9267edd4b0c6b2d0dfe64706c054463b", "src_set": ""}, "body": "Hello! I love your art style so much and would be thrilled if you would draw my original character for me.\n\n❓ SYCAMORE | 188CM | 38 YEARS OLD\n\nA doctor by trade, with keen intellect and a knack for medicine. He can seem silly and overly lighthearted at times, but he means well.\n\nCalm and serene. He seems to have a smile on his face at all times. He exudes a gentle aura, and though he can act childish as a joke, people typically regard him as a kind person. In truth, although he pretends to be warm-hearted without any ulterior motives, he is actually quite the apathetic person who has endured many losses of loved ones and a lot of grief in his past. He pretends to be friendly and kind because he does not think he deserves to grieve.\n\nHe is tired of this life he is living as the \"only survivor\" of the catastrophes that took his family from him, but does not think he yet deserves to die. A man with a lot of compassion and kindness who represses it all to put up a facade of kindness and warmth while keeping everyone an arm's length away.\n\nMOTIFS: Gingko leaves. Autumn days. Operating room table. Shattered glass. Scalpels.\n\n※ Please note the two (2) moles Sycamore has under both of his eyes, and the scar over his right eye. \n※ He is frequently covered in scars, bruises, and bandages, and is always wearing gloves.\n※ He wear a choker around his neck to conceal a scar that wraps around it.\n※ On his right arm is a large black ink-wash tattoo of flower petals. \n\nThe pose and composition are entirely up to you. Please feel free to turn down this request for any reason. Thank you for your consideration!\n\nhttps://imgur.com/a/Bl6M8Hn", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 10345, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "白竹/Plum", "screen_name": "marutaro02", "avatar_url": "https://pbs.twimg.com/profile_images/1598223858179313669/RLrVzpnj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2848652065/1653099805/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 1}, {"id": 1133288, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "酒梦猫", "screen_name": "maojiumeng", "avatar_url": "https://pbs.twimg.com/profile_images/1930508217635004416/dx7T56XR.png", "header_url": "https://pbs.twimg.com/profile_banners/2903124834/1715534610/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 48}, {"id": 2651788, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "仮名人", "screen_name": "XxzJi", "avatar_url": "https://pbs.twimg.com/profile_images/1428976503304331270/ZnVF0YH9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1325077916628127745/1757064365/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_a