ルダンの為なら何処までもついていく\n【補足】\nアルダンはハートオホ声喘ぎで。服装はアルダンが勝負服でサキがメイド服の着衣H。", "nc": 168, "word_count": 5399, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@uma454545taro/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 3281899, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/882a414c/uploads/origins/7b11d1c8-ba9b-4e1c-9b21-66bf6638794f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=388f2b1500983862f17bd6aca55ac503", "srcset": "https://si.imgix.net/882a414c/uploads/origins/7b11d1c8-ba9b-4e1c-9b21-66bf6638794f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=388f2b1500983862f17bd6aca55ac503, https://si.imgix.net/882a414c/uploads/origins/7b11d1c8-ba9b-4e1c-9b21-66bf6638794f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=14bde5c7bf0bf14f504e6722a2742220 2x, https://si.imgix.net/882a414c/uploads/origins/7b11d1c8-ba9b-4e1c-9b21-66bf6638794f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ed64c9e141a313052605dd35a95b56d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/882a414c/uploads/origins/7b11d1c8-ba9b-4e1c-9b21-66bf6638794f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f37be751497eec39d3d76b88ea4e4bd", "srcset": "https://si.imgix.net/882a414c/uploads/origins/7b11d1c8-ba9b-4e1c-9b21-66bf6638794f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f37be751497eec39d3d76b88ea4e4bd, https://si.imgix.net/882a414c/uploads/origins/7b11d1c8-ba9b-4e1c-9b21-66bf6638794f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c6508f9e9f605acc1f97c3268545e615 2x, https://si.imgix.net/882a414c/uploads/origins/7b11d1c8-ba9b-4e1c-9b21-66bf6638794f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop