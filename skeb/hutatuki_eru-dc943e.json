l, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b444a610/uploads/origins/f6925f43-cc75-4110-8bbc-1126152d2221?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2d94cde0fc92dcd9a020fb8cfb3b567", "srcset": "https://si.imgix.net/b444a610/uploads/origins/f6925f43-cc75-4110-8bbc-1126152d2221?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2d94cde0fc92dcd9a020fb8cfb3b567, https://si.imgix.net/b444a610/uploads/origins/f6925f43-cc75-4110-8bbc-1126152d2221?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=63194870bfdbd4380175f6612ba47519 2x, https://si.imgix.net/b444a610/uploads/origins/f6925f43-cc75-4110-8bbc-1126152d2221?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5c177c2e7bd987b1cedee25c6181419c 3x"}, "body": "初めまして。突然のリクエストすみません。\nこの度は以下のイラストをお願いできればと思い、リクエストさせていただきました。\n\n概要\n東方Projectの射命丸文・犬走椛・姫海棠はたての3人が罵詈雑言浴びせ合いながら賑やかにゲームで遊んでいる場面を横長なイラストでお願いしたいです。（可能であればセリフや文字なしで表現していただきたいです）\n\n使用用途\nPCモニターの壁紙に使わせていただけたらと考えています。\n\n以上になります。\n長くなってしまい申し訳ありません。ご検討のほどお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hutatuki_eru/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 535584, "client_id": 1179092, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a87ea1a/uploads/origins/d2e94de7-5080-45a0-8fa5-c95176cff1dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0382bb61d5065dcae8f2dba7d8a9200f", "srcset": "https://si.imgix.net/6a87ea1a/uploads/origins/d2e94de7-5080-45a0-8fa5-c95176cff1dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0382bb61d5065dcae8f2dba7d8a9200f, https://si.imgix.net/6a87ea1a/uploads/origins/d2e94de7-5080-45a0-8fa5-c95176cff1dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c691b9ed5dcbdb5c3e2cb631b6996e63 2x, https://si.imgix.net/6a87ea1a/uploads/origins/d2e94de7-5080-45a0-8fa5-c95176cff1dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b64a99ab94fb3b068c2e3c3836bdd3b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a87ea1a/uploads/origins/d2e94de7-5080-45a0-8fa5-c95176cff1dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46bcc0f49754f5487e5be8ef13fefd02", "srcset": "https://si.imgix.net/6a87ea1a/uploads/origins/d2e94de7-5080-45a0-8fa5-c95176cff1dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46bcc0f49754f5487e5be8ef13fefd02, https://si.imgix.net/6a87ea1a/uploads/origins/d2e94de7-5080-45a0-8fa5-c95176cff1dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=389e41b7d967e1dfda59ac2c813746a3 2x, https://si.imgix.net/6a87ea1a/uploads/origins/d2e94de7-5080-45a0-8fa5-c95176cff1dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8fcc5c6fa7da84c2cfca38e06ac7beab 3x"}, "body": "オフに人間の里のお祭りに遊びにきている4天狗(飯綱丸、文、はたて、椛)　のイラストをリクエストします。\n\n服装は文は書籍のルポライター衣装、飯綱丸はたて椛も目立たないよう普段とは違う衣装で来ている。3人のお忍び衣装を考えていただきたいです。\n椛は耳無しでお願いします\n\n構図は人間の里に屋台が並んでいてその真ん中を4天狗が歩いている。\n\n並びは右側がはたてと飯綱丸、左は気持ち少し後ろに椛と文がくっついて歩いている。皆正面向きの構図で\n右からはたて、飯綱丸/椛、文の順で\n\n\nはたては飯綱丸の腕を体を寄せて右腕で掴みつつ左手で指を差している。(あっち行きましょうと言っている。)　\n飯綱丸は両腕を組んで少しはたての対応に少し戸惑っている。(はたてはお祭りの場なので無礼講している)\n\n椛は大天狗の飯綱丸が居るから周りを警戒している為真剣な表情をしている。\n文は左手で椛の肩を叩いて右手にりんご飴を2つ持って1個椛に渡そうとしている。\n\n\nその他の細かい構図は双月える先生にお任せします。どうかよろしくお願いします", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hutatuki_eru/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 535584, "client_id": 506436, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.i