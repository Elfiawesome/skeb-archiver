rmat%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f414eb2469c645a4b99ea1ef4179e5b6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6094f09a/uploads/origins/f0f920cf-a4ec-47f9-9ebc-bb41aa58aef6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6744807bdb6c1a1314fee9d862eb44f7", "srcset": "https://si.imgix.net/6094f09a/uploads/origins/f0f920cf-a4ec-47f9-9ebc-bb41aa58aef6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6744807bdb6c1a1314fee9d862eb44f7, https://si.imgix.net/6094f09a/uploads/origins/f0f920cf-a4ec-47f9-9ebc-bb41aa58aef6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9d510008e7ec5af5aaac94393164f405 2x, https://si.imgix.net/6094f09a/uploads/origins/f0f920cf-a4ec-47f9-9ebc-bb41aa58aef6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e1bab53e42fb757be60593d5f553267e 3x"}, "body": "こんにちは\nウェディングイラスト(https://skeb.jp/@miuoekaki/works/2)がとても美しく惹かれまして、リクエスト失礼します！\nオリキャラの依頼になりますので、もしもNGでしたらすみません\n\n■概要\nキャラ：うちの子\n名前：細石ひわ(ヒワ=サザレ)\n参考イラスト→(https://gyazo.com/935cbd013e73164b5e6078bfd005a5c9)、(https://gyazo.com/fa4aa83b443fd026034075aad4fe76b3)\n※依頼の際の参考資料として利用する許可はいただいております\n髪：氷イメージの水色ロングヘア\n瞳：淡めの紫色\n体格：華奢だがそこそこ胸がある(目安としてサラシでギリギリ隠せるくらい)\n衣装：ウェディング(白色メイン)\n背景：お任せします(なくてもよいです)\n\n■依頼詳細\n　うちの子ひわが、肩出しウェディングドレスを着ているイラストをお願いします\n　胸元には赤い宝石のペンダントをつけてください\n　構図などはお任せしますが、全身を描いていただける場合は、ブライダルシューズが見たいので裾は長すぎないようお願いします(あるいは長い裾をたくし上げることで靴が見える形でも良いです)\n　上半身のみなどの場合は、胸元の赤い宝石のペンダントが隠れていなければなんでも大丈夫です\n　(なお、参考イラストにあります杖は描かなくて大丈夫です)\n\nご縁がありましたら嬉しいです\nよろしくお願いします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miuoekaki/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3179054, "client_id": 2585784, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dc920ad3/uploads/origins/803a1fb8-9a0f-4b90-87cf-2ed63132b258?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c06d0f91d071c43c1aeb9881c8296d59", "srcset": "https://si.imgix.net/dc920ad3/uploads/origins/803a1fb8-9a0f-4b90-87cf-2ed63132b258?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c06d0f91d071c43c1aeb9881c8296d59, https://si.imgix.net/dc920ad3/uploads/origins/803a1fb8-9a0f-4b90-87cf-2ed63132b258?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d318dd242fd3e657615f7a5d197f447c 2x, https://si.imgix.net/dc920ad3/uploads/origins/803a1fb8-9a0f-4b90-87cf-2ed63132b258?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cba56b79916e99b95007beb9b50836c8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc920ad3/uploads/origins/803a1fb8-9a0f-4b90-87cf-2ed63132b258?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=acacad894916073231148b8ab615ec1b", "srcset": "https://si.imgix.net/dc920ad3/uploads/origins/803a1fb8-9a0f-4b90-87cf-2ed63132b258?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=acacad894916073231148b8ab615ec1b, https://si.imgix.net/dc920ad3/uploads/origins/803a1fb8-9a0f-4b90-87cf-2ed63132b258?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e60ed25ee864bd827d55892e48530ce7 2x, https://si.imgix.net/dc920ad3/uploads/origins/803a1fb8-9a0f-4b90-87cf-2ed63132b258?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8f31242758d7c3706806d6b2bda79dda 3x"}, "body": "はじめまして。アピールありがとうございます！\nヒデアキちゃんとってもかわいいと言って頂けて嬉しいです！\nヒデアキちゃんの大鎌である妖刀「隆景」凄くカッコいいですよね！実はこれ、命の恩人でもある大好きな師匠の鉤爪の内1本を譲り受け作った大切なものなんです…！\nあんな大きくて重たそうな武器をブンブンと振るう姿を見ると気弱でかわいいヒデアキちゃんも立派な乙女武将なんだなぁ、としみじみとしちゃいます。でもやっぱり重たくて尻もちとかついちゃうのかわいいんです〜！！(すみません)\nアイコンの娘や、つきよのさん??というヴイチューバーの方、リ・ゼロの双子メイドさんのイラスト等、なかなか可愛らしかったのでご依頼させていただきました！\n\n「戦国乙女シリーズ」より、\n妖刀・隆景を構える「小早川ヒデアキちゃん」をお願いします！\n\n・「私だって…戦えます！助けてくれた皆さんに、恩返しがしたいんです!!」泣き虫ヒデアキちゃんが、皆の力になりたいと奮い立ち、大鎌を構え「隆景解放」─！\nいつもよりちょっぴりかっこいい覚醒?!ヒデアキちゃん、その小さな勇気に呼応し力を貸してくれる隆景、とか見てみたいな〜という妄想です！\n放て、「黒葬の滅多斬」！！\n\n・構図　ヒデアキちゃんが隆景を構えている感じですが、細かな構図はお任せしたいと思います。\n隆景も大事ですが、個人的にはヒデアキちゃんが主役になってほしいので、ヒデアキちゃんが小さくなり過ぎ無いように描写していただけると嬉しいです。本編では両手で持っていますが、火事場の馬鹿力という事で片手でも大丈夫です。\n\n・服装　いつものピンク花柄の着物が好みです。ですが花柄が大変複雑なので描きやすいように簡略化、省略してくださっても構いません。他の着せたい衣装があればそちらでも大丈夫です。\n\n・表情　かわいいけれど覚悟を決めているような、少しキリッとした表情だと嬉しいです。また、目にほんの少しだけ涙を浮かべている(涙を振り切った後)のもヒデアキちゃんらしさがあって良いかもしれません。\n\n・隆景の刀身はピンク色のオーラ(炎)を纏っている感じだと嬉しいです。\n\n・その他、細かな描写はお任せしたいと思います。\n\nヒデアキちゃんと隆景を描かせて頂きたいとアピールを頂けたので、隆景にフォーカスしイメージさせていただきました！楽しんで描いていただければ幸いです！\n御縁がございましたら、その際はよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1FWIKZ6Oh7PWp7AOtULrUiKqftuPMhVlo/view?usp=drivesdk", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miuoekaki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3179054, "client_id": 2983028, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0ee0f69b/uploads/origins/820e2489-9031-4322-acb6-4450012f8320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35fb78d3e921fa13f50414a7021a5aa2", "srcset": "https://si.imgix.net/0ee0f69b/uploads/origins/820e2489-9031-4322-acb6-4450012f8320?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35fb78d3e921fa13f50414a7021a5aa2, https://si.imgix.net/0ee0f69b/uploads/origins/820e2489-9031-4322-acb6-4450012f8320?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=40d89f17634e63f2e24b3ce4ea2d94f0 2x, https://si.imgix.net/0ee0f69b/uploads/origins/820e2489-9031-4322-acb6-4450012f8320?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f5e7075c213a688bf06cd1726324d05 3x"}, "duration": null, "nsfw": false, "hardco