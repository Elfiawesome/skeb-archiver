ail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1953031, "client_id": 3411812, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6736c1cd/uploads/origins/8b5e0b2b-0b6e-4ca5-b49d-cbfdd6a8d8e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba4b8b20134c644ab823d0e3afca555f", "srcset": "https://si.imgix.net/6736c1cd/uploads/origins/8b5e0b2b-0b6e-4ca5-b49d-cbfdd6a8d8e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba4b8b20134c644ab823d0e3afca555f, https://si.imgix.net/6736c1cd/uploads/origins/8b5e0b2b-0b6e-4ca5-b49d-cbfdd6a8d8e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=879e68b8c15033c0acb654b6260b7383 2x, https://si.imgix.net/6736c1cd/uploads/origins/8b5e0b2b-0b6e-4ca5-b49d-cbfdd6a8d8e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43f70d61a618b62389a833103541a7df 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6736c1cd/uploads/origins/8b5e0b2b-0b6e-4ca5-b49d-cbfdd6a8d8e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=538d63aa95cf7eca707c97270f405959", "srcset": "https://si.imgix.net/6736c1cd/uploads/origins/8b5e0b2b-0b6e-4ca5-b49d-cbfdd6a8d8e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=538d63aa95cf7eca707c97270f405959, https://si.imgix.net/6736c1cd/uploads/origins/8b5e0b2b-0b6e-4ca5-b49d-cbfdd6a8d8e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6eb43904c374cebe137c74e67da58038 2x, https://si.imgix.net/6736c1cd/uploads/origins/8b5e0b2b-0b6e-4ca5-b49d-cbfdd6a8d8e8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2a04e0c9cf96ef92ed72b9604479b87c 3x"}, "body": "はじめまして！\nXで素敵なトワ様のメイドイラストが目に留まり、ぜひ私のオリジナルキャラクターを描いていただきたいと思い依頼いたしました！\n\n\n⚫︎依頼内容\nメイド衣装イラスト(メイド喫茶のイメージ)\n\n⚫︎イラスト詳細\nメイド服の種類やポーズ、構図など基本的には全てお任せしたいと思っています。\n\n立ち絵の衣装の通り、シカ🦌をモチーフにしておりますのでフードについているようなシカ耳と角のカチューシャを付けていただきたいです！\n\nまた少し恥ずかしそうにしているような表情差分があると嬉しいです！\nその他、描写範囲や背景などもお任せいたします！\n\n⚫︎参考資料\n立ち絵等は参考URLに入っております。\n胸は控えめ(Bくらい)で描いていただけると嬉しいです。\n\n⚫︎使用用途\nXやInstagramでの投稿、アイコン、壁紙など\nまた限定的な公開範囲でのネップリ配布など\n活動者ではありませんので配信等での使用はありません。\n\n⚫︎納品について\n背景がある場合は、背景ありと背景なし(背景透過)を分けてPNGで納品していただけると嬉しいです。\n\n以上となります。よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1kQZQ7-DRcAkz2Sa8BYLb07IWncFz3t4l", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aonomumei/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1953031, "client_id": 3142613, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc95b051/uploads/origins/83b19bca-ab2a-4af8-afea-0e3031519392?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab0d75ce86229c085f8dcbaffb4b8d58", "srcset": "https://si.imgix.net/cc95b051/uploads/origins/83b19bca-ab2a-4af8-afea-0e3031519392?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab0d75ce86229c085f8dcbaffb4b8d58, https://si.imgix.net/cc95b051/uploads/origins/83b19bca-ab2a-4af8-afea-0e3031519392?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=915076e36c202b4bd229d351db8413a6 2x, https://si.imgix.net/cc95b051/uploads/origins/83b19bca-ab2a-4af8-afea-0e3031519392?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0903079004ea3daf8bec38a7ae23077 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc95b051/uploads/origins/83b19bca-ab2a-4af8-afea-0e3031519392?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f78b08aa72396b26ea1817cc632918cb", "srcset": "https://si.imgix.net/cc95b051/uploads/origins/83b19bca-ab2a-4af8-afea-0e3031519392?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f78b08aa72396b26ea1817cc632918cb, https://si.imgix.net/cc95b051/uploads/origins/83b19bca-ab2a-4af8-afea-0e3031519392?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e27ea71598afa17e47eda6a263b3258e 2x, https://si.imgix.net/cc95b051/uploads/origins/83b19bca-ab2a-4af8-afea-0e3031519392?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ecbe862ac4353f2ae30c7862fbb39c59 3x"}, "body": "はじめまして。タカと申します。\n青乃むめい先生の可愛いイラストをいつも拝見させていただいております。\n青乃むめい先生が描いた常闇トワさんのメイド服イラストとても可愛くて素敵でした。\nこの度は青乃むめい先生に個人Vtuberの「猫山みあ」さんを描いていただきたいと思いリクエストのご連絡をさせていただきました。\n\n依頼内容は下記の通りとなります。\n■依頼内容\n個人Vtuberの「猫山みあ」さんのファンアート。\n\n◼️猫山みあさんの特徴\n・銀髪ツインテール、ピンクメッシュ\n・歌うことが大好きな元気一杯の猫耳の女の子\n・八重歯とアホ毛がチャームポイント(八重歯は正面から見て右側)\n\n◼️キービジュアル、三面図(資料URLに同じ内容を記載しております)\n\nhttps://x.com/nekoyama_miaaa/status/1583022651102334976?s=46\n\n構図、ポーズはお任せでお願いします。\n服装はメイド服で髪型はツインテールでお願いします。\n\n■使用用途\nYoutube(収益化済）サムネやTwitter、FANBOXでの壁紙配布としてなど\n猫山みあさんの配信活動での使用を許可していただけると幸いです。\n\n■サイズ\nおまかせ\nサムネイル等に使用するため、髪の毛の先や耳、指の先等が切れていない構図ですと幸いです。\n\n■その他\n人物のみの背景透過もお願いいたします。\nファイル形式は、キャラクターと背景を分けたPSDファイルでいただけると幸いです。\n参考資料三面図：https://x.com/nekoyama_miaaa/status/1583022651102334976?s=46\n青乃むめい先生の描いたこの様な元気で明るい感じでお願いしたいです。\nメイド服イラスト参考資料\n\nhttps://x.com/aonomumei/status/1839945111645651299?s=46\n\nご検討のほどよろしくお願いいたします。\n\nhttps://x.com/nekoyama_miaaa/status/1583022651102334976?s=46\n\nhttps://x.com/nekoyama_miaaa/status/1583022651102334976?s=46", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aonomumei/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1953031, "client_id": 3294127, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a6ce810/uploads/origins/14d932d4-7394-4293-abd7-7d0cd71fe9ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a432ce7191eea86dc8916