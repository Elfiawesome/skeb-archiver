す\nポーズに関しては青い私の方は足組でお願いします\n\n\nイメージしやすい参考設定としましては私が\n\nお姉さんの魅力に恵まれた女の子\n1000年以上の時を生きた「真祖系吸血鬼」だが\n血は吸うのも、見るのも嫌らしい\n一方で日光に関しては克服しており\n日光を浴びでもダルくなる程度で済むらしい\n自堕落な所があり、ゲームが大好き\n銀色の長髪は青紫の光を伴って美しく輝き\n金色の瞳は、満月の光のような美しさを持つ\n漆黒のドレスは、彼女に「吸血鬼のお嬢様」のような\n魅力をもたらしているかのよう\n\n\nそして赤い方の和歌音　小春ちゃんが\n\nアイドル好きでアイドルになりたい女の子。双子の妹はたち。甘えん坊でポンしがち。\nゲームは勉強中だけど上手になるため、努力は止まない。\n赤と桜が好きで、小春のイメージになっている\n\n\nあとXで＃おはようVtuber等のVtuber素材で使用できるように背景透過のキャラクターのみのpsdや画面外で切れてしまった髪や体の可能な範囲の描画をお願いしたいです。\n\nご検討いただけましたら幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/11gBeoZWBbqQK4Ln9V0pXOu1_r0rcz_i6?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aonomumei/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1953031, "client_id": 125278, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1305db1e/uploads/origins/e009e783-2eb6-4b71-aa8e-939885298a05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb1959d61c5ddfebdcbad63ebfa40f77", "srcset": "https://si.imgix.net/1305db1e/uploads/origins/e009e783-2eb6-4b71-aa8e-939885298a05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb1959d61c5ddfebdcbad63ebfa40f77, https://si.imgix.net/1305db1e/uploads/origins/e009e783-2eb6-4b71-aa8e-939885298a05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=210279073d1c86c4befa2d599d9063d6 2x, https://si.imgix.net/1305db1e/uploads/origins/e009e783-2eb6-4b71-aa8e-939885298a05?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=705a4cd3172318c490ab08934d0dfc87 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1305db1e/uploads/origins/e009e783-2eb6-4b71-aa8e-939885298a05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=138212ada612d1bb1ed324bfdd206803", "srcset": "https://