作等に関するガイドラインです。\nhttps://specialite.games/guideline/\n\n\n以上となります。\nご縁がありましたら幸いです。\nご検討の程、何卒よろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@momochi_RINGO/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3693422, "client_id": 3614752, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b64a25d8/uploads/origins/e6cd7387-440a-456b-b66c-d8fe96a09800?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11b24498771b06de8fd259609d437567", "srcset": "https://si.imgix.net/b64a25d8/uploads/origins/e6cd7387-440a-456b-b66c-d8fe96a09800?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11b24498771b06de8fd259609d437567, https://si.imgix.net/b64a25d8/uploads/origins/e6cd7387-440a-456b-b66c-d8fe96a09800?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ebca49bb3b3b8a09a9e518ee946ee7b5 2x, https://si.imgix.net/b64a25d8/uploads/origins/e6cd7387-440a-456b-b66c-d8fe96a09800?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=669c2ca8731b8e4aac75b35d9575209f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b64a25d8/uploads/origins/e6cd7387-440a-456b-b66c-d8fe96a09800?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ae40967f554d0641025b20614355d84", "srcset": "https://si.imgix.net/b64a25d8/uploads/origins/e6cd7387-440a-456b-b66c-d8fe96a09800?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ae40967f554d0641025b20614355d84, https://si.imgix.net/b64a25d8/uploads/origins/e6cd7387-440a-456b-b66c-d8fe96a09800?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=72d4521757d06b03f8d43d329d3dca84 2x, https://si.imgix.net/b64a25d8/uploads/origins/e6cd7387-440a-456b-b66c-d8fe96a09800?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c5897983db04d91112ad198d2b8cdc59 3x"}, "body": "もち林檎様。、コミケでお疲れの中、失礼いたします。\n以前から先生のことを存じ上げており、最初のskebはVariumとも縁深い先生にと考え依頼させていただきました。\n依頼内容を以下にまとめさせていただきます。\n\n【描いていただきたい方】\nVarium所属　\"綿宮あひる\"様(@Watamiya_Ahiru)のイラスト\n\n【目的】\n綿宮あひる様のサムネやXなどでの使用、VTuber活動に使えるようにご許可いただけると幸いです。\nX投稿時に先生のXのIDおよびAI禁止の文言付きでポストさせていただきたいです。もしくは、個人での鑑賞用です。\n\n【リクエスト内容】\n・初期衣装の\"綿宮あひる\"様\n・ひまわりの花束(ブーケ)を抱えている(または持っている)姿\n→1.ひまわりの本数は9本\n　2.花束はあひるさんが受け取った想定です\n・表情は満面の笑みを浮かべつつも目尻に涙を溜めている様子\n・その他、細かい部分はお任せ致します\n・背景なしや文字なしで差分のレイヤーを分けたPSDファイルでも納品いただけると幸いです。\n\n【参考資料】\n・Xの三面図\nhttps://x.com/i/status/1673995669454086145\n\n・事務所の公式HP（タレントページ）\nhttps://varium.jp/talent/ahiru/\n\n・二次創作ガイドライン\nhttps://varium.jp/guide_line/\n\n不要かとは思いますが、参考資料も記載させていただきました。\n冒頭でも触れた通り、今回がskebでの初の依頼となりますので至らぬ点もあるかと思いますが、ご検討いただけますと幸いです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@momochi_RINGO/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3693422, "client_id": 999841, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1bdc1a40/uploads/origins/27d07729-0bde-466d-b37c-20708e103751?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b59560c63c17cd50afde139320f13c7c", "srcset": "https://si.imgix.net/1bdc1a40/uploads/origins/27d07729-0bde-466d-b37c-20708e103751?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b59560c63c17cd50afde139320f13c7c, https://si.imgix.net/1bdc1a40/uploads/origins/27d07729-0bde-466d-b37c-20708e103751?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=298189a4a19073ea973dcb680224f10b 2x, https://si.imgix.net/1bdc1a40/uploads/origins/27d07729-0bde-466d-b37c-20708e103751?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12c282b51db241065343312a3d89cd20 3x"}, "duration": null, "nsfw