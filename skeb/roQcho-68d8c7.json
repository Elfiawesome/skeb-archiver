利用させて頂きたく思います。\n\nご検討の程、よろしくお願い致します。\n\nhttps://twitter.com/i/events/1454430943658209282?s=20", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 16994, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "タツナ@skeb募集中", "screen_name": "tatsunami1379", "avatar_url": "https://pbs.twimg.com/profile_images/2066155526929686528/vq6OVskD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4830676878/1778060322/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 313409, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ねこだーそん", "screen_name": "nekodason", "avatar_url": "https://pbs.twimg.com/profile_images/2064175257792176128/GAkf162U.jpg", "header_url": "https://pbs.twimg.com/profile_banners/325381808/1731009656/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 176}, {"id": 1196555, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "28", "screen_name": "x_28mm", "avatar_url": "https://pbs.twimg.com/profile_images/1675622395221270528/s9TOo05Q.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1384531904444043270/1618961426/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "video"}, 