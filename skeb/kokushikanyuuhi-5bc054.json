": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1640875151519780864%2FnqypB52j.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99e712614d24c8e8d04bd2dc54b49e42", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1640875151519780864%2FnqypB52j.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=99e712614d24c8e8d04bd2dc54b49e42, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1640875151519780864%2FnqypB52j.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ead36df7549bc6c16c17dcfe8a147b67 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1640875151519780864%2FnqypB52j.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ffaba4dc2bf600f5288501bc03a4cdc8 3x"}, "body": "二度目のリクエストは物凄く個人的な内容ですが、お許しください…！ 前回の女幹部vsヒーローの設定を引き継ぎ、今度は私の名前を当てはめて「幽火様vsギギア」として、負けた私を「催眠」にかけ、「洗脳」して眷属にしていただきたいのです…！お好きなタイミングで構わないのですが、呼び捨てにしていただけると尚嬉しいです…。 甘くSっ気のある低音囁きで、耳を塞いで脳を舐めたり、耳の中に舌をねじ込んだりしながら、幽火様のこと以外考えられなくなる「本気の」洗脳をかけて欲しいです……！ 舌と唇で脳を真っ白に洗い流された後、幽火様の唾液と言葉を注入されて真っ赤に真っ黒に塗り潰されたいです……。  それと、私の本名も明かしますので使っていただきたいです…。宛名のところに書きますが「ぎんぺい」と読みます。ヒーローの正体バレのような展開で呼んでいただけますと嬉しいです…！  トドメの刺し方は幽火様にお任せいたしますので、何卒よろしくお願いいたします！", "nc": 59, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@kokushikanyuuhi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": true, "creator_id": 2298883, "client_id": 295265, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/a53ef972-c6de-44b4-bbe6-c831f358516c?response-content-disposition=inline&Expires=1783066316&Signature=UFCodm4shHz~KqERQ43~iRJbG8mkuhQ5FGRTqZi9rrpA42dUO2JURTzmuLctq3jR-apQjOBpeFPS0F8dOGkHkBcj1Hw5Q7kWUYo8LaiC2ghc8AlXSSACiunBF6WTpl62b6abaNsFmiiwZHgte