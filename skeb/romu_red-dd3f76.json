23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74f9989abee60273f3df40ab42f3e494 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bade90c9/uploads/origins/e2f863f5-8795-4b1b-89eb-912f9b08df44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29cd951c87beee34aaf1a5f66be6ae34", "srcset": "https://si.imgix.net/bade90c9/uploads/origins/e2f863f5-8795-4b1b-89eb-912f9b08df44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29cd951c87beee34aaf1a5f66be6ae34, https://si.imgix.net/bade90c9/uploads/origins/e2f863f5-8795-4b1b-89eb-912f9b08df44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d61e85bd30b59f256172377144aea774 2x, https://si.imgix.net/bade90c9/uploads/origins/e2f863f5-8795-4b1b-89eb-912f9b08df44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a1a988efb373cba464bcdfbf6ee6d934 3x"}, "body": "こんにちは！もしよろしければ、リクエストさせてください。\n\nデュラハンです。彼女はリボンで頭を固定しています。血はNGです。髪をよく染めるので、似合う色（何色でもOK）を自由に選んでください。髪の色は自然な黒で、根元を入れたり、少し伸ばしたりしてもいい。\n\n仕事中は上品な服装が多いが、オフの時はカジュアルな服装も厭わない。彼女の服装の例は「服装」にある。\n\n彼女は深い心配りをする人だが、わがままなところもある。よくデートをするが、長続きはしない。本当は愛されたいと思っているが、恐れている。人といても孤独を感じるタイプ。それでもよく笑い、人と一緒にいるのが好き。気さくで思いやりがある。\n\n趣味はお化粧、ゲーム、バー通い。\n\nあなたが彼女に一番似合うと思うものを自由に描いてください。\n\nhttps://drive.google.com/drive/folders/1xcDA7818kEDbil5KyeU3M3eVlIdsLuew", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@namegata_1701/works/31", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2795094, "client_id": 2147660, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/33f33eca/uploads/origins/c4daed2b-535c-4d3b-b986-93a59dd42614?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1b0653b8c2b7f6d1c2e14b65c69b768", "src