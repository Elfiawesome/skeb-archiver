ve/folders/1-4gErFwmoJbozhyOwILmzpPotnjy0j_P\n\n絵によってデザインが違う部分は00を優先、その他不明な部分はそちらの解釈で描いてもらって構いません。\n\n【依頼内容】\n・キャラクター二人のイラスト\n・ツバキは笑ったような表情、ラピスは嫌がっていれば何でも可(怯えでも嫌悪でも怒りでも)\n※ツバキの目にハイライトは入れないでください。\n・杖は有っても無くてもOK\n\nその他、シチュエーションや構図等はそちらにお任せします。\n\n【使用用途】\n個人鑑賞用。\n個人での印刷の他、印刷所を利用してのグッズ制作もするかもしれません(配布や販売は無し、全て個人用)。\n\n難しそうであれば再送要請やキャンセルしていただいて構いません。\n以上、ご検討よろしくお願い致します…！\n\nhttps://drive.google.com/drive/folders/1-4gErFwmoJbozhyOwILmzpPotnjy0j_P", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aochobire/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1662522, "client_id": 1309510, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3c73f896/uploads/origins/a9f1337e-1262-439c-94f1-baa6b2d60423?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10291fc690736c2967c993c9e84217ba", "srcset": "https://si.imgix.net/3c73f896/uploads/origins/a9f1337e-1262-439c-94f1-baa6b2d60423?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10291fc690736c2967c993c9e84217ba, https://si.imgix.net/3c73f896/uploads/origins/a9f1337e-1262-439c-94f1-baa6b2d60423?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=294756679f659e023014a918727888a7 2x, https://si.imgix.net/3c73f896/uploads/origins/a9f1337e-1262-439c-94f1-baa6b2d60423?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1180986051ddef88f82b0608edc9e0e9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c73f896/uploads/origins/a9f1337e-1262-439c-94f1-baa6b2d60423?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47413c12925668cdb8f03e76291c1ef4", "srcset": "https://si.imgix.net/3c73f896/uploads/origins/a9f1337e-1262-439c-94f1-baa6b2d60423?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h