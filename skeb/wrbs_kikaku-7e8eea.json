気で子供っぽい性格の女の子です。趣味でオルゴールをよく作ります。氷、雪がモチーフです。\nBのキャラクターから貰った造花の白いガーベラを大切にしています。\n※髪型が複雑なので何となくで大丈夫です\n\n＜B＞\n性別：男\n年齢：17歳\n身長：176cm\n穏やかでおおらかな気質の少年です。基本的に大人びていますが、無知故に無邪気にはしゃぐ事もあります。趣味は手品です。\n┈┈┈┈┈┈┈┈┈┈\n\n構図や情景などお好きに描いて頂けると幸いです。\nご縁があればよろしくお願いいたします…！\n\nhttps://drive.google.com/drive/folders/13TPt8HAtlQ7Jj0tfXzAexLPfJUdmcjUW", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wrbs_kikaku/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1338820, "client_id": 476330, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dc310880/uploads/origins/e36255a1-57b0-41c6-ad5b-68737333a8cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d978dabd545fba1c54ba3a8c5601b54", "srcset": "https://si.imgix.net/dc310880/uploads/origins/e36255a1-57b0-41c6-ad5b-68737333a8cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d978dabd545fba1c54ba3a8c5601b54, https://si.imgix.net/dc310880/uploads/origins/e36255a1-57b0-41c6-ad5b-68737333a8cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=480d0b422d2106f92dba1314f7e80fa3 2x, https://si.imgix.net/dc310880/uploads/origins/e36255a1-57b0-41c6-ad5b-68737333a8cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2fa6a6a8ac7e917f646928bb193ffee 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dc310880/uploads/origins/e36255a1-57b0-41c6-ad5b-68737333a8cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12499bd0e4e009190d16afb4f4f1dc2d", "srcset": "https://si.imgix.net/dc310880/uploads/origins/e36255a1-57b0-41c6-ad5b-68737333a8cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12499bd0e4e009190d16afb4f4f1dc2d, https://si.imgix.net/dc310880/uploads/origins/e36255a1-57b0-41c6-ad