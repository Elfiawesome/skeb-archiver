リアスであろうとするが、癇癪持ちで尊大なため、それを維持できない。からかいやすい！尊敬されることを切望しているが、身長が低い（140cm）のが難点。見た目よりずっと年上だ。ラムはただ、自分がまじめな魔法使いであることを証明し、誰よりも威張りたいだけなのだ！\n\nhttps://drive.google.com/drive/folders/1-RFhWtuHOZWzbtqlu3Bve8uZVKDxKZXm\n\nこのOCの説明が参考になれば幸いです！あとはあなたにお任せします。ありがとうございました！(๑ᴖ◡ᴖ๑)(๑ᴖ◡ᴖ๑)", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gv_vn8/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1112842, "client_id": 3278613, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/021e732e/uploads/origins/8439dc98-81df-438f-9190-46320825b300?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=778a1dea69c42a1301df1069841858b3", "srcset": "https://si.imgix.net/021e732e/uploads/origins/8439dc98-81df-438f-9190-46320825b300?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=778a1dea69c42a1301df1069841858b3, https://si.imgix.net/021e732e/uploads/origins/8439dc98-81df-438f-9190-46320825b300?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=869200c7893df4903bdeb09064a54d9e 2x, https://si.imgix.net/021e732e/uploads/origins/8439dc98-81df-438f-9190-46320825b300?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2fd6addc935024c45c37e9d75ded8b62 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/021e732e/uploads/origins/8439dc98-81df-438f-9190-46320825b300?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96cb577f235257531dcf1041b918f78e", "srcset": "https://si.imgix.net/021e732e/uploads/origins/8439dc98-81df-438f-9190-46320825b300?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96cb577f235257531dcf1041b918f78e, https://si.imgix.net/021e732e/uploads/origins/8439dc98-81df-438f-9190-46320825b300?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit