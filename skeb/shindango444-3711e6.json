.net/68e7c159/uploads/origins/28803ee2-2138-4ec6-b2c5-5f21678f5d76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cdb95dfdad8d2b2dd04b33cb8f705a67, https://si.imgix.net/68e7c159/uploads/origins/28803ee2-2138-4ec6-b2c5-5f21678f5d76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=81005e911013bdbd9cb1fc6fd866bd2f 2x, https://si.imgix.net/68e7c159/uploads/origins/28803ee2-2138-4ec6-b2c5-5f21678f5d76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ec01082df9bec28c08199ea01810dcba 3x"}, "body": "フェイズコネクトのVTuber伊佐美えいみさんのOL姿で、シャツを開いて胸を露わにしているイラストが欲しい。映美は胸の谷間をたくさん露出しているはずだ。表情は赤らんでいて、恥ずかしそうで、ちょっとツンデレな感じ。\n\n胸が丸出しで、胸に「heratic 💗」と書いてあるバージョンもお願いします。ありがとうございました！\n\n伊佐美映美参考シート：https://imgur.com/K7oZCE7\n\n伊佐美映美のOL姿：https://imgur.com/LKerUqg\n\nポーズとパース：https://imgur.com/ovL4i2Q\n\nhttps://imgur.com/a/VqpvHsE", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shindango444/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 732203, "client_id": 274695, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4ff5130/uploads/origins/3dc6dd8e-e4f7-4f37-b5a3-408465f71550?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ab074e13bdfc12ef23d6402aa64994f", "srcset": "https://si.imgix.net/f4ff5130/uploads/origins/3dc6dd8e-e4f7-4f37-b5a3-408465f71550?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ab074e13bdfc12ef23d6402aa64994f, https://si.imgix.net/f4ff5130/uploads/origins/3dc6dd8e-e4f7-4f37-b5a3-408465f71550?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76e036f7e09331a48f905c4fb2bd2077 2x, https://si.imgix.net/f4ff5130/uploads/origins/3dc6dd8e-e4f7-4f37-b5a3-408465f71550?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88aa8ace0e6659ceb94c792cb5451be1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4ff5130/uploads/origins/3dc6dd8e-e4f7-4f37-b5a3-408465f71550?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2803bcb1429f6a8277c43af3acef9455", "srcset": "https://si.imgix.net/f4ff5130/uploads/origins/3dc6dd8e-e4f7-4f37-b5a3-408465f71550?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2803bcb1429f6a8277c43af3acef9455, https://si.imgix.net/f4ff5130/uploads/origins/3dc6dd8e-e4f7-4f37-b5a3-408465f71550?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a21031b929210c77d264c4e499623fba 2x, https://si.imgix.net/f4ff5130/uploads/origins/3dc6dd8e-e4f7-4f37-b5a3-408465f71550?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1a0fc0496b38e00b52fa60a67efa21b6 3x"}, "body": "先生のイラストのしっとり感が好きでリクエストさせていただきました。\n\n触手は描かれますでしょうか？\nPSO2NGSというゲームのうちの子をキャラクターよりも巨大なタコの触手でがっちり拘束してほしいです。\n\nうちの子の資料です↓\nhttps://drive.google.com/drive/folders/1hOADCutifUM99xAzljHI4Q62gAYrWvd0?usp=sharing\n\nうちの子を声が出せないように口に触手が巻き付き、太い触手でお腹と腕を巻き込むようにギュって感じで拘束してほしいです。\n腕と口の触手は下二つのイラストのようにお願いします。\nhttps://drive.google.com/file/d/1Dw27KV1jf02OKgNXPcVHg2UT0uPp51Ep/view?usp=sharing\nhttps://drive.google.com/file/d/10aDBmTu_08U4giST6vhW2KwLtJUqlSyt/view?usp=sharing\n\nタコはキャラクターの後ろからキャラクターにググっと密着して抱き着くように、巨大触手を巻き付けている。触手で太ももや胸を舐めるように撫でまわされる、巻き付く。\n手足を動かせないように、身動きが取れないように密着して触手で拘束。\n\n口に触手を巻き付けるかほっぺを触手でなでるか迷っていますが、先生にお任せしたいと思います。\n服は乳首が見えない範囲で、肩と胸が見えるように脱がしてください。\n衣装が複雑で、情報が足りなかったりはっきりしなかったりすみません。\nよろしくお願いいたします。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shindango444/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 732203, "client_id": 2584500, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1cb