。\nソーシャルメディアでの宣伝に使用します。\n\n✔️ その他\n背景が透明または分離されたPSDファイルを希望します。\n\n✔️ キャラクターの設計：\n風鈴芽依は金色の風鈴木の花妖精で、服装は自由に組み合わせられます。\n髪の毛は金色で、髪先に白い染めが入っています。\n\n先生が絵を楽しんで描いてくれると嬉しいです。もし都合が悪い場合は、遠慮なくキャンセルしてください。どんなことがあってもお疲れ様です！\n\nhttps://drive.google.com/drive/folders/17VUetubK4RtT0c_U21SZzbU_ZpyyckpP?usp=sharing\n\nhttps://drive.google.com/drive/folders/17VUetubK4RtT0c_U21SZzbU_ZpyyckpP?usp=sharing\n\nhttps://drive.google.com/drive/folders/17VUetubK4RtT0c_U21SZzbU_ZpyyckpP?usp=sharing\n\nhttps://drive.google.com/drive/folders/17VUetubK4RtT0c_U21SZzbU_ZpyyckpP?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@17_1777/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1316882, "client_id": 489492, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d2d5acbd/uploads/origins/1304c4e8-3e1b-4f32-a5bc-839b4cb2d0da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=793551b290eedb5935f22b549ff5979b", "srcset": "https://si.imgix.net/d2d5acbd/uploads/origins/1304c4e8-3e1b-4f32-a5bc-839b4cb2d0da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=793551b290eedb5935f22b549ff5979b, https://si.imgix.net/d2d5acbd/uploads/origins/1304c4e8-3e1b-4f32-a5bc-839b4cb2d0da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5b56736cdb9d8bec6baab3ec8786c9f 2x, https://si.imgix.net/d2d5acbd/uploads/origins/1304c4e8-3e1b-4f32-a5bc-839b4cb2d0da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=232917daaa3febb250ef105aa5212159 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d2d5acbd/uploads/origins/1304c4e8-3e1b-4f32-a5bc-839b4cb2d0da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f94f0f0e88b55021c6e45fb7a30c4e6", "srcset": "https://si.imgix.net/d2d5acbd/upload