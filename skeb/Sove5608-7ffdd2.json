/status/1840650260240318549/photo/1", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sove5608/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2629499, "client_id": 3226368, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51b5df85/uploads/origins/9c67cc73-9a26-4f69-87d3-ad4245dff4de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=358700e4cf86fb8a83caa802e848baf1", "srcset": "https://si.imgix.net/51b5df85/uploads/origins/9c67cc73-9a26-4f69-87d3-ad4245dff4de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=358700e4cf86fb8a83caa802e848baf1, https://si.imgix.net/51b5df85/uploads/origins/9c67cc73-9a26-4f69-87d3-ad4245dff4de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b29aad4f505efe3372731cf315bdd70 2x, https://si.imgix.net/51b5df85/uploads/origins/9c67cc73-9a26-4f69-87d3-ad4245dff4de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2671b8a041d73258bfc9889ec18746e7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51b5df85/uploads/origins/9c67cc73-9a26-4f69-87d3-ad4245dff4de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aebcfce9135d19ff3f91ad83f5383d3c", "srcset": "https://si.imgix.net/51b5df85/uploads/origins/9c67cc73-9a26-4f69-87d3-ad4245dff4de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aebcfce9135d19ff3f91ad83f5383d3c, https://si.imgix.net/51b5df85/uploads/origins/9c67cc73-9a26-4f69-87d3-ad4245dff4de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e8f88bb9029e7d3994446dc307c732ad 2x, https://si.imgix.net/51b5df85/uploads/origins/9c67cc73-9a26-4f69-87d3-ad4245dff4de?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=626383d5ded132198d6e5c949ecf779f 3x"}, "body": "Hello, thank you for your appeal.\nI would like you to draw my creative character.\n\nPlease draw it as you like, pose and all.\nThe purpose is for personal viewing only.\n\nMy character is innocent, curious and mischievous.\nMotifs: nightmares, clowns, mannequins\nGender: asexual\nShe is an unethical outsider who loves humans and moves back and forth between the dream world and the real world as she pleases.\nPlease feel free to arrange them in any way you like.\n\nThank you very much for your consideration!\n\nhttps://drive.google.com/file/d/1SAGgShQT3MCAyrPMHqy-A1aNyM3zfAh4/view?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sove5608/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2629499, "client_id": 2734134, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b4fb1b26/uploads/origins/5a693bfb-8b8f-47b2-aab3-17c18c7bf5c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2153fff0e203a34479f4be987133c38", "srcset": "https://si.imgix.net/b4fb1b26/uploads/origins/5a693bfb-8b8f-47b2-aab3-17c18c7bf5c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2153fff0e203a34479f4be987133c38, https://si.imgix.net/b4fb1b26/uploads/origins/5a693bfb-8b8f-47b2-aab3-17c18c7bf5c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d530a056cafcfb08c8f432566924fb5b 2x, https://si.imgix.net/b4fb1b26/uploads/origins/5a693bfb-8b8f-47b2-aab3-17c18c7bf5c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ed4371a3d5606c88047db9f9ad08456 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b4fb1b26/uploads/origins/5a693bfb-8b8f-47b2-aab3-17c18c7bf5c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63901a83fc40e6ac0405ed42a2cd3382", "srcset": "https://si.imgix.net/b4fb1b26/uploads/origins/5a693bfb-8b8f-47b2-aab3-17c18c7bf5c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63901a83fc40e6ac0405ed42a2cd3382, https://si.imgix.net/b4fb1b26/uploads/origins/5a693bfb-8b8f-47b2-aab3-17c18c7bf5c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b162f3010bca9935ee7260be1b69c373 2x, https://si.imgix.net/b4fb1b26/uploads/origins/5a693bfb-8b8f-47b2-aab3-17c18c7bf5c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8a165c35612613e6308fb1820284595b 3x"}, "body": "Hello! Your art style is really unique and I noticed that you're comfortable doing Pokemon crossover art (I know due to licensing issues some artists won't do it). \n\nThere's a V-Tuber I enjoy named Menace Mamaki that is a clumsy maid. I've always felt like she somewhat resembles Hex / Occult Maniac and that's why I'm writing: I'd love to see a picture where Menace is dressed in Hex Maniac's traditional dress and is accompanied by the Pokemon Mimikyu.\n\nThank you for your time!\n\nhttps://imgchest.com/p/a846xe9zo4x", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sove5608/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2629499, "client_id": 3074427, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/656d2976/uploads/origins/60bb06d0-1fd2-491b-9915-aa49f0ee85b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f67a3fc302d29cdff680044923d84f5f", "srcset": "https://si.imgix.net/656d2976/uploads/origins/60bb06d0-1fd2-491b-9915-aa49f0ee85b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f67a3fc302d29cdff680044923d84f5f, https://si.imgix.net/656d2976/uploads/origins/60bb06d0-1fd2-491b-9915-aa49f0ee85b