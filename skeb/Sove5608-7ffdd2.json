er personality.\nPose is free as well, outfit is free to choose from different types!\n\nThank you for the appeal! Have fun drawing her!\nI'll be looking forward to it, have a nice day!\n\nhttps://drive.google.com/drive/folders/1yfNtWL0NRT5ovhl6TszDMm8uUOI-Qb8w?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sove5608/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2629499, "client_id": 2687824, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2cd7c944/uploads/origins/b8d70c0a-282b-4ddd-b115-b118e10f4641?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3eff1a6ab9a3f8c97b2153d90f1152f7", "srcset": "https://si.imgix.net/2cd7c944/uploads/origins/b8d70c0a-282b-4ddd-b115-b118e10f4641?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3eff1a6ab9a3f8c97b2153d90f1152f7, https://si.imgix.net/2cd7c944/uploads/origins/b8d70c0a-282b-4ddd-b115-b118e10f4641?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=edd69dea284e76208362511da606e153 2x, https://si.imgix.net/2cd7c944/uploads/origins/b8d70c0a-282b-4ddd-b115-b118e10f4641?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1979058a728b06b493031735913ee012 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2cd7c944/uploads/origins/b8d70c0a-282b-4ddd-b115-b118e10f4641?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9939579901abcdaa2cb129c8df272303", "srcset": "https://si.imgix.net/2cd7c944/uploads/origins/b8d70c0a-282b-4ddd-b115-b118e10f4641?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9939579901abcdaa2cb129c8df272303, https://si.imgix.net/2cd7c944/uploads/origins/b8d70c0a-282b-4ddd-b115-b118e10f4641?bg=%23fff&auto=format%2Ccompress&fm=