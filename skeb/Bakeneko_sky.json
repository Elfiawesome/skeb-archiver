p=top&w=200&h=200&blur=200&s=a7b9ee5247a3309f91a43675ad01eadf", "src_set": ""}, "body": "こんにちは！お願いがあります！\nこのキャラクターを描いてもらえませんか？\nhttps://drive.google.com/drive/folders/13Zi7G2nrsM6vp723SfzYEw2dnlDhXrFM\n\nどんな構図でもOKです！よろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Bakeneko_sky/works/46", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3617002, "client_id": 1521141, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cef71720/uploads/origins/9773e285-87a0-49a3-870b-ded5a362c1fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0120c23fddb876627ee43d50c182ef75", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cef71720/uploads/origins/9773e285-87a0-49a3-870b-ded5a362c1fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd0e1f86a19c98c0f5348ea62d9c0b83", "src_set": ""}, "body": "こんにちは、bakeneko!\n私のうさぎのもちを描いてほしいです。\nお好きなように描いていただいて構いませんが、ドヤ顔がとてもかわいいです！\n\nありがとうございました\n\nhttps://drive.google.com/drive/folders/1ji0DF3D7bITLg1jrGvOQMgxY3Hbh1_pL", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Bakeneko_sky/works/45", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3617002, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/751dc6ad/uploads/origins/e68cfcc9-d7c0-44dd-ad37-06303b1a6d94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8762b3c61a7b208204440c0de1bb7cfe", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/751dc6ad/uploads/origins/e68cfcc9-d7c0-44dd-ad37-06303b1a6d94?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=602782cda8cf549c2dc1a534508d3bca", "src_set": ""}, "body": "いつもばけねこさんの作品を楽しませていただいております。\n\n\nSkeb受付開始されたとのことで、オリジナルキャラクター限定とありましたが、\nばけねこさんのオリジナルキャラクター、オータムくんとサマーくんが\n好きでして、この二人をリクエストしてもよろしいでしょうか？\n（参考・キャラ：https://www.pixiv.net/artworks/122108463）\n\n■シチュエーション\n真夏、部屋の中、二人がトランクス一枚であつくてだれている。「あぢ～」みたいな。\n\n（参考：\n　https://www.pixiv.net/artworks/124951656\n　↑ばけねこさんのこのイラストのもっと暑がっている感じで\n　https://www.pixiv.net/artworks/125479920\n　↑ポーズとしてはこういうポーズイメージです）\n\n■2人の格好\n・下着(トランクス)一枚（柄はチェック/公式デザインでも！）\n　+風呂上がりタオル首にとか、シャツとか着せたい上服があればなんでもOKです\n\n背景に関しては、普通の部屋でも、縁側でも、簡略・省略されててもOKです。\nほか、こまかいディテールはすべておまかせします。\nよろしくお願いします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Bakeneko_sky/works/44", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3617002, "client_id": 420985, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/93da8693/uploads/origins/9002a371-9c20-406f-8297-8d2012474e67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17574300c6aaf885a4c87a7856399413", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/93da8693/uploads/origins/9002a371-9c20-406f-8297-8d2012474e67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e5237a90c30617172eaef4ca7542d6b", "src_set": ""}, "body": "こんにちは、私のキャラクター、AJの何かが欲しいです！\n彼は猫の部分と犬の部分を持っています。鼻は猫の形をしているけど、犬のように黒い。ひげはなく、しっぽは猫です。\nツアー・アートが大好きなので、ぜひ彼を描いてください！\n\nhttps://drive.google.com/file/d/1SEEJuClizlUmXRAKcLqmKHbnU0JWofLj/view?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Bakeneko_sky/works/43", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3617002, "client_id": 3559145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1361313f/uploads/origins/038ea854-a283-4cf6-8221-8aec47a8db71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d30c86e4cc6150e028c91aca6e7d9b0e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1361313f/uploads/origins/038ea854-a283-4cf6-8221-8aec47a8db71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a9086f082dc8b5861b1523cf520c39a", "src_set": ""}, "body": "こんにちは！私はあなたの絵が本当に好きなので、あなたにリクエストを送りたいと思いました！頑張って描きます。\n\n私のキャラクター \"ふわふわドラゴンのカンデオ \"を描いて欲しいです。ポーズ、表情、背景はお任せします！\n\nよろしくお願いします！🩵🩷\n\nhttps://drive.google.com/file/d/13cD8x4zu4BZVpSg0Qts6aaygWdeWR8GO/view?usp=drivesdk", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Bakeneko_sky/works/42", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3617002, "client_id": 1655351, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5a3e116/uploads/origins/e68d1f5a-9089-47b1-96e6-cd6c3612db70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df28521758a360c19f6d8564745e0405", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5a3e116/uploads/origins/e68d1f5a-9089-47b1-96e6-cd6c3612db70?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c2d89b6e258851adbe0fd22da650ccd", "src_set": ""}, "body": "こんにちは、ばけねこさん！\n\n私のファーソナを描いてくれませんか？\n\nガオは真っ青なゴーグルと真っ青なバンダナスカーフをつけたユキヒョウです。黒いレザージャケットを着て、その下に白いTシャツを着ています。ガオはグレーのズボンと茶色のブーツも履いている。毛色はグレーの濃淡が多く、足、手、胸、骨盤、耳の内側、マズルの部分が白い。ガオは黄色い目をしている。\n\nガオはオオカミの一部でもある。牙は普通のユキヒョウよりも長く、太く、鋭い。また、毛がふわふわしているのも特徴で、尻尾の部分が最も目立つ！\n\nあとは、ポーズや服のレベル、表情など細かい部分はお任せします！ガオはあなたの画風にとても合うと思います！\n\nばけねこさん、ご検討ありがとうございました。\n\nhttps://drive.google.com/drive/folders/1P4tRrtifwSd4sZkyOLM7SZwEkmQylBRQ?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Bakeneko_sky/works/41", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3617002, "client_id": 3618029, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a827343e/uploads/origins/8760b07d-1f07-4a8c-a6b7-ae05450d477d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df0019cb49f64728708ac7f08e43b757", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a827343e/uploads/origins/8760b07d-1f07-4a8c-a6b7-ae05450d477d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bb9d7e54c2a0e79f66c1dd0b1c37703", "src_set": ""}, "body": "bakeneko様こんにちわ😊本当に2度目のSkeb依頼を受け付けてくださって嬉しいです！❤️\n今回はオリジナルOC兼セルフキャラの、ミルクイエローの立ち耳ウサギちゃんをお願いします🐰\n表情とポーズは明るく元気な感じで、少し照れ屋のような雰囲気をお願いします！\n服設はまだ決めてなくて🥲 あなたの好みでデザインしていただけると助かります！複雑でもシンプルでも大歓迎です☺️\n\n必ずお願いするポイント：\n・左耳にオレンジと紫の音符のリングが絡んでいます🎵\n音符のデザインは自由に変更しても構いませんが❗️\n2つのリングが絡み合った形は必ず残してください\n・腕から手の内側は白で、ミルクイエローではありません\n・眉毛は髪色と同じピンクの「ピース眉」（丸みを帯びた小さな眉）\n・前髪に2か所グリーンの挑染があります\n・右耳にはタグが付いています\n\n設定画と参考イラストは以下のリンクにてご覧いただけます！\nhttps://drive.google.com/drive/folders/1EX6STUYbFBqZp6y8pazEcGxTpE29w7M9?usp=share_link\n\nhttps://drive.google.com/drive/folders/1EX6STUYbFBqZp6y8pazEcGxTpE29w7M9?usp=share_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Bakeneko_sky/works/40", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3617002, "client_id": 137546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/643ee9b9/uploads/origins/018e0956-9f39-409b-bf41-1d864157b483?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97b6a5cb2d5c4fe1524689e1ad484a1a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/643ee9b9/uploads/origins/018e0956-9f39-409b-bf41-1d864157b483?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d43d6e61ba9465450fb1ff5d97c1cee5", "src_set": ""}, "body": "こんにちは！私は先生の絵がとても好きで、私の息子「アカツキ」の絵をお願いしたいです。彼は内気な北極狐の魔法使いで、太陽の力で魔法を使います。\n\n特に条件はなく、フォルダの中から好きな服を選んで、自由に創造してください...！あなたの作品を楽しみにしています！\n\nhttps://drive.google.com/drive/folders/1ok1vhKXfzbmUv126QuGPdqBr-C_F1PnF?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Bakeneko_sky/works/39", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3617002, "client_id": 1825333, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/16e3d2c7/uploads/origins/86012c0b-0acb-4c96-8d80-71537f001bd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cbbd7d581b561b6bcc4c461dd6052046", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/16e3d2c7/uploads/origins/86012c0b-0acb-4c96-8d80-71537f001bd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8e91170ea8e1c912a56d5c313732a56", "src_set": ""}, "body": "こんにちは、友人があなたの作品を紹介してくれて、とても気に入りました。\n私のキャラクターを描いていただけませんか？\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/10Gy1c862-7GmpRT7p47SHpQVpLXtxLkM?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Bakeneko_sky/works/38", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3617002, "client_id": 2428470, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/737e32a8/uploads/origins/88c8f7a1-131d-4225-ac08-978887c14b3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22c1ba09cd58683a0680c74d9fc26951", "src_set": ""}, "duratio