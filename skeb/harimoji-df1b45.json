等がレイヤー分け出来るPSDデータで頂けると有難いです。\nもし金額内で可能であれば何か背景もあると嬉しいです。もちろん厳しければ無しでも大丈夫です！\n\n以上、お忙しい中だと思いますがご検討よろしくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@harimoji/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1895877, "client_id": 203406, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0e4804f7/uploads/origins/2280d011-6115-4c11-8172-7cf7b1b5a26c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed03ac6a221a6a456aa6d9fe4ceca40c", "srcset": "https://si.imgix.net/0e4804f7/uploads/origins/2280d011-6115-4c11-8172-7cf7b1b5a26c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed03ac6a221a6a456aa6d9fe4ceca40c, https://si.imgix.net/0e4804f7/uploads/origins/2280d011-6115-4c11-8172-7cf7b1b5a26c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3e872acfc8b7584db21cb038f81ae20 2x, https://si.imgix.net/0e4804f7/uploads/origins/2280d011-6115-4c11-8172-7cf7b1b5a26c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=164e03a1765411e4cefceb5d0053a86c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0e4804f7/uploads/origins/2280d011-6115-4c11-8172-7cf7b1b5a26c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e350e1f477baedc7ad6fc0beba841b6", "srcset": "https://si.imgix.net/0e4804f7/uploads/origins/2280d011-6115-4c11-8172-7cf7b1b5a26c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e350e1f477baedc7ad6fc0beba841b6, https://si.imgix.net/0e4804f7/uploads/origins/2280d011-6115-4c11-8172-7cf7b1b5a26c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd01859cd29985940053d0e853633fe1 2x, https://si.imgix.net/0e4804f7/uploads/origins/2280d011-6115-4c11-8172-7cf7b1b5a