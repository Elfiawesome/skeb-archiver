cset": "https://si.imgix.net/79684590/uploads/origins/dbf687f9-cd94-4201-ad94-3ea8e3ed7622?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01e8b9ccf6d1ff297c66770dfa568ebc, https://si.imgix.net/79684590/uploads/origins/dbf687f9-cd94-4201-ad94-3ea8e3ed7622?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=57e92a3b97a92a0b518ec8a76b70cdcb 2x, https://si.imgix.net/79684590/uploads/origins/dbf687f9-cd94-4201-ad94-3ea8e3ed7622?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=53e122535468a201414ef3f32849e38c 3x"}, "body": "以前からTwitterでイラストを拝見していました\n水着ダイヤちゃんのイラストを拝見して惹かれたので依頼を送らせていただきます\n\n海岸に居る水色ビキニ姿のデアリングタクトをお願いします\n\nイメージとしてはトレーナーと海へ遊びに来て、タクトが着替えてビキニ姿を見せに来たのをトレーナー目線で見ているようなシチュです\nスリーサイズなど公式で出ていますが美乳美尻と表現できるくらいの大きさでスラっとした体つきで描いていただきたいです\nポーズ、背景、ビキニのデザインなどはお任せしますが照れて恥ずかしそうな顔、トレーナーの体などは入れずタクトがビキニ姿と分かる構図でお願いします\n\n可能でしたら白ワンピースを上に着てビキニが透けている差分もお願いします", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@harimoji/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1895877, "client_id": 2774735, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf520f88/uploads/origins/1e6668a7-9c36-4f5b-baa8-f7a4b5daf3af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36c6e003cc25de13f5b793516754139a", "srcset": "https://si.imgix.net/bf520f88/uploads/origins/1e6668a7-9c36-4f5b-baa8-f7a4b5daf3af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36c6e003cc25de13f5b793516754139a, https://si.imgix.net/bf520f88/uploads/origins/1e6668a7-9c36-4f5b-baa8-f7a4b5daf3af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85f4799791c4d75abd325e1651eb8153 2x, https://si.imgix.net/bf520f88/uploads/origins/1e6668a7-9c36-4f5b-baa8-f7a4b5daf3af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=748db44f02a78e928f51e129056f7170 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf520f88/uploads/origins/1e6668a7-9c36-4f5b-baa8-f7a4b5daf3af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ff4e94dbf794a5a9b6a4e4a741e78ae", "srcset": "https://si.imgix.net/bf520f88/uploads/origins/1e6668a7-9c36-4f5b-baa8-f7a4b5daf3af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ff4e94dbf794a5a9b6a4e4a741e78ae, https://si.imgix.net/bf520f88/uploads/origins/1e6668a7-9c36-4f5b-baa8-f7a4b5daf3af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bdb60b2443716979d3abaccf75c23572 2x, https://si.imgix.net/bf520f88/uploads/origins/1e6668a7-9c36-4f5b-baa8-f7a4b5daf3af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cd1c25bac56f5dff613702a87faa4315 3x"}, "body": "はりもじ先生\n\nはりもじ先生のきれいなイラスト大好きです。\n今回先生がリクエストを受け付けてくださるとのことで思い切ってリクエストさせていただきます。\n\nはじめてのリクエストですので、\n何か失礼な点や要領を得ない点など、ご迷惑をおかけしてしまうかもしれませんが\n何卒宜しくお願いします。\n\n以下キャラ要望と内容要望です。\n・物語シリーズの羽川翼さん\n・服装はウェディングドレス\n　参考：https://www.tutu-dress.com/wedding/6803/\n・髪色は白黒混ざった状態\n・髪型はロングでおさげ\n(服装がウェディングドレスなので、髪型が合わない場合ははりもじ先生のセンスにお任せします。)\n・メガネあり\n・表情は幸せそうに笑う/微笑む\n・背景(可能であれば) 白など淡い色の花びらが舞ってる状態\n\nイラストの構図は全体像であればあとはお任せします。\n\n使用用途：PCの壁紙、SNS等（ヘッダー・アイコン）で使用したいと考えております。\n\n要望が多く申し訳ございません。\n改めて宜しくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@harimoji/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1895877, "client_id": 463993, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b661417/uploads/origins/c8e4e916-244c-4607-8e7c-9a95b7a77cab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96d6090a5a36015b231df3e726377d88", "srcset": "https://si.imgix.net/8b661417/uploads/origins/c8e4e916-244c-4607-8e7c-9a95b7a77cab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96d6090a5a36015b231df3e726377d88, https://si.imgix.net/8b661417/uploads/origins/c8e4e916-244c-4607-8e7c-9a95b7a77cab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e619a0a28fe07057910f82a82a5ca302 2x, https://si.imgix.net/8b661417/uploads/origins/c8e4e916-244c-4607-8e7c-9a95b7a77cab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=08f470f24e1cf8f2cc1a7dd25e779eca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b661417/uploads/origins/c8e4e916-244c-4607-8e7c-9a95b7a77cab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=936df610a09b50fb0359a29ca32ecfa6", "srcset": "https://si.imgix.net/8b661417/uploads/origins/c8e4e916-244c-4607-8e7c-9a95b7a77cab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=936df610a09b50fb0359a29ca32ecfa6, https://si.imgix.net/8b661417/uploads/origins/c8e4e916-244c-4607-8e7c-9a95b7a77cab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a33666fe49f7a4c48c99c695768c7176 2x, https://si.imgix.net/8b661417/uploads/origins/c8e4e916-244c-4607-8e7c-9a95b7a77cab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=614e504cce946fca505f0a47fff53e88 3x"}, "body": "月姫のアルクェイド・ブリュンスタッドを描いて頂きたいです。衣装はデート服でお願いします。\nその他構図などの指定は特にありません。何卒よろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@harimoji/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1895877, "client_id": 1986708, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/349020d2/uploads/origins/92142155-1b6a-4e3e-bc32-f7a781942b48?bg=%23fff&auto=form