さ耳の後ろに着ている、この状態です：\nhttps://www.pixiv.net/artworks/114508661\n\nポーズと表情はこんな感じ：\nhttps://www.pixiv.net/artworks/111047022\nでもスカートはたくし上げない、ほかの部分は少々調整してもいいです\n\n頼みたいのシチュエーションは：\nPippaはプレゼントの上に座って、でも自分の体重でプレゼントを潰れた\nそのまま転んで、ポーズは参考の状態になる\n”謝れないよ”のようなクソガキっぽいの顔を作る\n\n背景の要求はないが、そのシチュエーションを伝えて、尻の下、潰れたのプレゼントボックスは必要です\n\nいつも通り、健全の本体と\nその後でわからせる（服は半脱ぎ、画面にち○ぽだけ、中出しする）\n表情はこのようなトロ顔：https://www.pixiv.net/artworks/123825109\nの差分もお願いします\n\nいつもありがとうございます！", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@John_ZeroWB/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a6d1c4c2/uploads/origins/34434637-e3bb-44bf-808a-661f17b7d844?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c2b6c6e6dacdb6ca1cca77e0d9b9433", "src_set": ""}, "private": true, "genre": "correction", "tipped": true, "creator_id": 2174269, "client_id": 1646568, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@John_ZeroWB/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d83fa66d/uploads/origins/54e4b8df-ff07-4273-910a-12f14c6cad00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c8f9fa99074e877f93750811f2d4f994", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2174269, "client_id": 1151094, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@John_ZeroWB/works/8", "private_thumbn