=crop&crop=top&w=200&h=200&s=c681340d087b9198baa6615f5e4c8148", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d60b5694/uploads/origins/2d6e98d9-8c97-4891-a9a2-76d3e1b3feda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab9b30f63faf5d6b2613d1f6edf5661a", "src_set": ""}, "body": "こんにちは先生\n先日先生の落書き\n（https://x.com/John_ZeroWB/status/1920178077394743333）\nを見た後、”もう一度婦警マエミさんにいじめれたい”とずっと考えています\nだからこのシチュエーションの作品は頼みたい\nマエミさんの制服は以前の作品（https://www.pixiv.net/artworks/108384273）と同じ\n\nポーズのは騎乗位の同時に足舐め、具体はご自由に\n\n男性は黒髪モブ、肌の色は以前の作品と同じ、筋肉質\n\n以前と同じ、健全の本体、セックス途中、最後に中出しの汁差分\nタイツは股間だけ破り、色は黒、白の差分、そしてカラードタイツ（色はご自由に）の差分も頼みたい\n\n以上です、今回もよろしくお願いします", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@John_ZeroWB/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2174269, "client_id": 1646568, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f506be7b/uploads/origins/3ce374fd-8ee7-4f01-843c-02541d837d2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=229cff3467d905804a1c5567c68f32de", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f506be7b/uploads/origins/3ce374fd-8ee7-4f01-843c-02541d837d2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b0473c55f9c14eb318d5dc2a3bbd401", "src_set": ""}, "body": "こんにちは先生、今回もマエミさんの作品を頼みたい\nシチュエーションは女体盛りです\nこのポーズで：\nhttps://www.pixiv.net/artworks/60345811\nテーブルの上に横たえて、クリームといちごで体を飾る\n（胸と股間はいちごをクリームの上に載って、足にもクリームを付ける、他の所はご自由に）\n服はまだ裸ニーソ、色はライトピンク\n彼女のヘアクリップはハートの形に変える\n\nしっぽは画面の下部分にいる、体に近いの部分だけが見える\n\n差分も頼む、クリームと果物を全部食べた後\n体の色んな所を味わったら（体と足はちょっと唾液に濡れる）、エッチする\nそして中出し、この時マエミさんの目はハートの状態になる\n\nでは、今回もよろしくお願いします", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptabl