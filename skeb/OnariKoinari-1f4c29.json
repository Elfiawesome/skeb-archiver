ki.jp/to/w/blueoath/%E3%82%B0%E3%83%AD%E3%83%BC%E3%82%A6%E3%82%A9%E3%83%BC%E3%83%A0/::attach/SnapCrab_NoName_2020-4-20_7-28-54_No-00.png?rev=dcf7a03c20cebaa3178cc945d7af77df&t=20200420072925）\nが、昼間の街の中で、服（リンク先の画像参考）のスカートの下にこっそりおむつを穿いて、恋人繋ぎで、歩きながらおむつにお漏らししているイラストをお願いできますか？\n\n・擬装、武装は省略してOKです。服装も難しそうなら…何か適当にそれっぽいのを着せて上げてください。\n\n・大スカは無し、小のみ\n\n・二人の表情は、\n吹雪【顔を赤くして息を荒くしている、まだ慣れていないのか恥ずかしそうだが、表情には快楽が混じっている】\nグローウォーム【少しだけ顔が赤いが、慣れているのか息は普通。だが頬を染めており、快感からか口からはほんの少しだけよだれが垂れている】\nでお願いします", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@OnariKoinari/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3335517, "client_id": 128023, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff65e906/uploads/origins/35be4fd5-baae-4067-9fe9-b7aa61f7c1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df75c17fbc9e58ed91080b95297f68ea", "srcset": "https://si.imgix.net/ff65e906/uploads/origins/35be4fd5-baae-4067-9fe9-b7aa61f7c1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df75c17fbc9e58ed91080b95297f68ea, https://si.imgix.net/ff65e906/uploads/origins/35be4fd5-baae-4067-9fe9-b7aa61f7c1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=afd743732d977a48c1704fed7d04a6fb 2x, https://si.imgix.net/ff65e906/uploads/origins/35be4fd5-baae-4067-9fe9-b7aa61f7c1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4098aa5173d06c7f9d74035858c6f31 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff65e906/uploads/origins/35be4fd5-baae-4067-9fe9-b7aa61f7c1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6b4ba51382bfd6bb9bedbc3c5074cdb", "srcset": "https://si.imgix.net/ff65e906/uploads/origins/35be4fd5-baae-4067-9fe9-b7aa61f7c1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6b4ba51382bfd6bb9bedbc3c5074cdb, https://si.imgix.net/ff65e906/uploads/origins/35be4fd5-baae-4067-9fe9-b7aa61f7c1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7174617972e61694c1f9de5298be8da7 2x, https://si.imgix.net/ff65e906/uploads/origins/35be4fd5-baae-4067-9fe9-b7aa61f7c1d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=523d12607d895f1215929148b80723f6 3x"}, "body": "いつもお世話になっております！\n\nリクエスト失礼しますっ\n前々回(https://skeb.jp/@OnariKoinari/works/9)\n前回(https://skeb.jp/@OnariKoinari/works/12)\n上記の続きとして、1人の人間を二匹がかりでオムツに堕としていく様子をお願いしたく思いますっ\n\nシチュエーションにつきましては\n前回ですっかりおもらしする快感に堕ち、仲間を増やそうとする二人\n見つけた人間の服を破りオムツを履かせ…同じお漏らし大好きなケモノに仲間入りさせようとする\n\nヨモギは仰向けにした人間の顔にのしかかり、茶色く膨らんだオムツを顔に押し付け無理やり嗅がせ\nリーキはオムツを履かされお漏らしが止まらなくなった人間のオムツに顔を埋め臭いを堪能する\n\n襲われている人間の容姿や性別についてはお任せしたします…っ\nまた…襲われている人間は獣毛が生え始めており、ヨモギorリーキと同じ姿になりかけていると大変助かります…！\n\nキャラ資料については以下に添付いたしますっ\n■資料\n・ヨモギ\nhttps://www.dropbox.com/scl/fi/ih0lipwatnddsbvqoftfr/.png?rlkey=qxlz7xuucb94n92pl6c7f8511&st=kkddd8p3&dl=0\n\n・リーキ\nhttps://www.dropbox.com/scl/fi/ci6cbvgl1heeqen4jzrgy/.png?rlkey=qry7k4k8ctzryfp20hraeicg4&st=ry2v5ngf&dl=0\n\n以上です、何卒よろしくお願いいたします！", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@OnariKoinari/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3335517, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/67c741d5/uploads/origins/b7f58d8a-3a5a-4fe0-b089-a49d3291ad09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1784e21d2fefd08f5ab6b1943334dfd9", "srcset": "https://si.imgix.net/67c741d5/uploads/origins/b7f58d8a-3a5a-4fe0-b089-a49d3291ad09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1784e21d2fefd08f5ab6b1943334dfd9, https://si.imgix.net/67c741d5/uploads/origins/b7f58d8a-3a5a-4fe0-b089-a