ins/8f6cbedb-03ec-4a6a-8951-636efe4176c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8371eea02b656e513a64106ca0f3b95e 3x"}, "body": "お世話になります。\n前回は組織のサイボーグに勧誘され、改造手術されて同じ戦闘用サイボーグに生まれ変わり、その様子の映像を流しこまれることで、強化洗脳されていく青年サイボーグを描いていただきありがとうございました。\n今回は、前回の青髪の青年サイボーグがサイバーな刀を構えて、戦士として覚醒している姿を描いていただきたく思います。\n組織の一員として、戦うことに喜びを感じ、昂っている感じで、可能であれば、ほぼ全身のイラストであると嬉しいです。\nそれ以外の構図はすべておまかせします。\n間を置かずの依頼となりますが、よろしくご検討下さい。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kajimagu00/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 411683, "client_id": 407156, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ae8d34c/uploads/origins/3607df89-1ea7-4c10-aa64-45acee5ca00d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27841de73f590c5a052bf1b93b4ba08a", "srcset": "https://si.imgix.net/8ae8d34c/uploads/origins/3607df89-1ea7-4c10-aa64-45acee5ca00d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27841de73f590c5a052bf1b93b4ba08a, https://si.imgix.net/8ae8d34c/uploads/origins/3607df89-1ea7-4c10-aa64-45acee5ca00d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=857e22ef964d7687676b9690f4575c01 2x, https://si.imgix.net/8ae8d34c/uploads/origins/3607df89-1ea7-4c10-aa64-45acee5ca00d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5cecdbef4897f5212a9c75492126f6d5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ae8d34c/uploads/origins/3607df89-1ea7-4c10-aa64-45acee5ca00d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08553ab0335679a3d26d2109c3050609", "srcset": "https://si.imgix.net/8ae8d34c/uploads/origins/3607df89-1ea7-4c10-aa64-45acee5ca00d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08553ab0335679a3d26d2109c3050609, https://si.imgix.net/8ae8d34c/uploads/origins/3607df89-1ea7-4c10-aa64-45acee5ca00d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bdbf679eb1c0b280459cbdb7390c2028 2x, https://si.imgix.net/8ae8d34c/uploads/origins/3607df89-1ea7-4c10-aa64-45acee5ca00d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6f28d6ebbae60f7802eaf06f7e9d2ce8 3x"}, "body": "こんにちは。前回、前々回と素晴らしい作品ありがとうございました。\n\n今回依頼させていただきたいのは、前々回描いて頂いた青年が任務で別の青年を勧誘し、その青年も戦闘用サイボーグに改造されていて、その様子を認識して昂ぶっている様子を書いていただきたいと思います。\n姿は前々回の青年の「改良版」といった感じです\n(青年は前々回と同じぐらいの年齢設定、髪は黒色か暗めの青色、肌は褐色まではいかないくらいの若干濃いめの色、悪堕ち気味の強化洗脳されているような設定です)\n\n手術台に大の字に拘束され、ほぼ改造は完了し、全身が装甲化されているが、チューブやケーブルが接続され最終調整されている。\nなお、片腕の装着がまだでケーブルなどが接続部から出ている。また胸部や腹部のアーマーは一部が装着されておらず、ギシギシに詰め込まれた改造された内部構造が見えていて、ケーブルやチューブが接続されている。\nその様子は青年に映像として流し込まれており、改造されたいる身体に興奮しているイメージです。\n\nシチュエーション、カラーリング、構図などはおまかせします。よろしくお願いいたします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kajimagu00/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 411683, "client_id": 2663295, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1abe4182/uploads/origins/fa958fc4-46cc-4538-a409-21822ffae61e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2056d71006b35efe0457ee8fffde2f36", "srcset": "https://si.imgix.net/1abe4182/uploads/origins/fa958fc4-46cc-4538-a409-21822ffae61e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2056d71006b35efe0457ee8fffde2f36, https://si.imgix.net/1abe4182/uploads/origins/fa958fc4-46cc-4538-a409-21822ffae61e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4aca3c9543032c0a40cba0ec0c7103cb 2x, https://si.imgix.net/1abe4182/uploads/origins/fa958fc4-46cc-4538-a409-21822ffae61e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&f