h=200&blur=200&s=344166c81b993d11ec35a973b0db6aba 2x, https://si.imgix.net/07a85890/uploads/origins/74c0f28d-01b3-48a4-9052-0bced75719f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ab81f783e993c8cc6c676bde2dc425a1 3x"}, "body": "初リクエスト失礼します。\n\n少年戦闘員改造手術の絵を拝見し、今度は女性を描いてほしいなと思っております。\n以下希望シチュエーション列挙します。\n\n☆和風成人女性（可能なら年齢３０代）\n☆手術室で全裸あおむけ\n☆腹部を開いて体内を人工物に置換する作業中\n☆人工呼吸器装着　輸液管や電気ケーブルが体内に伸びている\n☆手足も切開され人工物が露出\n☆切開部分や女性器から液漏れ\n☆体表のどこかに機械化した証の焼き印\n\n以上です。\n悪の組織による強制ではなく、医療行為としての機械化改造という雰囲気が出ているとうれしいです。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kajimagu00/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 411683, "client_id": 407156, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d15da3f6/uploads/origins/b7c843bb-84c4-4650-b731-e685c4ff2898?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3460e2fbd68efdc4b884c7fd9d45e7d2", "srcset": "https://si.imgix.net/d15da3f6/uploads/origins/b7c843bb-84c4-4650-b731-e685c4ff2898?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3460e2fbd68efdc4b884c7fd9d45e7d2, https://si.imgix.net/d15da3f6/uploads/origins/b7c843bb-84c4-4650-b731-e685c4ff2898?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=379dbb27ced349cc8634466707d01149 2x, https://si.imgix.net/d15da3f6/uploads/origins/b7c843bb-84c4-4650-b731-e685c4ff2898?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7bb17f8caa2f0c92fc83ef4e3909eb3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d15da3f6/uploads/origins/b7c843bb-84c4-4650-b731-e685c4ff2898?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b441166597b91edaa35b9fdda5fbae2a", "srcset": "https://si.imgix.net/d15da3f6/uploads/origins/b7c843bb-84c4-4650-b731-e685c4ff2898?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b441166597b91edaa35b9fdda5fbae2a, https://si.imgix.net/d15da3f6/uploads/origins/b7c843bb-84c4-4650-b731-e685c4ff2898?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=da124c8dc72cfc0d378559ad43930369 2x, https://si.imgix.net/d15da3f6/uploads/origins/b7c843bb-84c4-4650-b731-e685c4ff2898?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e3c7963154cc285f3695bcf7dbf2fab6 3x"}, "body": "こんにちは。前回は戦闘用サイボーグに改造され、昂ぶる少年のイラストありがとうございました。ボディの描写やダークな雰囲気がとても良かったです。\nTweetでも、メカバレな少年が手術台に乗せられているようなイラストを書かれておられましたので、思い切って依頼させていただきます。\n今回は、前回の戦闘用サイボーグの青年が完成する前、生身の人間の姿から、サイボーグになっていく「改造手術」の描写をお願いしたく思います。\n\n内容は、\n手術台のようなものに拘束され、ロボットアームや機械触手のようなもので、生身の肉体が徐々に機械化改造され、カラダのあちこちにチューブやケーブルが接続されている状態。\n改造の進行具合は50％ぐらい。生身と改造された部分が混在しているような姿で、少年の表情は洗脳・調整作業の進捗でうつろになっている。「メカバレ」の描写も可能であればお願いします。\n全体的に怪しげでダークな印象があるとよいです。\n\n流血、欠損描写があっても構いません。\n\n他の内容、構図等はおまかせします。時間がかかっても構いません。かなり際どく、マニアックでニッチな難しい依頼かと思いますが、よろしくご検討ください。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kajimagu00/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 411683, "client_id": 407156, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/463c6ee4/uploads/origins/e6c02821-ddf9-4603-a396-bebb7e69bcbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=caca37c6d2a133abe56ba76cdf55ab6d", "srcset": "https://si.imgix.net/463c6ee4/uploads/origins/e6c02821-ddf9-4603-a396-bebb7e69bcbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=caca37c6d2a133abe56ba76cdf55ab6d, https://si.imgix.net/463c6ee4/uploads/origins/e6c02821-ddf9-4603-a396-bebb7e69bcbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=773eb45bdf4842e97a9a26a1bb24d2be 2x, https://si.imgix.net/463c6ee4/uploads/origins/e6c02821-ddf9-4603-a396-bebb7e69bcbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d405bfb8e451e2ef37ce2dc79966733a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/463c6ee4/uploads/origins/e6c02821-ddf9-4603-a396-bebb7e69bcbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7dc861f405109c508ca4cc4c7eed120a", "srcset": "https://si.imgix.net/463c6ee4/uploads/origins/e6c02821-ddf9-4603-a396-bebb7e69bcbe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7dc861f405109c508ca4cc4c7eed120a, https://si.imgix.net/463c6ee4/uploads/origins/e6c02821-ddf9-4603-a396-bebb7e69bcbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=167ae0de5fec0be9ab38d607674e0853 2x, https://si.imgix.net/463c6ee4/uploads/origins/e6c02821-ddf9-4603-a396-bebb7e69bcbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0d63a20252e9c71e2a57f3f3f4d9591b 3x"}, "body": "こんにちは、はじめまして。\n\nピクシブにて、メカ腕とメカバレした少年を描かれているのを拝見して、思い切ってご依頼させいただこうと思い、筆を執りました。\n\n今回依頼させていただきたいのは、戦闘用サイボーグに改造された、10代後半ぐらいから20代前半ぐらい青年を描いていただきたいと思います。改造された青年の姿は、全身は戦闘用アーマーやスーツで覆われている。マーキングのたぐいはある。表情がわかるように、装甲は顎や耳のあたりまで。\nサイボーグ化された自らのカラダに満足して昂ぶっているような姿をお願いしたく思います。\n\n(可能であれば、体にケーブルなどが接続されて調整されている感じもほしいです。)\n(青年は若干悪堕ち気味になっている設定です)\n\nカラーリング、構図などはおまかせします。いつもとは違うマニアックな内容ですが、よろしくご検討ください。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kajimagu00/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 411683, "client_id": 161481, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d4717352/uploads/origins/6a8b1872-31aa-4669-be65-65f255fff8fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c72df300dafebcab3885b40d4952a48e", "sr