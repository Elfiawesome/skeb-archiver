7-4d07-a5a9-19bc9a150e7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4fee5420a52fcf01b6bd00c3b36eeab", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff3832ef/uploads/origins/ae5d9169-3987-4d07-a5a9-19bc9a150e7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9899c6a30ba85e51ae800d8b776688bb", "src_set": ""}, "body": "これは私のオリジナルキャラクター2体です。これは2つの画像の連続です。\n画像1：クララ[1]は背後からアンナ[2]にアッパーカットを食らい、股間を強打します。その衝撃で、クララの胸が服から飛び出します（リングストラップが切れます）。両キャラクターとも服を着ています。[アンナの拳がクララの裸の性器に当たった衝撃のアップ（サイドコマ）が見たい。血は出ないで！]クララは驚いた表情をしている。アンナは楽しんでいるように見える。\n画像2：クララは辛うじて立っている。少し前かがみになり、痛む股間を手で覆っている。足は痛みに震えている。赤面し、涙をこらえている！腕の位置が胸を強調している。\n\nhttps://drive.google.com/drive/u/0/folders/1mqdVOe2-VsQIXqebX_V6F6zP65mKmRKk", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cannsk/works/77", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 498853, "client_id": 432590, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a1289bf/uploads/origins/a9603804-7dc2-4fd5-8bad-7bd38e5a7d89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a8cec592ce3f5b820456e836f30e9b95", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2a1289bf/uploads/origins/a9603804-7dc2-4fd5-8bad-7bd38e5a7d89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da64ad67dbab80ac2a8f547e29c2888a", "src_set": ""}, "body": "僕のヒーローアカデミアの麗日お茶子をお願いします。\n\n▼服装等\n・ヒーロースーツ\n\n▼シチュ\n・戦闘中、極太触手が真下から勢いよく突き上げてくる\n・ヒーロースーツの股間部分を突き破り、子宮を殴りつけるような勢いで挿入し、腹ボコォ\n・奥に到達した瞬間に勢いよく大量の精液を射精\n・結合部から破瓜の血と精液が逆流してる", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cannsk/works/76", "private_thumbnail_image_urls": null, "pr