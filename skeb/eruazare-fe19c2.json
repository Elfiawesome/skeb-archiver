-bd8e-933c0570c9c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ba6e729836edda84c1ce38b1f11a97d", "srcset": "https://si.imgix.net/7d2e0c85/uploads/origins/6e53d8bb-4e46-4945-bd8e-933c0570c9c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ba6e729836edda84c1ce38b1f11a97d, https://si.imgix.net/7d2e0c85/uploads/origins/6e53d8bb-4e46-4945-bd8e-933c0570c9c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a422d7326381a25e4ba6a4fb44e0ee1b 2x, https://si.imgix.net/7d2e0c85/uploads/origins/6e53d8bb-4e46-4945-bd8e-933c0570c9c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c2f58dc0f143b9ed1f263d4f227c419a 3x"}, "body": "初めまして、zenoと申します。\nオリキャラの絵を依頼したいです。\nTRPGで依頼キャラとして使っているキャラで、アリシアという500歳の吸血鬼の、紅茶が好きなロリおばあちゃん貴族です。\n黒系の拘束具や男の腕など(描きやすいもの、描きたいもので大丈夫です)で蹲踞のような格好で拘束されて、ぶつぶつの手袋などで秘部を擦り上げられながら、鼻先に男根を擦り付けられて、上目遣いで睨もうとしながら臭いでイってる様子をお願いします。\n上品で優しくて芯が強い人が、ぐずぐずに溶かされながら穢されてる感じの、汁・臭い多めだと助かります。\n要素が多ければ「蹲踞拘束」と「鼻フェライキ」だけ抑えてくだされば。\n絵が描けないので資料はカスタムキャストで作っていますが、衣装などは自由に変えたり崩してもらって構いません。(設定的には画像のような赤と黒と金が基調の礼服か、白と青のメイド服で過ごしています。\n\nhttps://bsky.app/profile/zeno1176.bsky.social/post/3klwmri4uo52o", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eruazare/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3133242, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dd4c5b21/uploads/origins/6ce2a55d-fb4a-4aa4-94c6-9caefa69d802?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6318a2737b929f00e8f5b0162a71ddb8", "srcset": "https://si.imgix.net/dd4c5b21/uploads/origins/6ce2a55d-fb4a-4aa4-94c6-9caefa69d802?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6318a2737b929f00e8f5b0162a71ddb8, https://si.imgix.net/dd4c5b21/uploads/origins/6ce2a55d-fb4a-4aa4-94c6-9caefa69d802?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=98a5c0dbb9ce725273588eeade738c14 2x, https://si.imgix.net/dd4c5b21/uploads/origins/6ce2a55d-fb4a-4aa4-94c6-9caefa69d802?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4bb07ba5069b714a65c7577b80d0db30 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dd4c5b21/uploads/origins/6ce2a55d-fb4a-4aa4-94c6-9caefa69d802?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fde505de84400b326dfb4af5b43ea8ab", "srcset": "https://si.imgix.net/dd4c5b21/uploads/origins/6ce2a55d-fb4a-4aa4-94c6-9caefa69d802?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fde505de84400b326dfb4af5b43ea8ab, https://si.imgix.net/dd4c5b21/uploads/origins/6ce2a55d-fb4a-4aa4-94c6-9caefa69d802?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=575008f62acabf4d44bf38d66787aca2 2x, https://si.imgix.net/dd4c5b21/uploads/origins/6ce2a55d-fb4a-4aa4-94c6-9caefa69d802?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=845e0276289f0f0f85b2399ba5e39ed1 3x"}, "body": "Twitterで納品イラストを拝見してクオリティの高さに感動しました。特に嫌そうな表情とお口えっち、触手などが素晴らしいです。\nもしよかったら以下の依頼をご検討いただければ嬉しいです。\n\n【キャラ】ユニコーンオーバーロードのロザリンデ\n（公式キャラ紹介ページ：https://unicorn-overlord.com/character/rosalinde/\n\n【シチュエーション】\nいつも描かれているお口えっち絵のような雰囲気で、唇つき触手に拘束され（資料掲示します、参考にしていただいた上でデザインは自由で大丈夫です）\n\n・嫌そうに、辛そうに\n・（何か事情があって）自分から触手にディープキス奉仕するのを強要されている\n・拘束している触手や順番待ちの触手はロザリンデの体を舐め回したりしている\n・他、順番待ち触手はロザリンデの綺麗なロングヘアをすくい取ったり、舐めしゃぶったり巻き付けたりしている\n\nイラストをお願いします。\n　\n【差分】\n差額での差分対応が可能であれば以下の差分をお願いします。\n汁と表情、書き文字の変化のみで大丈夫です。\n\n１：突然口内射精される（唇触手がディープキスしたまま口内に精液を吐き出してくる）、拘束、順番待ち触手も射精して髪や顔など全身を精液で汚される。ロザリンデは驚いて、かつ吐き気を催すような汚い精液を射精されてすごく嫌そうにえづく感じで\n\n２：目を辛そうにぎゅっと瞑って泣いてえづきながら精液を自分の意志で飲む\n\n３：唇触手が唇から離れてロザリンデの口内が見える。唇触手との間で精液の橋がかかる。ロザリンデはカメラ目線で辛そうにしながらも、嗜虐心を煽る表情でこちら（カメラ目線）を睨む\n\n【お願いしたい点】\n・書き文字、吹き出しなど可能でしたらお願いします。\n・髪は艶々のほうが好きです\n・髪フェチなので髪はまっすぐで、原作通り膝裏までかそれより長いくらいで（短くしないでください\n・衣装に関しては髪がよく見えるように黒マントは破くかとってしまってください。外衣装の損壊具合はお任せします（面倒であれば全裸でもいいです）\n・口以外の部位に関する責めはお任せしますが、メインはお口と髪で、やらしく舐め回している程度でお願いします\n\nhttps://www.dropbox.com/scl/fo/dyujeml8w3auef5408ktw/AJtwSXjfLcG-76V8BoyJuGg?rlkey=6x35b0fuzl2zhwl7yy4a2f0y0&dl=0", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eruazare/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3133242, "client_id": 461327, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23bc5135/uploads/origins/44080866-2d5c-4b17-8563-35aff8816e17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40f15b264974b53abde8d5feb63ff682", "srcset": "https://si.imgix.net/23bc5135/uploads/origins/44080866-2d5c-4b17-8563-35aff8816e17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40f15b264974b53abde8d5feb63ff682, https://si.imgix.net/23bc5135/uploads/origins/44080866-2d5c-4b17-8563-35aff8816e17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f9a1f1f0a8613fe6670274b602b1c895 2x, https://si.imgix.net/23bc5135/uploads/origins/44080866-2d5c-4b17-8563-35aff8816e17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ab53db7e2ebda6c7e8e4ad63530a2de 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23bc5135/uploads/origins/44080866-2d5c-4b17-8563-35aff8816e17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=924762b3d431645c341186b31db80f42", "srcset": "https://si.imgix.net/23bc5135/uploads/origins/44080866-2d5c-4b17-8563-35aff8816e17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=924762b3d431645c341186b31db80f42, https://si.imgix.net/23bc5135/uploads/origins/44080866-2d5c-4b17-8563-35aff8816e17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=94e5c10ca88891952008f79f28b4030e 2x, https://si.imgix.net/23bc5135/uploads/origins/44080866-2d5c-4b17-8563-35aff8816e17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a3517df18b74e39f70e2775d6b61eb3f 3x"}, "body": "フェラチオの後、指を舐めながらお金を渡されるシーンで、私のOCアシアを考えてみてください。\n\nhttps://sta.sh/21y78rp553aj?edit=1", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eruazare/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3133242, "client_id": 113707, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a12983ea/uploads/origins/93bb358b-5cb6-4151-ba33-89cd6e956832?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0aaddecfdf6f24fb6dc93d27f377f4e", "srcset": "https://si.imgix.net/a12983ea/uploads/origins/93bb358b-5cb6-4151-ba33-89cd6e956832?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0aaddecfdf6f24fb6dc93d27f377f4e, https://si.imgix.net/a12983ea/uploads/origins/93bb358b-5cb6-4151-ba33-89cd6e956832?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f3e73ad7375e0587c3606a64aef7dc2 2x, https://si.imgix.net/a12983ea/uploads/origins/93bb358b-5cb6-4151-ba33-89cd6e956832?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6d238e02ba9b07271a58fe1f5358f87 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a12983ea/uploads/origins/93bb358b-5cb6-4151-ba33-89cd6e956832?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50a0f332ed4623176827a6a70cb2ee14", "srcset": "https://si.imgix.net/a12983ea/uploads/origins/93bb358b-5cb6-4151-ba33-89cd6e956832?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50a0f332ed4623176827a6a70cb2ee14, https://si.imgix.net/a12983ea/uploads/origins/93bb358b-5cb6-4151-ba33-89cd6e956832?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c8e79e31d6a157de7aee4c30f207bed8 2x, https://si.imgix.net/a12983ea/uploads/origins/93bb358b-5cb6-4151-ba33-89cd6e956832?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c706d7c6365da2a8c826f0afb6719fdd 3x"}, "body": "初めまして、いつも素晴らしい作品をありがとうございます。ご依頼させていただきます。\nキャラ:勝利の女神NIKKEよりレッドフード\n服装:通常衣装。装備等はなくても大丈夫ですが可能な範囲着衣でお願いしたいです。(破れるとかは可)\n構図:以前描かれていた触手ラプラスがとても良かったので触手をお願いしたいです。四肢を触手に拘束されてM字のような体位で足を開かされる。\n触手はラプラスの時のようなイボイボのあるのと乳首を吸い付いてくるタイプのをお願いしたいです。ラプラスの時ほど触手は多くなくても良いので全体的にうねうねと苗床のようになっているのが見たいです。触手の種類等はおまかせします。\n差分で\n1.四肢を拘束されて動けず何が起こるか不安そうな顔。描写はなくても良いので直前にニケに効く媚薬のようなものを注入されてる設定。\n2.服を破る、またはズラしたりはおまかせで小陰唇を掴み膣口をクパァとして開かされイボイボの触手が膣口で待機しており、膣からは愛液を垂らしている。顔は何をされるのか理解して嫌悪感の溢れる顔。\n3.触手が膣口クチュクチュと膣口に擦り付けられ「ふーっふーっ」と息を荒くしている。服の胸の部分をズラし乳首にも触手に吸い付かれている。\n4.ゴツゴツとした触手が挿入され「うぐっ」と異物感を感じている。\n5.イボイボの触手が膣内を掻き回し快楽を感じ始め、息を荒くして余裕がなくなっている。\n6.膣内に白濁液を出され、痙攣して絶頂する。\n7.最後は触手を引き抜かれてビクビクしながら膣から白濁液を垂らす。その他に体全身に白濁液で汚してあげてほしいです。\n残りの背景や細かい構図等はおまかせします。ご不足等あれば再送いただけますと幸いです。\n難しい内容かと思いますがぜひご検討よろしくお願いします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 6654, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "せつにゃん＠DMのURLに飛ばないでください！", "screen_name": "hardcrom", "avatar_url": "https://pbs.twimg.com/profile_images/1359411948345958400/NhpWh9pU.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": 43, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 160}, {"id": 132363, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ささくら🔞", "screen_name": "sskur_a",