すべてあんどう様にお任せいいたします。\n\n\n‐-----‐-----‐-----‐-----‐-----‐-----‐-- \n\n\n以上の内容で、お願いできますでしょうか。 お忙しいところ恐れ入りますが、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/13Y9npcoTNzgKTkIyGfPRwvqXA1X4dnh9", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Andou_Honpo/works/34", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2875278, "client_id": 2457613, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7387423/uploads/origins/b6599811-a0f2-43f5-8100-4e1497a2e61d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ca1ba02cd08bea4901bf369b4a1eddd", "srcset": "https://si.imgix.net/b7387423/uploads/origins/b6599811-a0f2-43f5-8100-4e1497a2e61d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ca1ba02cd08bea4901bf369b4a1eddd, https://si.imgix.net/b7387423/uploads/origins/b6599811-a0f2-43f5-8100-4e1497a2e61d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=826f0005f6bf67e8b938aee9412fb21c 2x, https://si.imgix.net/b7387423/uploads/origins/b6599811-a0f2-43f5-8100-4e1497a2e61d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7053cefcfa7a89bb3ceb6fb5d90afbce 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b7387423/uploads/origins/b6599811-a0f2-43f5-8100-4e1497a2e61d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=817ac2362b85a55561e0f74ee1338209", "srcset": "https://si.imgix.net/b7387423/uploads/origins/b6599811-a0f2-43f5-8100-4e1497a2e61d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=817ac2362b85a55561e0f74ee1338209, https://si.imgix.net/b7387423/uploads/origins/b6599811-a0f2-43f5-8100-4e1497a2e61d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e1ac03ae930616ff8ca8f77bf