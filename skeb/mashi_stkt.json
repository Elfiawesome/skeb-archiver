e": false, "total_appeals_count": 0, "received_works": [{"path": "/@mashi_stkt/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3455820, "client_id": 2006966, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/987a490f/uploads/origins/56bb9c60-e681-4534-8424-afd9e54039c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0806605f02aedc870ff7be3a8e8221d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/987a490f/uploads/origins/56bb9c60-e681-4534-8424-afd9e54039c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3e890f00e3bdda3fa5e53843b12cf05", "src_set": ""}, "body": "Hi, I recently saw your art on X and it's very good! Could you draw this horse girl character?\nhttps://drive.google.com/drive/folders/1gqQpNUo-faR8sJuIUAsXTJ3wUABODPfI?usp=drive_link\nShe has a teasing, smug and bratty personality. I'll leave the details and pose up to your choice!\n\nhttps://drive.google.com/drive/folders/1gqQpNUo-faR8sJuIUAsXTJ3wUABODPfI?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mashi_stkt/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3455820, "client_id": 747569, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/76b8e512/uploads/origins/8e853dbc-1d12-47b7-969f-7edab1f33de2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d90f3a9e62491baf4f9226d264dbb2fb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/76b8e512/uploads/origins/8e853dbc-1d12-47b7-969f-7edab1f33de2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bdbf2cec0646681272498d483c0b946d", "src_set": ""}, "body": "こんにちは！パジャマ姿のコユキちゃんの最近の作品を見て、偶然あなたのアカウントを見つけました！とても可愛かったので、他の作品も見てみました。\nこれらの作品が私のお気に入りです！\nhttps://x.com/mashi_stkt/status/1921565963960385951\nhttps://x.com/mashi_stkt/status/1909862992138977604\n\nスケブを持っていることに気づいたので、私のvtuberキャラクター佐藤秋美をどう描くか見てみたいです！\n\n科学者の服を着ているところを描いてもらえますか？\n片手をコートのポケットに入れて、もう片方の手でメガネを調節して、自信に満ちたポーズをとってほしいです。\n表情は自信に満ちたものにしてください！ブルーアーカイヴのカスミのように、クールだけどちょっとドヤ顔な感じにしてください。\nもし可能であれば、アンダーフレームの眼鏡をぐぐる眼鏡に変更した代替品も追加していただけませんか？\n\nあとは自由に描いていただいてかまいませんが、目のディテールはしっかり描き込んでください！彼女の椎茸の目はとても重要です！\n\nありがとうございました！\n\nhttps://imgur.com/a/3CeDQyP", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 50667, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ほろくさ", "screen_name": "horokusa0519", "avatar_url": "https://pbs.twimg.com/profile_images/1953799577993457666/t_uGQfTl.jpg", "header_url": "https://pbs.twimg.com/profile_banners/718352776548519936/1724696437/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 49}, {"id": 528831, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "Encode@紅楼夢L-09a秋例大祭え58a", "screen_name": "Encode10Fantasy", "avatar_url": "https://pbs.twimg.com/profile_images/1974828319016382464/Eaj8plJk.jpg", "header_url": "https://pbs.twimg.com/profile_banners/738873678922842112/1759670737/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 128}, {"id": 1057632, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "07", "screen_name": "sobakonattou07", "avatar_url": "https://pbs.twimg.com/profile_images/184481268322661990