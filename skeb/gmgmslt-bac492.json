thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 1331981, "client_id": 1540375, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e6dd5ff/uploads/origins/12bfb9c1-cff7-431d-a790-a5e62999514b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5224b07b1f1544a03d45bd6b9655850", "srcset": "https://si.imgix.net/3e6dd5ff/uploads/origins/12bfb9c1-cff7-431d-a790-a5e62999514b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c5224b07b1f1544a03d45bd6b9655850, https://si.imgix.net/3e6dd5ff/uploads/origins/12bfb9c1-cff7-431d-a790-a5e62999514b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=178d0059af0fb9844ecbcc70ee2e4e82 2x, https://si.imgix.net/3e6dd5ff/uploads/origins/12bfb9c1-cff7-431d-a790-a5e62999514b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=265f92f0042875f43417a903a0688b32 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e6dd5ff/uploads/origins/12bfb9c1-cff7-431d-a790-a5e62999514b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7af706b83140f268b18c596faba38dec", "srcset": "https://si.imgix.net/3e6dd5ff/uploads/origins/12bfb9c1-cff7-431d-a790-a5e62999514b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7af706b83140f268b18c596faba38dec, https://si.imgix.net/3e6dd5ff/uploads/origins/12bfb9c1-cff7-431d-a790-a5e62999514b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7141ea30d64f45c1778302643332c50f 2x, https://si.imgix.net/3e6dd5ff/uploads/origins/12bfb9c1-cff7-431d-a790-a5e62999514b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=28c7492e9b746e219d1657a7445d04ea 3x"}, "body": "ごまおさん初めまして、アデリーと申します。\nごまおさんの絵柄がとても好きなので、リクエストさせていただきました。\n\n▼リクエスト\n私のオリキャラ二人の漫画を描いていただきたいです。\n服装と髪型は好みでアレンジをしていただいて構いません。\nセリフやシチュエーションなどはお任せします。お好みで描いていただけると嬉しいです。\n\n▼キャラクター\nオード（Aude）　16歳　145cm\n無表情の少女。茶髪に金色の瞳。\nマフィアの後継者で、先天的な反社会性パーソナリティ障害を持ち、冷淡かつ無情。解剖学と拷問に長けており、見た目は優雅な貴族令嬢だが、その本質は小型の猛獣。\n\nアクセル（Axel） 41歳　185cm\n常に微笑みを浮かべた紳士。茶髪に灰色の瞳。\nマフィアの首領。沈着冷静で理性的、強い自制心を持つ。サディスティックな一面と支配欲が強く、慈善事業を通じて上流社会で「温厚で思いやりのある商人」としてのイメージを作り上げている。\n\n二人は1950年代のフランスを舞台とするマフィアのキャラクター。家族であり師弟関係でもあります。（呼び方や会話の距離感は親密ですが、恋愛関係ではありません。）\n\n▼用途\n-アイコンやスマホの壁紙など個人観賞用\n-skeb等依頼する際の参考資料として用いる可能性があります\n\n金額や内容に不備などございましたら、お手数ですが再申請やキャンセルをしていただけますと幸いです。\nご一考のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Eydl86-uvBs1RKB8jqi5JGBYiU1wD-5q?usp=sharing", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gmgmslt/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1331981, "client_id": 2143390, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f05c9117/uploads/origins/ebe2301e-7f5d-4dec-a3e0-8d71d3ef2b2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcda2120a6abd1165f6887e67616b067", "srcset": "https://si.imgix.net/f05c9117/uploads/origins/ebe2301e-7f5d-4dec-a3e0-8d71d3ef2b2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcda2120a6abd1165f6887e67616b067, https://si.imgix.net/f05c9117/uploads/origins/ebe2301e-7f5d-4dec-a3e0-8d71d3ef2b2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=568b85284ea253ca41fd5ccf828eec6a 2x, https://si.imgix.net/f05c9117/uploads/origins/ebe2301e-7f5d-4dec-a3e0-8d71d3ef2b2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2108e0e25be1d9537c79fb03de671c3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f05c9117/uploads/origins/ebe2301e-7f5d-4dec-a3e0-8d71d3ef2b2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=833cab7