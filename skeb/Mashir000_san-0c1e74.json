%2Fitem%2Fm67090231350&docid=_8xWzybnM6q9TM&w=1080&h=1080&itg=1&source=sh%2Fx%2Fim%2Fm1%2F3&kgs=eac4c5d6e6eb2e27\n\nロイヤルパープル\nhttps://images.app.goo.gl/oVXcTkgwoCoBAEFE7\n\n元はタトゥーのためのデザインですが、ホラー小説を投稿するアカウントのサムネイルとして、神秘的な雰囲気に描いてくださると嬉しいです。\n\nご一考のほどお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mashir000_san/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2079835, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/98ca6cc5/uploads/origins/e3b91b46-b890-404e-9ed5-32e1a817a560?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fae51312b4e300b5b381c2cdc749d0e2", "srcset": "https://si.imgix.net/98ca6cc5/uploads/origins/e3b91b46-b890-404e-9ed5-32e1a817a560?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fae51312b4e300b5b381c2cdc749d0e2, https://si.imgix.net/98ca6cc5/uploads/origins/e3b91b46-b890-404e-9ed5-32e1a817a560?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb6c9b270f653cb5b087f57efeacfccd 2x, https://si.imgix.net/98ca6cc5/uploads/origins/e3b91b46-b890-404e-9ed5-32e1a817a560?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d857155a03fd5658e9e390ccba0d180 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/98ca6cc5/uploads/origins/e3b91b46-b890-404e-9ed5-32e1a817a560?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f9b2472fb01a6182fe4cfcc78d17315", "srcset": "https://si.imgix.net/98ca6cc5/uploads/origins/e3b91b46-b890-404e-9ed5-32e1a817a560?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f9b2472fb01a6182fe4cfcc78d17315, https://si.imgix.net/98ca6cc5/uploads/origins/e3b91b46-b890-404e-9ed5-32e1a817a560?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=28927734630c3f0cd14759c304a096cc 2x, https://si.imgix.net/98ca6cc5/uploads/origins/e3b91b46-b890-404e-9ed5-32e1a817a560?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dffefcbb957562cc218e887b8a36698d 3x"}, "body": "リピーターです。\n\nサムネイルとして縮小された際にも、デフォルメされながらも、解剖学を履修された確かな画力が光るサムネイルたちをありがとうございました。\n\n今回も、雨木麻白 様にSNSライフを満喫するためのサムネイル用イラストをお願いしたく、リクエストをさせていただきました。\n\n・上半身のみのサムネイル用イラスト\n\n・頬杖をつきながら、もう片方の手でチェスを打つ天使\n\n・天使の羽と輪と、天使っぽい白い服\nhttps://images.app.goo.gl/47fGyko2fyjmUA987\n\n・ピンクの髪\nhttps://images.app.goo.gl/TLkvUM7vL78sPLJg8\n\n・イエローと花緑青の２パターンの背景色の納品\nhttps://images.app.goo.gl/nDRg5z7eqtvGY2179\n\nhttps://images.app.goo.gl/LGrimSX7HgfNdt999\n\n・チェスをする人の参考画像\nhttps://images.app.goo.gl/1ujXPeEVG2x4khxF7\n\n・こちらも\nhttps://images.app.goo.gl/VqKopB9f1c1LSnEh6\n\n・サムネイルとして使用する際に、チェスを持つ手と顔が、はみ出してもいいので円の枠内に収まっている\n\nここまでお読みくださり、ありがとうございました。\n\nゲームを楽しんでいるような、リラックスした表情で描いていただけたら嬉しいです。\n\nご一考のほど、お願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mashir000_san/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2079835, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ceecef25/uploads/origins/53393398-9fd1-4c4f-9cfa-fba60a7f3a74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d319dfd33eafc7e09db38a2bc7889f5b", "srcset": "https://si.imgix.net/ceecef25/uploads/origins/53393398-9fd1-4c4f-9cfa-fba60a7f3a74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d319dfd33eafc7e09db38a2bc7889f5b, https://si.imgix.net/ceecef25/uploads/origins/53393398-9fd1-4c4f-9cfa-fba60a7f3a74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=015f8b38162ff509eb83ccae8581e3c5 2x, https://si.imgix.net/ceecef25/uploads/origins/53393398-9fd1-4c4f-9cfa-fba60a7f3a74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa6172a157ddd5821a529bc253540ba9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ceecef25/uploads/origins/53393398-9fd1-4c4f-9cfa-fba60a7f3a74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=434839cc839ec29773f130ce40f4698f", "srcset": "https://si.imgix.net/ceecef25/uploads/origins/53393398-9fd1-4c4f-9cfa-fba60a7f3a74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=434839cc839ec29773f130ce40f4698f, https://si.imgix.net/ceecef25/uploads/origins/53393398-9fd1-4c4f-9cfa-fba60a7f3a74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a67f51e3e083ae241eac9f4c1763ca7a 2x, https://si.imgix.net/ceecef25/uploads/origins/53393398-9fd1-4c4f-9cfa-fba60a7f3a74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1b67f8874d303bb530c862a7a50b1436 3x"}, "body": "雨木麻白様の描かれるポケモンキャラクターは可愛いですね。\n\nよろしければ、サムネイル用にポケモンのエリカをお願いします。\n\nポーズはお任せしますが、自然体で可愛い感じにしていただけたら嬉しいです。\n\n・ポケモンのエリカ\nhttps://x.com/snkrdunk_jp/status/1709878597282836789?s=46&t=FyIN7uALDLeOIW6kYwz56w\n\n・コットンピンクと花緑青、淡い紫の3パターンの背景色の納品でお願いいたします。\n\n・コットンピンクの色見本\nhttps://images.app.goo.gl/D9eJwNzebPXSDMqY8\n\n・花緑青の色見本\nhttps://images.app.goo.gl/A59FMJ283eeKzEiF9\n\n・淡い紫の色見本\nhttps://images.app.goo.gl/emNLuPMnUqyKjawEA\n\n・サムネイルにしたときに、円の枠内に顔と手が一緒に入るようにお願いします。\n\n鑑賞者がドキッとするような、魅了されるイラストを描いてくださると嬉しいです。\n\n胸は大きめにしてください（笑）\n\nご一考のほどお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mashir000_san/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2079835, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54fb3833/uploads/origins/10ba12b9-b278-4fb8-9009-a7545ad18399?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f290aa566953543993f4bb11908b6816", "srcset": "https://si.imgix.net/54fb3833/uploads/origins/10ba12b9-b278-4fb8-9009-a7545ad18399?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f290aa566953543993f4bb11908b6816, https://si.imgix.net/54fb3833/uploads/origins/10ba12b9-b278-4fb8-9009-a7545ad18399?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf2cf74ee18b05d869d0305b18cc8a53 2x, https://si.imgix.net/54fb3833/uploads/origins/10ba12b9-b278-4fb8-9009-a7545ad18399?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3932c9260f1e9790747f3fb990429c02 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54fb3833/uploads/origins/10ba12b9-b278-4fb8-9009-a7545ad18399?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25cd0c2e00031b3832c7ae6c6709c905", "srcset": "https://si.imgix.net/54fb3833/uploads/origins/10ba12b9-b278-4fb8-9009-a7545ad18399?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25cd0c2e00031b3832c7ae6c6709c905, https://si.imgix.net/54fb3833/uploads/origins/10ba12b9-b278-4fb8-9009-a7545ad18399?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a996029c727e4c8e9300489d1bbe6665 2x, https://si.imgix.net/54fb3833/uploads/origins/10ba12b9-b278-4fb8-9009-a7545ad18399?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3d5a53aab6b927d26db70ff108e0a8e1 3x"}, "body": "リピーターです。\n\n前回の「りんごを齧る美少年」では、美しい人物画を描いてくださってありがとうございました。\n\n今回も「丑の刻参り」をテーマにしたサムネイル用のイラストをお願いいたします。\n\n・白装束に、金槌と藁人形\n\n・頭の五徳(金輪)に火の灯ったロウソクを付けている\n\n・暗い背景色\n\n・こちらの絵もご参考にされてみてください\nhttps://www.pixiv.net/artworks/47546070\n\n・首に数珠を巻いた黒鏡を胸につけている\nhttps://www.pixiv.net/artworks/101594046\n\n・シンプルなデザインの黒鏡に数珠が付いている\nhttps://images.app.goo.gl/uVmY5Ph9dQSW85VV6\n\n・恨めしさと、相手を呪うことへの悦びが入り混じった邪な笑み\n\n・女性の容姿や、五寸釘を口に咥えさせるか、させないかはお任せします\nhttps://www.pixiv.net/artworks/115704232\n\n雨木麻白様の伸び伸びとしたイマジネーションを絵に反映してくださると嬉しいです。\n\nここまでお読みくださり、ありがとうございました。\n\nご一考のほどお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mashir000_san/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2079835, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/499c20a3/uploads/origins/dc485109-dc34-4802-b867-7b41c261f2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f26ef5575c661117068dbcb4d54b9bda", "srcset": "https://si.imgix.net/499c20a3/uploads/origins/dc485109-dc34-4802-b867-7b41c261f2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f26ef5575c661117068dbcb4d54b9bda, https://si.imgix.net/499c20a3/uploads/origins/dc485109-dc34-4802-b867-7b41c261f2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=361300dd838682fcb268c72df4f52260 2x, https://si.imgix.net/499c20a3/uploads/origins/dc485109-dc34-4802-b867-7b41c261f2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c629a2bde2fdfde31cf532b72a4901f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/499c20a3/uploads/origins/dc485109-dc34-4802-b867-7b41c261f2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25e9406c5403684b7a96e21af1cca158", "srcset": "https://si.imgix.net/499c20a3/uploads/origins/dc485109-dc34-4802-b867-7b41c261f2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25e9406c5403684b7a96e21af1cca158, https://si.imgix.net/499c20a3/uploads/origins/dc485109-dc34-4802-b867-7b41c261f2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=93613c5c235564926bde5b31b7aba54c 2x, https://si.imgix.net/499c20a3/uploads/origins/dc485109-dc34-4802-b867-7b41c261f2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8f77b4b8d3c3db6d3706727530fa60e8 3x"}, "body": "I had a chance to see Ameki Mashira's work on SNS, and I felt the originality of his analog drawings, which are not influenced by the AI that is so popular these days.\n\nIf you would like, we would like a digital illustration of a beautiful boy chomping on an apple to be used as a thumbnail.\n\nUpper body only\n\nPurple hair, red eyes, clear white skin\n\nA bewitchingly beautiful boy like the fallen saint from the legend of the Holy Sword\nhttps://images.app.goo.gl/j8JkR83RYuB6jhir9\n\nLaurel crown on his head instead of a circlet.\nhttps://images.app.goo.gl/Q7CcUUzdg28rwmV97\n\nBiting down on an apple as if inviting you to look at the camera.\nhttps://images.app.goo.gl/ZoVKTStCTpSQZaJZ9\n\nClothing that exposes one shoulder like an ancient Greek toga\nhttps://images.app.goo.gl/CvNAhftqTEAYomZK6\n\nBackground is all flower green and blue\nhttps://images.app.goo.gl/nKXAtCofAMSeiGWKA\n\nThank you for reading this far.\n\nI would be happy if you could do a painting of a beautiful boy bewitchingly chomping on an apple in the image of a homosexual in a Caravaggio painting.\n\nThank you very much for your consideration.", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@KAGUSA_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3163072, "client_id": 2079835, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5514883/uploads/origins/91a1da6f-8540-4c2d-b581-9d37b0835b91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fb720e046e83920fe31b6cc48c77e95", "srcset": "https://si.imgix.net/b5514883/uploads/origins/91a1da6f-8540-4c2d-b581-9d37b0835b91?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1fb720e046e83920fe31b6cc48c77e95, https://si.imgix.net/b5514883/uploads/origins/91a1da6f-8540-4