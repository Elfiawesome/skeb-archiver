webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c74467681d5bd408aca434dccf8ab9a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/150a6af1/uploads/origins/995ab038-0e65-4607-b362-cdbe9e7ad549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cfd73d0b558396f4ac9b7ddfd4e87212", "srcset": "https://si.imgix.net/150a6af1/uploads/origins/995ab038-0e65-4607-b362-cdbe9e7ad549?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cfd73d0b558396f4ac9b7ddfd4e87212, https://si.imgix.net/150a6af1/uploads/origins/995ab038-0e65-4607-b362-cdbe9e7ad549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=541a57cd2f0e7010799a9a45a41d715d 2x, https://si.imgix.net/150a6af1/uploads/origins/995ab038-0e65-4607-b362-cdbe9e7ad549?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ceaed3dba7a65ebea92796086234179f 3x"}, "body": "リピーターです。\n\nSNSで使っている、５つのアカウントのサムネイルを「サンタ帽の神父」で統一したいので、リクエストさせていただきました。\n\nパソコンの画面からは、アナログよりもデジタルツールを使って描かれた絵のほうが見やすいので、デジタルツールでのご作業をお願いいたします。\n\n・上半身のみ\n\n・レモンイエローの背景\nhttps://images.app.goo.gl/MtABN8MTXTkvW3k36\n\n・美味しいそうにスプーンで皿に持ったプリンを食べている\nhttps://images.app.goo.gl/wcZVgVqcbLdgVuJB8\n\n・糸目\nhttps://images.app.goo.gl/JutcMXUqYxduHG8GA\n\n・元の顔のモデルは、アニゴジのメトフィエス\nhttps://images.app.goo.gl/Uw5K6saMfgZ83YpS9\n\n・銀髪に赤いサンタの帽子、両胸に白いエジプト十字が刺繍された黒のカソックを着ている\nhttps://x.com/sigure_CXL2/status/1931950346290835852\n\nネット生活が明るくなるような、爽やかな笑顔の神父を描いてくださると嬉しいです。\n\nご一考のほどお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mashir000_san/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2079835, "client_id": 3630656, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7e1c20f4/uploads/origins/9800d13f-d329-4775-96f2-ac2dd596d659?bg=%23fff&auto=forma