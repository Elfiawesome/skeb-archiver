-8360-61c8caebc180?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=271250945416e026e541a737c3aada98 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2051264c/uploads/origins/2aff7847-5c98-4734-8360-61c8caebc180?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c107a4dbb02986a9eca268527366ace", "srcset": "https://si.imgix.net/2051264c/uploads/origins/2aff7847-5c98-4734-8360-61c8caebc180?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c107a4dbb02986a9eca268527366ace, https://si.imgix.net/2051264c/uploads/origins/2aff7847-5c98-4734-8360-61c8caebc180?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bf4920eb2358560f9ea885da4e1e0d2a 2x, https://si.imgix.net/2051264c/uploads/origins/2aff7847-5c98-4734-8360-61c8caebc180?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=59b14bd11ba5b22663ee7c996310f1b6 3x"}, "body": "こんにちは！あなたのイラストがすごく素敵なので、ぜひ依頼したいです。\n\n添付したキャラクターは、私が参加しているペン＆ペーパーRPGのキャンペーンに登場する友人のキャラクターです。\n彼はアーサー王の孫であり、王位継承者で、つい最近エクスカリバーの扱い方を覚えたばかりです。\n\n性格的には傲慢で少し自己中心的ですが、とても魅力的で、友達のためならいつでも助けに駆けつけてくれます。\n\n舞台は中世ファンタジーで、彼は神話や童話に登場するキャラクターたちが通う魔法学校に通っています。（ディズニーの『ディセンダント』のような感じですね）\n\n王座に座り、とても傲慢なポーズで、もしかしたら得意げな笑みを浮かべながら、見る者を見下ろしている姿をぜひ描いていただけると嬉しいです！参考フォルダに鎧などのアイデアをいくつか入れておきましたが、お好きな王室の衣装や鎧で自由に描いてください！\n\n本当にありがとうございます。素敵な週末をお過ごしください！\n\nhttps://app.box.com/s/9ou3w3t67wfpnkzutt9neh9jku3tr7ht", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kariyuonly/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3571713, "client_id": 204344, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/855c1bc2/uploads/origins/ec491e5e-d36f-4f3f-afac-7a02c4e53bbf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cro