edrals, doves(crows if a darker atmosphere), apples\n\nYou can draw him however you like in any atmosphere of your choice.\n\nIf there are any unused drafts, it would be great if you can include them in the PSD.\nThank you for considering!", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kariyuonly/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3571713, "client_id": 3231954, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/48bd9f8a/uploads/origins/720c3b11-2a53-4233-a568-76a018a0ab46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e54d8be21018ff53321358f461dd3f71", "srcset": "https://si.imgix.net/48bd9f8a/uploads/origins/720c3b11-2a53-4233-a568-76a018a0ab46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e54d8be21018ff53321358f461dd3f71, https://si.imgix.net/48bd9f8a/uploads/origins/720c3b11-2a53-4233-a568-76a018a0ab46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fadc2b22b35cab00159a9b429ff591e9 2x, https://si.imgix.net/48bd9f8a/uploads/origins/720c3b11-2a53-4233-a568-76a018a0ab46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d087c96887bb508130a10d68cefb34e3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/48bd9f8a/uploads/origins/720c3b11-2a53-4233-a568-76a018a0ab46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e80420bbb191436cc784a8a10999041", "srcset": "https://si.imgix.net/48bd9f8a/uploads/origins/720c3b11-2a53-4233-a568-76a018a0ab46?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e80420bbb191436cc784a8a10999041, https://si.imgix.net/48bd9f8a/uploads/origins/720c3b11-2a53-4233-a568-76a018a0ab46?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=2