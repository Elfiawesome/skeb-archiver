\n眼鏡、アクセサリーは資料二枚目のを参考にして頂けると助かります。\n(ユキママの匙加減で眼鏡は無くても大丈夫です）\n\nhttps://drive.google.com/drive/folders/1koTmOE0x8pmd0tCv2VzFzPRB4UZE4LXO?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Yuki_yuduki/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 72208, "client_id": 545596, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f90ecb93/uploads/origins/6128de27-ecef-4be5-b2db-a28e89744c0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca97a1e28689aaa6eab398fed136df6a", "srcset": "https://si.imgix.net/f90ecb93/uploads/origins/6128de27-ecef-4be5-b2db-a28e89744c0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca97a1e28689aaa6eab398fed136df6a, https://si.imgix.net/f90ecb93/uploads/origins/6128de27-ecef-4be5-b2db-a28e89744c0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e2c07da539deeaee6a0dbd8963c891b 2x, https://si.imgix.net/f90ecb93/uploads/origins/6128de27-ecef-4be5-b2db-a28e89744c0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=feb59b71e9db84bcfa1bf47946636411 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f90ecb93/uploads/origins/6128de27-ecef-4be5-b2db-a28e89744c0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37ca293e78d0f844da3a4e3ae9d8275b", "srcset": "https://si.imgix.net/f90ecb93/uploads/origins/6128de27-ecef-4be5-b2db-a28e89744c0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37ca293e78d0f844da3a4e3ae9d8275b, https://si.imgix.net/f90ecb93/uploads/origins/6128de27-ecef-4be5-b2db-a28e89744c0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5273c9ef4115bcd44f955df9cd8a9ec3 2x, https://si.imgix.net/f90ecb93/uploads/or