を出すためにこれのように手の動きに線をつけると捗ると思う)\nhttps://www.pixiv.net/artworks/57313954\n\n③\nhttps://www.pixiv.net/artworks/56536303\n\n④\nhttps://www.pixiv.net/artworks/58703363#manga\n\n⑤\nhttps://www.pixiv.net/artworks/84347806", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AzusaneShinon/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9ced0e71/requests/155066_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd10399d300118a27d2389f8496a44d6", "srcset": "https://si.imgix.net/9ced0e71/requests/155066_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd10399d300118a27d2389f8496a44d6, https://si.imgix.net/9ced0e71/requests/155066_2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e06c9847d5f5bcad2e06e06783f091d 2x, https://si.imgix.net/9ced0e71/requests/155066_2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63b94a3fcaa2e97a19dd3e95fb40d18b 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 106131, "client_id": 719561, "nc": 161}, {"path": "/@AzusaneShinon/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 106131, "client_id": 333028, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28afe39a/requests/143500_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f34202ba0304c93bee950c479532b557", "srcset": "https://si.imgix.net/28afe39a/requests/143500_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop