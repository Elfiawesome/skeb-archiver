福山舞\n・赤城みりあ\nこの子達の中で同級生とエッチしてるところを描ける子がいたら是非お願いします。\n同級生達に誘われて学校の中でセックスしちゃうアイドル。\n無理やりや脅迫ではなく楽しんでセックスしてる感じでお願いします。\n枕営業や事務所での男性スタッフへの性処理で開発済なアイドルが何人もの男子達を相手にして搾り取ってく様子をお願いします。\n膣だけでなく口や手も使って何本も同時に相手をするアイドル。\n中出しやぶっかけ多めだと嬉しいです。\n可能でしたら台詞を入れてください。\nこの内容で問題ないようでしたらよろしくお願いします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@dai3aji/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 432261, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3cbb6b98/uploads/origins/f7b5c8f9-f8da-4d95-a03d-5984a8b91353?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e8e72afaf34f9a81b13cf846e4f48b0", "srcset": "https://si.imgix.net/3cbb6b98/uploads/origins/f7b5c8f9-f8da-4d95-a03d-5984a8b91353?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e8e72afaf34f9a81b13cf846e4f48b0, https://si.imgix.net/3cbb6b98/uploads/origins/f7b5c8f9-f8da-4d95-a03d-5984a8b91353?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1cb1532527a166ef1ce2e457f541b2aa 2x, https://si.imgix.net/3cbb6b98/uploads/origins/f7b5c8f9-f8da-4d95-a03d-5984a8b91353?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d048f9c12f857c89b8ace5e603fde85 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3cbb6b98/uploads/origins/f7b5c8f9-f8da-4d95-a03d-5984a8b91353?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=391b6bf18490ccbc5d285f2ab7328d03", "srcset": "https://si.imgix.net/3cbb6b98/uploads/origins/f7b5c8f9-f8da-4d95-a03d-5984a8b91353?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=391b6bf18490ccbc5d285f2ab7328d03, https://si.imgix.net/3cbb6b98/uploads/origins/f7b5c8f9-f8da-4d95-a03d-5984a8b91353?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&