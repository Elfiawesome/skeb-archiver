して頂きたくご連絡しました。\n構図は参考資料を参考に、祝日を楽しむ2人(画像①)を描いて頂きたいです。また、イラストに馴染むように「おはよう」の文字を入れて頂けないでしょうか？\nご検討の程、宜しくお願いします。\n構図(イメージ)\nhttps://images.app.goo.gl/2XnHBXGXJRLUwjMM7\n①Vキャラ(元になった画像)\n[※黒い方は妹キャラなのでVキャラより少し幼くお願いします。]\nhttps://twitter.com/UMisopy/status/1810971097158013295?s=19\nVキャラ\nhttps://twitter.com/UMisopy/status/1810955725965009367?t=YkODSpkEVieNNP2tqtPXxA&s=19", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ougipanda07/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 538942, "client_id": 1741859, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2258391a/uploads/origins/d715fc42-de9c-4cda-8543-c3cc201c3337?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3334847e2c92dea06517a0fad82b3dc", "srcset": "https://si.imgix.net/2258391a/uploads/origins/d715fc42-de9c-4cda-8543-c3cc201c3337?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3334847e2c92dea06517a0fad82b3dc, https://si.imgix.net/2258391a/uploads/origins/d715fc42-de9c-4cda-8543-c3cc201c3337?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c57325491d5aaf8f7b18f02feb385195 2x, https://si.imgix.net/2258391a/uploads/origins/d715fc42-de9c-4cda-8543-c3cc201c3337?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a985da6af78b1c2068968a8822f62ab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2258391a/uploads/origins/d715fc42-de9c-4cda-8543-c3cc201c3337?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ca91a851e71d78b2e6cca293908bcac", "srcset": "https://si.imgix.net/2258391a/uploads/origins/d715fc42-de9c-4cda-8543-c3cc201c3337?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ca91a851e71d78b2e6cca293908bcac, https://si.imgix.net/2258391a