r.com/tQn7FoH\nhttps://imgur.com/Qnm0AHQ\n胸やお尻など大きくお願いします。\n過去の納品物などもご参考ください。\n\n【コーデ】\nホロライブの沙花叉クロヱちゃんの衣装（通常）のコスプレでお願いします。\nhttps://hololive.hololivepro.com/talents/sakamata-chloe/\n\n髪型などクロヱちゃんに合わせて構いません。\nポーズや後景など先生におまかせします。\nゆっかちゃんと後景はレイヤーを分けてください。\n個人的にアクスタにして飾る予定です。\n可能であればめがねありなしが出来ると幸いです。\n難しいとは思いますが、何卒ご検討の程、宜しくお願い致します。\n\nhttps://twitter.com/mikenekonomikan/status/1119562503371968512", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@RamKilog/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2593626, "client_id": 1460936, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c9d329a5/uploads/origins/5b76fbe6-6704-4532-891e-33bc8d377194?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1638016158a34bca8a92f00e3f5cee7", "srcset": "https://si.imgix.net/c9d329a5/uploads/origins/5b76fbe6-6704-4532-891e-33bc8d377194?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1638016158a34bca8a92f00e3f5cee7, https://si.imgix.net/c9d329a5/uploads/origins/5b76fbe6-6704-4532-891e-33bc8d377194?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0e64b2e1c4c3719f37d3cc09cbadbd1b 2x, https://si.imgix.net/c9d329a5/uploads/origins/5b76fbe6-6704-4532-891e-33bc8d377194?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84c6179491e77098761b5426cb361524 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c9d329a5/uploads/origins/5b76fbe6-6704-4532-891e-33bc8d377194?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43da6194c26721a19d5da2df6e7c353c", "srcset": "https://si.imgix.net/c9d329a5/uploads/origins/5b76fbe6-6704-4532-891e-33bc8d377194?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43da6194c26721a19d5da2df6e7c353c, htt