host=scre&page=%E6%AE%BF&src=%E6%AE%BF.png\n\n以上です。宜しくお願いいたします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_swaying/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1083893, "client_id": 1351280, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/240197bb/uploads/origins/ab230211-df42-494e-a1cf-1db698233599?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b150bcc8137217697f2d66b9a13dbcc4", "srcset": "https://si.imgix.net/240197bb/uploads/origins/ab230211-df42-494e-a1cf-1db698233599?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b150bcc8137217697f2d66b9a13dbcc4, https://si.imgix.net/240197bb/uploads/origins/ab230211-df42-494e-a1cf-1db698233599?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8bbd1959bbb0776d057bcfe7a90938b2 2x, https://si.imgix.net/240197bb/uploads/origins/ab230211-df42-494e-a1cf-1db698233599?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b35ff4c79098743bd4ee498dea677680 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/240197bb/uploads/origins/ab230211-df42-494e-a1cf-1db698233599?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0df1e8242efe46f82aec9f3e84d6aa47", "srcset": "https://si.imgix.net/240197bb/uploads/origins/ab230211-df42-494e-a1cf-1db698233599?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0df1e8242efe46f82aec9f3e84d6aa47, https://si.imgix.net/240197bb/uploads/origins/ab230211-df42-494e-a1cf-1db698233599?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0b57e1fe373cc81ec039d635e2935f2b 2x, https://si.imgix.net/240197bb/uploads/origins/ab230211-df42-494e-a1cf-1db698233599?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5eb0797bdd00f84c6e81c67e47a90a35 3x"}, "body": "初めましてお世話になります。\nskebを見ていて好みの絵柄だったので申し込んでみました。\nお題は自分のサイトのマスコットキャラの子で、緑のジャージに体操服、ブルマーというキャラになります。\nhttps://twitter.com/Funakiya/status/1274391962989158400\n\nブルマの尻をこちら側に突き出してオナニーしているシチュエーションをお願いします。汁でブルマーにしみがあるとより嬉しいです。\n胸も体操服からはだけて乳首が見えている感じを希望です。\n構図としてはこちらのイラストが近いでしょうか。\nhttps://twitter.com/hiyukey/status/1421086269925326854/photo/1\n\nもしリクエスト枠に余裕がありましたら宜しくお願いいします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_swaying/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1083893, "client_id": 202590, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4fbfc901/uploads/origins/0b81e9bf-869e-4011-8e29-ddecee8cc7eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=078d9a752eed71590fed0d439dcdb55f", "srcset": "https://si.imgix.net/4fbfc901/uploads/origins/0b81e9bf-869e-4011-8e29-ddecee8cc7eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=078d9a752eed71590fed0d439dcdb55f, https://si.imgix.net/4fbfc901/uploads/origins/0b81e9bf-869e-4011-8e29-ddecee8cc7eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1dc410258065d99b546b9ace97aeeac 2x, https://si.imgix.net/4fbfc901/uploads/origins/0b81e9bf-869e-4011-8e29-ddecee8cc7eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bfc41ad3155c65498d503fe3103e4326 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4fbfc901/uploads/origins/0b81e9bf-869e-4011-8e29-ddecee8cc7eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7e190865b171f0e44f8da811c67fadd", "srcset": "https://si.imgix.net/4fbfc901/uploads/origins/0b81e9bf-869e-4011-8e29-ddecee8cc7eb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7e190865b171f0e44f8da811c67fadd, https://si.imgix.net/4fbfc901/uploads/origins/0b81e9bf-869e-4011-8e29-ddecee8cc7eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=13deea51349e372b75228d9785008052 2x, https://si.imgix.net/4fbfc901/uploads/origins/0b81e9bf-869e-4011-8e29-ddecee8cc7eb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d4ddc587669a9c233ce1e28cbe1cdb9 3x"}, "body": "エロ下着マリーメイアありがとうございました。\n違うキャラになりますが、よろしければご検討下さい。\n今回お願いしたいのは御城プロジェクト:REの「鶴丸城」です。\nhttps://uploader.swiki.jp/attachment/full/attachment_hash/d267284eaafb3aa68c7d5023a9fea90ea67d8ce7\n\n彼女はとても強気なキャラなのですが、マリーメイアのようなエロ下着を着せてあげてください。\nマリーメイアは「嫌悪感」のある表情、お尻を突き出した格好でしたが、\nこちらの子は「チン堕ちした」感じが欲しいので、男に媚びるようないやらしい表情、\n構図も後ろではなく、前からで片手でおっぱいをいじりながらもう片方の手でくぱぁして待ち構えている、というものでお願いしたいです。\n\nなお、上記の画像ですと糸目なのですが感情が高ぶると目が開く系の子なので、\nhttps://uploader.swiki.jp/attachment/full/attachment_hash/f6ff17c64769102e6b6135baa7ddbb292ac3ea50\nこちらのような半目の開いている状態でお願いできればと思います。\n\n上記でわかり辛い点、解釈に困る点などがあれば自由にして下さい。\nよろしくお願いします。\n\nhttps://scre.swiki.jp/index.php?%E9%B6%B4%E4%B8%B8%E5%9F%8E", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_swaying/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1083893, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1b4bb5d6/uploads/origins/fad2e10b-8d6e-4c4d-877c-9ab401ce9a3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02034c9a6adcb9f36b49d74816d42268", "srcset": "https://si.imgix.net/1b4bb5d6/uploads/origins/fad2e10b-8d6e-4c4d-877c-9ab401ce9a3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02034c9a6adcb9f36b49d74816d42268, https://si.imgix.net/1b4bb5d6/uploads/origins/fad2e10b-8d6e-4c4d-877c-9ab401ce9a3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5edfff432fae4fbda3bb320214a930bf 2x, https://si.imgix.net/1b4bb5d6/uploads/origins/fad2e10b-8d6e-4c4d-877c-9ab401ce9a3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12769f5b92b9d31e0a44fc5531f6f4b1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b4bb5d6/uploads/origins/fad2e10b-8d6e-4c4d-877c-9ab401ce9a3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4be80ab18d21bb161f278c396d1d688", "srcset": "https://si.imgix.net/1b4bb5d6/uploads/origins/fad2e10b-8d6e-4c4d-877c-9ab401ce9a3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4be80ab18d21bb161f278c396d1d688, https://si.imgix.net/1b4bb5d6/uploads/origins/fad2e10b-8d6e-4c4d-877c-9ab401ce9a3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0e3559f39caf3ec39721ad7f222b211c 2x, https://si.imgix.net/1b4bb5d6/uploads/origins/fad2e10b-8d6e-4c4d-877c-9ab401ce9a3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=169f84523e4f5833bfa1619498da7d84 3x"}, "body": "機動戦士ガンダムW(エンドレスワルツ)に登場するマリーメイア・クシュリナーダをお願いします。\n\n〇エロ下着とガーターベルト(ググれば色々出るかと思いますがお好きに描いて下さい)着用\n〇お尻を突き出しておまんこくぱぁさせられてるポーズ\n〇こんな格好とポーズをさせられて悔しくて泣きそうな雰囲気\n\nイメージとしては逆らえず犯される前に屈辱的なことを要求されたマリーメイアです。\n宜しくお願いします。\n\nhttp://www.gundam-w.jp/endless_waltz/character/08.html", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_swaying/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1083893, "client_id": 2278, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7fa16510/uploads/origins/3e29fd92-d0ee-487d-adb3-bd5fd8ce839a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05268765b19062561aa45211eaf1cfdf", "srcset": "https://si.imgix.net/7fa16510/uploads/origins/3e29fd92-d0ee-487d-adb3-bd5fd8c