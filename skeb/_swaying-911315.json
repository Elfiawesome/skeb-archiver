129/uploads/origins/efda2c88-e175-4ffb-8a26-8ff96711c2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6a1021ccdbf52bc799f8586e748cc262 2x, https://si.imgix.net/bed93129/uploads/origins/efda2c88-e175-4ffb-8a26-8ff96711c2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=807973f09c2d46038ac416c01ae4fcd3 3x"}, "body": "前回はうちの子を描いていただきありがとうございました！\nよろしければ今回も依頼させていただきます。\n\nキャラクターは自分のサイトのマスコットキャラの子で、緑のジャージに体操服、ブルマーというキャラになります。陰毛はありません。\nhttps://twitter.com/Funakiya/status/1274391962989158400\n\n前回おまけで描いていただいた柴犬がとてもかわいかったので、柴犬とうちの子を絡めて描いていただきたく…\n柴犬がうちの子とじゃれあっているところを描いていただけますでしょうか。\nエロシチュでも構いません。襟さんにお任せします。\n\nSNSでの紹介および18禁掲載可能な自分のサイトでの紹介の範囲で利用させていただければと思います。\nリクエスト枠に余裕がありましたら宜しくお願いいします。\n\nhttps://twitter.com/Funakiya/status/1274391962989158400", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_swaying/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1083893, "client_id": 95640, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e39b879f/uploads/origins/eeea8450-dceb-4d8d-8c7e-3d9b5b6159b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db041d49415189fc5b54a032b54cccd7", "srcset": "https://si.imgix.net/e39b879f/uploads/origins/eeea8450-dceb-4d8d-8c7e-3d9b5b6159b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db041d49415189fc5b54a032b54cccd7, https://si.imgix.net/e39b879f/uploads/origins/eeea8450-dceb-4d8d-8c7e-3d9b5b6159b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34ac775cefe91bcdaf38215fa9273ff0 2x, https://si.imgix.net/e39b879f/uploads/origins/eeea8450-dceb-4d8d-8c7e-3d9b5b6159b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6af6931257799fd85e3760374731040b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnai