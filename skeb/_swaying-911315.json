いたします。\n背景は必要ありません。\n彩色に関しましても特に指定ございません。塗り方も自由に願います。無彩色、白黒、グレースケールでも結構です。\n\n以上どうかよろしくお願いいたします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 13332, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ばいばい", "screen_name": "mucchiri", "avatar_url": "https://pbs.twimg.com/profile_images/1701271595174801408/siaQC_iH.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1701184651157757952/1747536518/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 33}, {"id": 18457, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "えもんず（4代目）", "screen_name": "emons03", "avatar_url": "https://pbs.twimg.com/profile_images/1455446663284523008/Fm6GWG1H.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 343397, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "わんざっく skeb&pixivリクエスト募集中", "screen_name": "wanzach1", "avatar_url": "https://cdn.bsky.app/img/avatar/plain/did:plc:ujh4mqeg2s65xs432nmctbzv/bafkreiapn624e7lrgjnrmw5ynenagpocsshteyriomwo7mjecaw3nuyovi", "header_url": "https://cdn.bsky.app/img/banner/plain/did:plc:ujh4mqeg2s65xs432nmctbzv/bafkreigtooyixefhe7ib3n2j5bidwcl5i4ictezxj44gvbgntprczm2jga", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expirat