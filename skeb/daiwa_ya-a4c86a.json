loads/origins/5e273aa3-5414-4470-a7f3-ca2b6c64ac9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d122ce1b388c1c1547b4b984ff86021, https://si.imgix.net/b5e31bb6/uploads/origins/5e273aa3-5414-4470-a7f3-ca2b6c64ac9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8de8630cccc6f21aab314f37910ea48e 2x, https://si.imgix.net/b5e31bb6/uploads/origins/5e273aa3-5414-4470-a7f3-ca2b6c64ac9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=64cbaf4ed14303bd7c20c8857a5a68f9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5e31bb6/uploads/origins/5e273aa3-5414-4470-a7f3-ca2b6c64ac9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11763cd53ff90f2d6a7dfcb0d8c287b0", "srcset": "https://si.imgix.net/b5e31bb6/uploads/origins/5e273aa3-5414-4470-a7f3-ca2b6c64ac9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11763cd53ff90f2d6a7dfcb0d8c287b0, https://si.imgix.net/b5e31bb6/uploads/origins/5e273aa3-5414-4470-a7f3-ca2b6c64ac9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b2d6c40000797a0ccd062fd3c744712e 2x, https://si.imgix.net/b5e31bb6/uploads/origins/5e273aa3-5414-4470-a7f3-ca2b6c64ac9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=53b18d5fd363c9d9da828095411e078b 3x"}, "body": "大和さんはじめまして！　skeb開設本当にありがとうございます。以前から大和さんの都道府県擬人化をTwitterで拝見しておりました。地元なのもあり、特に神奈川県のキャラデザが大好きです……。\n\nもしよろしければ、私の創作している架空の市「湖北市」を大和さんに擬人化していただきたいです。\n用途：描いていただいたイラストは個人鑑賞させていただきます！\n\n湖北市についての設定を以下に載せさせていただきます。\n\n【湖北市】\n\n人口約10万8千人。\n滋賀県北部に位置する架空の市。北部は福井県敦賀市、東部は滋賀県長浜市・西部は高島市に面しており、南部には琵琶湖が広がる。市内は大きく分けて、小谷・杉見・秋風台・浜の4地区からなる。\n\n地形の特性上、一年を通して北からの風がさかんに吹くため県内では最も年平均気温の低い市である。森林と琵琶湖の豊かな水源に恵まれ、農業が多く行われている。代表的な特産品はスモモだが、そのほとんどは湖北市内での地産地消となっており県外の市場に出回ることは少ない。\n\n最近では森林との共存をテーマにしながらも滋賀県随一の避暑地として急速な都市開発が進み、利便性が向上している。市役所のある秋風台地区ではイオンなどの商業施設が並び、琵琶湖に面している浜地区でも大規模温浴施設や展望台・水上アクティビティ施設など観光客向けの開発が行われてきた。一方で、小谷地区・杉見地区は森林を活かした建築を行なっている住居や店舗が多くみられる。森の中を歩いていると突然建物があらわれることに定評があり、小谷地区にあるテーマパーク「イギリス村」の存在も相まって少し不気味で不思議な独特のブランドを地区として確立している。\n\n鉄道の駅は湖北小谷駅・秋風台駅・近江塩津駅がある。いずれの駅も湖西線で京都府へ、近江塩津駅からは北陸本線で福井県へ行くことができる。\n\n湖北の森公園敷地内にて年1度、北琵琶湖まつりが開催されることで有名。滋賀県北部の地域を中心に地元の農産物や湖魚、ハンドメイドの雑貨や手作りクッキーなどが販売される。ステージでの催しも行われ、毎年約12万人が来場する。\n\n湖北市のウェブサイト（PC推奨）\nhttps://kohokucity.my.canva.site/\n\n湖北市のその他の設定や広報誌\nhttps://drive.google.com/drive/folders/1QtKB3CRUTSfi2YcmXEFg7PmKKx_jZ83l?usp=drive_link\n\n\nぜひ、自由な発想でデザインしていただきたいです！\nよろしければご検討いただけますと幸いです。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1224002, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "西野のめ🎨", "screen_name": "shinoPSD", "avatar_url": "https://pbs.twimg.com/profile_images/1656938647491575808/Axzk427S.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1331562592578355201/1606440796/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 1470378, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "えすた", "screen_name": "ta_02ss", "avatar_url": "https://pbs.twimg.com/profile_images/1495948616623538177/tR1_5Qct.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1201486568243875840/1743427807/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 3397235, "creator": true, "nsfw_acceptable": false, "acceptable": true,