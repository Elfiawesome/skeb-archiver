描きなどがあれば残したままにしていただけると嬉しいです、個人的な解読があればもとても嬉しいです！画像データはpngもしくはpsdだと助かります！\n以上、私の依頼を考慮していただき、ありがとうございました！*ᴗ ᴗ)⁾⁾\n\nhttps://drive.google.com/drive/folders/1K3OP7Pq9HcL28jkeQfaFCAp0T3139VVV?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yywwbbb/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3694893, "client_id": 1389755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a1b45a15/uploads/origins/98ccec6c-dbcd-460e-9fa3-d5d3b99d2e29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6fc9b04237bcd339a4477cbd67dd966", "srcset": "https://si.imgix.net/a1b45a15/uploads/origins/98ccec6c-dbcd-460e-9fa3-d5d3b99d2e29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6fc9b04237bcd339a4477cbd67dd966, https://si.imgix.net/a1b45a15/uploads/origins/98ccec6c-dbcd-460e-9fa3-d5d3b99d2e29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7bad309aa4101071178a13a025dc53f7 2x, https://si.imgix.net/a1b45a15/uploads/origins/98ccec6c-dbcd-460e-9fa3-d5d3b99d2e29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cf929bf0f052554b22ffd47718b188da 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a1b45a15/uploads/origins/98ccec6c-dbcd-460e-9fa3-d5d3b99d2e29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dbcba4dd365a0793517187d56b4d2eac", "srcset": "https://si.imgix.net/a1b45a15/uploads/origins/98ccec6c-dbcd-460e-9fa3-d5d3b99d2e29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dbcba4dd365a0793517187d56b4d2eac, https://si.imgix.net/a1b45a15/uploads/origins/98ccec6c-dbcd-460e-9fa3-d5d3b99d2e29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=954f425d06ec0168e19702a8979af