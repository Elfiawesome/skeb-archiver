": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@y_kotohira/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 59593, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/117c82b1/uploads/origins/bef5a673-c6bd-43a3-9241-5e98c41042f7?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=baa3edb836d330fc528030ae532137d8", "srcset": "https://si.imgix.net/117c82b1/uploads/origins/bef5a673-c6bd-43a3-9241-5e98c41042f7?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=baa3edb836d330fc528030ae532137d8, https://si.imgix.net/117c82b1/uploads/origins/bef5a673-c6bd-43a3-9241-5e98c41042f7?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=f705a26f03e250a169f44894808fc794 2x, https://si.imgix.net/117c82b1/uploads/origins/bef5a673-c6bd-43a3-9241-5e98c41042f7?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=82f0aab7e76d12148157c4aa71d56a33 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/117c82b1/uploads/origins/bef5a673-c6bd-43a3-9241-5e98c41042f7?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=8a7604240c964848e35b67cb26e32605", "srcset": "https://si.imgix.net/117c82b1/uploads/origins/bef5a673-c6bd-43a3-9241-5e98c41042f7?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=8a7604240c964848e35b67cb26e32605, https://si.imgix.net/117c82b1/uploads/origins/bef5a673-c6bd-43a3-9241-5e98c41042f7?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7c04b40fc19c38b5e200139b5072e5a9 2x, https://si.imgix.net/117c82b1/uploads/origins/bef5a673-c6bd-43a3-9241-5e98c41042f7?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ca762eb639e0f84e32ad35793625745d 3x"}, "body": "お疲れ様です。\n\n先日投稿されていたゲームオーバーのイラストがとても好みでしたので、同じシチュエーションでお願いしてもよろしいでしょうか。\n\n・轢かれたカエルのような