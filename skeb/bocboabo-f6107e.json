しい間柄の枠に当てはまっている。 \n淡々としているようで存外繊細だったりする。親しい人からの押しに弱い。  \n\n\n■二人の関係 \n・呼び方：奏「凪々くん」、凪々「父さん」 \n・凪々が幼い頃はお父さんっ子で、奏によく抱きついていた \n・奏は凪々を構いたがるため、頬や手に触れたり抱きしめたりする。凪々は複雑な表情を浮かべつつ、好きにさせている \n・時々二人でホラー映画を観る。基本二人共大きい音に若干驚きはするものの怖がることはなく、最後まで静かに観ている。\n\n\nシチュエーションや構図はお任せいたします！親子間のスキンシップが見られたら嬉しいです！\n\nリクエスト内容が不適切だったり金額が見合わないなどありましたらキャンセルしてください。\nご検討の程よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1KHJVyJKIkwr3iC_o2rF9BPwr8tr5E7Xq?hl=ja", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@bocboabo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 273638, "client_id": 1445862, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0b76a813/uploads/origins/10a6f0d3-b1ee-4b17-96e0-4491c1723f9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91be5d175842b61aebe4b0303226c520", "srcset": "https://si.imgix.net/0b76a813/uploads/origins/10a6f0d3-b1ee-4b17-96e0-4491c1723f9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91be5d175842b61aebe4b0303226c520, https://si.imgix.net/0b76a813/uploads/origins/10a6f0d3-b1ee-4b17-96e0-4491c1723f9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28a1813e2a7235ed49fe58425bc539cf 2x, https://si.imgix.net/0b76a813/uploads/origins/10a6f0d3-b1ee-4b17-96e0-4491c1723f9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b407633bab9ab9cb5765cf2e2295fe2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0b76a813/uploads/origins/10a6f0d3-b1ee-4b17-96e0-4491c1723f9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a4bb976e762e66626c6ec86f6213b7b", "srcset": "https://si.imgix.net/0b76a813/uploads/origins/10a6f0d3-b1ee-4b17-96e0-4491c1723f9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s