nキャラクターコンビの設定と内容はリンク先の画像にあります！二人のコンビが見たいので、10代でも大人でも自由に描いてください。\n絵に条件はありません！ご自由にどうぞ。参考にしたい言葉：海／霧／雲\n今回もお読みいただきありがとうございました！リンクは以下の通りです。\nhttps://drive.google.com/drive/folders/1qTixT1-YcnrKX9EeJuzNSk7-uR3IlERv?usp=sharing\n\nhttps://drive.google.com/drive/folders/1qTixT1-YcnrKX9EeJuzNSk7-uR3IlERv?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kanizousui___/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2003355, "client_id": 1792249, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f4b0b72/uploads/origins/59338c8f-6d98-43bd-bd04-359670eb47af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d958ed43fdedac1c0ec6563256a65e2", "srcset": "https://si.imgix.net/9f4b0b72/uploads/origins/59338c8f-6d98-43bd-bd04-359670eb47af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d958ed43fdedac1c0ec6563256a65e2, https://si.imgix.net/9f4b0b72/uploads/origins/59338c8f-6d98-43bd-bd04-359670eb47af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c9bbaa5381b28b6e25021a3187906891 2x, https://si.imgix.net/9f4b0b72/uploads/origins/59338c8f-6d98-43bd-bd04-359670eb47af?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28ec0e5a8c1749d154ddd95bf4b6937e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f4b0b72/uploads/origins/59338c8f-6d98-43bd-bd04-359670eb47af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72b27ab59b097d4676f44c85b6a0840a", "srcset": "https://si.imgix.net/9f4b0b72/uploads/origins/59338c8f-6d98-43bd-bd04-359670eb47af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=72b27ab59b097d4676f44c85b6a0840a, https://si.imgix.net/9f4b0b72/uploads/origins/59338c8f-6d98-43bd-bd04-359670eb47af