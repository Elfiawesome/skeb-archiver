ご配慮頂けますと幸いです。\n\nお忙しいなか大変恐れ入りますが、ご検討下さいますよう、お願いいたします。\n\nhttps://drive.google.com/drive/folders/1txT9wRhcfThrV92CJxf-VpxFV1psJOyX", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@art_mu/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3185907, "client_id": 3365068, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/522fe7ab/uploads/origins/60bd47c4-a9ea-4382-99a0-692a2d819755?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa3b6169188e3128ca28be5e9ae3bb6c", "srcset": "https://si.imgix.net/522fe7ab/uploads/origins/60bd47c4-a9ea-4382-99a0-692a2d819755?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa3b6169188e3128ca28be5e9ae3bb6c, https://si.imgix.net/522fe7ab/uploads/origins/60bd47c4-a9ea-4382-99a0-692a2d819755?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f576b0c39a73d0be2a0f89ce9cb502f6 2x, https://si.imgix.net/522fe7ab/uploads/origins/60bd47c4-a9ea-4382-99a0-692a2d819755?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4bbee4d64656e39c6d557ebd2536d8c8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/522fe7ab/uploads/origins/60bd47c4-a9ea-4382-99a0-692a2d819755?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94137c21c95b853cb2419abd745d8e3f", "srcset": "https://si.imgix.net/522fe7ab/uploads/origins/60bd47c4-a9ea-4382-99a0-692a2d819755?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94137c21c95b853cb2419abd745d8e3f, https://si.imgix.net/522fe7ab/uploads/origins/60bd47c4-a9ea-4382-99a0-692a2d819755?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eaeb25c94524d84dbdaf5992f2924091 2x, https://si.imgix.net/522fe7ab/uploads/origins/60bd47c4-a9ea-4382-99a0-692a2d819755?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4265ae5cc80f8749a52fc5fa188875da 3x"}, "body": "はじめまして\nＸ(旧Twitter)の方でいつもイラスト拝見させて頂いています。\nSkebを利用するのは初めてなので不手際があったらすみません。。\n\n今回は　夢羽様にリクエストさせていただいたイラストを自分の車に痛車として貼らせて頂きたいと思いリクエストさせていただきました。\n痛車のデザインで使用する部分としてはおそらく全身は入らないと思うので縦構図の場合イラストの上側６，７割に集中すると思います。\n\n\n・依頼内容\n　キャラはにじさんじの石神のぞみさんの初期衣装　\n\n　ポーズ等は、以前描かれていた「100日チャレンジ　38日目」のリゼ様の様な表情で　右向きに落ち着いた雰囲気で耳に髪をかけて座っている感じの構図で描いていただけると嬉しいです！\n\n　可能でしたら小物として先日コラボしていたDinamisの石神のぞみモデルのブレスレットをどこかで織り込ませていただけたらと思います。\n\n　コラボブレスレット\nhttps://dinamis-store.com/items/6683b47fb0a3020211fb0b86\n\nその他細かな部分は夢羽様にお任せしたいと思います！\n\nもしご都合がつけられなければ　キャンセルしていただいても大丈夫です！\nお忙しい中恐れ入りますが、ご検討の程　宜しくお願いいたします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@art_mu/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3185907, "client_id": 1546302, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a55c836c/uploads/origins/198b19e4-a707-46c5-b157-c3739e6fc504?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24952c004bbb7ed6284acc7c54b1d374", "srcset": "https://si.imgix.net/a55c836c/uploads/origins/198b19e4-a707-46c5-b157-c3739e6fc504?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24952c004bbb7ed6284acc7c54b1d374, https://si.imgix.net/a55c836c/uploads/origins/198b19e4-a707-46c5-b157-c3739e6fc504?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=435b5a61ba872ff9b5b5075ddba8ef61 2x, https://si.imgix.net/a55c836c/uploads/origins/198b19e4-a707-46c5-b157-c3739e6fc504?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39ec7905e49e8c5a8ad514224ea3e230 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a55c836c/uploads/origins/198b19e4-a707-46c5-b157-c