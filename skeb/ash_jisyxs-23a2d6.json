net/2bad5618/uploads/origins/8b66cfc6-46c8-4bda-a56d-bdaa09d28f62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=454dce388c49986e8d56e18057a440d6", "srcset": "https://si.imgix.net/2bad5618/uploads/origins/8b66cfc6-46c8-4bda-a56d-bdaa09d28f62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=454dce388c49986e8d56e18057a440d6, https://si.imgix.net/2bad5618/uploads/origins/8b66cfc6-46c8-4bda-a56d-bdaa09d28f62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4f1e5a9e7eb71fc62865d07af672a745 2x, https://si.imgix.net/2bad5618/uploads/origins/8b66cfc6-46c8-4bda-a56d-bdaa09d28f62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc00a4ef966045dadcb998964c12342e 3x"}, "body": "こんにちは。前回は素晴らしい絵をありがとうございました。\n今回は、私のオリジナルキャラクターである「虚澤無為」という女の子の絵をリクエストさせていただきます。\nあしゆ先生がオリジナルキャラクターで描いている、正円の中に魔女さんが描かれている構図で私のオリジナルキャラクターが描かれているのを見てみたいです。\n\n以下はキャラクターの細かい設定です。外見のデザインはURLの絵を参考にしてください。\n15歳の女の子で、華奢な体型で肌の色は薄いです。絶壁です。\nキャミソールっぽい、ノースリーブの白いワンピースを着ています。裾は膝が隠れるほどの長さです。\n足元は裸足です。\n髪の色は黒い髪に水色と朱色のメッシュが入っているイメージです。メッシュの部分は魔法を使うと発光します。\n髪型はぼさぼさのロングヘアで、後ろ髪の長さは腰に届く程度です。\n目はオッドアイで、陰陽図のようなイメージです。\n何かを恐れたり、怯えたりするような表情や態度はしません。\n自分が誘拐した18歳の男の子に好意を抱いていて、彼に依存しています。ヤンデレ気味です。\n万能の力を持つ混沌の魔女、という設定なのでダークでカオスっぽい雰囲気の絵にして頂けると嬉しいです。\n目の光の有無、ハイライトや差し色にデザインとは違う色を混ぜる、衣装のアレンジなどは先生の描きやすいようにしていただいて構いません。\n彼女のイメージカラーである「赤、青、黒」が目立った絵になっていると嬉しいです。\n\nいつも活動を応援しています。よろしくお願いします。\n\nhttps://www.pixiv.net/artworks/111258048", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ash_jisyxs/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 424159, "client_id": 1229035, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51da3043/uploads/origins/21af1513-3323-4e0f-8c6f-796209cafbcd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91492ae