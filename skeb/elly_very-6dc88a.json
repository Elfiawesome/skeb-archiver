rive.google.com/drive/folders/14O3evcYwc7AewEPeyJwDsgUNS6QXiSCx?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@elly_very/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2158426, "client_id": 1524117, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7daa07cf/uploads/origins/6d92a885-a1fd-4ddf-8fe6-492f91e03530?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d5bb4f9511e3988cbd9f0888a706a00", "srcset": "https://si.imgix.net/7daa07cf/uploads/origins/6d92a885-a1fd-4ddf-8fe6-492f91e03530?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d5bb4f9511e3988cbd9f0888a706a00, https://si.imgix.net/7daa07cf/uploads/origins/6d92a885-a1fd-4ddf-8fe6-492f91e03530?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=48a8b85480524d3580909e21320377d6 2x, https://si.imgix.net/7daa07cf/uploads/origins/6d92a885-a1fd-4ddf-8fe6-492f91e03530?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ff00ea3b8653ad33385d9b2422f1f23d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7daa07cf/uploads/origins/6d92a885-a1fd-4ddf-8fe6-492f91e03530?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f33e2b5efb42f49202ee88fc2b074f20", "srcset": "https://si.imgix.net/7daa07cf/uploads/origins/6d92a885-a1fd-4ddf-8fe6-492f91e03530?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f33e2b5efb42f49202ee88fc2b074f20, https://si.imgix.net/7daa07cf/uploads/origins/6d92a885-a1fd-4ddf-8fe6-492f91e03530?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6269ecca55f6a85e2bafc2207b97a4bb 2x, https://si.imgix.net/7daa07cf/uploads/origins/6d92a885-a1fd-4ddf-8fe6-492f91e03530?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7e53d07530ff9befe494285ad632d339 3x"}, "body": "こんにちは、私の創作漫画のキャラをお願いします。\n男キャラか女キャラどちらか一人を選んでお描きください。\n\n■女キャラの場合\n「桜（サクラ）」を描いてください。\n\n前髪は目が隠れるぐらい長いが頭の上で結んでおでこを出してもどっちでも可です。\n衣装はカスタマイズしてもらってもかまいません。\n\nビジュアルの資料は以下です↓\nhttps://twitter.com/SakumaGinmaru/status/1574735461817659393\n\nこのキャラが出てくる漫画の回は以下です↓\nhttps://manga-no.com/episodes/105b36c1baf95ef6064\n※読まなくてもどちらでもよいですがどんなキャラなのかの参考に必要でしたらどうぞ。\n\n■男キャラの場合\n十七夜（かなぎ）を描いてください。\n\nキャラの特徴↓\nふわふわ金髪ロン毛で後ろで軽く結っている、三白眼、ギザ歯、右頬に傷、右腕がない、やせ型\n\nキャラの三面図資料の載っているページ↓\nhttps://sakuma-ginmaru.fanbox.cc/posts/3600156\n\n悪い表情でかっこよく描いてもらえると嬉しいです。\n細かいシチュエーションは申し訳ないのですが思いつかないのでお任せします。\n羽織や細かい装飾は大変そうなら省略しても大丈夫です。\n\n−−−−−−−−\n\n描いて頂いたイラストは自分のブログ等に掲載させていただく場合があります。\n\nどうぞよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@elly_very/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2158426, "client_id": 154813, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5f57e06e/uploads/origins/f92c7758-8c0d-416f-a90d-9e51d62c0def?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1700fae3daebbf6becfd12df3bcecbd3", "srcset": "https://si.imgix.net/5f57e06e/uploads/origins/f92c7758-8c0d-416f-a90d-9e51d62c0def?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1700fae3daebbf6becfd12df3bcecbd3, https://si.imgix.net/5f57e06e/uploads/origins/f92c7758-8c0d-416f-a90d-9e51d62c0def?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a263cba529afba5cf75752701e3030d3 2x, https://si.imgix.net/5f57e06e/uploads/origins/f92c7758-8c0d-416f-a90d-9e51d62c0def?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0a3c458095b9b1f5e9aaa0cb1576b77b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5