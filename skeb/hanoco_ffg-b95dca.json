tshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d5de08df18415e6d72c534519fc8a673 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2027371, "nc": 128}, {"path": "/@hanoco_ffg/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2027371, "client_id": 2814803, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d8f5cf47/uploads/origins/4b97586e-7808-4879-90ec-131b04153a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8d9f99b4db3cfbfe32e3e9559bfa3b1", "srcset": "https://si.imgix.net/d8f5cf47/uploads/origins/4b97586e-7808-4879-90ec-131b04153a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8d9f99b4db3cfbfe32e3e9559bfa3b1, https://si.imgix.net/d8f5cf47/uploads/origins/4b97586e-7808-4879-90ec-131b04153a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf33924a72c80e6bc61b83b53777a47d 2x, https://si.imgix.net/d8f5cf47/uploads/origins/4b97586e-7808-4879-90ec-131b04153a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8e6bdd17ca3883a0ef9e2c4d0b2c4b50 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d8f5cf47/uploads/origins/4b97586e-7808-4879-90ec-131b04153a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06679eb17a5ca8fe15ff1b8d0fcfb6d0", "srcset": "https://si.imgix.net/d8f5cf47/uploads/origins/4b97586e-7808-4879-90ec-131b04153a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06679eb17a5ca8fe15ff1b8d0fcfb6d0, https://si.imgix.net/d8f5cf47/uploads/origins/4b97586e-7808-4879-90ec-131b04153a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c015f7ff378c5de4112158af79482ecb 2x, https://si.imgix.net/d8f5cf47/uploads/origins/4b97586e-7808-4879-90ec-131b04153a1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3d7c6038114fbc39d9354bceacef9b88 3x"}, "body": "淡野ﾉﾑさま\n\n初めまして。skebの新着でイラストをお見かけし、一目惚れしました。\nXに掲載されている作品も拝見しましたが、構図の取り方や小物の配置、シンプルかつ正確な線、バランスの良い配色が眺めていてとても心地よいです。どの作品もまるで洋画のポスターのようで魅力を感じます。\nぜひ、オリジナルキャラクターのイラストを描いていただきたく、リクエストお送りいたしました。\n\n【依頼内容】\nオリジナルキャラクターのイラスト\n\n【使用目的】\n観賞用、可能であればグッズ作成（個人用）\n※個人のSNSアカウントに、依頼した作品として掲載させていただく場合がございます。\n\n【キャラクター】\n以下が参考資料になります。\n\nhttps://drive.google.com/drive/folders/1ihczdCfE7Wau622DW08Clf6dcjz7nB_Q?usp=sharing\n\nTRPGで使用している探索者です。性別は男。年齢は12〜14歳程度をイメージ。\n宮沢賢治作品、特に「銀河鉄道の夜」「春と修羅」をモチーフにしたキャラクターです。\n趣味は読書、天体観測、鉱物収集。口数は少なめで、表情豊かな方ではありません。\n\nイメージカラー：寒色\nモチーフ：銀河鉄道の夜\nイメージソング：カムパネルラ/米津玄師、スターライト/amazarashi\n\n【イラスト】\n・服装や小物の細部などは、描きやすいよう、省略・アレンジしていただいて構いません。\n・もし可能であれば、どこかしらに宇宙や夜空、星の要素を感じさせる描写があると嬉しいです。\n・淡野ﾉﾑさまの画作りのセンスが大好きなので、構図や色合いなどはすべてお任せいたします。\n\n【納品形式】\npsd形式で、人物と背景を分けていただけますと幸いです（可能な範囲で構いません）。\n\n上記の内容でご検討いただけますと幸いです。よろしくお願いいたします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hanoco_ffg/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2027371, "client_id": 3206450, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac9d2688/uploads/origins/07e59212-4cf8-4fef-92e4-75caf88a1fe3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43e8fda2971487fce34f693dd9d1fa2b", "srcset": "https://si.imgix.net/ac9d2688/uploads/origins/07e59212-4cf8-4fef-92e4-75caf88a1fe3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=43e8fda2971487fce34f693dd9d1fa2b, https://si.imgix.net/ac9d2688/uploads/origins/07e59212-4cf8-4fef-92e4-75caf88a1fe3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1fd426d0f2e75ecc717e10bd439aa5c 2x, https://si.imgix.net/ac9d2688/uploads/origins/07e59212-4cf8-4fef-92e4-75caf88a1fe3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bfb3a9c099fe1dd4edc47370323a6d97 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac9d2688/uploads/origins/07e59212-4cf8-4fef-92e4-75caf88a1fe3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c509cde7131728e066af7b4abf165e2e", "srcset": "https://si.imgix.net/ac9d2688/uploads/origins/07e59212-4cf8-4fef-92e4-75caf88a1fe3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c509cde7131728e066af7b4abf165e2e, https://si.imgix.net/ac9d2688/uploads/origins/07e59212-4cf8-4fef-92e4-75caf88a1fe3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3996da440a71343ba3ca9b6a7c9d332f 2x, https://si.imgix.net/ac9d2688/uploads/origins/07e59212-4cf8-4fef-92e4-75caf88a1fe3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4f08c54af0fa5b199bf68f21bc23d6d1 3x"}, "body": "はじめまして。IRIAMで配信をする予定の砂々芽と申します。\n淡野様のスッとしてるのにどこか素朴な味わいのする線と、イラスト全体の雰囲気が大好きでリクエストを送らせていただきました。\nずっとリクエストを送りたかったのですが、何を描いていただこうか迷っていまして、この度立ち絵を得て依頼できることが本当にうれしいです！\nご検討いただければ幸いです。\n\n▶依頼内容\n砂々芽のイラスト\n\n構図や表情はお任せいたします。\n\n・サムネイルやSNSに使用させていただきたいので、人物と背景を分けていただけるとありがたいです。\n・頭や髪の毛、手などが途切れていないと大変助かります。\n\n▶資料\nお手数ですが、イラストの参考資料は下記URLからご確認ください。\nhttps://drive.google.com/drive/u/0/folders/12r7F8HdZkyWlEEI3SM1ra2ofm4cM-OQJ\n\nTwitter : https://twitter.com/sazame_iriam\n\n▶使用する可能性のある用途\n・IRIAMの配信サムネイル\n・各種SNSアイコン\n・SNS上での配信宣伝画像\n可能でしたら使用させていただきたいもの\n・ファンの方への壁紙配布(個人観賞用として配布)\n・収益の伴わないネットプリント\n（使用がNGの用途がありましたら納品ファイルの方に記載していただければと思います。グッズなどには使いません）\n\n慣れていないリクエストで、依頼内容に問題などがありましたら申し訳ございません。\nお忙しいとは存じますが、ご検討いただけますと幸いです。\n宜しくお願い致します！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hanoco_ffg/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/11788eb7/uploads/origins/83979a58-9137-4d03-84d5-93dd5c7dab79?bg=%23fff&auto=format%2C