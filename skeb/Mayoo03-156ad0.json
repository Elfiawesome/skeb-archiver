.net/64d47ac8/uploads/origins/410269be-00ad-46ac-96ef-953aad7f7445?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fda93445a5b36687dedb2a2846bc2c51 3x"}, "body": "こんにちは。先日は素敵な圭ちゃんをありがとうございました。今回はのんのんびよりのんすとっぷ3話終盤の「夕暮れの中夏海をおんぶして帰るひかげ」の場面をMayooさんの絵柄で背景付きでお願いします。画像比率やサイズに指定はありません。構図も、アニメと同じでも同じじゃなくても大丈夫です。自由に描いていただければ幸いです。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Mayoo03/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2610931, "client_id": 3985909, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4b51368/uploads/origins/2c158cb4-08d9-462d-8296-4383f42b4d1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fabb2f9456b3b0e7b38c2c669115429a", "srcset": "https://si.imgix.net/f4b51368/uploads/origins/2c158cb4-08d9-462d-8296-4383f42b4d1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fabb2f9456b3b0e7b38c2c669115429a, https://si.imgix.net/f4b51368/uploads/origins/2c158cb4-08d9-462d-8296-4383f42b4d1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c690302b1082faac82bd2f61945d2905 2x, https://si.imgix.net/f4b51368/uploads/origins/2c158cb4-08d9-462d-8296-4383f42b4d1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=47a8739ef4fa2339345ba4a7d5768d21 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4b51368/uploads/origins/2c158cb4-08d9-462d-8296-4383f42b4d1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=626d9568059f6f325e8ff156913787d0", "srcset": "https://si.imgix.net/f4b51368/uploads/origins/2c158cb4-08d9-462d-8296-4383f42b4d1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=626d9568059f6f325e8ff156913787d0, https://si.imgix.net/f4b51368/upload