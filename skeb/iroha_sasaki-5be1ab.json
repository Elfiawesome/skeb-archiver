&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fad2a803f9b80f0a22f1a1c00c17655d 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1602490594932461568%2FOxXco-Jm.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=edc29f3a1db12001af93692ff2fb67b0 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/9b975d4f-3130-4d48-adc4-db1f544d4f73?response-content-disposition=inline&Expires=1780677031&Signature=lJWHSSNCDP8rYd4dcbVZODVYutTNLyL5wo80g68kgO5nG5r47MvohNC7Ny10YEA4VDHhcY-n62r7GB-VgDY~q8Su~lmyTqVq-J-hMyU-en4UAXxOJKzin5C7MF3-RdZSAwYKDYiNnW-Gwr02t5ZSiMAiHDGv0SwotxR7GewliaMmUrBKxuw9i~UfWbuzfUo8tUNFeMb3vSu4Xj6wl7mKZaME~hMkOBmia6cX884XiiAJkkCV8QmQehpPUqPiXpy3f9O1mfnnDwGEL-VTyZ9rEqgxv3umB~GC-lZlbe9cZ~lSdo8HAWTmxX5hrrVWv~ElK~f7cikWBaQC5TwvJI5ACg__&Key-Pair-Id=K1GS3H53SEO647", "duration": 325, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1602490594932461568%2FOxXco-Jm.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=547e07b4c38f3cf833e6f85b78de0a42", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1602490594932461568%2FOxXco-Jm.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=547e07b4c38f3cf833e6f85b78de0a42, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1602490594932461568%2FOxXco-Jm.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=928f1866a51d0f0580933fcbdb846619 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1602490594932461568%2FOxXco-Jm.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3463c1829abeb24f034ec4fba2fa4ca6 3x"}, "body": "はじめまして…！母語の英語のほうで創作小説を書いているものですが、学生時代から”炉心融解”が大好きな曲で、まさかこうしてスケブを開設してると知った時以来先生にリクエストするのを心待ちしておりました。\n\nもし良ければうちの子(創作キャラ)のヴァスカのイメージで水中を浮かんでいるような心地の良さと、深淵を思わせるほんのりと神秘的でミステリアスな色を合わさった曲をリクエストしたいです。\n\n既存の曲に例えると”Beyond where you gaze”と”三鳥夭夭”のようなダウンテンポで少しダークな雰囲気が望ましいです…！\nどれも大変素敵で好きな曲たちなのですが、どちらかと言えば和の色が強い”三鳥夭夭”よりも、”Beyond where you gaze”がよりこちらの理想に近い例かもしれません。\n\nまた、ご参考になりうるかは分からないのですが、先生の”アルビレオ”の編曲の涼しいテクノサウンドもとても好きです。\n\n最後の参考URLにイメージプレイリストを挙げさせていただいていますが、あくまでも大まかな雰囲気の参考までにと思っていただければ幸いです。先生のセンスを全面的に信じます。\n\n【キャラ詳細】\nキーワード：忘却の水、無限ループ、冥界の川レテ\n\nミステリアスな雰囲気を纏う魔術師の青年。自らの研究を経て神秘を体現する存在でもある。\n魔術の代償として常に記憶喪失状態にあって、一日の記憶がそのまま毎日リセットされる体質となっています。\nギリシャ神話ではレテという冥界の川があって、楽園（エリュシオン）にたどり着く前の最後越えなければならないものです。ヴァスカの脳脊髄液は少年時代に自らの研究でレテの”忘却の水”に作り替えられていて、就眠するとその水が魂を洗って再新してリセットするので、常に白紙状態のような魂を保つ。客観的な知識こそ失われないが、個人としての記憶はまっさらに戻ります。\n\n”記憶することは、自分の外にあるものを認識し受け入れ、自分の一部にすること”と考え、彼の独特の魔術理論を実現するためにはこれを拒絶して内側と外側を断界しなければならなかった。\n\n目が覚める時には、あらかじめ一定数の情報を元に再構築されています。過程や結果的にはパソコンやスマホをファクトリーリセット（工場出荷状態に戻す）のようなものです。初期設定や稼働には必要なものこそ残っていても、個人で保存したデータなどは全部飛んでいる感じです。\n\n---\n\nイメージする際の手助けになれるかは分からないのですが、キャラクターのビジュアルはこちらでご覧いただけます。\n\nhttps://drive.google.com/drive/folders/1LqmdSSaKda3BjIfUtjQu9ZAbca_721P9?usp=drive_link\n\n長々と失礼いたしました。お手隙の際にご検討のほどどうぞよろしくお願いいたします…！\n\nhttps://www.youtube.com/playlist?list=PL6U619ZiWbMB6eVfQkN0WKs2EWCQblkP3", "nc": 145, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}, {"path": "/@iroha_sasaki/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": false, "creator_id": 668870, "client_id": 2179785, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1602490594932461568%2FOxXco-Jm.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=142fb90fbe50477e8e40e48de596bd65", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1602490594932461568%2FOxXco-Jm.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=142fb90fbe50477e8e40e48de596bd65, https://sk