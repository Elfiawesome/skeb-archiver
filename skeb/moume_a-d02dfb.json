83c-aa5e-6c8a255b7511?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af672a52c1edbd06ac2787be4c72734e, https://si.imgix.net/06082491/uploads/origins/6af9f325-cc0b-483c-aa5e-6c8a255b7511?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9007a7decd3e09cd880252988886011b 2x, https://si.imgix.net/06082491/uploads/origins/6af9f325-cc0b-483c-aa5e-6c8a255b7511?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c6851ec6797c5ae3da82192671bb2926 3x"}, "body": "はじめまして。\n今回描いていただきたいキャラクターは、アークナイツのキャラクターです。\nレミュアンもしくはルシーラのどちらかもしくは両方の、描きやすいのを選んで描いてください。\nレミュアンの場合服装は昇進2のイラストのものを希望します。その他はおまかせします。\n使用用途としてSNSのアイコン等で使わせて頂く場合があります。ご検討の程よろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@moume_a/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3724130, "client_id": 1231709, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ca6b01eb/uploads/origins/0e2f42b4-ca7c-4f8b-82a8-5dc7447da071?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b0871abc1ee75825ec42b71a7534c4c", "srcset": "https://si.imgix.net/ca6b01eb/uploads/origins/0e2f42b4-ca7c-4f8b-82a8-5dc7447da071?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b0871abc1ee75825ec42b71a7534c4c, https://si.imgix.net/ca6b01eb/uploads/origins/0e2f42b4-ca7c-4f8b-82a8-5dc7447da071?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c1b286d078a7fd18b0be5dfc7abcfec 2x, https://si.imgix.net/ca6b01eb/uploads/origins/0e2f42b4-ca7c-4f8b-82a8-5dc7447da071?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fe0ecd58e501e8bf21d1c4aece511b25 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca6b01eb/uploads/origins/0e2f42b4-ca7c-4f8b-82a8-5dc7447da071?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=896f2ab108569d31d31b980e95516c48", "srcset": "https://si.imgix.net/ca6b01eb/uploads/origins/0e2f42b4-ca7c-4f8b-82a8-5dc7447da071?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=896f2ab108569d31d31b980e95516c48, https://si.imgix.net/ca6b01eb/uploads/origins/0e2f42b4-ca7c-4f8b-82a8-5dc7447da071?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=13235ecbe6fb5691eb07129eb6a523ad 2x, https://si.imgix.net/ca6b01eb/uploads/origins/0e2f42b4-ca7c-4f8b-82a8-5dc7447da071?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5403917e1ffa4ce11715d300d8396c76 3x"}, "body": "はじめまして。アークナイツのイラストが素敵で、画風がとっても好みなのでリクエストさせてください。\n描いていただきたいのは私がVRChatで使用しているアバターです。\n\n・キャラクターのイメージ\n吸血鬼+龍のイメージで、少し人外感のあるキャラクターです。\nクールな印象を纏っていますが、そこそこ表情豊かです。\n\n・キャラクターの特徴\n髪：頭の頂点から毛先にかけて茶色→金色→白へと変化するグラデーション(前髪は茶色→金色のみ)\n目：ジト目気味 / 外側から中心にかけて明るくなる赤い瞳 / 瞳孔の周りに二重の環\n目元：目の下側に放射状のフェイスペイント\n暗所では瞳・角・ヘッドフォンの赤色が光ります。\n\n・参考資料\nhttps://drive.google.com/drive/folders/1C3qQoeDCskoeFT0hgQXxD8b9v4GH7uvn?usp=drive_link\n↓衣装\nhttps://drive.google.com/drive/folders/1--PaUCUhbsVgZ7inlqM-WgzP99g6FfhG?usp=sharing\n※他により描きたい衣装があればそちらでも大丈夫です。\n\n・イラストへの要望\n簡易的なもので構いませんので、何か背景があると嬉しいです。 \nその他のポーズ・構図やシチュエーション等はお任せいたしますが、目が特徴的なため顔がしっかりと映えるようにお願いしたいです。\n\nPSDファイルはキャンバスサイズ大きめ(フルHD以上)で、レイヤーが分かれていると助かります。\n (キャラクター/背景/サイン　など)\n\n・使用用途 \nSNSやVRChatのアイコン・サムネイル、PC・スマホの壁紙等の私的利用(非商用)\n\n何か問題がございましたら差し戻し下さい。\nご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1--PaUCUhbsVgZ7inlqM-WgzP99g6FfhG?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@moume_a/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3724130, "client_id": 714016, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e