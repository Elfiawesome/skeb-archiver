1S9XfHMj6CwhYGQrozERWh8_qbVojyqU2?usp=drive_link\ncp属性としては不良×真面目委員長になります。\n\nお引き受けして頂けるようでしたら、adyharu先生のご負担がないよう簡略化など…調整して描いてくださって構いません。（チェックや靴の柄など、細かい部分は全く一緒でなくて大丈夫です）\n構図は特に指定はありません。お任せになってしまって申し訳ないのですが、どうぞ宜しくお願い致します…！\n\nまた、個人的なグッズの製作（アクスタなど）などに使用したいと考えておりますので、可能であれば背景が透過されたデータも頂けますと幸いです。\n\nご縁がありましたらうちの子二人を描いていただけたら幸いです！\nご検討のほどよろしくお願いいたします…！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aminbo_san/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 686854, "client_id": 2301741, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/46aa5476/uploads/origins/f5f858cf-2aad-4c36-8331-4f92baf90eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=305289088e37eff77a838fe985c74f74", "srcset": "https://si.imgix.net/46aa5476/uploads/origins/f5f858cf-2aad-4c36-8331-4f92baf90eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=305289088e37eff77a838fe985c74f74, https://si.imgix.net/46aa5476/uploads/origins/f5f858cf-2aad-4c36-8331-4f92baf90eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=604b732c9f0e1abbc4a69fb07b2f800d 2x, https://si.imgix.net/46aa5476/uploads/origins/f5f858cf-2aad-4c36-8331-4f92baf90eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e455df06420c8543162932b06325ad25 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/46aa5476/uploads/origins/f5f858cf-2aad-4c36-8331-4f92baf90eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75d09c844002343979255343d531a49a", "srcset": "https://si.imgix.net/46aa5476/uploads/origins/f5f858cf-2aad-4c36-8331-4f92baf90eb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75d09c844002343979255343d531a49a, https://si.imgix.net/46aa5476/uploads/origins