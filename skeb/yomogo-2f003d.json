た人間に対しては面倒見がいい。\n顔はそこそこ整ってはいるが、言葉が「お前がいいなら俺は構わん」「いい加減にしろ」と言った強めの口調なので接する人間は選びがち。\nまた、戦闘に関してもかなりの手練で愛用武器はマチェット。あまり戦いたがらない割にいざ戦闘に入ると確実に息の根を仕留めるタイプ。\n\n服装は時代背景を鑑みてトレンチコートとかかなあと思っていますが、構図や服装の細かいところについては基本的によもごさんにお任せ致します……！\n\n\n料金不足や不備等ございましたらお手数ですが差し戻しいただければと思います。ご縁がありましたら何卒よろしくお願いします……！\n\n参考資料のリンク貼り付けておきます。何卒よろしくお願いします🤍\n\nhttps://drive.google.com/drive/folders/10LYi6LddDhQg6f0CGnf87R7AGD_9xfOT", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 985061, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ちかみつ", "screen_name": "chikakostars", "avatar_url": "https://pbs.twimg.com/profile_images/1702034247861813249/eN9Q95hA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1015974395938914304/1788503025/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 22, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 1844279, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "平安. ᵗ ᵒ ᵐ ᵃ ᵗ ᵒ", "screen_name": "heiantomato", "avatar_url": "https://pbs.twimg.com/profile_images/1851114963341017088/uAgC75Lz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1252937639352610816/1727544542/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 2245355, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "透子", "screen_name": "to_trpg_ko", "avatar_url": "https://pbs.twimg.com/profile_images/1936357854534860800/4X_NubDe.jpg", "header_url": "https://pbs.twimg.com/profile_banners/14843719976481