rive.google.com/drive/folders/1UswAoLGgghodorhRhcVzRukTpkTKHey7?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yomogo/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1245605, "client_id": 2755750, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3af882f0/uploads/origins/ee59a483-5c51-4fcc-9eda-81ca08b1fbfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=026b1c7afe48692706a4b19da412b630", "srcset": "https://si.imgix.net/3af882f0/uploads/origins/ee59a483-5c51-4fcc-9eda-81ca08b1fbfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=026b1c7afe48692706a4b19da412b630, https://si.imgix.net/3af882f0/uploads/origins/ee59a483-5c51-4fcc-9eda-81ca08b1fbfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1f80e70c891a48b39cdd380187237072 2x, https://si.imgix.net/3af882f0/uploads/origins/ee59a483-5c51-4fcc-9eda-81ca08b1fbfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=af4cedd7786e62253713634cebc66f7e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3af882f0/uploads/origins/ee59a483-5c51-4fcc-9eda-81ca08b1fbfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06a67606c62657fa388f8b891c58c965", "srcset": "https://si.imgix.net/3af882f0/uploads/origins/ee59a483-5c51-4fcc-9eda-81ca08b1fbfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06a67606c62657fa388f8b891c58c965, https://si.imgix.net/3af882f0/uploads/origins/ee59a483-5c51-4fcc-9eda-81ca08b1fbfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8281c381dd021e19f5f1d228112fcb00 2x, https://si.imgix.net/3af882f0/uploads/origins/ee59a483-5c51-4fcc-9eda-81ca08b1fbfd?bg=%23fff&auto=format%2Ccompress