tJJGMJtN-Waw?rlkey=1yyjxly9pbas7a7p83d23dy17&st=qflqj1x1&dl=0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@karakuririnngo/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2147827, "client_id": 880066, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f398d707/uploads/origins/638d1f5e-ce88-4cfc-a3c0-23aa41ec7602?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e72f51d89889914236cfd4a60a80c69", "srcset": "https://si.imgix.net/f398d707/uploads/origins/638d1f5e-ce88-4cfc-a3c0-23aa41ec7602?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e72f51d89889914236cfd4a60a80c69, https://si.imgix.net/f398d707/uploads/origins/638d1f5e-ce88-4cfc-a3c0-23aa41ec7602?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34e707a2b26d6c2e97e6a0d6d29c5a1f 2x, https://si.imgix.net/f398d707/uploads/origins/638d1f5e-ce88-4cfc-a3c0-23aa41ec7602?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad4f0e1cd581c29bd04acc12aca49976 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f398d707/uploads/origins/638d1f5e-ce88-4cfc-a3c0-23aa41ec7602?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bda3321f565485c9670b79e25c778fc", "srcset": "https://si.imgix.net/f398d707/uploads/origins/638d1f5e-ce88-4cfc-a3c0-23aa41ec7602?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bda3321f565485c9670b79e25c778fc, https://si.imgix.net/f398d707/uploads/origins/638d1f5e-ce88-4cfc-a3c0-23aa41ec7602?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0c4269408a75f40acda318983137939e 2x, https://si.imgix.net/f398d707/uploads/origins/638d1f5e-ce88-4cfc-a3c0-23aa41ec7602?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2d833263416ca9442f54d544ae0d25ad 3x"}, "body": "はじめまして、こんにちは。\n大変イケてるお顔が目に入ったので投げさせて頂きました。\nもしよろしければ私のOCを描いていただけないでしょうか。\n\n＜依頼内容＞\n○描いていただきたいOCについて：\n私の別のOC、紅眼白髪猫耳の女の子に瓜二つな化け物です。\n容姿が瓜二つで白髪くせっ毛、雨でも無いのにボワボワ広がって髪の毛は白なのに耳部分は黒。\n身長160cm。\n容姿の詳細は資料URLをご確認いただければと思います。\n\n◯OCの設定等：\n名前：那由多(ナユタ)\nヒトガタだが、化け物。\nその姿から限りなく人に近いようだが、実際は似て非なる凶悪な化け物である。\n元のOCが感情が表に出づらい性格に対し、真逆であり感情が表に出やすく非常にお喋り。好戦的で攻撃的。\n人間や動物、その他生き物は道端の石ころ・眼の前を飛ぶ虫、不愉快な障害として無意識に認識しており、少しでも気に触れると両腕や足等、黒く変異させたモノで払い落とす（その場には肉片と血しぶきしか残らないため吹き飛ばすほうが正しいかもしれない）。\nそれ故に人間でいう論理感や常識は持ち合わせてない。\n常時ニヤニヤと笑い、敵対ないし戦闘時は大口を開けて笑っているが感情として笑っているのではなく一つの行動の一環として笑っており、感じるということについて非常に疎い、というよりも何も感じていない。\n全身に返り血を浴びようが血肉にまみれようが気にしない。体の半身が無くなろうと彼は動き続ける。\n目に入ったモノに対し反射で動く節もあり、その根源は実に野性的であり生物の深淵そのもの。\nおしゃべりなのは話すのが好きということではなく、思考している内容がそのまま言葉としてでているだけ。感情が表にでやすいのもそのためである。\n本人は私やボクと言う。名前が付与されているのは知っているが自らは呼称しない。\n\n○衣装について：\n黒シャツ、白スーツに赤ネクタイ、両手に黒手袋を着用していますが、必要であれば簡略化していただいて構いません。\n\n◯イラストイメージ・構図・サイズ等：\n構図、サイズは問いません。\n\n対応不可と言う事であればキャンセルして頂いて構いませんので、ご検討いただければと思います。\n\nhttps://drive.google.com/drive/folders/1YWJDf7tf6vWXIModfabn_xUUWu483Y1Z?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@karakuririnngo/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2147827, "client_id": 3167825, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a2e8e858/uploads/origins/51355089-da6c-4f82-9229-165b237cd0b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=528ce48452d82a58ee9e70f30792c20f", "srcset": "https://si.imgix.net/a2e8e858/uploads/origins/51355089-da6c-4f82-9229-165b237cd0b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=528ce48452d82a58ee9e70f30792c20f, https://si.imgix.net/a2e8e858/uploads/origins/51355089-da6c-4f82-9229-165b237cd0b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=900cb