sfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@lomii_f/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 968190, "client_id": 73101, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5fb8e096/uploads/origins/e5e020b6-ba9c-4b3a-9272-3389b240e9a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f647e23217ac947719d81c6ae4ce6e3e", "srcset": "https://si.imgix.net/5fb8e096/uploads/origins/e5e020b6-ba9c-4b3a-9272-3389b240e9a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f647e23217ac947719d81c6ae4ce6e3e, https://si.imgix.net/5fb8e096/uploads/origins/e5e020b6-ba9c-4b3a-9272-3389b240e9a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=92fcc3e710facadd8cd20fbef4829190 2x, https://si.imgix.net/5fb8e096/uploads/origins/e5e020b6-ba9c-4b3a-9272-3389b240e9a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f99df97d668c3ac2450ef3d40723c47 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5fb8e096/uploads/origins/e5e020b6-ba9c-4b3a-9272-3389b240e9a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d18cb0c8d52202e742928d9c8f6c99e6", "srcset": "https://si.imgix.net/5fb8e096/uploads/origins/e5e020b6-ba9c-4b3a-9272-3389b240e9a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d18cb0c8d52202e742928d9c8f6c99e6, https://si.imgix.net/5fb8e096/uploads/origins/e5e020b6-ba9c-4b3a-9272-3389b240e9a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=40845b25eca2c0c47e9c2e0fff0eda15 2x, https://si.imgix.net/5fb8e096/uploads/origins/e5e020b6-ba9c-4b3a-9272-3389b240e9a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=327023ff30f1f2ebe75bd1c42cbdd0f4 3x"}, "body": "このチャンスを逃すわけには…！ということでリクエストを送らせていただきます。\n\nまおりちゃんやみぞれさんはlomiiさんの考えてらっしゃるネタがあるかと思いましたので、\n完全別キャラでのシチュをリクエストさせていただこうかと思いました。\n\n主題は『思春期ふたなりっ娘２人のおちんちん比べ』です。\n\n学校の人気のない場所でのおちんちん比べ。\n\n２人の関係性は幼馴染ですが、お互いのおちんちんは幼少期にしか見た記憶はない。\n思春期になった今、お互いのを見せ合ってみようというシチュ。\n\n１人（仮にAちゃん）は小柄で童顔、少しぽっちゃり、おっとりふわふわとした、普段の姿では性的に成長している印象がほとんど感じられない雰囲気の女子。\nもう１人（仮にBちゃん）は思春期相応のスタイルのごくごく平均的な女子。\n\n実はAちゃんはおちんちんに関しての経験的なものが一般的なふたなりっ娘より「色々な事情」により、この年齢としてはとても経験豊富な状態となっており…という裏設定。\n\n１コマ目：お互いに見せ合ってみようという場面。お互いにスカートをまくり上げようとしている。ショーツはヒザ下まで既に下ろしている状態。（可能であればワイプで双方の幼き日の平常時おちんちんの姿があったりすると最高です）\n\n２コマ目：お互いスカートをまくり上げ、双方の現在のおちんちん（勃起していない平常時の状態）がご開帳。\n◆Aちゃん：年齢と普段のその見た目と雰囲気からは想像できない、同年代平均サイズより大きめサイズ。皮が剥け切って亀頭が完全に露出したおちんちん。カリ下に下がった皮の余りも平常時なのにほとんど余りがないほどになっている。亀頭もしっかり張り出し丸みを帯び、カリ首の段差も高い。そして何故か全体的に浅黒い。玉も同年代平均より大きめずっしり。\n◆Bちゃん：思春期相応のサイズと剥け具合、色味etcの平均的なおちんちん。\n\nAちゃんは特に誇らしいような表情をするわけでもなく、むしろBちゃんのおちんちんを見て「Bちゃんのおちんちん、女の子らしくていいなぁ…。わたしの、色々あってこんなになっちゃったから…。」と羨ましがる。\nBちゃんはただただ茫然。\n\n※勃起差分は可能でしたら…！\n\nもしお受けいただける際は、希望は書きましたが細かい部分は好きに調整してくださって大丈夫です。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@lomii_f/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 968190, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de269bc8/uploads/origins/fe313ee4-03c8-4b0d-a925-be730e27e738?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91b6c231fe0c1fa833fbcd32008635d8", "srcset": "https://si.imgix.net/de269bc8/uploads/origins/fe313ee4-03c8-4b0d-a925-be730e27e738?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91b6c231fe0c1fa833fbcd32008635d8, https://si.imgix.net/de269bc8/uploads/origins/fe313ee4-03c8-4b0d-a925-be730e27e738?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8620e885e7de1c247f918d9edd04b39 2x, https://si.imgix.net/de269bc8/uplo