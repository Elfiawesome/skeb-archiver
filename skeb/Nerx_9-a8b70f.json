uto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa6c593b7cb74f3b5b3509bd4c51994e, https://si.imgix.net/dfc2a037/uploads/origins/818abb7d-41d3-48ad-9300-ade678e106a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f9490a22a68f0a57503eef461ce1cc23 2x, https://si.imgix.net/dfc2a037/uploads/origins/818abb7d-41d3-48ad-9300-ade678e106a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3ea3736a93f144304d18dcb375bf9b60 3x"}, "body": "愛する練習曲〜！！！\nあなたのイラストが大好きです！そして大尊敬しています！\nあなたが描く私のOCのフィルレイアを見たくて今回連絡させていただきました！\n黒髪長髪(腰元まで伸びている)片手剣使いで将来氷の魔剣を手にする男…\n感情表現が顔に出にくいので冷たげな印象があります！\nただ可愛い妹に対して少し頬を緩ませるような一面も…\n雰囲気やアートスタイルは全てお任せします！あなたのセンスを全面的に信用しています！！！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nerx_9/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2639981, "client_id": 2389245, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/826f7a58/uploads/origins/b5f71a6d-ff04-4ff8-b8bc-e49253d1469e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=563eb7b07ce378b7b693ce079271e8dc", "srcset": "https://si.imgix.net/826f7a58/uploads/origins/b5f71a6d-ff04-4ff8-b8bc-e49253d1469e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=563eb7b07ce378b7b693ce079271e8dc, https://si.imgix.net/826f7a58/uploads/origins/b5f71a6d-ff04-4ff8-b8bc-e49253d1469e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=674c793c0dee5f54e1f9148b25b0e3ab 2x, https://si.imgix.net/826f7a58/uploads/origins/b5f71a6d-ff04-4ff8-b8bc-e49253d1469e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a3bb76fe9123e54e0192ea4aebe87731 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/826f7a58/uploads/origins/b5f71a6d-ff04-4f