, "srcset": "https://si.imgix.net/cfc16e9b/uploads/origins/f3dc756c-3d9b-4159-960e-8627dc232f52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d824a093293f05564ec34a6696fe554c, https://si.imgix.net/cfc16e9b/uploads/origins/f3dc756c-3d9b-4159-960e-8627dc232f52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=43e92840607c4581b5661c15bfbc84ab 2x, https://si.imgix.net/cfc16e9b/uploads/origins/f3dc756c-3d9b-4159-960e-8627dc232f52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b753c6867b093b69ef506f2b336110ea 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cfc16e9b/uploads/origins/f3dc756c-3d9b-4159-960e-8627dc232f52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be306f7469b1886f9673a0b7e3a06583", "srcset": "https://si.imgix.net/cfc16e9b/uploads/origins/f3dc756c-3d9b-4159-960e-8627dc232f52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=be306f7469b1886f9673a0b7e3a06583, https://si.imgix.net/cfc16e9b/uploads/origins/f3dc756c-3d9b-4159-960e-8627dc232f52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d5075992a5a3cb2f888e65aca5c3e14f 2x, https://si.imgix.net/cfc16e9b/uploads/origins/f3dc756c-3d9b-4159-960e-8627dc232f52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=df11858816ebdb62b84023d443ed5e08 3x"}, "body": "もんぱら終章が発売し、発売する前にもう一度周回していたのですが、その中でも一番好きなエロシーンが誘惑でしか見れないセントールの授乳手コキでした。そこで調べたところ、すがもん先生が描いているのを知ったので、リクエストをさせていただきました。\n\nもんぱらのセントールの授乳手コキのシーンをセリフ付きで描いていただきたいです。\n要望としてはカメラの画角はゲームのものより少し引き気味でセントールの顔が映るように書いてほしいです。（顔が映らなくてもあれはあれでエロくて好きなので、ゲームのcgに似せる形でも良いです。)\nあと一番好きなところがルカ君がセントールのおっぱいを揉みながらされているところなのでそこは忘れずにお願いします。\n\nセントールはゲーム通り、お姉さんぽく、少し小バカにするような感じで、ルカ君は理性を抑えきれず、メロメロでおっぱいにむしゃぶりつきながら、モゴモゴ喋っている感じでお願いします。\n射精するシーンまで描いていただきたいです。\nセリフはお任せしますが、プレイ時に「授乳手コキ、気持ちいいでちゅか〜♥♥」というセリフを入れてほしいです。\n\nご検討のほど、よろしくお願いいたします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sugamon/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/811ca310/uploads/origins/abc52210-5ddb-4950-a2ab-16af4bb6a01c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f0bb102a3ce660042b3c2b00d91fef78", "srcset": "https://si.imgix.net/811ca310/uploads/origins/abc52210-5ddb-4950-a2ab-16af4bb6a01c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f0bb102a3ce660042b3c2b00d91fef78, https://si.imgix.net/811ca310/uploads/origins/abc52210-5ddb-4950-a2ab-16af4bb6a01c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=add463e120dcaa9784c915babd62f851 2x, https://si.imgix.net/811ca310/uploads/origins/abc52210-5ddb-4950-a2ab-16af4bb6a01c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a1e7d27031480fa0b53db4aba0d875f 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3191591, "client_id": 440245, "nc": 49}, {"path": "/@sugamon/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3191591, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/765f1326/uploads/origins/cbfe8f5f-1b8f-4766-bd23-ea19f28b5263?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f39f151e561221800f34c392985970d", "srcset": "https://si.imgix.net/765f1326/uploads/origins/cbfe8f5f-1b8f-4766-bd23-ea19f28b5263?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=