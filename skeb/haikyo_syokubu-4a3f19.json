84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d7d5e393a58fc5f8f8e581c05e5a884c 3x"}, "body": "初依頼失礼します、鯉のぼりです。\n廃墟先生のえっちな変化イラストが大好きで、今回リクエストさせていただきました。\n２ページのシークエンスでお願いします。\n\n依頼内容\nうちの子の「ノボル」が感じながらヌルヌルの海竜に変化するイラストをお願いします。\n\n怪人の攻撃で体の一部が変化、変化が加速して羽が背中と一体化し背びれになる、服を破りながら徐々に変化する、その様子を民衆に見られる感じで...\n\n海竜はグラブルのリヴァイアサンのような蛇型で、おっぱい有り(重要)、手足にヒレがあるものだと嬉しいです。\nよろしくお願いします。\n\nノボル資料\nhttps://x.com/Uosato_Nobori/status/1991366356948906131?s=20\nhttps://x.com/Uosato_Nobori/status/1990377139120796035?s=20\nhttps://x.com/Uosato_Nobori/status/1989363562243092636?s=20\nhttps://x.com/Uosato_Nobori/status/1989371009523409181?s=20\nhttps://x.com/Uosato_Nobori/status/1989609729317113987?s=20\nhttps://x.com/Uosato_Nobori/status/1991408178261815335?s=20", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@haikyo_syokubu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3788498, "client_id": 29045, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8bc9d7ba/uploads/origins/7b7a1fbd-fe86-4e72-869a-7315cbbd4082?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=484e773ee8390954b333d03a2bf3afac", "srcset": "https://si.imgix.net/8bc9d7ba/uploads/origins/7b7a1fbd-fe86-4e72-869a-7315cbbd4082?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=484e773ee8390954b333d03a2bf3afac, https://si.imgix.net/8bc9d7ba/uploads/origins/7b7a1fbd-fe86-4e72-869a-7315cbbd4082?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4484512ffe29b8f1efc80be18c0137e7 2x, https://si.imgix.net/8bc9d7ba/uploads/origins/7b7a1fbd-fe86-4e72-869a-7315cbbd4082?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf894148c6d1db58ab56e81aca0bdc70 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8bc9d7ba/uploads/origins/7b7a1fbd-fe86-4e72-869a-7315cbbd4082?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=908dfde47df43d3e3a6f7e8eb86a4d74", "srcset": "https://si.imgix.net/8bc9d7ba/uploads/origins/7b7a1fbd-fe86-4e72-869a-7315cbbd4082?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=908dfde47df43d3e3a6f7e8eb86a4d74, https://si.imgix.net/8bc9d7ba/uploads/origins/7b7a1fbd-fe86-4e72-869a-7315cbbd4082?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4ac874be988760c97e59165371bc42e3 2x, https://si.imgix.net/8bc9d7ba/uploads/origins/7b7a1fbd-fe86-4e72-869a-7315cbbd4082?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=36e698c2921bdb9696453dcac5c67dcb 3x"}, "body": "こんばんは！\n多様なtransfur・状態変化のイラストを拝見してます\n\nこの度、依頼したい内容があり連絡させて頂きましたー\n\n『プロローグ:\n\n古い遺跡に入った男性と女性のコンビの冒険者(どちらも人間)が、黒い大理石のような硬質な肌を持つアヌビス♂(無表情で感情が読みにくい)に襲われ\nその力量差から敗北\n\n【↓敗北後の場面からお願いします】\n\n裸に剥かれた女性冒険者の両腕を掴み、黄金色に鈍く輝く自身の肉棒を、女性の秘所に捩じ込むアヌビス♂\n\n女性は少し抵抗の意志を見せるものの、\nパートナーである男性冒険者と行う情交。その何倍にも至る衝撃が脳裏に巡り\n\n未知ともいうべき快楽に、あえなく理性が飛び\n獣のように喘ぎつつ、アヌビス♂との交尾に興じ始めてしまう\n\n屈強な雄に犯されて、雌としての魅力が高まっていく彼女の身体が黒みを帯びていき\n\nマズルが伸び、耳と尻尾が生え、\n\n古代遺跡を守る1体のアヌビス♀に造り変わった元女性冒険者は\n自分の対(番い)であるアヌビス♂と同じ冷淡な顔で\n\n未だ地面に倒れ伏したままの男性冒険者(遺跡に侵入した不届き者)を、見下ろすのであった』\n\nという内容を、可能ならお願い致しますー", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@haikyo_syokubu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3788498, "client_id": 1947026, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aff9e50a/uploads/origins/6b2e9f21-ece2-4bb0-8fbd-385655410f7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e25b3cb0758fb6f47a4c2a2ac5185827", "srcset": "https://si.imgix.net/aff9e50a/uploads/origins/6b2e9f21-ece2-4bb0-8fbd-385655410f7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e25b3cb0758fb6f47a4c2a2ac5185827, https://si.imgix.net/aff9e50a/uploads/origins/6b2e9f21-ece2-4bb0-8fbd-385655410f7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed46019df0811f9db7595b5937c64273 2x, https://si.imgix.net/aff9e50a/uploads/origins/6b2e9f21-ece2-4bb0-8fbd-385655410f7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d91908e40b5e2c774e67e3ecb46ede5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aff9e50a/uploads/origins/6b2e9f21-ece2-4bb0-8fbd-385655410f7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e5c6b75e1376c28d4067c110483fcad", "srcset": "https://si.imgix.net/aff9e50a/uploads/origins/6b2e9f21-ece2-4bb0-8fbd-385655410f7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e5c6b75e1376c28d4067c110483fcad, https://si.imgix.net/aff9e50a/uploads/origins/6b2e9f21-ece2-4bb0-8fbd-385655410f7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2105f0c733c46d8ca8aad87d3c654438 2x, https://si.imgix.net/aff9e50a/uploads/origins/6b2e9f21-ece2-4bb0-8fbd-385655410f7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9b7355054657ac0183cbc0a87e4c43ff 3x"}, "body": "黒髪ストレートで、背が高くて丸みを帯びた学校の先生が、生徒を叱るときに、生徒の一人から呪いの携帯カメラで攻撃される。カメラが写真を撮るたびに、彼女は目に見えて若く、小さく、毛深くなり、ウサギに変身する。しかし、実際には巨乳はさらに大きくなり、その結果、巨乳、白い毛、長く垂れ下がった耳を持つ、かわいくて小さなアンソロ（主に動物のような）バニーになってしまう。変身中、彼女の表情は険しさ、驚き、興奮と変化する。彼女の服もカメラで撮られるたびに変化し、縮み始め、かわいい首輪以外は裸になる。生徒たちから見れば、彼女は今やクラスのかわいいかわいいペットで、みんな彼女を撫でるのが大好きだ。しかし、ウサギの性欲を持つだけで、実は中身は同じ人間なのだ。だから、発情しても自分を解放できないという、哀れでかわいい表情で彼女は終わるのだ。素晴らしい作品をありがとうございました。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@haikyo_syokubu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "crea