食べ物を作って猫を飼っているウェイター、忙しい中で暇を探して、妖と伴って邪祟を除いた陰陽師で、世間の太平のために各地を走り回って、写真と紙で物語を記録した大正カメラマンと古書店のオーナー、桜の小雨の中で出会い、一緒に各銀河を行き来して一緒に探索する宇宙開拓者、一緒に輝かしい星河などを見て、二人は異なる身分を持ち、一緒に異なる物語を創造します。 \n構図は全部あなたに任せて、自由に発揮できます。もし金額が足りないようでしたら、お手数ですが指定の後再送要請を送っていただけると嬉しいです。 よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/106xtoRTYZZ-eoR7MhM9cHSPoVZSK-C_c", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@c7g9yq/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4022439, "client_id": 1999669, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc649b56/uploads/origins/7be4d132-568d-4a91-8114-85771f5c606e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40d6792ddff92010ad5937ede96f5d18", "srcset": "https://si.imgix.net/fc649b56/uploads/origins/7be4d132-568d-4a91-8114-85771f5c606e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40d6792ddff92010ad5937ede96f5d18, https://si.imgix.net/fc649b56/uploads/origins/7be4d132-568d-4a91-8114-85771f5c606e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0facd550d9aa3260a55680ad3b99f8ab 2x, https://si.imgix.net/fc649b56/uploads/origins/7be4d132-568d-4a91-8114-85771f5c606e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f79dab6ef967e52aa55d3b8a4c654258 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc649b56/uploads/origins/7be4d132-568d-4a91-8114-85771f5c606e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40fde66971ab993a95ad1098b1c1ce59", "srcset": "https://si.imgix.net/fc649b56/uploads/origins/7be4d132-568d-4a91-8114-85771f5c606e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40fde66971ab993a95ad1098b1c1ce59, https://si.imgix.net/fc649b56/uploads/origins/7be4d132-568d-4a91-