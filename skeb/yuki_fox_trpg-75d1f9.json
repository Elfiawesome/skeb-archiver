るく人懐っこい。\n聡明ではあるが褒められたら子供らしく喜んだりもする。本とチェレスティーナが大好き。色々なものに興味津々でよく方向音痴になる。\n\n\n▼構図等詳細\n森様にお任せしたいと思います。参考までに案を二つほど記載しております。\n\nふかふかの大きめのベッドの上でうつ伏せに両肘をついて足をぱたぱたさせて絵本を覗き込んでいるようなアリーチェと、ベッドに腰かけて絵本を読み聞かせるチェレスティーナのふたり。ベッドの上には白いうさぎが置かれていて、部屋には絵本やフリージアの花が飾られていると嬉しいです。\n\nor\n\nふかふかの大きめのベッドの上で白うさぎのぬいぐるみを抱きしめながら絵本を覗き込んでいるようなアリーチェと、ベッドに腰かけて絵本を読み聞かせるチェレスティーナのふたり。部屋には、絵本やフリージアの花が飾られていると嬉しいです。\n\n▼使用用途\n・個人鑑賞(キャラクターをお借りした友人との共有鑑賞)\n・非商用の個人的鑑賞のためのグッズ作成\n\nご検討いただけますと幸いです。よろしくお願いいたします。```\n\nhttps://drive.google.com/drive/folders/1thRu-u3uinKIOOf-DgkPqgGWTdywkubH?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Table___/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 589243, "client_id": 913045, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3df614aa/uploads/origins/d3604516-5320-4fc3-b8ce-419e2f56d6a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df5f875083ec2bda5d193b2aa2bd0052", "srcset": "https://si.imgix.net/3df614aa/uploads/origins/d3604516-5320-4fc3-b8ce-419e2f56d6a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df5f875083ec2bda5d193b2aa2bd0052, https://si.imgix.net/3df614aa/uploads/origins/d3604516-5320-4fc3-b8ce-419e2f56d6a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ce082e0a3fff6048d161d3ab483fd4e 2x, https://si.imgix.net/3df614aa/uploads/origins/d3604516-5320-4fc3-b8ce-419e2f56d6a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57bef2b7500578ec123a23466a86fab3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3df614aa/uploads/origins/d3604516-5320-4fc3-b8ce-419e2f56d6a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1095523c9e8ee9b14d56d0d58c17a6d4", "srcset": "https://si.imgix.net/3df614aa/uplo