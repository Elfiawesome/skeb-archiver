70c-e43f-47bc-af12-8b0ee11faf17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c5a9150f1a6cdfce47572b5aef15410", "srcset": "https://si.imgix.net/b02a1fb6/uploads/origins/e292770c-e43f-47bc-af12-8b0ee11faf17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c5a9150f1a6cdfce47572b5aef15410, https://si.imgix.net/b02a1fb6/uploads/origins/e292770c-e43f-47bc-af12-8b0ee11faf17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8377762f668c47c3591aa20a138adc81 2x, https://si.imgix.net/b02a1fb6/uploads/origins/e292770c-e43f-47bc-af12-8b0ee11faf17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=28bdbda8016306350d391cb39d423d28 3x"}, "body": "はじめまして！カードキャプターさくらのフリフリの青いワンピースがかわいい、ごちうさのココア・ホトトさんのコスチューム交換のリクエストを受けたいと思います！\n\nそれは、さくらちゃんがプレゼントされたドレスで、ビクトリアンブルーのドレスの中央に白いレースがあしらわれ、ウエストはブルーのベルト、ミニスカートの下は長いパンプキンパンツのようなドロワーズ、左右にブルーの花とリボンがあしらわれたブルーのカチューシャがついている。これはモバイルゲームのビデオで、彼女がドレスを着て、かわいい人形を抱いている：https://youtube.com/shorts/nQOCgchodos?si=pE_iEgWn8x5Ei282\n\nビデオの人形と一緒に、ココアさんが立って、あのかわいいドレスを着ている全身（頭からスリッパまで）が見たい。ココアさんは目を見開いて幸せそうな表情で見る人を見つめている。このイラストには、落ち着いて目と口を閉じた表情のバリエーションも欲しい。また、スリッパは白で、ココアさんに合うようにティッピーのような形にしてほしい！https://gochiusa.com/chara/tippy.html\n\n背景は、上で紹介したリンク先のビデオのシーンをベースにするか、この公式アートワークのシンプルなチェック柄のブルーの背景をベースにするかはあなた次第だ。https://static.zerochan.net/Cardcaptor.Sakura.full.640442.jpg\n\nこのリクエストを検討してほしい！ありがとうございました！\n\nボーナス資料\nhttps://x.com/dyoring/status/1717533711535681618\nhttps://imgbox.com/g/R7ozTv32ef\nhttps://imgbox.com/B2zQdIfs\nhttps://imgbox.com/g/Zt0OoRvIfr", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sugiatsu3/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2775164, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/947eb5d5/uploads/origins/dc5820d4-713e-45f6-af2e-f109a94a9cdb?bg=%23fff&