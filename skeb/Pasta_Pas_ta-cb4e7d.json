8c343c8-810e-40b8-bded-927973eedb93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c34260e03973547e7fe987df90a34da 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/911fb344/uploads/origins/38c343c8-810e-40b8-bded-927973eedb93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=423e62cfbc082e994ad4db7ff46eb879", "srcset": "https://si.imgix.net/911fb344/uploads/origins/38c343c8-810e-40b8-bded-927973eedb93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=423e62cfbc082e994ad4db7ff46eb879, https://si.imgix.net/911fb344/uploads/origins/38c343c8-810e-40b8-bded-927973eedb93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=efb842bb47fc51d6d4b4526b98790a00 2x, https://si.imgix.net/911fb344/uploads/origins/38c343c8-810e-40b8-bded-927973eedb93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a2f7d38265275c08143ee56f29c8d93a 3x"}, "body": "いつも拝見させて頂いてます。\nブルーアーカイブから、サキと先生のR18コミックをリクエストします。\n\n1.「先生、早漏改善訓練だ」の訓練の延長でパイズリを行う。\n2.早々に限界が来て射精しそうになる先生。\n3.スパートかけて「射精せっ」と声を掛けるサキと、射精の瞬間に思わず自分の顔を手で覆ってしまう先生。\n4.その後、少し不機嫌そうに先生を見つめるサキ、そして間髪入れずにまたパイズリを再開する。\n5.抵抗できず先生は止めるよう懇願するも、そのまま継続するサキ。\n6.また射精しそうになっている先生を見て、手を止めて先生と恋人繋ぎで両手を繋ぐサキ。\n7.「今度はキチンと射精する瞬間の顔を見せてくれ(意訳)」と言って見つめ合ったままノーハンドパイズリで射精まで導き、その表情を余すことなく見届けて満足そうなサキと連続射精でぐったりした先生。\n8.先生を膝枕して、「カッコよかった♡」と声を掛けながら頭を撫でてフェードアウト。\n\n上記の流れでおねがいします。\nコマ割りや詳細なセリフ等は先生へお任せします。\nリクエストの主旨は「射精の瞬間の先生の顔が見たいサキ」なので、そこが合っていれば内容の変更、省略等して頂いても構いません。\n\nご検討よろしくお願いします。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Pasta_Pas_ta/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 1145363, "client_id": 113103, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff2666bb/uploads/origins/a9b540a5-dea5-4a63-b024-b18df686142a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7df164c69e3a1ac446bd17ee13ccee6", "srcset": "https://si.imgix.net/ff2666bb/uploads/origins/a9b540a5-dea5-4a63-b024-b18df686142a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7df164c69e3a1ac446bd17ee13ccee6, https://si.imgix.net/ff2666bb/uploads/origins/a9b540a5-dea5-4a63-b024-b18df686142a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5710d33543627b5731ba3f2c3b121419 2x, https://si.imgix.net/ff2666bb/uploads/origins/a9b540a5-dea5-4a63-b024-b18df686142a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4f86fe99b26f3e3f3bfd23d983f5fd89 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff2666bb/uploads/origins/a9b540a5-dea5-4a63-b024-b18df686142a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9624d10b4f775639471442d3a2c26b24", "srcset": "https://si.imgix.net/ff2666bb/uploads/origins/a9b540a5-dea5-4a63-b024-b18df686142a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9624d10b4f775639471442d3a2c26b24, https://si.imgix.net/ff2666bb/uploads/origins/a9b540a5-dea5-4a63-b024-b18df686142a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d2b029e85e7ef140e863ef352ae9568e 2x, https://si.imgix.net/ff2666bb/uploads/origins/a9b540a5-dea5-4a63-b024-b18df686142a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2ea9e57646d463a0b596ce582fbbc049 3x"}, "body": "いつも作品を楽しみに拝見しております！\nぱす太さんのお描きになる「男性が女性に優しく甘々に責められているシチュ」がとても癖に刺さりましたので、この度リクエストさせていただきました。\n\n早速ですが、以下のような内容のものをお願いできますでしょうか？\n\n★面倒見が良く距離感の近いボーイッシュな幼馴染に甘やかしてもらう\n（女の子は咲空ちゃんのようなイメージです）\n\n１．「今日は僕が正常位で腰を振りたい」と申し出ると「え…？普段騎乗位ばっかりでしかも早漏なのに…？大丈夫…？」と幼馴染から怪訝な反応をされる。\n２．強がって正常位を始めたものの、へっぴり腰でヘコヘコと腰を振るだけの僕。そんな様子を幼馴染はジーっと見つめてくる…と思いきや、いきなり膣内をにゅるっ！と締めてくる。\n「出ちゃうからやめて！」という僕に「何が？」ととぼける幼馴染。\n３．幼馴染の意地悪に腰が止まり歯を食いしばって快感に耐えていると、「暇だから」と悪戯っぽく両手で僕の乳首をくにくにと優しく弄ってくる。突然の刺激に下半身の力が抜け、幼馴染に抱き着くように倒れこんでしまう僕。\n４．僕を優しく抱き留めた幼馴染。耳元で「もう出る？イっちゃいそう？」と囁かれコクコクうなずく僕。「そのままの体勢でいいよ。私が動くから」と言われ、僕に抱き着かれたまま器用に腰を振る幼馴染。\n５．少しでもかっこいいところを見せようと踏ん張る僕を見た幼馴染は、僕の背中を指でツーっと撫でる。予想外の刺激でぞわぞわっとなる僕。間髪いれず耳元にやさしく吐息を吹きかけられ、痺れるような快感で勢いよく膣内射精。\n６．ピクピクと痙攣しながら射精が止まらない僕を抱きしめながら、頭を撫でつつ背中をぽんぽんと優しく叩きながら耳元で「がんばってえらいなー全部出そうなー」と囁く幼馴染。射精中も追いピストンしてくれて射精を手伝ってくれる。\n７．腰が抜けて動けない僕を仰向けに寝かせた幼馴染は「お掃除してあげる、そのまま寝てていいぞ」と言い、ティッシュでペニスを少し拭うとそのままフェラ。尿道の先に舌を入れてほじられ、奥に残っていた精液ごとお掃除フェラで絞られる。\n８．授乳の体勢で添い寝され寝落ちする僕。\n９．翌朝、気持ちよさで目を覚ますと幼馴染に乳首舐め騎乗位されている。\n「おはよう、今日も頑張ろうな」と言われベロチュー。\n\nよろしければご一考いただけますと幸いです。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Pasta_Pas_ta/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 1145363, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3968fba4/uploads/origins/6feb4d14-4db9-4a47-a29a-168fc078496e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fb36f075382d5862099399c7703421c", "srcset": "https://si.imgix.net/3968fba4/uploads/origins/6feb4d14-4db9-4a47-a29a-168fc078496e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fb36f075382d5862099399c7703421c, https://si.imgix.net/3968fba4/uploads/origins/6feb4d14-4db9-4a47-a29a-168fc078496e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bca97a2ea8409cb16f31c1588c99fe49 2x, https://si.imgix.net/3968fba4/uploads/origins/6feb4d14-4db9-4a47-a29a-168fc078496e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f393984089241791d177749f032385c8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3968fba4/uploads/origins/6feb4d14-4db9-4a47-a29a-168fc078496e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce933ea01a67a371df644a9cf719e564", "srcset": "https://si.imgix.net/3968fba4/uploads/origins/6feb4d14-4db9-4a47-a29a-168fc078496e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce933ea01a67a371df644a9cf719e564, https://si.imgix.net/3968fba4/uploads/origins/6feb4d14-4db9-4a47-a29a-168fc078496e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=63c9d296e36aae2021a3e7fbb1daebfe 2x, https://si.imgix.net/3968fba4/uploads/origins/6feb4d14-4db9-4a47-a29a-168fc078496e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cd499f6781b0da1a045080e31692e5d1 3x"}, "body": "初めまして！OC（オリキャラ）・うちの子キャンペーンらしいのでオリジナルキャラの依頼したいと思っていますが宜しいでしょうか？普段描かれているイチャラブとは違う内容ですので合わないと感じられたらキャンセル願います\n\n依頼したいのは過去に他の絵師さんに創作してもらったOC「アリシア」が複数の男たち（敵対組織の兵士という設定）に襲われるといった内容のコミックお願いしたいです。\n\n※下の方にキャラの立ち絵と設定等の資料が載っているURLを添付していますのでご参考になさってください。別に元の絵柄に寄せなくても構いません、ぱす太さんの得意とする絵柄で描いて下さい。あと台詞付き＆擬音付きでお願いしたいです。\n\n流れとしては「私は仲間たちを守る為、敵に降伏した。ただし娼婦となり敵兵士の慰安を行うという条件付きで…」というアリシアの独白から始まり、着ていた服を脱ぐように命じられまるでストリップのように敵兵士の前で脱いでいく。\n\nパンティだけ履いた姿で手ブラで胸を隠すアリシアの姿に興奮した男たちは襲いかかる\n\n「くっ！貴様ら……！」と屈辱を噛み締めながら馬乗りパイズリで犯されるアリシア。そしてこれは希望なのですがこのページでは、ぱす太さんが以前描かれたブルアカのサキの馬乗りパイズリのイラスト（https://www.pixiv.net/artworks/136602700）の構図およびキャラの表情で描いていただきたいです！この依頼を決めるキッカケがサキの絶妙なまでの表情だったので是非お願いです！ただし複数に襲われている設定の為キャラが「くっ！」という表情で見つめる先にチンポを配置して欲しいです。\n\nそして同じくぱす太さんの過去絵（https://www.pixiv.net/artworks/134459141）と同じ構図で悔しそうにザーメンブリッジを披露しながらハメられるアリシア。そしてまたも視線の先には顔射しようとシゴくチンポがある感じでお願いします。そして最後は「しかし奴らに散々弄ばれた後で知らされたのは、守るべき仲間たちは全員…敵の毒牙にかかり情夫にされていたと言う事実だけだった」というアリシアの独白で締め\n\nhttps://www.pixiv.net/artworks/128489149\n※↑今回依頼したいアリシアはURL先の3枚目と15枚目のキャラです", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Pasta_Pas_ta/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 1145363, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/63d99970/uploads/origins/e782c364-d6d2-418a-81d3-1ebcda30025b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84ba0b6eb2c9d2f309bedc63cdd18152", "srcset": "https://si.imgix.net/63d99970/uploads/origins/e782c364-d6d2-418a-81d3-1ebcda30025b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84ba0b6eb2c9d2f309bedc63cdd18152, https://si.imgix.net/63d99970/uploads/origins/e782c364-d6d2-418a-81d3-1ebcda30025b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3848220c30bb91bb05902d8519fca639 2x, https://si.imgix.net/63d99970/uploads/origins/e782c364-d6d2-418a-81d3-1ebcda30025b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8680f9213f4249c77698143c37357cea 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/63d99970/uploads/origins/e782c364-d6d2-418a-81d3-1ebcda30025b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46b3ef57290a55cf427c79ff9365e263", "srcset": "https://si.imgix.net/63d99970/uploads/origins/e782c364-d6d2-418a-81d3-1ebcda30025b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=46b3ef57290a55cf427c79ff9365e263, https://si.imgix.net/63d99970/uploads/origins/e782c364-d6d2-418a-81d3-1ebcda30025b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=13484668566ec0524f32ec755ef5cbb1 2x, https://si.imgix.net/63d99970/uploads/origins/e782c364-d6d2-418a-81d3-1ebcda30025b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8db3cb943ca717e79d6afca4e90f59fe 3x"}, "body": "いつも拝見させて頂いてます。\nブルーアーカイブから、サキと先生のR18コミックをリクエストします。\n\n1.シャーレの当番の際、「先生にお返しがしたいがそっち方面の知識に乏しく教範となる本はないものか(意訳)」と先生に伝えるサキ\n2.「それなら…」と自分好みの本(甘々なH本)をサキへ渡す先生\n3.後日、寝室的な所にて向かい合うサキと先生\n4.「任せてくれ」と手始めに愛おしそうにペニス全体に何回もキスをするサキ\n5.既に射精しそうな先生の表情を見て嬉しそうに「先生からもらった教範で学んだことはまだたくさんあるからな、期待しててくれ」と続きのプレイへと移行する\n6.イチャイチャな雰囲気のままフェードアウト\n\n上記の流れでおねがいします。\nコマ割りや詳細なセリフ等は先生へお任せします。\nリクエストの主旨は「サキが自発的にペニスにキスをしてくれる」なので、そこが合っていれば上記内容の変更等して頂いても構いません。\n\nご検討よろしくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Pasta_Pas_ta/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1145363, "client_id": 548494, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bbd28e7e/uploads/origins/043cf1c3-986a-4e87-8d7b-95dc16fd6978?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df669f60c14af10a90a6ef5b27d8a00c", "srcset": "https://si.imgix.net/bbd28e7e/uploads/origins/043cf1c3-986a-4e87-8d7b-95dc16fd6978?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df669f60c14af10a90a6ef5b27d8a00c, https://si.imgix.net/bbd28e7e/uploads/origins/043cf1c3-986a-4e87-8d7b-95dc16fd6978?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c307c761ff7c2260cba418c3fe5de9c7 2x, https://si.imgix.net/bbd28e7e/uploads/origins/043cf1c3-986a-4e87-8d7b-95dc16fd6978?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91b1afb6494a2ac552a7fb4708b4233f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bbd28e7e/uploads/origins/043cf1c3-986a-4e87-8d7b-95dc16fd6978?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc4ad96cdca502bbadcaacf24ea2007a", "srcset": "https://si.imgix.net/bbd28e7e/uploads/origins/043cf1c3-986a-4e87-8d7b-95dc16fd6978?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc4ad96cdca502bbadcaacf24ea2007a, https://si.imgix.net/bbd28e7e/uploads/origins/043cf1c3-986a-4e87-8d7b-95dc16fd6978?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b9d80eebb0b16506b24de7749459d59f 2x, https://si.imgix.net/bbd28e7e/uploads/origins/043cf1c3-986a-4e87-8d7b-95dc16fd6978?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ebcb6306629fb100641282e51a0cc984 3x"}, "body": "いつも拝見してます。\n今回もサキちゃんをお願いします。\n\n・ミヤコと二人で初代プリキュアの決めポーズをとっている\n・ノリノリの表情と羞恥心に耐えている表情の差分が欲しいです\n・服装についてはプリキュアコスプレ若しくは通常衣装でお願いします\n・可能であればカメラを構えている先生が脇に居ると嬉しいです\n・先生の思うままに2人にセリフや心の声を付けてもらえると嬉しいです\n・その他については先生にお任せします\n\n検討よろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Pasta_Pas_ta/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 1145363, "client_id": 1811340, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ead093d/uploads/origins/3bfaec79-275e-4e49-bc91-3a97094eb5f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=422439657a358abe1efc23d86afe9028", "srcset": "https://si.imgix.net/7ead093d/uploads/origins/3bfaec79-275e-4e49-bc91-3a97094eb5f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=422439657a358abe1efc23d86afe9028, https://si.imgix.net/7ead093d/uploads/origins/3bfaec79-275e-4e49-bc91-3a97094eb5f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7582503f16d91d6207fe6d99fc908d76 2x, https://si.imgix.net/7ead093d/uploads/origins/3bfaec79-275e-4e49-bc91-3a97094eb5f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c0e9e4b33277e0af614324c2db85e81 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ead093d/uploads/origins/3bfaec79-275e-4e49-bc91-3a97094eb5f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ec4ff07e3276d82c4a030cc971c0174", "srcset": "https://si.imgix.net/7ead093d/uploads/origins/3bfaec79-275e-4e49-bc91-3a97094eb5f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ec4ff07e3