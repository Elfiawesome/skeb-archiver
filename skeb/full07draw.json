m=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=07fdfdbc0a38bd8f7ef065f719c0e4a2 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2950879, "client_id": 3068359, "nc": 144}, {"path": "/@full07draw/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2950879, "client_id": 2113028, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/45c2e566/uploads/origins/95f81242-3563-4c90-bd36-e115dce4b649?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69b45984cf33adc0d3d118d90f71c602", "srcset": "https://si.imgix.net/45c2e566/uploads/origins/95f81242-3563-4c90-bd36-e115dce4b649?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69b45984cf33adc0d3d118d90f71c602, https://si.imgix.net/45c2e566/uploads/origins/95f81242-3563-4c90-bd36-e115dce4b649?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c4d0d68ceea545535076a8348eba6005 2x, https://si.imgix.net/45c2e566/uploads/origins/95f81242-3563-4c90-bd36-e115dce4b649?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4a97a2eca9ba2fa5aebaa6aede5b7a44 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/45c2e566/uploads/origins/95f81242-3563-4c90-bd36-e115dce4b649?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e088a25e8f02c3dfc428625c46b5aed", "srcset": "https://si.imgix.net/45c2e566/uploads/origins/95f81242-3563-4c90-bd36-e115dce4b649?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e088a25e8f02c3dfc428625c46b5aed, https://si.imgix.net/45c2e566/uploads/origins/95f81242-3563-4c90-bd36-e115dce4b649?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f2c665f9325714707f0a4e980bfbe7fd 2x, https://si.imgix.net/45c2e566/uploads/origins/95f81242-3563-4c90-bd36-e115dce4b649?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c3717c7189e176bfcbd42dea90e78313 3x"}, "body": "はじめまして！\nSkebを見ていたら素敵なイラストを拝見いたしました。\nもしよろしければ私のVtuberモデル（オリキャラ、OC）を描いて頂きたいと思いリクエストを送信させて頂きました。\n\n★依頼内容★\n　・テーマ：キス顔（緊張、恥ずかしさがある）\n　・ポーズ：恥ずかしさ、緊張が分かるポーズ\n　・構図：正面を向いている\n　・服装：おまかせ（アレンジ自由ですNGありません）\n　・注意点：胸のサイズはぺたんこです。髪飾りやシュシュも付いています。\n主に配信内や動画・配信サムネイルに使用させて頂きたいので、衣服の端や髪など、途切れないように描写していただけたら、とてもありがたいです。（全身イラストでなくて大丈夫です。）\n\n★キャラの設定★\n　元気で楽しいことが大好きだけどどこかポンコツ。\n　好きなことには真面目に一生懸命取り組む頑張り屋さん。\n\n★使用用途★\n　収益化済Youtubeの配信関係・動画サムネやTwitterなど各種SNSの他、現在検討中ですが今後、印刷サービスなどを含むグッズとして使用させて頂きたいです。\n\n★納品形式★\n　・キャラクターの透過を使用させて頂きたいのでPSDファイルでサイン、キャラクターはレイヤーを分けて頂けたらありがたいです。\n　※PSDファイルの納品が難しい場合はお手数ですがPNGファイルキャラのみ・背景あり等で分けて頂けると嬉しいです。\n\nVtuberモデル（オリキャラ）へのイラストや使用用途がジャンル外、モデルが気に入らない等で却下して頂いても問題ございません。\n何卒条件等合いましたらご検討の程宜しくお願いします。\n\nhttps://drive.google.com/drive/folders/11dKZv6WOilzkK6q44YHN_fup8mg5q3UG?usp=sharing\n\nhttps://drive.google.com/drive/folders/11dKZv6WOilzkK6q44YHN_fup8mg5q3UG?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@full07draw/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2950879, "client_id": 923885, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4e92ebcd/uploads/origins/3c60db02-a574-4459-8791-345838711b12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44255ac39720895ae34775b9cc03c4d3", "srcset": "https://si.imgix.net/4e92ebcd/uploads/origins/3c60db02-a574-4459-8791-345838711b12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44255ac39720895ae34775b9cc03c4d3, https://si.imgix.net/4e92ebcd/uploads/origins/3c60db02-a574-4459-8791-345838711b12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d51c81db511d76e8887c38e41b45