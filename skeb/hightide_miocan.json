4727-b85b-11b0af1bd4b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67913bb04f5d1e28b55db597613aa50f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/565a6761/uploads/origins/1fa25b46-40cb-4727-b85b-11b0af1bd4b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f87fb6c1606aab99b641a626e514b0c", "src_set": ""}, "body": "はじめまして。\n\nバラエティ豊かで楽しくて可愛い表情パターンの絵を、いっぱい拝見させて頂いておりました！\n\n以前単眼のキャラクターのリクエストも描かれてたようなので、もし可能でしたら、自分の作品（ヒトミ先生の保健室）の単眼キャラ「ヒトミ先生」を描いて頂きたいです…！\n\nURL\nhttp://www.comic-ryu.jp/_hitomi/\n\n参照画像\nhttps://www.pixiv.net/artworks/84407201\nhttps://twitter.com/shakekoujou/status/1533374191004618757?s=20&t=f4wiGa6hzN2ful1R8lvk8A\n\n単眼巨乳の、優しくて明るいけれどちょっとドジな保健室の先生です。\n\nどうぞご検討よろしくお願いいたします…！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hightide_miocan/works/62", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 411474, "client_id": 845053, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/74bbeac9/uploads/origins/04a65162-087c-41cf-9025-09c3caf8e7e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4f57d6c699b6fd32954e274db16f4b2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/74bbeac9/uploads/origins/04a65162-087c-41cf-9025-09c3caf8e7e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa1a20c3c01e26e2a668c7482750552d", "src_set": ""}, "body": "またまたこんにちは。以前描いていただいた作品、とても気に入っています。この表情でもう一度私のキャラクターを描いてくれませんか？\n\n1.1. 中立的な話し方\n2.笑う\n3.邪悪な笑い\n4.怒る\n5.口角泡を飛ばす\n6.悲しい\n7.にっこり\n8.困惑\n9.考える\n10.ため息\n\n-\ntwitter、twitch、youtubeで使用する予定です。クレジットは付与されます。\n\nhttps://drive.google.com/drive/folders/1CMQeI9EwLGCRPRRjiahALW13UPYTnjk6?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hightide_miocan/works/61", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 411474, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f0bf5d2/uploads/origins/de6b1d85-1954-4d62-8ad1-d47b15b642b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f117b8d2b10cb87f22062a52e665f934", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1f0bf5d2/uploads/origins/de6b1d85-1954-4d62-8ad1-d47b15b642b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1d35fbf44e542dfde0526a0958fa41a", "src_set": ""}, "body": "下記URL衣装のデレマスのウサミンで、Pとデート中に気を利かせて屋台で2人分のアイスを買って戻ってきた所、突然の強風でパンツが丸見えになってしまったシチュをお願いしたいです！\nウサミンは両手が塞がっていてガードができず、どうにもできずに悲鳴を上げていて、目はギャグっぽい感じ（何回も〇をなぞった黒輪郭の白目で丸い粒の涙を流している）のもので。\n\nスカートは全体が裏返るくらいに派手に思い切り捲れてしまっていて、\nパンツは全体がよく見えるように、色は濃い黒でシンプルなデザインでお願いしたいです！\n\n構図はアイスを両手に持ったウサミンの（普通頭身の）立ち絵がメインで、\n端の方に小さく簡潔に、それを見たPがお札を一枚差し出していて、ウサミンはしどろもどろに断ってるという、その後のシーンをお願いしたいです！\n\nまたよろしければ、スカートがめくれる直前のものを、お願いします！\n\nhttps://imas.gamedbs.jp/cgss/images/ubwbMLm1ggIr6Fgup1p_Cem3zXqYvl2rs-TnLWpZs4I.jpg", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hightide_miocan/works/60", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 411474, "client_id": 1645269, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff099711/uploads/origins/ea48f0ee-d401-46a5-94b1-8192b6cd98ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f94720bd73758791f21a19dd46fff0ab", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff099711/uploads/origins/ea48f0ee-d401-46a5-94b1-8192b6cd98ca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c7936c9ce70ca4e57391712d8761b618", "src_set": ""}, "body": "こんにちは！私はあなたのアートワークが大好きです。私のvtuberの友人の何人かはあなたのアートワークを持っていて、それはすべてとてもかわいいです。(最後のオファーについては本当に申し訳ありません - minを読み間違えました！)\n\nhttps://skeb.jp/@can_miomio/works/47 私のキャラクターVixsaiaのようなセットが欲しいです。\n\nVixsaiaは、ガラ/スチームパンクの美学を持つシェイプシフターの発明家です。彼女は3つのモードを持っています：キツネ（考え事や好奇心が強い時）、ウサギ（内気な時）、悪魔（もう少し「大人」なモード、ハハ、イライラしている時）です。光輪は宝石用のドライバー、首の法螺貝は小さな工房で、縮めて使うことができるなど、とても実用的です。\n\n参考資料も載せておきますが、私は左のような服装が好きです。https://1drv.ms/u/s!AtQExA8dMR1gg8d_q5ukhMjEAHlO-g\n\nこのような、「これはかっこいい！」「これは楽しい！」と思うポーズや表情は、自由にやってください。\n\n作品はTwitch、Twitter、Discordで使用する予定です。背景を透明にしてもらえると嬉しいです。\n\nhttps://1drv.ms/u/s!AtQExA8dMR1gg8RA4rOghPQaiP1pxg", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hightide_miocan/works/59", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 411474, "client_id": 1678909, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef9af2ca/uploads/origins/e5b5ebdf-1393-4e1a-99e5-7df5b98cf419?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7e80808041012a37ca33900fd34063e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef9af2ca/uploads/origins/e5b5ebdf-1393-4e1a-99e5-7df5b98cf419?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90e28c860548d930529a1fe3fb59cd40", "src_set": ""}, "body": "こんにちは、私の名前はTaorenです、私はermine vtuberです。私はあなたのアートスタイルが大好きです。\n\nいろいろな表情やポーズで描いていただけませんか？\n\nあと、ハンバーガーが好きです。\nこのアートはtwitterやtwitch、そして多分マーチャンダイズに使われるでしょう。あなたの名前は必ずクレジットされます\n\nhttps://drive.google.com/file/d/1TgKEomIK0AUpp43DpuknACfH37YbBrDy/view?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hightide_miocan/works/58", "private_thumbnail_image_urls": null, "priva