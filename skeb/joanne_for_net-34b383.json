ps://si.imgix.net/d4c99837/uploads/origins/0e72c7c6-8575-442b-becf-e25f0191f144?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0bdd43e0edfb000470e6b40a74bcdea0, https://si.imgix.net/d4c99837/uploads/origins/0e72c7c6-8575-442b-becf-e25f0191f144?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4350310e70eb9cdc77e132f3f9dfcf66 2x, https://si.imgix.net/d4c99837/uploads/origins/0e72c7c6-8575-442b-becf-e25f0191f144?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=41d36e37f42d5c01f321eb98cb85eed7 3x"}, "body": "前回も素敵なゆかりさんと葵ちゃんをありがとうございました。\n大変好みでしたので、また依頼させていただきました。\n\nふたなり結月ゆかりにボテ腹になるまで犯される琴葉葵を描いていただきたいです。\n\n■キャラクター\n琴葉葵、結月ゆかり\n\n■シチュエーション\n一緒に出掛けようと自部屋に訊ねてきた茜ちゃんを、\nゆかりさんに犯された状態で扉の隙間から顔を見せて断る葵ちゃん。\n茜ちゃんが出掛けたので、ゆかりさんにボテ腹になるまで犯される葵ちゃん。\n\n以上の内容でお願いいたします。\n指定していない部分はお任せいたします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@joanne_for_net/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 496274, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28613d81/uploads/origins/88c99282-2296-471a-85c6-9baf256657d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0719667ef0bc2317820f56564f301eb5", "srcset": "https://si.imgix.net/28613d81/uploads/origins/88c99282-2296-471a-85c6-9baf256657d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0719667ef0bc2317820f56564f301eb5, https://si.imgix.net/28613d81/uploads/origins/88c99282-2296-471a-85c6-9baf256657d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c137af8125a764554fc6d25502e47c8 2x, https://si.imgix.net/28613d81/uploads/origins/88c99282-2296-471a-85c6-9baf256657d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=509568b50e59d5176a80731bdcf2c4da 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28613d81/uploads/origins/88c99282-2296-471a-85c6-9baf256657d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a854b0e6e89972998ede5ba6f2258c7", "srcset": "https://si.imgix.net/28613d81/uploads/origins/88c99282-2296-471a-85c6-9baf256657d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a854b0e6e89972998ede5ba6f2258c7, https://si.imgix.net/28613d81/uploads/origins/88c99282-2296-471a-85c6-9baf256657d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bfb61b8fe0529ec3d6f02caffd2e9c77 2x, https://si.imgix.net/28613d81/uploads/origins/88c99282-2296-471a-85c6-9baf256657d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7a9d92630e0821631c0e1862d6dbef4f 3x"}, "body": "こんにちは！最近のイラスト、特にカノエの絵をとても楽しませていただきました。そこで、カノエちゃんの漫画をリクエストしたいと思います。\n\n視点は結構小さくなった先生のもの。（一人称視点なので、先生自身を描く必要はありません。全ては先生の視点から。）カノエは小さな先生を探しており、彼女の巨大な靴が視界いっぱいに広がっています。先生はカノエのそびえ立つ身体を見上げると、カノエは虫眼鏡を手に先生を見下ろしている。\n\nカノエの巨大な体がしゃがみこみ、先生に手を伸ばす。差し伸べられた手は先生をつかむほどに更に大きく見える。「イヒヒ…」\n\n捕らえられた先生は笑みを浮かべたカノエに抱え上げられ掴まれている。「前世よりずいぶん小さくなったねぇ…でも大丈夫。イヒッ。」\n\nありがとうございました！可能であれば、先生の視点からカノエの巨大さを強調した描写を希望します。それ以外に自由に描写していただき、お好きなように調整してください。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@joanne_for_net/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 496274, "client_id": 1417523, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f57e94a2/uploads/origins/e6ae7301-85f7-4d13-9453-d8ba3329c679?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78b64de044e27f880c4421ec29329c2d", "srcset": "https://si.imgix.net/f57e94a2/uploads/origins/e6ae7301-85f7-4d13-9453-d8ba3329c679?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78b64de044e27f880c4421ec29329c2d, https://si.imgix.net/f57e94a2/uploads/origins/e6ae7301-85f7-4d13-9453-d8ba3329c679?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d565b99b9e113100b02be7707858331 2x, https://si.imgix.net/f57e94a2/uploads/origins/e6ae7301-85f7-4d13-9453-d8ba3329c679?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d0b3e318c6f623867b63384d1401263 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f57e94a2/uploads/origins/e6ae7301-85f7-4d13-9453-d8ba3329c679?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d69c1210e709ee4e23a0769cf49e7242", "srcset": "https://si.imgix.net/f57e94a2/uploads/origins/e6ae7301-85f7-4d13-9453-d8ba3329c679?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d69c1210e709ee4e23a0769cf49e7242, https://si.imgix.net/f57e94a2/uploads/origins/e6ae7301-85f7-4d13-9453-d8ba3329c679?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cb711e0a345f5a2bd7c110a0fa12c2fb 2x, https://si.imgix.net/f57e94a2/uploads/origins/e6ae7301-85f7-4d13-9453-d8ba3329c679?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=28d1d2e53fb72c05c0e6268b7fc62004 3x"}, "body": "前回は素敵なゆかりさんと葵ちゃんをありがとうございました。\n大変好みでしたので、また依頼させていただきました。\n\n三人で買い物している際に我慢できなくなって、\nふたなり結月ゆかりを誘い、犯される琴葉葵を描いていただきたいです。\n\n■キャラクター\n琴葉葵、結月ゆかり\n\n■シチュエーション\n（こんな感じの設定を想定していますが、参考程度に。\n特にイメージと合わなければ、スルーしていただいて大丈夫です。）\n\n琴葉茜、琴葉葵、結月ゆかりの三人で買い物に出かけ一段落した頃。\n寄る所があると言うゆかりさんと、見たい物があるという葵ちゃんが言い、一旦各々で行動することになる。\n一人でショッピングを続ける茜ちゃんと、再び合流するゆかりさんと葵ちゃん。\nそうしてトイレの個室に連れ込まれ、自分から股を広げてゆかりさんを誘う葵ちゃん。\n「茜ちゃんが居るのに我慢できないなんて、仕方ない子ですね」と、\n膣内に精液詰め込まれてしまう葵ちゃん。\n\n■要望\n(可能であれば。また該当シーンがあれば)\n遅かったことに文句をつける茜ちゃんとのやり取り中、膣から精液が垂れている葵ちゃん\n\n以上の内容でお願いいたします。\n指定していない部分はお任せいたします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path