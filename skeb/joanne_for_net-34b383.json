キメまくった事後というシチュで、腕くらいある長チンをずろろろ…っと引き抜かれ、ずんだもんの膣肉は名残惜しそうに吸い付き離さず、引き抜かれる刺激でまたイっている様子をお願いします\n構図は元イラストと同じ、或いは差分だと嬉しいです", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@joanne_for_net/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 496274, "client_id": 1417523, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6352a59/uploads/origins/0b7abd2f-f70a-480b-9ff8-1540288411bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e5509a70d16dc8b520e6a2b4bfda1e9", "srcset": "https://si.imgix.net/c6352a59/uploads/origins/0b7abd2f-f70a-480b-9ff8-1540288411bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e5509a70d16dc8b520e6a2b4bfda1e9, https://si.imgix.net/c6352a59/uploads/origins/0b7abd2f-f70a-480b-9ff8-1540288411bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e0a440c1ee9900e71708b823eac77d0 2x, https://si.imgix.net/c6352a59/uploads/origins/0b7abd2f-f70a-480b-9ff8-1540288411bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae5e1d639df2b636770cf8a7de0a52be 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6352a59/uploads/origins/0b7abd2f-f70a-480b-9ff8-1540288411bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dab65482e8c40b5d51c5273aed2b63a2", "srcset": "https://si.imgix.net/c6352a59/uploads/origins/0b7abd2f-f70a-480b-9ff8-1540288411bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dab65482e8c40b5d51c5273aed2b63a2, https://si.imgix.net/c6352a59/uploads/origins/0b7abd2f-f70a-480b-9ff8-1540288411bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b8973ceaf74176126ee7725547de7408 2x, https://si.imgix.net/c6352a59/uploads/origins/0b7abd2f-f70a-480b-9ff8-1540288411bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=989dba51e314b98f151334b32bad3918 3x"}, "body": "初めまして。\nふたなりゆかりさんと琴葉姉妹の内容が\nとても好みでしたので依頼させていただきました。\n\nふたなり結月ゆかりに犯される琴葉葵を描いていただきたいです。\n\n■キャラクター\n結月ゆかり、琴葉葵\n\n■シチュエーション\n（こんな感じの設定を想定していますが、参考程度に。\n特にイメージと合わなければ、スルーしていただいて大丈夫です。）\n\n何度も交わる度にゆかりさんのおちんちんの魅力に夢中になり、\nいつの間にか立場が逆転してしまった琴葉姉妹。\n茜ちゃんにぬけがけでゆかりさんの家にやって来て、ゆかりさんを誘う葵ちゃん。\n「今日は茜ちゃんの分も葵ちゃんが受け止めてくれるんですよね」と\n普段の倍犯されてしまう葵ちゃん。\n\n■要望\n・イってる様子の葵ちゃんと、そんな葵ちゃんをまだまだ犯す気のゆかりさん\n\n以上の内容でお願いいたします。\n指定していない部分はお任せいたします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@joanne_for_net/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/94acced8/uploads/origins/0017f7e4-5839-4ee2-8931-2f3f4171ad9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9f7e61b98f64c5a87fb06410da6927b", "srcset": "https://si.imgix.net/94acced8/uploads/origins/0017f7e4-5839-4ee2-8931-2f3f4171ad9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a9f7e61b98f64c5a87fb06410da6927b, https://si.imgix.net/94acced8/uploads/origins/0017f7e4-5839-4ee2-8931-2f3f4171ad9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2fe51b2b946b0b922caad0f1162a78d7 2x, https://si.imgix.net/94acced8/uploads/origins/0017f7e4-5839-4ee2-8931-2f3f4171ad9b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1200f27d0e1512ff3a5e8785d3586301 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 496274, "client_id": 470012, "nc": 48}, {