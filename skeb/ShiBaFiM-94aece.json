200&h=200&s=281cbba18eb9a9891c98e8c6fb792ee9, https://si.imgix.net/ca9f9c28/uploads/origins/53ba60da-ebf7-4f6f-b87f-90bb5660ce1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=15f8593a4c1810036eb27886250f558d 2x, https://si.imgix.net/ca9f9c28/uploads/origins/53ba60da-ebf7-4f6f-b87f-90bb5660ce1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50341ef370709a97ef295aad5d9a87d5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ca9f9c28/uploads/origins/53ba60da-ebf7-4f6f-b87f-90bb5660ce1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a97666104e0ae4afe41d4f51a5486ff7", "srcset": "https://si.imgix.net/ca9f9c28/uploads/origins/53ba60da-ebf7-4f6f-b87f-90bb5660ce1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a97666104e0ae4afe41d4f51a5486ff7, https://si.imgix.net/ca9f9c28/uploads/origins/53ba60da-ebf7-4f6f-b87f-90bb5660ce1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a758d50b8e362950f67ac2ce436412a6 2x, https://si.imgix.net/ca9f9c28/uploads/origins/53ba60da-ebf7-4f6f-b87f-90bb5660ce1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f99a186f2de99f1727f311bd760b0f03 3x"}, "body": "こんにちは！アリュです。\nしばりゅうきんさんにオリジナルキャラクターを作っていただきたくリクエストしました。\n\nこういったリクエストをするのは初めてなので、もしやり方が違っていた場合はキャンセルしていただいて大丈夫です。\n\n何個かのイメージを伝えるので、その中で創作意欲が湧いたキャラクターを描いていただけると嬉しいです。(1つでOKです)\n\n①キウイ(果物)モチーフのキャラ\n(キウイそのままでも、キウイタルトなどキウイを使った別のモチーフでもOK)\n\n②鉱石、鉱物(宝石など)モチーフのキャラ\n(原石、加工品(指輪・ネックレスなど)は自由に決めてOK)\n\n③鳥モチーフのキャラ\n(鳥の種類や創作鳥などなんでもOK)\n\n④青色のカーネーションのキャラ\n(濃い青色と、水色に花びらの端が白のカーネーション)\n\n⑤ピエロやサーカスがモチーフのキャラ\n\nこの①〜⑤のなかでイメージが湧いたキャラを描いていただきたいです。\n各モチーフが入っていれば、他に別の要素(別のモチーフや職業など)を足してもらうのは問題ありません。むしろ嬉しいです。\n\nキャラクターは人間、獣人、人外など種族はなんでも大丈夫です。\n年齢や性別は指定しませんが、個人的にはおじさんキャラ(髭あり)が特に好きです。\nしかし、しばりゅうきんさんの描く女の子や男の子も大好きなのでイメージが湧いた方を描いていただけたらと思っています。\n装飾品として、メガネやモノクル、仮面といった目元に何かあるのが好きです。(なしでも可)仮面などで瞳が隠れる場合は瞳が見える差分もあると嬉しいです。(なしでも可)\n\nしばりゅうきんさんの絵が大好きなので、リクエストさせていただきました。いつも応援しています。\nご縁があればよろしくお願いします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2697743, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "りーしぶ", "screen_name": "LeeDJ42", "avatar_url": "https://pbs.twimg.com/profile_images/1644281620684488704/T8Rtjb1e.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1421133918477058053/1778987166/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 2843993, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "回（null）", "screen_name": "nullmms", "avatar_url": "https://pbs.twimg.com/profile_images/2028754800960266241/bhbgQygn.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2028754327142350848/1784675944/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 3412615, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "お黙りなさい", "screen_name": "odamarinasai53", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fe843488b-3a9d-4c69-bc40-f48e1de975e7.png&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/webpublic-a1ec9817-4306-421a-9530-76ed5c2c3a1e.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at":