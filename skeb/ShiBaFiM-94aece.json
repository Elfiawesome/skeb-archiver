物→ヴァンピっち→\n【メア】【ヴァレリウ】で確認してください\n追加設定資料として、同サイト内の\nイラスト→ヴァンピっち→イラスト→資料\nを確認してください。\n\n2枚で対にしたいため。\n配置は左右対称にして頂きたいです。\n(等身高い絵が背中合わせもしくは、向かい合っている)\nミニキャラ絵部分は【ヴァンピっちの姿】(ぬいぐるみのような姿)にしてほしいです。\n\nポーズは指定なしですが、【メア】の靴底の蹄鉄が見えるポーズだと嬉しいです。\n\nよろしくお願いいたします。\n\n<iframe src=\"https://zigzag-chicken-5d1.notion.site/ebd//3e9ec1dd221e80c0a5dbe8a20ff8cc2b\" width=\"100%\" height=\"600\" frameborder=\"0\" allowfullscreen />", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ShiBaFiM/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3703153, "client_id": 2990425, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c40cf61/uploads/origins/661295ef-e84f-44d1-95a3-b6e31389fc56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=836250df1017f80317369b6657e6a4da", "srcset": "https://si.imgix.net/8c40cf61/uploads/origins/661295ef-e84f-44d1-95a3-b6e31389fc56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=836250df1017f80317369b6657e6a4da, https://si.imgix.net/8c40cf61/uploads/origins/661295ef-e84f-44d1-95a3-b6e31389fc56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6976c48ab868f7936371cb6280250e96 2x, https://si.imgix.net/8c40cf61/uploads/origins/661295ef-e84f-44d1-95a3-b6e31389fc56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38314e82e86953d35751c75d7272cc54 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8c40cf61/uploads/origins/661295ef-e84f-44d1-95a3-b6e31389fc56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24a84d5dcf188325194d84f7bb04c52f", "srcset": "https://si.imgix.net/8c40cf61/uploads/origins/661295ef-e84f-44d1-95a3-b6e31389fc56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24a84d5dcf188325194d84