少しだけ明るく）\n\n可能であれば、サインや宛名を別レイヤーに分けた画像をくださると大変助かります。\n用途は自己観賞用です。\n\n以上となります。\nよろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ao_softn/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1677771, "client_id": 1932639, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ae37933c/uploads/origins/4328219e-f959-4544-a000-aa888d409a37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d411798c4064da586cf3755b1f4a7102", "srcset": "https://si.imgix.net/ae37933c/uploads/origins/4328219e-f959-4544-a000-aa888d409a37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d411798c4064da586cf3755b1f4a7102, https://si.imgix.net/ae37933c/uploads/origins/4328219e-f959-4544-a000-aa888d409a37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe3b495d7e5956c4e06594cf0de00f9f 2x, https://si.imgix.net/ae37933c/uploads/origins/4328219e-f959-4544-a000-aa888d409a37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a6eed9ba871368f647c8911c8d7d959 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ae37933c/uploads/origins/4328219e-f959-4544-a000-aa888d409a37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83fe17903767e5ad7bff6563a63535d2", "srcset": "https://si.imgix.net/ae37933c/uploads/origins/4328219e-f959-4544-a000-aa888d409a37?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83fe17903767e5ad7bff6563a63535d2, https://si.imgix.net/ae37933c/uploads/origins/4328219e-f959-4544-a000-aa888d409a37?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa97f74bd643b22c2c6fb1cd394e1b52 2x, https://si.imgix.net/ae37933c/uploads/origins/4328219e-f959-4544-a000-aa888d409a37?bg=%23fff&au