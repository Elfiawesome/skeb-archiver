く持つ青年です。\nifの世界線では普通に高校生をしており、友達や恋人と一緒に平和を享受しています。放課後の買い食いが好きだったり、戦隊ヒーローが好きだけれど人に話すのは恥ずかしかったり、ifの方だとより男子高校生らしいところが多いキャラクターです。\n\n構図等はお任せしますが、彼が高校の制服姿で、学生らしいシチュエーション・爽やかな夏の光景の中に居るイラストだと嬉しく思います。\n\nよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/c4jo4tgqsz5jj262725qn/AIQmXgssyE3QnqSC4N92l2k?rlkey=shuyle3i3y1ob46bbi1a00e7f&st=lqwf2rhq&dl=0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1634817, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "おこのみこ", "screen_name": "O_okonomiko", "avatar_url": "https://pbs.twimg.com/profile_images/1764663399324196864/qRhkvrw3.jpg", "header_url": "https://pbs.twimg.com/profile_banners/790913043064508416/1723634201/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "skills": [{"genre": "art"}], "nc": 145}, {"id": 1787606, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "みそぢる", "screen_name": "misodiru", "avatar_url": "https://pbs.twimg.com/profile_images/1964882803235094528/B21bKv1m.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2609298366/1757299598/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 161}, {"id": 1791902, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "スパイシーつな", "screen_name": "spicy_tsuna", "avatar_url": "https://pbs.twimg.com/profile_images/1583084912042684416/_nURibT9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/269019641/1623056495/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_ac