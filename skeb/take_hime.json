=webp&fit=crop&crop=top&w=200&h=200&s=3796685399fa53fefc3c709e34070a41", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b4af1e1f/uploads/origins/cf7664d1-35e4-47f2-b07f-18a60c99add9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da0c5ed9c6ac3eff4e30f0f57abd02da", "src_set": ""}, "body": "こんにちは、前回も素敵なイラストをありがとうございました。\n鳩もなかなかに可愛かったので、おかげさまでマスコット鳩な設定も生えてきました。\n今回も同じキャラにて特殊なエロマジックなネタでリクエストさせていただきます。\n\n・キャラクター\nエカチェリーナ\nコミッション用のオリジナルキャラです。\n\nhttps://seesaawiki.jp/ageha_commission/d/%a5%a8%a5%ab%a5%c1%a5%a7%a5%ea%a1%bc%a5%ca\n\nキャライメージは派手で煌びやかな宮廷道化師に由来する「ジェスター」の装いに身を包んだアイドルマジシャン。\n生意気でドヤ顔が似合う系属性。\n\n服装は以下URLのステージ衣装姿でお願いします。\n\nhttps://image02.seesaawiki.jp/a/n/ageha_commission/LxFuKzgO6A.png\n\n\n・シチュエーション\n触手が蠢くボックスの上にエカチェリーナが乗っている状態から、ボックスと自分を覆うほどのカーテンの様な布で自身を隠す舞台装置を使い、瞬きする間もなく布をどかした次の瞬間にはエカチェリーナ自身が触手の蠢くボックスの中に瞬間移動しており、ほぼ着衣の状態で触手と交わり、更には口、女性器、アナルの三穴に触手が挿入されている「瞬間移動マジック」なエロマジックなシチュエーション。\nマジックとしての一連の流れを書きましたが、主に描写して欲しいのは触手ボックスの中に瞬間移動した直後。\nなおあくまでも楽しくてエッチなマジックショーである為、触手ボックスの中に入った状態のエカチェリーナは楽しそうかつ気持ちよさそうな表情で触手と交わり、悲壮感は一切ない状態でお願いします。\n細かな構図等はお任せしますが、瞬間移動前はカットイン形式やデフォルメでもいいので入れて頂けるとありがたいです。\n\n\n・その他\nその他不明点、不自然な点は自由にアレンジして頂いて構いません。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@take_hime/works/65", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7f2063b3/uploads/origins/1139a3ea-55d9-481d-9d70-b1ee0cbf94ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e41b92bbc5aece741bfa9c0d30b2e268", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 714658, "client_id": 54138, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 33, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@take_hime/works/64", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 714658, "client_id": 179692, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a686a2b9/uploads/origins/5f84bb1b-f478-428e-8ce2-a69ce8de1a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebd421fc9e2df51f3fab44f8de0ed673", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a686a2b9/uploads/origins/5f84bb1b-f478-428e-8ce2-a69ce8de1a9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=33c555f4c9c6f66e4f2fa55c4e68208b", "src_set": ""}, "body": "こんにちは、リクエストのたびにキャラが変わっていますが、今回はちょっと変わったネタでリクエストさせていただきます。\n\n\n・キャラクター\nエカチェリーナ\nコミッション用のオリジナルキャラです。\n\nhttps://seesaawiki.jp/ageha_commission/d/%a5%a8%a5%ab%a5%c1%a5%a7%a5%ea%a1%bc%a5%ca\n\nキャライメージは派手で煌びやかな宮廷道化師に由来する「ジェスター」の装いに身を包んだアイドルマジシャン。\n生意気でドヤ顔が似合う系属性。\n\n服装は以下URLのステージ衣装姿でお願いします。\n\nhttps://image02.seesaawiki.jp/a/n/ageha_commission/LxFuKzgO6A.png\n\n・シチュエーション\nアダルト向けマジックショーで、マジックの初歩でもあり定番の「鳩出しマジック」の白い鳩を、女性器から出しているエロマジック「エロ鳩出しマジック」なシチュエーション。\n服は完全に着衣の状態で、パンツは可能なら片脚にひっかけている状態でお願いします。\nなおパンツのデザインに関してはお任せします。\n構図やポーズなどは女性器から鳩が出て来ているのが分かる様な構図で、描きやすい形でお任せします。\nなお一見すれば出産的な内容にも見えますが、あくまでも種も仕掛けもないマジックですのでボテ腹はNGでお願いします。\n\n・その他\nその他不明点、不自然な点は自由にアレンジして頂いて構いません。", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@take_hime/works/63", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 714658, "client_id": 190843, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/daa8d273/uploads/origins/717170a8-a4f4-4b19-b681-b3ab7da34c11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6bc46356ed34efd123135aed76dd96c8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/daa8d273/uploads/origins/717170a8-a4f4-4b19-b681-b3ab7da34c11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=644a2a4fae547b01521bb79654c25f3a", "src_set": ""}, "body": "昔他社で描いて頂いたうちの子日輪・稲子（元気処方箋・e05271）をお願いします！\nセックス中で騎乗位、男視点で誰だか分からないけど稲子ちゃんが男の上で腰を振っている様子です。\nちょっと見上げるアングルで上には稲子ちゃんの天真豊満ボディが！\n見た人がもしかして挿れてるの自分かも！？って思える様子がいいよね！\n基本全裸のつもりですが衣服や表情やポーズや散らかってそうな部屋の様子や中出しとかオプション的なものは一切合切自由です！\nグロリョナスカ表現のみＮＧで。\n宜しければお願いいたします！", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@take_hime/works/62", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 714658, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d2dd1a50/uploads/origins/d7aa9cf1-57d6-475c-a805-9262f95f27c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc5d7d0791825a1c65a33ae1499507e0", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d2dd1a50/uploads/origins/d7aa9cf1-57d6-475c-a805-9262f95f27c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=119dd8dddb59854f3b1a2ef6baeb225c", "src_set": ""}, "body": "お世話になっています。\n以前に御依頼したキャラで、今回は健全（ちょいエロ）でリクエストお願いします\n\n●キャラクター設定・容姿\n容姿は資料URLをご参照ください\n\n『しょせん一度は騎士を下りた身、多くは求めないでくださいな』\n『わたくしには、この街と運河の平穏が心地よい身の丈です』\n\n　水上都市でゴンドラ乗りを営む引退した王宮騎士であり、悪徳商人や裏社会の侵略と戦うクライムファイター（義賊）。\n　陰謀に絶望して身を引いた儚い雰囲気の大人の女性。姉、先輩、未亡人など年上属性キャラ。\n\n　外見年齢十代後半（実年齢的には二十代半ば）。身長170cm前後。黒髪、碧眼、長身、巨乳。健康的なお色気のお姉さん。\n　イメージカラーは青、水色（水属性）で、手にしたゴンドラの『櫂』を使った棒術で戦う魔法戦士\n\n●シチュエーション\n　水上での戦闘シーンイメージ\n　以前に描いていただいたピンチシーンの直前といったイメージで、敵側の描写はシルエット、体の一部のみでかまいません。\n\n　https://drive.google.com/file/d/1X_SqHh7_85AnCSBI26E0s7OVWuGmYzq5/view?usp=drive_link\n\n　水上、もしくはゴンドラの上で手にした『櫂』を振り回し、数で勝る敵のならず者を次々と倒していく。\n　水しぶきが飛び散り、たわわに揺れる四肢が濡れ透ける、エロかっこいい感じ。\n（NSFWは念のためです、本番行為は不要です）\n\n　その他細かい構図やアングルなどは今回もお任せいたします\n\nhttps://drive.google.com/file/d/1J8-mBJYaRu2S0efg4erRRVVFiLJKKxqF/view?usp=drive_link", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@take_hime/works/61", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d1b1dcf3/uploads/origins/0cc11d2c-73ff-4444-b019-94f298926754?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8821ad7985eec315515dc3c10a2bd7c0", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 714658, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@take_hime/works/60", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2c7e8410/uploads/origins/45658ab8-8a1a-4062-ace4-b1a3ead01e5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=46cd5d58d9b05750128cbdb3bbbff382", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 714658, "client_id": 872136, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@take_hime/works/59", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1b181bb0/uploads/origins/0d2cb06e-b960-4bf3-ae7f-3442649cbb8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d55ea3d7dae3b737433c2ff7ca232f64",