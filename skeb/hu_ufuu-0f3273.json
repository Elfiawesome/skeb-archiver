4f/uploads/origins/44dea519-8e2d-4191-8f7b-844bbcf47447?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83e4203780acb94c46d23ad543b8228d, https://si.imgix.net/98f6664f/uploads/origins/44dea519-8e2d-4191-8f7b-844bbcf47447?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8c666e0bbe3cc01693a197e29f1de820 2x, https://si.imgix.net/98f6664f/uploads/origins/44dea519-8e2d-4191-8f7b-844bbcf47447?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=68cde78cdee43224354bbcb6bf457ba0 3x"}, "body": "ビタミンさん、またお会いできて嬉しいです！前回のイラストが本当に素晴らしく、大変気に入っています。今回は、私の冒険者OCたちのイラストをお願いしたいです。\n\n【世界観】\n中世風の西洋ファンタジー世界で、物語の舞台は乾燥した地域に広がっています。主に「ドラゴンシティ（冒険者が集う活気ある都市）」と「ドラゴンライダー部族（衰退した辺境の民）」を中心に展開される物語です。\n\n【キャラクター紹介】\nhttp://tiny.cc/hu_ufuu\n登場キャラクターが多いため、全員を描く必要はありません。インスピレーションを感じたキャラクターを選んで描いてください。また、物語の中ではあまり関わりのないキャラクター同士でも、『AとBのこんな絡みがあったら面白そう！』と思うものがあれば、遠慮なく自由に描いてください！ビタミンさんならではの解釈を楽しみにしています。\n\n依頼内容と金額が見合わない・その他不備などあればお気軽に再送要請してください。\nご検討いただき、ありがとうございます！\n\nhttp://tiny.cc/hu_ufuu", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hu_ufuu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3291794, "client_id": 2813792, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4dd88165/uploads/origins/131edd52-22d3-4866-87f9-8150fc64581e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=166f4b4ee7b5b96120f97232b6b1372a", "srcset": "https://si.imgix.net/4dd88165/uploads/origins/131edd52-22d3-4866-87f9-8150fc64581e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=166f4b4ee7b5b96120f97232b6b1372a, https://si.imgix.net/4dd88165/uploads/origins/131edd52-22d3-4866-87f9-8150fc64581e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0224582ff479420492a06f70cbbb9bb8 2x, https://si.imgix.net/4dd88165/uploads/origins/131edd52-22d3-4866-87f9-8150fc64581e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bba6b0a47e30bf1bcdd83840c7b058da 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4dd88165/uploads/origins/131edd52-22d3-4866-87f9-8150fc64581e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=707c53f6c6c703af395ce400be6f73ed", "srcset": "https://si.imgix.net/4dd88165/uploads/origins/131edd52-22d3-4866-87f9-8150fc64581e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=707c53f6c6c703af395ce400be6f73ed, https://si.imgix.net/4dd88165/uploads/origins/131edd52-22d3-4866-87f9-8150fc64581e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1b99860b4f8ba3b190495983ce08a65f 2x, https://si.imgix.net/4dd88165/uploads/origins/131edd52-22d3-4866-87f9-8150fc64581e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6d0986e68158e40aa159c235317be3d7 3x"}, "body": "こんにちは、ビタミンさん。初めまして！ビタミンさんの作品が大好きなので、ゲームのPCキャラクターとNPCのイラストをお願いしたいです。NPCの原作は文字だけで、デザインは完全に私自身のデザインです。もし受け入れられない場合は、キャンセルしてください。NPCは独立したミニゲーム「Degree's of Lewdity」のキャラクターで、二次創作を許可されています。もし金額に問題があれば、お知らせいただければ幸いです。ありがとうございます。\n「ケイシー」は、緑がかった茶色の髪を持つ18-20歳以上のエネルギッシュで頑固な女の子です。彼女の目は外側が抹茶グリーンで、内側がアンバー色です。彼女は冒険心が強く、超自然的なこと（異常、幽霊、モンスター、バンパイアなど）に関しては少しおかしいところがあります。\n\n「エデン」は、暗い茶色の髪を持つ23-30歳以上の冷静で実践的、そして少し頑固な男性です。彼の目はダークグリーンと茶色が混ざっています。顔には二つの傷があり、ケイシーよりも肌の色が暗いです。彼の髪はダークブラウンで、結ぶことも下ろすこともできます。彼は森の中に住み、異常を狩るハンターです。顔に傷跡やひげを加えても全然問題ありません！\n彼らの髪型や服装や全部変更しても構いませんので、どうぞご自由にしてください。\n\nお互いの感情と接し方：\nエデン→ケイシー（彼女はうるさくてエネルギーがありすぎる、迷惑だ）\nケイシー→エデン（退屈な老人、全然冒険心がない…まるで彫像のようで嫌いだ）\n参考：\nhttps://skeb.jp/@JAM_____jjj/works/4\n\nこれはお任せの依頼ですので、表情や服装など、自由に選んでいただければ幸いです。お読みいただき、ありがとうございます^^\n\nhttps://drive.google.com/drive/folders/1sO6dq6IvsUPsEaMNn43DWzy720qv79DL?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hu_ufuu/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3291794, "client_id": 187973, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/272c8b5f/uploads/origins/fce5de6f-b540-4b5e-a6af-8dc4f948ce10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ade38dca9b212730f4b40245af6054a", "srcset": "https://si.imgix.net/272c8b5f/uploads/origins/fce5de6f-b540-4b5e-a6af-8dc4f948ce10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ade38dca9b212730f4b40245af6054a, https://si.imgix.net/272c8b5f/uploads/origins/fce5de6f-b540-4b5e-a6af-8dc4f948ce10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bac937dfbb25d63c11beb788cceaa92d 2x, https://si.imgix.net/272c8b5f/uploads/origins/fce5de6f-b540-4b5e-a6af-8dc4f948ce10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ba749e90ca9988a5a6e4de78abf9c94 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/272c8b5f/uploads/origins/fce5de6f-b540-4b5e-a6af-8dc4f948ce10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe746b6bde4fb22897125b887d6b4728", "srcset": "https://si.imgix.net/272c8b5f/uploads/origins/fce5de6f-b540-4b5e-a6af-8dc4f948ce10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe746b6bde4fb22897125b887d6b4728, https://si.imgix.net/272c8b5f/uploads/origins/fce5de6f-b540-4b5e-a6af-8dc4f948ce10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bbc6cbae12c86c50ed7673b4fb98e806 2x, https://si.imgix.net/272c8b5f/uploads/origins/fce5de6f-b540-4b5e-a6af-8dc4f948ce10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a8ed326754170a1227e4af8c0fbac097 3x"}, "body": "はじめまして！あなたの作品はとてもかわいいですね！\n\nこの二人のオリジナルキャラクターのイラストを描いていただけませんか？ヴィクトリア朝（1890年代）のホラー設定です。家がなく、一緒に路上生活をしている親友です。\n\n茶髪の少年シェイは物静かで、普段は無表情か、小さく謎めいた笑みを浮かべている。アロイスをとても大切にしている。\n金髪の少年アロイスは大胆でおしゃべり。彼の表情はいつも満面の笑みだ。シェイをとても愛している。\n\n怖いお化け屋敷を探検しているシーンを描いていただけますか？家の中には怖いモンスターが隠れています。\n\n使用目的SNS、OC活動、個人的な閲覧のための印刷のみ\n\nいずれにせよ、私のリクエストを読んでいただき、本当にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1uV4UtcsimuwnNtJvnj3WmLZ-heBRzsN9?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hu_ufuu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3291794, "client_id": 2333635, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0da39615/uploads/origins/5cb048c0-391c-452f-a56e-6ab2507bfa3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d554c14f39f1a75731099164d6ad98b", "srcset": "https://si.imgix.net/0da39615/uploads/origins/5cb048c0-391c-452f-a56e-6ab2507bfa3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d554c14f39f1a75731099164d6ad98b, https://si.imgix.net/0da39615/uploads/origins/5cb048c0-391c-452f-a56e-6ab2507bfa3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c4a878f7569d13ad528397bec5ed9fe 2x, https://si.imgix.net/0da39615/uploads/origins/5cb048c0-391c-452f-a56e-6ab2507bfa3d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39caa9abb227847271e775dc6cd60e88 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0da39615/uploads/origins/5cb048c0-391c-452f-a56e-6ab2507bfa3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=adf218b81d687b5ed89fe374670bde48", "srcset": "https://si.imgix.net/0da39615/uploads/origins/5cb048c0-391c-452f-a56e-6ab2507bfa3d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=adf218b81d687b5ed