t/ae028ada/uploads/origins/17c85d1f-7bbf-4121-86bb-53dcf8cc6906?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ff107df3e36c5e94fc7bb8282a2b8071 2x, https://si.imgix.net/ae028ada/uploads/origins/17c85d1f-7bbf-4121-86bb-53dcf8cc6906?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ffd6048ed0031f992b163ff5d081cb38 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1502615, "nc": 129}, {"path": "/@harusame_298yen/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1502615, "client_id": 3037589, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c3231a4/uploads/origins/b2bece52-1d50-474d-a544-608437e97a56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07e559fb774704b14dae03d8bfcc8660", "srcset": "https://si.imgix.net/6c3231a4/uploads/origins/b2bece52-1d50-474d-a544-608437e97a56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07e559fb774704b14dae03d8bfcc8660, https://si.imgix.net/6c3231a4/uploads/origins/b2bece52-1d50-474d-a544-608437e97a56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=319c12824b2556292a887b4252ef0bf0 2x, https://si.imgix.net/6c3231a4/uploads/origins/b2bece52-1d50-474d-a544-608437e97a56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7082961d998f78683201fad493d27f1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c3231a4/uploads/origins/b2bece52-1d50-474d-a544-608437e97a56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d331ab8f5b6b004dd461c32083dce5e6", "srcset": "https://si.imgix.net/6c3231a4/uploads/origins/b2bece52-1d50-474d-a544-608437e97a56?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d331ab8f5b6b004dd461c32083dce5e6, https://si.imgix.net/6c3231a4/uploads/origins/b2bece52-1d50-474d-a544-608437e97a56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=19ca8fd8c3497f5d449bde4863394347 2x, https://si.imgix.net/6c3231a4/uploads/origins/b2bece52-1d50-474d-a544-608437e97a56?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=942c890e2eb3852f36d4c5ade26f292d 3x"}, "body": "はるさめ様 \nうたたねプロダクション所属VTuberの海月ひなつと申します。 \n以前Skebの新着ではるさめ様のイラストを拝見し、暖かくて鮮やかな塗り、生き生きとした表情がすごく素敵だなと思っておりました。\n\n  ◾︎依頼内容(簡易) \n海月ひなつのイラストを描いていただきたいです。\n (YouTubeのチャンネル登録者数が年内目標の3000人を達成しそうなので、自分へのお祝いと、応援してくださっているリスナーさんたちへの感謝を込めて…！と思っております) \n\n ◾︎使用用途 \n・収益化済みYouTubeのサムネイル \n・Xへの掲載(おはよう/おやすみVTuberを始めとした、Xでの活動での使用) \n・ネットプリント \n・グッズ化(商用利用)  \n\n※Xへの掲載は、先日の規約改定を踏まえ、基本的にはウォーターマーク＋トーン掛けをした上で投稿しております\n\n  ◾︎イラスト詳細 \n・背景と人物を分けたPSD、もしくは透過pngのどちらかで納品いただけると、活動に使用しやすくて嬉しいです…！ \n・向きは縦/横どちらでも大丈夫なのですが、長辺が2000pxを超えるサイズ感だと、活動各所で使用しやすくて助かります(上限は無し) \n・カメラ目線 \n・描画範囲は可能であれば全身だと嬉しいですが、金額内で描いていただければと思います。\n ・表情差分があると、活動で色々と使用出来そうなので助かります。が、こちらも金額の範囲内でお願い出来ればと思います…！\n\n  はるさめ様のイラストで特に好きなのは、\n ・クマちゃんのイラスト(Skeb)\n ・りりむちゃんと委員長のイラスト(X) \n・健屋花那ちゃんのイラスト(X) \n(下2つはXの「みんなこういうピンクが好きなんでしょ」のハッシュタグで投稿されていたものです…！)  です。 \n\n寒色系の姿なのに、好きな例として挙げるイラストが暖色系のものばかりになってしまって申し訳ないのですが、\n 思いっきり可愛く描いていただけると嬉しいです！(ハートを作ったり、お顔にぐーで手を添えるなど、何かしらお手手に動きをつけていただけると可愛いな…と思っております！) \nお洋服については、資料URL内にあります、ケープありの姿でお願いいたします。\n\n  ◾︎海月ひなつについて \n・キャッチフレーズは「インターネットの海と世界を揺蕩うクラゲ」\n ・一人称は「僕」ですが、人間の性別にこだわりがないだけで、性別としては女の子です！\n ・ミズクラゲがモチーフのVTuberです。南の海出身/在住で、暖かいお日様や優しい月の光のような、誰かの居場所になれる配信ができるように…と思い活動しています。 \n・ファンマークは太陽とビーチパラソルです。 穏やかな南の海と、暖かいお日様のような…というところから来ています。\n ・見た目に反して、お姉さん感のあるハスキーボイスですが、ポンもそれなりにします…が、自称はしっかり者の清楚で可愛いミズクラゲ！です。\n ・元はデフォルメの姿(「小さい僕」)なのですが、リスナーさんたちの応援やクリエイター様方の力を借りて、等身の姿になっています。\n ・高評価が増えたりチャンネル登録が増えたりすると「ありがと！ちゅっ(投げキッス)」と言うのですが、その後にどうしても照れてしまったり、「よしっ」と言ってしまいます(素で投げキッスなどができるような性格ではないです…アイドル系というよりは、本当に「近所のお姉さん」タイプだと思います) \n・配信の内容はゲーム実況、歌枠、雑談がメインです。基本的に何をしていてもずっと喋り続けられるタイプで、かつゲラなので、割と常にニコニコ笑顔です。\n・笑顔以外にも、アニメ「葬送のフリーレン」の同時視聴で号泣するなど、割と感情豊かなのですが、唯一ホラゲーはまったく怖がらず、8番のりばを15分ほどでクリアし、悲鳴がまったく上がらないことが多いです。\n ・音楽と言葉が大好きです。 \n・ミズクラゲの寿命がだいたい1年で、1年に1回死と生まれ変わりを繰り返しています。(記憶は引き継ぎしていますが、曖昧なことも多いです)  \n\n長々と自分自身について書いてしまいましたが、はるさめ様の可愛らしいイラストが本当に大好きなので、 はるさめ様の思う、可愛い海月ひなつを描いていただけますと幸いです。\n  使用用途に不可なものございましたら、遠慮なくキャンセルください。  \n\nご検討、どうぞよろしくお願いいたします。  https://drive.google.com/drive/u/1/folders/1HP_YouQiKkfbwuDDfu3U0mQ7bnHVzXAV\n\nhttps://drive.google.com/drive/u/1/folders/1HP_YouQiKkfbwuDDfu3U0mQ7bnHVzXAV", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@harusame_298yen/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1502615, "client_id": 2850105, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a6e12f7b/uploads/origins/5c1d59f2-5510-4360-9c1b-ded5c93eea17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d622f705064796a15b09b2320586696", "srcset": "https://si.imgix.net/a6e12f7b/uploads/origins/5c1d59f2-5510-4360-9c1b-ded5c93eea17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d622f705064796a15b09b2320586696, https://si.imgix.net/a6e12f7b/uploads/origins/5c1d59f2-5510-4360-9c1b-ded5c93eea17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d5ec7c96ce7812918a2255e8266b9f69 2x, https://si.imgix.net/a6e12f7b/uploads/origins/5c1d59f2-5510-4360-9c1b-ded5c93eea17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f118a9463c746ca3a49915db9b0f876 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a6e12f7b/uploads/origins/5c1d59f2-5510-4360-9c1b-ded5c93eea17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top