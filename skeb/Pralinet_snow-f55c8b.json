c18d-92be-4dc6-aa99-24009229c3b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38ee459d107494393e363cb9b4d39f4c, https://si.imgix.net/6d06c437/uploads/origins/1e7cc18d-92be-4dc6-aa99-24009229c3b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb7d3e91109890ed8278297eb2aa67b2 2x, https://si.imgix.net/6d06c437/uploads/origins/1e7cc18d-92be-4dc6-aa99-24009229c3b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4c91d07ddbe9f09f385218d32424d03 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6d06c437/uploads/origins/1e7cc18d-92be-4dc6-aa99-24009229c3b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3eec355630ae1fefa37cbe33c15c913", "srcset": "https://si.imgix.net/6d06c437/uploads/origins/1e7cc18d-92be-4dc6-aa99-24009229c3b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3eec355630ae1fefa37cbe33c15c913, https://si.imgix.net/6d06c437/uploads/origins/1e7cc18d-92be-4dc6-aa99-24009229c3b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=baa533209fe26f851f7a25148a9cc007 2x, https://si.imgix.net/6d06c437/uploads/origins/1e7cc18d-92be-4dc6-aa99-24009229c3b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=50e2a0d7ae3afdb16968da47e1d23caf 3x"}, "body": "こんばんは、いつも素敵なイラストを拝見させていただいております。是非イラストをお願いしたく、私の大好きな極寒着膨れと言うジャンルのイラストをリクエストします\n\n金髪九尾な狐娘ちゃんが、物凄く寒い場所で、全身を防寒着でモッフモフに着膨れながら凍って行く感じのイラストをお願いしたいです。\n例えば今から想像もつかない極寒の地に放り出されると言われ、凍えないように暖かそうな防寒着をひたすら重ねて着込んだような、モフモフの着膨れ姿をお願いします。\n\nシチュエーションは世界が終わるほどの雪、雪、雪。極寒と豪雪の地獄のような大寒波の中、ありったけの防寒具をモッコモコに着込み、ガッチガチに凍ってしまう感じの雰囲気でお願いします\n\n雪国のような分厚く耐寒性の高い、ふわふわな防寒着と言うイメージで着込ませて欲しいです、全体的なデザインはお任せします。\n着込ませ過ぎだと思うその8割増しくらいのモフモフ着膨れ加減でお願いしたいです。凄く寒い所で、モフモフした防寒着を大量に着込む女の子が大好きなので、本当に……\n\nまた、描写が可能であれば場所は凄く寒そうな場所、雪や氷に覆われた世界観でお願いします、寒さの表現として防寒着にはつららや霜、体に雪等を積もらせて頂ければ嬉しいです\n可能な限りの防寒着を着込んでもなお凍りつくような寒さ、そんなイメージが大好きなので……\nまつ毛や吐息が凍りつく程の寒さで、口や目からつららや涙のつらら等の描写も入れて下さると嬉しいです(もっと寒くても良いです！！！)\n\n狐の耳と尻尾についてですが、耳は防寒着を邪魔しない程度に描写、または防寒具にしまう形をお願いします。\n九本の尻尾は可能であればかなり大きく描いて頂けるととても喜びます。モフモフ尻尾が大好きなので……\n\nまた、可能であれば、時間経過で雪が積もり、凍えきって身体を包む雪と氷が増え、全身がつららと氷に包まれ、樹氷のように青白く全身が凍りついてしまった様子までお願いしたいです。\n\n長々と描いてしまい申し訳ないです、かなりおまかせしてしまう部分が多く申し訳ないのですが、とにかく徹底した防寒着の盛りと全身モフモフの着膨れ、しかし、それでもガチガチに凍りついた狐娘の姿を見たいです。どうか宜しくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 19537, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "めぅ🫠skeb募集中", "screen_name": "Meun", "avatar_url": "https://pbs.twimg.com/profile_images/2038820380547420160/bU9afR3x.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1700863108259233792/1696932966/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 176}, {"id": 25671, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "尾張屋🐻", "screen_name": "owariya_ranko", "avatar_url": "https://pbs.twimg.com/profile_images/1776851816283840512/XEMd6WXo.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3083686872/1712469469/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 161}, {"id": 105753, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ねおしの", "screen_name": "neosino", "avatar_url": "https://pbs.twimg.com/profile_images/465875430788980736/5tD3u8Dh.png", "header_url": "https://pbs.twimg.com/profile_banners/33186900/1655201411/1500x500", "appea