fcac-97d4-4790-9531-6a2736d66ff6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ad9028c505bb84f1d3c239cbf76e7260 3x"}, "body": "Hello! Can you draw our character, KAMEN AMERICA, wearing a modified cheongsam dress with a gold sash around the waist? Please see the reference photos for inspiration: red, white, blue, and gold, short skirt, no boots or gloves. She can wear a mask or not depending on your preference. Background can be somewhere lively, like Las Vegas at night with fireworks in the sky. Thank you!\n\nhttps://www.dropbox.com/sh/ys91zo7c79sqv89/AAA9JisUbqi8CLUpysLQYszEa?dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nms_otsukimi9/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 223989, "client_id": 1407934, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b408c97/uploads/origins/3d7e6369-4faf-492e-8012-2f3434411011?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2195f0c87e2cd32345fabf3a7c8517be", "srcset": "https://si.imgix.net/5b408c97/uploads/origins/3d7e6369-4faf-492e-8012-2f3434411011?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2195f0c87e2cd32345fabf3a7c8517be, https://si.imgix.net/5b408c97/uploads/origins/3d7e6369-4faf-492e-8012-2f3434411011?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d5eb68a5c513dbdc5d6c7b66889385ec 2x, https://si.imgix.net/5b408c97/uploads/origins/3d7e6369-4faf-492e-8012-2f3434411011?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67576fbc240018b23e1b10fb90d7b3c4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b408c97/uploads/origins/3d7e6369-4faf-492e-8012-2f3434411011?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36a387