良い\n\n・2人の関係性\n同じ学校に通っていて仲良しです\n彼女が大好き\n彼女に対してはわりとかっこつけだが、男同士の場だと軽口も叩くし口も悪め\n\n\n ・使用用途 　\n頂いたイラストはSNSアイコンや参考資料への追加pc背景に使用したいと思っています。\n  \n\nもし難しいようでしたら断っていただいて大丈夫です。\nアピールから拝見してとっても好きな絵柄なのでどうぞご縁がありましたらよろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@C2Rcm/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3644699, "client_id": 1448010, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/64b55bcc/uploads/origins/7fdbf227-f38f-438e-96ee-f2a2a93b415f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fac468d7bcdcf06383d8ffab9bd8a058", "srcset": "https://si.imgix.net/64b55bcc/uploads/origins/7fdbf227-f38f-438e-96ee-f2a2a93b415f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fac468d7bcdcf06383d8ffab9bd8a058, https://si.imgix.net/64b55bcc/uploads/origins/7fdbf227-f38f-438e-96ee-f2a2a93b415f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=575624d6b17082a59bf786dc0b641076 2x, https://si.imgix.net/64b55bcc/uploads/origins/7fdbf227-f38f-438e-96ee-f2a2a93b415f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=03c5605bd24c24d376cb29aa92f2eafd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/64b55bcc/uploads/origins/7fdbf227-f38f-438e-96ee-f2a2a93b415f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ce35df0dbec2d328cb7e28bfafb683f", "srcset": "https://si.imgix.net/64b55bcc/uploads/origins/7fdbf227-f38f-438e-96ee-f2a2a93b415f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ce35df0dbec2d328cb7e28bfafb683f, https://si.imgix.net/64b55bcc/uploads/origins/7fdbf227-f38f-438e-96ee-f2a2a93b415f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=485bdce1299100b