//si.imgix.net/c8186d6c/uploads/origins/63f9f0f7-8ceb-4622-8a6e-7c23bce14763?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=313e1f5ef01e318d27f9ebc1b8d401f2 3x"}, "body": "初めまして、ごばぁさんのお描きになるテキサスがとても可愛らしくて好きでしたのでリクエストをさせて頂きたいです。\nごばぁさんのお描きになられたしょたドクシリーズが大変素晴らしいと感じたためリクエスト内容としては\n仏頂面のテキサス（ペンギン急便の服装）がソファにうつ伏せで雑誌を読んでくつろいでいると背後からショタドクターがテキサスの上にいきなりのし掛かり何を読んでいるのかを尋ねるとテキサスから「重いからまず降りろ」と叱られたショタドクターが怒ってのし掛かったままテキサスの腋の下や脇腹をくすぐり回して仕返しをすると言った内容でお願い致します。\nテキサスの表情は最初はなんとか我慢しようとするも耐えきれず涙目になりながら口を大きく開けて大爆笑するといった形でお願いします。\n\nご検討の程よろしくお願い致します。", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gobilidakedo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2731880, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89d7b406/uploads/origins/8efb8fa2-ed19-4456-a24b-7932bb5429b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d946263e0573fe442d1899469510c31", "srcset": "https://si.imgix.net/89d7b406/uploads/origins/8efb8fa2-ed19-4456-a24b-7932bb5429b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d946263e0573fe442d1899469510c31, https://si.imgix.net/89d7b406/uploads/origins/8efb8fa2-ed19-4456-a24b-7932bb5429b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=588121052bad72332f70336323c00c23 2x, https://si.imgix.net/89d7b406/uploads/origins/8efb8fa2-ed19-4456-a24b-7932bb5429b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e52a9f6ded91966e53c706897dbc81f4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/89d7b406/uploads/origins/8efb8fa2-ed19-4456-a24b-7932bb5429b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5defed76de6c693aea4aac7081d9ade0", "srcset": "https://si.imgix.net/89d7b406/uploads/ori