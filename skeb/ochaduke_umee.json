て欲しい\n・服装はスーツの立ち絵のもの\n・幸せそうな雰囲気・表情(大まかな構図はお任せします)\n以上でお願いいたします。\n\nskebも依頼も初めてなので不手際がありましたら申し訳ございません...！！何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Ds6AhrWS8pkBKcCYGhM4RZE0NUdIji_F", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ochaduke_umee/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/766c8e97/uploads/origins/24efb818-aab9-4257-b61b-cd015cd4301c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f7849f0f4921320909303afa9833bc8b", "srcset": "https://si.imgix.net/766c8e97/uploads/origins/24efb818-aab9-4257-b61b-cd015cd4301c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f7849f0f4921320909303afa9833bc8b, https://si.imgix.net/766c8e97/uploads/origins/24efb818-aab9-4257-b61b-cd015cd4301c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b2592c78c2f0997a0c7c597a623b6389 2x, https://si.imgix.net/766c8e97/uploads/origins/24efb818-aab9-4257-b61b-cd015cd4301c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a1170f04926dc2d4917fd6ebd4d57d91 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 797263, "client_id": 2652442, "nc": 1}, {"path": "/@ochaduke_umee/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 797263, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/47d6fb06/uploads/origins/e1d7abd5-b2dc-4f8a-928f-2fd8f070b79f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0490224d17d2