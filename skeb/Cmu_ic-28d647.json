=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b10c258a070e2b2bca683c8664adc148, https://si.imgix.net/96017dc6/uploads/origins/f7fdda34-0fab-423b-9459-17e596856674?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d52aea0c4da9d71fc5e3be0e25f3ed5 2x, https://si.imgix.net/96017dc6/uploads/origins/f7fdda34-0fab-423b-9459-17e596856674?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0d6386c20a81e70851e998acba198da 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96017dc6/uploads/origins/f7fdda34-0fab-423b-9459-17e596856674?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=330a38bcb8e6ebe352f66506a8b039a3", "srcset": "https://si.imgix.net/96017dc6/uploads/origins/f7fdda34-0fab-423b-9459-17e596856674?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=330a38bcb8e6ebe352f66506a8b039a3, https://si.imgix.net/96017dc6/uploads/origins/f7fdda34-0fab-423b-9459-17e596856674?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1921a8f90d1a70bde1038dfb90fb2661 2x, https://si.imgix.net/96017dc6/uploads/origins/f7fdda34-0fab-423b-9459-17e596856674?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1a1f21192e8fd2e65c5fed063ea9b8fa 3x"}, "body": "こんにちは、うまきさんのイラスト大好きです。この度はうまきさんにOCのキャラクターデザインをして頂きたいです。\n\n【使用用途】\n・プロフへの使用、SNS掲載\n・他のクリエイター様へのご依頼\n・OC(代理)としての使用\n　（↳本格的な活動予定はまだありませんが趣味程度でやっている歌ってみたでキャラを使用する可能性があります）\n\n【キャラクターデザイン】\nうまきさんがデザインしたものであれば全て愛せるため特に指定はございませんが、メインカラーは青と緑意外だと助かります。(この色もとても可愛いですが今回はそれ以外のお色味でお願いしたいので)\nそれ以外は全く指定はありません。モチーフ、髪型、お衣装などうまきさんの好きを詰め込んで自由に描いて頂けたら嬉しいです！\n\nもしアイデアが思い浮かばなければ、下記のいずれかをモチーフにデザインして頂ければと思います。\n\n・動物(犬、猫、熊、兎)\n・天使\n・シュークリーム\n・苺\n・目玉焼き\n\n※できる限りうまきさんなりのデザインが見たいので本当に思いつかなかったらで大丈夫です！\n\n【その他】\n自分自身でも描いてみたい＆他の絵師様に依頼する予定もあるため、こだわりポイントや忘れて欲しくない箇所などございましたらそちらも一緒にお願いします。\nまた、うまきさんさえ宜しければ没案や没ラフ等もありましたらそれをおかずに白米が食べられるため一緒に入れてくださると嬉しいです。\n\n- - - - - - - - - - - - - - - - - \n\n以上になります。お忙しいところ恐縮ですが、ご検討頂けますと幸いです。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Cmu_ic/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9a6276b8/uploads/origins/ed47c1a7-6007-4443-b342-fccf055861f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b23c435ebe81fcec90b9a1792d2a7ef", "srcset": "https://si.imgix.net/9a6276b8/uploads/origins/ed47c1a7-6007-4443-b342-fccf055861f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b23c435ebe81fcec90b9a1792d2a7ef, https://si.imgix.net/9a6276b8/uploads/origins/ed47c1a7-6007-4443-b342-fccf055861f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=70253f5e48b4077738721dbbceeb39d4 2x, https://si.imgix.net/9a6276b8/uploads/origins/ed47c1a7-6007-4443-b342-fccf055861f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53c732bcabc650a9acfaca8768b09d18 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3965314, "client_id": 2854420, "nc": 128}, {"path": "/@Cmu_ic/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/58859481/uploads/origins/7b623065-e497-490a-bd98-46b730f05b40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91082e4693b0c8b86f48dc5f29f5ac50", "srcset": "https://si.imgix.net/58859481/uploads/origins/7b623065-e497-4