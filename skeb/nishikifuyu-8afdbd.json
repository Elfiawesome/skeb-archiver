 "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nishikifuyu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1387355, "client_id": 27685, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/746efaa4/uploads/origins/8d9d35bc-94fd-48fc-babb-e1cf8ec82bfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59d52181f7f040b15173cea9194058ed", "srcset": "https://si.imgix.net/746efaa4/uploads/origins/8d9d35bc-94fd-48fc-babb-e1cf8ec82bfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59d52181f7f040b15173cea9194058ed, https://si.imgix.net/746efaa4/uploads/origins/8d9d35bc-94fd-48fc-babb-e1cf8ec82bfe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bab33271c83d4a9363f482af15d16a94 2x, https://si.imgix.net/746efaa4/uploads/origins/8d9d35bc-94fd-48fc-babb-e1cf8ec82bfe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ea309fb3a33aa38a17413832c161f01 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/746efaa4/uploads/origins/8d9d35bc-94fd-48fc-babb-e1cf8ec82bfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=975172e0cebbe61597441a91148044fa", "srcset": "https://si.imgix.net/746efaa4/uploads/origins/8d9d35bc-94fd-48fc-babb-e1cf8ec82bfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=975172e0cebbe61597441a91148044fa, https://si.imgix.net/746efaa4/uploads/origins/8d9d35bc-94fd-48fc-babb-e1cf8ec82bfe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1b79ecb6797134f2e6e668577cf95423 2x, https://si.imgix.net/746efaa4/uploads/origins/8d9d35bc-94fd-48fc-babb-e1cf8ec82bfe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f30fabac04abf0d58014aea0ef624e38 3x"}, "body": "にしきふゆ様\n\nこんばんは、つい最近にしきふゆ様のファンになった人です。\nこの前のナース服の子のイラストのポーズや色合いから感じられるにしきふゆ様のセンスがすごく良くて、それからツイッターの他のイラストたちも見させておりました。\n８月のケモミミちゃんやキョンシーちゃんのコミッション絵は最高でした！本当に、眼福の極みです。こんな絵を描いてくださりありがとうございます。\nそれで、どうかうちの娘をにしきふゆ様の絵で見たくなり、突然ながら依頼を申し上げます。\n\nお願い申し上げたいのは私のツイッターのプロフ絵とヘッダーにいるオリキャラ狐娘の万里香（まりか）という子です。\n狐耳と尻尾・赤メガネ・アホ毛、そしてちょっぴりツリ目な目つきが特徴的な、160cmくらいの身長の高校生で、シャツ・スカート・ニーソの制服姿を基本にしてます。\n本に、動物や花、星空のような自然をぼーっと見るのが大好きな子です。\n好きなくせに自分に近づく犬や人は苦手で怖がります。でも虫やおばけには大丈夫そうな娘、って感じです。\nそんな人見知りで照れ屋ですので外では余計に固くなりクールっぷりしてるけどまた寂しがり屋のちょっと面倒くさい感じです。知り合いの前では表情が緩めてちょっと豊かになる感じです。\n文字だけでは説明が足りない気がして設定画などのご参考のできる素材を下のURLにつけます。\n\nもしよろしければ、この娘をにしきふゆ様の絵柄で依頼したいです。\n基本的には落ちついた色合いの制服の子ですが、どうかにしきふゆ様のポップな色のセンスの絵がみたいですので、設定画にいる他の衣装を選んだり、アレンジしてくださったりしてくださっても大丈夫です！\n表情は微笑みや笑顔でお願いします。ポーズや構図などはおまかせします！\n\n要件のみの依頼で申し訳ありません。\n応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nishikifuyu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1387355, "client_id": 223872, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09591ecf/uploads/origins/14732c63-1223-4ae4-9935-b30db085481e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9e75385879e12b73d44f93a2f641231", "srcset": "https://si.imgix.net/09591ecf/uploads/origins/14732c63-1223-4ae4-9935-b30db085481e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9e75385879e12b73d44f93a2f641231, https://si.imgix.net/09591ecf/uploads/origins/14732c63-1223-4ae4-9935-b30db085481e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a1cecec5127349441360eaeee21384ec 2x, https://si.imgix.net/09591ecf/uploads/origins/14732c63-1223-4ae4-9935-b30db085481e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0d9aa9e41ed71726cad4c71bb5ff