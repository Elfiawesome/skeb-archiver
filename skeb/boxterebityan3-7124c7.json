8bd-4b7d-4c01-8a19-6dd5adfc08e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe110ea20976c1743fbcfd154456abe8, https://si.imgix.net/90b508e7/uploads/origins/23afb8bd-4b7d-4c01-8a19-6dd5adfc08e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c44b0b0463a1130d348bd9eda832ed86 2x, https://si.imgix.net/90b508e7/uploads/origins/23afb8bd-4b7d-4c01-8a19-6dd5adfc08e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fc65d05ced8688513653ded5b830943f 3x"}, "body": "初めまして。個人でVtuberをしております、十六夜（いざよい）めあと申します。\n\nXであさげ様のイラストをお見かけし、とても可愛らしく素敵な雰囲気なイラストだと思い依頼させていただきます…！\n\nー依頼内容ー\n\n・キャラクター\n私、十六夜めあを描いていただきたいです。\n自堕落を自称している吸血鬼で、睡眠が好きです。女性です。\n見た目は落ち着いていますが、よく喋りよく笑います。\n喋りが「〜だぞ」「〜だろ」となっており、少々特徴的です。\n\n・見た目などの詳細\nGoogleドライブのURLを添付いたしますので、そちらをご確認いただけましたら幸いです。\n\n・構図やポーズなど\nお任せいたします。髪型や衣装なども、資料のものとは別でも構いません。\nかっこいいよりは可愛い寄りの雰囲気だと嬉しいです！\nもし金額内で可能でしたら表情差分などを別レイヤーでいただけると嬉しいです。\n\nサムネイルなどで使わせていただきたいため、髪の毛などが切れないような構図にしていただけるととても助かります。\nまた、人物のみの透過をいただけると嬉しいです。\n\n・使用用途\n収益化済みのYouTubeでのサムネイルやShorts動画への使用、Xでのポストへの使用を考えております。\n\n依頼内容に関して、以上となります。\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1-qlhAFlYxvzSEU318D-14e3BPZpQmcPs", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@boxterebityan3/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3210435, "client_id": 1690162, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7017ecd4/uploads/origins/1dc5cf85-c3b3-4b4c-9b2f-78f072db7067?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=feae7fd2216b782dacfde07be146cbb8", "srcset": "https://si.imgix.net/7017ecd4/uploads/origins/1dc5cf85-c3b3-4b4c-9b2f-78f072db7067?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=feae7fd2216b782dacfde07be146cbb8, https://si.imgix.net/7017ecd4/uploads/origins/1dc5cf85-