=top&w=200&h=200&s=1de0186c5c3bee824427324991fe7541 2x, https://si.imgix.net/694004cf/uploads/origins/3e225a41-17e0-4f4f-8ad9-8a862605a28a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=22c6bd482b63fcf37278671e9e1cec53 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/694004cf/uploads/origins/3e225a41-17e0-4f4f-8ad9-8a862605a28a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=888b3daab3012eb43b86a5847eedc5c8", "srcset": "https://si.imgix.net/694004cf/uploads/origins/3e225a41-17e0-4f4f-8ad9-8a862605a28a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=888b3daab3012eb43b86a5847eedc5c8, https://si.imgix.net/694004cf/uploads/origins/3e225a41-17e0-4f4f-8ad9-8a862605a28a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b401bd40aa34cffe282ef9c8f38c86e5 2x, https://si.imgix.net/694004cf/uploads/origins/3e225a41-17e0-4f4f-8ad9-8a862605a28a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1ea99ad604a0e5a683c28d3a18df55b8 3x"}, "body": "はじめまして。\nhttps://skeb.jp/@ryrrrrrrrrr/works/2 のデカパイ誘惑シチュに惹かれたので依頼させていただきます。\n\n遊戯王OCGのライトローミディアム(おっぱい増量)が性的に誘ってくるシチュエーションのイラストをお願いしたいです。\n\nライトローミディアム資料\nhttps://twitter.com/YuGiOh_OCG_INFO/status/1476825454287867904\n\n以下細かい要望です。\n・胸は普段描かれている絵くらいに盛って下さい。\n・ポーズ、構図などはお任せします。\n・ライトローミディアムの①の効果は誘惑して自分にお触り(攻撃強制)させる、②の効果は抱きしめて動きを封じ(攻撃無効)て射精させる(ダメージを与える)、というようなイメージで解釈しています。\n　ですので、「この柔らかおっぱい、好きなだけ触って良いんだよ…♡」「私弱いから、君みたいなたくましい腕で襲われたら抵抗できないなあ…♡」のようなお触り(攻撃)を誘うようなセリフを付けて頂きたいです。\n　(上記のセリフはあくまで方向性のイメージなので書きやすいように変えていただいて構いません)\n・乳首は浮かせるかモロ出しにするかして欲しいです。\n\n以上です。よろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ryrrrrrrrrr/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1032630, "client_id": 76720, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09008c83/uploads/origins/15846e53-f9a3-42fa-8487-8c92091325c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21a51f5bce0f8ff14bf05839f449f464", "srcset": "https://si.imgix.net/09008c83/uploads/origins/15846e53-f9a3-42fa-8487-8c92091325c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=21a51f5bce0f8ff14bf05839f449f464, https://si.imgix.net/09008c83/uploads/origins/15846e53-f9a3-42fa-8487-8c92091325c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6bfea7a7596d04e9cd1ed4688e4fadcc 2x, https://si.imgix.net/09008c83/uploads/origins/15846e53-f9a3-42fa-8487-8c92091325c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c3ce6ff72e6dd1eac611f388d479fbf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/09008c83/uploads/origins/15846e53-f9a3-42fa-8487-8c92091325c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=881b15573f1f4a3541ccd3cf3d637df3", "srcset": "https://si.imgix.net/09008c83/uploads/origins/15846e53-f9a3-42fa-8487-8c92091325c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=881b15573f1f4a3541ccd3cf3d637df3, https://si.imgix.net/09008c83/uploads/origins/15846e53-f9a3-42fa-8487-8c92091325c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e684e448ce1fc34a4c2d13f86d22bd33 2x, https://si.imgix.net/09008c83/uploads/origins/15846e53-f9a3-42fa-8487-8c92091325c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a32bd15ca73c4186c6c998eb0cb6a4cb 3x"}, "body": "絵違いのキスキル・リィラの依頼絵めっちゃよかったです。その絵の続きをお願いしたいです。\n\n絵違い版キスキル・リィラの二人が生おっぱいを見せつけてきて挑発してくるのが見たいです。前の依頼絵ぐらい爆乳でお願いします「ほーら、ご主人がチラチラ見てたデカパイだぞ〜❤️うれしいか？」「ガン見しちゃって❤️触っていいっ言ってんじゃん❤️おっぱいモミモミしてみろよオラッ❤️」など攻め攻めな淫語でこちらを挑発してくれると嬉しいです。淫語などは変換したり増量してくれるとなお嬉しいです。\n\n是非ご検討お願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ryrrrrrrrrr/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1032630, "client_id": 1826484, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5e3c9cf7/uploads/origins/407a1de2-f45c-4ade-953a-413563a52bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4dd45de7b8e0effb69fd76f1baddfa67", "srcset": "https://si.imgix.net/5e3c9cf7/uploads/origins/407a1de2-f45c-4ade-953a-413563a52bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4dd45de7b8e0effb69fd76f1baddfa67, https://si.imgix.net/5e3c9cf7/uploads/origins/407a1de2-f45c-4ade-953a-413563a52bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb24fc85be26349947cff34342b1916b 2x, https://si.imgix.net/5e3c9cf7/uploads/origins/407a1de2-f45c-4ade-953a-413563a52bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=29e15115b3aaad81a76ff2fcf625060e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5e3c9cf7/uploads/origins/407a1de2-f45c-4ade-953a-413563a52bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7662fa1f7618462b02cf6828db5dde9", "srcset": "https://si.imgix.net/5e3c9cf7/uploads/origins/407a1de2-f45c-4ade-953a-413563a52bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7662fa1f7618462b02cf6828db5dde9, https://si.imgix.net/5e3c9cf7/uploads/origins/407a1de2-f45c-4ade-953a-413563a52bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=13cf92aac309d7812ffeb11a2dba5ea3 2x, https://si.imgix.net/5e3c9cf7/uploads/origins/407a1de2-f45c-4ade-953a-413563a52bc8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=to