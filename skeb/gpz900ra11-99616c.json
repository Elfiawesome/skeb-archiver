なびく日\n人参が好きなお姫様が建物の窓から眺めており\n街の活気を聴きながらリラックスしてる。\n\nお姫様の参考資料URL（使用許可取ってます）\nhttps://twitter.com/DesertGreatSo2/status/1174259388850290690/photo/1\n\n音楽でどう作ってほしいのかというと　ゆったり　楽しい　のんびり…と表してほしいのですが\nwataruさんの作った曲を聴き比べていたら色々悩んでしまい聴いた中で以下のwataruさんが作った曲のリズムで作っていただきたいです。\nストロベリースムージー　That's the way\n\n色々注文してしまって申し訳ありません。\nよければお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 269832, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Ak!La@一次創作", "screen_name": "Kasser1275paint", "avatar_url": "https://pbs.twimg.com/profile_images/1688781746337447936/bEW3X48N.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4757931998/1738337607/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "novel"}, {"genre": "correction"}], "banned": false, "nc": 0}, {"id": 405628, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "かち割り氷 K-Ice@氷幻舎", "screen_name": "kachiwari_1016", "avatar_url": "https://pbs.twimg.com/profile_images/1866107826688724992/gcVPXKuT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/62302869/1610784061/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 15, "skills": [{"genre": "music"}, {"genre": "correction"}], "banned": false, "nc": 16}, {"id": 1304911, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "S405//SHOGO | BGM Comms Open", "screen_name": "S405", "avatar_url": "https://pbs.twimg.com/profile_images/1685093149713268736/-SB2Gzkl.jpg", "header_url": "https://pbs.twimg