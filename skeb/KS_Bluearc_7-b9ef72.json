混乱が入り混じった表情で立ち尽くしている様子をお願いします。\nコンセプト：\n「勇者」としての強さを完全に封じられ、先生の腕の中に囚われて「メス」として搾り取られるアリスの無防備さと、その現実を突きつけられたケイによるドラマチックな緊張感。\n備考：\n キャラクターデザインは公式に準拠してください。\n難しい箇所があれば柔軟にアレンジしていただいて問題ありません。\n場合によっては天童ケイは居なくても大丈夫です。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 145865, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "クロスリア・フィリア@もちもちドラゴンパラフィリア系VTuber", "screen_name": "chrolia_Vtuber", "avatar_url": "https://pbs.twimg.com/profile_images/2102277452987084800/dpynIwtJ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1165685446753443840/1790073325/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "voice"}], "banned": false, "nc": 33}, {"id": 1121603, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "masso", "screen_name": "masso_nullbuilt", "avatar_url": "https://pbs.twimg.com/profile_images/1760267732136898561/ew9bHDZP.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 1490134, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "おのあ🔞@Skeb募集中", "screen_name": "acuonoa", "avatar_url": "https://pbs.twimg.com/profile_images/1770151638214619138/NMKdyoKn.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1146088428779397120/1710872051/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "comple