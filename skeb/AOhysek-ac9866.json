r=2&fit=crop&crop=top&w=200&h=200&s=0d2bd0fcc0398cc71ef4990fca451b87 2x, https://si.imgix.net/7bdc9750/uploads/origins/297dbc26-7391-4e06-9152-8825ecc4239a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6abdc5ec2f5905bd6e300bfdd101a9ff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7bdc9750/uploads/origins/297dbc26-7391-4e06-9152-8825ecc4239a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e747d0b764f74fb1d0b325483b8486d0", "srcset": "https://si.imgix.net/7bdc9750/uploads/origins/297dbc26-7391-4e06-9152-8825ecc4239a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e747d0b764f74fb1d0b325483b8486d0, https://si.imgix.net/7bdc9750/uploads/origins/297dbc26-7391-4e06-9152-8825ecc4239a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=88aa6952b32568c41dde74e6dea7b403 2x, https://si.imgix.net/7bdc9750/uploads/origins/297dbc26-7391-4e06-9152-8825ecc4239a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=17c8126836b78d238e3d8ed6434d14a8 3x"}, "body": "こんにちは、初めまして。\n貴方の描く青と水の表現に感激してリクエストを送らせていただきました。\nイラストを1枚お願いいたします。\n(先程は少し混乱を招く表現をしてしまったため依頼を再掲させていただきます）\n\n〇人物1\nhttps://thup.work/miniup/?mode=edit&id=9538\n\n〇人物2\nhttps://thup.work/miniup/?mode=edit&id=9539\n\n〇構図\nどこか幻想的な海の中、水面に向かって浮いていく人物１，水底に向かって沈んでいく人物２が互いに手を伸ばし合うけど届かない…\nという絵を、ほぼ真横からの構図で描いてほしいです。\n\n表情は、\n人物１：悲しそう。まだ一緒に居たいのにという未練\n人物２：真面目な顔。もっと一緒に居たかったという願望\n\n以上となります。\n人物１がかばんとトランプを持っていますが、なくていいです。\n\nその他詳しい構図（ボトムアップか全身像か、真横とはいうが少し傾きのある構図か…）などはお任せします。\n\n依頼内容に何か失礼があれば申し訳ありません。\nよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AOhysek/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1343575, "client_id": 1382175, "vtt_url": null, "thumbnail_imag