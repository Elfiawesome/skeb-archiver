b-b95a-c9746337a5a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=293f8e471ff36d7973655089bbc87575, https://si.imgix.net/0a4c9257/uploads/origins/3d81914a-d6b6-498b-b95a-c9746337a5a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=54d37cabe1ce056ebb777ef95e73a645 2x, https://si.imgix.net/0a4c9257/uploads/origins/3d81914a-d6b6-498b-b95a-c9746337a5a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9cdaee82a9a2e376a1c4b79b63834977 3x"}, "body": "リクエスト失礼致します。\n以前あおたま様のイラストを拝見させていただきまして、水中の描写がとても綺麗だと感じこの度依頼させていただきたく思いました。\n\nVTuberの片骨おるかさん(@Orca_katabone)を描いていただきたいです。\nもうすぐYoutubeでの活動4周年を迎えるためそのプレゼントにしたいと考えております。\n水中にいて、後ろに大きなシャチが一頭いるイラストを希望します。\n(宛名の記載は無しで構いません)\n\n資料として添付しましたリンク先に片骨おるかさんの二面図、及び本人よりSkeb依頼の許可に関する記述(注意事項欄にて)ございますのでご参照いただければと思います。\n\n尚、描いていただいたイラストを本人がサムネイル等に使用できるようお許しいただきたいです。加えて、お手数ではございますがPSDデータまたはキャラクターのみの透過PNGデータ差分を頂けますと嬉しく思います。\n\nご検討の程よろしくお願い致します。\n\nhttps://lit.link/orcakatabone", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AOhysek/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1343575, "client_id": 2840615, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/78a801f4/uploads/origins/8d60522f-d650-483a-a76b-b8a0627d1292?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=967e16852f0843d54ce02b3e8843ab86", "srcset": "https://si.imgix.net/78a801f4/uploads/origins/8d60522f-d650-483a-a76b-b8a0627d1292?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=967e16852f0843d54ce02b3e8843ab86, https://si.imgix.net/78a801f4/uploads/origins/8d60522f-d650-483a-a76b-b8a0627d1292?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a98051167c176b811143e94a5ecaf005 2x, https://si.imgix.net/78a801f4/uploads/origins/8d60522f-d650-483a-a76b-b8a0627d1292?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43b684981853e1336a7213a8fdde55a9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/78a801f4/uploads/origins/8d60522f-d650-483a-a76b-b8a0627d1292?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=597d491990082c1a3b39bbcf087894d9", "srcset": "https://si.imgix.net/78a801f4/uploads/origins/8d60522f-d650-483a-a76b-b8a0627d1292?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=597d491990082c1a3b39bbcf087894d9, https://si.imgix.net/78a801f4/uploads/origins/8d60522f-d650-483a-a76b-b8a0627d1292?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6b4fbcd9fb7ff301966594ad59e2b543 2x, https://si.imgix.net/78a801f4/uploads/origins/8d60522f-d650-483a-a76b-b8a0627d1292?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c5d9bd4a104f30da3cfb25bae490db2e 3x"}, "body": "あおたま様\nはじめまして\n個人Vtuberの鎖片かさねと申します。\n\nデザフェスにてあおたま様のイラストを拝見させていただき\n依頼したいと思いましたのでご検討のほどよろしくお願いいたします\n（透明ポストカード購入させていただきました！すごくきれいでずっと眺めてます・・・！）\n\n以下詳細となります。\n\n■依頼内容\n私のイラストを描いていただきたいです\nポーズなどはお任せでお願いいたします\n※服装もデフォルトのものじゃなくても大丈夫です。どんな服装でも嬉しいです。\n\n■立ち絵詳細\nhttps://twitter.com/kusabira_kasane/status/1744297488142782593?s=19\n\n■納品形式\n背景（ある場合）と人物と宛名等を分けたPSDファイルまたはPNG形式納品を可能でしたらお願いいたします\n\n■使用用途\n・SNSの投稿（X、FANBOX等）\n→ネットプリント配布\n・YouTube等の配信のサムネイル\n※不可なデータがございましたらお伝えいただけますと幸いです。\n\n■X（旧：Twitter）\nhttps://x.com/kusabira_kasane\n\n以上となります。\n難しい場合遠慮なく却下いただければと思います。\n何卒よろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AOhysek/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1343575, "client_id": 2084435, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ae236aaa/uploads/origins/2585a78c-ea48-48ba-8689-95717ecd2d14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc8cf2c6637d5f849715136801941602", "srcset": "https://si.imgix.net/ae236aaa/uploads/origins/2585a78c-ea48-48ba-8689-95717ecd2d14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc8cf2c6637d5f849715136801941602, https://si.imgix.net/ae236aaa/uploads/origins/2585a78c-ea48-48ba-8689-95717ecd2d14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b95b5013f4cc6a6ec9627e80914574d 2x, https://si.imgix.net/ae236aaa/uploads/origins/2585a78c-ea48-48ba-8689-95717ecd2d14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32d280c598ef466dd07ab189c528a3a9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ae236aaa/uploads/origins/2585a78c-ea48-48ba-8689-95717ecd2d14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b30d7f1d2964e89857fbc263f8f1f7d", "srcset": "https://si.imgix.net/ae236aaa/uploads/origins/2585a78c-ea48-48ba-8689-95717ecd2d14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b30d7f1d2964e89857fbc263f8f1f7d, https://si.imgix.net/ae236aaa/uploads/origins/2585a78c-ea48-48ba-8689-95717ecd2d14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d2978402f4ccc6114cdb19614952a69c 2x, https://si.imgix.net/ae236aaa/uploads/origins/2585a78c-ea48-48ba-8689-95717ecd2d14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=51795758d581d8a01dd284d5c16d292d 3x"}, "body": "あおたま様\n\nYouTubeで活動をしている個人Vtuberの戌衣もちと申します。\n先日のデザフェスにてあおたま様の素敵な作品を拝見させていただきました。\nあおたま様が描かれる青の雰囲気がとてもとても素敵と感じ\nあおたま様の雰囲気で自身を描いていただきたくリクエストさせていただきました。\n\n戌衣もちについて\n普段はゲームやマダミスのGMなど興味があるものを配信しており\n苦手ながらホラゲーなどもプレイしています。\n戌に化けてる餅のVtuberということで正体はお餅となっています。\nVtuber状態では化けていますが、素の姿は丸いお餅のような姿\n普段着用しているのは和服ですが、服装を創作される際洋服・中華などNGなしです。\n性格としてはまったりとしておりマイペースになります。\n\n使用用途について\n創作イラスト希望ですが立ち絵などの透過などをいただけましたら\n配信のサムネイルやスケジュールなどにも使用させていただきたいとと考えております。\n\n詳細\nVtuber状態での姿を希望ですが服装や構図、雰囲気などはあおたま様のお好みにお任せしたいと考えています。\n重ねてのお願いですみませんが、上部と左右で見切れが発生しないようにしていただけると幸いです。\n\n以上、不躾なリクエストになっていたら申し訳ありませんが、ご検討のほど何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1NA9527CZXTRWO6vB7VpD74SoTgzq724p?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AOhysek/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1343575, "client_id": 3029693, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/619868e5/uploads/origins/9af2b9cd-9818-49e6-ada9-a7f1afee7561?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f0e651a89b2bffe09b958d6abd5e034", "srcset": "https://si.imgix.net/619868e5/uploads/origins/9af2b9cd-9818-49e6-ada9-a7f1afee7561?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4f0e651a89b2bffe09b958d6abd5e034, https://si.imgix.net/619868e5/uploads/origins/9af2b9cd-9818-49e6-ada9-a7f1afee7561?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4305b572c96d5c3e09f1019a16ccae19 2x, https://si.imgix.net/619868e5/uploads/origins/9af2b9cd-9818-49e6-ada9-a7f1afee7561?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4930c6a48d2caa9a649f30b258b91887 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/619868e5/uploads/origins/9af2b9cd-9818-49e6-ada9-a7f1afee7561?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c55ed75ef2b5dbad3c22286924d977d", "srcset": "https://si.imgix.net/619868e5/uploads/origins/9af2b9cd-9818-49e6-ada9-a7f1afee7561?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c55ed75ef2b5dbad3c22286924d977d, https://si.imgix.net/619868e5/uploads/or