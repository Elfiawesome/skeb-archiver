りない場合は、遠慮なく再送依頼をいただければと思います。\n\nまた、ご依頼内容が難しいと感じられた場合は、キャンセルしていただいても構いません。\n\nお忙しいところ恐縮ですが、ご検討いただけますと幸いです。\n何卒よろしくお願い申し上げます。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@lI6574839201/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c56ea37e/uploads/origins/8efd1603-daef-4ee0-9c78-02ffe79dcc87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2b22a2daf0d3559852ebc4212edebbed", "srcset": "https://si.imgix.net/c56ea37e/uploads/origins/8efd1603-daef-4ee0-9c78-02ffe79dcc87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2b22a2daf0d3559852ebc4212edebbed, https://si.imgix.net/c56ea37e/uploads/origins/8efd1603-daef-4ee0-9c78-02ffe79dcc87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2ef58a7fd787ca980e9bb208d10d0408 2x, https://si.imgix.net/c56ea37e/uploads/origins/8efd1603-daef-4ee0-9c78-02ffe79dcc87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6802901d6537be4150e215fb4c946c33 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2074484, "client_id": 2640495, "nc": 17}], "sent_works": [], "similar_creators": [{"id": 37020, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "カイザー♀", "screen_name": "TomaadoHK", "avatar_url": "https://pbs.twimg.com/profile_images/2024452678294863872/5LtRuImG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/97976403/1734611328/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_r