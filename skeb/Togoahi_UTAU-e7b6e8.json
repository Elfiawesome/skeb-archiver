igins/60f33047-d3ec-4f15-ae20-d29458b494d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9fa733f0c5ca9779dafce90437c756ab", "srcset": "https://si.imgix.net/18492701/uploads/origins/60f33047-d3ec-4f15-ae20-d29458b494d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9fa733f0c5ca9779dafce90437c756ab, https://si.imgix.net/18492701/uploads/origins/60f33047-d3ec-4f15-ae20-d29458b494d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e8c7fdea03b162b1acdfaf94cae4f80e 2x, https://si.imgix.net/18492701/uploads/origins/60f33047-d3ec-4f15-ae20-d29458b494d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4c064b910f93a2dd3b7b686ba56c67f9 3x"}, "body": "とーごア洋志さんこんにちは。\nskeb募集中とのことなので今回リクエストすることにしました。\n\n描いていただきたいのは自音源の灰音ツクです。\nどのように描いていただいても大丈夫です。おまかせしたいです。\n\n使用用途は個人鑑賞です。\nご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/file/d/11FI-t_ZWSQJg4xhgFvJM1uZ1XFr9Mk4v/view?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@ehrt03/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1693145, "client_id": 1860743, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/44c59fcb/uploads/origins/5b59271f-14f2-4927-8fe3-fff56dc51a77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08e59c1d0b982cc2c818c0471373d155", "srcset": "https://si.imgix.net/44c59fcb/uploads/origins/5b59271f-14f2-4927-8fe3-fff56dc51a77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08e59c1d0b982cc2c818c0471373d155, https://si.imgix.net/44c59fcb/uploads/origins/5b59271f-14f2-4927-8fe3-fff56dc51a77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6e0b4e39abf415da79d93a2dac988817 2x, https://si.imgix.net/44c59fcb/uploads/origins/5b59271f-14f2-4927-8fe3-fff56dc51a77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9579fe60be0442c8dcb20dace65e2a51 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/44c59fcb/uploads/origins/5b59271f-14f2-4927-8fe3-fff56dc51a77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af526d81dc90436beaf5b601236cb051", "srcset": "https://si.imgix.net/44c59fcb/uploads/origins/5b59271f-14f2-4927-8fe3-fff56dc51a77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af526d81dc90436beaf5b601236cb051, https://si.imgix.net/44c59fcb/uploads/origins/5b59271f-14f2-4927-8fe3-fff56dc51a77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9c5fa3439fd04039d81dea958d7c4c07 2x, https://si.imgix.net/44c59fcb/uploads/origins/5b59271f-14f2-4927-8fe3-fff56dc51a77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b01efb3569a46b1b22ad029e38f1e674 3x"}, "body": "お誕生日おめでとうございました～～！\n\n前回描いていただいた絵がとても良かったので、今回は高校時代のあとの社会人時代（20代か30代か～などはおまかせいたします！）で「日護折鯱太郎」と「碓平裕司」の二人が野球しているところが見たいです…！！\n※「碓平裕司」はカノシタさん(https://twitter.com/kinokino_ut/media)宅のキャラで、私からskebで依頼する事・絵を資料として共有する事の許可を今回も得ています！\n\nあの後の二人がそのまま野球選手になっていても、仕事は別で趣味で野球を続けていてもどっちも素敵だな……と思ったので、具体的なシチュエーションなどもおまかせいたします。\nご検討のほどよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1UCEPKGQG9Oevu1jRHhtQdJ-GxkFJFKu3?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ponenne/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": true, "creator_id": 1301330, "client_id": 1860743, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1878846183801790464%2FW1XCbZHS.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=edbbdee307b22cf48