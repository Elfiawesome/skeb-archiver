もまた、彼を救おうとしております。\n男の子は強い不安感を抱えており、少し重力系な一面があります。\n\n具体的な内容はご自由にご調整ください。お読みいただき、ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1kL64tQfkaKjahpLUWj7h2nxBCXBa6GuH?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Still_w_u0/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4083619, "client_id": 3088269, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa11eea2/uploads/origins/bdbea023-89a6-45c0-a522-894d13209d48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3579c283fa9094956d36897492ee8bfb", "srcset": "https://si.imgix.net/fa11eea2/uploads/origins/bdbea023-89a6-45c0-a522-894d13209d48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3579c283fa9094956d36897492ee8bfb, https://si.imgix.net/fa11eea2/uploads/origins/bdbea023-89a6-45c0-a522-894d13209d48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=09f6121aa28277a723c5bb019d36c81e 2x, https://si.imgix.net/fa11eea2/uploads/origins/bdbea023-89a6-45c0-a522-894d13209d48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cadc0ca8143f4047b81fdca20038a2c5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa11eea2/uploads/origins/bdbea023-89a6-45c0-a522-894d13209d48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2752866bb498aa282ccea7a18c24e311", "srcset": "https://si.imgix.net/fa11eea2/uploads/origins/bdbea023-89a6-45c0-a522-894d13209d48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2752866bb498aa282ccea7a18c24e311, https://si.imgix.net/fa11eea2/uploads/origins/bdbea023-89a6-45c0-a522-894d13209d48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7f3c6d0c9d5445185d7936555244dfcf 2x, ht