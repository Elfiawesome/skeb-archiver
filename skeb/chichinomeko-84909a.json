3df24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c17b617870353387478b006dd4f9dbc, https://si.imgix.net/0624ae80/uploads/origins/5c9cc0c2-4752-4248-9941-b5fd3b83df24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ee41d48b3882875695b3d7ad979be6a5 2x, https://si.imgix.net/0624ae80/uploads/origins/5c9cc0c2-4752-4248-9941-b5fd3b83df24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c29302a76ebc1a879a37ba03ef6d3a0 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0624ae80/uploads/origins/5c9cc0c2-4752-4248-9941-b5fd3b83df24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=318acd44cfe6201da3f0c8916493c37d", "srcset": "https://si.imgix.net/0624ae80/uploads/origins/5c9cc0c2-4752-4248-9941-b5fd3b83df24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=318acd44cfe6201da3f0c8916493c37d, https://si.imgix.net/0624ae80/uploads/origins/5c9cc0c2-4752-4248-9941-b5fd3b83df24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b68a19afb26a33bab7eedd0fa28697da 2x, https://si.imgix.net/0624ae80/uploads/origins/5c9cc0c2-4752-4248-9941-b5fd3b83df24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a31358fe7c4b07334291cca1a60a9bce 3x"}, "body": "湖を小舟で渡る女の子（バスト100センチ超え、10代）の船が\n動かなくなったと思ったら、水面から水竜が首を伸ばし、\n「お前のオッパイが美味しそうだから止めてやった。帰りたければ\n　そのおっぱいを食べさせろ。さもなければひっくり返して残さず食べるぞ」\nと言われ、覚悟を決めおっぱいを縁から水面にさらけ出すと、\n水竜がうまそうに乳房を舌で舐め、揉みしだき、味見した後、\nゆっくり食いちぎって食べてしまう。という内容のものを読みたいです。\n落ちはもっと食べたいからとひっくり返して全部食べてもいいし、\n生還してもどちらでもいいです。\n大事なおっぱいがただの一食分のごちそう肉として扱われてしまう描写とかほしいです。\n気が向いたらお願いします。", "nc": 186, "word_count": 5149, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@asaomi_shimura/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 100537, "client_id": 174042, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22c242c5/uploads/origins/8f23db81-6ee1-4a15-b110-34d75fc453ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=431478cda9c5aef60ef9a006ffccd4da", "srcset": "https://si.imgix.net/22c242c5/uploads/origins/8f23db81-6ee1-4a15-b110-34d75fc453ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=431478cda9c5aef60ef9a006ffccd4da, https://si.imgix.net/22c242c5/uploads/origins/8f23db81-6ee1-4a15-b110-34d75fc453ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c697f065b25f1cb5e8220ed4ecb0153 2x, https://si.imgix.net/22c242c5/uploads/origins/8f23db81-6ee1-4a15-b110-34d75fc453ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8936325d7cbff342d2bd54173820d2af 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22c242c5/uploads/origins/8f23db81-6ee1-4a15-b110-34d75fc453ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bf89ffec977f49f16b91b7f091634fa", "srcset": "https://si.imgix.net/22c242c5/uploads/origins/8f23db81-6ee1-4a15-b110-34d75fc453ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bf89ffec977f49f16b91b7f091634fa, https://si.imgix.net/22c242c5/uploads/origins/8f23db81-6ee1-4a15-b110-34d75fc453ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c66f70734628cc9914208d72895c56de 2x, https://si.imgix.net/22c242c5/uploads/origins/8f23db81-6ee1-4a15-b110-34d75fc453ce?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3b90b56c4f9fc68f1d387c4a40ea41f6 3x"}, "body": "はじめまして。チチノメコと申します。\nアサオミ様の描かれるおっぱい責めと乳首責め、そして母乳描写が最高でしたのでリクエストさせていただきます。\n\n内容は、アサオミ様のキャラクター「みろろちゃん」が男性のお客様にとにかく乳首を責められ、おっぱいを握り潰されて母乳を大量に噴き出すというものです。\n\n男性は目なしの丸ハゲでお願いします(見た目無個性)。\n\n当方、おっぱいの中身……つまり乳腺描写が大好きで、乳腺描写もお願いしたいです。\n\n\nこちらの絵師様のようなデフォルメ気味の乳腺描写\nhttps://www.pixiv.net/artworks/89865672 \nhttps://www.pixiv.net/artworks/90325091 \n\nまたはこちらの絵師様のようなリアルな乳腺描写(閲覧注意)\nhttps://www.pixiv.net/artworks/78610012 \n\nどちらかの描写をお願いしたいです。\n個人的にはリアル描写が好きなのですが、これはかなり好みが分かれるので、難しかったらデフォルメ気味乳腺描写でも大丈夫です。\n\n少額で厚かましいでしょうが、可能ならカラー、無理なのであればモノクロでお願いします。\nそしてスケベメイドカフェシリーズのように「漫画」でお願いします。\n\n\n流れとしては――\n1:お客様が来店して、いきなりみろろちゃんが乳責めされる。\n2:最初にひたすら乳首を責められる(過激IV撮影たるる編、メイドカフェ♡めゆ編のような無遠慮の力一杯の全力乳首責め)。\n3:乳首責めで大量の母乳が噴き出す(とにかくとんでもない量)。この時、床に母乳が大量に飛び散る描写があるといいです。\n4:メイドカフェ1のような握り潰す乳揉み。ここでも大量の母乳が出る。\n5:とにかくひたすら乳潰し、乳首責め、乳揉みされて、最後に思いっきり絶頂して今までで最大の量の母乳を噴き出す。この時の母乳は粘ついた粘性母乳でお願いします。床、みろろちゃんの体に母乳が付着している様子で〆。\n\n乳責めが始まったときから終わりまで、すべてのおっぱいで乳腺描写を描いていただきたいです。そして乳腺の中に母乳が作られて溜まっていく様子、握り潰されてグシャっとなってる乳腺、母乳が勢いよく乳管を流れ溢れていく様子をお願いします。\n\n無理難題となってしまいますが、是非ともよろしくお願いします！", "nc": 171, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 797103, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "うっちゅう", "screen_name": "uttyuudayo", "avatar_url": "https://pbs.twimg.com/profile_images/1477046886532251650/W3yjKSDw.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "novel"}, {"genre": "correction"}], "banned": false, "nc": 49}, {"id": 959047, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "屋根が高い", "screen_name": "ms4f6YXjaryTfBR", "avatar_url": "https://pbs.twimg.com/profile_images/1220433000615182336/Djm3ykKE.png", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills":