ff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d85011581e91f83794afb92b75bf30ea, https://si.imgix.net/a2ec2e50/uploads/origins/a6c1b193-b0f4-465c-b157-1e90359a49f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cd1a47bcb63815e9dc979ef84978c09d 2x, https://si.imgix.net/a2ec2e50/uploads/origins/a6c1b193-b0f4-465c-b157-1e90359a49f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=51ddadce580a5bb24e3a9713f5856e10 3x"}, "body": "ご依頼失礼します。\nこちらの趣向の関係で似たような内容となるのですが 以前お願いした白装束っぽい方の衣装を着た女の子をあなたの絵柄で描いて頂けますか？\n以前のご依頼と衣装の資料は同様ですが、今回は同じ子ではなく別の子を新しく描いて頂きたいです。\n\nですが今回は変化を加えてみたいので\"幽霊\"や\"お化け\"のような要素を抜き、髪で目を隠さないようなデザインで描いてみて頂きたいです。\nこちらの嗜好上、必ずキャラの手や足先までが衣装の袖や裾に包まれて見えないように描いて下さい。\n\n絵柄も以前と変わらずそちらにて描かれていらっしゃった日本一ソフトウェアの少女シリーズ(ホタルロゼハコニワボイテラ、絵本シリーズ、夜廻等)辺りのデフォルメ寄りかつ口は省かないデザインでお願いします。\n\n衣装については上記の手や足を衣装で隠す事さえ守って頂ければ\n大きくアレンジしたり要素のオミットから付け足しまで何でも歓迎ですのでお好きなようにどうぞ。\n\nまた、裾に隠れたままの足の部分まで見えるように全身を描いて頂きたいというのも前回同様になります。\n構図やポーズ等はそちらにお任せです。\n\n参考資料↓\nhttps://imgur.com/a/BoRro2t", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kumizuri_gm/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1494964, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc998dd9/uploads/origins/a1bbd273-0b20-45d2-9c16-840af289e479?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c41c21eaea474a6cb2e04df46f394fd1", "srcset": "https://si.imgix.net/cc998dd9/uploads/origins/a1bbd273-0b20-45d2-9c16-840af289e479?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c41c21eaea474a6cb2e04df46f394fd1, https://si.imgix.net/cc998dd9/uploads/origins/a1bbd273-0b20-45d2-9c16-840af289e479?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b28519d09e183176cf5eb96353ea8b4 2x, https://si.imgix.net/cc998dd9/uploads/origins/a1bbd273-0b20-45d2-9c16-840af289e479?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b57cce5c2e0f274ae4c62cf9285f41af 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc998dd9/uploads/origins/a1bbd273-0b20-45d2-9c16-840af289e479?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21692bf099b69e69755faad2e790b675", "srcset": "https://si.imgix.net/cc998dd9/uploads/origins/a1bbd273-0b20-45d2-9c16-840af289e479?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21692bf099b69e69755faad2e790b675, https://si.imgix.net/cc998dd9/uploads/origins/a1bbd273-0b20-45d2-9c16-840af289e479?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=480dabd425d2e75ff385683b9978cf12 2x, https://si.imgix.net/cc998dd9/uploads/origins/a1bbd273-0b20-45d2-9c16-840af289e479?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e890a4e0bae373cefe8bc0c9974863d6 3x"}, "body": "もう一つご依頼失礼します。\n下記資料のような感じの衣装を着た女の子をあなたの絵柄で描いて頂けますか？\n\n指定は衣装の大まかな形状とキャラが女の子であるという部分のみですので、\n中の女の子のデザインはそちらのお好きなように描いて頂く形となります。\n\n衣装につきましてはキャラの手先や足先までが衣装の長い袖や裾に包まれて見えないように描いて頂ければ、色変えや大きくアレンジしたり要素のオミットから付け足しなども何でも歓迎ですのでお好きなようにどうぞ。\n\nまた、手と脚全体を覆い隠すような幽霊っぽさもある衣装ではありますが、ステレオタイプの幽霊のように脚や下半身部分が先細りだったり消えているようには描かずにあくまで床まで引きずるような長い裾で隠れていて足が見えないという感じにお願いしたいです。\n\nそれから、以前送ったご依頼の指定と同文ですが\n絵柄としてはそちらにて描かれていらっしゃった日本一ソフトウェアの少女シリーズ(ホタルロゼハコニワボイテラ、絵本シリーズ、夜廻等)辺りのデフォルメ感で描いて頂きたいです、ただし口は省かないデザインでお願いします。\n\n可能であれば 裾に隠れたままの足の部分まで見えるように全身を描いて頂きたいです。\n\n構図やポーズ等はそちらにお任せします。\n\n参考資料↓\nhttps://imgur.com/a/BoRro2t", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kumizuri_gm/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1494964, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/38fc4ddb/uploads/origins/16d99021-5d26-4f4a-bdcd-0a87adcf3587?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1351b80ce0c371e078242aba28514a8b", "srcset": "https://si.imgix.net/38fc4ddb/uploads/origins/16d99021-5d26-4f4a-bdcd-0a87adcf3587?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1351b80ce0c371e078242aba28514a8b, https://si.imgix.net/38fc4ddb/uploads/origins/16d99021-5d26-4f4a-bdcd-0a87adcf3587?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f73f4af0a18c1e341c0c0af9c5d3562d 2x, https://si.imgix.net/38fc4ddb/uploads/origins/16d99021-5d26-4f4a-bdcd-0a87adcf3587?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=817d55539eba124f03b4629b20acc5e9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/38fc4ddb/uploads/origins/16d99021-5d26-4f4a-bdcd-0a87adcf3587?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67ff87be20746cfc495f780de88ed69a", "srcset": "https://si.imgix.net/38fc4ddb/uploads/origins/16d99021-5d26-4f4a-bdcd-0a87adcf3587?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67ff87be20746cfc495f780de88ed69a, https://si.imgix.net/38fc4ddb/uploads/origins/16d99021-5d26-4f4a-bdcd-0a87adcf3587?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=67118a716beb79abe658bb61ea55665b 2x, https://si.imgix.net/38fc4ddb/uploads/origins/16d99021-5d26-4f4a-bdcd-0a87adcf3587?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=797430011e0f693bd4aeecca84781be4 3x"}, "body": "ご依頼失礼します。\n再度リクエストをお開き下さりありがとうございます。\n以前送ったものと同様の依頼ですが内容は多少見直してあります。\n\n下記資料のかたつむりな感じの衣装を着た女の子を描いてみて頂けますか？\n指定は着せる衣装のみですので、中の女の子のデザインはそちらにお任せする形となります、\n資料内には衣装だけでなくそれを着たキャラ自体の画像が複数含まれていますがそちらに寄せて描いたりはしなくて良いです。\n殻や触覚部分の色もそちらにお任せしますのでお好きな色でどうぞ。\n\n衣装についてもアレンジや要素の付け足し等も歓迎ですのでお好きなようにやって頂いて構いませんが、\n手は先端まで完全に覆われ、足も長い裾で完全に隠れるローブや着ぐるみっぽい服ですので 手や足先は衣装から露出させないようにお願いします。\n\nそれから、絵柄の幅がお広いようでいらっしゃるのでお伝えしておきたいのですが\nそちらにて描かれていらっしゃった日本一ソフトウェアの少女シリーズ(ホタルロゼハコニワボイテラ、絵本シリーズ、夜廻等)辺りのデフォルメ感で描いて頂きたいです、ただし口は省かないデザインでお願いします。\n\nここからは任意となりますが\n衣装の手先部分のデザインに関しては 先細りの先端が完全に閉じた形状と、ローブのようにたるみのある感じを両立した感じに描いて貰いたいです。\n衣装本体の資料とは別でその下に作例をご用意しましたのでこちらを参考にお使い頂ければ幸いです。\n\n構図やポーズ等はそちらにお任せしますが、裾で隠れたままの足の部分まで見えるように全身を描いて頂きたいです。\n\n参考資料(衣装本体資料)↓\nhttps://imgur.com/a/qmGUT0v\n\n参考資料↓(衣装の手先部分作例資料)\nhttps://imgur.com/a/pgwjiMN", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 676678, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "るてこ/Ruteko", "screen_name": "ruko220", "avatar_url": "https://pbs.twimg.com/profile_images/2075751439717285888/7tln9nJg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1261990035135426561/1725219913/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 1995919, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "七色ないろ", "screen_name": "716", "avatar_url": "https://pbs.twimg.com/profile_images/1074289254556098561/9Bhzkssu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1066303897038245888/1703390471/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "none", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 2825679, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "絵が好き", "screen_name": "noname__da", "avatar_url": "https://pbs.twimg.com/profile_images/1992984809367564288/jda4CUZZ.