&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=13340fe80aca5be286de66ffde19467e 3x"}, "body": "ここのかさん、はじめまして。Vtuberの月夜猟介と申します。\nここのかさんの描かれるふんわりとして可愛らしい絵柄が気に入りました！ぜひ自身のイラストを描いていただきたいと思い、リクエストを送らせていただきます！\n\n【ご依頼したい内容】\nキャラクター：月夜猟介(参考画像URLを添付いたします)\n衣装等：参考画像内にあるデフォルトの白いアイドル風の衣装\nポーズ・構図・シチュエーション等：\nなにか見てはいけないようなところを偶然見てしまい「顔を真っ赤にして照れて慌てている猟介」を描いていただきたいです！細かいポーズ等はお任せいたします。\n下記のとおりサムネイル等へ使用したいので、キャラクターの上と左右(髪や腕など)は可能な範囲で途切れていないと助かります。\nもし予算内で可能であれば、照れ赤面とは別に「なにか怖いものを見て青ざめて慌てている表情差分」がいただけると嬉しいです(ホラーゲームのサムネに使うイメージです)。\n\n〇使用用途：Youtube等の配信やサムネイルでの使用、SNSでの使用等を考えております。そのほか、もし可能であれば個人観賞用に印刷をする許可もいただければ嬉しいです(頒布・販売等は致しません。難しければ結構ですので、psd内などにその旨ご記載いただければ幸いです)。\n\n〇形式など：psd形式でいただけると嬉しいです。キャラクターと、そのほかの背景やサインなどは可能な範囲で別レイヤーに分けていただけると大変助かります。\n\n〇参考画像： Twitterアカウントとgoogle driveを記載いたします。\n①https://twitter.com/RyosukeTsukiyo\n②https://drive.google.com/drive/folders/19_zo9HFwtI_E9Ew6ID3ziu95biPTWZ9d?usp=sharing\n\nもしもご縁がありましたら、どうぞよろしくお願いします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1158780, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "えのまる💫", "screen_name": "number_TRPG", "avatar_url": "https://pbs.twimg.com/profile_images/1930094699949502464/Wq640aHi.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1264327466870386688/1735916951/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "novel"}], "banned": false, "nc": 144}, {"id": 2490759, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "たまお", "screen_name": "1_ssmk", "avatar_url": "https://pbs.twimg.com/profile_images/2055999338460147712/i0Gh_j-d.png", "header_url": "https://pbs.twimg.com/profile_banners/942039009122967552/1771365600/1500x500", "appeal_receivable"