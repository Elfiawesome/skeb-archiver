om/%E6%96%B0%E4%BA%95%20%E6%A1%83%E5%AD%90", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 535722, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ららみ〜道場🫠skeb募集中", "screen_name": "peropero_cino", "avatar_url": "https://pbs.twimg.com/profile_images/2033365626182623233/RUOHDQL2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/907867184340156416/1778120680/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "novel"}, {"genre": "art"}], "banned": false, "nc": 177}, {"id": 756808, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ニジデーミル・イシュカンスキー", "screen_name": "2dmirishukansky", "avatar_url": "https://pbs.twimg.com/profile_images/1152726770501603328/eFNhnomj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1152726684015067136/1633164211/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 56, "skills": [{"genre": "novel"}, {"genre": "correction"}], "banned": false, "nc": 56}, {"id": 1226275, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "クロ煉瓦", "screen_name": "kurorenga_0213", "avatar_url": "https://pbs.twimg.com/profile_images/1346084551467048960/AeG47TwN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1271915138543529984/1634133204/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 41, "skills": [{"genre": "novel"}], "banned": false, "nc