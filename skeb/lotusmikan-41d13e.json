%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8b894c7fe337187e827ce4e034a69e09 3x"}, "body": "こんにちは、\n\nアークナイト\n\nSIEGEとドクターを薄暗い木のバーでデートに誘いたい。\nお酒を飲みながら。\n\nシージがドクターにちょっと頭をもたれかからせて、尻尾をドクターの一部に巻きつけるとか。\n\n可能であれば、INDRAが嬉しそうに二人を祝福し、ドクターの背中を戯れに叩くシーンも。\n\n漠然としたアイデアですが、必要に応じて修正してください。\n\nもし必要なら、彼らの衣装を少し修正してもいい。もしシージのオリジナルの衣装を使うなら、彼女のジャケットを後ろの椅子の上に置いて肩を露出させるのもいいだろう。\n\n巨乳でお願いします。\n\nありがとう。\n\nhttps://drive.google.com/drive/folders/1y75vt51f44v1DEwvyFP1EGREgRlGXuwZ?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@lotusmikan/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2082111, "client_id": 1779663, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f85b6297/uploads/origins/d75431fd-4538-40c5-ba71-bef7da935c93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=298e5ac7fa0c0544c98b32d0055224e5", "srcset": "https://si.imgix.net/f85b6297/uploads/origins/d75431fd-4538-40c5-ba71-bef7da935c93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=298e5ac7fa0c0544c98b32d0055224e5, https://si.imgix.net/f85b6297/uploads/origins/d75431fd-4538-40c5-ba71-bef7da935c93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6289423c6df7a0a232504bf07fa887de 2x, https://si.imgix.net/f85b6297/uploads/origins/d75431fd-4538-40c5-ba71-bef7da935c93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16dbb672b7ec9fc37557eb0fb44785a9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f85b6297/uploads/origins/d75431fd-4538-40c5-ba71-bef7da935c93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32205c84706ab9ec90cd23f42b0fa3d8", "srcset": "https://si.imgix.net/f85b6297/uploads/origins/d75431fd-4538-40c5-ba71-bef7da935c93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=32205c84706ab9ec90cd23f42b0fa3d8, https://si.imgix.net/f85b6297/uploads/origins/d75431fd-4538-40c5-ba71-bef7da935c93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c31d83124f57686f5e1742697569ddf5 2x, https://si.imgix.net/f85b6297/uploads/origins/d75431fd-4538-40c5-ba71-bef7da935c93?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a2d19ec640e96d9e961deaf5e28b2496 3x"}, "body": "またまたこんにちは！アークナイツのOC \"エルタニン \"のためにリクエストしたいことがあります。\n\n今回は、\"Lone Trail \"というイベントにちなんで、宇宙をテーマにしたものをお願いします。テラがバリアーを突破して、宇宙飛行士をテラの周回軌道に送り始めた未来を想像してみたい。ロードス島のエンジニアであるエルタニンは、誇りと決意を胸に、宇宙飛行士に選ばれたことを喜んでいる。\n\nこの画像のような設定、ポーズ、服装（Tシャツ、ズボン）がいいだろう。髪は少し浮いていて欲しいが、難しければそのディテールは入れなくても構わない。\nhttps://www.nasa.gov/wp-content/uploads/2023/03/462928main_GPN-2000-001083_full-1.jpg\nhttps://www.nasa.gov/wp-content/uploads/2018/06/peggy_whitson_0.jpg\n\nhttps://drive.google.com/drive/folders/1oPP9OcPe9tKVfKt0aFOsd0ez0gigbSlI", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@lotusmikan/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2082111, "client_id": 1779663, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8175d4ac/uploads/origins/05ff0b08-97d0-465b-be66-0ae68ccf2f33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3d15098b17a550e040890e514807a85", "srcset": "https://si.imgix.net/8175d4ac/uploads/origins/05ff0b08-97d0-465b-be66-0ae68ccf2f33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3d15098b17a550e040890e514807a85, https://si.imgix.net/8175d4ac/uploads/origins/05ff0b08-97d0-465b-be66-0ae68ccf2f33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36368cb38950c7c1344a7ab8623d5af7 2x, https://si.imgix.net/8175d4ac/uploads/origins/05ff0b08-97d0-465b-be66-0ae68ccf2f33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ae1494c272b71d340b9b95df7260943f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8175d4ac/uploads/origins/05ff0b08-97d0-465b-be66-0ae68ccf2f33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8fd754f650142d51b603ac036cd5287", "srcset": "https://si.imgix.net/8175d4ac/uploads/origins/05ff0b08-97d0-465b-be66-0ae68ccf2f33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8fd754f650142d51b603ac036cd5287, https://si.imgix.net/8175d4ac/uploads/origins/05ff0b08-97d0-465b-be66-0ae68ccf2f33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b16fb2665ef6ae10d51961ce45d74e88 2x, https://si.imgix.net/8175d4ac/uploads/origins/05ff0b08-97d0-465b-be66-0ae68ccf2f33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=12c30f26e7b7df1fffbca55acf648b3f 3x"}, "body": "こんにちは！私のアークナイツのOC「ラグエル」をもう一度描いていただけませんか？\n\n今回は、シラクーサでの彼女の任務を描いていただけませんか？ 彼女は、堕落したサンクタの調査と阻止を依頼されています。新都市 \"ニューヴォルシニイ \"で連続殺人鬼と化した悪党の暗殺者。ラグエルは歓迎の意を込めて、街のオペラハウスで新しいオペラの鑑賞に招待された。https://imgur.com/a/Blhbeiv。\nラグエルは黒いドレス（https://imgur.com/e7lwM17）を着て、テーブルのひとつに座り、オペラを見ながら飲み物を楽しんでいます。普段はもっと現代的なメディアを楽しんでいる彼女だが、今回初めて鑑賞し、ストーリーと歌手にとても感動している。\n\nありがとうございます！\n\nhttps://imgur.com/a/XkPZXcl\n\nhttps://imgur.com/a/XkPZXcl", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@lotusmikan/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2082111, "client_id": 2580348, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d66c257f/uploads/origins/8c1cf90a-2d60-41fd-bf93-f77774ded939?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38418ffb5fec2aff32b60d870059a4a1", "src