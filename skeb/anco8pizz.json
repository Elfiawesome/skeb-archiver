200&blur=200&s=e9c578e66297a7f060ca6121d32037e3", "src_set": ""}, "body": "こんにちは！\n\nあなたの作品を見て、私のVtuberの絵を描いていただけませんか？\n\n夏をテーマにした作品で、彼女がビキニを着ているものにしたいんです。このような水着を着てほしいのですが、1枚ではなく2枚です。上はとても気に入っていますが、下は布が多すぎます。https://drive.google.com/file/d/1x745ALTux3yt34mq6SNrft62wx250FQd/view?usp=sharing\n\n海から上がってくる彼女を少し前傾姿勢にして、見る人を見てほしい。髪を耳の後ろでまとめてほしい。性格は大人しくていじわるなお姉さんタイプ。\n\n他にもアイディアがあれば遠慮なく言ってください。完成した作品は、とにかく魅力的な夏の水着イラストにしたいです。\n\nよろしくお願いします。\n\n私のキャラクターの参考はこちら https://drive.google.com/drive/folders/1iO3m9tDfz__voQm8cnwVrCARP3ZDT9wi?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1iO3m9tDfz__voQm8cnwVrCARP3ZDT9wi?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@anco8pizz/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 458072, "client_id": 3604576, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ae935fe7/uploads/origins/5d6de694-5c02-4852-9f99-e71099582ee1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e154cdbb8d386c7cbf64a5eaf485a049", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ae935fe7/uploads/origins/5d6de694-5c02-4852-9f99-e71099582ee1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66a54d2856db936c60ad07b63a2b40cf", "src_set": ""}, "body": "安丹下さん、こんにちは！私は安田さんの絵がとても好きで、カサネ・テトをチューニングしているビデオもとても素晴らしいです。あなたの絵の素晴らしさとキャラクターの新鮮さに驚きました！\n\n私のVtuberのキャラクターをお願いしたいのですが、白のラップビキニで描いていただけませんか？参考画像が黒のビキニで、欲しい白バージョンが見つからなくてすみません。\n\n夏っぽい感じがいいので、背景画像は水とか、強い日差しとか、青空とかでお願いします！\n\n金額が正しくない場合は、正しい金額にしてお支払いください！\n\nご検討いただき、本当にありがとうございます！よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/183yxHXngmtCawBxlYWI22rx8F-vQZK3P?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@anco8pizz/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 458072, "client_id": 36149, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f8b050f9/uploads/origins/6c7a927b-99af-4f03-b715-98169f444701?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6200a709841e06806e350d28fa280e2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8b050f9/uploads/origins/6c7a927b-99af-4f03-b715-98169f444701?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a1062dd780039451b5417cdc8bfd2b9e", "src_set": ""}, "body": "こんにちは、リクエストでVOCALOIDの重音テトお願いします。シチュエーションは、手の甲にテトの顔のお面を着けた状態で、ボカロ曲「ホントノ」にあやかり人差し指と中指でトコトコとハンドウォークをこちらに見せてくれるよう(こちらに向かって歩く感じ)に描いて欲しいです。テトの手は素手ではなく肌色の手袋をはめた状態で、縫い目ありでお願いします。もし描けたら、その手袋をはめるところと手を握らせてくれるところも描いて欲しいです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@anco8pizz/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 458072, "client_id": 3200101, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d159ec8d/uploads/origins/c0db4aa5-3905-466a-be83-232eda5b3ea3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b23e43fc8cffa486ca9bbb80d57feece", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d159ec8d/uploads/origins/c0db4aa5-3905-466a-be83-232eda5b3ea3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=28c8f9d5326d21f95f7f98237877bad5", "src_set": ""}, "body": "やすたんげ先生、こんにちは！\n先日はキャラデザ本当にありがとうございました・・！！\n\nやすたんげ先生の調声…（絵柄）がとても魅力的で、\n今回、【先日のキャラクター】の【夏を感じさせる】イラストをリクエストします。\n\n先生のチャンネルにある「【調声晒し】 リピート v2 / 重音テト」のイラストが好きで、資料を確認頂ければと思います。以下の詳細をご参考にしていただければ幸いです。\n\n【イメージ】\n- アクセサリー：【メガネ】、【星型で何か】あれば嬉しいです（メガネだけ着脱差分があると嬉しいです！サングラス以外であればメガネの形状や色が変わっても、問題ありません）\n- 背景：無しで問題ありません\n- 構図：顔はできるだけ正面を向いていれば、嬉しいです\n（先生のSkebヘッダーのように横を向いていてほぼ正面でも問題ありません）\n- 衣装：サムネイルのような服にこだわりがあるわけではなく、髪を纏めていたり、そんな元気な夏のイメージです）\n\nこのリクエスト内容に何か制約がある場合は、適所調整していただいて大丈夫です。\n\nお忙しい中、この抽象的な依頼に対しても丁寧に対応していただけることを大変感謝しております。やすたんげ先生のクリエイティブな解釈を楽しみにしています！\n\nどうぞよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/16T-kVivYR9KUpUPl__gw3y_9k2sPl__t?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@anco8pizz/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 458072, "client_id": 3200101, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03b90765/uploads/origins/6e889de3-7890-4f07-8bf7-67f6aff0bd5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29b025c40f8ff977c7470832aadd7f6b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03b90765/uploads/origins/6e889de3-7890-4f07-8bf7-67f6aff0bd5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f7cbde1cacfeab18c0e4d2958a72352", "src_set": ""}, "body": "やすたんげさん、こんにちは！\n\nやすたんげさんの絵柄がとても魅力的で、特にその明るく元気なキャラクターの表現に感動しました。\nイメージしかなく恐縮ですが、夏を感じさせる元気で活発な女の子のイラストをリクエストさせていただきます。以下の詳細をご参考にしていただければ幸いです。\n\n【イメージ】\n- 年齢：18-20代\n- 髪色：おまかせします\n- 髪型：セミロングカール\n- 瞳：大きくてパッチリした明るい水色の瞳\n- 服装：おまかせします\n- アクセサリー：【メガネ】、【星型で何か】あれば嬉しいです（メガネだけ着脱差分があると嬉しいです！）\n- 背景：無しで問題ありません\n- 構図：特に希望はありません\n\nこのリクエスト内容に何か制約がある場合は、適所調整していただいて大丈夫です。\n\nお忙しい中、この抽象的な依頼に対しても丁寧に対応していただけることを大変感謝しております。やすたんげさんのクリエイティブな解釈を楽しみにしています！\n\nどうぞよろしくお願いします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@anco8pizz/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/136cddd0/uploads/origins/45ba5e5c-4b76-4a69-b019-35b7b61a6529?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=20