_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2431125, "client_id": 1242278, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e04062e3/uploads/origins/ebd7e4e7-3af0-4bf4-a045-9a218ec2934b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e838f6ffabeb8c40058756682aaf2e16", "srcset": "https://si.imgix.net/e04062e3/uploads/origins/ebd7e4e7-3af0-4bf4-a045-9a218ec2934b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e838f6ffabeb8c40058756682aaf2e16, https://si.imgix.net/e04062e3/uploads/origins/ebd7e4e7-3af0-4bf4-a045-9a218ec2934b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=363a0c82ebef84ceeb3c3bbe0d7012f3 2x, https://si.imgix.net/e04062e3/uploads/origins/ebd7e4e7-3af0-4bf4-a045-9a218ec2934b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88af4f064c87d67df828807df6459041 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e04062e3/uploads/origins/ebd7e4e7-3af0-4bf4-a045-9a218ec2934b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7cb7bfe85c6e1392ec812a4e9aff711", "srcset": "https://si.imgix.net/e04062e3/uploads/origins/ebd7e4e7-3af0-4bf4-a045-9a218ec2934b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7cb7bfe85c6e1392ec812a4e9aff711, https://si.imgix.net/e04062e3/uploads/origins/ebd7e4e7-3af0-4bf4-a045-9a218ec2934b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2d4c2f61a7ea03d3387087f9f8d7cbc0 2x, https://si.imgix.net/e04062e3/uploads/origins/ebd7e4e7-3af0-4bf4-a045-9a218ec2934b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c9ccd6222d15d6ce978cc17661d84848 3x"}, "body": "友人のNadia（https://imgur.com/a/33nLzKq）と私は、あなたが最初に描いてくれた衣装のようなイブニングドレスを私たちに着せてくれないかと期待していました。エレガントかつセクシーに。\nNadiaは、この種のドレスを要求しているときに、このアルバムを共有します： https://imgur.com/a/ibMItPD\nアテナのドレスを考えるときにもこのフォルダを使えば、二人のスタイルが似たような起源を持つように感じられるでしょう。\n\nドレスの配色は、髪の色と同じように、コントラストをつけたり、引き立てたりしてほしいと思っています。例えば、アテナは白いドレスで、ナディアは黒いドレス。デザイン的には、ナディアはホルタートップかストラップレスのドレスがいいなと思います。肩が露出するような。2枚目の衣装のアテナの腰のバラのシルバーチェーンが好きです。ああいうのを取り入れてもらえるとありがたいです。\n\nナディアの角や鱗の質感は、表面がツルツルしているわけではありません。彼女のこだわりが詰まっています。\n\nナディアはアテナより少し恥ずかしがり屋ですが、二人とも幸せそうな顔をしているはずです。\n\nhttps://drive.google.com/drive/u/1/folders/1HdxysbTza1ML9NZZkX0DSmU4swID-XZM", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tkskmakoto/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2431125, "client_id": 420175, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ad99ca0/uploads/origins/762887cf-e796-4d00-910b-80b9ac6f69b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75fc8c41ebbc84ece2f7d705691577a5", "srcset": "https://si.imgix.net/3ad99ca0/uploads/origins/762887cf-e796-4d00-910b-80b9ac6f69b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75fc8c41ebbc84ece2f7d705691577a5, https://si.imgix.net/3ad99ca0/uploads/origins/762887cf-e796-4d00-910b-80b9ac6f69b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cccc7dc425071f86fe4e132ade5b3e5c 2x, https://si.imgix.net/3ad99ca0/uploads/origins/762887cf-e796-4d00-910b-80b9ac6f69b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c60edb39ebac52b8098b70d8e4441743 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3ad99ca0/uploads/origins/762887cf-e796-4d00-910b-80b9ac6f69b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=930ce05a54f36d8e5bd6fdbd449a0c40", "srcset": "https://si.imgix.net/3ad99ca0/uploads/origins/762887cf-e796-4d00-910b-80b9ac6f69b3?bg=%23fff&auto=format%2Cc