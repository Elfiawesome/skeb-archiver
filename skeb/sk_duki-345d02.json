pr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e857982a32b1f509e358cefb74eec9a3 2x, https://si.imgix.net/4ce75c32/uploads/origins/60a489dc-af1e-4793-915f-809267b74057?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a15a66dfe251edfe34f9d4d483c88513 3x"}, "body": "しき様、初めまして。ツイッターでイラストを拝見し、素敵な絵柄に惹かれリクエストさせて頂きました。\nイラスト内容ですが、Vtuberである私「一色白」と「猫目みっけ」の二人のイラストをお願いしたくリクエストいたしました。\n用途としましては、ツイッターやYouTubeなどのサムネイルやヘッダーなどに使用する予定です。\nイラスト内容は、\n【性別】性転換(一色白：女、猫目みっけ男)。\n【衣装】おまかせ\n【髪形】一色白：ツインテール、猫目みっけ：おまかせ\n【表情】一色白：泣き顔、猫目みっけ：煽るような顔\n【構図、ポーズ】一色白：両手を前について顎を上向きにしてお姫様座りしている感じ、猫目みっけ：一色白を煽っている感じ。\n【その他】可能であれば一色白を流血させていただきたいです。　\n\n納品の際、お手数ですがキャラクター透過も送って頂けますと幸いです。\nお忙しいとは思いますが、ご縁がありましたらよろしくお願いいたします。\n\nhttps://www.dropbox.com/sh/98a4wgz6xsg1s2d/AAAmwFguCho7v2O19kSBwhXaa?dl=0", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sk_duki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 528911, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/40703a23/uploads/origins/54ecf5af-3360-4511-802a-4dd57277faa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4682495d110dc9a3addb9341489d6ed", "srcset": "https://si.imgix.net/40703a23/uploads/origins/54ecf5af-3360-4511-802a-4dd57277faa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4682495d110dc9a3addb9341489d6ed, https://si.imgix.net/40703a23/uploads/origins/54ecf5af-3360-4511-802a-4dd57277faa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b884b15a1392b37d96790f6cca25347 2x, https://si.imgix.net/40703a23/uploads/origins/54ecf5af-3360-4511-802a-4dd57277faa4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c169794bc8ac0221fe0bb5c407acb5fc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/40703a23/u