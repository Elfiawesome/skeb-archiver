23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=988671b3b6486c3d5399ffb1e13d98c3 2x, https://si.imgix.net/6fea917c/uploads/origins/58edf43e-201d-4d03-9781-1bc6147e8231?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ee78645e8e721bd3afb0fcdece744fb 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6fea917c/uploads/origins/58edf43e-201d-4d03-9781-1bc6147e8231?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3576099a91f89f9d1157eddcd499c74d", "srcset": "https://si.imgix.net/6fea917c/uploads/origins/58edf43e-201d-4d03-9781-1bc6147e8231?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3576099a91f89f9d1157eddcd499c74d, https://si.imgix.net/6fea917c/uploads/origins/58edf43e-201d-4d03-9781-1bc6147e8231?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=313842e4a10fcf0fd38f434ac765fa25 2x, https://si.imgix.net/6fea917c/uploads/origins/58edf43e-201d-4d03-9781-1bc6147e8231?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1ca993537b9d8fa4413ad972f73b1079 3x"}, "body": "お世話になっております！\n今回はブルーアーカイブより、ヒナちゃんの肥満化+女先生との百合SSをお願いしたいです。\nストレスが原因での過食による激太りで追い詰められていくヒナちゃんと、先生に受け入れられた後ドカ食いを見てもらう事に興奮を覚えるようになってしまったヒナちゃんの2パート構成のイメージです。\n\n流れとしては、\n\n先生ともまともに会えないほどの激務のなか、ストレスの捌け口として過食をはじめ、激太りしてしまうヒナ。→親しい関係の者からは心配を、ヒナに反感を持つ者や敵対組織からは嘲笑の的にされ、ますますストレスが募る。→醜い身体が恥ずかしくて先生に顔向けもできず、先生を避け寂しさから自傷がわりに過食をしさらに太ってしまう。悪循環に陥ってしまったヒナは仕事中も常に食べ物を口に含んでいないと落ち着かなくなり、悪化するストレスから逃れるためにがぼがぼと呑むように食事を詰め込み、日に日に太っていく自分の醜さがさらにストレスを増大させる。望まぬ満腹感に苦しみながら気絶するように眠るヒナの心身は、限界寸前だった。\n\n連絡のないヒナを心配し、(彼女はモモトークで誘っても遠慮するだろうと考え)内緒でヒナに会いに行く先生。風紀委員会の執務室の戸を開けると、一瞬誰だかわからないほどにでっぷりと変貌したヒナの姿があった。→一番見られたくない人に見つかってしまい、「見ないで」と叫び、ひどく取り乱し泣きながらうずくまるヒナ。その激太りっぷりのあまり、薬を盛られたのか、何かされたのかと心配する先生に、「違うの… 私が醜いだけ…」と嗚咽する。→ヒナを落ち着かせた先生は事情を聞くと、ヒナのことを抱きしめ、「気づいてあげられなくてごめんね、辛かったね、苦しかったね」と泣きながら慰める。予想外の反応に、私が醜くないのか、気持ち悪くないのかと問うが、先生は微笑んで「そんなことないよ、女の子は少しぽっちゃりしてるくらいがかわいいよ！」と返す。→先生が自分を嫌わなかったことで、心にいくばくか救いが生まれて落ち着きを取り戻したヒナ。緊張がほぐれると、でっぷりとした腹から大きな腹の音が鳴り、赤面してしまうのだった。\n\nそのまま先生の前でお昼ご飯を食べることになったヒナ。少し待ってて…と言うと、いつもの癖で無意識的に大量の食事を注文してしまう。あわてて取り消そうとするも、音速のデリバリーラーメンはあっというまに執務室まで届いてしまうのだった…→先生に見られながら大量のラーメンをがぼがぼと貪るヒナ。自分への嫌悪と恥ずかしさで爆発しそうだが、不思議と気持ちの昂りも感じていた。「(私の醜い食事姿を見ても、先生は嫌な顔一つせず、むしろ穏やかに微笑んで「おいしい？」と話しかけてくれる。そんな先生を前に、私はみっともなく大口を開けて胃袋に食べ物を流し込む姿を晒している…その事実に、興奮する…)」そんな気持ちが芽生え始めていたのだった。\n\nそうして、ヒナの「こんなに醜くなってしまったけれど、それでも一緒にいてくれる？」という問いに、一も二もなく「もちろん！」と答えた先生。ヒナがまたストレスを溜め込まないよう、控えめな彼女をリードするように触れ合いつつ、今はもっぱら太ったヒナのモチモチまるまるとした可愛らしい姿を愛でるのに夢中だった。→そしてヒナは、周りからの助けもありでっぷりとした身体を受け入れつつあり… そして、すっかり先生に見られながらドカ食いをするのにハマってしまっていた。優しくて大好きな先生に、私の恥ずかしい姿をみんな晒してしまう…そんな背徳感が、彼女の快楽となっていたのだった。今日もまた、先生を誘ってふたりで夕飯をとり…呑むように食事を胃袋へ流し込む姿を見てもらうのだった。\n\nかなり長くなってしまいましたが、こんな感じのSSをイメージしております！\n地の文は先生がヒナに会いに行く〜受け入れてあげるシーンは先生の主観で、それ以外はヒナの主観で書いていただけるといい感じかな〜と思います。書きやすい形で書いてくださればと思います。\n女先生の口調はブルーアーカイブ本編での先生のように、キャラクター性薄めで飾らない淡白な言葉使いだけど、少し子供っぽい感性で、生徒への優しさがにじみ出ているような感じの口調だと嬉しいです。\n見たい描写としては、\n\n・ストレスによる過食が止められない→激太り→太った姿の醜さ、周りの反応がさらにストレスに…という悪循環で追い詰められていくヒナの心理描写\n・ろくに味あわず、自分を傷つけるようにまさしく鯨飲馬食といった勢いでがぼがぼと飯を腹に詰め込んでいく破滅的なドカ食いをするヒナ\n・ヒナが先生に救われてからは、心の暗雲が晴れたように幸せで穏やかになっていき、先生のおかげで食事の味もわかるようになり、食事が自分を傷つけるための手段から、先生と楽しいひとときを過ごせる時間に変わっていく様子\n・ヒナのおでぶ体型を肯定してあげて、もちもちの身体をかわいがるヒナ大好き先生と、こんなにも醜くなってしまったのに先生に赦されて愛されるしあわせで脳がとろけちゃうヒナ\n・(恥ずかしい…でも興奮しちゃう)といった感じでドカ食いを先生に見られる事に興奮を感じてしまうヒナ\nあたりを見れたら嬉しいな、と思います。\n\n以上となります！長々とした依頼文でしたが、よければ受けていただけると嬉しいです！", "nc": 58, "word_count": 10458, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@nazomemo55/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 668819, "client_id": 450065, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f05699c/uploads/origins/7cd1d055-0958-4de7-b230-106fcd2c350c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca96618a3d83a61648701a4c3121c53c", "srcset": "https://si.imgix.net/6f05699c/uploads/origins/7cd1d055-0958-4de7-b230-106fcd2c350c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca96618a3d83a61648701a4c3121c53c, https://si.imgix.net/6f05699c/uploads/origins/7cd1d055-0958-4de7-b230-106fcd2c350c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d22b5028b071f7fba8e650bb3a972310 2x, https://si.imgix.net/6f05699c/uploads/origins/7cd1d055-0958-4de7-b230-106fcd2c350c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aef276e68cd557c502972a5df68ef3f0 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6f05699c/uploads/origins/7cd1d055-0958-4de7-b230-106fcd2c350c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37330ba366c180cbec5d5586665aa265", "srcset": "https://si.imgix.net/6f05699c/uploads/origins/7cd1d055-0958-4de7-b230-106fcd2c350c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37330ba366c180cbec5d5586665aa265, https://si.imgix.net/6f05699c/uploads/origins/7cd1d055-0958-4de7-b230-106fcd2c350c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=56f507d2345ef1f926fcd1a38f3713af 2x, https://si.imgix.net/6f05699c/uploads/origins/7cd1d055-0958-4de7-b230-106fcd2c350c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=93eaee16307587cb407c5cf76fce3b6c 3x"}, "body": "現代学校(女子高)もので異世界女神の豊穣の加護で時間経過による一斉肥満化をお願い致します。\n現在世界は痩せているのがだめだと思い異世界から豊穣の加護を祝福にきました。\n女子生徒が授業中に学校にいる時急に肥満化が始まり世界規模で肥満化始まります。\n同時に300kgに肥満化します。\n学校にいることがこわくなり脱出しようとします。\n2階の教室から1階に階段を使って移動しますが\n体力、筋力ともに重さに耐えられず立てなくなっていきます。\n自分たちではどうすることもできいないので親や妹などに連絡しますがデブ声でお互い話しずらく聞き取りにくい状況になり\n自分たちも同じ状況で他でも連絡がきているため対応できないと言われます。肥満化で息苦しくなり\n状況把握のためスマホやテレビで状況を確認して世界中が肥満化になっているのを確認し絶望し、\n自分たちも肥満化より動けなくなって疲れてしまい酸欠状態ぎみで倒れます。\nモブが会話を入れてもらう場合は肥満化で辛そう状況でお願いします。\n学校に残され主人公が徐々に肥満化ハザード中で絶望していくことに重きをおいております。\n身長、体力、筋力がデフォで変わら日常できることが出来なくなっていきます。\n肥満化経過は1.【パニック感】2.【重さを感じること】3.【動きずらさ】4.【しゃべりずらさ】5.【息苦しさ】になります。\n全キャラを肥満体形は顔と胸とお腹中心の締まりのないだらしない太り方で肥満化でお願いします。\n体重は300kgから肥満化が始まり500kgで終わるくらいをイメージしております。\nキャラ及びモブキャラ前回と同じで問題ございません。\n\n\n肥満化後は会話文をひらがなで書いていただくようお願い致します。\nデブ声でひらがなもったりしているのがかなり好きです。\n前回からの抜粋です。\n【こひゅぅぅ…ずみまぜぇぇん、きぎどれなぐでぇぇぇ…むぶぅぅぅ、もぉいちどおねがいしまずぅぅ…】\nの表現が大好きです。\n女神も自己肥育目覚めデブ声でもったり会話文を書いていただければと思います。\n改変後の世界のある場合でもデブ声でひらがなもったりしてしていただければと思います。\n全編デブ声小説が好きです。\n\n色々と書いてありますが書きやすいよう書いていただいて問題ございません。\n何卒宜しくお願い致します。", "nc": 58, "word_count": 13899, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@nazomemo55/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/59ef6be8/uploads/origins/ead45ed6-c417-41fd-8641-296da6547637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=21b530fa2b6d3489a6ca75ba6f4df59b", "srcset": "https://si.imgix.net/59ef6be8/uploads/origins/ead45ed6-c417-41fd-8641-296da6547637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=21b530fa2b6d3489a6ca75ba6f4df59b, https://si.imgix.net/59ef6be8/uploads/origins/ead45ed6-c417-41fd-8641-296da6547637?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=94a4bdb26c25832c09b9794620c14686 2x, https://si.imgix.net/59ef6be8/uploads/origins/ead45ed6-c417-41fd-8641-296da6547637?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d2258752d953b72ed480307c677a631 3x"}, "private": true, "genre": "novel", "tipped": true, "creator_id": 668819, "nc": 178}, {"path": "/@nazomemo55/works/4", "private_thumbnail_image_urls": {"src": "ht