e9b9-4a59-8e68-ac68063dd7d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d28d39f5d9369ea4141f6ead2979827, https://si.imgix.net/89462f0d/uploads/origins/c556b43e-e9b9-4a59-8e68-ac68063dd7d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cca0e43594d105dcbe9274b5c565d31b 2x, https://si.imgix.net/89462f0d/uploads/origins/c556b43e-e9b9-4a59-8e68-ac68063dd7d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=90bf32691fb586b65b5716bc563326f4 3x"}, "body": "はじめまして荒木テオさん、ヒョウガと申します。\n今回は荒木テオさんにリクエストしたいイラストがありまして、もしよろしければお願いします。\n\n今回のリクエストしたいキャラはskimaで迎えた男の子、詳細な設定はまだですが応援団所属DC1年生、天然。\nキャラの外見は下記のサイトに参考にしてください。\nhttps://skima.jp/dl/detail?id=303638\n\n今回の依頼はカラーイラストで、二つのリクエストあります。\n\n一つ目はこの子の立ち絵風イラスト。\n全身(全体)を見える様な構図で、何かのモーションやシチュエーションを加えた作品を荒木テオさんに頼みます。\n\n二つ目はこの子のイラストです。\nこの子の応援団活動中をイメージしたの一枚を荒木テオさんお願いします。\n\nキャラの背 景透過と原寸未統合PSDファイルの提供をお願いします。\n出来た作品(キャラ)は個人のSNS関連の使用・グッズ化・商品化への予定や\n作品(キャラ)を他のクリエイターに描いていただくこともございます。\nご検討のほどお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@arakitewo/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2583803, "client_id": 108603, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/124eed40/uploads/origins/126edba6-6a5d-4d5f-a8ca-7b3f0ff9ed07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47b93347439393704d5072a8a3c1872f", "srcset": "https://si.imgix.net/124eed40/uploads/origins/126edba6-6a5d-4d5f-a8ca-7b3f0ff9ed07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47b93347439393704d5072a8a3c1872f, https://si.imgix.net/124eed40/uploads/origins/126edba6-6a5d-4d5f-a8ca-7b3f0ff9ed07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=296ad5e8e31ff81317147f11d887c5cc 2x, https://si.imgix.net/124eed40/uploads/origins/126edba6-6a5d-4d5f-a8ca-7b3f0ff9ed07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d9ab59414f67a9b57146d1a38dc98b9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/124eed40/uploads/origins/126edba6-6a5d-4d5f-a8ca-7b3f0ff9ed07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd210ab632a673000e793b31b9b4276b", "srcset": "https://si.imgix.net/124eed40/uploads/origins/126edba6-6a5d-4d5f-a8ca-7b3f0ff9ed07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd210ab632a673000e793b31b9b4276b, https://si.imgix.net/124eed40/uploads/origins/126edba6-6a5d-4d5f-a8ca-7b3f0ff9ed07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5af6a4cd02ad55d6155e959c5c044636 2x, https://si.imgix.net/124eed40/uploads/origins/126edba6-6a5d-4d5f-a8ca-7b3f0ff9ed07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=707dbb97857d630e12196542ffd2fc7e 3x"}, "body": "荒木テオ様、先日はうちの悠宇の素敵でえっちなイラストを描いてくださり、本当にありがとうございました。\nhttps://skeb.jp/@arakitewo/works/3\nもしよろしければまた、私のオリキャラ「仁科悠宇」のイラストを依頼したいです。\n・シチュ\nリングコスチューム姿の悠宇がプロレスのリング上で、全身黒タイツ姿の対戦相手に【ちんぐり返し】のような体勢でふとももを両手で押さえつけられ、その体勢のままビキニパンツを履いたままパンツをずらされてモブの長いち◯ぽを挿入されて、ビキニパンツ越しに絶叫絶頂射精してしまう悠宇のイラストをお願いしたいです。\n「ちっ♡ ち◯ぽち◯ち◯ぽっ！！♡♡ おっっ…きぃっ！！♡♡」「イクイクイクイクイク……♡ イ゛っくぅぅぅっっ…！！♡♡」とという悠宇のセリフもお願いします。\nちんぐり返しの資料はこちらを参考にしてください。\nhttps://dic.pixiv.net/a/%E3%81%A1%E3%82%93%E3%81%90%E3%82%8A%E8%BF%94%E3%81%97\nまた、悠宇の表情と身体、股間、挿入されている所を描写していただきたいです(描き方としては、画面に向かってちんぐり返しされている感じ)\n・衣装\n悠宇は、前回と同じように\n上半身裸に黒チョーカー、下半身は純白ビキニパンツ、左ふとももに赤のベルトガーターリング、白のニーパッドとレガースでお願いします。\n対戦相手の男は全身黒タイツで肥満体型。前回と同じく顔の描写は必要ありません\n・キャラデザ参考資料\nhttps://x.com/afpw_jobberera/status/1412568764978061313?s=46&t=FXKpE6XmgH_jXYKUip0qLg\nhttps://www.pixiv.net/artworks/91128852#manga\n (3枚目のオレンジ色の髪の男の子です)\n\n\nなにとぞ、よろしくお願いします。\n\nhttps://dic.pixiv.net/a/%E3%81%A1%E3%82%93%E3%81%90%E3%82%8A%E8%BF%94%E3%81%97", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@arakitewo/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2583803, "client_id": 1459073, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/df374298/uploads/origins/97915999-c173-4395-bc65-390fd858853e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=675a5373c796ba4efccaeb381904d740", "srcset": "https://si.imgix.net/df374298/uploads/origins/97915999-c173-4395-bc65-390fd858853e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=675a5373c796ba4efccaeb381904d740, https://si.imgix.net/df374298/uploads/origins/97915999-c173-4395-bc65-390fd858853e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4df76ab5d5f2a8f40f25df4ca8630e1 2x, https://si.imgix.net/df374298/uploads/origins/97915999-c173-4395-bc65-390fd858853e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7ee0e3bdf1b812a226be0f80da4ce81 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/df374298/uploads/origins/97915999-c173-4395-bc65-390fd858853e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=363521261dfd59c11ec8b994cd48505c", "srcset": "https://si.imgix.net/df374298/uploads/origins/97915999-c173-4395-bc65-390fd858853e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=363521261dfd59c11ec8b994cd48505c, https://si.imgix.net/df374298/uploads/origins/97915999-c173-4395-bc65-390fd858853e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=536a0299519c33f6b49920f2763c94f3 2x, https://si.imgix.net/df374298/uploads/origins/97915999-c173-4395-bc65-390fd858853e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bf