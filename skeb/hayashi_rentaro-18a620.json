d2-c1de75b1197e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=342f3b8694b285f85101fd4b43813b50, https://si.imgix.net/093eed77/uploads/origins/ba3a7706-fce9-4382-a3d2-c1de75b1197e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c36d1c1dddc8a8aed24db2d9cb5bb8f1 2x, https://si.imgix.net/093eed77/uploads/origins/ba3a7706-fce9-4382-a3d2-c1de75b1197e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5fe6628e715358b9e456fb3a69552d7c 3x"}, "body": "こんにちは！あなたの絵のスタイルがとても素敵なので、私のキャラクター「クモメ」を描いていただけないでしょうか。\nhttps://imgur.com/a/kumome-reference-I6BnwJG\n\nクモメには、クモや不気味な要素、歯車、そしてワイヤーをモチーフにしたデザインが特徴です。精神的に崩壊するたびに、ワイヤーが切れる様子で表現されます。\n\n彼は機械やロボットが大好きです。弱いものに対して弱いところがあり、それが、人間ではなく哀れな存在である恋人にこれほどまでに執着する理由の一つでもあります。彼は、様々なスクリーンや配線で覆われた自分の研究室に住んでいます。そこはまるで蜘蛛の巣のようです。 クモメは非常に知的な青年だが、深い不安を抱えており、自分は何の価値もないと信じ込んでいる。それでも、ロボットである恋人を守り、修理することに自らの存在を捧げている。彼は深い不安を抱えた青年であり、恋人への執着によってかろうじて正気を保っている。 \n\nクモメはただ微笑んで黙って苦しむことを心がけているが、限界まで追い詰められるとキレてしまう。キレた時、彼は微笑みを浮かべたまま残酷な振る舞いをするか、あるいは耐えきれなくなると、穏やかで忍耐強い表情が崩れ、狂気じみた表情を浮かべる。\n\nクモメは感情の起伏が激しい男で、それを表に出さないよう必死に努力しているが、心の中は荒れ狂っている。その思考は、将来の実験やロボット工学に関するアイデアから、自殺願望に駆られて死を望むことまで多岐にわたる。彼は、恋人への執着心によって、自らの死についての考えから気をそらそうとしている。 \n\n彼について、お好きなように自由に創作してください！このリクエストについて、もっと詳細なアイデアがあれば、追加のリクエストも大歓迎です！\n\n必要であれば、彼の恋人の画像はこちらです https://imgur.com/a/denkai-Cd4vcl1\n\nhttps://imgur.com/a/kumome-reference-I6BnwJG", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hayashi_rentaro/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2493043, "client_id": 18831, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d7eb3af/uploads/origins/2cbf3d8a-f124-43ed-bc02-63974bdd2437?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ceff05a55a5f8f9252da73fe987c4db2", "srcset": "https://si.imgix.net/0d7eb3af/uploads/origins/2c