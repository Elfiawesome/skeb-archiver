少し大きく、抱っこすると収まりの良いサイズ感\n・尻尾の先が黒い\n▼性格\n・ころすけよりしっかり者\n・保護者気質だけど、かわいいマスコット的存在\n\n────────────\nお忙しいところ恐縮ですが、ご検討のほどよろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/16KYJQd7-Wq95Vy-3XZ_g_dHrtQRx_57r?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@P_Q0112/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4071574, "client_id": 3911082, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3b7461d1/uploads/origins/fa2d5ac5-f011-4900-ae31-94fc1f868faf?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=59eeb488a583bbd8aa7ffa4dd6f7be5a", "srcset": "https://si.imgix.net/3b7461d1/uploads/origins/fa2d5ac5-f011-4900-ae31-94fc1f868faf?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=59eeb488a583bbd8aa7ffa4dd6f7be5a, https://si.imgix.net/3b7461d1/uploads/origins/fa2d5ac5-f011-4900-ae31-94fc1f868faf?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba9e519cf2ea80d07b9cd3c769f89501 2x, https://si.imgix.net/3b7461d1/uploads/origins/fa2d5ac5-f011-4900-ae31-94fc1f868faf?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=45fa885cb51fcd8f7a9017983c5a3122 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3b7461d1/uploads/origins/fa2d5ac5-f011-4900-ae31-94fc1f868faf?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=751ffe282ad424c313a3632d3298840f", "srcset": "https://si.imgix.net/3b7461d1/uploads/origins/fa2d5ac5-f011-4900-ae31-94fc1f868faf?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=751ffe282ad424c313a3632d3298840f, https://si.imgix.net/3b7461d1/uploads/origins/fa2d5ac5-f011-4900-ae31-94fc1f868faf?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=149bdd32f103ff5132e7242da92517c4 2x, https://si.imgix.net/3b7461d1/uplo