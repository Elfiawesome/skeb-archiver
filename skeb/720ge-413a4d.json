ins/c31921a2-6f0c-4498-8304-cb043586c288?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee02f74cef81856f06bf0a6e834b1bf4, https://si.imgix.net/e259ef9a/uploads/origins/c31921a2-6f0c-4498-8304-cb043586c288?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=176fa798a66de3a0ef8b05aa5904a344 2x, https://si.imgix.net/e259ef9a/uploads/origins/c31921a2-6f0c-4498-8304-cb043586c288?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e7b14078bbafaddfc751df0428ec6953 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e259ef9a/uploads/origins/c31921a2-6f0c-4498-8304-cb043586c288?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37579df1b9d79e294eb1408a8000d8cd", "srcset": "https://si.imgix.net/e259ef9a/uploads/origins/c31921a2-6f0c-4498-8304-cb043586c288?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37579df1b9d79e294eb1408a8000d8cd, https://si.imgix.net/e259ef9a/uploads/origins/c31921a2-6f0c-4498-8304-cb043586c288?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=36b904059fd868317b52a633c413d968 2x, https://si.imgix.net/e259ef9a/uploads/origins/c31921a2-6f0c-4498-8304-cb043586c288?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8a6ff7a13d823e77459cc21b3ca333f4 3x"}, "body": "初めまして。式と申します。\n今回は私と友人のTRPGのキャラクターを描いていただきたいと思いリクエストを送らせていただきました。\n(友人には許可を得ています)\n\nCoCシナリオ「OTHEllO - the Dee of Nara」を通過した刑事バディです。\n以下にネタバレを含まないかたちでキャラ設定を記載します。\n\n\n▽HO1: 英禰 晨(あくね とき)\n男性/174cm/30歳\n奈良県警中央署捜査一課の刑事。愛想がよく落ち着いた性格。\nふわふわしている印象を受けるが使えるものは使う精神の利己的な一面がある。よく言えば世渡り上手。\n体当たり捜査より効率よく事を進められるよう動くタイプ。\n\n[外見的特徴]\n・ボブヘア、髪色は蘇芳香(赤みの褐色)\n・イライラすると爪を噛む癖があり、噛み防止で常時手袋つけている\n・モチーフは早朝\n\n\n▽HO2: 吉野 悠也(よしの ゆうや)\n男性/178cm/25歳\nHO1の相棒として一課に配属された。\nいわゆる「キャリア組」の警察官だが、かっちりしておらず、不真面目でルーズな印象を与える人。\n進んで他人と交流を持つタイプで、先輩警察官にしばしば甘えて世話を焼かせている。片付けが苦手。\nおしゃれ好き。趣味は読書で、小説とファッション誌を読むことを好む。\n\n[外見的特徴]\n・長髪、髪色は青紫〜ピンクのグラデーション\n・シルバーアクセサリーをしている(チョーカー、指輪)\n・表情豊か\n・モチーフは夕焼け(青紫にピンクが差しこむ焼け空のイメージ)\n\n\n▽二人の関係性など\n・HO1が先輩、HO2が後輩です。\n\n\n▽用途\n・個人的な観賞用\n・個人利用目的でのグッズ作成\n\n\n内容に問題や金額不足などあれば再送信またはキャンセルをよろしくお願いします。ご検討いただければ幸いです。\n\nhttps://drive.google.com/drive/folders/1t-qpGjxM2QKQjomTPdDnLN1JR562-WXG", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 19297, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "宇野山むじ / COMITIA156 I-05a", "screen_name": "uimss", "avatar_url": "https://pbs.twimg.com/profile_images/1833036325219614720/bpzc2qBP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/80830269/1749634563/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 40, "skills": [{"genre": "art"}, {"genre": "video"}], "banned": false, "nc": 144}, {"id": 1376036, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "mo-ja", "screen_name": "mo__________ja", "avatar_url": "https://pbs.twimg.com/profile_images/1449714315892707329/arxwaWGi.png", "header_url": "https://pbs.twimg.com/profile_banners/1200417902345609221/1575038805/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "novel"}, {"genre": "correction"}], "banned": false, "nc": 17}, {"id": 1502952, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "za!", "screen_name": "monogusatar", "avatar_url": "https://pbs.twimg.com/profile_images/1697102063820513280/8-twf6qS.jpg", "header_url": "https://pbs.twimg.com/profi