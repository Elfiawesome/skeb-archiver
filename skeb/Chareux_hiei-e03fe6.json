和「もう♡髪にもかかっちゃった…♡」と、口元の精液をペロっと舐める\nモブ整備員ACはガチガチに勃起した肉棒を大和に突きつけ「俺も！」「俺もお願いします！」\n大和「ふふ…駄目ですよ♡王様の命令じゃないと…さ、王様ゲームの続き、しましょう♡」とえっちに微笑む\n\nモブ整備員の顔の描写はなしで\n以前出されていた摩耶様の同人誌のパイズリがすごくえっちだったので、あんな感じのパイズリを描いていただけたら嬉しいです\n\nご検討お願いします", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Chareux_hiei/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/371e3e61/uploads/origins/5d741e6e-df06-45bb-873c-0fbe0f32314d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=73cb1324cf28f525a1760ccb349cc071", "srcset": "https://si.imgix.net/371e3e61/uploads/origins/5d741e6e-df06-45bb-873c-0fbe0f32314d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=73cb1324cf28f525a1760ccb349cc071, https://si.imgix.net/371e3e61/uploads/origins/5d741e6e-df06-45bb-873c-0fbe0f32314d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b706f0f19b9d3dd9cd7a392f8310bb4a 2x, https://si.imgix.net/371e3e61/uploads/origins/5d741e6e-df06-45bb-873c-0fbe0f32314d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=74a358c9aaa419bff7a6e4c0a0d32209 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 8066, "client_id": 165205, "nc": 33}, {"path": "/@Chareux_hiei/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 8066, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8822306/uploads/origins/ac4f1a37-a6ab-45ec-96ae-0a673791225b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=20