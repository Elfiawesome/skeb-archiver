gix.net/b3072b71/uploads/origins/34446de3-1e88-474c-ad31-9b09c71118e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6620b3d8018a24181af170dd36847c0e, https://si.imgix.net/b3072b71/uploads/origins/34446de3-1e88-474c-ad31-9b09c71118e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0dea6e186ad851ab1dbac9ff44fb32bc 2x, https://si.imgix.net/b3072b71/uploads/origins/34446de3-1e88-474c-ad31-9b09c71118e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13a6f9caaf950ccb82e413481e3d037b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3072b71/uploads/origins/34446de3-1e88-474c-ad31-9b09c71118e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efe1b382c08748ae1c8c19accb4e87c3", "srcset": "https://si.imgix.net/b3072b71/uploads/origins/34446de3-1e88-474c-ad31-9b09c71118e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efe1b382c08748ae1c8c19accb4e87c3, https://si.imgix.net/b3072b71/uploads/origins/34446de3-1e88-474c-ad31-9b09c71118e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6edd41667a41f9b1ca08847efc4f83f6 2x, https://si.imgix.net/b3072b71/uploads/origins/34446de3-1e88-474c-ad31-9b09c71118e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=318cd654056e7967dce30b0aa33113a4 3x"}, "body": "初めまして。\nXで無縫様の素敵なイラストをお見掛けし、一目ぼれいたしました……！\n和を感じるタッチと色使い、物静かそうな場面の中に感じる少しの不気味さがとても大好きです！\nお忙しいところかとは思いますが、宜しければ作成した探索者のイラストを描いていただきたいです。\n\n─キャラ─\n・西園寺 公孝　（さいおんじ きみたか）\n一人称「僕」\n二人称「お前」「貴様」\n代々医者の家系に生まれた一人息子。\nオカルトが大の苦手な高校生男子。\nだがオカルト部に所属しており、強がって平気な振りをしているが内心ビビりながら部活に参加している。\n突然現れた見知らぬ兄を名乗る化け物に怯え切っているが、何度も巻き込まれる怪奇現象から助けられるため、段々と心を許してきている。\n\n↓詳しい設定が載っているキャラクターシート\nhttps://iachara.com/view/5585855\n\n\n・西園寺 宗一郎　（さいおんじ そういちろう）\n一人称「僕」\n二人称「呼び捨て」\n本来存在しないはずの公孝の兄を名乗る化け物。\n怪奇現象に巻き込まれる公孝を何故か守ってくれる兄。人の姿をしているが人間界に馴染むためにしているだけで本来の姿は悍ましい化け物。\n公孝の事をいたく気に入っており、「おにいちゃんが守ってあげる」とよく口にする。\nスキンシップが激しい。結局は人外なので思考は人とずれている。\n\n\n参考資料：https://drive.google.com/drive/u/1/folders/1kWp0ceF1to15kkuuxp77XCys5YQRLOA7\n茶髪金目のセンター分けが公孝、前髪をおろしている方が宗一郎です。\n\n─関係性─\nオカルト嫌いの公孝が様々な怪奇現象に遭ったところを、自称兄の化け物が助けています。\n同じ家に住んでおり、いるはずのない兄という存在に家族は何の違和感を覚えることなく接しています。\n\n\n無縫様のスケブで納品されていた、映画ポスター風とコマ割りされていたイラストの作風がとても素敵でしたので、宜しければそのような雰囲気のイラストを希望いたします！\n他に関連しそうな要素をあげさせていただくと\nオカルト/都市伝説/田舎/学校/夕方/帰り道/梅雨/夏/山道 等です……！\n\n─用途─\n個人的な観賞用。\n\n\n金額不足などございましたら再送してください……！\n何卒宜しくお願い致します！", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@GSriz/works/250", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 1616186, "client_id": 3210683, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e536f530/uploads/origins/10f5c164-ea44-436b-9309-f4c636bfa197?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c94dd676ebf423092fb3a3de858291cf", "srcset": "https://si.imgix.net/e536f530/uploads/origins/10f5c164-ea44-436b-9309-f4c636bfa197?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c94dd676ebf423092fb3a3de858291cf, https://si.imgix.net/e536f530/uploads/origins/10f5c164-ea44-436b-9309-f4c636bfa197?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7f427cedee2d0786ab7998cba959a74b 2x, https://si.imgix.net/e536f530/uploads/origins/10f5c164-ea44-436b-9309-f4c636bfa197?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f2c7460155f83d0e86d7a4c33f5cac6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e536f530/uploads/origins/10f5c164-ea44-436b-9309-f4c636bfa197?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bda71177368db774e03a671430372fb0", "srcset": "https://si.imgix.net/e536f530/uploads/origins