0&s=61811ed7bf25db6dd5a92f5ae09180ce", "srcset": "https://si.imgix.net/a07a9a85/uploads/origins/14c03f07-5632-47ff-9cb4-8e24d3c24fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61811ed7bf25db6dd5a92f5ae09180ce, https://si.imgix.net/a07a9a85/uploads/origins/14c03f07-5632-47ff-9cb4-8e24d3c24fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c60875210d3feb1d21986df7480feb92 2x, https://si.imgix.net/a07a9a85/uploads/origins/14c03f07-5632-47ff-9cb4-8e24d3c24fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f445c1dc9975893b2e9c5a4bacfe422d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a07a9a85/uploads/origins/14c03f07-5632-47ff-9cb4-8e24d3c24fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ceeca3bd0fe061a3b850d999925aafa6", "srcset": "https://si.imgix.net/a07a9a85/uploads/origins/14c03f07-5632-47ff-9cb4-8e24d3c24fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ceeca3bd0fe061a3b850d999925aafa6, https://si.imgix.net/a07a9a85/uploads/origins/14c03f07-5632-47ff-9cb4-8e24d3c24fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4b3c41ce84c2564979c1878efcbff75c 2x, https://si.imgix.net/a07a9a85/uploads/origins/14c03f07-5632-47ff-9cb4-8e24d3c24fe6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc7ddc6cea5ea7cdfc89f541eea60fef 3x"}, "body": "そうたつ様\n初めまして。以前より作風、特に格闘描写が素敵でいつか機会をと思っていましたが、この度Xにて募集されていたのをお見かけしましたので、今回ご依頼をさせて頂きたく参上致しました。\n\n資料:https://imgur.com/tocDwyu\nこれは大分昔にとある掲示板で描いて頂いたものですが、この度の依頼はこちらをリメイクして頂くという形になります。\n以下、キャラ設定です。\n\n性別は女性、年齢は18歳女子高生。髪は黒のショートカットです。\n性格はとても明るく、格闘技が好きでキックボクシングのジムに通いつつ、実家が古武術の道場なのでそちらも嗜んでいる。\n現実よりストリートファイトの盛んな世界で、そちらにも片足を突っ込んでおり、そこそこ名が知れている。\n以前、ストリートの試合で酷い腹パンKOされたのがちょっとしたトラウマになっていて、それをきっかけに徹底的に腹筋を鍛え直した。\n結果、一部(主に愛好者)で注目を集める程造形的にも見事な腹筋を作り上げたが、同時に妙に狙われやすくもなって、腹からのダメージが起因で苦戦する事が多くなり、硬いが脆いガラスのボディなどと不本意な風評を得る事となってしまった。\n\n\n長くなるので割愛していますがこんな感じです。\n\n服装の方はノースリーブのハーフトップ、資料ではジャケットを羽織っていますがこちらをパーカー的な物に、ジーンズをホットパンツに、指ぬきグローブはそのままにバンダナは外す感じで、いわゆるストリートファッション風にお願いします。\n構図や服装の配色等はお任せします。\n設定に書かせて頂いた通り、腹筋はかなり盛って頂けると幸いです。\nあと、バストは控えめです。\n\n以上です。\nご検討のほどよろしくお願いします。", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Sawtatsu/works/20", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1839ce28/uploads/origins/bc91f7e8-9449-4bb8-8f75-9af8c2960a8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1694be8f18d2a589ba4ce84833af1216", "srcset": "https://si.imgix.net/1839ce28/uploads/origins/bc91f7e8-9449-4bb8-8f75-9af8c2960a8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1694be8f18d2a589ba4ce84833af1216, https://si.imgix.net/1839ce28/uploads/origins/bc91f7e8-9449-4bb8-8f75-9af8c2960a8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a709d6f7b3df7af5bfc82ab365c45139 2x, https://si.imgix.net/1839ce28/uploads/origins/bc91f7e8-9449-4bb8-8f75-9af8c2960a8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d34631bfce163e07af34f5ba949ab4db 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2761626, "nc": 48}, {"path": "/@Sawtatsu/works/19", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9ef08a17/uploads/origins/6913ccca-721b-42ef-87cd-735caed8dc40?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&tx