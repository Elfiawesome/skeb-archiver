f&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0d140d4bd5a7c4d1740b7315239688bd", "src_set": ""}, "body": "こんにちは。いつも表＆R18＆FF14垢、それぞれを楽しく拝見しております。\n本日は、FF14で作って遊んでいるキャラクタを描いてほしく、SKEBにまいりました。\n\nミコッテ族のムーンキーパー、ブランシュことブランちゃんをお願いしたいです！\nミコッテ族ですが角が生えていて（資料2枚目参考）角の色は髪色と同じく根本が緑→先端が白、の設定です。\n（角は秋ごろにくる、昨年のイベントアイテム販売で染色する予定です（現在は染色できないものなので、この色に……）\n角が生えていることで色々と辛い過去もあり、17歳ですがにこっと笑えることは少なく、感情を押し殺したような表情をよくします。\n根は寂しがりやで、人と平和に仲良くしたい…と思っている、小動物的な子です。\n\nボインちゃんであるという設定なので、たかこさんのFF14キャラクタにいる、ラピスラズリさんくらいの胸の大きさであれば嬉しいな…と思います。\n\n服装・構図等については指定ありませんが、資料２枚目画像が、いちばん普段着として使用している設定です。\n今は夏なので薄着にされてもOKです、嬉しいです！（？\n\n以上になります。よろしくお願いします！\n\nhttps://x.com/tunoneko/status/1955234857354924528", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takoppai/works/26", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a621fae7/uploads/origins/e0fa2bb8-8353-4d0a-8f18-e727c46bd3d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3585fea8f7029160b8ebc8c79c5da8e3", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 132213, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@takoppai/works/25", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 132213, "client_id": 40100, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b2b68498/uploads/origins/51e5c235-0c3b-4a5b-8d9b-5c00d7aeda6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=814725933a8c1254b3db6f5917f54496", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": 