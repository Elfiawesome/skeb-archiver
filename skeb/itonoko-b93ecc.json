い夢中になってしまう好奇心旺盛な子で、いろんな味の豆乳が好きです。\n\n構図など全てお任せします。資料の服装と全然違っても大丈夫です。\nハッサンさんのイラストは、肇にとても似合うのでは、と思っています。\nぜひよろしくお願いいたします。\n\nhttps://twitter.com/itonoko/status/1524603273503977472", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 18953, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Downy🦈", "screen_name": "dwnydwdw", "avatar_url": "https://pbs.twimg.com/profile_images/1371860138206765057/j65VGAZk.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2613815670/1615911920/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 715141, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "マヤヅカ🐻‍❄️", "screen_name": "3Renico", "avatar_url": "https://pbs.twimg.com/profile_images/1457311709052686339/7IXdb8ZF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1206779228278013953/1746706847/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "video"}], "banned": false, "nc": 161}, {"id": 930419, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "OGGMariné(まりね)🍍", "screen_name": "OGG_ZIP", "avatar_url": "https://pbs.twimg.com/profile_images/1690991605019545600/OBJficXD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/127785954/1645433845/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expirati