4-6521-4cdc-81f7-9f137970771f?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=29e8ce8815f9993075ab3106a876f56e", "src_set": ""}, "duration": 2, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/117b8c45/uploads/outputs/0b5eb494-6521-4cdc-81f7-9f137970771f?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=e911f4cdc948b621713a994ae0f83fb3", "src_set": ""}, "body": "こんにちは！アニメーションをお願いしたいのですが。\n\nこの有名なミームのポーズをするサヌとクシャモが見たいです。\nhttps://i.imgur.com/Q3TPD4E.gif\n\nサヌが消えていく。横に立つのはクシャモ。\n\n背景はお好みで。\n\n細かい部分を追加したり、フレームを増やしたりすることができます。\n\nそれに、私はあなたのキャラクター「ふれら」がとても好きです。もしお望みなら、このアニメーションの中にふれらを追加していただいてもかまいません（必須ではありません）。\n\nありがとう！\n\n参考\n\nサヌ：https://i.imgur.com/MwhKk60.png\n\nクシャモ：https://drive.google.com/file/d/1LkPY516kYy59ORKn-94_Y0drXl8KQrXn/view", "nc": 0, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": false}, {"path": "/@monufun_f/works/94", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 866185, "client_id": 35611, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d138acc1/uploads/origins/c3c5a823-0297-43de-9373-ce822917a86b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ce5cfe3eb31842da7ca34a9e7312dd4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d138acc1/uploads/origins/c3c5a823-0297-43de-9373-ce822917a86b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=df28b902faf613e0997a3a9ba6d989e1", "src_set": ""}, "body": "ふーさんこんにちは！いつもふーさんの色遣いと絵柄が大好きです！\n\nうちの子（代理キャラ/ファーソナ/アバター）をふーさんのスタイルでお願いしたいです！名前はフォンデュです！\n普段は明るいけど、シャイな一面もある子です！\n\nそれと、ふーさんちのフレラちゃんが大好きです...！もしよろしければ、フレラちゃんと一緒の構図をお願いしたいです！シチュは撫でるとか、抱きしめるとか、一緒に遊ぶとか、じゃれあうとか、どれくらい親しいのはふーさんにおまかせします！\n\n一緒ではダメな場合はうちの子ソロでお願いします！その時にシチュや構図や背景などは全部おまかせします！\n\nよろしくお願いします！\n\n利用範囲\n◆自分のSNSへクリエイター名を明記したうえでの掲載\n◆個人使用（非商用）の範囲での印刷\n\nhttps://i.imgur.com/VC2KmdC.png\n\nhttps://drive.google.com/drive/folders/1zR0O6BPp-fFABzQmoSi0TkxiB9CC0mTA", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@monufun_f/works/93", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 866185, "client_id": 1853457, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/699da20e/uploads/outputs/3ca051cb-a71f-49c8-83c2-981747ede7ed?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=3b6c0e170083939e3da3015cacee2187", "src_set": ""}, "duration": 13, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/699da20e/uploads/outputs/3ca051cb-a71f-49c8-83c2-981747ede7ed?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=11abdb9bb745f3c645a2fed23c1a9ba5", "src_set": ""}, "body": "また会えて嬉しいよ！とても寂しいよ！\n冒険チーム（https://skeb.jp/@monufun_f/works/52）をフィーチャーした作品をまた依頼できることに興奮しています。\nでも今回は、とってもキュートなフレラちゃんたちと一緒に冒険したいんだ！\nフレラちゃんは好きなクラスを選べるよ！\n\n動画の内容はこちら：\n\n1.1.宝箱を見つけ、喜んで開けるが、ミミックだった！\n2.ミミックに食べられそうになり、必死にもがくがうまくいかない。\n3.その後、フレラちゃんが通りかかり、その光景に怖がる。\n4.フレラちゃんが駆け寄り、私をミミックから引きずり出そうとする。\n5.最終的にフレラちゃんは私を助けることに成功するが、私はマントが千切れたり、毛皮がぐちゃぐちゃになったりと怪我をしてしまう。\n6.最後に、フレラちゃんは私を慰め、優しく抱きしめてくれた。私はとても幸せで、涙を浮かべながら満面の笑みを浮かべている。\n\n\n私がミミックに食べられている写真を使ったカードかキーホルダーを作る予定なので、そのシーンをできるだけ奇妙で面白いものにしてください！\n\nありがとう！LOVE YOU\n\ndado:https://drive.google.com/file/d/11ufEGmALSmDKTmR-ig87-q1IiIX9HL9a/view?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": false}, {"path": "/@monufun_f/works/92", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 866185, "client_id": 2110517, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/07126f34/uploads/origins/47890b80-9855-4cf9-9a21-51fe2c32f640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top