か？\n内容は牛柄の眼帯ビキニを着たうちの子が搾乳されている絵をお願いします。\n・ビキニを片方ズラして搾乳器で搾乳されていてる。もう片方の父はビキニをずらして母乳が大量に吹き出している。\n・表情はトロ顔\n・おっぱいは前回同様可能な限り大きく、体はmilさん家のミル子ちゃんの搾乳されていた絵のような感じぐらいの豊満でBBWに近いような肉体\n・下は何も履かずに毛が見えていて、毛は多めで。手と足には牛柄のタイツと手袋をつけている。\n・ポーズは両手で乳を両方とも支えながら体をくねらせる感じでお願いします。\n以上の内容をこの金額でよろしければ検討よろしくお願いします！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mil_k_vanilla/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1046211, "client_id": 741479, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/01488ef2/uploads/origins/0be848ee-fd55-46b1-b2d1-8e4cd84e0ccc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02d0fbc86248766cc7a2c40af506606e", "srcset": "https://si.imgix.net/01488ef2/uploads/origins/0be848ee-fd55-46b1-b2d1-8e4cd84e0ccc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02d0fbc86248766cc7a2c40af506606e, https://si.imgix.net/01488ef2/uploads/origins/0be848ee-fd55-46b1-b2d1-8e4cd84e0ccc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=12d1739d119cdc879d6966e8c4cf11de 2x, https://si.imgix.net/01488ef2/uploads/origins/0be848ee-fd55-46b1-b2d1-8e4cd84e0ccc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1f1bea627595ac83eb5854cec9b42bd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/01488ef2/uploads/origins/0be848ee-fd55-46b1-b2d1-8e4cd84e0ccc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71a8e5b8f0b3d8cc82f9938cbae28045", "srcset": "https://si.imgix.net/01488ef2/uploads/origins/0be848ee-fd55-46b1-b2d1-8e4cd84e0ccc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71a8e5b8f0b3d8cc82f9938cbae28045, https://si.imgix.net/01488ef2/uploads/origins/0be848ee-fd55-46b1-b2d1-8e4cd84e0ccc?bg=%23fff&auto=format