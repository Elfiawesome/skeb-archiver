任せします！かわいらしいイメージでお願いします。\n\n資料を見ても不明な箇所は想像で描いていただいて大丈夫です。\n※人耳と猫耳どちらもあるのでその点だけご注意お願いします\n\n使用用途\nXとYouTubeでの投稿・サムネ等に使用させていただきたいです。\n\nその他\n・できるだけ顔周辺(髪)が見切れてないイラストでおねがいします！\n・PSD形式で、背景・キャラ・サインの3点を分けていただけると嬉しいです。\n\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1GuhBGZga8KklTaF3SgaDjbx7o1enSCJn?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wata_ann/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2986246, "client_id": 3663509, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/88e91b68/uploads/origins/178238ee-3922-49ab-a053-7e36be43788b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be14741659fae74794ec8e067431e648", "srcset": "https://si.imgix.net/88e91b68/uploads/origins/178238ee-3922-49ab-a053-7e36be43788b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=be14741659fae74794ec8e067431e648, https://si.imgix.net/88e91b68/uploads/origins/178238ee-3922-49ab-a053-7e36be43788b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=54886fda27296ca0c2bc9038e22f5c29 2x, https://si.imgix.net/88e91b68/uploads/origins/178238ee-3922-49ab-a053-7e36be43788b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de9d98df684f6da9140c0a3138d25d12 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/88e91b68/uploads/origins/178238ee-3922-49ab-a053-7e36be43788b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45c2f5bab0af73188cd3d55b3fba5ea9", "srcset": "https://si.imgix.net/88e91b68/uploads/origins/178238ee-3922-49ab-a053-7e36be43788b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45c2f5bab0af73188cd3d55b3fba5ea9, https://si.imgix.net/88e91b68/uploads/origins/178238ee-3922-49ab-a053-7e36be43