いに見えます。彼は田舎者で、公式の場では謹直で、行動が不器用で、よく間違いを犯す。\n\n描きたいイメージを自由に選ぶことができますが!\n﻿\nもし興味がなければ、キャンセルしてください！価格が不適切な場合は、リクエストを再送信すること自由に尋ねる。ありがとうございました！\n下のリンクは私のキャラクター設定です!お願いします 。\nhttps://drive.google.com/drive/folders/1-2UimkjLCEhiuzZpWAxpT9GMwfzfwcVQ\n\nhttps://drive.google.com/drive/folders/1-2UimkjLCEhiuzZpWAxpT9GMwfzfwcVQ", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tankikessen/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3188074, "client_id": 3123019, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/30ea8167/uploads/origins/89b79f5e-7dbe-4486-8fbb-ce0b2742d2d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60bcd673aa7ebf2702d3ff08ede7602b", "srcset": "https://si.imgix.net/30ea8167/uploads/origins/89b79f5e-7dbe-4486-8fbb-ce0b2742d2d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60bcd673aa7ebf2702d3ff08ede7602b, https://si.imgix.net/30ea8167/uploads/origins/89b79f5e-7dbe-4486-8fbb-ce0b2742d2d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bbfe670e5f48f9d55eaefbc151c71032 2x, https://si.imgix.net/30ea8167/uploads/origins/89b79f5e-7dbe-4486-8fbb-ce0b2742d2d8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c42f985fae125d514e1342c258ccc73 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30ea8167/uploads/origins/89b79f5e-7dbe-4486-8fbb-ce0b2742d2d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a469a06cc9543a8b652513daa646a2f4", "srcset": "https://si.imgix.net/30ea8167/uploads/origins/89b79f5e-7dbe-4486-8fbb-ce0b2742d2d8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a469a06cc9543a8b652513daa646a2f4, https://si.imgix.net/30ea8167/uploads/origins/89b79f5e-7dbe-4486-8fbb-ce0b2742