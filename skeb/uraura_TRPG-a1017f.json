oads/origins/69e98d20-0593-43de-b7ec-038fb97afa1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d90f9bf88137a273cfb128187a63d29e, https://si.imgix.net/1b347bc0/uploads/origins/69e98d20-0593-43de-b7ec-038fb97afa1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36022c25f22c50a07c190a1dcdd49fe9 2x, https://si.imgix.net/1b347bc0/uploads/origins/69e98d20-0593-43de-b7ec-038fb97afa1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6b93e0228b09afca3d808244f2d91d0c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b347bc0/uploads/origins/69e98d20-0593-43de-b7ec-038fb97afa1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f49d718f80cc3158de2986451dae825", "srcset": "https://si.imgix.net/1b347bc0/uploads/origins/69e98d20-0593-43de-b7ec-038fb97afa1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f49d718f80cc3158de2986451dae825, https://si.imgix.net/1b347bc0/uploads/origins/69e98d20-0593-43de-b7ec-038fb97afa1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=960e9ee26be6fc649b4ff5ca9a008268 2x, https://si.imgix.net/1b347bc0/uploads/origins/69e98d20-0593-43de-b7ec-038fb97afa1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b6c47730e603234037278cbc80bdc637 3x"}, "body": "𖠿⸝ﾕｶｲ様\n\nはじめまして、夜凪と申します。\n以前より密かに、𖠿⸝ﾕｶｲ様のイラストを拝見させていただいておりました。\nもしよろしければ、探索者の立ち絵を描いていただきたいと思いリクエスト送信いたしました。\nご依頼したいキャラクターは以下の通りです。\n\n----------------------------------------------------------\n【キャラクターの概要】\n●外見\n性別：男性\n身長：178cm\n年齢：36歳\n体型：大柄ではないけれど、ある程度がっしりしている。\n髪型：無造作な感じでぼさぼさ。前髪は長めで目にかかっている。\n目：目に光がなく死んだような目。目の下にクマがある。\n髭：あまり手入れできていないので無精ひげになりつつある。\n\n●性格\n元サラリーマン。\nブラック企業の営業として精神を削りながら働いていたが、知り合いの女性に騙され闇金の連帯保証人にされた。\nこれをきっかけに完全にメンタルが崩壊。何もかもがどうでもよくなってしまった。\n現在は仕事を飛んで闇金から逃亡している。\n人間への不信感が強く、特に女性に対してはトラウマがあるため極端に苦手。\n元は営業職だったため、うわべの会話や取り繕いは得意だが、無理をすればするほどグロッキーになる。\n酒とタバコに依存しており、常にタバコを吸っていないと落ち着かない。\n\n●希望\n服装については、通過予定のシナリオが夏なので季節感に合うものであれば、自由にしていただいて構いません。\nまた、もし可能であれば表情差分などを頂けると嬉しいです…！\n\n●参考資料\nhttps://drive.google.com/drive/folders/13pxWA9-d022B3pZXr0afNw2btmsV5BKn?usp=drive_link\n\n----------------------------------------------------------\n\n使用用途としては、個人観賞や同卓の身内間での共有となります。\n記載や値段などに不備がございましたら、再送要請・キャンセルしていただいて構いません。\nもしご縁がありましたらよろしくお願いいたします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1489666, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "秋瀬🥚🐣🐥", "screen_name": "akishio_trpg", "avatar_url": "https://pbs.twimg.com/profile_images/1292138146105196544/cFX4T5fU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1292134568867139589/1596904200/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 2875278, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あんどう本舗", "screen_name": "Andou_Honpo", "avatar_url": "https://pbs.twimg.com/profile_images/1346146310349488128/EHaNtlie.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1346146116614557697/1609931174/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "novel"}], "banned": false, "nc": 161}, {"id": 2888457, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "京子", "screen_name": "kyovi_pon", "avatar_url": "https://pbs.twimg.com/profile_images/1809836631249285120/Nh8DWCr8.jpg