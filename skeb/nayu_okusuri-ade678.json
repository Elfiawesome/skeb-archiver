rop=top&w=200&h=200&s=b079d3f12254ef693e54c1cd4d29e4f6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a26ad54/uploads/origins/68c1c7fd-6471-4a69-9d11-433ad99bd768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce37f3d00f1e445be9b7f56cbb1dc959", "srcset": "https://si.imgix.net/7a26ad54/uploads/origins/68c1c7fd-6471-4a69-9d11-433ad99bd768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce37f3d00f1e445be9b7f56cbb1dc959, https://si.imgix.net/7a26ad54/uploads/origins/68c1c7fd-6471-4a69-9d11-433ad99bd768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f27d64683c11b4b5aadce3c77f0601b2 2x, https://si.imgix.net/7a26ad54/uploads/origins/68c1c7fd-6471-4a69-9d11-433ad99bd768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a64df93c30f2052f1960542f5bf29d80 3x"}, "body": "薬屋なゆ様！はじめまして！\n\nこの度はアピールくださり本当にありがとうございます！\nとても嬉しい言葉をいただき光栄です、ありがとうございます🙏🏻💕\n\nぜひ薬屋なゆ様に描いていただきたいと思いご連絡致しました、 構図などはおまかせとさせて頂きたいです！\n\n資料の方をお手隙の際にご確認いただけますと幸いです、よろしくお願いいたします！\n\nhttps://www.dropbox.com/scl/fi/qfiky54kf3fcxeow0ie2g/2024-07-05-19-07-42.png?rlkey=u14g5nbsmk9ffdcmig0iasigv&dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nayu_okusuri/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3287466, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/17cfa68d/uploads/origins/d3c04eeb-659c-4927-bf03-fd5f246ecc62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a20d9da003496a09545123a6745fdb66", "srcset": "https://si.imgix.net/17cfa68d/uploads/origins/d3c04eeb-659c-4927-bf03-fd5f246ecc62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a20d9da003496a09545123a6745fdb66, https://si.imgix.net/17cfa68d/upload