せします\n\n【その他】\n夜鵟狂夜について\n・記憶喪失の教祖Vtuber\n・ゲーマー(ホラーゲーム・麻雀・APEXなどのFPSを主に配信)\n・ポンコツでよく騒ぐ\n・かっこつけ\n・好きな色は赤、黒、タコーズブルー\n\n【希望納品形式について】\n・PSD\n・背景、人物、サインのレイヤーを分けたもの\n\n説明不足の箇所もあるかと存じますが、ぜひご検討のほどよろしくお願いいたします\n\n夜鵟狂夜(@Yonosuri_Kyouya)", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 543807, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ななやことえ", "screen_name": "toe_nana", "avatar_url": "https://pbs.twimg.com/profile_images/712681891460034560/12zk_a65.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 934033, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "マコトウ", "screen_name": "mako_makotoo", "avatar_url": "https://pbs.twimg.com/profile_images/1704475610133958656/GZzgY-Yj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3263456155/1572620729/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 33}, {"id": 2641634, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "梦", "screen_name": "yumeyume222", "avatar_url": "https://pbs.twimg.com/profile_images/2016344045086556161/iJnwc9lY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1266963772742045696/1769568857/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 1, "complete_expiration_days