creator_acceptable_same_genre": false}, {"path": "/@sansanumino/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2798178, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/223a903d/uploads/origins/56c23e3a-a14d-4799-ace1-1eaa6dc90e82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca24b847bae857e67dc492cdabf34e97", "srcset": "https://si.imgix.net/223a903d/uploads/origins/56c23e3a-a14d-4799-ace1-1eaa6dc90e82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca24b847bae857e67dc492cdabf34e97, https://si.imgix.net/223a903d/uploads/origins/56c23e3a-a14d-4799-ace1-1eaa6dc90e82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=44786f2dd58b3aa624830efe2b767c79 2x, https://si.imgix.net/223a903d/uploads/origins/56c23e3a-a14d-4799-ace1-1eaa6dc90e82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=258278fe97bd3ef14dfc8dc96e6afbb2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/223a903d/uploads/origins/56c23e3a-a14d-4799-ace1-1eaa6dc90e82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26a3635365bd565b36ec8aeec9791437", "srcset": "https://si.imgix.net/223a903d/uploads/origins/56c23e3a-a14d-4799-ace1-1eaa6dc90e82?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26a3635365bd565b36ec8aeec9791437, https://si.imgix.net/223a903d/uploads/origins/56c23e3a-a14d-4799-ace1-1eaa6dc90e82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=855a55ea8e80aad186a3262f0e1d9c6e 2x, https://si.imgix.net/223a903d/uploads/origins/56c23e3a-a14d-4799-ace1-1eaa6dc90e82?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1a984752fc97a4d9b724a1e18e1356c1 3x"}, "body": "SSO先生、こんにちは！以前リクエストさせていただいた者です。ほんとうに素敵なイラストをありがとうございました。\nSSO先生の描かれる少女がほんとうに好きで、改めてお願いしたいキャラクターがおりまして依頼に参りました。\n今回は画像資料がないため、詳細なキャラクターデザインはおまかせする形になってしまいます。（とはいえ、凝ったものではなくて大丈夫です！）難しい場合はどうぞご遠慮なくお断りください。\n\n■外見\n・低身長の少女。\n・髪は長く、後ろでまとめていることもあるが無造作におろしていることもある。髪色は白。光の加減によって銀っぽかったり青みがかって見えたりもする。\n・瞳は琥珀色。夜は光って見えることもある。\n・服装は黒が基調の戦闘服など。動きやすさ、戦いやすさ重視。\n露出度は低めでお願いします。また、目のハイライトは無しが嬉しいです…！\n\n■ほか性格などの設定\n少女の姿をしていますが、異星の異種族なので豊富な人生経験を持っています。勝ち気で男勝りな性格をしており、一人称は「おれ」、二人称は「あんた」です。\n戦うことが得意で、平和に過ごしているよりも戦場で武器を振るっている方が落ち着きます。武器はなんでも使いますが二丁拳銃を得意としています。\n精神力が強く、あっけらかんと笑います。やんちゃすぎない大人っぽさがあり、少女の姿をしていますが兄や父を思わせる包容力があります。\n\nまた、SSO先生のお名前を明記した上で、いただいたキャラデザで三次創作（？）をさせていただきたいと思っています。\n上記がもしもよろしければ、是非お願いします……！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sansanumino/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4f61bc07/uploads/origins/6aa30590-7989-4b35-9e90-67c70f332bc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=267e28dc08cf9fc673fa56982d662f2a", "srcset": "https://si.imgix.net/4f61bc07/uploads/origins/6aa30590-7989-4b35-9e90-67c70f332bc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=267e28dc08cf9fc673fa56982d662f2a, https://si.imgix.net/4f61bc07/uploads/origins/6aa30590-7989-4b35-9e90-67c70f332bc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b23b08ec9dc41c9b8c150cf3b6952f97 2x, https://si.imgix.net/4f61bc07/uploads/origins/6aa30590-7989-4b35-9e90-67c70f332bc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2ea78c46930cb4e77b7b5126c617fb58 3x"}, "private": true,