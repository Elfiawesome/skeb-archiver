5/uploads/origins/d1b41edf-7315-4421-a892-6f54622f661c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=404777a6ff6c0929bfd3f7fc7990cc87, https://si.imgix.net/dda01305/uploads/origins/d1b41edf-7315-4421-a892-6f54622f661c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9766409de93cd698507c58283cffef4 2x, https://si.imgix.net/dda01305/uploads/origins/d1b41edf-7315-4421-a892-6f54622f661c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3397f7a8b55bb7a0fc856203a029022 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dda01305/uploads/origins/d1b41edf-7315-4421-a892-6f54622f661c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=423282aad74335fc52956c4efb1863ba", "srcset": "https://si.imgix.net/dda01305/uploads/origins/d1b41edf-7315-4421-a892-6f54622f661c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=423282aad74335fc52956c4efb1863ba, https://si.imgix.net/dda01305/uploads/origins/d1b41edf-7315-4421-a892-6f54622f661c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2417b80aa5486e6cd9f8cd38a9e8da0a 2x, https://si.imgix.net/dda01305/uploads/origins/d1b41edf-7315-4421-a892-6f54622f661c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8c86d323da7d8fb373413be3b4fa0144 3x"}, "body": "去年クラウン×シュヴァの依頼をさせて頂いた者です。\nその節はありがとうございました。頂いたときから今まで携帯のロック画面にさせて頂いています。\n依頼の直後にアプリ実装・アニメ3期もあり、クラウン×シュヴァルに陽が当たっていく\nジャストのタイミングで依頼できたことを嬉しく思ったのを覚えています。\n冬コミもこの画像と共に参戦し、新刊も購入させて頂きました。\n自分はファッションに疎く自分で買うことがなかったので、\nスニーカーの世界の広さとこだわりの深さにただ感心していました。\n\n今回のリクエストですが、ノースフライトがシンボリクリスエスを着飾って\n写真をたくさん撮っているシーンをお願いします。\n今回はsilenxeさんの描くクリスエスが見たいと思っているので、\nこの二人が親しげにしている以外は全てお任せします。\n\nこの二人はモデル馬が産駒を作った間柄であり、もっとアプリでも絡むと思っていたのですが\n参戦した距離の関係かあまり見ることが出来ませんでした。\n素材を輝かせることに情熱を燃やすノースフライトが、\nクリスエスほどのモデルを放っておかないだろうに…と惜しんでいるところです。\n\n現在私の中でクリスエス熱が高まり、クリスエスをテーマにした依頼をしているところなのですが\nクリスエスが着飾ったらどうなるだろう…？と考えた時、以前依頼した絵を思い出しました。\n一期一会が美しいと感じているので、なるべく同じ方への依頼はしないようにしているのですが\nファッションをテーマに頼むならどうしてもと思い今回依頼に至りました。\nぜひご承認のほどよろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_slx99/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1266703, "client_id": 3150091, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20dd9595/uploads/origins/5a1659a8-3466-492c-8ed0-684613bad20a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5ed4dbb54aba8706b08a74e0d65fbd1", "srcset": "https://si.imgix.net/20dd9595/uploads/origins/5a1659a8-3466-492c-8ed0-684613bad20a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d5ed4dbb54aba8706b08a74e0d65fbd1, https://si.imgix.net/20dd9595/uploads/origins/5a1659a8-3466-492c-8ed0-684613bad20a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32e8b76635a8cd674063e8c312e3d540 2x, https://si.imgix.net/20dd9595/uploads/origins/5a1659a8-3466-492c-8ed0-684613bad20a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3decb91c91ca9e0299ca5dc9eda874de 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20dd9595/uploads/origins/5a1659a8-3466-492c-8ed0-684613bad20a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bce737589c7355a02719d470a793686", "srcset": "https://si.imgix.net/20dd9595/uploads/origins/5a1659a8-3466-492c-8ed0-684613bad20a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bce737589c7355a02719d470a793686, https://si.imgix.net/20dd9595/uploads/origins/5a1659a8-3466-492c-8ed0-684613bad20a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e5b0ab361d470ab24529158e082fd80