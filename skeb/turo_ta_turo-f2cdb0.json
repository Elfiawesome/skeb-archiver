ab2/uploads/origins/94f4d609-65d5-40cc-85c3-ca1db058c31f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3012be53d8454a85878e72a3cf0ff45 2x, https://si.imgix.net/8f827ab2/uploads/origins/94f4d609-65d5-40cc-85c3-ca1db058c31f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=036bcda1398e9a7c92f7c6dd80ad90c6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f827ab2/uploads/origins/94f4d609-65d5-40cc-85c3-ca1db058c31f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=667ec91a33dce4afaa146429d3640884", "srcset": "https://si.imgix.net/8f827ab2/uploads/origins/94f4d609-65d5-40cc-85c3-ca1db058c31f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=667ec91a33dce4afaa146429d3640884, https://si.imgix.net/8f827ab2/uploads/origins/94f4d609-65d5-40cc-85c3-ca1db058c31f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6b822502badb05debbfbb7dba9408fa5 2x, https://si.imgix.net/8f827ab2/uploads/origins/94f4d609-65d5-40cc-85c3-ca1db058c31f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3f928a386a0a18e81a299f87aacf1e3a 3x"}, "body": "https://skeb.jp/@turo_ta_turo/works/9、とてもきれいですね！https://skeb.jp/@turo_ta_turo/works/2のカラーリングのディテールも。\n あなたのアートが大好きです。\n アートピースは1920x1080で、全身で、背景は（環境に似ていますが、多くのクローズアップで）水に向かってバルコニーの端に座っているかもしれません（あなたが望むなら、水位はもっと高くてもかまいません）？彼女は湯のみ茶碗でお茶を飲んでいるかもしれません。また、水辺のバルコニーに桜が咲いているような環境も参考にしているので、そのようなスタイルで背景を作ってもいいし、桜の木がなくても、桜の葉を上から落とすようにしてもいい。また、もし岩を追加するつもりなら、岩はあまり多くしないでください）また、床は参考資料と違って石ではなく木にしてほしい。パースは、リファレンスのパース・ファイルのように、彼女の体がメインなので大きく見えるように、もう少し近づけてほしい。彼女の表情と向いている方向はあなた次第。でも、彼女の両方がフレーム内に見えるようにしてください。私のOCは着物を着ていて、リファレンスにkimono_refという名前の髪を付けて欲しい。kimono_refには好きなかぶりものを選んでください。ネイルは好きな色にしてほしい。私のOCの現在の目の色を維持してください。\n  彼女は犯罪組織のボスですが、とてもエレガントでもあります！でもちょっと威圧的でもある。でも今回の依頼では、彼女のエレガンスと美しさを輝かせたい。また、彼女の体が大きく見えるようなアングルで、たぶん真ん中より少し下からのアングルだと、とてもかわいく見えると思う。\n \nあなたと一緒に仕事ができることにとても感謝します！本当にありがとうございました！\n \n\nストリーミングとsnsの目的（twitch、youtube、twitter）で使用したいです。\n\nhttps://drive.google.com/drive/folders/1NCvxwtOW_-qn2_AG4oW-lOga2JIeqElI?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@turo_ta_turo/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3127861, "client_id": 2545323, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f87b9c95/uploads/origins/a78a37ea-ad7e-4e55-9147-997f5fad5ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f6fbf2660bdd99045508088961bc5f0", "srcset": "https://si.imgix.net/f87b9c95/uploads/origins/a78a37ea-ad7e-4e55-9147-997f5fad5ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3f6fbf2660bdd99045508088961bc5f0, https://si.imgix.net/f87b9c95/uploads/origins/a78a37ea-ad7e-4e55-9147-997f5fad5ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e96bf31a419f4d8749873e48de9fcc12 2x, https://si.imgix.net/f87b9c95/uploads/origins/a78a37ea-ad7e-4e55-9147-997f5fad5ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=360efdae4e75d0c4e73c6bd93394ca7f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f87b9c95/uploads/origins/a78a37ea-ad7e-4e55-9147-997f5fad5ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35e57e408089d953be010415bbb76dfb", "srcset": "https://si.imgix.net/f87b9c95/uploads/origins/a78a37ea-ad7e-4e55-9147-997f5fad5ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35e57e408089d953be010415bbb76dfb, https://si.imgix.net/f87b9c95/uploads/origins/a78a37ea-ad7e-4e55-9147-997f5fad5ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&