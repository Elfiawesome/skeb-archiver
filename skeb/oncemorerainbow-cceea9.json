=200&s=c1bf99a176415735ce7acc6a28e181b5 2x, https://si.imgix.net/867c9b08/uploads/origins/f2e15bb2-e999-46c0-aebe-74076ed9e2cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b5a714f7f593008bb734a494da569eb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/867c9b08/uploads/origins/f2e15bb2-e999-46c0-aebe-74076ed9e2cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=486b93e983b51e17d47cf4d052f2d5ee", "srcset": "https://si.imgix.net/867c9b08/uploads/origins/f2e15bb2-e999-46c0-aebe-74076ed9e2cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=486b93e983b51e17d47cf4d052f2d5ee, https://si.imgix.net/867c9b08/uploads/origins/f2e15bb2-e999-46c0-aebe-74076ed9e2cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=876a5e8e886141ccd77a91225af5837a 2x, https://si.imgix.net/867c9b08/uploads/origins/f2e15bb2-e999-46c0-aebe-74076ed9e2cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=31b69136d46748137609e5cc1349c085 3x"}, "body": "貴方の迫力あるイラストが好きです。\nこの度はリクエストさせていいただきます。\n◼️キャラクター\n・アニメ『うまゆる』第10話「ウマ娘百物語」\nhttps://youtu.be/proK-e-v3Eg\nに登場した偽セイウンスカイ\n服装は勝負服で。\n特徴的な鋭い歯が見える感じでお願いいたします。\nまた、可能であれば白目の箇所を黒くしていただけると嬉しいです(気に入らなければこの箇所は無視していただいてもかまいません！)\n\n・アニメ『うまよん』第10話「ビビったら負け！肝試し対決！」\nhttps://teo.cocolog-nifty.com/photos/ref_2680_09/umayon0909c.jpg\nに登場した偽マチカネフクキタル\n服装は勝負服で。\n濁った瞳でお願いします\n\n◼️シチュエーション\nレースで全力でぶつかり合う二人をお願いいたします。何故レースをしているのか、どこでしているのかなどの背景はおまかせします。(描写しなくても問題ないです！)\nとにかく不気味な存在である彼女達がレースに全力で取り組みぶつかるワンシーンが見たいです！\n\n以上、ご検討をお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oncemorerainbow/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 265243, "client_id": 663495, "vtt_url": null, "thumbnail_image_urls": {"src