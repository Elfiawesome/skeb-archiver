op&crop=top&w=200&h=200&blur=200&s=51656a5652c545ab23572917834b7893, https://si.imgix.net/7cc74c4c/uploads/origins/20a81db8-e4a6-40c0-8137-b1225baa1ef6?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=be8a9de8abc58b060e1943c235426658 2x, https://si.imgix.net/7cc74c4c/uploads/origins/20a81db8-e4a6-40c0-8137-b1225baa1ef6?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2e2ea5b8f8dd659147c1a5963cf66df3 3x"}, "body": "津島さん、こんにちは！\n津島さんのイラストが大好きな者です。\n\nリクエストですが、頭身イラストで資料のキャラのゴスロリ姿をお願いしたいです。デザインは改変してもらって大丈夫です。\nポーズはお任せで、儚げ、ゴシック、宗教的な雰囲気で描いていただきたいです。\nモノクロイラストにしていただいても構いません。\n\n個人使用の範囲内での鑑賞、壁紙、トレカに使用させていただきたいと思っております。\n\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1z9zj5HA6dL8bardfcvAkKXrbOAF8O75c?usp=sharing", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsushimatoshima/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3338824, "client_id": 2406114, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/227af48b/uploads/origins/38c3ba36-37de-44ac-a929-d40fc0bcceab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06dc8177081c9d5448580f712cec7d2c", "srcset": "https://si.imgix.net/227af48b/uploads/origins/38c3ba36-37de-44ac-a929-d40fc0bcceab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=06dc8177081c9d5448580f712cec7d2c, https://si.imgix.net/227af48b/uploads/origins/38c3ba36-37de-44ac-a929-d40fc0bcceab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8d997062079994f4df54de293c94ef1 2x, https://si.imgix.net/227af48b/uploads/origins/38c3ba36-37de-44ac-a929-d40fc0bcceab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57ea512f3d4c4fc8c094086218288a43 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/227af48b/uploads/origins/38c3ba36-37de-44ac-a929-d40fc0bcceab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=099f9ce71a1933dfdd162806be3eb499", "srcset": "https://si.imgix.net/227af48b/uploads/origins/38c3ba36-37de-44ac-a929-d40fc0bcceab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=099f9ce71a1933dfdd162806be3eb499, https://si.imgix.net/227af48b/uploads/origins/38c3ba36-37de-44ac-a929-d40fc0bcceab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a07e5db71e7007a0c904d105ff1c2171 2x, https://si.imgix.net/227af48b/uploads/origins/38c3ba36-37de-44ac-a929-d40fc0bcceab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7ccc7b455865a17fc77afbb7284cd4fc 3x"}, "body": "津島さんこんにちは。いつもお世話になっております。\nミニキャラ本当にかわいくて大好きなので今回も依頼させて頂きました！\n\n----------------------\n◆リクエスト内容 \nクトゥルフ神話TRPG「東京ゴーストマティカ」というシナリオのOC4人のミニキャラをお願いしたく存じます。\n\n◆イラストの使用用途\nSNSへの掲載(アイコンやヘッダー等)\n非商用・個人観賞用のグッズ作成 (アクリルスタンドなどの作成)\nココフォリア内での駒としての使用。\n\n◆キャラクター詳細\nHO1 雷：男性。177cm。電撃を使える、優秀な人間。\n責任感が強く、仲間を守るために身体を張るタイプ。努力知らずの器用人間のため少々ノンデリ。騙されやすくて天然気味。\n\nHO2 狗：男性。176cm。俊敏で鼻が効く、肉弾戦が得意。\n内向的で人付き合いが苦手。心を開いた相手にはしっかりものを言う。第一印象とは違い、タフであり身体を動かすのは得意。\n\nHO3 鈴：男性。168cm。草花を咲かせたり枯らせたりできる。\n明るく人懐っこい。人に褒められるのが好き。賢く、専門的なことにも造詣が深いが世間知らずの面もある。\n\nHO4 灰：男性。187cm。影に身を潜められ、暗闇に引きずり込める。\nのらりくらりとしている。冗談が多く、嘘か本当か分からない適当な発言をよくする。傍観者寄りだが戦闘は好き。\n\n\nご参考になればと色々と記載しましたが難しいようでございましたら、描きやすい物で描いて頂いて大丈夫です。\n\n※身長は目安に記載したものなので正確に反映して頂かなくても問題ありません。\n容姿の詳細は下記URLよりご確認して頂ければと存じます。\nご検討のほどよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1aaQpvHbZHFNQLk-_oW7FVm4uwV91-l1H", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsushimatoshima/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3338824, "client_id": 1701139, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/