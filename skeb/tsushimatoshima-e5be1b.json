2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c613ac86ca86bb73c6716471450c8ce4 2x, https://si.imgix.net/3a6fa133/uploads/origins/4dd8d938-b143-4e92-8f50-e7acd3470bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=375e9a8ce0fbd5772db9da69f2eff0cc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3a6fa133/uploads/origins/4dd8d938-b143-4e92-8f50-e7acd3470bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c78ad87808e253e3eb5caa9cfeba1c6", "srcset": "https://si.imgix.net/3a6fa133/uploads/origins/4dd8d938-b143-4e92-8f50-e7acd3470bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c78ad87808e253e3eb5caa9cfeba1c6, https://si.imgix.net/3a6fa133/uploads/origins/4dd8d938-b143-4e92-8f50-e7acd3470bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6ffcb5ae2a22122923b130bcd6089777 2x, https://si.imgix.net/3a6fa133/uploads/origins/4dd8d938-b143-4e92-8f50-e7acd3470bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=591bfd1069f048a20f08dab9722102f6 3x"}, "body": "津島さんこんにちは！お世話になっております。\nいつも素敵なイラストや可愛いデフォルメキャラに惚れ惚れしております。\n今回は意を決してリクエストをお願いしに来ました！\n\n今回、CoCシナリオ「K県警K課」の自陣探索者たちをデフォルメキャラでお願いしたいです。\nシチュエーションなどはお任せいたします！\n\n\n▼簡易プロフィール(ネタバレなし)\n①法螺吹き\n喫煙者。都合が悪くなると煙に巻いてうやむやにする。\n自陣の中では割と落ち着いている。顔がいい。\n左手の小指に青い石のついた指輪をしている。\n\n②好色\n遊び人。本業は刑事だが兼業でホテル経営をしている。\n他同僚3人には本当にいろんな意味で懐いている。顔がいい。\nワインレッドのネクタイがトレードマーク。\n\n③守銭奴\n手癖が悪く、口が悪い。しかし顔はいい。\n金品が絡むと率先して動く。なんだかんだ面倒見がいい。\n左手にゴールドのゴツい腕時計をしている。\n\n④無能\n本当に何もできない。顔だけは本当にいい。(APP18)\n不器用で足も遅く、上履きで歩き回る男。精神が小学3年生で止まっている。\n首から緑色のストラップがついたネームカードを下げている。\n\nキャラクターの容姿は添付している資料をご覧いただけると幸いです！\n\n\n▼使用用途\n主に鑑賞、SNSのアイコンやヘッダーなどに使用、自陣に共有、\nまたココフォリアの部屋に置く…など個人の範囲で使用させていただく予定です。\n\n\n長くなってしまいましたが、ご検討いただけますと幸いです。何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1epMEca97zUi-ltEfdfXyNIFA-NJ_xJuv?usp=d