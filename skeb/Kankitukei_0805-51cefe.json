top&w=200&h=200&blur=200&s=b53d2807ef4c653befe3614deec80636, https://si.imgix.net/5aa27469/uploads/origins/aa001e8c-69bc-4af9-bcc7-eaf594ee2eaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=078835099f45d42361fe4021f696686b 2x, https://si.imgix.net/5aa27469/uploads/origins/aa001e8c-69bc-4af9-bcc7-eaf594ee2eaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6151bc334cfed4437d625bdbd141b138 3x"}, "body": "〜立ち絵依頼〜\n■髪\n・水色のメッシュが入った桃色の髪\n\n・右目にかかりそうでかからない前髪\n\n・髪の長さや髪型はお任せします。イケメン性を感じれると嬉しいです。\n\n■顔\n・顔がいい\n\n・イケメンな雰囲気の女\n\n・紫色の目\n\n・一目でナルシストだと分かるくらい自信ありげな表情\n\n■服\n・「あび」の制服にネクタイを着けてスーツ風に仕上げている。\n\n・「あび」制服例の左側のような色合いか、スーツっぽい色が好ましい。出来上がった雰囲気に合っててほしいので一任します。\n\n・落ち着いた色味のブーツを履いている。\n\n■武器\n・胡蝶蘭(白色)の花弁型の武器を両腕に、胡蝶蘭(白色)の萼片型の武器を背中と両脚に装着している。\nどちらも端が刃の斬撃武器となっている。\n※武器なし，両腕のみ，両腕と背中のみ，フル装備の差分が欲しいです。\n\n■予備情報\n・「あび」制服例の左の子の姉なので、血縁や春らしさを感じる色味と雰囲気にして欲しいです。\n\n■参考資料\nhttps://drive.google.com/drive/folders/1g9kzopRwGGgGLc1rgfQsG4GyW9D5KLY7", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kankitukei_0805/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "correction", "tipped": false, "creator_id": 3944413, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a3b68d24/uploads/origins/e3461dd9-b270-46c9-986d-ae073003250b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78e0e03060e121d9091dd1fd488f79c1", "srcset": "https://si.imgix.net/a3b68d24/uploads/origins/e3461dd9-b270-46c9-986d-ae073003250b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78e0e03060e121d9091dd1fd488f79c1, https://si.imgix.net/a3b68d24/uploads/origins/e3461dd9-b270-46c9-986d-ae073003250b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b759122380fd0915fe3c8f6973a9547 2x, https://si.imgix.net/a3b68d24/uploads/origins/e3461dd9-b270-46c9-986d-ae073003250b?bg=%23fff&au