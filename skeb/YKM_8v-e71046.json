r=2&fit=crop&crop=top&w=200&h=200&s=76bdff21b777dcd50dbf386d36136f97 2x, https://si.imgix.net/b9a53d82/uploads/origins/cd40d2f0-60fd-470c-8ecc-5be7b66d49ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0745b86bbd406830f361aeb40d2a944 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b9a53d82/uploads/origins/cd40d2f0-60fd-470c-8ecc-5be7b66d49ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d22f51a00c77b2e1a094fb45914a664", "srcset": "https://si.imgix.net/b9a53d82/uploads/origins/cd40d2f0-60fd-470c-8ecc-5be7b66d49ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d22f51a00c77b2e1a094fb45914a664, https://si.imgix.net/b9a53d82/uploads/origins/cd40d2f0-60fd-470c-8ecc-5be7b66d49ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d6cd618bd8875a4bacca84318ce1384a 2x, https://si.imgix.net/b9a53d82/uploads/origins/cd40d2f0-60fd-470c-8ecc-5be7b66d49ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fb931084590c2cfcd0e9143644f3cb58 3x"}, "body": "八雲へしを様\n初めまして、chronoと申します。\n\nTRPGセッション用のキャラクターの立ち絵を描いて頂きたいです。\nまた、身内限定の同人誌にも使用したいと考えております。\n\n〈依頼内容〉\n【キャライメージ】：175㎝、細みで\nキャラクター自体は市役所職員で、荒事担当で、戦闘をしております。\n飄々とした感じでつかみどころがない雰囲気。市役所職員なのでスーツですが、上半身はジャケットは着ておらずYシャツのみ第一ボタンは開けている状態です。ネクタイはしておりますが、緩めで無地系、色についてはお任せ致します。\nYシャツの左側は和柄が入っていますが、柄についてはお任せ致します。下半身は黒のパンツ、靴は革靴です。\n口に火のついていない煙草を咥えて仕事をしています。口元はニヒルな笑いを浮かべている感じです。\n（これはもし分かれば、という形なのですがイメージはFGOのヘクトールをイメージしています。言動や見た目はこのイメージをしています。）\n\n\n【入れてほしい要素】：黒寄りのグレーの髪（1:9で黒という感じです。）、髪は後ろで短く括っています。ひげは、顎全体と鼻の下に全体的にうっすらある形です。薄めの無精ひげといった風体です。耳にはピアス2種、耳たぶと耳の上の方にあります。煙草はマールボロソフトパックで、胸ポケットに入っています。クシャクシャで胸ポケットに入っています。\n\n\n\n【良ければ…】金額に見合えばの話ですが、差分を頂ければありがたいです。\n・煙草を咥えている、煙は出ていない。（こちらを基本として、最低限こちらが頂ければ問題ありません。）\n\n・煙草を手に持っている\n・煙草を咥えている、煙が出ている。（可能ならば足元に白いショットガンを抱えているとありがたいです。ここは無くても問題ありません）\n\n金額とうまくつりあえば差分についてもご検討頂けるとありがたいです。\n\n実際にTRPGのセッションで使用していた立ち絵、キャラクターシートに記載していた文章がありますので、参考にしていただければ幸いです。\n\nもし条件が見合いませんでしたらキャンセルでも構いません。どうぞよろしくお願いします。\n\nhttps://charaeno.com/6th/new", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YKM_8v/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 809533, "client_id": 802455, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/654baeee/uploads/origins/01c5574b-f4e7-4a9f-b477-cbef4f23a31e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ce4f38d87be3344134e27ca4ec2dbc4", "srcset": "https://si.imgix.net/654baeee/uploads/origins/01c5574b-f4e7-4a9f-b477-cbef4f23a31e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ce4f38d87be3344134e27ca4ec2dbc4, https://si.imgix.net/654baeee/uploads/origins/01c5574b-f4e7-4a9f-b477-cbef4f23a31e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8c3cd52c1069cc01dac09d8f1d005899 2x, https://si.imgix.net/654baeee/uploads/origins/01c5574b-f4e7-4a9f-b477-cbef4f23a31e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96a80ddff4e51b470b97b96cd70ede17 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/654baeee/uploads/origins/01c5574b-f4e7-4a9f-b477-cbef4f23a31e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=105dfa0272ea9244e977900ce2876a61", "srcset": "https://si.imgix.net/654baeee/uploads/origins/01c5574b-f4e7-4a9f-b477-cbef4f23a31e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=105dfa0272ea9244e977900ce2876a61, https://si.imgix.net/654baeee/uploads/origins/01c5574b-f4e7-4a9f-b477-cbef4f23a31e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b81390d441a4b89a173cc5f691e4cfbd 2x, https://si.imgix.net/654bae