家の美学を融合させたものにしたいです。彼女の呪術は記憶操作で、領域拡張の手印には赤色蒼穀印を使います。 主な武器はナイフです。\n\nもう一人は、ふわふわとした長い黒髪に赤い瞳の女の子です。遊び心があり、少しおっちょこちょいで楽天家なところがあります。とてもフレンドリーで元気いっぱいで、胸も豊満です。呪術は「ユニバーサルピロー」で、触れたものを何でも柔らかくする能力を持ち、領域拡張の手印は「カルナムドラ」を使います。主に拳や足を使って戦います。\n\n二人を並べて描いてほしい。緑のある日差しの明るい背景があると良いが、必須ではない。\n\nビジュアルのムードボードや参考画像：https://imgur.com/Qr6sEkK", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ka_kshi/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3556472, "client_id": 1878743, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fcc5faeb/uploads/origins/0154167b-c214-48d5-b8cc-7e8d780d2b97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=876fe0f4a7ab73efb598175a58607161", "srcset": "https://si.imgix.net/fcc5faeb/uploads/origins/0154167b-c214-48d5-b8cc-7e8d780d2b97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=876fe0f4a7ab73efb598175a58607161, https://si.imgix.net/fcc5faeb/uploads/origins/0154167b-c214-48d5-b8cc-7e8d780d2b97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fbae0c109875f69099e2bb270705fb68 2x, https://si.imgix.net/fcc5faeb/uploads/origins/0154167b-c214-48d5-b8cc-7e8d780d2b97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c15720624cfa2ab0d2e7d33d45c526a4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fcc5faeb/uploads/origins/0154167b-c214-48d5-b8cc-7e8d780d2b97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6056704d57b7dee2aad9d41a7cf2acbf", "srcset": "https://si.imgix.net/fcc5faeb/uploads/origins/0154167b-c214-48d5-b8cc-7e8d780d2b97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6056704d57b7dee2aad9d41a7cf2acbf, https://si.imgix.net/fcc5faeb/uploads/origins/0154167b-c214-48d5-b8cc-7e8d780d2b9