": 2647063, "nc": 48}], "sent_works": [{"path": "/@nm20000/works/41", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1327398, "client_id": 2647063, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef45f1e8/uploads/origins/46a0b949-e557-4168-bfc5-7a6238fb5c4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c6670c5c2cc29aee4e3a02c648db71f", "srcset": "https://si.imgix.net/ef45f1e8/uploads/origins/46a0b949-e557-4168-bfc5-7a6238fb5c4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c6670c5c2cc29aee4e3a02c648db71f, https://si.imgix.net/ef45f1e8/uploads/origins/46a0b949-e557-4168-bfc5-7a6238fb5c4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb69258e8d2ee9ca829141a3fad0e323 2x, https://si.imgix.net/ef45f1e8/uploads/origins/46a0b949-e557-4168-bfc5-7a6238fb5c4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9363599a3219fe9ca666499c6d8b7d59 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef45f1e8/uploads/origins/46a0b949-e557-4168-bfc5-7a6238fb5c4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74f74887f359849c2eb493938f0a356e", "srcset": "https://si.imgix.net/ef45f1e8/uploads/origins/46a0b949-e557-4168-bfc5-7a6238fb5c4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74f74887f359849c2eb493938f0a356e, https://si.imgix.net/ef45f1e8/uploads/origins/46a0b949-e557-4168-bfc5-7a6238fb5c4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a7da3bb42c3156fc7bfcde054d08ca14 2x, https://si.imgix.net/ef45f1e8/uploads/origins/46a0b949-e557-4168-bfc5-7a6238fb5c4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6c59a20fa4a7df31c27d429674803d90 3x"}, "body": "NEMO様\nこんにちは、頭と申します。\nいつもTwitterでかっこよくて素敵な作品を拝見させて頂いております。是非自分のTRPGのオリジナルキャラクターの二人組のイラストを描いて頂けないかと思い、リクエストを送らせて頂きます。\n\n■キャラクター\nアザミ(以下Aとします)\n30代・185㎝\n深紫色の毛量の多い髪・筋肉質で浅黒い肌・ゴーグルをつけている・顔や全身に傷や痣・鋭利な爪\n動物の毛皮を加工したものを肩にかけ、藍色の着物風のボロ布を羽織っている。\n他者に対して警戒心が強く懐疑的／野蛮で粗暴／時々油断する／傲慢であり強がりでもある\n\nクロホウシ(以下Bとします)\n23歳・148㎝(下駄無)/162cm(下駄有)・薬師\n白髪・長めで堅めの癖っ毛・太眉の三白眼・色白\n袈裟が擦り切れている僧侶の服に足袋、高下駄、包帯をつるしている赤い番傘がついた薬背負い箱\n土佐弁訛り／楽しいことが大好き／頑張り屋／困っている人を見捨てられず自己犠牲的／寂しがり／思うが儘に行動する\n\n\n■世界観・関係\n2人は『野狗子と薬師』というシナリオを遊ぶ為に作られたキャラクターです。\n抽象的なものですが、公式のトレーラーが以下となります。\nhttps://twitter.com/i/status/1433807409403740163\n2人は滅亡しかけている終末世界を旅する薬師Bと、それに宛がわれた”犬”Aという関係です。\n最初は互いに、Bは自分を殺しかねないAを恐れていたり、Aは能天気なBを毛嫌いしていましたが、旅を経ていく内に信頼関係が生まれ、AはBを守ろうとし、BはAと共に在ろうとする関係になりました。\nただ基本的には何にでも首をつっこむBがトラブルメーカーとなってハプニングが起き、Aがペースを乱されてキレ散らかしながらﾋｰﾋｰ頑張るのが日常です。そういった時にはAはBにげんこつ・首根っこを掴んで持ち上げる・デコピンをするなどして怒ります。\n\n\n■構図・要望\n神秘的な山の森の中にいる二人、という構図だと嬉しいです。\n逃げている、休んでいる、歩いているなど、ポーズや服装の簡略・独自の解釈・改変など自由にして頂いて構いません。\nNEMO様の絵柄であればどんな絵でも嬉しいのですが、\nhttps://twitter.com/nm20000/status/1638520277008281601\nこちらの様な重厚感のある絵柄は勿論のこと、\nhttps://twitter.com/nm20000/status/1636026589980033027/\nhttps://twitter.com/nm20000/status/1625755238178394114\nこちらの様に線が生きているような絵柄もどれも好きなので、表現の為であればカラーやモノクロなどは問いません。\n主線のある絵柄だと嬉しいのですが、描きやすいものでお任せ致します…！\n\n\n■イラスト用途\n観賞用として、そしてもし描いて頂けるのであれば、Tシャツあるいはトートなどのグッズを作りたいと思っております。どちらも私と友人の個人間で楽しむ目的のものです。\nそのため解像度が350dpi以上のもので頂けますと幸いです。\n\n独特の世界観で複雑かもしれませんが、NEMO様のエキゾチックさもある絵柄で是非うちの子達を見たい、あわよくばグッズも欲しい！と思っております。どうかご検討のほど、どうぞ宜しくお願いいたします…！\n外見資料および背景のイメージを添付させて頂きます。\n\nhttps://drive.google.com/drive/folders/17XBXJlL2BuSZpOAM2m2i1kJhHLaHR79P?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Bh1h1J/works/303", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1705449, "client_id": 2647063, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/67cf7665/uploads/origins/fd868fd4-4369-40e5-aec1-bfc60bb77b12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5db8460afd06acc4e2cccb6789df935e", "srcset": "https://si.imgix.net/67cf7665/uploads/origins/fd868fd4-4369-40e5-aec1-bfc60bb77b12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5db8460afd06acc4e2cccb6789df935e, https://si.imgix.net/67cf7665/uploads/origins/fd868fd4-4369-40e5-aec1-bfc60bb77b12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3b14cf39a9f973a03fcaeff52d9decd6 2x, https://si.imgix.net/67cf7665/uploads/origins/fd868fd4-4369-40e5-aec1-bfc60bb77b12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c9482828b233b170b8732e1ebb8cc65 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/67cf7665/uploads/origins/fd868fd4-4369-40e5-aec1-bfc60bb77b12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24c9b765411d9cf8b845decfa0da011f", "srcset": "https://si.imgix.net/67cf7665/uploads/origins/fd868fd4-4369-40e5-aec1-bfc60bb77b12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24c9b765411d9cf8b845decfa0da011f, https://si.imgix.net/67cf7665/uploads/origins/fd868fd4-4369-40e5-aec1-bfc60bb77b12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bbf1ce8cd80ee51ffbaf21d50c17a42e 2x, https://si.imgix.net/67cf7665/uploads/origins/fd868fd4-4369-40e5-aec1-bfc60bb77b12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=65a1ebb5c21816597705375a7ecb57fb 3x"}, "body": "横様\n\n初めまして、頭と申します。\nポップでおしゃれな絵柄にとても惹かれ、是非自分のTRPGのコンビを描いて頂きたいなと思い、リクエストを送らせて頂きます。\n\n■キャラクター\n漫才コンビ「地獄寺」\nツッコミの飛谷（以下A）とボケの久遠寺（以下B）による。典型的な喋り漫才型。\nAがつっこむ際に手ではなく足で蹴るスタイルであったり、\n服装は2人ともスーツだが、Bは虚無僧の天蓋を被り尺八を持った出で立ちなのが特徴。\n下積みを経てお笑い番組以外にも地上波バラエティやローカル番組の1コーナーなどにも出番が貰える程度の知名度。\n\nA\n22歳・155㎝・広島訛り・地獄担当\n黒髪の大半をグレーに脱色したアシメの髪型。\n目つきが悪くガラも悪い・やや猫背・喫煙者・神経質・頭が良い\nスーツは黒に赤シャツ、ネクタイも柄物など派手めなものを好む。左の側頭部に赤いピンで髪留めをしている。\nモチーフは紅葉、赤、小鬼\n\nB\n24歳・175㎝・大阪訛り・寺担当\n直毛気味な黒髪に太目の垂れ眉と垂れ目。\n全体的にお行儀が良い。元僧侶。おっとりした性格。料理が得意で甘い物が大好き。\nスーツは安物の濃いグレーに白シャツに、ネクタイは青。肩から緑色の輪袈裟をかけている。\nキャラ付けとして顔を天蓋で隠してネタを披露しており、素顔は一般非公開になっている。\nモチーフは桜、藍、極楽の蓮\n\nしっかりしているAと少々どんくさいBという真逆の二人ですが、お互いを信頼して支え合っておりとても仲良しです。\n\n詳しい外見は資料URLを参照ください。\n\n\n■要望・構図について\n「実在の漫才コンビの公式グッズ」の様なニュアンスで描いて頂けるととても嬉しいです。\nその際はイラストの中に「JIGOKUDE LIVE 2023」という文字を入れて下さい。\n構図や表情などは横様の解釈でお任せ致します。スーツの色味や服装についてもアレンジして頂いて構いません。\nそしてBは本来顔出しNGなのですが、顔出しVerもあると嬉しいです。\n\n■用途について\n鑑賞と、実際にアクリルスタンド等のグッズにしたいと考えています。こちらは自分と友人のみで楽しむ目的です。\nその為、350dpiで背景が透過されているデータも頂ければ幸いです。\n\n作品を拝見させて頂き、まさにこの絵柄、横様の絵柄で描かれた自キャラ達が見たい、グッズが欲しい…！と強く願っています。どうかご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Z3cKoH0g96VjHL2cavwNOU7nyuJgvezd?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@matte_TB/works/70", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1438301, "client_id": 2647063, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23ebffb9/uploads/origins/6db52d1c-8aca-4f70-8945-2a3928bc36e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b575e07ca43f03bcd1d664731d188e1", "srcset": "https://si.imgix.net/23ebffb9/uploads/origins/6db52d1c-8aca-4f70-8945-2a3928bc36e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b575e07ca43f03bcd1d664731d188e1, https://si.imgix.net/23ebffb9/uploads/origins/6db52d1c-8aca-4f70-8945-2a3928bc36e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3152284bdba4ad09d14e05d257cee2dc 2x, https://si.imgix.net/23ebffb9/uploads/origins/6db52d1c-8aca-4f70-8945-2a3928bc36e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=64e664a528b7282e831d5e81a958a14a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/23ebffb9/uploads/origins/6db52d1c-8aca-4f70-8945-2a3928bc36e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78343dbdea5f2cc758a18e9f3c3ad444", "srcset": "https://si.imgix.net/23ebffb9/uploads/origins/6db52d1c-8aca-4f70-8945-2a3928bc36e7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78343dbdea5f2cc758a18e9f3c3ad444, https://si.imgix.net/23ebffb9/uploads/origins/6db52d1c-8aca-4f70-8945-2a3928bc36e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b7c774f50637283a3e1b1596d3e3cd1d 2x, https://si.imgix.net/23ebffb9/uploads/origins/6db52d1c-8aca-4f70-8945-2a3928bc36e7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5996cdcfdbb5bbc80201f333a56c8ffd 3x"}, "body": "まち様\n初めまして、頭と申します。\n可愛らしく落ち着いたマットなデフォルメイラストに惹かれ、是非自分のTRPGのオリジナルキャラクターの二人組のイラストを描いて頂けないかと思い、リクエストを送らせて頂きます。\n\n■キャラクター\n北御門(攻・以下Aとします)\n38歳・176㎝・大学教授\n明るい茶色の髪・色白・光のないまっ黒の目、左に涙ぼくろ\n白いスーツに黒いシャツ、白黒斜めストライプのネクタイ\n落ち着いていて柔和／紳士的／博愛主義／先祖が蛇人間\n\n武霧(受・以下Bとします)\n41歳・179㎝・大学教授\n柔らかい焦げ茶のくせ毛・垂れ目・茶色い瞳、顎に少しの髭\nシャツにベスト、スラックス、薄紫のサングラス\n落ち着いているが無邪気で自由／甘い物好き／大胆な行動に出る／宝石に目が無い\n\n2人は双方ともに遅い春を迎え、穏やかに愛を育んでいる関係です。\nTRPGのキャラクターなので幾度か命の危機に晒されていますが、それらがきっかけで結ばれ、互いに寄り添いあっています。\n最初はBがAに初恋をする形でしたが、Aは幼少の頃に愛されず、また家族も早世した経験からか時折Bに甘えるような時があり、Bも浮足立ったような態度から次第にAを慈しむ様な関係にシフトしていきます。\n\n■構図・要望\nポーズや服装の簡略・改変など自由にして頂いて構いません。\n他の方へのイラストの様に背景に装飾品を添えて頂きたく、可能であれば白い花(菊など和風のもの)や宝石・鉱石などだと嬉しいです。あくまで要望ですので、もしモチーフとして納得がいかない場合は描きやすいように適宜変えて頂ければと思います。\n\n■イラスト用途\n観賞用として、そしてもし描いて頂けるのであれば、まち様の絵柄でアクリルスタンドなどのグッズを作りたいと思っております。こちらも個人で鑑賞する目的のものです。\nそのため解像度が350dpiの、背景が透過されたデータも頂けますと幸いです。\n\n再三になりますが、是非ともまち様の絵柄でうちの子が見たい…！と思っております。\nどうかご検討のほど、どうぞよろしくお願いいたします。\n外見資料を添付させて頂きます。\n\nhttps://drive.google.com/drive/folders/1RhvRotToB5gZ2u2LQswPXApkI3EH5T2x?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 92880, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "