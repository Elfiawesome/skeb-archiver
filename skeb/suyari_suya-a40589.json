のような建物がある場所ですから、栄えた都市と考えられます。\nメガネ男は、高いところに興奮して、子どものように笑うタイプです。青い髪の女性は落ち着いていて、どうしようもなく遊んでくれるタイプです。\n\nキャラクターを小さく描いても、裏に描いてもOK。衣装の簡略化はまったく問題ありません。\n構図は指定しません。なお、時間は昼、夕方、夜、どちらでも構いません。\nとにかく、先生の好きなように描いてください。✨\nご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1KXi-_33odlxFUKUXazIYl16CDv-l--Hf?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1384089, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "柴おかか", "screen_name": "g92ToB7c1NkBkxu", "avatar_url": "https://pbs.twimg.com/profile_images/1885684585511690240/4c8TdPp_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1289950671152640001/1648209201/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 0}, {"id": 1686210, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "yoni/よに", "screen_name": "yoni_bixid", "avatar_url": "https://cdn.bsky.app/img/avatar/plain/did:plc:dycivmpnup56b4wsosvkwqls/bafkreiasoj6jowwpjh2jqe7mo74zawgvipynapu2iamg4kljhjjkvf3u3u", "header_url": "https://cdn.bsky.app/img/banner/plain/did:plc:dycivmpnup56b4wsosvkwqls/bafkreicehj2ml4beo5xyiwtdiujwztw7kjimaqzb7g7rlwfpnu3xqwf3my", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 2171119, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🌴たし", "screen_name": "tashi5555", "avatar_url": "https://pbs.twimg.com/profile_images/1259171236392792067/68WcDlbi.jpg", "header_url": null, "