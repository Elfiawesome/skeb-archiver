4e-bda3-12c877a00ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=389412f252fcbca7cdd5456f8b3e1bcf, https://si.imgix.net/2c2bad5f/uploads/origins/e69c23eb-70ff-464e-bda3-12c877a00ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e4de79acc105754c72477869c65b6447 2x, https://si.imgix.net/2c2bad5f/uploads/origins/e69c23eb-70ff-464e-bda3-12c877a00ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=193bd2e168f7e8318912bda5923db221 3x"}, "body": "はじめましてmizuさん！モノクロコラージュのようなイラストが大好きです！\n\n私のと友達のOCのイラストをリクエストさせていただきたいです！二人ともは恋人です\n\n詳細：\n*アルド*\n60億+歳\n２４３ｃｍ\n星アルデバランは人間になった\nヒールを履いて足が特に長い（上半身の大きさは普通の人間と同じくらいです）\n陽気で外向的で注目を浴びることが好き\n人間の身体にまだ慣れてない\nマロリーが猫みたいだと思って抱きかかえることが好き\nマロリーにキュートアグレッションを感じる\n\n*マロリー*\n１８０ｃｍ\n４４歳\nただの地味な高校の教師\nやさしくて心配しやすいタイプで一見静かにそうすけどおしゃべりなおじさんです\nドジっ子\n見た目はアルドより年上\n好きなもの：アルコール、麻雀、ロマンス本を読むこと、料理\nこんなに美しくて優しい人は私のことが好きのが信じられない！をよく考える\n世界一のラッキー男だと思う\n\n身長差は非常に大きいからきちんと描くことは必要ないです！アルドはマロリーより背が高いさえすればOKです\n\nアルドの顔を描くためにリンクにある「アルド（人間姿）」フォルダーを使ってください\nアルドの服を描くために「アルド」というフォルダーの使うのが大丈夫ですけどオブジェクトヘッドの姿を描かないでください\n\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1hJ2Mmnx4pvAkha6CxJaX82q9QrZIPuDd?usp=drive_link", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@omzdkkn/works/16", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fcfa0ab1/uploads/origins/e070e430-cf25-48ab-bb21-92db26503f25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7bef6fec1170169bb544d7a010ad8c05", "srcset": "https://si.imgix.net/fcfa0ab1/uploads/origins/e070e430-cf25-48ab-bb21-92db26503f25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7bef6fec1170169bb544d7a010ad8c05, http