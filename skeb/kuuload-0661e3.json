rigins/8f0d0de6-839f-4931-8ea3-dca9eaa478c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be81d24f111d35297963540e1975f8de 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1b261eec/uploads/origins/8f0d0de6-839f-4931-8ea3-dca9eaa478c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6978fa69d76d53485dff2bc6c209f0c", "srcset": "https://si.imgix.net/1b261eec/uploads/origins/8f0d0de6-839f-4931-8ea3-dca9eaa478c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6978fa69d76d53485dff2bc6c209f0c, https://si.imgix.net/1b261eec/uploads/origins/8f0d0de6-839f-4931-8ea3-dca9eaa478c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2f4acf35c7b55ca61102209d93f1d902 2x, https://si.imgix.net/1b261eec/uploads/origins/8f0d0de6-839f-4931-8ea3-dca9eaa478c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=74efae98a6dd537d698f81736cf45a5b 3x"}, "body": "結城友奈は勇者であるシリーズの郡千景、鷲尾須美、乃木園子(小)、三ノ輪銀が\nアーケードゲーム「D&Dシャドーオーバーミスタラ」キャラのコスプレをした姿で\n大ゴマポーズとその後一幕をお願いしたく思います。\n\n[扮するキャラ]\n千景：マジックユーザー\n須美：クレリック\n園子：エルフ\n銀　：ドワーフ\n\n皆の衣装や手に持つ武器は、以下の画像を参考にして下さい。\nクレリックやドワーフは元ネタがごついオッサンで、鎧が妙に膨らんでいますが\nこれを彼女達の体型に合わせる等の調整はご自由にお願いします。\n\n[参考画像]\nhttps://drive.google.com/file/d/1JjyP6_Udc3snZ36pbBKW8PgZyKd-rYys/view\n\nその他、実際のゲーム動画はyoutubeやニコニコ動画に色々有りますのでご参考に。\n\n[シチュエーション]\n①大ゴマポーズ\n    船の甲板の様な場所(本当は飛空船の上なのですが)で\n　　4人各々自分の武器を上に掲げて勝利のポーズ。(実はエンディングの光景をイメージしてます。)\n　　銀、園子は満面の笑みで。　千景、須美は少々恥ずかしがりつつもやはり嬉しそうな表情で\n　　お願いします。　アングルは、おまかせします。　\n　\n②その後一幕\n　　ゆるちびキャラで須美がゲームの更に元ネタのTRPGルールブックの箱を抱えて、誇らしげに\n         するのを、他の3人が驚いたり慌て冷や汗出したりしている様子をお願いします。\n　　須美の抱える箱は赤、青、緑、黒の4色が重なり、\n         サイズは縦30cm×横25cm×高さ(4つ合計)12cm程度\n　　\n　　(セリフ例)\n　　　必ずしも以下通りでなくても良いですが、ご参考に。\n　　\n　　銀「しっかし、須美。これ元ネタは外国産なのに、よくやる事同意したよなー。」　　\n　　須美「まぁ今回はみんなに付き合うという事で。とにかくやると決めたからには\n                       準備に余念無しです！！(ふんす)」　\n　　園子「わっしーは入れ込むタイプだからねぇ、、、。」\n　　千景「4色全部、、一財産だわこれ、、、、鷲尾さん、、分かってはいたけど、\n                       やはりガチね。(ちょい汗)」\n\n以上です。　よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kuuload/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 89936, "client_id": 947665, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e57bbf67/uploads/origins/ccb494f2-c4a8-4d24-bea3-70df8f1a6bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6de8e1e01e74210d916244f804550fdd", "srcset": "https://si.imgix.net/e57bbf67/uploads/origins/ccb494f2-c4a8-4d24-bea3-70df8f1a6bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6de8e1e01e74210d916244f804550fdd, https://si.imgix.net/e57bbf67/uploads/origins/ccb494f2-c4a8-4d24-bea3-70df8f1a6bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c9724a8f802492cca9768571a171bc6 2x, https://si.imgix.net/e57bbf67/uploads/origins/ccb494f2-c4a8-4d24-bea3-70df8f1a6bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=516f0c9a16d48ab8b048353ee13ec329 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e57bbf67/uploads/origins/ccb494f2-c4a8-4d24-bea3-70df8f1a6bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d763ada756c81b35de7fe3cf3a78acb6", "srcset": "https://si.imgix.net/e57bbf67/uploads/origins/ccb494f2-c4a8-4d24-bea3-70df8f1a6bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d763ada756c81b35de7fe3cf3a78acb6, https://si.imgix.net/e57bbf67/uploads/origins/ccb494f2-c4a8-4d24-bea3-70df8f1a6bb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=50042afcb8e76fe0d73210eb40b11023 2x, https://si.imgix.net/e57bbf67/uploads/origins/ccb494f2-c4a8-4d