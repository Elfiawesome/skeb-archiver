\n個人鑑賞、SNS（アイコン・ヘッダー）での利用。\n\nご検討のほど、どうぞよろしくお願いいたします。\n\n【資料URL】\nhttps://drive.google.com/drive/folders/1J_7729M3Vbf8R3U2jt9rT-Jt8UK7Z_9T\n\nhttps://drive.google.com/drive/folders/1J_7729M3Vbf8R3U2jt9rT-Jt8UK7Z_9T", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yyy_fukuzawa/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3991899, "client_id": 3899023, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/da30b479/uploads/origins/846fb31a-5ef2-4ef5-bbdc-30de1973dc32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c365019dfcfdd0536ad2e67945d9c2b2", "srcset": "https://si.imgix.net/da30b479/uploads/origins/846fb31a-5ef2-4ef5-bbdc-30de1973dc32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c365019dfcfdd0536ad2e67945d9c2b2, https://si.imgix.net/da30b479/uploads/origins/846fb31a-5ef2-4ef5-bbdc-30de1973dc32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82746bf574b610f66a267e84bb24e1fa 2x, https://si.imgix.net/da30b479/uploads/origins/846fb31a-5ef2-4ef5-bbdc-30de1973dc32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=183ebf9a6f17c34aaad7aa1d0c8921e9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da30b479/uploads/origins/846fb31a-5ef2-4ef5-bbdc-30de1973dc32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d4e217b7e812405c763da343fa964ac", "srcset": "https://si.imgix.net/da30b479/uploads/origins/846fb31a-5ef2-4ef5-bbdc-30de1973dc32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d4e217b7e812405c763da343fa964ac, https://si.imgix.net/da30b479/uploads/origins/846fb31a-5ef2-4ef5-bbdc-30de1973dc32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8c597c