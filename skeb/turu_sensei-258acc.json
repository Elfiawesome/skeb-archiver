db7f89-363d-40a3-92a5-72c6b1c5a09f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66746e97870343f942f0608ee060708f", "srcset": "https://si.imgix.net/a1665a4b/uploads/origins/71db7f89-363d-40a3-92a5-72c6b1c5a09f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66746e97870343f942f0608ee060708f, https://si.imgix.net/a1665a4b/uploads/origins/71db7f89-363d-40a3-92a5-72c6b1c5a09f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=14d7a11e8eace4652f17d10058f418fa 2x, https://si.imgix.net/a1665a4b/uploads/origins/71db7f89-363d-40a3-92a5-72c6b1c5a09f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d113c17a52cbdd5e6b0baf5aa33306e3 3x"}, "body": "こんにちは！ファンです！！\nあーた更に絵が上手くなっちゃって！！すごい、もう理解も追いつかない🤷🏻‍♀️基礎ができすぎている、、とてもとても尊敬しています。\n手数料無料の波には乗れないけどまたまた立ち絵制作をお願いしにきました！ぴえの描く猟奇的な女を見せてください！\n\n内容：立ち絵(通常・戦闘)\n使用目的：TRPG(CoC)\n└卓報告を行う際投稿に載ります\n└『かいぶつたちとマホラカルト』というシナリオの『HO3 鬼』のPC立ち絵として使用します。\n※シナリオページは資料URLに添付\n\n名前：アスラ(女性)(20代前半に見える)\n性格(*)：『狂人』『ハツラツ』『扱いやすい、流されやすい』\n*立ち姿や、表情差分の参考程度に。本当に参考程度にです、前回みたいに山ほど描いてくへなくていいかはね、むりしないで😭\n身長：185cm　体型：健康的、胸はそこそこある、尻は大きめ\n\nデザイン　(APP：15)(SIZ：16)\n印象：幼い\n髪：赤色　ボッサボサのロングヘア(毛先がクルンとなっている。猫っ毛)\n目：赤色　大きめ(猟奇的)　まつ毛長め　下まつげあり　(つり目たれ目はお任せ)\n口：大きい　犬歯が目立つ(片側のみか両側かはバランスを見てお任せさせてください)\n服：スーツベースでお任せ。白、黒、赤基調を希望するものの、バランスを見てキモイなあと思ったら変えちゃってもらえると嬉しいです！\n\n【差分】\n通常：メガネあり、服ははだけさせない、髪の毛はしばっててもかわいいかも！お任せしたいです！\n→フリースクールの美術科職員をしています。立ち絵横に色彩鮮やかな絵画がおいてあったり描いてたりしたらうれしいな！\n→表情😆or😊\n\n戦闘：メガネなし、服ははだけててもいい、はだけててほしい\n→武器は金棒。でっかいと嬉しい！\n→備考：STRが高く、DEXが低いので力強い構図が似合う。かも。お任せします！\n→表情😆　+返り血差分もあったら！よろこびます！私が\n\n以上、よろしくお願いします！！\n\nhttps://booth.pm/ja/items/1715406", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Eruna_kp/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3487995, "client_id": 3902940, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/058333f0/uploads/origins/3f4c16c5-44e0-46a9-9473-9ceb96c26b64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8e94af58d9e3729b3e143b48ae9ad38", "srcset": "https://si.imgix.net/058333f0/uploads/origins/3f4c16c5-44e0-46a9-9473-9ceb96c26b64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8e94af58d9e3729b3e143b48ae9ad38, https://si.imgix.net/058333f0/uploads/origins/3f4c16c5-44e0-46a9-9473-9ceb96c26b64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ef88873fdc1f4383116ac299ec4c9899 2x, https://si.imgix.net/058333f0/uploads/origins/3f4c16c5-44e0-46a9-9473-9ceb96c26b64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=80dea5b2f395a011c0f46e6579d33ff4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/058333f0/uploads/origins/3f4c16c5-44e0-46a9-9473-9ceb96c26b64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4974c71aeb2f06947d2b438bd1e72c3", "srcset": "https://si.imgix.net/058333f0/uploads/origins/3f4c16c5-44e0-46a9-9473-9ceb96c26b64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4974c71aeb2f06947d2b438bd1e72c3, https://si.imgix.net/058333f0/uploads/origins/3f4c16c5-44e0-46a9-9473-9ceb96c26b64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=08618b3988d1528a5e9e6fe49f39f8dc 2x, https://si.imgix.net/058333f0/uploads/origins/3f4c16c5-44e0-46a9-9473-9ceb96c26b64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2cfe7a5cee9cf09cd102e596465ac709 3x"}, "body": "ファンです！！！！！！！！！！うちのペットの白のポメラニアンを描いてください！！\n「てぃあ」と申します！！お散歩が好きなのでお散歩してそうなイメージでお願いしたいです！！！！！！！！！！！！！！！！！！！！！！！！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pien_piccon/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3736914, "client_id": 3902940, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2ba585bf/uploads/origins/7d43c773-6eac-4261-b474-fd250bb09d43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cde63c4ac2de15322fae63b81b965f6b", "srcset": "https://si.imgix.net/2ba585bf/uploads/origins/7d43c773-6eac-4261-b474-fd250bb09d43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cde63c4ac2de15322fae63b81b965f6b, https://si.imgix.net/2ba585bf/uploads/origins/7d43c773-6eac-4261-b474-fd250bb09d43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d398ba53664c5181a2507f1aae8d0a1e 2x, https://si.imgix.net/2ba585bf/uploads/origins/7d43c773-6eac-4261-b474-fd250bb09d43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3cf87bf95164e72d2ef7653125744c61 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2ba585bf/uploads/origins/7d43c773-6eac-4261-b474-fd250bb09d43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bf876abc947aac3014f06fbb2060ef3", "srcset": "https://si.imgix.net/2ba585bf/uploads/origins/7d43c773-6eac-4261-b474-fd250bb09d43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bf876abc947aac3014f06fbb2060ef3, https://si.imgix.net/2ba585bf/uploads/origins/7d43c773-6eac-4261-b474-fd250bb09d43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c875f50a9784778fcfe8897b782dcbbe 2x, https://si.imgix.net/2ba585bf/uploads/origins/7d43c773-6eac-4261-b474-fd250bb09d43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=26d5950ce01784d39b589db784501b35 3x"}, "body": "こんにちは、ファンです。\n\nリクエスト内容は[TRPG(CoC)全身立ち絵]でございます。\n通常立ち絵と戦闘立ち絵を同じクリエイターに作成していただきたいと考えているため、2件をまとめて依頼させていただきます。\nまた、TRPG上での立ち絵として利用させていただきたく存じます。その際、卓報告時に再アップロードする可能性がございます。\n\n❏TRPG立ち絵(通常立ち絵)\n\n<キャラデザ>\n名前：コロール・ノア　年齢：25歳　職業：警察官\n身長：179cm　体重：75kg　瞳色：不定(虹色)(ツリ目だと嬉しい)　髪色：オレンジ(ツンツンしたイメージでおでこが見える髪形だとGood)　肌色：健康的\n参考ステータス：STR 16｜APP 15｜SIZ 14｜INT 8\n\n・表情差分、裁量でいくつか\n└通常は元気ハツラツ！な笑顔希望\n└なくてもよい\n・服装指定あり(詳細下記)\n・構図指定なし(静のイメージよりも動のイメージ)\n・秘匿HOに直接関係しないため開示しますが、セルフ秘匿で「交通事故から人物を庇って頭部損傷した過去」「それの影響で海馬に後遺症が残り、INT激減」という設定を持ちます。\n→→その上で……単純な「バカ」というよりも特殊な世界観を持つ「理解し難い人」というイメージのINT最低値人間です。常に人間の世界に溶け込むバケモノのような気分で、無意識のうちに周囲を警戒しながら生きています。表情差分の参考までに……\n\n<服装の指定>\nシナリオ、Liebbing概要にNPC立ち絵アリ。シナリオBOOTHリンク欄に添付\n\n備考：シナリオ指定制服にプラスして、彼(HO1)の対応NPC(スロウ)が身につけているマントを身につけていただきたく思います。マントをはためかせるイメージです。構図指定なし\n┈┈┈┈┈┈┈┈┈┈┈┈┈┈\n❏TRPG立ち絵(戦闘立ち絵)\n\nマントの有無はお任せします。\n武器は[二丁拳銃]です。構図指定なし\n\n備考：高DEXのため、身軽です\n┈┈┈┈┈┈┈┈┈┈┈┈┈┈\n<公開メモ>※参考程度に\n一人称：俺\n二人称：お前／(呼び捨て)\n\n好き　：人\n嫌い　：-\n\n\n「総員に告ぐ！作戦はこうだ！正面突破ｧ!!」\n\n\nリーダーらしからぬ低IQをもつ男。いっつもなんかズレてる気がする。\nただし人望と統率力は抜群で、いつの間にか周りに人が集まってくるようなタイプ。人の長所を見つけ引き出す能力に長けており、そういった意味では視野が広いと評価できる。老若男女問わず平等に接し、その明るさを人々に振りまいている様子が普段の生活からも見てとれるだろう。\nいついかなる時であろうと、ポジティブに変換するお花畑な頭はもはや天賦の才といえようか。\n\nまた、どんな状況であろうと戦場では必ず先頭に立ち、仲間を死なせるのは俺が死んでからだとでも言わんばかりに果敢に攻め込む癖がある。\nPLとしてはHPがそこまで高いわけではないのでぜひとも止めていただきたい所存。PCとしては俺ならぜってぇ耐えられるから黙って庇われてろ！と思っている。さぁてDEX最大値の男を止められるかなァ！！！コロールだけが死ぬ1ロスト3生還になれば本望です！！！\n\n最近の趣味は公園でドッジしてる子供たちに混ざること。パトロール中にも混ざってしまうので反省文を書かされた。\n\n手を叩いて笑う癖がある。上官相手にもコレなのでもう一回反省文を書かされた。\n\nmbtiはESFP-Tでした！\n\n\n「そーーいうのはスロウに聞けっての！」\n\n「いいかぁお前ら！俺についてこいよ！」\n\n「リーダー命令だ！死ぬな！」\n\n\nイメソン：魔法の本より／sui4160\n(裏イメソン：アンコールダンス／MIMI)※秘匿内容関係なし\n\n\n以上、よろしくお願いします。\n\nhttps://booth.pm/ja/items/3825032?srsltid=AfmBOooKz3gh2mzL3O8g9dWIM4Cu42hSK7JgIdCHRCJ5sC16RQ5hemwT", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 2419145, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "常磐田@skeb募集再開", "screen_name": "nu9leic_acid", "avatar_url": "https://pbs.twimg.com/profile_images/2056181006823202816/JQcRsuKP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/