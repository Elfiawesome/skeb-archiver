=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1efeb31f752618450135a4b38c534f43 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a83e1886/uploads/origins/0423dabf-696a-46ce-9eea-fa18f3f68cb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b317880c81f0bea88406918f5d973d74", "srcset": "https://si.imgix.net/a83e1886/uploads/origins/0423dabf-696a-46ce-9eea-fa18f3f68cb6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b317880c81f0bea88406918f5d973d74, https://si.imgix.net/a83e1886/uploads/origins/0423dabf-696a-46ce-9eea-fa18f3f68cb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=15aa674b2107e42027542ea36abbde42 2x, https://si.imgix.net/a83e1886/uploads/origins/0423dabf-696a-46ce-9eea-fa18f3f68cb6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f29283e3f2ffe9efa1615f75c7c492b0 3x"}, "body": "過去に描かれていた水着ルザミーネの絵が好みだったので、\nもし良ければ下記をお願いできないでしょうか。\n\n■キャラ\n前作と同様に主人公とルザミーネ\n※場面は通常の室内のイメージ。\n\n■内容\nhttps://x.com/terasumc/status/1080475822895489025\n上記のような優しいルザミーネと普通に接している中で、\n事故のような形でモブ男との不倫ハメ撮り画像を見てしまうとか、\nルザミーネが〇〇くんどうかしたの？と優しそうに微笑む中で、\n主人公がたまたま見つけたルザミーネ出演のエロDVDパケかスマホでエロ動画を突き付けて、\nこれってルザミーネさん・・？とモジモジしながら聞いてルザミーネは驚き焦りながらごまかすとか、\n清純で優しく美しいルザミーネ様の裏の顔が露わになる的な、明るめNTRをお願いしたいです。\n\nほかに良さげなシチュがあればそれでも全然OKで、\nいずれもエロシーンを拡大(あまり小さいと見えないので・・)したような描写はお願いします。\n\n以上、よろしくお願いいたします。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Yneet8282/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3727535, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/293ce684/uploads/origins/542be9cc-e487-4fcc-bf72-928dbb5fcecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=faf270b1ca34db0952ef4ed93791d32a", "srcset": "https://si.imgix.net/293ce684/uploads/origins/542be9cc-e487-4fcc-bf72-928dbb5fcecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=faf270b1ca34db0952ef4ed93791d32a, https://si.imgix.net/293ce684/uploads/origins/542be9cc-e487-4fcc-bf72-928dbb5fcecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed875e212a81f17bfbb8e389c94c998f 2x, https://si.imgix.net/293ce684/uploads/origins/542be9cc-e487-4fcc-bf72-928dbb5fcecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6e8f3d7179e07886a6b6b3bf7e2ebf50 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/293ce684/uploads/origins/542be9cc-e487-4fcc-bf72-928dbb5fcecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=622c4668618c5e058456fcef6d1377be", "srcset": "https://si.imgix.net/293ce684/uploads/origins/542be9cc-e487-4fcc-bf72-928dbb5fcecd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=622c4668618c5e058456fcef6d1377be, https://si.imgix.net/293ce684/uploads/origins/542be9cc-e487-4fcc-bf72-928dbb5fcecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ae5cbb12d08e5381ef782a37e8b6c1b6 2x, https://si.imgix.net/293ce684/uploads/origins/542be9cc-e487-4fcc-bf72-928dbb5fcecd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b0b3c2394bf84a06c59494671317f9eb 3x"}, "body": "お世話になっております。\nリクエストさせて頂きます。\n\n描いて頂きたい子\nhttps://x.com/yuino_kitasiro/status/1832718319608270887\nhttps://x.com/yuino_kitasiro/status/1843505520050872691\n神社の清楚な巫女さんです。\n\n構図、設定\n神社の信仰をあげるためにお参りに来てくれた子に御奉仕をするゆいのちゃん\nえっちなことの知識や興味はあるが処女という設定でお願いします。\n今回コミックでの依頼になるので複数回のプレイを想定しております。\n服装は全裸ニーソでお願いします。\n竿役は短小包茎の童貞少年でお願いします。\n(早漏だが何回もできるタイプの絶倫少年という設定)\n\n①まずは手コキで御奉仕をしてあげることに\n少年は早漏のため我慢できずすぐに射精\n\n②ゆいのちゃんは初めての精液の匂いに興奮し、まだ勃起しているおちんちんに次なる御奉仕としてパイズリをしてあげることに\nゆいのちゃんの爆乳に全部隠れてしまうおちんちん\n乳圧にやられてしまい今回もすぐに射精してしまう少年\n射精後はザーメンブリッジを描いて頂きたいです。\n\n③まだまだゆいのちゃんのご奉仕は続いて\n次はフェラをしてあげることに。\n少年の持続力は少し上がりなかなか射精をしなくなり、知識の中にある色んなテクでフェラをするゆいのちゃん\n徐々に気持ちよくなった少年は我慢できなくなり、ゆいのちゃんの頭を押さえつけイラマチオで喉奥に無理やり射精\nゆいのちゃんは苦しくなりながらも精液を飲んであげる。\n\n④色んなプレイをして自分も気持ちよくなりたくなったゆいのちゃんは最後に騎乗位で挿入。\n初の挿入で最初は少し戸惑いながらも自分の性欲が我慢できずに、凄く乱れながらおちんちんを犯してあげることに。\n激しく動き最後はおちんちんの中出し射精と共に絶頂、潮吹き\n\n⑤またえっちなことしようねと良いお掃除フェラをしながら終わり\n\nという流れでお願い致します。\n各シーンに対し、2〜3ページ書いていただければと思います。\nセリフはY人先生の言い回しが好きですのでお任せ致します。\n\n以上、ざっくりなご依頼にはなってしまいましたがご検討の程よろしくお願いいたします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Yneet8282/works/19", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2bd3ff28/uploads/origins/272551e3-acb5-4c6e-8b6d-8f460785ab7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bc961a4e4df0bf2d0861025f83b83c09", "srcset": "https://si.imgix.net/2bd3ff28/uploads/origins/272551e3-acb5-4c6e-8b6d-8f460785ab7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bc961a4e4df0bf2d0861025f83b83c09, https://si.imgix.net/2bd3ff28/uploads/origins/272551e3-acb5-4c6e-8b6d-8f460785ab7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=60492765c917a8bea01fbc6ac1791e5c 2x, https://si.imgix.net/2bd3ff28/uploads/origins/272551e3-acb5-4c6e-8b6d-8f460785ab7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eb64909b0527d00f749fd158d4be0462 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3727535, "client_id": 3385141, "nc": 177}, {"path": "/@Yneet8282/works/18"