e3b667c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=634af0ba3e5d74471bc0ded89ea87307 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f012de6/uploads/origins/9621769f-4b08-40e5-98f0-4397e3b667c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=208fe22ec0f88667fe3763edb685c2d7", "srcset": "https://si.imgix.net/9f012de6/uploads/origins/9621769f-4b08-40e5-98f0-4397e3b667c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=208fe22ec0f88667fe3763edb685c2d7, https://si.imgix.net/9f012de6/uploads/origins/9621769f-4b08-40e5-98f0-4397e3b667c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0c78f1ccb7090b6c2fe59cdec643218d 2x, https://si.imgix.net/9f012de6/uploads/origins/9621769f-4b08-40e5-98f0-4397e3b667c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a10e4417aaedfa8f6c761f90bc53c67e 3x"}, "body": "こんにちは！\n今回依頼をさせてもらいます！\n\n\n◆【キャラクター】\n　ファイアーエムブレム ヒーローズに登場するトール。\n　今回はこちらのバニー衣装バージョンで依頼をさせてもらいます。\n　https://drive.google.com/file/d/1RZ99wgA7bsEyvmNi9FH7Cm1GXVQ523Qs/view?usp=sharing\n\n◆【シチュエーション】\n　ウサギモチーフの衣装を着て春祭りに参加したトール。\n　衣装の影響か発情してエッチな気分になってしまい我慢できずにモブ男たちを誘惑して乱交する…というシチュでお願いします。\n\n◆【体位や構図】\n　体位や構図はおまかせします。\n　竿役の男たちの数は2～3人ぐらいでお願いします。\n　竿役の男たちの射精差分をお願いします。\n\n◆【表情】\n　衣装の影響からかすっかり発情しており気持ちよさそうに乱交しているという風にお願いします。\n　中出しされてイッてしまった表情差分をお願いします。\n\n◆【服装】\n　キャラ資料の衣装は着たままオッパイ部分は布を下に垂らしてオッパイが露出。\n　また股間部分はずらして挿入しているという風にお願いします。\n　タイツも太もも辺りが破けタイツになっているという風にお願いします。\n\n◆【台詞や擬音】\n　トールには心の声で\n　(何故だ…この衣装を着てから興奮が抑えられん…？)\n　(このような破廉恥な…駄目だもう我慢できん♡）\n　みたいな心の声を。\n　また乱交中はエッチな喘ぎ声をお願いします。\n　中出しでイッてしまった後に\n　「まだこの祭りは終わっていないのだろ…？もっと私を満足させろ♡」\n　みたいな台詞をお願いします。\n\n\n◆【NG要素】\n　個人的な好みで\n　・汚い竿役\n　・気持ち悪い竿役\n　・過度なアヘ顔\n　・口をすぼめたひょっとこフェラやバキュームフェラ 　\n　・スカ要素 　\n　・乳首やクリトリスへのピアス\n　・抜け陰毛\n　などはNGでお願いします。\n\n◆【その他】\n　竿役のモブ男たちは顔など写さずにこちらの3Dモデルぐらいの写り込みでお願いします。\n　https://x.com/0141robin/status/1873976226848940355\n\n\n長々となりましたがどうぞよろしくお願いいたします！\n\n↓公式キャラ紹介\n\nhttps://guide.fire-emblem-heroes.com/00004000901354-2/", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Yneet8282/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3727535, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57abb90d/uploads/origins/cc6a8f3e-06bc-4d8f-bafc-c0a4eebb81cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9f692491a3415c9a6f40563e77ace25", "srcset": "https://si.imgix.net/57abb90d/uploads/origins/cc6a8f3e-06bc-4d8f-bafc-c0a4eebb81cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9f692491a3415c9a6f40563e77ace25, https://si.imgix.net/57abb90d/uploads/origins/cc6a8f3e-06bc-4d8f-bafc-c0a4eebb81cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ada1bb97e12e1f40c2b80c7326ce51bc 2x, https://si.imgix.net/57abb90d/uploads/origins/cc6a8f3e-06bc-4d8f-bafc-c0a4eebb81cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e7df3a452933d7578db4d0b8f326e8d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57abb90d/uploads/origins/cc6a8f3e-06bc-4d8f-bafc-c0a4eebb81cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4298eaf1e58c8a0eb0db6c22b1daef0e", "srcset": "https://si.imgix.net/57abb90d/uploads/origins/cc6a8f3e-06bc-4d8f-bafc-c0a4eebb81cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4298eaf1e58c8a0eb0db6c22b1daef0e, https://si.imgix.net/57abb90d/uploads/origins/cc6a8f3e-06bc-4d8f-bafc-c0a4eebb81cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e953eaf57c053992a28185da3672beac 2x, https://si.imgix.net/57abb90d/uploads/origins/cc6a8f3e-06bc-4d8f-bafc-c0a4eebb81cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=308b57f23fc5e11a01914f1b38cdfa2e 3x"}, "body": "初めまして！人さんのポケモンおねショタイラストの作品が好みでして是非リクエストさせていただいてもよろしいでしょうか？\n\n「ポケモン」のモミさんをお願いします。\nHイラスト可となっていますので \n・ポケモンDP vsエッチなお姉さんトレーナー　\n　モミ編　のイラストをお願いします。\nシュチュエーションは\nハクタイの森の出口前で到着した後の主人公とモミのHなifストーリー\n\nハクタイの森を出る前 モミさんにスケベな誘惑をされ、そのまま森の洋館に連れて行かれる。\n\n洋館のベッドルームでおねショタH開始\n各Hの構図やキャラの体型雰囲気は資料を参考にお願いします！\n※フルバージョンでなくすみません🙇\n服装はお任せします。\n手コキ→パイズリ→騎乗位のルートで　\nよければ主人公側の攻めのパートも一つお願いします。\n（ベットの上で開脚させ手マンで潮吹き）\nここからよろしければルート分岐で敗北 勝利のルート別で描いていただけると嬉しいです。（難しければ勝利ルートのみで大丈夫です。）\n\n敗北ルート\n資料の一番下イラストの搾乳手コキで射精し敗北\nトレーナー引退　モミママの赤ちゃんend\n\n勝利ルート\n資料の下から五番目のイラストの逆転バック高速ピストン開始\n誘惑したお姉さんをお嫁さんママにしちゃう孕ませ確定中出し\n記念撮影（スマホロトム）で主人公の上でモミさんをM字開脚させて\nちんぽを抜いてマンコからたっぷり特濃精液が出ている所を撮影しハクタイの森であった虫取り少年たちのグループに送信し報告\n※受精描写有り　モミお姉さんに勝利&記念に孕ませちゃったend\n\n\n以上です。\nセリフや効果音などはお好みで描いてください！\n\n改めましてご検討よろしくお願いします！\n\nhttps://www.pixiv.net/artworks/142150413", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Yneet8282/works/27", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/58d69054/uploads/origins/685a506e-1ab0-4c62-9459-635795019fec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c94f46001cde01256a697fdf76ce35e", "srcset": "https://si.imgix.net/58d69054/uploads/origins/685a506e-1ab0-4c62-9459-635795019fec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8c94f46001cde01256a697fdf76ce35e, https://si.imgix.net/58d69054/uploads/origins/685a506e-1ab0-4c62-9459-635795019fec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=abba57ef781d787c4db1c459f793cca7 2x, 