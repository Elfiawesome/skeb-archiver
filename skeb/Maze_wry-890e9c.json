a6a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=972baeabc9ccb4ad485f5c5c9e798d5d, https://si.imgix.net/3b5472e5/uploads/origins/ccfd8a80-8d48-48e8-95c1-f769cc99a6a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c04a406017f9bf8bbebdc80702d75d88 2x, https://si.imgix.net/3b5472e5/uploads/origins/ccfd8a80-8d48-48e8-95c1-f769cc99a6a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e166ed1f4b8ed90481e0b3bfa07d3d0c 3x"}, "body": "納品ありがとうございました。ステラの可愛さもさることながらマゼさんの書くぴっちりスーツが最高だったので引き続きぴっちりスーツのイラストをリクエストさせていただきます\n\n原神の「刻晴」がステラと同じマゼさんの任務失敗シリーズのスーツを身に着けたイラストをお願いします\n刻晴参考資料：https://imgur.com/a/eqVjcL8\n\nお気に入りのスーツを着て満足気なドヤ顔の刻晴をお願いします\n構図は頭のてっぺんから太ももあたりまで画面に入るように、視点やポーズはお任せしますがマゼさんのスーツが映えるような視点・ポーズでお願いします\n\nまた可能であれば差分で任務失敗シリーズのようにベルトやファスナーが外れて乳首や秘所が丸見えになってしまい、恥ずかしそうにする刻晴のイラストもいただけたら幸いです。難しければなしで構いません\n\n以上になります。マゼさんのスーツが気に入っているのでマゼさん×原神のコラボが見られたらうれしいです。ご検討のほどよろしくお願いします", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Maze_wry/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1441860, "client_id": 698483, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac8036d0/uploads/origins/1a51a294-8942-45e6-8bcc-ffa0a1d879ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7d45f067955863530341769ad24070c", "srcset": "https://si.imgix.net/ac8036d0/uploads/origins/1a51a294-8942-45e6-8bcc-ffa0a1d879ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7d45f067955863530341769ad24070c, https://si.imgix.net/ac8036d0/uploads/origins/1a51a294-8942-45e6-8bcc-ffa0a1d879ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7d47e0666fc807c332c589244e32b783 2x, https://si.imgix.net/ac8036d0/uploads/origins/1a51a294-8942-45e6-8bcc-ffa0a1d879ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=710a02956b75bae0cad548d7eef186b7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac8036d0/uploads/origins/1a51a294-8942-45e6-8bcc-ffa0a1d879ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=957e6aa406d823cbbc9d0d7d45ecbc1b", "srcset": "https://si.imgix.net/ac8036d0/uploads/origins/1a51a294-8942-45e6-8bcc-ffa0a1d879ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=957e6aa406d823cbbc9d0d7d45ecbc1b, https://si.imgix.net/ac8036d0/uploads/origins/1a51a294-8942-45e6-8bcc-ffa0a1d879ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6fa8e5e37a10a8cd0162736d7371f338 2x, https://si.imgix.net/ac8036d0/uploads/origins/1a51a294-8942-45e6-8bcc-ffa0a1d879ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=72a927f877a580e29ba79b151f2d54e3 3x"}, "body": "こんにちは。\n私のOCが触手に犯されているところを描いていただけませんか？服は着たままで、乳房を露出させて触手に乳首を吸わせ、腕は背中に巻き、脚は触手が両方の穴を使えるように広げて口を使わせる。また、可能であれば子宮のタトゥーやマインドコントロールや堕落している様子も加えてください。\nありがとうございました。\n\nhttps://sta.sh/2182z2sgiadb", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Maze_wry/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1441860, "client_id": 104321, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a6e2f38/uploads/origins/8b3679d4-51ee-434f-9f45-ae1b9b9bd565?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e90b9dbe53cba4bdeb31c82f2062c400", "srcset": "https://si.imgix.net/1a6e2f38/uploads/origins/8b3679d4-51ee-434f-9f45-ae1b9b9bd565?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e90b9dbe53cba4bdeb31c82f2062c400, https://si.imgix.net/1a6e2f38/uploads/origins/8b3679d4-51ee-434f-9f45-ae1b9b9bd565?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb8b91bbc80337abac753baec497fd95 2x, https://si.imgix.net/1a6e2f38/uploads/origins/8b3679d4-51ee-434f-9f45-ae1b9b9bd565?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95ec2d8bc3454fd58aa82e12fe8ef9be 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a6e2f38/uploads/origins/8b3679d4-51ee-434f-9f45-ae1b9b9bd565?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd8665b701c01fa95572ff5d2b431888", "srcset": "https://si.imgix.net/1a6e2f38/uploads/origins/8b3679d4-51ee-434f-9f45-ae1b9b9bd565?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd8665b701c01fa95572ff5d2b431888, https://si.imgix.net/1a6e2f38/uploads/origins/8b3679d4-51ee-434f-9f45-ae1b9b9bd565?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=666a54e401a76ec87d1145853216f2ad 2x, https://si.imgix.net/1a6e2f38/uploads/origins/8b3679d4-51ee-434f-9f45-ae1b9b9bd565?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9d904c01950330ed78275114dbafaabf 3x"}, "body": "はじめまして。作品はよく拝見させていただいております。\n\nボーダーブレイクというゲームよりレジーナの陵辱イラストを依頼します。\n\n衣装は資料URL１枚目の普段着で袖を通しているジャケットは無し。上はそのままで下だけ脱がされている状態。\n\n過去作「ステラの専用牧場- チイ編」のような構図で後ろ手に拘束され、片足を膝辺りから釣り上げられている。\n\nシチュエーション\n\n①手マン・アソコへのディルド責め。既に何度か絶頂していて身体はできあがっているものの強気な態度で虚勢を張っているレジーナ\n②挿入。目を閉じてこらえる、歯を食いしばる等快楽に負けないよう抵抗\n③射精。レジーナも絶頂するが相手を喜ばせまいと声を押し殺してこらえる。\n④２ラウンド目。途中からアナルも責められ(指・道具責めどちらでも可)、ついに声を上げてしまう\n⑤もう一人が参加しレジーナに咥えさせる\n⑥竿役がそれぞれ腟内と口内に射精。レジーナも絶頂\n⑦まだ終わらない責めに心が折れそうになり弱気になるレジーナ\n⑧数時間後。全身精液まみれでアソコとアナルにディルド等を挿入されたまま放置されたレイプ目のレジーナ\n\n以上の流れを金額面と相談しできる限りでお願いします。\n\nご検討のほどよろしくお願いします。\n\nhttps://twitter.com/notogoro/status/1318140918554218496", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Maze_wry/works/9", "private_thumbnail_ima