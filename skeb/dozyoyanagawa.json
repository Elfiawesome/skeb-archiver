=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=adca6e09a2364ccc02de9bedd3e88497 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6f7f4851/uploads/origins/d7cdd5ed-326f-4aee-8aab-4c796169af55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=255259031cfdc036f15417089304ef81", "srcset": "https://si.imgix.net/6f7f4851/uploads/origins/d7cdd5ed-326f-4aee-8aab-4c796169af55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=255259031cfdc036f15417089304ef81, https://si.imgix.net/6f7f4851/uploads/origins/d7cdd5ed-326f-4aee-8aab-4c796169af55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b13517bab25910b69629bdf0074fc027 2x, https://si.imgix.net/6f7f4851/uploads/origins/d7cdd5ed-326f-4aee-8aab-4c796169af55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1ed48b26f9b4c8c158359e623f17ebd7 3x"}, "body": "Good morning~ It’s nice to meet you, Dojo-san.\nThank you for sending the appeal!\n\nSince the weather has been getting quite cold lately, I’d love to see Lexi in a cute winter outfit, as if she’s going on a date.\n\nIf possible, I’d also like a slightly naughty version in the same outfit, with a playful skirt-up pose that shows her panties.\n\n1920 x 1080 のイラストを描いていただけるとありがたいです。\n可愛い冬服を着て、デートに行くような雰囲気のLexiを描いていただきたいです。\n\nもし可能でしたら、同じ衣装で少しセクシーなバージョンとして、\nスカートアップ／スカートめくり（スカートを上げて下着が見える）ポーズもお願いしたいです。スカートアップの少しセクシーなバージョンは、可能でしたら別レイヤーでの差分を希望します。\n\n＊文字はなるべくレイヤー分けしていただけると助かります。\n※イラストはSNSやYouTube・Twitchのサムネイルで使う予定です。\n\nhttps://drive.google.com/drive/folders/1peOTMZ5WflhAER9XlFMFT1BRdoHVVlR8?usp=sharing", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@dozyoyanagawa/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3734803, "client_id": 3587182, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c9b11ae3/uploads/origins/3f7f6356-d834-4761-85cd-3c72ca597be1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9e6e4ac1fae9cdf04573f5b53b298f9", "srcset": "https://si.imgix.net/c9b11ae3/uploads/origins/3f7f6356-d834-4761-85cd-3c72ca597be1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9e6e4ac1fae9cdf04573f5b53b298f9, https://si.imgix.net/c9b11ae3/uploads/origins/3f7f6356-d834-4761-85cd-3c72ca597be1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66bb729f55c36456ec3c52e8617325cc 2x, https://si.imgix.net/c9b11ae3/uploads/origins/3f7f6356-d834-4761-85cd-3c72ca597be1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c5602cce4333257576aa093ebabb4fa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c9b11ae3/uploads/origins/3f7f6356-d834-4761-85cd-3c72ca597be1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=035cfda83e832b6cbd02b1bad55e7ae9", "srcset": "https://si.imgix.net/c9b11ae3/uploads/origins/3f7f6356-d834-4761-85cd-3c72ca597be1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=035cfda83e832b6cbd02b1bad55e7ae9, https://si.imgix.net/c9b11ae3/uploads/origins/3f7f6356-d834-4761-85cd-3c72ca597be1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=89ed716f2a514e08840fd533ff1626ab 2x, https://si.imgix.net/c9b11ae3/uploads/origins/3f7f6356-d834-4761-85cd-3c72ca597be1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1f3c28c4506cdc36d43e9f695747da1c 3x"}, "body": "初めまして、るおんと申します。 \nIRIAMという媒体で配信活動をしています。 \n柳川ドジョウ様の、厚塗り感のあるイラストがとても好みで、OCとして私を依頼させていただきました。\n 昔からファンタジーRPGなど好きで、柳川様の温かみのある雰囲気がとても好きです！\n\n  ▷希望 \n冬の待ち合わせをテーマに、好きに描いて欲しいです！\n ◎衣装はおまかせ\n正面や横顔背中、特にポーズにも拘りません。\n 髪型を変えてもらっても大丈夫です。\n好きに描いてほしいです！ \n\n▷私について\n左頬上あたりにホクロあり。\n雑談、麻雀参加型をメインに活動してます。\nよく笑い、元気！　社畜で疲れてもすぐ復活！ 毎日楽しく、趣味配信しています。 \n\n▷使用用途 ※可能性があるものを含む \nサムネイル、SNSでの宣伝、配信先での使用。 \nファン用　デジタル返礼品への使用。\n パネル開け企画、グッズ化する可能性があります。\n \n▷納品形態\n背景、キャラクターが分かれているPSDデータで、もしくはPDFで納品頂ければ助かります。  \n\n依頼が料金見合わなければ、遠慮なく差し戻しください 。\n承諾いただければ幸いです、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1MjfA7zFtsLtRc3dQ", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@dozyoyanagawa/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3734803, "client_id": 3112918, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d20f074a/uploads/origins/bb451e92-93dc-4ffa-be57-40abc20a079c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b59fbb9a2d45a4cb81e2e576a74b82a3", "srcset": "https://si.imgix.net/d20f074a/uploads/origins/bb451e92-93dc-4ffa-be57-40abc20a079c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b59fbb9a2d45a4cb81e2e576a74b82a3, https://si.imgix.net/d20f074a/uploads/origins/bb451e92-93dc-4ffa-be57-40abc20a079c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=339f8f9342934b678e161914db78fcd5 2x, https://si.imgix.net/d20f074a/uploads/origins/bb451e92-93dc-4ffa-be57-40abc20a079c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6fa729ecbccfb6a40a20f7bbc4e3d1e1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d20f074a/uploads/origins/bb451e92-93dc-4ffa-be57-40abc20a079c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8dbfaba6f9781186101d71b3e5df28c8", "srcset": "https://si.imgix.net/d20f074a/uploads/origins/bb451e92-93dc-4ffa-be57-40abc20a079c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8dbfaba6f9781186101d71b3e5df28c8, https://si.imgi