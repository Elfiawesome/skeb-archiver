ient_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@amesui_illust/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1817436, "client_id": 2581909, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/907fd802/uploads/origins/632d7aca-7192-40fc-b631-67daf8ec2c31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=302db3f998e45395f8dfb8094c4e25c7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/907fd802/uploads/origins/632d7aca-7192-40fc-b631-67daf8ec2c31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fe77b7731b852b0c09e744b719d76d97", "src_set": ""}, "body": "こんにちは！あなたのコラージュアートが大好きです！私は中世/ファンタジーの世界に住んでいるドラゴン泥棒Vtuberのモキザードです。私のVtuberがお宝を盗んだり、休憩したり、その他どんなポーズでも可愛いと思うコラージュを描いてくれたら嬉しいです。\n\n 彼女は牙があり、胸が平らな日焼けしたドラゴンの泥棒です。彼女は牙があり、胸はぺったんこです。  彼女の身長は157.48cmです。下ネタが好きで、ちょっとツンデレ。不器用で地図を読むのが苦手。日焼けしているので、肌の色がキャラクターシートと合っているか確認してください。\n\ntwitch/YouTube/その他のvtuberの活動であなたのアートワークを使用した場合、クレジットを記載します。背景ファイルとキャラクターを分けていただけると助かります。\n\nhttps://drive.google.com/drive/folders/1HKA_0gMxzz_GVL4WAkoBdyVW0m1fSOZ6?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amesui_illust/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1817436, "client_id": 777836, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/05189169/uploads/origins/04c05cf1-9089-4838-b67e-8b06cbf8fac0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22c451b4929a61e666a914707d462fe4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/05189169/uploads/origins/04c05cf1-9089-4838-b67e-8b06cbf8fac0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b1d0f53c69aafe9a6c6e94d5c84c71a2", "src_set": ""}, "body": "こんにちは！Sugiのためにあなたが描いたアートを見て、同じような作品をBG用に風景画でもらえないかと思ったんです！\n\n私のVtuberはゾンビの悪役令嬢で、アンデッドのまま水上から動けなくなり、人間として陸に上がることができます！彼女は不器用に冒険に出かけ、金を盗んだり、船を略奪しようとする。また、彼女は芸術品を盗むのが大好きです！彼女はペットの鳥を持っていて、イカと海の悪魔に親近感を持っています！\n\nできれば、海賊船で航海したり、宝物を見つけたり、望遠鏡や剣を落としたり、沈没した船で水中に潜ったりするような、ちょっとしたシーンが欲しいですね。詳細や具体的なことはあなたにお任せしますが、これらは単なるアイデアです！\n\nhttps://imgur.com/a/peLR5w0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amesui_illust/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1817436, "client_id": 683132, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5881da7f/uploads/origins/0ea7d396-2595-4f10-a10b-4e2669120556?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7fcd628a6d69450b8444a9d56a381f2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5881da7f/uploads/origins/0ea7d396-2595-4f10-a10b-4e2669120556?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f34ed436b06dd47e7ba3a042f5c94503", "src_set": ""}, "body": "こんにちは！私はあなたのアートワークが大好きです!\n私のキャラクターをどう描くか見てみたいわ！\nクリエイティブな自由を存分に発揮してください！\n\n── ⋅ ⋅ ── ⋅ ⋅ ── ✦ ── ⋅ ⋅ ── ⋅ ⋅ ──\n\n私のキャラクターは、独りよがりの悪魔の大将です！\n以下の私のホームページでいろいろと紹介しています！\nhttps://fream.gg/fream\n\n髪の色はブルー（長い方）、ピンク、ティール（短い方）。\n舌は青くて、トゲトゲしたサメの歯があるんだ！鼻には白い絆創膏を貼っています！\n私のチークは青です！\n\nあと、スパイクっていう超かわいいマスコットがいるの！\nもしよかったら、彼も入れてあげてね！片目だけ \"X \"がついています！\n\nhttps://fream.gg/fream", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amesui_illust/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1817436, "client_id": 1119561, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/569706be/uploa