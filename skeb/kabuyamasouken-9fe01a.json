r=3&fit=crop&crop=top&w=200&h=200&s=82a72e96fbe68e61e07273926ba56e77 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef064d8e/uploads/origins/becf95d3-19f2-40e1-8b35-261bfe41514c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6123979230961dad095ea6adc8ece93a", "srcset": "https://si.imgix.net/ef064d8e/uploads/origins/becf95d3-19f2-40e1-8b35-261bfe41514c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6123979230961dad095ea6adc8ece93a, https://si.imgix.net/ef064d8e/uploads/origins/becf95d3-19f2-40e1-8b35-261bfe41514c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5a410785f40de014146b8f1042d0677c 2x, https://si.imgix.net/ef064d8e/uploads/origins/becf95d3-19f2-40e1-8b35-261bfe41514c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1e29969a3c866faa72d24dab37172480 3x"}, "body": "はじめまして、Moouと申します。\n長年かぶ山総研様の作品を拝見しており、独特な世界観や表現がとても好きで、いつかお願いできたらと思っていました。今回こうしてリクエストできる機会があり、とても嬉しいです。\n\n今回お願いしたいのは、私がVRChatで使用しているLapwingというアバターです。\n私の改変したLapwingは葬儀服を着たバージョンで、今回のために専用の参考リンクを用意しました。\nまた、もし可能でしたら、参考リンク内にあるGondolaという小さなキャラクターもどこかに描いていただけると嬉しいです。\n\n構図や背景、全体の内容についてはすべてかぶ山総研様にお任せいたします。\n個人的には、少し冷たさや静けさを感じる雰囲気も素敵だなと思っていますが、ご自由な解釈で描いていただけたら幸いです。\n\nかぶ山総研様の表現でLapwingとGondolaを描いていただけたら、とても嬉しいです。\n\n参考リンク：\nhttps://drive.google.com/drive/folders/1ELzyXqfv_PddmbfHIHUV7C74uODnaRjB?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kabuyamasouken/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3860351, "client_id": 857449, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dcb7b62f/uploads/origins/72576de3-8bc1-4b58-8265-93691c7dec3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46c3f10ec3ab38034a5a