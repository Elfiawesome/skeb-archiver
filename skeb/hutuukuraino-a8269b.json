sored_thumbnail_image_urls": {"src": "https://si.imgix.net/86e332fa/uploads/origins/01c53af4-7081-4582-b2b9-a11f4f9d3a7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2b607a99cf655513d5e09b1e70674d7", "srcset": "https://si.imgix.net/86e332fa/uploads/origins/01c53af4-7081-4582-b2b9-a11f4f9d3a7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2b607a99cf655513d5e09b1e70674d7, https://si.imgix.net/86e332fa/uploads/origins/01c53af4-7081-4582-b2b9-a11f4f9d3a7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=08ebf682050841057cd447c80655ffc4 2x, https://si.imgix.net/86e332fa/uploads/origins/01c53af4-7081-4582-b2b9-a11f4f9d3a7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ea21427e80df19d09c1f9699d5703bec 3x"}, "body": "ゲーム実況者として活動をしております休涼ねこまと申します。\n\nフツウくらいの様のイラストをXにて拝見し絵柄、表情、使用されているペンやタッチなどすべてに一目惚れしぜひ描いていただきたいと思いリクエストを送らせていただきます\n自分も「無職転生」が大好きで同じ作品を愛する方のイラストにとても魅力を感じました\n\n【キャラクター】\nあの日の夏休み・風鈴・晩夏光　などがコンセプトのキャラクターです\n女性のモデルのみ受け付けていたらすみません…男性です。が男の娘イメージで構いません\n直前にポストされていらっしゃったロキシーにあったような何か憂いのある表情がとても好みです\nいつもマスコットと一緒にいて二人ともゲームをとにかく愛しています\n\n【用途】\n・収益化済みのTwitch・youtubeでの配信内使用やサムネイル\n・SNS活動\n・グッズ作成\n\n【依頼内容】\nサムネイルに使用する都合上できるだけ見切れのない構図だと助かります\n服装・構図などは特に指定なしです、オリジナルの衣装でも構いません。\nマスコットキャラのぬいぐるみも一緒だとすごく嬉しいです！(なくても構いません)\n\n普段はゲーム実況/雑談配信を主にしております\n\n背景透過したPNG or PDS等のデータで頂けると幸いです。\nあまりskebにてリクエストを送ったことがなく失礼がありましたら申し訳ございません。\nよろしくお願いいたします。\n\n資料データ\nhttps://drive.google.com/file/d/1VQKIs7obuyHOxS94OWQI2wtu3pgd-EEe/view?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hutuukuraino/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4035129, "client_id": 3067754, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/004b4162/uploads/origins/23eaa71d-88d0-4de1-b38f-738413b13e11?bg=%23fff