身長：約170cm\n体格：細身、胸は大きくも小さくもなし\n\nライトな剣と魔法のファンタジー世界のキャラ。\n聖職者を務める、所謂サキュバス。\n育った環境のためもあり、種族の印象に反し、極めて清純かつ礼儀正しく、穏やかな性格。\nちょっぴりお茶目で、恋話に対しては少女のように食いつく。(ただし色恋周りの情緒はほぼお子様レベル)\n種族としての外見特徴も特に隠していない上で、しっかり周囲に受け入れられている。\n歌うのが得意かつ大好きなものの、種族としての力で相手を魅了してしまう可能性を気にしているため、人前では聖歌以外は歌わない。\n\nhttps://drive.google.com/drive/folders/1ZjHOVcSoZjSy0OXLxPssAStbA4XsTC3V?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Happousai78/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2892386, "client_id": 2585969, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a897e6d1/uploads/origins/b40df77b-3431-4e6b-9797-4b49f43cc155?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f310208a8b1f0e8038519388aa6454fb", "srcset": "https://si.imgix.net/a897e6d1/uploads/origins/b40df77b-3431-4e6b-9797-4b49f43cc155?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f310208a8b1f0e8038519388aa6454fb, https://si.imgix.net/a897e6d1/uploads/origins/b40df77b-3431-4e6b-9797-4b49f43cc155?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3708ed1d76e03eb3ad42c13966a4990c 2x, https://si.imgix.net/a897e6d1/uploads/origins/b40df77b-3431-4e6b-9797-4b49f43cc155?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1fbf823c0a9022c833295d2ba3167d60 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a897e6d1/uploads/origins/b40df77b-3431-4e6b-9797-4b49f43cc155?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4a34576bf0511a780c2e806f4f57107", "srcset": "https://si.imgix.net/a897e6d1/uploads/origins/b40df77b-3431-4e6b-9797-4b49f43cc155?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4a34576bf0511a780c2e806f4f57107, https://si.imgix.net/a897e6d1/