%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83ff24b8f456639c8b36c7abebef0629 2x, https://si.imgix.net/7d3c099e/uploads/origins/1c2354ef-b670-45b7-9cc4-34632fbb3eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f0c1fa0a357190361088276404f1698 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7d3c099e/uploads/origins/1c2354ef-b670-45b7-9cc4-34632fbb3eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2e3cc3d36bdf10d16a8b6e576489f1c", "srcset": "https://si.imgix.net/7d3c099e/uploads/origins/1c2354ef-b670-45b7-9cc4-34632fbb3eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2e3cc3d36bdf10d16a8b6e576489f1c, https://si.imgix.net/7d3c099e/uploads/origins/1c2354ef-b670-45b7-9cc4-34632fbb3eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9903b2afc2c0688b58adf48633f388b6 2x, https://si.imgix.net/7d3c099e/uploads/origins/1c2354ef-b670-45b7-9cc4-34632fbb3eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5a02c76ae34a2e79a29352c8296d9d3f 3x"}, "body": "おの様\nリクエスト受付再開ありがとうございます！\n匿名で失礼しますが、作者様が過去描かれていた作品がとても素敵で自分も描いて頂きたくてリクエストしました！\n\nデパプリのエッチなコミックで、\n内容は本編終了後の設定で\n「今日は門平さんが帰ってくる」とルンルン気分で買出しから帰宅したあんさん、\nゆいが遊びに来ている様で、挨拶しようと拓海の部屋の扉を少し開けるとそこには、\n「ゆい！ゆい！」「あぁん！拓海ぃ！激しいよぉ！！」とゆいとエッチしている拓海の姿が…\n『あ…あの子たち付き合いだしたのは知ってたけどこんなに進んでたの！？』\nと驚きを隠せないあんさん\nあんさんが見ている事など知らず、「たく…みｯ拓海…ちゅう…チュウしょう？」とキスをせがむゆいにキスしながらピストンが激しくなる拓海\nそんな2人の見て\n『だ、ダメよ！あん！息子の恋愛事情？を盗み見るなんてっ！でも…』\nと目が離せないあんさん\n『いつも元気いっぱいで可愛いゆいちゃんがあんなにえっちな表情する様になって…』\n『拓海のあの切なげな表情…門平さんにそっくり…やっぱり親子ねぇ…』\nなどと変な感慨に陥っていると、2人のフィニッシュが近いのか\n「拓海！アタシもうっ」「ゆいっ！オレもっ」「うん！拓海っそのまま…そのまま来てぇ！！」と中出しを受け入れるゆい、そのまま中出しとともに絶頂し、少しの余韻の後、力が抜けた様にベッドに倒れ込む2人、「ゆい…好きだ…」「私も…拓海、大好き♡」といちゃいちゃしだす2人、その声を後に何かを決意した様にその場を去るあんさん。\n〜数時間後〜\n「ただいま、拓海」\n「あ、父さんお帰…り！？」\nと帰宅した門平の姿を見て驚く拓海、そこには、げっそりとした門平と何故かツヤツヤとして満足そうに微笑むあんさんの姿があったとさ…\nという流れのコミック作品をお願い致します！\nよろしければ承認のご検討よろしくお願い致します！！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wimawi838/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3053283, "client_id": 2653663, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51eea89f/uploads/origins/f35b3cd9-e093-49c8-acfe-d7ec78c1ad11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f0868933bdcc72cb6ec06ecaa15078a", "srcset": "https://si.imgix.net/51eea89f/uploads/origins/f35b3cd9-e093-49c8-acfe-d7ec78c1ad11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f0868933bdcc72cb6ec06ecaa15078a, https://si.imgix.net/51eea89f/uploads/origins/f35b3cd9-e093-49c8-acfe-d7ec78c1ad11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b039a22851852ba51955a88c3901de69 2x, https://si.imgix.net/51eea89f/uploads/origins/f35b3cd9-e093-49c8-acfe-d7ec78c1ad11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f0fc771cfae809d28447af8dde9b43a6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51eea89f/uploads/origins/f35b3cd9-e093-49c8-acfe-d7ec78c1ad11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a2adc3f01715663e4aef71a19d8cd1c", "srcset": "https://si.imgix.net/51eea89f/uploads/origins/f35b3cd9-e093-49c8-acfe-d7ec78c1ad11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a2adc3f01715663e4aef71a19d8cd1c, https://si.imgix.net/51eea89f/uploads/origins/f35b3cd9-e093-49c8-acfe-d7ec78c1ad11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e5fd4d4ddca37556cb73e812ba1a01de 2x, https://si.imgix.net/51eea89f/uploads/origins/f35b3cd9-e093-49c8-acfe-d7ec78c1ad11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5da0297f13c599a505dd7d9abbc525e9 3x"}, "body": "お久しぶりです、作家さん。 今回は、あまねちゃんのミッドフォームバージョンが見たくてリクエストさせていただきました。 どうぞよろしくお願いします。\n\n依頼内容はデリシャスパーティ♡プリキュアの菓彩あまねちゃんがキュアフィナーレの衣装で顔だけ変身解除している状態(pixivタグでいうミッドフォーム)\n\n表情は適当に恥ずかしがって、ほとんど泣きそうな表情で口を閉じてください。\n\nポーズはこの下のリンクをご参考ください。\nhttps://img.atwiki.jp/aniwotawiki/attach/51599/13437/%E3%82%AD%E3%83%A5%E3%82%A2%E3%83%95%E3%82%A3%E3%83%8A%E3%83%BC%E3%83%AC.jpg\n\nそして全体を描いてほしいです。\n\n正確にこういうスタイルで描いてください。 ありがとうございます。\nhttps://i.pinimg.com/564x/33/ff/3d/33ff3dbad46b8e59f89f7a25811f80d2.jpg", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wimawi838/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f4f1064f/uploads/origins/dd2a61f2-2a2d-42ba-a119-78d41b16d4e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3227fc6e40b5c7cdbeb722908862693f", "srcset": "https://si.imgix.net/f4f1064f/uploads/origins/dd2a61f2-2a2d-42ba-a119-78d41b16d4e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3227fc6e40b5c7cdbeb722908862693f, https://si.imgix.net/f4f1064f/uploads/origins/dd2a61f2-2a2d-42ba-a119-78d41b16d4e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a7cc37d344fe97f2161894ffe73d88a5 2x, https://si.imgix.net/f4f1064f/uploads/origins/dd2a61f2-2a2d-42ba-a119-78d41b16d4e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=481793cf46a03b242c3c7cdf7dbd2f89 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3053283, "client_id": 1942488, "nc": 160}, {"p