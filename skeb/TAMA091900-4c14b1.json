op=top&w=200&h=200&blur=200&s=9bcb3c7442970b570516790611c354df 3x"}, "body": "初めまして！Vtuberの歌織（うたおり）たわしです。\n\nたまねこ様のイラストで拝見し、とても可愛らしいイラストに一目ぼれしました！！\n是非歌織を描いてほしいと思い今回リクエストさせていただきました！！\n\n♦構図、表情\nたまねこ様にお任せしたいと思いますが、サムネイル等で使用したいので、横や上や切れないような構図でお願いします！！\n\n♦使用用途\nアイコンや配信サムネイルでの使用\n可能であれば人物透過ファイルをPNGで頂けると嬉しいです！\n\nお忙しいとは思いますが、どうぞよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1irGIqr7HBYXdIYRZw6dF2PdWQZugQylz?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@TAMA091900/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3321179, "client_id": 3054261, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c56fee6f/uploads/origins/cf7bc088-c59d-409b-b105-4395226a77ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad35fc3776a4908431148c14aab19e52", "srcset": "https://si.imgix.net/c56fee6f/uploads/origins/cf7bc088-c59d-409b-b105-4395226a77ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad35fc3776a4908431148c14aab19e52, https://si.imgix.net/c56fee6f/uploads/origins/cf7bc088-c59d-409b-b105-4395226a77ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6b0da6af166e5e0fe16f37a0e0518019 2x, https://si.imgix.net/c56fee6f/uploads/origins/cf7bc088-c59d-409b-b105-4395226a77ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=47bb20c8336dbcf94fbdb3e6ae648901 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c56fee6f/uploads/origins/cf7bc088-c59d-409b-b105-4395226a77ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5d02f435cc352e2328aed5002944060", "srcset": "https://si.imgix.net/c56fee6f/uploads/origins/cf7bc088-c59d-409b-b105-4395226a77ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=20