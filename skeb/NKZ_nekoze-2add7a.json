\n体術(柔道)と心理戦が得意。\n言動や行動からチャラく思われがちだけど誰に対しても誠実。\n\nセリフサンプル\n「オッケー、任せて👌」「えー司馬ちゃんひどくない！？」「俺はこんなにも司馬ちゃんのこと好きなのにさ」\n\n\nお互いを信頼し合う刑事バディです。\nシチュエーションとしては戦闘中で、少し負傷しながら背中合わせで戦っているような雰囲気だと嬉しいです！\n是非よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/14iT496flwg7sa0qyN-hg-xR81NDKScZy", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NKZ_nekoze/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1269754, "client_id": 2628477, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/41794cd2/uploads/origins/007c3570-59b4-49d5-a763-5f97031008a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6d07c1f8699a3cb4c6f03a9a2ddd495", "srcset": "https://si.imgix.net/41794cd2/uploads/origins/007c3570-59b4-49d5-a763-5f97031008a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6d07c1f8699a3cb4c6f03a9a2ddd495, https://si.imgix.net/41794cd2/uploads/origins/007c3570-59b4-49d5-a763-5f97031008a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85076f46e02a1ad5ca0f826712b2ccf6 2x, https://si.imgix.net/41794cd2/uploads/origins/007c3570-59b4-49d5-a763-5f97031008a1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=748eff326c41d98dc30d377a77b13166 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/41794cd2/uploads/origins/007c3570-59b4-49d5-a763-5f97031008a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c07a371d0a025b7149364d143d25d1ef", "srcset": "https://si.imgix.net/41794cd2/uploads/origins/007c3570-59b4-49d5-a763-5f97031008a1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c07a371d0a025b7149364d143d25d1ef, https://si.imgix.net/41794cd2/uploads/origins/007c3570-59b4-49d5-a763-5f97031008a1?bg=%23fff&auto=format%2Ccompress&fm