55f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b7b0a60814dbd87847e4fe34a332d9b", "srcset": "https://si.imgix.net/683771f4/uploads/origins/1325ce0a-eac5-4f19-ac08-9d9c3499355f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b7b0a60814dbd87847e4fe34a332d9b, https://si.imgix.net/683771f4/uploads/origins/1325ce0a-eac5-4f19-ac08-9d9c3499355f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c85db9ab7d9c7397aac6073fbc2489d0 2x, https://si.imgix.net/683771f4/uploads/origins/1325ce0a-eac5-4f19-ac08-9d9c3499355f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=284b3618c768c111bacf1c81d03b5b71 3x"}, "body": "先日は素敵なイラストを描いて頂きありがとうございます、\nまたイラストを描いて頂きたくリクエストをさせて頂きます。\n\nブラウザゲーム「天穹ノ彼方の錬星郷（そらノかなたのディストピア）」略称「ソラカナ」\n\nクリスマスイベント「聖夜を招ずる聖人の名」にて登場した\n「【輝ける祝福】穢戸鳴 辰祁」（えとな　たつき）をお願いします。\n\n描いて頂きたいのは星3武装時の姿となります\n\n描いて頂きたい資料URL\nhttps://sd.swiki.jp/index.php?plugin=attach&refer=%E3%80%90%E8%BC%9D%E3%81%91%E3%82%8B%E7%A5%9D%E7%A6%8F%E3%80%91%E7%A9%A2%E6%88%B8%E9%B3%B4%20%E8%BE%B0%E7%A5%81&openfile=800203-a.png\n\nイラストの構図や背景の有無についてはお任せします、よろしくお願いいたします。\n\n大まかなキャラ概要\n元老院直属の戦闘部隊「四瑞（しずい）」の「筆頭代理」で「応竜」の号をもつ\n都市規模の反乱を個人で対応したりする\n博愛、年齢不詳、個人的最推し\n\n参考用通常時\nhttps://sd.swiki.jp/index.php?%E3%80%90%E8%BC%9D%E3%81%91%E3%82%8B%E7%A5%9D%E7%A6%8F%E3%80%91%E7%A9%A2%E6%88%B8%E9%B3%B4%20%E8%BE%B0%E7%A5%81\n\n世界観説明資料\nhttps://dic.pixiv.net/a/%E5%A4%A9%E7%A9%B9%E3%83%8E%E5%BD%BC%E6%96%B9%E3%81%AE%E9%8C%AC%E6%98%9F%E9%83%B7", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HinomotoEP/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 463965, "client_id": 1467, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d36fd49c/uploads/origins/68531020-46ce-44af-8925-fef1a38fa2c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b797113c01d914de5bf92661970f17e", "srcset": "https://si.imgix.net/d36fd49c/uploads/origins/68531020-46ce-44af-8925-fef1a38fa2c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b797113c01d914de5bf92661970f17e, https://si.imgix.net/d36fd49c/uploads/origins/68531020-46ce-44af-8925-fef1a38fa2c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0154b11024e73e0eee028a77668ae7bd 2x, https://si.imgix.net/d36fd49c/uploads/origins/68531020-46ce-44af-8925-fef1a38fa2c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9b2a48d77a4d4f48fd7ab0feaffd8a14 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d36fd49c/uploads/origins/68531020-46ce-44af-8925-fef1a38fa2c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36460120778dc5ade9f8cd99e7277a7c", "srcset": "https://si.imgix.net/d36fd49c/uploads/origins/68531020-46ce-44af-8925-fef1a38fa2c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36460120778dc5ade9f8cd99e7277a7c, https://si.imgix.net/d36fd49c/uploads/origins/68531020-46ce-44af-8925-fef1a38fa2c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ec82ac22448b8efceeb407706f3bacf6 2x, https://si.imgix.net/d36fd49c/uploads/origins/68531020-46ce-44af-8925-fef1a38fa2c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9d7283fa2a82a1560d949f66b9701753 3x"}, "body": "いつもお世話になっております、月影楼です。\n\nうちの子狐のお姉さん「翠燐」をリク致します。\nキャラデザインは参考資料の通りで、\n資料で不明な点、分かりづらい点は描きやすいように描いていただいて大丈夫です\n\nシチュは飛行機撮影にきた翠燐さんで、衣装は普段着+カメラ、\n普段着は資料にある感じ（アレンジ可）\nカメラは私の使っているS◯NY　RX10IV風でお願いします。\n\n背景に飛行機（可能であれば翠燐さんカラーなANAの787グリーンジェット塗装）を描いていただけると嬉しいです\n（※地上・空中やリアル・SDなどは全てどちらでもOK）\n\n宛名につきましてはPSDレイヤーでon/off出来ると嬉しいです。\nよろしくご検討お願い致します。\n\n\nキャラクター資料（立ち絵・３面図・注意事項含む\nURL：https://twitter.com/Tukikagerou/status/1586588803682119680?s=20&t=avLf_nZfVY2WEbnfKO5Wmw\n※上記ツイのツリーに資料記載（耳と双尾先端の緑色のワンポイントは見落としやすいのでご注意ください）\n\n普段着資料：https://twitter.com/Tukikagerou/status/1660061993762697216\n\nキャラ資料（予備URL）：https://min.togetter.com/VrQdsKr\nこれまでの納品一覧　 ：https://min.togetter.com/Gyo3MrY\nVRCスクショ（VRChatアバター）：https://min.togetter.com/pC5ggJd", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HinomotoEP/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 463965, "client_id": 859605, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/acc0a84c/uploads/origins/343c2951-5371-4927-adc2-d46e358af092?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41286693b1b788b307524eeadba092a6", "srcset": "https://si.imgix.net/acc0a84c/uploads/origins/343c2951-5371-4927-adc2-d46e358af092?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41286693b1b788b307524eeadba092a6, https://si.imgix.net/acc0a84c/uploads/origins/343c2951-5371-4927-adc2-d46e358af092?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=207d34215a69c6c863d336bd23e4a1c4 2x, https://si.imgix.net/acc0a84c/uploads/origins/343c2951-5371-4927-adc2-d46e358af092?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=957df87cc9ce31668243774f3bf4b158 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/acc0a84c/uploads/origins/343c2951-5371-4927-adc2-d46e358af092?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05038ed26a62de9e9619bdb4e6f03d7f", "srcset": "https://si.imgix.net/acc0a84c/uploads/origins/343c2951-5371-4927-adc2-d46e358af092?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05038ed26a62de9e9619bdb4e6f03d7f, https://si.imgix.net/acc0a84c/uploads/origins/343c2951-5371-4927-adc2-d46e358af092?bg=%23fff&aut