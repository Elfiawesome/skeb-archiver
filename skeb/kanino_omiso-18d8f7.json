=200&s=126e70fb9ad23d6ca1a88db5b5a6e9da 2x, https://si.imgix.net/76caa89a/uploads/origins/491ce394-3260-43af-9fdd-21546d75885b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8cded5b1a7e60e855a4252fec87dac67 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/76caa89a/uploads/origins/491ce394-3260-43af-9fdd-21546d75885b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17ed3d34e38203187b1731331312df38", "srcset": "https://si.imgix.net/76caa89a/uploads/origins/491ce394-3260-43af-9fdd-21546d75885b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=17ed3d34e38203187b1731331312df38, https://si.imgix.net/76caa89a/uploads/origins/491ce394-3260-43af-9fdd-21546d75885b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=818ccde98888b6fc064198b69f3a0d7c 2x, https://si.imgix.net/76caa89a/uploads/origins/491ce394-3260-43af-9fdd-21546d75885b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e1f4cfd134f8d3e083d80c5748e0989b 3x"}, "body": "ななしいんくの大浦るかこさん(https://twitter.com/Rukako_Oura)のイラストを依頼したいです。\n活動休止中のため描きづらい等であればお断り頂いて結構です。\n\nオフィスカジュアル(スーツほどカッチリしていないがそこまでラフでないイメージです)を着て、\n「お仕事頑張るぞ！」という前向きな気持ちが分かるようなイラストが希望です。\n\n場面等はおまかせしますが、下記の描写を入れて頂きたく。\n・あにまーれの制服を自室内にハンガー等で綺麗に掛けている\n　(回想シーンの様な感じで端に描く等でも大丈夫です、復帰の希望を持ちたいという願望込みの依頼になります)\n・イラスト内のどこかに「椿」の花を入れる\n　(そこまで強調して描いて頂かなくても良くて、花瓶に一輪等でも大丈夫です)\n\nイラスト内に、宛名書きは入れて頂かなくて結構です。\n\nややこしい依頼かと思いますが、ご一考をお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kanino_omiso/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 269298, "client_id": 1323885, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/359b235f/uploads/origins/22572d6d-1e20-4f4f-bf32-4c1908f6cd7b?bg=%23fff&auto=