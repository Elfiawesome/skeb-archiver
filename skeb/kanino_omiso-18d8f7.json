tps://si.imgix.net/2e41324b/uploads/origins/37669fc9-b589-46a6-a315-e6924a37301d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=93afd8fd82cf87ef60be174df3b652b8 3x"}, "body": "かにのおみそ様\n\nこんばんは、かにのおみそ様。ファンのゼッダルと申します。\nめいじーのかわいいイラストを毎回拝見させております。描いてくださりありがとうございます！とても魅力的です！\n不老不死ちゃんの絵もすごくきれいで…！\nみんなとても可愛く美しく描かれてて惚れちゃいました。\nそれでもしよろしければ、Vではありませんので申し訳ありませんけど、かにのおみそ様にこちらのオリキャラのイラストをお願いしたいです。\nどうかご検討くださいませ。\n\nお願い申し上げたいのはこちらのツイッターのプロフ絵とヘッダーにいるオリキャラ狐娘の万里香（まりか）という子です。\n狐耳と尻尾・赤メガネ・アホ毛、そしてちょっぴりツリ目な目つきが特徴的な、160cmくらいの身長の高校生です。\n本とか、動物や花、星空のような自然をぼーっと見るのが大好きな子です。\n性格的には、ちょっと人見知りで照れ屋ですので人前では余計にクールっぷりしてるけどまた寂しがり屋のちょっと面倒くさい感じです。\n知り合いの前や一人の時には表情が緩めてちょっと豊かになります。\n設定画などのご参考できそうなものを下のURLにまとめておりますのでよろしければ見てくださいませ。\n\nこの娘のかにのおみそ様の絵柄のイラストを依頼してもよろしいでしょうか？\nぺたん座りで画面の外側の…こちら側を見上げてちょっと照れてる笑顔になってる？感じを依頼したいです。\n衣装は設定画のうちの一つで、背景などはおまかせします！\n\n要件のみで申し訳ありません。\nいつも応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kanino_omiso/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 269298, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61c7d677/requests/230140_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5e4a62b4f9603ff814bbee5deda8fee", "srcset": "https://si.imgix.net/61c7d677/requests/230140_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5e4a62b4f9603ff814bbee5deda8fee, https://si.imgix.net/61c7d677/requests/230140_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1dae83c2e108346494e38904ce12c719 2x, https://si.imgix.net/61c7d677/requests/230140_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e93327fa60aa4dfba4908328c0c5212a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_url