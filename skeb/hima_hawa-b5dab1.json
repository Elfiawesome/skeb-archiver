57_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2d98e52f4c927881dbad1c9bcf49d96", "srcset": "https://si.imgix.net/0606c9fe/requests/181657_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e2d98e52f4c927881dbad1c9bcf49d96, https://si.imgix.net/0606c9fe/requests/181657_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0211289e548140d01acb8d8b3c1fd4f4 2x, https://si.imgix.net/0606c9fe/requests/181657_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2af17d98540d92c62ea509c8c080969d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0606c9fe/requests/181657_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e5faad3c685b66c89fab0cecb88a77b", "srcset": "https://si.imgix.net/0606c9fe/requests/181657_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e5faad3c685b66c89fab0cecb88a77b, https://si.imgix.net/0606c9fe/requests/181657_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=695f04191a04fc45609418d3218137f4 2x, https://si.imgix.net/0606c9fe/requests/181657_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=43a06503442b0b0d3207a7b59216304a 3x"}, "body": "はわさん、こんにちは。\n今回は「体育教師と男子中学生の入れ替わり」のイラストを、はわさんが描いたらどうなるのか？が見たくなって、依頼を出しました。具体的な内容は、下記の通りです。\n\nシチュエーション\n　体育教師と男子中学生の体が入れ替わってしまい、体は体育教師（中身は男子中学生）が、体は男子中学生（中身は体育教師）に、チンポを扱かれて射精してしまっている場面です。\n\n　補足すると、精通もまだなのにいきなり大人の体になってしまって、うまく性欲の処理ができない、体は体育教師（中身は男子中学生）が、体は男子中学生（中身は体育教師）に、性教育の延長としてチンポを扱かれている状況です。\n\n　そのため、扱いている側である、体は男子中学生（中身は体育教師）は、淡々と元の自分のチンポを手慣れた様子で扱いており、あれこれ男の体について講釈を垂れてそうな、余裕のある様子で描いて欲しいです。\n\n　一方で、扱かれている側の、体は体育教師（中身は男子中学生）は、憧れていた先生の体になった挙げ句、人生で初のオルガスムスを、大好きな先生の肉体で体験してしまう、という倒錯的な状況に非常に興奮しており、快楽に溺れて余裕のない表情で描いて欲しいです。それと、涎が顎まで垂れている描写もお願いしたいです。\n\n\n体育教師の風貌\n　30代前半ぐらい。爽やかなマッチョ。上半身は白い半袖ポロシャツとホイッスル。下半身は赤いジャージを膝下まで刷り下げて、チンポを扱かれている状態です。両手はポロシャツの裾をめくって、チンポを扱いて貰いやすくしている感じです。それと、陰毛が股間からヘソまで繋がって生えている描写もお願いしたいです。\n\n\n男子中学生の風貌\n　文化系で、おとなしそうな生徒。服装は夏服の、半袖半ズボンの体操着でお願いします。\n\n\n背景\n　特に背景については指定はないです。今回の依頼で見たいのは、倒錯的な状況に陥った生徒と教師の関係性なので、なんなら背景は無地でも構わないくらいです。\n\n\n　依頼文は以上です。検討のほど、よろしくお願いします！", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hima_hawa/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5766ea19/requests/166007_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b2e448c11625eaf109a70b6b2bb9e6b5", "srcset": "https://si.imgix.net/5766ea19/requests/166007_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b2e448c11625eaf109a70b6b2bb9e6b5, https://si.imgix.net/5766ea19/requests/166007_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a71bdf581c418c48e4de591ac48d4cf 2x, https://si.imgix.net/5766ea19/requests/166007_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c4ed9cab32fb9bc10215b1ac97ef3f24 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 17258, "client_id": 22982, "nc": 48}, {"path": "/@hima_hawa/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 17258, "client_id": 2024, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42731a3c/requests/149955_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a2a0fb27eb51784692908e1ca3b109e", "srcset": "https://si.imgix.net/42731a3c/requests/14995