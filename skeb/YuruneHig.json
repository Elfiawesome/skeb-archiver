e.com/production/uploads/images/56566432/picture_pc_c478c729c4e4a964add1a6f29b1d26e3.png?width=4000&height=4000&fit=bounds&format=jpg&quality=90", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YuruneHig/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 135196, "client_id": 260033, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61f7153f/uploads/origins/91994ccf-dd1d-4215-af22-674f48276161?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa09716b0c91335110aec98be16a5f13", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61f7153f/uploads/origins/91994ccf-dd1d-4215-af22-674f48276161?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef95055480163ba5fcc5666620c3b89d", "src_set": ""}, "body": "ゆるねひぐ様\n小灘ゆきでござる。\nイラストのご依頼をさせて頂きますでござる。\n\n今回の依頼は\n小灘ゆきのデフォルメミニキャライラストをお願いしますでござる。\n\n\n楽しそうな小灘ゆきを描いて頂きたいです！でござる。\nよろしくお願いしますでござる！\n\n\n立ち絵参考\nhttps://x.com/konadayuki358/status/1701872939921203255?t=isUUWiGhUJ81KVo9SLRVrQ&s=19\n\n顔参考\nhttps://x.com/konadayuki358/status/1795796657809858751", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YuruneHig/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 135196, "client_id": 3238387, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cbf23522/uploads/origins/94ac60aa-0db2-4e15-b09b-18fdb7c620de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe7d324f846477aafd75ce02b0ee90e6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cbf23522/uploads/origins/94ac60aa-0db2-4e15-b09b-18fdb7c620de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=293eb5b92a0aa2e2c41fe41c002c5dac", "src_set": ""}, "body": "ゆるねひぐ様、はじめまして。\nVtuber活動をしている睡莵まほろ(すいつ まほろ)と申します。\nゆるねひぐ様のXのヘッダーイラストが大変可愛かったため、\nよろしければ活動で使用したいデフォルメキャラをゆるねひぐ様にお願いしたいです。\n下記が依頼内容になります。\n\n【使用用途】\n・YoutubeにUPする動画や配信内での使用\n・SNSでのポスト\n\n【イメージ】\n現在、パワプロ企画に参加する機会があるため、下記のどちらか描きやすい方をリクエストさせて頂きたいです。\n来ている衣装や装飾品が細かい部分が多いと思われるため、露出度が低ければ違う衣装でも大丈夫です。\n（野球服やジャージ、制服など）\n①バッドを持ったパワプロ風のイラスト\n②ポンポンを持って応援しているイラスト\n※ゆるねひぐ様のイラストが好きなため、必ずしも上記を守っていただく必要はございません。\nご自由に描いていただきたいです。\n\n【キャラデザイン】\n普段はお菓子の家で暮らしている魔女です。\n送付しているGoogドライブに立ち絵と顔をアップにした画像を格納しております。\n\n【納品形式】\n可能であれば、人物のみの透過データを頂けると嬉しいです。\n\nお忙しい中恐縮でございますが、リクエストについてご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Ol9A-_e50ozRh5Z3D5fdIlF8uoGaF7Ad?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YuruneHig/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 135196, "client_id": 1965349, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aff4baef/uploads/origins/6abed1d6-e1c4-432f-9034-546849f41270?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a88fd31a25abc908f8642b6cc56cf1f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aff4baef/uploads/origins/6abed1d6-e1c4-432f-9034-546849f41270?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8dd6bc98d6e439b7c3e0bbbb5314ba46", "src_set": ""}, "body": "ゆるねひぐ🐈先生はじめまして！\n個人Vtuberの星羊おメガ‪と申します！\nこの度、急で申し訳ないのですが、ゆるねひぐ🐈先生にイラストのお願いをしたいと思いメッセージを送らせていただきました。\nご検討のほどよろしくお願いします！\n┈┈┈┈┈┈┈┈┈┈\n【依頼内容】\n星羊おメガ　パワプロ風デフォルメイラスト　2点　\n【資料】\n・三面図\nhttps://drive.google.com/file/d/1eCcUMQ7GfxxR5NZmAFzhcyTBlnK45O4l/view\n・Youtube\nhttps://www.youtube.com/@Hoshihitsuzi_Omega\n\n【リクエスト内容】\n・横浜DeNAベイスターズのユニホームを着用(背番号25)\n・バッティングしてる姿、ピッチングしてる姿　2点\n・お手数おかけ致しますが、納品時に透過版（PSDでも大丈夫です。）も合わせて、納品して頂けると幸いです。\n・金額不足などありましたら再送お願い致します。\n【詳細・活動内容】\n・ひつじ系おとこのこゲーマーVTuber\n・身長115cmの7さいの男の子\n・Splatoon3やポケモン等を中心としたゲームを多く行う。\n・もともと人間の男性であったが訳あって羊の男の子にされてしまった。\n・とてもおっとりしていて穏やかな性格。\n羊というのもあってかよくあくびをして眠そうにしている。\n恥ずかしがり屋さんでもあり、強く言われるとおどおどして泣いてしまうことも。\n・趣味は歌うこと\n・特技は動画編集\n・21時～23時頃の夜に配信活動中\n・好きな色は黄色・白色\n・好きな食べ物は卵料理\n\n【使用用途】\n配信のサムネイル等\nTwitterなどSNSへの投稿等\nNG項目がございましたら別レイヤーにてお知らせいただけますと幸いです\n\n【納品形式】\n人物と背景、サイン等がレイヤー分けされた\nPSDデータでいただけますと幸いです。\n\n大変難しい内容ですが、もしご縁がございましたら、星羊おメガをゆるねひぐ🐈先生の素敵な絵柄でぜひ描いていただきたいです！\nご検討よろしくお願いいたします！\n\nhttps://drive.google.com/file/d/1eCcUMQ7GfxxR5NZmAFzhcyTBlnK45O4l/view", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YuruneHig/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 135196, "client_id": 3071106, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/079cbb19/uploads/origins/5706d4dc-803a-4a7c-9fd4-21095f6d9581?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d34f4f72033e7e270b37cc56d70dba15", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/079cbb19/uploads/origins/5706d4dc-803a-4a7c-9fd4-21095f6d9581?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=69fa934def9842a5f62ba0453e9a2c89", "src_set": ""}, "body": "ただの横山です\nよろしくおねがいします", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@YuruneHig/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 135196, "client_id": 130814, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c48a233c/uploads/origins/6239cc32-95b6-44dd-b21e-fbf5a3adfede?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=24e625b99afee2f1a29cfb4141292aa4", "src_set": ""}, "duration": null, "n