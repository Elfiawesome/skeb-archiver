資料が少なく分かりずらい部分もあるかと存じますが、不明瞭な部分は自由に描いて頂いて構いません。\n\n何卒ご検討、よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1-4rovIsSqXS4tjaL_Ai17bGJcwFwqZfM", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ruka1_126/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3716154, "client_id": 3569768, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8f1afb5a/uploads/origins/a6def47f-026e-4d7b-81c0-0ee073aaa4c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aae8a585f68ccc9ed35ed0dee829cd3a", "srcset": "https://si.imgix.net/8f1afb5a/uploads/origins/a6def47f-026e-4d7b-81c0-0ee073aaa4c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aae8a585f68ccc9ed35ed0dee829cd3a, https://si.imgix.net/8f1afb5a/uploads/origins/a6def47f-026e-4d7b-81c0-0ee073aaa4c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e4476256b3fd0dce482bb65299efbd7 2x, https://si.imgix.net/8f1afb5a/uploads/origins/a6def47f-026e-4d7b-81c0-0ee073aaa4c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eec810fbeecb20e69a5e60dd0469fd7b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f1afb5a/uploads/origins/a6def47f-026e-4d7b-81c0-0ee073aaa4c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79fd798f8a7e0d860a9db218100e48e7", "srcset": "https://si.imgix.net/8f1afb5a/uploads/origins/a6def47f-026e-4d7b-81c0-0ee073aaa4c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79fd798f8a7e0d860a9db218100e48e7, https://si.imgix.net/8f1afb5a/uploads/origins/a6def47f-026e-4d7b-81c0-0ee073aaa4c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e210671e10478c7c3b657da07508b411 2x, https://si.imgix.net/8f1afb5a/uploads/origi