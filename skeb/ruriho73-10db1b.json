9568c06809b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e1b0597e057443d976c7d37c365f9caa 3x"}, "body": "こんにちは。\n緑魔キャロラインさんのイラストをお願いします。\nhttps://x.com/midorimacarol/status/1535826178162171904\n差分を使ってこのポストの内容を再現していただきたいです。\n表情や服装などはお任せします。\n\n①メイク待ちの緑魔キャロラインさん\nメイクをしてもらうため、目をつむってこちらに顔を向けています。\n前髪はヘアピンかヘアバンドで上げて、おでこを出してください。\n\n②落書きされた緑魔キャロラインさん\n顔に落書きされたのに気付いて、目を開けてこちらを見ています。\n可能なら、手前にマジックペンを持った手を登場させてください。\n\n落書きの内容ですが、2パターンお願いしたいです。\n①可愛らしく、顔に何ヶ所か軽めの落書き\n　ハートマークや星マーク、猫ひげなど\n②面白おかしく、顔中びっしり落書きまみれ\n　ひげやぐるぐるほっぺ、眉毛を太く繋げるなど\n\nご検討よろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ruriho73/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1160641, "client_id": 3011207, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/acadeea1/uploads/origins/a9051358-414e-48db-9952-8909db4d1985?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab3babd796336127e371311242476f23", "srcset": "https://si.imgix.net/acadeea1/uploads/origins/a9051358-414e-48db-9952-8909db4d1985?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab3babd796336127e371311242476f23, https://si.imgix.net/acadeea1/uploads/origins/a9051358-414e-48db-9952-8909db4d1985?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c906a30788bba9e0e24d16d729ac135 2x, https://si.imgix.net/acadeea1/uploads/origins/a9051358-414e-48db-9952-8909db4d1985?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68e38934034fdf4f3be876ee52268759 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/acadeea1/uploads/origins/a9051358-414e-48db-9952-8909db4d1985?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ec6b2ae39c31a9276de1c047ee43af4", "srcset": "https://s