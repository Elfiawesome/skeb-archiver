0990, "client_id": 2168110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa536725/uploads/origins/5bf7a671-00ff-4bf1-98ec-08aaa2925e8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdfc903465ac5229ab74afbaefe0b64c", "srcset": "https://si.imgix.net/fa536725/uploads/origins/5bf7a671-00ff-4bf1-98ec-08aaa2925e8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdfc903465ac5229ab74afbaefe0b64c, https://si.imgix.net/fa536725/uploads/origins/5bf7a671-00ff-4bf1-98ec-08aaa2925e8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1ecefcd8753dcb44a57678e6192b00a 2x, https://si.imgix.net/fa536725/uploads/origins/5bf7a671-00ff-4bf1-98ec-08aaa2925e8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95bbad45c6b057254bb3c3b109b11df7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa536725/uploads/origins/5bf7a671-00ff-4bf1-98ec-08aaa2925e8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d2554bb43f798a029e88bd9febf20b3", "srcset": "https://si.imgix.net/fa536725/uploads/origins/5bf7a671-00ff-4bf1-98ec-08aaa2925e8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d2554bb43f798a029e88bd9febf20b3, https://si.imgix.net/fa536725/uploads/origins/5bf7a671-00ff-4bf1-98ec-08aaa2925e8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=acdce65c1b63d0dc00eff756ab07497e 2x, https://si.imgix.net/fa536725/uploads/origins/5bf7a671-00ff-4bf1-98ec-08aaa2925e8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d3d37fde378244bd9be647f14ec9d422 3x"}, "body": "絵柄が素敵だったのでご依頼しました。\n冥府をテーマにうちのOCの「鮫氷しゃち」をお願いすることは可能でしょうか？ \n参考までに設定は以下のとおりですが、自由に描いていただいて構いません。\n███\n鮫氷 しゃち（さめすが しゃち）\n細身かつ色白の黒髪ロングストレート。\n白と黒を基調にしたセーラー服にセーラーキャップを着こなす。\nアイドル的な元気さと明るさに加え、清楚で可憐な容姿をしている。 \n好奇心旺盛で趣味はテーマパーク巡りと人間観察。\nかなりの偏食家で、気に入ったものはヘビロテする。その一方で飽きるのも早い。  \n親しい間柄の相手でさえ巧みに感情を操って都合よく利用する。\nその言動はどこか演技的で大げさ。\n先天的に共感性が欠落しており、一見感情のように見えるものは人間観察の結果身に着けたものでしかない。\n███\n宛名・背景はpsdでon/offできると幸いです。\n使用用途は個人活動全般(小説の挿絵等、SNSや個人サイト等でのキャラクター紹介・個人活動の告知等、コミッションでのリクエストのための参考資料等)を考えています。\nもしご都合が合えばよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/15QcfblJ6ABjLUrKZ3ijKi-ncxD6c6GKd", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 766695, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "IZ（あいぜっと）@『Witch's Heart』の中の人。", "screen_name": "blueiziz", "avatar_url": "https://pbs.twimg.com/profile_images/1704769743725666304/1Cf7deKu.png", "header_url": "https://pbs.twimg.com/profile_banners/962013116765675521/1734268894/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 2337593, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "てんちゃ", "screen_name": "Ten0609Cha", "avatar_url": "https://pbs.twimg.com/profile_images/2000586398349533184/KNQhLAMB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1534900901097644033/1765813172/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 2629798, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "戸森（tomori）", "screen_name": "tmrhrc", "avatar_url": "https://pbs.twimg.com/profile_images/1742898688190775296/_tCY8Nw1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/10793298828474