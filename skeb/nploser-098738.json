4a3acaf/uploads/origins/b231c687-589c-4f6d-973d-65a83819a817?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0776cb630b0fb98c3b4868cb0cc37843 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e4a3acaf/uploads/origins/b231c687-589c-4f6d-973d-65a83819a817?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63441941be1c09b4d725033ddc9bdf21", "srcset": "https://si.imgix.net/e4a3acaf/uploads/origins/b231c687-589c-4f6d-973d-65a83819a817?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63441941be1c09b4d725033ddc9bdf21, https://si.imgix.net/e4a3acaf/uploads/origins/b231c687-589c-4f6d-973d-65a83819a817?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ad8a67805ac1631db06aa18ddd7cccc5 2x, https://si.imgix.net/e4a3acaf/uploads/origins/b231c687-589c-4f6d-973d-65a83819a817?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9a6e5f7dd0d168510a23aeb6d02ae431 3x"}, "body": "はじめまして！\ngnsnきっかけで知り、いつも素敵なイラストを拝見しております。\nキャラが生きている！と強く思える生き生きとした表情、可愛らしい絵柄にとても惹かれております…！\n\nリクエスト失礼致します。\n以前ゲームで動かしていた自キャラクターです。\nご検討いただけましたら幸いです。\n\n―――――――――\n\n【1】機械人形の少年\nhttps://twitter.com/yashiroRH/status/1431957442473050123\n\n・敬語で淡々と喋る機械人形の少年。ボディパーツは最新型、コアなど内部パーツは旧型のちぐはぐな個体。\n・銀髪、右目マゼンタ/左目バイオレット。\n・感情が僅かに芽生えかけている。\n・日課は読書。書物を通じて人間の感情を理解しようとしていた(旧い機体でも感情を得ることができるのか、という実験のために或る博士によって造られた機械人形だからです)\n・なお余談ですが、旧いパーツではその過負荷に耐え切れず、最終的には感情を自覚したと同時にコアが壊れて死を迎えます。\n・白手袋は必須(機械らしいパーツが唯一ある部位が手の甲なので、それを隠すために着用しています)\n・満面の笑みはNG、微笑までは可です。\n\n【2】キメラ的な種族の少女\nhttps://twitter.com/yashiroRH/status/1669061989040283648\n\n・黒い腰羽に黒い尾(鳥)、大きな獣耳(フェネック)あり。\n・髪色はピンクゴールド。\n・なんとかなる、がモットーの明るい性格。\n・失せ物探しから人殺しまで、どんな依頼でも請ける何でも屋。表向きはジャム屋の店員。\n・喜怒哀楽、感情も表情も豊か。やや感情に流されがち。\n・服装/髪型はどちら準拠でも構いません、アレンジも歓迎です。\n\n―――――――――\n\n■関係性\n\n時に一緒に戦い、時に共に語らった良き友人。\n少女が機械人形を引っ張り、あちこちに連れて行きながら彼の変化を見守っていた感じです。\n戦闘時は冷静な機械人形が猪突猛進な少女をサポートする時もありました。\n持ちつ持たれつといった間柄で、恋愛感情はありません。\n\n―――――――――\n\n■依頼内容\n\n貴方様の絵柄で見たいという一心でのリクエストです。\n設定をあれこれ書きましたが、内容は完全にお任せします。\nご自由にのびのびと描いていただけますと嬉しいです…！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nploser/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3249876, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/510a3f02/uploads/origins/135c9cf6-a5e6-4f32-9515-2b7dc7cbe67c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5edeb03fc46ce2845789e6b01a5b904c", "srcset": "https://si.imgix.net/510a3f02/uploads/origins/135c9cf6-a5e6-4f32-9515-2b7dc7cbe67c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5edeb03fc46ce2845789e6b01a5b904c, https://si.imgix.net/510a3f02/uploads/origins/135c9cf6-a5e6-4f32-9515-2b7dc7cbe67c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2794560663e958b71262576f392009c3 2x, https://si.imgix.net/510a3f02/uploads/origins/135c9cf6-a5e6-4f32-9515-2b7dc7cbe67c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=80db9526bbef796d0853d221869d29de 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/510a3f02/uploads/origins/135c9cf6-a5e6-4f32-9515-2b7dc7cbe67c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5377ed194e4bd4efd3c114322dc97077", "srcset": "https://si.imgix.net/510a3f02/uploads/origins/135c9cf6-a5e6-4f32-9515-2b7dc7cbe67c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5377ed194e4bd4efd3c114322dc97077, https://si.imgix.net/510a3f02/uploads/origins/135c9cf6-a5e6-4f32-9515-2b7dc7cbe67c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bc648fb0b990b56c0a6996c624882654 2x, https://si.imgix.net/510a3f02/uploads/origins/135c9cf6-