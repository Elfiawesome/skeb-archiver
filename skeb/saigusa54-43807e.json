otal_appeals_count": 0, "received_works": [{"path": "/@saigusa54/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 631135, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8d30079/uploads/origins/2beeb6a1-7769-4540-8fb8-3b168fd87410?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ac14f1f7172d9021e2709bf91100b9c", "srcset": "https://si.imgix.net/a8d30079/uploads/origins/2beeb6a1-7769-4540-8fb8-3b168fd87410?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3ac14f1f7172d9021e2709bf91100b9c, https://si.imgix.net/a8d30079/uploads/origins/2beeb6a1-7769-4540-8fb8-3b168fd87410?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1cc499a31bc9066016c8a57b43047093 2x, https://si.imgix.net/a8d30079/uploads/origins/2beeb6a1-7769-4540-8fb8-3b168fd87410?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65d86c104f002f12fd806d2b8bd50718 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a8d30079/uploads/origins/2beeb6a1-7769-4540-8fb8-3b168fd87410?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=318eba985d87f48d46b63ad183bee71d", "srcset": "https://si.imgix.net/a8d30079/uploads/origins/2beeb6a1-7769-4540-8fb8-3b168fd87410?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=318eba985d87f48d46b63ad183bee71d, https://si.imgix.net/a8d30079/uploads/origins/2beeb6a1-7769-4540-8fb8-3b168fd87410?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4ea8e7f414ffc37fa4ea9ef17c4d1e47 2x, https://si.imgix.net/a8d30079/uploads/origins/2beeb6a1-7769-4540-8fb8-3b168fd87410?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ca34935454f17a17f65bd632b5457d15 3x"}, "body": "もしよろしければ、美人遊女がくすぐり妖怪に全身を舐め回され、くすぐり地獄のリクエストをお願いします。\n\nキャラ：綺麗な髪に白い肌、美しい曲線の身体の持ち主。美貌と教養を兼ね備えた美人。元々神楽の舞姫らしい、妖怪の男に騙されて拉致され、妖怪を遊興させる遊郭に売られてしまう。男たちと妖怪たちの歪んだ性欲を発散するために、性的奴隷として扱われる（主にくすぐり犯すこと♡）\n\nシチュ：何度も反抗・脱走を試みてきた遊女、とある体を傷つけないの罰を受けることになった。男たちに「舐ノ湯」という不気味な風呂場に連れていかれて、苛烈なくすぐり拷問にかけられてしまう\n\n・衣服を全て剥ぎ取られ、施術台の上に仰向けで拘束されている美女は、腋の下、胸、お腹、股間、足の裏、足の指の間まで、体の敏感な部位に媚薬を仕込んだ蜜を塗られて放置される（刷毛や筆など程度の刺激にもう耐えられず、苦しそうに笑い悶える）\n・ほどなく、「あかなめ」みたいな妖怪たちが体に引き寄ってくる。風呂場や風呂桶などに付着した垢を舐め落とす妖怪と言われているが、実は女の柔肌から出る汗などものを直接舐めるほうが好き。その舌に触れると、耐え難いくすぐったさを感じる\n・汗をかきやすく、においやすい部分である腋の下・乳首・お臍・陰部・足の裏には特に舌が舐め回される。それに胸・腰・太ももを揉まれくすぐられ、彼女の汗や愛液を絞り出され続ける\n・地獄のようなくすぐったさに、彼女は笑い狂いながら悶え続ける事しかできない。女性の匂いを身体から発しているせいで、妖怪がさらに群がってくる\n・その後、拷問が延長されるため、男たちは勘弁してと泣きついている彼女を四つん這いの姿勢で拘束し直して、まだ敏感な肌に蜜を塗り擽り、もう一回放置しておる。今回は背筋もお尻も免れない\n\n可能であれば、その他：\n・この悲惨な状況に陥る前に普段着の舞姫、あるいは遊女のイメージ落書きをお願いします\n・くすぐり妖怪「あかなめ」の外見は、エロガキとキショ生物を融合のようなもの、舌の長さは20–40 cm\n・妖怪は剥ぎ取られたばかりの彼女の着物や腰布をつかみ、匂いを嗅いだり、舐めたりする\n・ナレーション風のイメージ、詳しい内容やセリフはお任せします\n\nこれらのシチュエーションはあくまで提案ですので、適宜内容を変更・厳選していただいて構いません\nご検討のほどよろしくお願いいたします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@saigusa54/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 631135, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2bd0343b/uploads/origins/0f7b77d2-f23d-4a19-9c72-ca0e6ac70c76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5e966304313d7e7d3aa3048862aa782", "srcset": "https://si.imgix.net/2bd0343b/uploads/origins/0f7b77d2-f23d-4a19-9c72-ca0e6ac70c76?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5e966304313d7e7d3aa3048862aa782, https://si.imgix.net/2bd0343b/uploads/origins/0f7b77d2-f23d-4a19-9c72-ca0e6ac70c76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc543c285e66d024bb78496f4167a47c 2x, https://si.imgix.net/2bd0343b/uploads/origins/0f7b77d2-f23d-4a19-9c72-ca0e6ac70c76?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=t