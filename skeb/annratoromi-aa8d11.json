いですがご検討の程よろしくお願いします！", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 40281, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "🦞赤マフラー大和🦞", "screen_name": "yamatoooooo", "avatar_url": "https://pbs.twimg.com/profile_images/1774644076132159489/YiVnMVcm.jpg", "header_url": "https://pbs.twimg.com/profile_banners/112703724/1706509940/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 48277, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ひとかとか", "screen_name": "r9L8QO89LRJqH9v", "avatar_url": "https://pbs.twimg.com/profile_images/1114312930751729664/2-xzZkOe.png", "header_url": "https://pbs.twimg.com/profile_banners/1114068574094553089/1554507951/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 33}, {"id": 520094, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "あまがえる🦊マグコミ＆永遠娘コミックス2冊発売中", "screen_name": "HylaTheWet", "avatar_url": "https://pbs.twimg.com/profile_images/1927900267133161473/geRP76QD.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1741717848949714944/1767782418/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 775050, "creator": true,