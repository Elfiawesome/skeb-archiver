-828c-bab6754669f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bf328f651d595768a3ae8ceef729324e, https://si.imgix.net/6f61d084/uploads/origins/01f05f45-baf8-4fa3-828c-bab6754669f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e3261054641a33f26a17bc558c68979a 2x, https://si.imgix.net/6f61d084/uploads/origins/01f05f45-baf8-4fa3-828c-bab6754669f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a4f1b929605c616975f1144404a04dda 3x"}, "body": "お久しぶりです、ウリビン様\n以前にマドルチェ・プディンセスとマドルチェ・シューバリエのイラストをリクエストした者です\n\n○キャラクター\n・遊戯王OCGのマドルチェ・プディンセス\n（以下プディンセス）\n・遊戯王OCGのマドルチェ・シューバリエ\n（以下シューバリエ）\n\n○依頼内容\nプディンセスとシューバリエがケーキ入刀をするイラスト\n\n○二人の特徴\n●プディンセス\n・ウェディングドレスを着ていて白いベールを被っている\n・ウェディングケーキを見て目を輝かせながら両手でシューバリエの剣を構える\n\n●シューバリエ\n・白いタキシードを着ていてカードイラストと同じ帽子（を白くしたの）を被っている\n・緊張しているが右手で自分の剣を持って左手をプディンセスの腰に回している\n\n○おまけ\nこれはおまけで描いて欲しいですけど描くかはウリビン様の自由で構いません\n・シチュエーションはそのままだけどプディンセスの衣装はショコ・ア・ラ・モードと同じでシューバリエの衣装がカードイラストと同じになっている差分\n\n注文が多いと思いますがよろしくお願いします", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uribin_yp/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3104851, "client_id": 1937910, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e06ef27/uploads/origins/07510061-2d54-4db0-983d-e3f54ce8715a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd8618387adb34988f5bead5b4578a1d", "srcset": "https://si.imgix.net/6e06ef27/uploads/origins/07510061-2d54-4db0-983d-e3f54ce8715a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd8618387adb34988f5bead5b4578a1d, https://si.imgix.net/6e06ef27/uploads/origins/07510061-2d54-4db0-983d-e3f54ce8715a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=436ecded3bee865d316f7fd01f7906c2 2x, https://si.imgix.net/6e06ef27/uploads/origins/07510061-2d54-4db0-983d-e3f54ce8715a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed40b0179eccbffacaf348898a16ae6d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e06ef27/uploads/origins/07510061-2d54-4db0-983d-e3f54ce8715a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1e2b66ca908b83301e7861d7292fdfb", "srcset": "https://si.imgix.net/6e06ef27/uploads/origins/07510061-2d54-4db0-983d-e3f54ce8715a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1e2b66ca908b83301e7861d7292fdfb, https://si.imgix.net/6e06ef27/uploads/origins/07510061-2d54-4db0-983d-e3f54ce8715a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=afcb07bba81bf1ef911b656b24d409db 2x, https://si.imgix.net/6e06ef27/uploads/origins/07510061-2d54-4db0-983d-e3f54ce8715a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1b0df6756a1893a93b4ec12bbabd00da 3x"}, "body": "ウリビンさんはじめまして！いつも可愛いイラスト拝見しております。\n\n早速ですが、幻獣王キマイラのぬいぐるみを抱いている「幻惑の見習い魔術師」を描いていただけないでしょうか？\nキマイラはぬいぐるみにするにあたってデフォルメしてもらいたいです。\n\n描いていただいたイラストはnote等個人的な用途で使用させていただこうと思っております。\n何卒宜しくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uribin_yp/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3104851, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/746e9272/uploads/origins/cca7e106-7c0c-425c-b6a3-90c4199e8df7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7860fd160c8b954602677a23ed47170", "srcset": "https://si.imgix.net/746e9272/uploads/origins/cca7e106-7c0c-425c-b6a3-90c4199e8df7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c7860fd160c8b954602677a23ed47170, https://si.imgix.net/746e9272/uploads/origins/cca7e106-7c0c-425c-b6a3-90c4199e8df7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c907b2842d28676fb72b7da7b24528d6 2x, https://si.imgix.net/746e9272/uploads/origins/cca7e106-7c0c-425c-b6a3-90c4199e8df7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1b47283dae4c9e9c38488c7a83280d6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/746e9272/uploads/origins/cca7e106-7c0c-425c-b6a3-90c4199e8df7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b77cfe705d4dbd7714bac8d935ad68d8", "srcset": "https://si.imgix.net/746e9272/uploads/origins/cca7e106-7c0c-425c-b6a3-90c4199e8df7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b77cfe705d4dbd7714bac8d935ad68d8, https://si.imgix.net/746e9272/uploads/origins/cca7e106-7c0c-425c-b6a3-90c4199e8df7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b0377b6ffd068340e4a545cb12f4b9d9 2x, https://si.imgix.net/746e9272/uploads/origins/cca7e106-7c0c-425c-b6a3-90c4199e8df7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4ead789aec2334cb6de609b28682b7d1 3x"}, "body": "こんにちは、ウリビン様\n貴方の可愛いマドルチェモンスターのイラストを何時も楽しませていただいています。\n\n○キャラクター\n・遊戯王OCGのマドルチェ・プディンセス\n（以下プディンセス）\n・遊戯王OCGのマドルチェ・シューバリエ\n（以下シューバリエ）\n\n○二人のポーズ\nお姫様抱っこでシューバリエがプディンセスを抱っこしている\nシューバリエの顔は呆れている感じでプディンセスの顔は満面の笑みでお願いします\n背景はマドルチェ・シャトーの内部っぽい感じでお願いします\n\n○差分\nこれは差分で描いて欲しいけど描くかはウリビン様の自由で構いません\n・プディンセスが頬にキスをしてシューバリエの顔が真っ赤に染まって固まる\n\n注文が多いと思いますが是非、改めてよろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uribin_yp/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3104851, "client_id": 931082, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd5cf772/uploads/origins/d945238c-dce