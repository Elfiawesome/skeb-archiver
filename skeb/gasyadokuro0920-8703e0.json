ator_acceptable_same_genre": true}, {"path": "/@gasyadokuro0920/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3771961, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c364911c/uploads/origins/76082742-b565-42d1-81f8-1098dcfaf5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bb74112cfe2a5b4328401b7c7c6bb56", "srcset": "https://si.imgix.net/c364911c/uploads/origins/76082742-b565-42d1-81f8-1098dcfaf5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bb74112cfe2a5b4328401b7c7c6bb56, https://si.imgix.net/c364911c/uploads/origins/76082742-b565-42d1-81f8-1098dcfaf5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d56359c65703d4f75d39864f68eb5c31 2x, https://si.imgix.net/c364911c/uploads/origins/76082742-b565-42d1-81f8-1098dcfaf5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0368cde7e98de6da0e839932271c7cbd 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c364911c/uploads/origins/76082742-b565-42d1-81f8-1098dcfaf5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3080a70c3928d86051a85ac3a32d4a22", "srcset": "https://si.imgix.net/c364911c/uploads/origins/76082742-b565-42d1-81f8-1098dcfaf5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3080a70c3928d86051a85ac3a32d4a22, https://si.imgix.net/c364911c/uploads/origins/76082742-b565-42d1-81f8-1098dcfaf5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d23afb71b9f964de466cc7f947c91d73 2x, https://si.imgix.net/c364911c/uploads/origins/76082742-b565-42d1-81f8-1098dcfaf5e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d23deefcce6d644837693908d117d347 3x"}, "body": "うちの子が眠らされて集団レイプされているところを生配信されているイラストを描いてください\n\n内容\n①悪戯\n②本番\n③妊娠検査\n④14週と22週:エコー検査とセックス\n⑤臨月:エコー検査とボテ腹セックス \n\n①\n一服盛られたうちの子は目隠しをされ、その状態で配信が開始される。服の上から胸を揉まれたり、ボタンを外してブラ上から胸を揉まれる。フロントホックブラを外して生乳が露出して乳を揉む\nスカートのホックを外して脱がし、紐パンの紐を解くとマンコが露出する。男達はクンニと母乳吸いを同時にする\n\n②\nチンコをだし、チンコでマンコに愛撫でする。愛撫でされるたびにビクンビクンとうちの子は感じる\nそして亀頭がマンコに触れると徐々に挿入を始める。亀頭が包み込まれるとゆっくりと挿入していき子宮口とキスをする。そこからピストン運動を開始。徐々にスピードを上げていき中出し。\n暗転すると一気に挿入して種付けプレスの体位。最後はだいしゅきホールドさせられ中出し\nチンコを抜くと精液ブリッジ。マンコからは大量のザーメンが流れる。服を戻して配信を終えると受精・着床が起きる\n\n③\n①と同じ流れで服を脱がす。まんこや母乳を吸うなどのイタズラして妊娠検査薬に放尿させる。検査結果は陽性。検査薬を何処かに置いてセックス\n\n④\n14週→制服の下に競泳水着を着用。制服を脱がして競泳水着だけにするとその状態から悪戯をする。その鼠蹊部から手を忍び込ませて少し膨らんだお腹にローションを塗ってエコー検査\n22週→水着のままエコー検査。モニターに映る胎児には突起がないため女の子だと判明\n\n⑤\n制服を脱がして搾乳しながらエコー検査。最後にセックス\n\n詳細\n・スキン:制服\n紐パンでフロントホックブラ。紐パンには愛液たっぷりの陽性反応の妊活用ナプキン付き\n・体位:足閉じ→正常位→種付けプレス\n・表情:眠ったまま(途中覚醒NG)悪戯やセックス時は感じている(下品な顔NG) \n・背景:教室\n・排卵描写、中出し断面図、受精描写、胎内描写(胎児の成長差を細かく)お願いします \n・妊娠に伴うバストとヒップアップ\n・パイパン。魅惑の谷間が特徴的なハリがあって形のいい美巨乳。ウエストは引き締まっていて、前からでも見えちゃう尻神様のような安産型のお尻に艶っぽい鼠蹊部と健康的な太もも\n\n金額内で不可能な場合は金額を再送してくださると幸いです\n\nhttps://drive.google.com/drive/folders/1-aU6Jy4i_0sVRLLUTig1DU3yvjRUiS1K", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gasyadokuro0920/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3771961, "client_id": 2492763, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ee01a1cf/uploads/origins/69f30b3f-c8de-4916-86fa-669dd282e905?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f267a62c3af3fec5f8e59c84ec538c73", "srcset": "https://si.imgix.net/ee01a1cf/uploads/origins/69f30b3f-c8de-4916-86fa-669dd282e905?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f267a62c3af3fec5f8e59c84ec538c73, https://si.imgix.net/ee01a1cf/uploads/origins/69f30b3f-c8de-4916-86fa-669dd282e905?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc2bf330cf47dbfdadf904d195bedba6 2x, https://si.imgix.net/ee01a1cf/uploads/origins/69f30b3f-c8de-4916-86fa-669dd282e905?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1644057ff6ea840b3404bad6f443bf65 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee01a1cf/uploads/origins/69f30b3f-c8de-4916-86fa-669dd282e905?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d547547b9b3f83ece132b3b8e72b066d", "srcset": "https://si.imgix.net/ee01a1cf/uploads/origins/69f30b3f-c8de-4916-86fa-669dd282e905?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d547547b9b3f83ece132b3b8e72b066d, https://si.imgix.net/ee01a1cf/uploads/origins/69f30b3f-c8de-4916-86fa-669dd282e905?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=37c9485753a61f8eb9c72ddb84295d5b 2x, https://si.imgix.net/ee01a1cf/uploads/origins/69f30b3f-c8de-4916-86fa-669dd282e905?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=81a76dac470935ed8ad084bf155d99d1 3x"}, "body": "お疲れ様です！個人Vtuberをしております、藍上桜華です！\n前々からすごくイラストかわいいな～…！と思っていたので、お試し価格でSkebが開かれているということで飛びつかせていただきました！\n\n依頼内容なのですが、青肌のキャラクターを描くことに抵抗がなければ、ボク、藍上桜華のイラストを描いていただけたら嬉しいです！\n\n▼内容指定について\n特に指定はありません！イラストレーターの方が自分の癖のままに描いているのが基本的に一番その人のうまさが出ると思っているので、セクシーなのでもキュートなのでもかっこいい感じなのもどんとこいです！\n\n藍上桜華は、相手の思考やイメージを受け止めることで外見や身体的特徴が変化する存在です。\nそのため、性別・身長・体格・髪の長さ・胸の大きさ・服装などなど\nこうだと嬉しいな。みたいな要素があれば自由に解釈・アレンジしていただいて問題ありません。\n\n一方で、以下の要素は「このキャラクターと分かる構成要素」として残していただけると嬉しいです！\n\n・髪色　・肌色　・目の色　・角\n\n上記が含まれていれば、全体のデザインや表現はご自由にお任せします！\n過去にはガッツリ女の子スタイルで描いていただいたケースもガッツリ高身長男性として描いていただいたケースもございます。\n\n逆にデフォルトの設定では\n・性別中性(男女両方の特徴あり)\n・身長165㎝程度\n・胸は普段は中くらいのサイズを衣装で軽く抑え込んでる想定。\n・筋肉などの付き方が少し男の子っぽい\n・舌を伸ばすとだらんと長い\n・爪は黒く塗っていて長い\nといった感じになっています。設定をいじって考えるのも大変だなと思った際はご使用くださいませ。\n\n▼使用用途\n配信のサムネやXのアイコンなどVtuber活動での使用をします！\nそのため、お姿は頭の見切れなし、透過のPngかPSDなどの編集可能なファイルでいただけると嬉しいです。\n\n以上になります！\n\n雪が降るなど、この冬はとても寒く体調を崩しやすい状態ですが、風邪などひかぬようお過ごしください！\n\nhttps://drive.google.com/drive/folders/1mSOSNtBbvy8UXLrrzYyZ-FvlN43MNJzs?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gasyadokuro0920/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3771961, "client_id": 76306, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5cab07e/uploads/origins/34500da8-9027-4b9c-a577-441fb7ed4ea0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec66cb6229884173a5fb4b2fb94641ec", "srcset": "https://si.imgix.net/d5cab07e/uploads/origins/34500da8-9027-4b9c-a577-441fb7ed4ea0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec66cb6229884173a5fb4b2fb94641ec, https://si.imgix.net/d5cab07e/uploads/origins/34500da8-9027-4b9c-a577-441fb7ed4ea0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=898e93982d7b5dff94ae99ea401b1442 2x, https://si.imgix.net/d5cab07e/uploads/origins/34500da8-9027-4b9c-a577-441fb7ed4ea0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=acaa10f7c6fa1f136ed9b05634fdc37d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5cab07e/uploads/origins/34500da8-9027-4b9c-a577-441fb7ed4ea0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=662bc372335d12237014f79a3e05cfc2", "srcset": "https://si.imgix.net/d5cab07e/uploads/origins/34500da8-9027-4b9c-a577-441fb7ed4ea0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=662bc372335d12237014f79a3e05cfc2, https://si.imgix.net/d5cab07e/uploads/origins/34500da8-9027-4b9c-a577-441fb7ed4ea0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=35beb27df37f09ab68ce05b97eeec407 2x, https://si.imgix.net/d5cab07e/uploads/origins/34500da8-9027-4b9c-a577-441fb7ed4ea0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=95bf6529bb0e7f0fa81c996af2bdfa5c 3x"}, "body": "はじめまして。今回私のオリキャラを背景付きで描いていただきたいです。\n\nオリキャラ資料\nhttps://drive.google.com/drive/folders/1GzAfHLWsos6D47uJPWLEy8ueHRK1qjUz?usp=sharing\n・色っぽい雰囲気を出す大人のお姉さん\n・銀色のストレートロングヘア―\n・青色の目\n・巨乳です\n・髪には画像のような髪飾りをお願いします。\n・アンダーヘアーは一切なし\n\n髑髏沼カガチの温泉イラストが素敵だったので、私のオリキャラの温泉イラストをお願いします。巨乳設定なので、大きさと柔らかさの主張を強くしていただければと思います。\nタオルで隠すようなことはせずに温泉につかって堪能しているシーンをお願いします。\n乳首は髪ブラでギリギリ見えない程度でお願いします。ギリギリ見えないのであれば乳輪は見えても大丈夫です。\n局部はぼかすかギリギリ見えないぐらいでお願いします。\n\n縦向けのイラストで全身に近い描写をお願いします。\n\nそれではご検討よろしくお願いします", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gasyadokuro0920/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3771961, "client_id": 3777823, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c5f2a54/uploads/origins/6f7be781-5de2-4a68-8220-bc7001430254?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99bc891c5d8b1b4b7d94cdda9eca68d4", "srcset": "https://si.imgix.net/4c5f2a54/uploads/origins/6f7be781-5de2-4a68-8220-bc7001430254?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=99bc891c5d8b1b4b7d94cdda9eca68d4, https://si.imgix.net/4c5f2a54/uploads/origins/6f7be781-5de2-4a68-8220-bc7001430254?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1bbaf70c52cc2667dba3e152ebdeeecd 2x, https://si.imgix.net/4c5f2a54/uploads/origins/6f7be781-5de2-4a68-8220-bc7001430254?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea587e61d4f1f0402593474c3496da67 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4c5f2a54/uploads/origins/6f7be781-5de2-4a68-8220-bc7001430254?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1067eb80bc59a31ac74311764ead6