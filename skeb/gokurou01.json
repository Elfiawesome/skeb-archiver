l_image_urls": {"src": "https://si.imgix.net/a57c2cec/uploads/origins/332d2b7c-abe0-4f76-8ee6-0522a0429bf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=059d3c6bd1597b3957bde3ac9780c5ac", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a57c2cec/uploads/origins/332d2b7c-abe0-4f76-8ee6-0522a0429bf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6214e7316ce7d39a4fa8e84974d206e3", "src_set": ""}, "body": "もしよろしければ、ブルーアーカイブより「砂狼シロコ(水着)」がくすぐられるイラストをお願いします\nシチュエーションとしましては、スライム娘との戦闘中に捕まってくすぐりで弄ばれる場面をお願いします\nスライム娘の体色や顔立ちなど細かいデザインはごくろう様にお任せいたします\n\n【内容】\n①シロコは両腕を真っ直ぐバンザイして、両脚をがに股に開いた姿勢でスライム娘の体の前面に磔にされてる\n\n②スライム娘はシロコの腋付近にある体の組織を、人間の人差し指のような形状に変化させ、シロコの腋を人差し指でかりかりと掻いたり、ぐりぐりとほじくったりする動きでくすぐる\nシロコは歯を食いしばってこの責めに耐える\n\n③スライム娘は、シロコの腋から太ももにかけておびただしい数の「人差し指」を生やし、シロコの身体中を思いっきりくすぐる\n腋や太股を優しく引っ掻かれたり、脇腹をつっついたりと1つ1つの責めはソフトだが、あらゆる箇所を一気に責められたシロコは我慢できず笑い悶えてしまう\n\n以上の内容でお願いします\n細かい指示が多く恐縮ですが、ご検討の程よろしくお願い致します\n\nhttps://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSggS-IK5fdDtO-ocLb_zeJIieiJCsQRYFV0A&usqp=CAU", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gokurou01/works/19", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/afb1438f/uploads/origins/65d09cda-94fc-44b3-a0a1-37aee7207068?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=95445bed43340f849ca5bf71a5628c23", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 616223, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@gokurou01/works/18", "private_thumbnail_image_urls": {"src