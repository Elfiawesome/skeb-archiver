f43c5dc430c8 2x, https://si.imgix.net/c282f71e/uploads/origins/10cbba71-2a47-4e87-992b-1e48c7e33c02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34853f321bbf91e92a974d7316dc58a3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c282f71e/uploads/origins/10cbba71-2a47-4e87-992b-1e48c7e33c02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a5dd58c2821a06d1c773adcdc634569", "srcset": "https://si.imgix.net/c282f71e/uploads/origins/10cbba71-2a47-4e87-992b-1e48c7e33c02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a5dd58c2821a06d1c773adcdc634569, https://si.imgix.net/c282f71e/uploads/origins/10cbba71-2a47-4e87-992b-1e48c7e33c02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ec270d0f0bb09f6be94ed89eb94583e1 2x, https://si.imgix.net/c282f71e/uploads/origins/10cbba71-2a47-4e87-992b-1e48c7e33c02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a329b4e415fe807ce8877a75a6e58e2f 3x"}, "body": "はじめまして\n好みな絵柄でしたのでリクエストさせてください\n\nキャラ\n星街すいせい\n\n服装\n･ローソン店員の制服+ひざ下丈の紺色のハイソックス\n(過去に実施されたローソンのキャンペーンで配布されたクリアファイルの絵柄と同じものです)\nhttps://www.lawson.co.jp/lab/campaign/hololive/file.html#file\n･ピコレース等の飾りのない純白のフルバックパンツ(クロッチは省略しないでください)\n (先日描かれたhttps://www.pixiv.net/artworks/137355796で着用のパンツと同じもののイメージです)\n\nシチュエーション等\n立ち絵と背景のパンツの組み合わせ(いわゆるMtUウィルスと呼ばれるものです)のイラストをお願いします\n\n･立ち絵の表情は両目を開けた微笑み顔で、ハイソックスを履いているのがわかるようひざ下かふくらはぎ辺りまで描く\n･背景のパンツはお尻側から見たもの\n･差分として\n　･パンツがお尻に食い込んでいるもの\n　･お尻の穴に入れられたバイブでパンツが膨らんでいるもの\n　･パンツの中に出された精液がパンツから垂れているもの(精液はレイヤーにて有無を選択できるようお願いします)\nを作っていただきたいです\n･psd型式での納品を希望します\n\nその他\n実在する企業の制服を描くことに問題があると判断されましたら、上着のデザインをそれとなく元ネタがわかる感じに変更していただいて問題ありません\n\n内容に問題があると判断されましたら即キャンセルしていただいて構いませんので、改めてよろしくお願いします", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Satera_23/works/1", "priva