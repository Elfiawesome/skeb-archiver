がございましたら遠慮なくキャンセルして頂いて構いませんのでご一考の程をよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1ah5uQ_H_ZSC2fh9tDfi3OOGuuTgcy993?usp=sharing", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 3392, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "たぢまよしかづ🐸姫様、ご乱心！（ヤンチャンWEB ）湯ハー(がうがう)W連載中🐸Skeb歓迎", "screen_name": "taditadi", "avatar_url": "https://pbs.twimg.com/profile_images/1486391331689615361/RbMuPUNd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/135971717/1655877745/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "novel"}], "banned": false, "nc": 161}, {"id": 188572, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "Kleio", "screen_name": "kleio", "avatar_url": "https://pbs.twimg.com/profile_images/1659693768428367872/YjGrfG1I.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3039875821/1758575145/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 160}, {"id": 1032630, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "星超え@新作発売中", "screen_name": "ryrrrrrrrrr", "avatar_url": "https://pbs.twimg.com/profile_images/1774089773659090944/Ia1GcHUi.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1336684869494001664/1695203118/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_da