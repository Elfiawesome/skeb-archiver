表現した作品が欲しいです。このキャラクターは下着姿でテイクアウトや脂っこいものを食べているイメージでお願いします。疲れているようなイメージで、書類仕事などマルチタスクをこなしているようなイメージです。\n\n全体的には、一日の仕事を終えた後の、ある種の怠惰な、「独身貴族」のようなシーンであるべきです。\n\n可能であれば、彼はシャツを着ていなくて、ちょっと乱雑な感じにしてください。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@80siiii/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1971597, "client_id": 582670, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51a4dd4c/uploads/origins/23f6fdbd-7fb5-42ff-bf06-3b3917f2e293?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2e30356367dc239facd68f16593f732", "srcset": "https://si.imgix.net/51a4dd4c/uploads/origins/23f6fdbd-7fb5-42ff-bf06-3b3917f2e293?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2e30356367dc239facd68f16593f732, https://si.imgix.net/51a4dd4c/uploads/origins/23f6fdbd-7fb5-42ff-bf06-3b3917f2e293?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c960d52c55eacb491bfdefe52b31fde0 2x, https://si.imgix.net/51a4dd4c/uploads/origins/23f6fdbd-7fb5-42ff-bf06-3b3917f2e293?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ff49685e06d798c35862ef6541c2308 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51a4dd4c/uploads/origins/23f6fdbd-7fb5-42ff-bf06-3b3917f2e293?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e73ae8d28d74c5463ea60a71cd5ee6f", "srcset": "https://si.imgix.net/51a4dd4c/uploads/origins/23f6fdbd-7fb5-42ff-bf06-3b3917f2e293?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e73ae8d28d74c5463ea60a71cd5ee6f, https://si.imgix.net/51a4dd4c/uploads/origins/23f6fdbd-7fb5-42ff-bf06-3b3917f2e293?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=85fa88960f2a7190f80eade71ed349b4 2