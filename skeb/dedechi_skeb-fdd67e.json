1zyebQ1AQIzDxfmpCnrqJR_kQkRAA90gm?usp=drive_link\n\nhttps://charaforio.com/ja/ip/70398\n（キャラクターのタブにも詳細あり）\n\n▶︎概要\n性格は、明るくいじられキャラ。オオカミの群れを率いるボスと呼ばれている。\nデフォルメの場合「オオカミの姿 ver.」もあります。\n\n▶︎ 新衣装の作画ポイント\n太もものベルトは「左右」あり\nブレスレットは「左」のみ\nネクタイに「月とライン」飾りあり\nツインテールの「毛先も濃いグレー」\n青いベルトの「裏」には数字デザインなし。\n1回内側に入れ込んで外に出して最初の折り込んだベルトの下を通してます。（1本です）\n\nサムネイル使用を検討しているため、耳、しっぽ、髪の毛の先、等が切れていないと有難いです。\n\n▶︎使用用途\n・収益化済の配信サイト、動画、配信、イベントでの利用\n・各種SNSへの使用、ファンクラブへの掲載\n・ 商用グッズ、イベント頒布グッズ、リアルでの印刷物\n\n難しそうなものがあれば再送させて頂きます。\nよろしくお願い申し上げます。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@dedechi_skeb/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3363091, "client_id": 2784169, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a75e1085/uploads/origins/e461484a-b885-43ff-8326-0bb71373a6f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af7697e506e63260b7cb0d08d771eb21", "srcset": "https://si.imgix.net/a75e1085/uploads/origins/e461484a-b885-43ff-8326-0bb71373a6f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=af7697e506e63260b7cb0d08d771eb21, https://si.imgix.net/a75e1085/uploads/origins/e461484a-b885-43ff-8326-0bb71373a6f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88f4836520ec568b520a56d18587a3bb 2x, https://si.imgix.net/a75e1085/uploads/origins/e461484a-b885-43ff-8326-0bb71373a6f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ace2cb17708425581827608514c257cb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a75e1085/uploads/origins/e461484a-b885-43ff-8326-0bb71373a6f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad9cf2f7efe2edd69ba37775f5f3b368", "srcset": "https://si.imgix.net/a75e1085/uploads/origins/e461484a-b885-43ff-8326-0bb71373a6f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad9cf2f7efe2edd69ba37775f5f3b368, https://si.imgix.net/a75e1085/uploads/origins/e461484a-b885-43ff-8326-0bb71373a6f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ddc72cc6535c955bf5b4a5e4a85a5b03 2x, https://si.imgix.net/a75e1085/uploads/origins/e461484a-b885-43ff-8326-0bb71373a6f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bb9ccca337c1ee3287fd230e9bd58ff8 3x"}, "body": "デデチ様、初めまして⭐️\nVtuberの神那レイアと申します。\n\nskebさんの再開を楽しみにしておりました！以前よりデデチ様のイラストを拝見しておりかわいさの中にあるかっこいいイラストが大好きなので是非デデチ様に私のイラストをご制作いただきたく今回リクエスト送らせていただきました！\n\n【希望依頼内容】\n普段は夜に悪魔退治をし、みなさんが素敵な夢を見れるようにと活動しているのですが住んでいる教会で日中はシスターとして教会でぼ業務(礼拝、お花に水やり、子供達のお世話など)をしているためデデチ様に\n【シスターとして働いている様子】を構図、衣装、髪型など全てお任せでお願いできればいいなと思っております。\n\n【キャラクターポイント】\n永遠の88歳の女の子。150cm\n本職: エクソシスト☪️兼シスター\n相棒のむうちゃんはバクの精霊で魔法を使う🪄僕自身は足技で悪魔退治をしている。\nチャームポイント：まろ眉とオッドアイ\n(キャラの右目紫、左ピンク。わかりやすくしてくださると嬉しいです）\n\n【使用用途】\nXを含むSNSでの利用/動画・配信内、サムネイルで使用/FANBOX等\n\n【お願い】\n人物と小物を分けたPSDデータや透過されたデータでお願いしたいです。また、ポーズや髪型が上右左見切れていないように描いていただけますと幸いです。デデチ様のサインやメッセージもいただけますと飛んで喜んじゃいます💕\n\nご縁がありますように…\n神那レイア\n\nhttps://drive.google.com/drive/folders/1-EJnRN66efXkNFudK7-olbOVFQW6Mdg9", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@dedechi_skeb/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3363091, "client_id": 2609658, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e352b12/uploads/origins/188c1d5d-0966-4eac-8f22-e47335c3774f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a465c5609cdb96e0444901ea5374591", "srcset": "https://si.imgix.net/6e352b12/uploads/origins/188c1d5d-0966-4eac-8f22-e47335c3774f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a465c5609cdb96e0444901ea5374591, https://si.imgix.net/6e352b12/uploads/o