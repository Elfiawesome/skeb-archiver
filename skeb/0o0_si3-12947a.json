ごせているか気にかけてくれます。また、絡繰に似合いそうなものを見つけたら買ってきて絡繰にプレゼントしてくれます。\n\n関係性\nシナリオ通過前は、絡繰は祝を兄のように慕っていたが、四季送りや他の継続シナリオを通過するなかでそれが恋心であると気づき、今はお付き合いをしています。どちらもお互いのことを大切にしており、何処に行くにも一緒に出掛けます。\n\nビジュアルや服装などは以下のURLに参考資料として立ち絵をまとめています。\n（立ち絵は作者様に参考資料として利用する許可を得て掲載しています）\nhttps://drive.google.com/drive/folders/1fbOUHmsgKEECwqGGM0sPQVNzjEBz6fJK?usp=sharing\n---------------------------------------\n構図やシチュエーション、ポーズ等は好きにしていただいて構いません。\n内容や金額が合わない場合は、キャンセルまたは再送要請等をお願いいたします。長文失礼いたしました。\n\nお忙しいところ恐縮ですが、何卒よろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1fbOUHmsgKEECwqGGM0sPQVNzjEBz6fJK?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0o0_si3/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3847416, "client_id": 300145, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f8da4977/uploads/origins/8c3e6b60-3e38-4508-ae5e-de9c6dec6274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd2c1bca2878d134e3c6486d7c979be4", "srcset": "https://si.imgix.net/f8da4977/uploads/origins/8c3e6b60-3e38-4508-ae5e-de9c6dec6274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd2c1bca2878d134e3c6486d7c979be4, https://si.imgix.net/f8da4977/uploads/origins/8c3e6b60-3e38-4508-ae5e-de9c6dec6274?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1864d3abdc7c118b4a1ea20f841a312c 2x, https://si.imgix.net/f8da4977/uploads/origins/8c3e6b60-3e38-4508-ae5e-de9c6dec6274?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b0fc727cf41af786d0a0a8418187cbb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8da4977/uploads/origins/8c3e6b60-3e38-4508-ae5e-de9c6dec6274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6be1f5713d6e2dfc999f60477cf63aa1", "srcset": "https://si.im