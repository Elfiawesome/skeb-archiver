しいところ恐縮ですが、何卒よろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1fwrWn6LMduNMXfqIRO7UUZ3D6EH7TF8o?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 3349138, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "咲雨(ささめ)", "screen_name": "Secret_ssm3", "avatar_url": "https://pbs.twimg.com/profile_images/2053301884543533056/oTSXXj0K.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 3448413, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "電波障害さん", "screen_name": "denpawarukunai4", "avatar_url": "https://pbs.twimg.com/profile_images/1860612615376150528/gkBA9boF.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 0}, {"id": 3567993, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "海広🌊", "screen_name": "KoshiITA_Okina", "avatar_url": "https://pbs.twimg.com/profile_images/1909142976779186176/DJcMeKYa.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1577852161496879105/1775901034/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 8, "complete_expiration_days": 40, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 3647123, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "氷乃 