c84-8829-de57cc7d0c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f7c4ec9f08b05d58cb1ef8ccf9aab59, https://si.imgix.net/b0448073/uploads/origins/b809f8e7-eadf-4c84-8829-de57cc7d0c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=73fef4c1f93212cc75b0db3291c129af 2x, https://si.imgix.net/b0448073/uploads/origins/b809f8e7-eadf-4c84-8829-de57cc7d0c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7a1f4a2d3fac2a6e6a7ecb97f82fc49e 3x"}, "body": "フィービー、カルテシア（フルールデリス形態）、オーガスタ、ザニは戦いの準備を整える。しかし、彼女たちは敗北し、部分的に石化してしまった。（胸と陰部は石化していない）フィービーは現在も部分的に石化しつつある最中だ。彼女の表情は絶望に満ちている。他の者たちの表情は、驚き、衝撃、あるいは無表情のいずれかである。\nそれが終わると、敵は呪文を唱え、彼女たちの石化した部分を操る。（顔はそのままのままである。）彼は彼女たちに客への奉仕を強要し、手コキ、パイズリ、授乳、騎乗位などの行為をさせる。\n夜になると、彼は彼女たちを床に4本のディルドが固定された部屋へ連れて行く。彼は彼女たちに、新しい客がサービスを受けに来る時だけ休憩し、それ以外は休みなくディルドを犯し続けるよう命じる。最後に、彼は彼女たちに自分の手で自分の頭をちぎるよう命じる。最後のカットは、彼女たちがディルドを犯している様子で、両手で首から切り離された自分の頭を高く掲げている。\n少女たちの心の内を描写すること", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AOBAkinka/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3847367, "client_id": 333632, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e18819e0/uploads/origins/b6d4ac28-39db-41bd-a60a-e4bd605c3d14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3102cf1558d77c99f0fbcb3b086fbbc0", "srcset": "https://si.imgix.net/e18819e0/uploads/origins/b6d4ac28-39db-41bd-a60a-e4bd605c3d14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3102cf1558d77c99f0fbcb3b086fbbc0, https://si.imgix.net/e18819e0/uploads/origins/b6d4ac28-39db-41bd-a60a-e4bd605c3d14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=81e3d7afc7cbc2b440cf9f703a1985a1 2x, https://si.imgix.net/e18819e0/uploads/origins/b6d4ac28-39db-41bd-a60a-e4bd605c3d14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=94cc3f1a84d48b550b6eaae463d4964b 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e18819e0/uploads/origins/b6d4ac28-39db-41bd-a60a-e4bd605c3d14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ebd1ff0bf190469e3ece833754dc64e1", "srcset": "https://si.imgix.net/e18819e0/uploads/origins/b6d4ac28-39db-41bd-a60a-e4bd605c3d14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ebd1ff0bf190469e3ece833754dc64e1, https://si.imgix.net/e18819e0/uploads/origins/b6d4ac28-39db-41bd-a60a-e4bd605c3d14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=930987632eb28d33f6cd19812b98bd7d 2x, https://si.imgix.net/e18819e0/uploads/origins/b6d4ac28-39db-41bd-a60a-e4bd605c3d14?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c9a01435bb4b6a4d8768d40581d8a393 3x"}, "body": "おはようございます。100の人と申します。\n固めタグでお見かけしまして、ちょうど手数料無料キャンペーン中なのでさっそくリクエストさせてもらいます。\n\nちょっと複雑な内容になるのですが、\n\n①うちの子「100の人」(♂・末尾資料参照) と、100の人を消そうと付け狙っていた幼い女性の精神が入れ替わってしまう\n　• 女性のデザインはおまかせ (版権キャラなどでも良い)\n②100の人 (中身女性) は、女性 (中身100の人) を石化する\n　• 石像の目の部分は、瞳がある (黒目と白目の境界がある) タイプで\n③100の人と付き合っている男性 (以降、男性) が、100の人 (中身女性) と石像化女性 (中身100の人) を見つけ、入れ替わりを知らぬまま石像化女性 (中身100の人) をバラバラにする\n　• 男性のデザインもおまかせで、モブ顔や、始終見切れていても良い\n④100の人 (中身女性) は男性を誘い、石像化女性 (中身100の人) の腰部分を拾い上げ、100の人 (中身女性) が膣側から、男性が子宮側から挿入して、中で兜合わせ\n　• 石像化女性 (中身100の人) へ見せつけるように、石像の頭部の真上で行為に及んでおり、2人の溢れ精液が石像の顔にかかっている\n　• 石像の腰部分ではなく頭部で兜合わせでも良い、あるいは石像を使わずにところてん (その場合は100の人 (中身女性) が前で) でも\n\nという感じの流れを描いてもらえないでしょうか……？\n\n可能であれば、石像化女性の中身の100の人の感情を表すコマで、\n• 100の人のポーズや向きは、石像と同じに\n• 100の人の表情は、石像と同じ表情にして、肉体だけ操られて表情固定のままイキ狂っている\nという感じにして欲しいです。\n\n細かく書きましたが、内容は適宜省略したり変えてもらったりしてかまいません。\n金額不足等何かあれば再送要請してください。\nご検討よろしくお願いします。\n\n\n【100の人についての資料】\n\n■立ち絵・設定\n\n↓の右側 (ヒト型)\nhttps://www.pixiv.net/artworks/128487854\n\n■額の宝石やしっぽ部分の3Dモデル　※しっぽの文字は省略してもらってもかまいません\n\nhttps://virtualcast.jp/items/acacf505a4d84111c58ade19a42772c3851e0083db9e12b3ab79ae6bb019977a", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AOBAkinka/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3847367, "client_id": 875400, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b9cbcba3/uploads/origins/ac092267-a8ee-4a78-a993-976cca431571?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01a3fa4cf64aa9168d4fec603c1ec2df", "srcset": "https://si.imgix.net/b9cbcba3/uploads/origins/ac092267-a8ee-4a78-a993-976cca431571?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01a3fa4cf64aa9168d4fec603c1ec2df, https://si.imgix.net/b9cbcba3/uploads/origins/ac092267-a8ee-4a78-a993-976cca431571?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=79762b552ecf8394528e070121356915 2x, https://si.imgix.net/b9cbcba3/uploads/origins/ac092267-a8ee-4a78-a993-976cca431571?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9cf8e25579e23b2b409accb7c84e64b 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b9cbcba3/uploads/origins/ac092267-a8ee-4a78-a993-976cca431571?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f0ff2b72867923071f09802242f8de1", "srcset": "https://si.imgix.net/b9cbcba3/uploads/origins/ac092267-a8ee-4a78-a993-976cca431571?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f0ff2b72867923071f09802242f8de1, https://si.imgix.net/b9cbcba3/uploads/origins/ac092267-a8ee-4a78-a993-976cca431571?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2f8aa47b30c894b294d64eb704ed1bd6 2x, https://si.imgix.net/b9cbcba3/uploads/origins/ac092267-a8ee-4a78-a993-976cca431571?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=10699410206af6a8b0b93aeff161f047 3x"}, "body": "FGOのオルガ・マリー（パート2以降）とマシュが、カルデア本部で不審な男と遭遇する。尋問中、男は自身の「呪文」を披露した。彼はそれを使って、二人の体を真っ直ぐな姿勢に固定した。（顔は動かせるし、多少の抵抗は可能だ。）二人の服を脱がせると、彼は絶え間なく絶頂に達するよう命じた。 二人の体には子宮のタトゥーが現れ、数秒ごとにそれが光り、強烈な快感を呼び起こす。その快感により、愛液と母乳が噴き出す。しばらく二人がもがく様子を眺めた後、彼は最後のコマンドスペルを使い、胸と股間を除く全身を石化させる。二人の顔はアヘ顔のまま固まってしまう。 彼女たちの哀れな姿を眺めた後、見知らぬ男は彼女たちの首を刎ねることにした。これにより、彼女たちが元に戻ることは二度とない。最後のシーンは、首が刎ねられ、その首が近くに転がっている彼女たちの全身像となる。子宮のタトゥーは、彼女たちを永遠に絶頂へと追い込み続ける。", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AOBAkinka/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ca8fe180/uploads/origins/1bc4a415-ae91-4a02-98c6-9a02585bb194?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f8b2dbcfea34cde8a43eedd0b8badd5f", "srcset": "https://si.imgix.net/ca8fe180/uploads/origins/1bc4a415-ae91-4a02-98c6-9a02585bb194?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f8b2dbcfea34cde8a43eedd0b8badd5f, https://si.imgix.net/ca8fe180/uploads/origins/1bc4a415-ae91-4a02-98c6-9a02585bb194?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=23e1f0f6b0f5898141a8b9f7d32b2726 2x, https://si.imgix.net/ca8fe180/uploads/origins/1bc4a415-ae91-4a02-98c6-9a02585bb194?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bb14d5642530722534567f8cd18bcef1 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3847367, "client_id": 3863265, "nc": 177}, {"path": "/@AOBAkinka/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3847367, "client_id": 875400, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6fd328ac/uploads/origins/6569a46b-150d-4a33-af11-de414034d93d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4092f9061eab900fba6a99bc4b164292", "srcset": "https://si.imgix.net/6fd328ac/uploads/origins/6569a46b-150d-4a33-af11-de414034d93d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4092f9061eab900fba6a99bc4b164292, https://si.imgix.net/6fd328ac/uploads/origins/6569a46b-150d-4a33-af11-de414034d93d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6807ffe8440ad0a62f2d9e8993eb524d 2x, https://si.imgix.net/6fd328ac/uploads/origins/6569a46b-150d-4a33-af11-de414034d93d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=555ecd1e69d1bcc63e0d467cb301506d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6fd328ac/uploads/origins/6569a46b-150d-4a33-af11-de414034d93d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6945f07a7d2091febffe9acd1307e96", "srcset": "https://si.imgix.net/6fd328ac/uploads/origins/6569a46b-150d-4a33-af11-de414034d93d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c6945f07a7d2091febffe9acd1307e96, https://si.imgix.net/6fd328ac/uploads/origins/6569a46b-150d-4a33-af11-de414034d93d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=359f5717833bf5b16693de4a8037c16d 2x, https://si.imgix.net/6fd328ac/uploads/origins/6569a46b-150d-4a33-af11-de414034d93d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=93da93dc06b884436c1faa6b7d021259 3x"}, "body": "こんにちは。『ゼンレスゾーンゼロ』のニコ・デマラを石化させたシチュエーションを希望します。\n\nニコは借金の返済ができず、ヤクザに捕まってしまいます。ヤクザは、1ヶ月間石像になれば借金を帳消しにしてやると持ちかけます。他に選択肢のないニコは、その仕事を引き受けました。依頼人の要望通り、彼女は両手を広げて開脚したポーズをとらされ、石化させられます。\n\nしかし、ヤクザたちは彼女を依頼主に引き渡す前に、少し遊んでみることにした。彼らは彼女の石化した服を引き裂き、胸と股間だけ石化を解いた。そして、彼女が絶頂に達して潮を吹くまで、彼女を弄り、指で刺激した。その後、彼らは交代で彼女を貫き、激しく突き、何度も中に出した。残念ながら、最後の男の最後の突きが激しすぎたため、誤ってニコを後ろに倒してしまった。 その衝撃で、彼女の頭は首の付け根からきれいに折れてしまった。ヤクザたちは、もう彼女を客に貸し出せなくなったと嘆く一方、意識のあるままのニコールは絶望に陥っていた。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AOBAkinka/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/55d4149f/uploads/origins/4c5c7e47-921b-4e35-a80c-6b4b3543409e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=949b08257dce1a8ef323f19c98d02085", "srcset": "https://si.imgix.net/55d4149f/uploads/origins/4c5c7e47-921b-4e35-a80c-6b4b3543409e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=949b08257dce1a8ef323f19c98d02085, https://si.imgix.net/55d4149f/uploads/origins/4c5c7e47-921b-4e35-a80c-6b4b3543409e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4ac7110ba6c48188efd5b9e99310c204 2x, https://si.imgix.net/55d4149f/uploads/origins/4c5c7e47-921b-4e35-a80c-6b4b3543409e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=906a7f05e3da63b06d94ae27e58dcc58 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 3847367, "nc": 48}, {"path": "/@AOBAkinka/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3847367, "client_id": 875400, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.