ds/origins/e76404f4-240a-4830-8649-792732dbc66b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=066c31dc9a299c0ec48ac0f0037702b7 3x"}, "body": "初めまして！ もし可能であれば、以下の内容でリクエストさせていただきたいです！ \nご覧いただきありがとうございます！ \n\n下記はイメージになります。\n実際は描きやすさを優先していただいて構いません！\n\n 【キャラクター】\n ダーヤ(トリッカル)の通常衣装 \n\n【構図】\n 事後にダーヤが自分でマングリ返ししているところを教主が両手でくぱぁする構図。教主は腕のみ描写して欲しいです。 表情はこちらを参考にお願いします。 https://drive.google.com/drive/folders/17dCc-8yRtqP7NsdVu3l3xygsdJo6-pth\n\n【服装】 \n服ありと全裸で切り替え可能だと嬉しいです(もし難しければ着衣のみでお願いします) \n\n【備考】 可能であれば性器の不明瞭処理は黒線でお願いします。 \n精液は表示の切り替えができると助かります！ \n\n注文がややこしくて恐縮ですが、それ以外の構図や細かなデザインはおまかせいたします。 \n何卒ご検討よろしくお願いいたします！", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@onpa_drawing/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3992608, "client_id": 3806890, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/86953682/uploads/origins/092c8c04-79c6-4d82-ac91-716a9f527bfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=660d1d2e0ec17e0954cf5fcd6f8915ff", "srcset": "https://si.imgix.net/86953682/uploads/origins/092c8c04-79c6-4d82-ac91-716a9f527bfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=660d1d2e0ec17e0954cf5fcd6f8915ff, https://si.imgix.net/86953682/uploads/origins/092c8c04-79c6-4d82-ac91-716a9f527bfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6a9fc8fc2407921f653b67ff880005d 2x, https://si.imgix.net/86953682/uploads/origins/092c8c04-79c6-4d82-ac91-716a9f527bfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df870b3eca5eea25ef887865ab17966c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/86953682/uploads/origins/092c8c04-79c6-4d82-ac91-716a9f527bfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81b92cc1fbbf2821b2c0d01ec0fd72c6", "srcset": "https://si.imgix.net/86953682/uploads/origins/092c8c04-79c6-4d82-ac91-716a9f527bfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81b92cc1fbbf2821b2c0d01ec0fd72c6, https://si.imgix.net/86953682/uploads/origins/092c8c04-79c6-4d82-ac91-716a9f527bfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ae6d82c08a988dc9e6af799a49c87d22 2x, https://si.imgix.net/86953682/uploads/origins/092c8c04-79c6-4d82-ac91-716a9f527bfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=138e23b4b90cd33e58b1fe1c84f37fdb 3x"}, "body": "はじめまして！pixivのイラストいつも楽しみにさせて頂いてます！skeb始めていたのを見てめっちゃテンション上がってます！\nイラストなんですが、ロリ巨乳のヨミと教主のイチャラブえっちをお願いしたいです！\n服は通常衣装の巫女服で、えっちしてる時は服を着たまま胸は脇から両方溢れていて、スカートは大きく捲ってまんこが見える状態でお願いします！\nヨミの胸の大きさは以前描かれていたマリーくらいの大きさでお願いします！\nもし出来るなら擬音や効果音、セリフ入れて頂きたいです！\n①右上に発情したヨミ\n「教主様が望むなら胸を大きくせねばなりません❤️」\n②左上フェラでしゃぶり射精されている\n教主の心読む力（沢山教主様の子種が出てます❤️）\n\n③右下騎乗位でオナホのように使われて、片手で胸を揉んで乳首触ってる。\n\n④喘ぎながら腰をガッツリ掴まれ犯されて射精\n断面図とまんこが見えるポーズで沢山出されてイキまくる。膣が浅いのでまんこからめっちゃ溢れている。\n「月様❤️愛していますぅ❤️❤️」\n\n⑤次のページ\n事後で全裸\n教主が頭を撫でながらほっぺに擦りつけて顔射\n「月様が満足されたなら私も嬉しいです❤️お慕いしております❤️私の教主様❤️」\n\nセリフ入りそうなら入れて頂けると嬉しいです！長い内容になってしまってすいません！受けて頂ければ嬉しいです！", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 63535, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "H'（えいちだっしゅ）🔞", "screen_name": "zeke_hdash", "avatar_url": "https://pbs.twimg.com/profile_images/1380643864814309379/qZx7BBDO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1918909754/1771239892/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, 