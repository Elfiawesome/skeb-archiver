%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45548d99e424b42c7e0b6f7cc97911aa, https://si.imgix.net/82927613/uploads/origins/1b45a0e6-51c7-4af0-875d-45be6b78ae10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=42bf54bade10cb91853d263f2f62cd54 2x, https://si.imgix.net/82927613/uploads/origins/1b45a0e6-51c7-4af0-875d-45be6b78ae10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aac33d60f7379fdda72d3edbbf588241 3x"}, "body": "こんにちは！柚原の画風が大好きです! 私のVTuberを描いてください！\n\nキャラクターシート： https://imgur.com/a/m3aM2hp\n\n彼女はライオンのvtuberです! 彼女は騎士であり、王女である。カリスマ性があり、気取り屋だが、シャイでもあります。 チャームポイントは左胸上部のビューティマーク ^^\n\nこのコーディネートのテーマは「コギャル」です!\n\nこれらは私が考えていたポーズの参考資料ですが、最終的なポーズや背景については、あなたにお任せします:\nhttps://imgur.com/a/DBLY3uU\nもし可能でしたら、全身のポーズをお願いしたいです!\n\n＊なるべく文字のレイヤーを分けてください\n※イラストはSNSへの掲載・YouTube&Twitch配信サムネイルでの利用を考えています。\n\nありがとうございます！\n\nhttps://imgur.com/a/m3aM2hp", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuzu8ra/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4079105, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d3854dfa/uploads/origins/52df47f6-d094-45d8-8419-f57fdb6ef4d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b50ef216e81672a9c55a1891ebc8797d", "srcset": "https://si.imgix.net/d3854dfa/uploads/origins/52df47f6-d094-45d8-8419-f57fdb6ef4d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b50ef216e81672a9c55a1891ebc8797d, https://si.imgix.net/d3854dfa/uploads/origins/52df47f6-d094-45d8-8419-f57fdb6ef4d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=25395f1033842ca0afe2b4c7d3266406 2x, https://si.imgix.net/d3854dfa/uploads/origins/52df47f6-d094-45d8-8419-f57fdb6ef4d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=13c81644f36d0b0b99036a1d42bb6dbe 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d3854dfa/uploads/origins/52df47f6-d094-45d8-8419-f57fdb6ef4d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7084874eb016119ea7163d5db9bcb175", "srcset": "https://si.imgix.net/d3854dfa/uploads/origins/52df47f6-d094-45d8-8419-f57fdb6ef4d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7084874eb016119ea7163d5db9bcb175, https://si.imgix.net/d3854dfa/uploads/origins/52df47f6-d094-45d8-8419-f57fdb6ef4d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3e2cf034bd9973a78b949f7837d2c556 2x, https://si.imgix.net/d3854dfa/uploads/origins/52df47f6-d094-45d8-8419-f57fdb6ef4d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fe79d46ba45b86fcc3731edfdac114ad 3x"}, "body": "前回は最高に可愛いなずぴを描いて下さりありがとうございました！また新たなリクエストをさせて頂きます。\n\n【依頼内容】\nぶいすぽっ！所属の花芽なずなさんのバニー姿を描いていただきたいです。\n\n【衣装】\n衣装は以前描いてたバニーの日のひなーの作品みたいに背中がぐっと開かせたバニー姿＋うさみみ髪飾り、透け黒/白透けニーソを希望します。今回の髪型はツインテールでお願いします。\n\n■参考イラスト1：\nhttps://skeb.jp/@daihu9san/works/287\n参考イラスト2：https://www.pixiv.net/artworks/123315821\n\n【構図】\n参考イラスト1のようにテーブルの上に座り、振り向いて背を見せムチっとしたふとももとお尻が強調されるの構図で、片手でお尻に食い込んだスーツを直している。（背中がしっかり見えるように、反対側の右手でお願いします。）\n\nアングルは参考イラスト2を参考にして、背中やお尻を強調しつつ、身体をややひねり気味で横乳も強調してほしいです。\n胸のサイズは前回より少し控えめでお願いします。\n背景はバーやカジノなどの場所でお願いします。\n表情はカメラ目線で恥ずかしがっている表情と、片目ウインク、舌を出した挑発的な微笑差分お願いします！\n背景はバーやカジノなどの場所でお願いします。\n\n【使用用途】\n個人としては個人観賞用になりますが、本人様がYouTube等の配信または動画のサムネイルなどへ利用する可能性がありますので、配信活動への利用を許諾の上での作成をお願い致します。\n\nご検討のほどよろしくお願いいたします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuzu8ra/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4079105, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a533423/uploads/origins/d240