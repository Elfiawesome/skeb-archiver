net/496f65c2/uploads/origins/a6dff7cd-180b-4157-9123-a182b8231d12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bcce56724d450809ac3ecadf394cda2, https://si.imgix.net/496f65c2/uploads/origins/a6dff7cd-180b-4157-9123-a182b8231d12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d323657616d2f684a9c49e9349695668 2x, https://si.imgix.net/496f65c2/uploads/origins/a6dff7cd-180b-4157-9123-a182b8231d12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa08a3531fa544c790720ba3a886771b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/496f65c2/uploads/origins/a6dff7cd-180b-4157-9123-a182b8231d12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1bb885d3c5a8e012078317fc2a3ab950", "srcset": "https://si.imgix.net/496f65c2/uploads/origins/a6dff7cd-180b-4157-9123-a182b8231d12?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1bb885d3c5a8e012078317fc2a3ab950, https://si.imgix.net/496f65c2/uploads/origins/a6dff7cd-180b-4157-9123-a182b8231d12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5676efef681ab432e052b945e3972f61 2x, https://si.imgix.net/496f65c2/uploads/origins/a6dff7cd-180b-4157-9123-a182b8231d12?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7316fdb3cf4a1504f454a81f83548581 3x"}, "body": "柚原様\nこの度はフォロワー1000人突破＆Skeb開設おめでとうございます！\nいつも大変かわいくて、綺麗で、見惚れてしまうような素敵なイラストご拝見しております、行人です。\n是非柚原様にイラストをお願いしたく、リクエストをお送りさせていただきます。\n\n今回リクエストさせていただきますのは、ぶいすぽっ！所属の橘ひなのさんです。\n柚原様が描くひなーのがとっても大好きで、是非描いていただきたく存じます。\n\n⬛︎キャラクター・衣装\n橘ひなの\n2026/4/24お披露目の制服衣装\n・髪型は盛り髪ポニテ\n・カーディガン、眼鏡、ブレザーは無し\n\n⬛︎構図・ポーズ・背景\nポーズは脚、太もも、そしてレッグウォーマーがしっかり見えるポーズでお願いいたします。\n表情・背景はお任せいたします。\nレッグウォーマーがしっかり見えるように描画範囲は脚先までを希望いたします。\nもし難しい点などありましたら、描きやすい形にご調整いただいて問題ありません。\n柚原様の癖やお好きなものを詰め込んだかわいくて、魅力的な構図・見せ方で描いていただければ嬉しいです。\n\n⬛︎使用用途\nTwitter（現X）、Discord、Bluesky、Instagram、LINEなどのアイコンやヘッダー、スマホとPCの壁紙など、個人使用を予定\n（SNSのアイコン、ヘッダーへの使用時にはプロフィール欄にクレジット表記させていただきます）\n\n■差分\n可能であれば、カーディガン腰巻き、眼鏡ありの差分も描いていただけると嬉しいです。\n\n■その他\nアイコンにも使用する為、バストアップのイラストもお願いいたします。\n文字・キャラクター・背景等をそれぞれレイヤー分けされたPSDファイルで頂ければ幸いです。\n\n以上となります。\nリクエストの希望内容が多くなっており、お忙しいところ大変恐縮ではございますが、何卒ご検討をよろしくお願いいたします！\nとびっきりかわいく描いていただけるのを心から楽しみにしております♡✨\nもし金額が不足していれば、金額指定での再送依頼をしていただけると幸いです。\n\n参考資料\n橘ひなの制服衣装：https://x.com/hinano_tachiba7/status/2047655604202946919\nお披露目配信：https://www.youtube.com/watch?v=y9GTrRGi8Pc", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2639993, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": ".", "screen_name": "c4gHJ8dtBb", "avatar_url": "https://pbs.twimg.com/profile_images/1971880360234618880/Z0VttaWf.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1470803739120660481/1758967906/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 80, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 2668782, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "隼海ひすい🐏🪽", "screen_name": "HayamiHisui", "avatar_url": "https://pbs.twimg.com/profile_images/2038991276780187648/eMsCQOZG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/953166019/1758934062/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}, {"genre": "voice"}], "banned": false, "nc": 144}, {"id": 3019801, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "MINUI / みぬい", "screen_name": "minui_7", "avata