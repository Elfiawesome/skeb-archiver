なります。\nリクエストの希望内容が多くなっており、お忙しいところ大変恐縮ではございますが、何卒ご検討をよろしくお願いいたします！\nとびっきりかわいく描いていただけるのを心から楽しみにしております♡✨\nもし金額が不足していれば、金額指定での再送依頼をしていただけると幸いです。\n\n参考資料\n橘ひなの制服衣装：https://x.com/hinano_tachiba7/status/2047655604202946919\nお披露目配信：https://www.youtube.com/watch?v=y9GTrRGi8Pc", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 849490, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🐟", "screen_name": "admmdk", "avatar_url": "https://pbs.twimg.com/profile_images/1615323101377736707/Gukb5aSM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1297642734983864320/1693795979/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 1940952, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "うさの🐰skeb募集中", "screen_name": "usn_yn5813", "avatar_url": "https://pbs.twimg.com/profile_images/1537631502066155522/Lkz0XsyK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/945318467820953600/1646513209/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 70, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 1995919, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "七色ないろ", "screen_name": "716", "avatar_url": "https://pbs.twimg.com/profile_images/1074289254556098561/9Bhzkssu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1066303897038245888/1703390471/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "de