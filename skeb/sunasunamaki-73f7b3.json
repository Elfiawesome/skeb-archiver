のイラストがとてもよく見えて、あんな風に躍動感の溢れる元気なイラストだと嬉しいです。\n上記はあくまで希望のイメージの話で、描きやすいように自由に描いて頂ければと思います。参考に夏の装いのくろがねをあげておきますが、構図やラッピングもこれに限らず自由にお任せいたします。\n\nもし引き受けて頂ける場合も、急ぎませんので、他の依頼ややりたいことを優先して頂いて、無理なく楽しく描ける範囲でお願いしたいです。\n\n以上、宜しくご検討下さい。\n\nhttps://twitter.com/vgloTDcrhxRn5B2/status/1666901952352100352?t=UsOG3WdnjKW0bn24vyrXKQ&s=19", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sunasunamaki/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2506339, "client_id": 1285089, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5487c677/uploads/origins/78b32967-6a05-4bb0-a075-fd0edc464283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5ff26fd463338921885403c3700c785", "srcset": "https://si.imgix.net/5487c677/uploads/origins/78b32967-6a05-4bb0-a075-fd0edc464283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5ff26fd463338921885403c3700c785, https://si.imgix.net/5487c677/uploads/origins/78b32967-6a05-4bb0-a075-fd0edc464283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f289d4f2acd3c92b062e8bdab304febb 2x, https://si.imgix.net/5487c677/uploads/origins/78b32967-6a05-4bb0-a075-fd0edc464283?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e6beff6c04333d8de669f114dd2781fa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5487c677/uploads/origins/78b32967-6a05-4bb0-a075-fd0edc464283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b599fb28a01d70a2b744055bb44ec18", "srcset": "https://si.imgix.net/5487c677/uploads/origins/78b32967-6a05-4bb0-a075-fd0edc464283?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b599fb28a01d70a2b744055bb44ec18, https://si.imgix.net/5487c677/uploads/origins/78b32967-6a05-4bb0-a075-fd0e