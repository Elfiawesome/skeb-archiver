9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d5ae97a9fc1090f27e3b0aae0973d63 2x, https://si.imgix.net/62712ac9/uploads/origins/bb54cac6-5fd8-4782-8f9e-18ecc482f39a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a6a636405faed58426baa6aba9d58d0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62712ac9/uploads/origins/bb54cac6-5fd8-4782-8f9e-18ecc482f39a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c51d9007d983d74734c576e092e987c1", "srcset": "https://si.imgix.net/62712ac9/uploads/origins/bb54cac6-5fd8-4782-8f9e-18ecc482f39a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c51d9007d983d74734c576e092e987c1, https://si.imgix.net/62712ac9/uploads/origins/bb54cac6-5fd8-4782-8f9e-18ecc482f39a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ce48338558f5d1b72213826dc4c2233f 2x, https://si.imgix.net/62712ac9/uploads/origins/bb54cac6-5fd8-4782-8f9e-18ecc482f39a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=28ff0dc599017f60afa1f1dffeccb69a 3x"}, "body": "はじめまして。\nいつもイラストやツイート拝見させて頂いてます。\n今回ドラクエ10の自キャライラストをリクエストさせて頂きます。\n\nキャラシートと自作イラスト、ゲーム内画像をURLからご確認お願いします。\n\n衣装はバトルマスターなどで使っている、スクショ画像を載せてるの方のドレア（舞い手の服、魔法使いのズボン、はがねのグリーブ）でお願いします。\n\nイラストや写真のようにブラックやレッドなどでカラーリングしてます。\n口紅とネイルはオーロラ。\n髪型はゲーム内とはだいぶアレンジして描いているので、自作イラスト準拠な感じでお願いします。\n目ヂカラ強め。声のイメージは坂本真綾さんです。\n\n構図などおまかせしますが出来ればある程度ポーズまで見える感じで描いて頂けるとうれしいです。\n武器を持つ場合はロトの剣か天空の剣希望です。\n盾を持たせる場合はアリアハンの盾ノーマルカラーになります。\n\nよろしくお願い致します。\n\nhttps://note.com/harumatoki/n/n4877f4296e95?sub_rt=share_pw", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mtr_310/works/94", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 80177, "client_id": 2206121, "vtt_url