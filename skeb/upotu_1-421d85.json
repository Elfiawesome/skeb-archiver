n○使用用途\n個人鑑賞\n\n説明に不足等ありましたら申し訳ありません。 ご検討の程宜しくお願い致します。\n\n\nhttps://drive.google.com/drive/folders/1x6ZGCZjnxivlibt6PoGPdNY_xEpxEsky", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1225113, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "nightingale_shi", "screen_name": "nightingale_shi", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2Fwebpublic-4ba95557-42e1-45f4-b69f-52b35f8ed831.webp?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/webpublic-5b8077ed-232c-45cf-899b-6869216e7204.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 16}, {"id": 2485742, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "aston", "screen_name": "ast00000000n", "avatar_url": "https://pbs.twimg.com/profile_images/2029929645009948677/lBVpKrRK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1454097940264357894/1772807774/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 25, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 2690202, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "畔陽@Skeb募集中", "screen_name": "azehi_18", "avatar_url": "https://pbs.twimg.com/profile_images/1855944095077924864/fzwk7i9b.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1294963121476390913/1741863244/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "del