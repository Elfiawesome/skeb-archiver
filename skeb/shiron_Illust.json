fm=webp&fit=crop&crop=top&w=200&h=200&s=3e0332a146dd803345998a0aa25f38ab, https://si.imgix.net/e05d111f/uploads/origins/4396d984-1eea-4de6-9d27-33b05a9cbd3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46783fd78783c867942ddbe93c5fb47e 2x, https://si.imgix.net/e05d111f/uploads/origins/4396d984-1eea-4de6-9d27-33b05a9cbd3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66c34962fa3456b796f448657d9cad89 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e05d111f/uploads/origins/4396d984-1eea-4de6-9d27-33b05a9cbd3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc78d32bddfd124f88231041f2fe92a1", "srcset": "https://si.imgix.net/e05d111f/uploads/origins/4396d984-1eea-4de6-9d27-33b05a9cbd3c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc78d32bddfd124f88231041f2fe92a1, https://si.imgix.net/e05d111f/uploads/origins/4396d984-1eea-4de6-9d27-33b05a9cbd3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2cf503a8899b9af09fd65372766746a9 2x, https://si.imgix.net/e05d111f/uploads/origins/4396d984-1eea-4de6-9d27-33b05a9cbd3c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bfba6341a0ff61ac48b3ca179e923c3b 3x"}, "body": "むに工房様の「LustGrimm Again」より\nねこまた巨大化イベントのIFをお願いします。\n\nシリーズ恒例の貧乳キャラであるねこまたを「大きくしたい」と願ったところ\n胸では無く身体が巨大化してしまいふとももで責められるというイベントになりますが、\n他のプレイが行われるというシチュエーションです。\n\n1：授乳\n小さいけど巨大な乳首に主人公の顔を押し付けて無理矢理授乳\n「くふふ、いつもは飲みきれる量だけど今日はそうはいかないにゃん♪　たくさん飲んでねこまたくらい大きくなるにゃん♪」\n\n2：パイズリ\n全身パイズリをしようとするが、胸のサイズ自体は変わらないのでうまく寄せられず苛立ち、\n主人公を胸に押し付けてごしごしして無理矢理射精させる\n「うにゃあああああ！　これでどうにゃ！　これも立派なパイズリにゃ！」\n\n3：Wパイズリ\n同様に巨大化した二人目のねこまたがやってきて、二人で全身パイズリ。\n「くふふ、全身パイズリ出来るサキュバスなんて……え？　ミニマム魔法とかメガサキュバスとか超乳サキュバスとか割といるにゃって？」（ショックを受けている）\n\n4：母乳風呂\n4つのおっぱいの中心に主人公を入れて母乳を出してお風呂のようにする」\n「くふふ、谷間酒ってやつを一度やってみたかったのにゃん♪」\n\n参考までに本作のイベント絵（通常状態での授乳、パイズリ、巨大化状態）を送付します。\n二人がかりでも谷間作ったりするのが難しければ気持ち大きくしてもかまいません。\n台詞等はざっくりとした案なので、\n作者様がシリーズをプレイ済みなら作者様のイメージに合わせても構いません。\n差分等もお任せします。\n\nhttps://drive.google.com/drive/folders/1fioI22iGQRUUJa5_bt7TATf9VoLqitHT?usp=drive_link", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shiron_Illust/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3384328, "client_id": 854986, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8e07a47/uploads/origins/3f92a4ac-da78-42d9-a3e8-c5828a059ed4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b58fcfef579fa1208a3ce7bb686e1d6d", "srcset": "https://si.imgix.net/b8e07a47/uploads/origins/3f92a4ac-da78-42d9-a3e8-c5828a059ed4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b58fcfef579fa1208a3ce7bb686e1d6d, https://si.imgix.net/b8e07a47/uploads/origins/3f92a4ac-da78-42d9-a3e8-c5828a059ed4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6431be4101d9d95f0725d69be39fa7b 2x, https://si.imgix.net/b8e07a47/uploads/origins/3f92a4ac-da78-42d9-a3e8-c5828a059ed4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b59b6d792db000e6d7b21b11d327f44 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8e07a47/uploads/origins/3f92a4ac-da78-42d9-a3e8-c5828a059ed4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b5428233471637e54ce903dbbe535d3", "srcset": "https://si.imgix.net/b8e07a47/uploads/origins/3f92a4ac-da78-42d9-a3e8-c5828a059ed4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b5428233471637e54ce903dbbe535d3, https://si.imgix.net/b8e07a47/uploads/origins/3f92a4ac-da78-42d9-a3e8-c5828a059ed4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f9ac738aa32d2f5324eac6e94a3ad8b2 2x, https://si.imgix.net/b8e07a47/uploads/origins/3f92a4ac-da78-42d9-a3e8-c5828a059ed4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6ebe8c2bb4f616dabe316c9a703b45e4 3x"}, "body": "初めまして、流れて来たイラストを見かけてリクエスト送らせて貰いました。\n\n鏡の淫魔と悪魔のタネのアイドルサキュバス(アイリ)のリクエストになります。\n主観視点で恋人繋ぎをしながらの(上裸ないし全裸での)ノーハンドパイズリで連続射精させられるイラストを描いていただきたいです。\nご検討よろしくお願い致します。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shiron_Illust/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3384328, "client_id": 129890, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/59b41549/uploads/origins/08a38d2e-baf0-415a-975a-210aa7e4b3b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffe1f61fabfd27429228aaed8770ed04", "srcset": "https://si.imgix.net/59b41549/uploads/origins/08a38d2e-baf0-415a-975a-210aa7e4b3b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffe1f61fabfd27429228aaed8770ed04, https://si.imgix.net/59b41549/uploads/origins/08a38d2e-baf0-415a-975a-210aa7e4b3b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83331a66021884e069bd973d9c5daad1 2x, https://si.imgix.net/59b41549/uploads/origins/08a38d2e-baf0-415a-975a-210aa7e4b3b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8887901406aea625a670aa868d703028 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/59b41549/uploads/origins/08a38d2e-baf0-415a-975a-210aa7e4b3b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3265b0a9577c50a567e9e00ce52d77bb", "srcset": "https://si.imgix.net/59b41549/uploads/origins/08a38d2e-baf0-415a-975a-210aa7e4b3b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3265b0a9577c50a567e9e00ce52d77bb, https://si.imgix.net/59b41549/uploads/origins/08a38d2e-baf0-415a-975a-210aa7e4b3b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4d536e28b10314d2c862436fb902b17f 2x, https://si.imgix.net/59b41549/uploads/origins/08a38d2e-baf0-415a-975a-210aa7e4b3b9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=defbea1aaca08537d958ca5cde6a39ab 3x"}, "body": "こんにちは！\nhttps://www.pixiv.net/artworks/135817781\nこちらのイラストに衝撃を受けたマンです。\n良ければリクエストお願いできないでしょうか………？\nいけたら２枚組でお願いできないでしょうか………？\n\n\n『サキュバス戦記に出てくるミニ・ミラージュの分身ダブルぱふぱふ』\nサキュバス戦記主人公のレイ君がミニ・ミラージュにあひあひ負けちゃうイラスト。\n抵抗しなきゃいけないのに、ぱふぱふでメロメロにされてペニスは太ももコキとかされて負けちゃう。\nおっぱいだけ脱衣で、他は着衣状態でお願いしたく思います。\nミニ・ミラージュは好意高めでレイ君を自分のモノにするために色仕掛けしてるイメージです。\nワガママを言うんですけど、もし可能だったら小窓描写みたいな感じで太ももコキも見られないでしょうか……？\n難しそうでしたら、全然大丈夫です……！\n\n『ミニ・ミラージュの分身ダブルパイズリ』\n続けて動けなくなったレイ君を追撃で搾り取るイラスト。\nおっぱいがむにゅむにゅとたわむ様な感じでズリズリしてくれていると嬉しいとても嬉しいです。\n相変わらずおっぱいだけ脱衣で、他は着衣状態でお願いしたく思います。\nしつこく何度も射精させられて、メロメロに堕とされるイメージです。\n\n\n………みたいなイラスト、お願いできないでしょうか……！？\nもし可能でしたら、何卒よろしくお願い致します……！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shiron_Illust/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3384328, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aeef5ce7/uploads/origins/5e46ab28-eeb6-4bb2-ac1f-e495c3f85002?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04b7ae72e4c24b89e8c9163214636587", "srcset": "https://si.imgix.net/aeef5ce7/uploads/origins/5e46ab28-eeb6-4bb2-ac1f-e495c3f85002?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04b7ae72e4c24b89e8c9163214636587, https://si.imgix.net/aeef5ce7/uploads/origins/5e46ab28-eeb6-4bb2-ac1f-e495c3f85002?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a096c92f54e504154c10982635d743e5 2x, https://si.imgix.net/aeef5ce7/uploads/origins/5e46ab28-eeb6-4bb2-ac1f-e495c3f85002?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b8ade57324f5c3cfa04dd062a274ab6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aeef5ce7/uploads/origins/5e46ab28-eeb6-4bb2-ac1f-e495c3f85002?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7db58f42c4d473f9cfaa4e937b6a7fb8", "srcset": "https://si.imgix.net/aeef5ce7/uploads/origins/5e46ab28-eeb6-4bb2-ac1f-e495c3f85002?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7db58f42c4d473f9cfaa4e937b6a7fb8, https://si.imgix.net/aeef5ce7/uploads/origins/5e46ab28-eeb6-4bb2-ac1f-e495c3f85002?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1d2978a52892fbab4d476af2c8e80e9e 2x, https://si.imgix.net/aeef5ce7/uploads/origins/5e46ab28-eeb6-4bb2-ac1f-e495c3f85002?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=286a2af694e3f338d7967dd3340eba3d 3x"}, "body": "同人ゲーム「鏡の淫魔と悪魔のタネ」から魔法少女みるくちゃん。の全身パイズリイラストをお願いします。\n\nシチュエーションは悪人と勘違いされて小さくされて着衣おっぱい監獄に閉じ込められて回復魔法と合わせて延々全身パイズリされる。\n十数回射精させられた後反省したか聞かれるも息も絶え絶えで何も答えることが出来なかった為、反省したとみなされず全身パイズリが再開される。\nと言う感じでお願いします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shiron_Illust/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3384328, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ae39926/uploads/origins/dd0f0f58-6a04-4857-95f3-4da8c14c250f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fb2d4a55e7b4893338e802d8ee2fe27", "srcset": "https://si.imgix.net/6ae39926/uploads/origins/dd0f0f58-6a04-4857-95f3-4da8c14c250f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4fb2d4a55e7b4893338e802d8ee2fe27, https://si.imgix.net/6ae39926/uploads/origins/dd0f0f58-6a04-4857-95f3-4da8c14c250f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e541a412927981f5434aa152dd541c0 2x, https://si.imgix.net/6ae39926/uploads/origins/dd0f0f58-6a04-4857-95f3-4da8c14c250f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23d0be0965771d5c15f5ad2d49a9265b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ae39926/uploads/origins/dd0f0f58-6a04-4857-95f3-4da8c14c250f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bed4ad611a311bcf407469641880008", "srcset": "https://si.imgix.net/6ae39926/uploads/origins/dd0f0f58-6a04-4857-95f3-4da8c14c250f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bed4ad611a311bcf407469641880008, https://si.imgix.net/6ae39926/uploads/origins/dd0f0f58-6a04-4857-95f3-4da8c14c250f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4ec96a58eaf2c9e7fa6ad9729ecba3de 2x, https://si.imgix.net/6ae39926/uploads/origins/dd0f0f58-6a04-4857-95f3-4da8c14c250f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=edd0a0edba2fc7039a27ed9be6da3b8a 3x"}, "body": "ミッドナイトガールズRのキャラクターを始めとする様々なモンスター娘のイラストに心惹かれたので、リクエスト失礼します。\n\nミッドナイトガールズRのリーニィが、授乳手コキでマゾオスを搾り尽くすイラストをお願いします。\nhttps://midnightgirlsr.wikiru.jp/?%E3%83%AA%E3%83%BC%E3%83%8B%E3%82%A3\nhttps://x.com/midnight_girls_/status/1597972912287272960\n\n以下、シチュエーションです。\n・構図や雰囲気は以前書かれていた資料URLの作品のような感じで、終始丁寧な口調で甘々な雰囲気\n・最初は普通の手コキで責めていたが、途中から「手でするだけでは物足りないですか？」などと言いながら、ボリュームのあるツインテールでペニスを包み込んで髪コキで責め始める。\n・サラサラの髪の感触が気持ち良すぎてすぐに射精してしまうが、リーニィはマゾオスの射精を見たことでスイッチが入り、手の動きを速めたり巻く髪の量を増やしたりして授乳髪コキをエスカレートさせ、マゾオスはリーニィの髪に何度も射精し、大量の精液でドロドロにしてしまう。\n・ようやくリーニィが落ち着いた後、マゾオスはリーニィの髪を汚してしまった事を謝るが、リーニィはそんなマゾオスを優しく労わる。\n\nマゾオスの呼び方は、原作通り「人間さん」でお願いします。\n細かいセリフの内容はそちらにお任せします。\nまた、髪でペニスを包み込む際は、ペニス全体が見えなくなるくらいに大量の髪で包み込んで、髪のサラサラ感や柔らかさが強調されるように描いて頂きたいです。\n\nマニアックな内容で恐縮ですが、以上、よろしくお願いいたします。\n\nhttps://www.pixiv.net/artworks/122749625", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shiron_Illust/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3384328, "client_id": 168140, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/83d4def1/uploads/origins/26a06dc5-d93d-4646-9aff-dd50b2e0dc78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9acf70da2d5781bdc928ded64c1c8ae", "srcset": "https://si.imgix.net/83d4def1/uploads/origins/26a06dc5-d93d-4646-9aff-dd50b2e0dc78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9acf70da2d5781bdc928ded64c1c8ae, https://si.imgix.net/83d4def1/uploads/origins/26a06dc5-d93d-4646-9aff-dd50b2e0dc78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38f483ffe1c80e02c957f234b1b855a4 2x, https://si.imgix.net/83d4def1/uploads/origins/26a06dc5-d93d-4646-9aff-dd50b2e0dc78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ca8c33eee1f2c91c1798d54b1eeb266b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/83d4def1/uploads/origins/26a06dc5-d93d-4646-9aff-dd50b2e0dc78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9181ab6942cd9cc31226099aceb39e0", "srcset": "https://si.imgix.net/83d4def1/uploads/origins/26a06dc5-d93d-4646-9aff-dd50b2e0dc78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9181ab6942cd9cc31226099aceb39e0, https://si.imgix.net/83d4def1/uploads/origins/26a06dc5-d93d-4646-9aff-dd50b2e0dc78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8eb9d24591e68315ad4e462eea6dd768 2x, https://si.imgix.net/83d4def1/uploads/origins/26a06dc5-d93d-4646-9aff-dd50b2e0dc78?bg=%23fff&aut