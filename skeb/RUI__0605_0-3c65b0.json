b\u3066\u5927\u5207\u306b\u611b\u7528\u3055\u305b\u3066\u9802\u3044\u3066\u304a\u308a\u307e\u3059(*\u00b4\u02d8`*)\u2661\n\n\u4eca\u56de\u306fX\u306e\u30d8\u30c3\u30c0\u30fc\u306b\u3057\u305f\u304f\u3001\u30ea\u30af\u30a8\u30b9\u30c8\u3092\u9001\u3089\u305b\u3066\u9802\u304d\u307e\u3057\u305f\u3002\n\u63cf\u5199\u7bc4\u56f2\u3084\u30b5\u30a4\u30ba\u306a\u3069\u304a\u4efb\u305b\u3057\u307e\u3059\u304c\u3001\u51fa\u6765\u308c\u3070\u30d8\u30c3\u30c0\u30fc\u306b\u8a2d\u5b9a\u3067\u304d\u308b\u3088\u3046\u306a\u69cb\u56f3\u3067\u3059\u3068\u3068\u3066\u3082\u3042\u308a\u304c\u305f\u3044\u3067\u3059( \u00a8\u032e )\n\u30c7\u30fc\u30bf\u306f\u53ef\u80fd\u3067\u3042\u308c\u3070\u4eba\u7269\u306e\u307f(\u80cc\u666f\u767dor\u900f\u904e)\u306e\u7269\u3082\u5e0c\u671b\u3067\u3059\u304c\u3001\u96e3\u3057\u3051\u308c\u3070\u5927\u4e08\u592b\u3067\u3059\u3002\n\n\u30d8\u30c3\u30c0\u30fc\u4ee5\u5916\u306b\u3082\u4f7f\u7528\u3067\u304d\u305d\u3046\u3067\u3042\u308c\u3070\u30a2\u30a4\u30b3\u30f3\u3084\u81ea\u5206\u7528\u306e\u30b0\u30c3\u30ba\u3001\u30dd\u30fc\u30c8\u30d5\u30a9\u30ea\u30aa\u306eFA\u6b04\u306b\u4f7f\u7528\u3055\u305b\u3066\u3044\u305f\u3060\u304f\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\n\u30d8\u30c3\u30c0\u30fc\u306b\u8a2d\u5b9a\u3057\u3066\u81ea\u5206\u306e\u65e5\u3005\u306e\u5236\u4f5c\u306e\u30e2\u30c1\u30d9\u30fc\u30b7\u30e7\u30f3\u306b\u3057\u305f\u3044\u3068\u601d\u3063\u3066\u304a\u308a\u307e\u3059( \u00a8\u032e )\uff01\n\n\u53c2\u8003\u8cc7\u6599\u306f\u904e\u53bb\u7d75\u3084\u843d\u66f8\u304d\u306a\u3069\u3057\u304b\u3054\u7528\u610f\u304c\u51fa\u6765\u305a\u8cc7\u6599\u4e0d\u8db3\u3067\u3057\u305f\u3089\u7533\u3057\u8a33\u3042\u308a\u307e\u305b\u3093\u3002\n\u5168\u3066\u305c\u308d\u332b\u69d8\u306e\u304a\u597d\u304d\u306a\u3088\u3046\u306b\u63cf\u3044\u3066\u9802\u3044\u3066\u5927\u4e08\u592b\u3067\u3059\u3002\n\u30c7\u30b6\u30a4\u30f3\u3084\u8272\u5473\u306a\u3069\u305c\u308d\u332b\u69d8\u306e\u4f5c\u98a8\u306b\u5408\u308f\u305b\u3066\u9802\u3051\u308c\u3070\u3068\u304a\u3082\u3044\u307e\u3059\u3002\n\n\u3082\u3057\u3001\u91d1\u984d\u4e0d\u8db3/\u8cc7\u6599\u4e0d\u8db3/\u30b9\u30b1\u30b8\u30e5\u30fc\u30eb\u304c\u5408\u308f\u306a\u3044\u306a\u3069\u304c\u3042\u308a\u307e\u3057\u305f\u3089\u9060\u616e\u305b\u305a\u304a\u65ad\u308a\u3044\u305f\u3060\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u3053\u3056\u3044\u307e\u3059\u3002\n\u304a\u5fd9\u3057\u3044\u4e2d\u3054\u78ba\u8a8d\u304f\u3060\u3055\u308a\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3057\u305f\u3002\n\u3054\u691c\u8a0e\u4f55\u5352\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u3044\u305f\u3057\u307e\u3059\ud83d\ude47\u200d\u2642\ufe0f\n\n\u2508\u2508\u2508\u2508\u2508\u2508\u2508\u2508\u2508\u2508\u2508\u2508\u2508\u2508\u2508\u2508\u2508\u2508\n\u30d9\u30af\u30c8\ud83d\udc0a\ud83c\udf0a\ud83e\udd69BECTO \u8a73\u7d30\n\ufe0e\u2726\ufe0e\u5916\u898b\n\u30fb\u5de6\u76ee\u304c\u8d64\u8272/\u53f3\u76ee\u304c\u30b0\u30ec\u30fc(\u767d\u3067\u3082\ud83d\ude46\u200d\u2640\ufe0f)\n\u30fb\u5de6\u76ee\u306e\u4e0b\u306b\u306f\u30ad\u30ba\u306e\u7e2b\u3044\u76ee\u304c\u3042\u308b(\u8d64\u8272)\n\u30fb\u77b3\u5b54\u306f\u7e26\u9577\n\u30fb\u4e0a\u307e\u3064\u6bdb\u5c11\u306a\u3081/\u4e0b\u307e\u3064\u3052\u306f\u3042\u3063\u3066\u3082\u7121\u304f\u3066\u3082\ud83d\ude46\u200d\u2640\ufe0f\n\u30fb\u524d\u9aea\u306f\u771f\u3093\u4e2d\u3067\u30af\u30ed\u30b9/\u30b5\u30a4\u30c9\u306e\u9aea\u306f\u5916\u30cf\u30cd/\u8033\u5468\u308a\u3068\u8f2a\u90ed\u3042\u305f\u308a\u3092\u96a0\u3059\u3088\u3046\u306b\u9aea\u306e\u6bdb\u3042\u308a\n\u30fb\u5168\u4f53\u306e\u5f62\u306f\u30a6\u30eb\u30d5\u30ab\u30c3\u30c8\n\u30fb\u895f\u8db3\u306f\u5916\u30cf\u30cd\u3067\u9577\u3055\u306f\u80a9\u3042\u305f\u308a\n\u30fb\u6bdb\u8cea\u56fa\u3081\u306e\u8a2d\u5b9a\n\u30fb\u9aea\u578b\u306f\u30cf\u30fc\u30d5\u30a2\u30c3\u30d7\u3067\u3082\u4e0b\u308d\u3057\u3066\u3066\u3082\ud83d\ude46\u200d\u2640\ufe0f\n\u30fb\u8d64\u25b6\ufe0e\u30df\u30f3\u30c8\u30b0\u30ea\u30fc\u30f3\u306e\u9aea\u306