b.jp/@rakuraku_kmczk/works/134\n\nhttps://skeb.jp/@rebasuto102702/works/516\n\nhttps://www.pixiv.net/en/artworks/117125253\n\nhttps://skeb.jp/@notogoro/works/23\nhttps://www.pixiv.net/en/artworks/122785397#manga\n\nhttps://skeb.jp/@chibotakun/works/64", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@difk/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/760580a9/uploads/origins/c5d32d25-d82a-49ae-b248-d604079e4005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bee8d64dd9c0b8bd9b78f8f86f6f6338", "srcset": "https://si.imgix.net/760580a9/uploads/origins/c5d32d25-d82a-49ae-b248-d604079e4005?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bee8d64dd9c0b8bd9b78f8f86f6f6338, https://si.imgix.net/760580a9/uploads/origins/c5d32d25-d82a-49ae-b248-d604079e4005?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5480c05080f702b916f602c67fc41825 2x, https://si.imgix.net/760580a9/uploads/origins/c5d32d25-d82a-49ae-b248-d604079e4005?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9de8b9c761388e89f16d084a2e4c0e51 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3559554, "nc": 34}, {"path": "/@difk/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3559554, "client_id": 71755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9aaf5a16/uploads/origins/2a414b5d-cc46-4af0-9bfd-6cf9e389a9a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=816aa52a5121acbc917eb17ff2a999ff", "srcset": "https://si.imgix.net/9aaf5a16/uploads/origins/2a414b5d-cc46-4af0-9bfd-6cf9e389a9a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=816aa52a5121acbc917eb17ff2a999ff, https://si.imgix.net/9aaf5a16/uploads/origins/2a414b5d-cc46-4af0-9bfd-6cf9e389a9a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34f9a67adb1e278a03d80284722bc902 2x, https://si.imgix.net/9aaf5a16/uploads/origins/2a414b5d-cc46-4af0-9bfd-6cf9e389a9a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e2633937d4313c42425d3a83b234d68d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9aaf5a16/uploads/origins/2a414b5d-cc46-4af0-9bfd-6cf9e389a9a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b906257ee5e9fb6d038751ff54261ab1", "srcset": "https://si.imgix.net/9aaf5a16/uploads/origins/2a414b5d-cc46-4af0-9bfd-6cf9e389a9a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b906257ee5e9fb6d038751ff54261ab1, https://si.imgix.net/9aaf5a16/uploads/origins/2a414b5d-cc46-4af0-9bfd-6cf9e389a9a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=526e911aaf28b347735513c86fa01172 2x, https://si.imgix.net/9aaf5a16/uploads/origins/2a414b5d-cc46-4af0-9bfd-6cf9e389a9a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1d57b01a045d091ee03f798ef4a6fc91 3x"}, "body": "おっぱいが最高だったので可能な範囲でお願いします！\n書くかも程度ですがM向け小説の挿絵に利用したいです\nシチュ：着衣超魔乳+着衣超特大ボテ腹姿のヴリドラ&リナリスにゴミを見る冷めた目(ハイライト無し、顔上部に影有)で嫌悪され見下されるドホイホイシチュ\n二人とも顔の上部や目元まで影がかかりハイライトなし、ドM男への嫌悪MAXを一切隠さない強い侮蔑の表情で、\n全身が粘度の高いどろどろの粘液まみれで衣服が超魔乳やボテ腹にべっとりと張り付き、 片乳だけで両腕でも抱え込めない、頭と胴体を合わせたよりも大きいサイズ&(見えませんがピンク想定の)勃起乳首ありの着衣超魔乳と超特大着衣ボテ腹(妊娠淫紋付)で、超魔乳やボテ腹がデカすぎて衣装を肉に食い込んでいる描写希望です\n\nファイルはpsd形式希望で、粘液まみれの水音(効果音)と瞳のハイライト有無、顔上部に掛かる影の有無差分、可能であれば「変態」「最低」「気持ち悪い」等、蔑むような台詞の有無差分希望で、\n背景は肉壁系もしくはダーク系or禍々しい感じの単色orグラデ背景で、優先度低で精液ぶっかけ差分（可能であればペニスとシコっている最中の手の描写も）希望します\n\nまた優先度低でいいので可能であればどちらか一人でも構いませんが非貫通オナホを持っており、\nオナホは軽く握るだけ指がめり込む程柔らかく内部を圧迫する肉厚ピンクオナホで内部に大量のローションが充満しており、結合部からローションを溢れさせている様子と差分として大量の精液交じりのローションを溢れさせた様子を希望します\nまた可能であれば生物的な要素を持つ肉塊オナホ描写を希望します\n\nキャラ参考：\n\nhttps://drive.google.com/drive/folders/1sWbOWIDDg7ediv6iKOEn7f5K8poREN9r?usp=sharing", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 874852, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "姫仮 倶錬🍺ぐねるChannel🎨🎵", "screen_name": "Mekari_Guneru", "avatar_url": "https://pbs.twimg.com/profile_images/2035722428039749632/Hk74ub17.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1054531014544973826/1774189024/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "voice"}], "banned": false, "nc": 33}, {"id": 1023123, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "yagamiマン", "screen_name": "yagamiTSR", "avatar_url": "https://pbs.twimg.com/profile_images/1516357783914151938/DgE2UAv2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/345652673/1669191467/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 1079381, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ハムマグ＠skeb", "screen_name": "ham121ham", "avatar_url": "https://pbs.twimg.com/profile_images/1962038907941662721/wl35s_zT.jpg", "header_url": "https://pbs.twimg.c