makoto.bsky.social/post/3l7hn5dxfxu2b\n\nヘアスタイルは複数ありますが、お任せでお願いします。\n\n\nその他資料、リットリンク下部\nhttps://lit.link/nekoyoi\n\n\nその他ポーズや構図なども、桜黒かりん様のお任せでお願いします。\n\n\n可能であれば、耳や髪の毛など頭が見切れないよう描いていただけますと嬉しいです。\n\n使用用途は、SNSへの掲載、場合によっては配信や動画のサムネイルなどへの使用です(猫酔くるさん本人[収益化済]の使用も含む)\n\n名前入り・名前無し・名前無し背景透過(PSD)の三種類を希望します\n\nよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakurokarin/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3443086, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65f5873b/uploads/origins/044178c7-1113-40fc-9927-5d848b648c28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53bf8748a4f3d07cd809575b725ba47c", "srcset": "https://si.imgix.net/65f5873b/uploads/origins/044178c7-1113-40fc-9927-5d848b648c28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53bf8748a4f3d07cd809575b725ba47c, https://si.imgix.net/65f5873b/uploads/origins/044178c7-1113-40fc-9927-5d848b648c28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cdd5eca1c4ab5f9ca040e557bea9e41a 2x, https://si.imgix.net/65f5873b/uploads/origins/044178c7-1113-40fc-9927-5d848b648c28?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d38b792d63ce9be015820194b106e7b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/65f5873b/uploads/origins/044178c7-1113-40fc-9927-5d848b648c28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23b03a1c88ecb39729fe14791d8697a7", "srcset": "https://si.imgix.net/65f5873b/uploads/origins/044178c7-1113-40fc-9927-5d848b648c28?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23b03a1c88ecb39729fe14791d8697a7, https://si.imgix.net/65f5873b/uploads/origins/044178c7-1113-40fc-9927-5d848b648c28?bg=%23fff&auto=for