いたします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": []}, "price_history": {"art": [{"amount": 3000, "recorded_at": 1760093946.784567}, {"amount": 8000, "recorded_at": 1771094237.360468}, {"amount": 6000, "recorded_at": 1784377907.896781}]}, "custom": {"from_archive": true}}