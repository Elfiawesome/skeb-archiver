ながら絶頂。\n\n①\n発情期で全体的にじっとりと艶っぽいティナリが、ズボン越しからも分かるパンパンな股間をコレイの太ももに当て、「すまないコレイ、今晩お願いできるかい？」とお願い。\nそれに対してコレイはニコッと笑う。\n\n②ベット上にて\n妖艶な笑みを浮かべたコレイが「悪い精子、びゅ〜♡っと出しちゃいましょう」と四つん這いになったティナリの肛門にディルドを挿入する。\nそれを乱暴にピストンさせながら片手で尻尾の付け根をパンパンと叩く。\nティナリは両手で布団を掴みながら苦しい表情で「う゛〜」と嬌声を上げびゅるびゅると射精。\n\n備考\n・性具について、ディルドと記載していますが、乱暴にピストンできるような持ち手付きの女性用バイブのイメージでお願いします。\n・衣装について、①はどちらも着衣、②はティナリは全裸でコレイは薄着又は着衣に黒いゴム手袋でお願いします。\n・可能であれば②の差分として下記のシーンを入れて頂けるとありがたいです。\nディルドを挿入した状態でピストンさせず、睾丸をポンポンとはたき、「タマタマ揺らして上げますから、いっぱい射精してくださいね♡」", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gz88ez/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3026030, "client_id": 2743558, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c0e953aa/uploads/origins/4368df5f-fcf4-4731-9b59-33817dc55080?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dee4a2b9e364c43c25c4246a67faf97c", "srcset": "https://si.imgix.net/c0e953aa/uploads/origins/4368df5f-fcf4-4731-9b59-33817dc55080?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dee4a2b9e364c43c25c4246a67faf97c, https://si.imgix.net/c0e953aa/uploads/origins/4368df5f-fcf4-4731-9b59-33817dc55080?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff0faff9b2dcff1334bd0adab8c1731e 2x, https://si.imgix.net/c0e953aa/uploads/origins/4368df5f-fcf4-4731-9b59-33817dc55080?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e117e5a385289b375d6e9e8b35c5deab 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c0e953aa/uploads/origins/4368df5f-fcf4-4731-9b59-33817dc55080?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0078da01fbcc3eb7ff02accd52d2eaa3", "srcset": "https://si.imgix.net/c0e953aa/uploads/origins/4368df5f-fcf4-4731-9b59-33817dc55080?bg=%23fff&auto=format%2