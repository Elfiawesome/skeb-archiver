いなぁという感じの優しい笑顔で少年を見下ろしている。\n\n2、満面の笑みのマキがペタンと腰を下ろして跨って挿入しているだけの騎乗位で少年を搾り取っている状態。\n少年は激しい快楽に悶え何度も射精している感じで。\n\n\n※弦巻マキは余裕たっぷりで優しくを意識して描いて頂けるとありがたいです。\n\n内容が合わなければキャンセルしていただいて結構です。\nお忙しい中恐れ入りますがご検討よろしくお願いいたします。\n\nhttps://www.google.com/amp/s/tumidangosan.tumblr.com/post/634157034002153472/%25E5%25BC%25A6%25E5%25B7%25BB%25E3%2583%259E%25E3%2582%25AD/amp", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@asagiyumina/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2224633, "client_id": 351442, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c0daf32f/uploads/origins/59afef16-0468-48a7-bf57-31dd6758f58b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bff3fc3202f6155fd400f0164e17c032", "srcset": "https://si.imgix.net/c0daf32f/uploads/origins/59afef16-0468-48a7-bf57-31dd6758f58b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bff3fc3202f6155fd400f0164e17c032, https://si.imgix.net/c0daf32f/uploads/origins/59afef16-0468-48a7-bf57-31dd6758f58b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6d21c0a1bb4ab062c3fb6e342dafb6f7 2x, https://si.imgix.net/c0daf32f/uploads/origins/59afef16-0468-48a7-bf57-31dd6758f58b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=acecd6d6af83a4f75ac85ca502c19cb1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c0daf32f/uploads/origins/59afef16-0468-48a7-bf57-31dd6758f58b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b1f3d84b1ea9b69bcf8ad0da5e14e91e", "srcset": "https://si.imgix.net/c0daf32f/uploads/origins/59afef16-0468-48a7-bf57-31dd6758f58b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b1f3d84b1ea9b69bcf8ad0da5e14e91e, https://si.imgix.net/c0daf32f/uploads/o