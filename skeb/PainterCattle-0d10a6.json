-bbd0-1cb77570550b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=034f37691ca3d74ee23c2bdd6ab62289 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5645a00/uploads/origins/ffcce80c-92cd-4521-bbd0-1cb77570550b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e79e4c490d56a48decb908466c73998", "srcset": "https://si.imgix.net/a5645a00/uploads/origins/ffcce80c-92cd-4521-bbd0-1cb77570550b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5e79e4c490d56a48decb908466c73998, https://si.imgix.net/a5645a00/uploads/origins/ffcce80c-92cd-4521-bbd0-1cb77570550b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cd814dd2927035f7f1876e8cc3c39c66 2x, https://si.imgix.net/a5645a00/uploads/origins/ffcce80c-92cd-4521-bbd0-1cb77570550b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=79beea7017cb96085a4d1ecfdb3341f3 3x"}, "body": "こんにちは 絵描キ牛さん、私はあなたのアートスタイルが本当に好きで\n\n私のVtuberである卡森拉森（カーソン・ラーソン）の絵を描いてほしいです。\n卡森拉森 | ラクーン\n・180cm\n・ラクーン 怪盜\n・犬牙 緑目 面具 狂氣\n\nこれがとても好きです, 私も同じスタイルになりたい\nhttps://skeb.jp/@PainterCattle/works/9\nhttps://skeb.jp/@PainterCattle/works/10\n\n[構図・モチーフ]\nすべてお任せ致します。\n\n[用途]\n個人で使用/商用利用 (PCの壁紙・印刷して飾る 等)\nSNS\nユーチューブのサムネイル\n\nhttps://drive.google.com/drive/folders/16500g9AlfH28Hq_fIzYgVS74BydyGJn2?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@PainterCattle/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 278999, "client_id": 3090461, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d68e9dc8/uploads/origins/d07e34ad-7f36-4ab2-8a56-dc2da6c1ef5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d4f3c0252c4839548595b0809943fa3", "srcset": "https://si.imgix.net/d68e9dc8/uploads/origins/d07e34ad-7f36-4ab2-8a56-dc2da6c1ef5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d4f3c0252c4839548595b0809943fa3, https://si.imgix.net/d68e9dc8/uploads/origins/d07e34ad-7f36-4ab2-8a56-dc2da6c1ef5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=942cd86cbc8be463dd7ed3b3b580c284 2x, https://si.imgix.net/d68e9dc8/uploads/origins/d07e34ad-7f36-4ab2-8a56-dc2da6c1ef5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33d0445354bb0a5ed3abf7551ea794e8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d68e9dc8/uploads/origins/d07e34ad-7f36-4ab2-8a56-dc2da6c1ef5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b0eaaa5404a6e3edc6f1222f0b285c2", "srcset": "https://si.imgix.net/d68e9dc8/uploads/origins/d07e34ad-7f36-4ab2-8a56-dc2da6c1ef5e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b0eaaa5404a6e3edc6f1222f0b285c2, https://si.imgix.net/d68e9dc8/uploads/origins/d07e34ad-7f36-4ab2-8a56-dc2da6c1ef5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3b4ab410d40486b6cdc985265649a208 2x, https://si.imgix.net/d68e9dc8/uploads/origins/d07e34ad-7f36-4ab2-8a56-dc2da6c1ef5e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1815a0e223858c11e721cdceab4be726 3x"}, "body": "はじめまして。ヒジリと申します。\n\nSkebにてお見かけし、SNS掲載の素敵なイラストも拝見させていただきました。\nダークな雰囲気や人外要素のあるキャラクターに魅力を感じ、\n今回オリジナルキャラクターをリクエストさせていただきました。\n\nイメージ画像のような資料がないため、フレーバーテキストの抜粋を掲載いたします。\n\n\n○キャラクター名：スケアクロウ\n\n・イメージ：案山子、死、最悪\n・種族：死人(元人族)\n・年齢：享年二十歳\n・髪型：お任せします\n・髪色：黒赤or灰赤のメッシュ\n・顔：裂けそうな笑み、愛\n・性格：思いやり、親愛、殺意、同気相求、最悪\n・体型：百九十センチル\n・服装：お任せします\n・好きなもの：自分、世界\n・嫌いなもの：日光、拒絶\n・戦闘：恐怖テラーによる汚染、錆びた鎌、死霊術\n　彼女と相対する者は、恐怖に打ち勝たねば彼女に傷を与えることはできない。\n　鎌はただ固く、よく斬れる。\n　死霊術によって今まで愛して(殺して)きた者たちの魂を呼び出し、使役することができる。\n　魂に肉体を与えることで一緒に戦ったり、魂を燃料として己の強化に使うことも可能。\n　日光は苦手のため、彼ら彼女らの魂で姿や記憶を擬態し、各地を転々としている。\n\n\n○構図\nお任せいたします！\n\n\n○用途\n個人鑑賞、コミッション依頼用\n\n\n下記にもう少しだけ詳細な資料を添付いたします。\nあくまで参考として、先生のお好きに書いていただいて構いません！\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/19qGzzKb3YWwSBY1icz2jtlVaI5A0-pq4?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@PainterCattle/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 278999, "client_id": 2582688, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a83d7dee/uploads/origins/c8a389c7-79cc-483d-a423-e4eee067b324?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e56988503206364ddcc9873e0d2e350", "srcset": "https://si.imgix.net/a83d7dee/uploads/origins/c8a389c7-79cc-483d-a423-e4eee067b324?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0e56988503206364ddcc9873e0d2e350, https://si.imgix.net/a83d7dee/uploads/origins/c8a389c7-79cc-483d-a423-e4eee067b324?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7156d2e7f4a741379fe5d08bcc629cb3 2x, https://si.imgix.net/a83d7dee/uploads/origins/c8a389c7-79cc-483d-a423-e4eee067b324?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6040f4349cde236a434029730405d26f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a83d7dee/uploads/origins/c8a389c7-79cc-483d-a423-e4eee067b324?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb973b442f028ff29bc2926d67ef517d", "srcset": "https://si.imgix.net/a83d7dee/uploads/origins/c8a389c7-79cc-483d-a423-e4eee067b324?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb973b442f028ff29bc2926d67ef517d, https://si.imgix.net/a83d7dee/uploads/origins/c8a389c7-79cc-483d-a423-e4eee067b324?bg=%23fff&auto=format%2Ccompress&fm=we