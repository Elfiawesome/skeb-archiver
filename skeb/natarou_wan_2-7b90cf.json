）👼\n・27歳\n・身長185cm\n・幼い頃からの病気で、右目の白目が黒く濁っている（眼帯の装着有無はお任せします！！）\n・全ての物事を人並み以上にこなす完璧人間だが、完璧なものは「退屈だ」と捉え、嫌っている\n・受け\n\n▼ 麻鬼 欠（黒髪の男性）😈\n・27歳\n・身長180cm\n・右頬に2点ほくろ\n・能天気でひょうきんな性格だが、表情筋が死んでおりほとんど顔に出ない\n・人並みにもできない物事が多いが、「できないものはできない」と開き直っている\n・攻め\n\n▼ 詳細\n・より詳しい設定（関係性等）は、リンク先ドライブに設定補足がございます。\n────────────── \n\n依頼内容や金額に問題や失礼等ありましたら、大変お手数ですがキャンセルや再送要請していただけますと幸いです。\nお忙しいところお任せする点の多い依頼で恐縮ですが、ご検討のほどよろしくお願いいたします。\n\nなたろう様のご活動を、陰ながら応援しております🌸\n\nhttps://drive.google.com/drive/folders/1UCMRthC8AHivRGEK9q0WNbPzJ4q70ntm", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@natarou_wan_2/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3736364, "client_id": 2740430, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2eb09801/uploads/origins/8850e626-1b96-4d36-aa97-1d4612746ea3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c8ad6210b2d41383e3d048676e0854a", "srcset": "https://si.imgix.net/2eb09801/uploads/origins/8850e626-1b96-4d36-aa97-1d4612746ea3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c8ad6210b2d41383e3d048676e0854a, https://si.imgix.net/2eb09801/uploads/origins/8850e626-1b96-4d36-aa97-1d4612746ea3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f623b10ce2c49c4c70189017b0956e9 2x, https://si.imgix.net/2eb09801/uploads/origins/8850e626-1b96-4d36-aa97-1d4612746ea3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c147fff1fdbbe4e3189569830993b2d8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2eb09801/uploads/origins/8850e626-1b96-4d36-aa97-1d4612746ea3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b2d741672ebcda73a3f050bf5a0d68e1", "srcset": "https://si.imgix.net/2eb09801/uploads/origins/8850e626-1b96-4d36-aa97-1d4612746e