s/4bd08992-18c2-46f1-929a-725c76b9375d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08351078dac7cec7e0c36112285b3741", "src_set": ""}, "body": "はじめまして。\n\n個人勢Vtuberの雲丹ゐくらと申します。\n\nsana🐼様のイラストを新着画像にてお見かけし、とても素敵でぜひご依頼させていただきたいと考えておりましたので、 今回リクエストをお送りさせていただきました。\n\n【使用用途 】\n・配信活動全般\n・X等SNS全般への投稿(※オリジナルの透かしを使用して投稿)\n・サムネイル、配信画面内、動画内での使用(使用の際にトリミング等加工をさせて頂く可能性がありますが、原型を留めない程の加工は致しません)\n・メンバーシップ加入者への壁紙配布\n\n想定している使用方法は上記ですべてになります\n\n【希望のポーズ/服装】\n日本海出身のVtuberという設定なので通常の衣装は、マリンセーラーとなっていますが、今回は下記の衣装『着物』スタイルでお願いできればと思います。\n主に飲酒雑談などのサムネイルで使用させていただくことになると思うのですが、ポーズなどはお任せ致します。\nhttps://x.com/uniikura_uta/status/1825897868399698379\n\n【構図/差分に関して】\n・サムネイルに使用する可能性があるため、髪の毛と顔周りは見切れていない構図だととても助かります！\n・もし可能であれば表情差分もいただけますと幸いです。\n※サイズ指定が可能であればYouTubeのサムネイルに使用できるものでお願いいたします。\n・画面比率はこだわりません。(過去作品のように縦長の比率で大丈夫です)\n・納品時にPSDデータにて背景透過されているデータもいただけますと幸いです。\n\n【衣装参考用】\nhttps://x.com/uniikura_uta/status/1889283446541001122\nhttps://x.com/uniikura_uta/status/1823298552623493408\n描写は必須ではないですが、ウニの体にイクラの目をしたサブキャラクターもいます。\n\n【キャラクターテンプレート】\n名前:雲丹ゐくら\n髪色:金髪ハイトーン\nヘアースタイル:前髪重めストレートロング\n目の色:青(海の色)\n通常服装:マリンセーラー\nサブキャラクター:ウニの体にイクラの目をした生き物", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sana79261827/works/303", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bc4992ed/uploads/origins/63cc0c63-d9e7-4533-bdce-22a6c8d77912?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=db32a2ef38246273e41154a629c58751", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2607759, "client_id": 2614847, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sana79261827/works/302", "private_