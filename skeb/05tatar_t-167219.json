23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=066153813b5bfa0b651d9cf9b8fc3608, https://si.imgix.net/a03691a7/uploads/origins/683aba6e-aed7-492f-9cf6-e6f6e2395047?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2d00de77f27b15e3b620e90635ae9508 2x, https://si.imgix.net/a03691a7/uploads/origins/683aba6e-aed7-492f-9cf6-e6f6e2395047?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=17b1cac25b01c264876a09bc8ee2d34b 3x"}, "body": "Hi there! Hehe, it’s me again. I guess it’s inevitable since I’ve already fallen in love with your art. This is my favorite OC pair, so please feel free to create them in your own way. I’m really excited to see what you come up with! \n\nこの世界では、エヴァンとルイスは同じ空に浮かぶ二つの星のように、共に成長してきた。エヴァンはルイスより三歳年上で、名前を付けたことのない想いを胸に抱えていた。戦争は破滅で終わる。エヴァンは二十三歳で戦死し、ルイスは生き残ったが両手を失い、完全な人間として歩み続ける力も失ってしまった。この場所では、魂は同じ光の一点から共に生まれることがあるが、やがて消えるときには別々の軌道へ散っていく。死後、エヴァンは交差する空間へと漂い着いた。そこは星々の運行と無数の世界の循環を見守る観測の領域だった。前任の管理者と契約を交わしたあと、エヴァンは新たな管理者となり、自由と引き換えに記憶を手元に残した。礼服をまとい、エヴァンはそこに留まり続ける。もう動かない星のように、ただ静かに、自分が見守る空を一つの懐かしい魂が横切るのを待ちながら。\n\n——\n\n小さなメモ：\n他のAUでは、二人はとても幸せに暮らしている。エヴァンはスキンシップが大好きでよく笑い、ルイスの髪にキスするのが好き。ルイスはまじめで愛らしく、学問に強い情熱を持っている。二人はまるで月と太陽のような存在。\nEvan: 1m88cm\nLouis: 1m79cm\n\nhttps://drive.google.com/drive/folders/1FagtkfATPRqeXfVPWDp-bKgAFp5AscAP?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@05tatar_t/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3615719, "client_id": 2822197, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/476fbb18/uploads/origins/f42cb97d-de55-4925-ac16-05fcfcb61d7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=702c451c5b06710364d6ac4886bf97b5", "srcset": "https://si.imgix.net/476fbb18/uploads/origins/f42cb97d-de55-4925-ac16-05fcfcb61d7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=702c451c5b06710364d6ac4886bf97b5, https://si.imgix.net/476fbb18/uploads/origins/f42cb97d-de55-4925-ac16-05fcfcb61d7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b8915b0715e91547825293c6e61627dd 2x, https://si.imgix.net/476fbb18/uploads/origins/f42cb97d-de55-4925-ac16-05fcfcb61d7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=21cbb1022cb99afcc1992549fabf794f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/476fbb18/uploads/origins/f42cb97d-de55-4925-ac16-05fcfcb61d7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=048e9bd16dd92f72b31c19ef60c5847a", "srcset": "https://si.imgix.net/476fbb18/uploads/origins/f42cb97d-de55-4925-ac16-05fcfcb61d7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=048e9bd16dd92f72b31c19ef60c5847a, https://si.imgix.net/476fbb18/uploads/origins/f42cb97d-de55-4925-ac16-05fcfcb61d7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=380b7fbec5e7c81f028be33e1329afdc 2x, https://si.imgix.net/476fbb18/uploads/origins/f42cb97d-de55-4925-ac16-05fcfcb61d7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=27a8e128598bb75d05841820ef91cf96 3x"}, "body": "また僕だ！前回の依頼が本当に大好きで、一日中見とれていました。素晴らしい作品を本当にありがとう。今回は、彼女の新しい衣装をフィーチャーした新作を依頼したいと思います。彼女は伝説的な存在で、人々が眠るベッドのそばに現れ、ケーキのように彼らの夢をむさぼる。舞台は夜にしたいのですが、それ以外は自由に作ってください。本当にありがとうございました\n\nhttps://drive.google.com/drive/folders/1e8kQ5LtWhYkIQjQ4c9JWz0Jh94eBSbIN?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@05tatar_t/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3615719, "client_id": 3535220, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9765428e/uploads/origins/1cd707ea-69d4-428d-8b5c-44c597010041?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07dbf9e18c511bebbac1f59b23c9ea0a", "srcset": "https://si.imgix.net/9765428e/uploads/origins/1cd707ea-69d4-428d-8b5c-44c597010041?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07dbf9e18c511bebbac1f59b23c9ea0a, https://si.imgix.net/9765428e/uploads/origins/1cd707ea-69d4-428d-8b5c-44c597010041?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bade47b0f2cebbfd2a5483f7d032b361 2x, https://si.imgix.net/9765428e/uploads/origins/1cd707ea-69d4-428d-8b5c-44c597010041?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=855ab7c0f579e0d5a24eba1f9e9dffe9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9765428e/uploads/origins/1cd707ea-69d4-428d-8b5c-44c597010041?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d11ee7db82756f7e34befd661b8a232", "srcset": "https://si.imgix.net/9765428e/uploads/origins/1cd707ea-69d4-428d-8b5c-44c597010041?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2d11ee7db82756f7e34befd661b8a232, https://si.imgix.net/9765428e/uploads/origins/1cd707ea-69d4-428d-8b5c-44c597010041?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b2286be8e3b79ad3622a7ac7cee9cd52 2x, https://si.imgix.net/9765428e/uploads/origins/1cd707ea-69d4-428d-8b5c-44c597010041?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5f9dc52976af3fe4317be41b42153106 3x"}, "body": "あに様\n\n初めまして、個人VTuberのユメ子と申します。\nあに様の繊細な線と力強い目がとても好きで、ぜひあに様の解釈で私のイラストを描いていただきたいと思いリクエストをお送りいたします。\n\nイラストはYouTubeのサムネイルや動画内で使用したり、Xでの自己紹介ポストに添付させていただきたいと思っております。(Xに掲載する際は私の方でウォーターマークを追加する場合があります)\n衣装デザインはおまかせいたします。\nホラーやリミナルスペース・ドリームコアのような不思議だったり不穏な雰囲気が好きなので、そういった空気感のあるイラストにしていただきたいです。\n\nまた、料金内