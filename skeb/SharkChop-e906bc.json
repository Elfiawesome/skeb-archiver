9-7160dca20e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=300014194db36762f8c9b596bb484974", "srcset": "https://si.imgix.net/e38943d8/uploads/origins/4444d16c-5b9c-4230-8899-7160dca20e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=300014194db36762f8c9b596bb484974, https://si.imgix.net/e38943d8/uploads/origins/4444d16c-5b9c-4230-8899-7160dca20e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30f09d5994e3ae3d2dedc18b041c28c0 2x, https://si.imgix.net/e38943d8/uploads/origins/4444d16c-5b9c-4230-8899-7160dca20e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81c16f5e2cdd274ad14033a7123a345a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e38943d8/uploads/origins/4444d16c-5b9c-4230-8899-7160dca20e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e9048ee28eb52cdc3e1f284a9f08a00", "srcset": "https://si.imgix.net/e38943d8/uploads/origins/4444d16c-5b9c-4230-8899-7160dca20e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e9048ee28eb52cdc3e1f284a9f08a00, https://si.imgix.net/e38943d8/uploads/origins/4444d16c-5b9c-4230-8899-7160dca20e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=23b4a29248694dc006763f2a7a669c72 2x, https://si.imgix.net/e38943d8/uploads/origins/4444d16c-5b9c-4230-8899-7160dca20e0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7ec506ea01738dac8c9fa59874da2461 3x"}, "body": "海外からの挨拶だ。\nVTuber「キリ キロボルト」のファンで、エロイラストをお願いします。\n\nキリは顔にサングラスをかけている（髪にはかけていない！）。イラストは、キリが顔とサングラスに本当に濃厚なドリップぶっかけを浴びて、幸せそうな笑顔とウインクをしながら口の端に垂れた精液を舐め取っているビフォー・アフターであるべきだ。\n\nサングラスをかけたのは、彼女の顔に大量の精液をぶちまけるためだ」という気持ちを呼び起こし、幸せそうな顔を鑑賞するために、目はまだ十分に見えるはずだ。\n\n口の端に一筋の陰毛があり、パイズリを暗示するためにおっぱいの近くにも陰毛があるとありがたい！\n\n私の依頼を考慮してくれて本当にありがとう。あなたの素晴らしいエロティックなイラストの長所を生かし