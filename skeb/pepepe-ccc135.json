DとPNG形式\n（PSDを扱うソフトがないため、PNG形式も併せて納品頂けると助かります）\n\n◆宛名\n宛名は「Quon」でお願いします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pepepe/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1922448, "client_id": 2616430, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0e17add3/uploads/origins/86e874ec-1061-4452-9f6b-7619b9b6c08c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd63adfba30fabc1f69a7d9a3058d275", "srcset": "https://si.imgix.net/0e17add3/uploads/origins/86e874ec-1061-4452-9f6b-7619b9b6c08c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd63adfba30fabc1f69a7d9a3058d275, https://si.imgix.net/0e17add3/uploads/origins/86e874ec-1061-4452-9f6b-7619b9b6c08c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=470bb8a90ba618e6fb3a5107ac1c626a 2x, https://si.imgix.net/0e17add3/uploads/origins/86e874ec-1061-4452-9f6b-7619b9b6c08c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0767c845552f65fc26e151a78c1bbe2d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0e17add3/uploads/origins/86e874ec-1061-4452-9f6b-7619b9b6c08c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbb8ea15c5b80d92743e3421ebb06251", "srcset": "https://si.imgix.net/0e17add3/uploads/origins/86e874ec-1061-4452-9f6b-7619b9b6c08c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbb8ea15c5b80d92743e3421ebb06251, https://si.imgix.net/0e17add3/uploads/origins/86e874ec-1061-4452-9f6b-7619b9b6c08c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a85048b6e423bba683cf06d5edefa2c0 2x, https://si.imgix.net/0e17add3/uploads/origins/86e874ec-1061-4452-9f6b-7619b9b6c08c?bg=%23fff&auto=format%2Ccompress&fm=