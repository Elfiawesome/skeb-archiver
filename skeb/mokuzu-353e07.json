外見：ロシア人であり、非常にマッチョ。\n性格：いつも無表情で、まじめで率直な性格。感情は豊かで、無表情で赤くなったり青くなったりする。拷問や血が苦手で、良くも悪くも純粋である。\n\n▽使用用途\n・個人観賞、自陣への共有\n・SNSなどでのヘッダー、アイコン使用（お名前をその際記載させていただきます。）\n\n資料は下記リンクを参照して頂けると幸いです。\nデフォルトの服装に準拠しなくても大丈夫です。自由に描いていただけるとありがたいです。\n\nご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1S7HA-9luBtOjz4NdP_9rsbCuv4mkHoou?usp=drive_link", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 1808847, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Mt.10", "screen_name": "mug09122021", "avatar_url": "https://pbs.twimg.com/profile_images/1796231572972257284/1tTJnDOU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1269431717867053057/1717089980/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 129}, {"id": 1918422, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "らみゆう🐦skeb受付中", "screen_name": "rami_Illust", "avatar_url": "https://pbs.twimg.com/profile_images/1505544842067464197/nIlT-hIZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1503425064251043840/1647280054/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 144}, {"id": 2757069, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "mita", "screen_name": "mitamita284", "avatar_url": "https://pbs.twimg.com/profile_images/1659412623279153153/itC4xXpW.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by