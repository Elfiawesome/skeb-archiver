いです.\n野郎フェス楽しみにしております(∩´∀｀)∩\n※デザイン参考リンクを\"資料URL\"に添付しておきます※\n\nhttps://drive.google.com/drive/folders/1Ehp8Ipuq7qJXog0so2CW0VsPNNlLKovt?usp=drive_link", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1030020, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "スナオ", "screen_name": "70_the", "avatar_url": "https://pbs.twimg.com/profile_images/1939683578402557952/nXyIKTvX.jpg", "header_url": "https://pbs.twimg.com/profile_banners/568297786/1715942638/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 1394972, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "Zig", "screen_name": "zig_r14", "avatar_url": "https://pbs.twimg.com/profile_images/1633875170858512385/bzr5IePI.jpg", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "video"}, {"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 160}, {"id": 1487547, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "増量中筋トレなめこ", "screen_name": "nameko_hachikou", "avatar_url": "https://pbs.twimg.com/profile_images/2028514255126089728/vpVEfJxH.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1871589942/1765981169/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc