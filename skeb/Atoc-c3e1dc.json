imgix.net/9eb40149/uploads/origins/57e5b2bc-72b6-4566-9438-7a8320993361?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=423cabc35053d8f18c4eff482eb8381e 3x"}, "body": "こんにちは。アピールありがとうございます。私のキャラを気に入っていただけたようで、嬉しいです最近、ロザリーの絵がもっと欲しくなってきたので、今回リクエストを送らせていただきました。構図については、2つ考えています。\nまず、ロザリーのブーツに焦点を当てた構図を楽しみたいと思います。ローアングルの写真はとても力強さを感じるので、とても好きです。\nもうひとつは、ポートフォリオにあるバイクの絵がカッコイイと思いました。この絵が好きだし、関連性があるように思えたからです。ロザリーは古いアメリカン・バイクに乗るのが好きなので、バイクの写真も何枚か入れておきました。ロザリーがアメリカの古いバイクに乗るのが好きなので、バイクの写真も入れておきました。(ロザリーのデザインは、バイカーと巫女を組み合わせたものなのです。）\nなどなど、参考になれば幸いです。とにかくロザリーを楽しんで描いてほしいので、喜んでもらえるような絵を描いてください。ありがとうございました。\n\nhttps://1drv.ms/u/s!ApN8YHxADFfvjVlEf1u1HMgy1dg_?e=RyHkyh", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Atoc/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2090024, "client_id": 1456276, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/122adf63/uploads/origins/18540755-6457-47b4-b429-f17a6271587a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f5a45d94b5b353e7227b36b917fe795", "srcset": "https://si.imgix.net/122adf63/uploads/origins/18540755-6457-47b4-b429-f17a6271587a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f5a45d94b5b353e7227b36b917fe795, https://si.imgix.net/122adf63/uploads/origins/18540755-6457-47b4-b429-f17a6271587a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7c3194e5c97cb71dd43cfa240d81366 2x, https://si.imgix.net/122adf63/uploads/origins/18540755-6457-47b4-b429-f17a6271587a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59c47fc435050d0fe2f45bf9cdee916a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/122adf63/uploads/origins/18540755-6457-47b4-b429-f17a6271587a?bg=%23fff&auto=format%2Ccomp