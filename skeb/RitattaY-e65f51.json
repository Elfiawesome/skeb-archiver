si.imgix.net/5b441da2/uploads/origins/99eca89b-4b6b-4ccd-9bbd-aa4992125414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58871686f08d0135af900d1c68557204, https://si.imgix.net/5b441da2/uploads/origins/99eca89b-4b6b-4ccd-9bbd-aa4992125414?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6fc630c6f71c956338724759e04da5aa 2x, https://si.imgix.net/5b441da2/uploads/origins/99eca89b-4b6b-4ccd-9bbd-aa4992125414?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=70138a33bbfd27c591c2845f6829c250 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b441da2/uploads/origins/99eca89b-4b6b-4ccd-9bbd-aa4992125414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73526e351792544270beb61e572e4489", "srcset": "https://si.imgix.net/5b441da2/uploads/origins/99eca89b-4b6b-4ccd-9bbd-aa4992125414?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73526e351792544270beb61e572e4489, https://si.imgix.net/5b441da2/uploads/origins/99eca89b-4b6b-4ccd-9bbd-aa4992125414?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a92f8ef066c5747f7ffe4140b864410c 2x, https://si.imgix.net/5b441da2/uploads/origins/99eca89b-4b6b-4ccd-9bbd-aa4992125414?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d1770f9415b45fb99a93679c63ba69b0 3x"}, "body": "こんにちは！私はあなたの前のアートが大好きです。とてもかわいい！あなたのスタイルで私のキャラクターを描いてほしいです。\n前の作品と同じようにしたいです。https://skeb.jp/@RitattaY/works/3\n\n二人のキャラクターの絵を依頼したいです。エミコ」と「レイ」です。二人は恋愛関係にあります。\n\nエミコ」は、長い爪とふわふわの尻尾を持つ太陽竜です。気性が激しく情熱的で、「レイ」に対してはとても愛情深い。また、「レイ」にはすぐに慌てふためく。\n\nレイ」はいたずら好きで、独りよがりなエルドリッチ・クリーチャーだ。鋭い歯と黒くて長い尻尾を持っている。エミコ」をからかうのが好きだ。背は「エミコ」より高い。\n\nアクティビティとアイデアのリスト：\n- 一緒にアイスクリームを食べる。\n- ビデオゲームをする。\n- レイ」は疲れているか寝ている。エミコ」は元気。\n- 赤面する「えみこ」。\n- レイ」が「エミコ」を指差して笑う。\n- 一緒に音楽を聴く。\n- 一緒に手をつなぐ。\n- 一緒に写真を撮る。\n\nご配慮ありがとうございました\n\nhttps://drive.google.com/drive/folders/1oWoOMem9ZxbcF6BQNHh3UqKzmtG5UTEm?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@RitattaY/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2650588, "client_id": 1162939, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/77be7118/uploads/origins/35508f05-340a-41d1-9ecc-531ed99b9d64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6598f7fa7f94541a98b5ea11d6a5fb15", "srcset": "https://si.imgix.net/77be7118/uploads/origins/35508f05-340a-41d1-9ecc-531ed99b9d64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6598f7fa7f94541a98b5ea11d6a5fb15, https://si.imgix.net/77be7118/uploads/origins/35508f05-340a-41d1-9ecc-531ed99b9d64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=838f12e3759649bc1b1463cb89aebc14 2x, https://si.imgix.net/77be7118/uploads/origins/35508f05-340a-41d1-9ecc-531ed99b9d64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ff6e0040e20971c3a366f589c88f9a5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/77be7118/uploads/origins/35508f05-340a-41d1-9ecc-531ed99b9d64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=493df8f67219b894701090d8eb54ca7c", "srcset": "https://si.imgix.net/77be7118/uploads/origins/35508f05-340a-41d1-9ecc-531ed99b9d64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=493df8f67219b894701090d8eb54ca7c, https://si.imgix.net/77be7118/uploads/origins/35508f05-340a-41d1-9ecc-531ed99b9d64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8c01cdaf55fee2b10937f20a885ee233 2x, https://si.imgix.net/77be7118/uploads/origins/35508f05-340a-41d1-9ecc-531ed99b9d64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b7643af8949e6532f3b7bc889fd89a93 3x"}, "body": "私と友人のOC２人の絵を描いて頂きたくご検討お願いします！\n友人（ @ta81ta ） のプロフィールにこのリクエストに同意した記載有。\n\n●用途\n非商用の範囲（SNSに載せたり、２だけでグッズにしたり、キャラプロフィール載せる等）で使用させて下さい。\n\n●イラスト内容\n以前skebで描かれているスタイルのイラストを描いて頂きたいです！　下記、キャラや関係性のイメージを掴んで頂く為に記載しますので、良ければ参考にして下さい。内容の使用可否お任せ、自由に描いていただければ嬉しいです！\n\n●関係性\n大切な幼馴染、同級生、仕事仲間。\n友達以上、家族以上、恋人未満。\nスーパー距離が近い。\n\n●陽向・空唄\n【外見】瞳は青、爽やかでかっこいい\n【呼称】自分「俺」相手「ひな」\n【年齢】１７才／高２\n【身長】１７４cm\n【職業】新人俳優\n【性格】元気で純粋、懐っこいわんこ\n【特技】運動全般、料理\n【欠点】高い所が苦手\n【ほか】尽くしたい傍にいたい兎に角雛世が大好き！雛世しか勝たんっ。\nhttps://skeb.jp/@UU_w32/works/34\n\n●翼・雛世\n【外見】瞳は銀、童顔でやや中性的\n【呼称】自分「おれ」相手「空唄」\n【年齢】１７才／高２\n【身長】１７０cm\n【職業】子役→俳優\n【性格】真面目で天然、男前\n【特技】演技、空手（黒帯）\n【欠点】方向音痴\n【ほか】大食い。演技以外では表情が乏しい。空唄は大切な友人で甘やかしたい（無意識）存在。\nhttps://skeb.jp/@UU_w32/works/33\n\n●シチュエーションや台詞参考\n・雛世にあーんする空唄と自然に受け入れる雛世\n・スマホで自撮り、空唄が撮影。雛世と映れてにこにこな空唄、表情は薄いがほわほわな雰囲気でピースする雛世\n・食べ物を半分こする時は必ず雛世に大きい方をあげる空唄、嬉しそうに受け取る雛世\n・雛世が頭を撫でようとすると自然と頭を傾ける空唄（撫でて撫でてっ）\n・お忍びお出かけ中、ファンサするふたり。手を振る空唄、しーっする雛世\n・バイクの後ろに雛世を乗せる空唄\n\n●漫画\nhttps://skeb.jp/@UU_w32/works/46", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@RitattaY/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2650588, "client_id": 1933200, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/518ae5d3/uploads/origins/3c4525ac-224f-4b14-af21-4a16df26c46e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7debb60f798aa1b8d87dfb4b66c24147", "srcset": "https://si.imgix.net/518ae5d3/uploads/origins/3c4525ac-224f-4b14-af21-4a16df26c46e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7debb60f798aa1b8d87dfb4b66c24147, https://si.imgix.net/518ae5d3/uploads/origins/3c4525ac-224f-4b14-af21-4a16df26c46e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c7411fdd52ae0668869b1c744f49c11 2x, https://si.imgix.ne