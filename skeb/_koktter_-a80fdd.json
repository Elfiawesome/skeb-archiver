op&w=200&h=200&s=b5b96c44b8258d7d345084e0279174e5, https://si.imgix.net/be3edbbe/uploads/origins/1fa133b2-8a28-4742-91aa-387e8f0b3fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d5daf0e0a0d41a0abddb4cf9e52acfa3 2x, https://si.imgix.net/be3edbbe/uploads/origins/1fa133b2-8a28-4742-91aa-387e8f0b3fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8eed079eb8fe0fc2ddda3c40decf492e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/be3edbbe/uploads/origins/1fa133b2-8a28-4742-91aa-387e8f0b3fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89522371cd7db3da22a1cb4afb5e4b51", "srcset": "https://si.imgix.net/be3edbbe/uploads/origins/1fa133b2-8a28-4742-91aa-387e8f0b3fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=89522371cd7db3da22a1cb4afb5e4b51, https://si.imgix.net/be3edbbe/uploads/origins/1fa133b2-8a28-4742-91aa-387e8f0b3fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7df3609ebe8a1613ca90500a7b10a71c 2x, https://si.imgix.net/be3edbbe/uploads/origins/1fa133b2-8a28-4742-91aa-387e8f0b3fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c274082dfacc99be101873753e32497f 3x"}, "body": "シスタークレアさんのパイズリ懺悔室をお願いします。\n\nどんなお願いも簡単に叶えてくれる優しいシスター。\nパイズリをしたことが無いのが悩み(嘘)でも聞いてくれる。\nhttps://realsound.jp/wp-content/uploads/2022/07/20220730-sistercrea99.jpg\n\nかなり着やせするタイプで脱げば凄い柔らか爆乳。\n参考→https://i.gyazo.com/17160028aa9930570b6a428dfb5b83e7.png\n\n\nなんども頼まれているようでテクニック抜群。\n乳圧弱め、乳圧MAX(乳寄せで乳圧UP)の2種類ができればお願いしたいです。\n\nご検討宜しくお願い致します。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_koktter_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 41064, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/41973322/uploads/origins/47d96834-e737-4893-be2e-d10743fc71d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=779ee1bee53b791dfe66c22a47e9e0ac", "srcset": "https://si.imgix.net/41973322/uploads/origins/47d96834-e737-4893-be2e-d10743fc71d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=779ee1bee53b791dfe66c22a47e9e0ac, https://si.imgix.net/41973322/uploads/origins/47d96834-e737-4893-be2e-d10743fc71d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=246c5f9bd769fc39284b8f373b04b469 2x, https://si.imgix.net/41973322/uploads/origins/47d96834-e737-4893-be2e-d10743fc71d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=37cb93e0817a5976fc05d864cd84efdb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/41973322/uploads/origins/47d96834-e737-4893-be2e-d10743fc71d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f14cc644a3b885bfb9ab3e35e05a9c0a", "srcset": "https://si.imgix.net/41973322/uploads/origins/47d96834-e737-4893-be2e-d10743fc71d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f14cc644a3b885bfb9ab3e35e05a9c0a, https://si.imgix.net/41973322/uploads/origins/47d96834-e737-4893-be2e-d10743fc71d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4ac8802126a3e0c4b14b3c0abad81cc3 2x, https://si.imgix.net/41973322/uploads/origins/47d96834-e737-4893-be2e-d10743fc71d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=21f5455f57c920eaeae4fa51bb5dc3f2 3x"}, "body": "お久しぶりです。こくとうさんがskebを開設されて、居ても立ってもいられなくなったのでリクエストさせていただきます。\n\nキャラはワンピースのナミさんをお願いします。ナミさんは爆乳・デカ乳首(綺麗なピンク色)・デカ乳輪で衣装はルフィの衣装(参考資料)を描いてください。\n描いていただきたいシーンはナミさんの膝上爆乳パイズリシーンをお願いします。かなり胸元が開いてる衣装なので着衣状態でも乳首がハミ出て見えている様に描いてください。差分として①膝上爆乳パイズリ②バキュームパイフェラ③口内射精④ごっくん⑤飲み干し確認の舌見せをお願いしたいです。\nシーンの流れはエロコスナミさんの爆乳圧パイズリに必死で耐える竿役に「なかなかやるじゃない♡サービスしてあ・げ・る♡」とナミさんは爆乳からハミ出たチン先にバキュームパイフェラをします。竿役に口を窄めた下品な表情を見せて「あんたの好きなひょっとこ口の間抜けなフェラ顔よ〜♡」と射精を煽ります。我慢の限界に達した竿役はナミさんの口内に大量の口内射精(なかだし)をします。ナミさんは口の中いっぱいのザーメンをゴクゴクと美味しそうに飲みます。舌を見せてザーメンを飲み干した事を見せつけます。「ぷはぁっ♡ちょっと溜めすぎよ♡飲み込むの大変だったわ♡でもあんたのザーメンなかなか癖になる味で良かったわよ♡あはっ♡チンポギンギン♡まだまだ射精そうね♡たっぷり搾り取ってあげる♡」\n\n以上となります。\n可能な範囲で構いませんので引き受けていただけると嬉しいです。よろしくお願いします。\n\nhttps://x.com/sol_air424/status/2114680233769271421?s=46&t=gmRRJ5v45o7qbz8BkrrY6w", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_koktter_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 41064, "client_id": 50473, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4e8c527/uploads/origins/42c17d18-ebc3-493d-b861-85316b57e03b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3db32a20151bbfc04cf678b3ecb66c57", "srcset": "https://si.imgix.net/a4e8c527/uploads/origins/42c17d18-ebc3-493d-b861-85316b57e03b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3db32a20151bbfc04cf678b3ecb66c57, https://si.imgix.net/a4e8c527/uploads/origins/42c17d18-ebc3-493d-b861-85316b57e03b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73562fdaaa22c86a18d8b73cbd4c9556 2x, https://si.imgix.net/a4e8c527/uploads/origins/42c17d18-ebc3-493d-b861-85316b57e03b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=672499fbe6432227473f1cefbafab7d0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4e8c527/uploads/origins/42c17d18-ebc3-493d-b861-85316b57e03b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a1d54c94ece5162a2793a6deeb1f5dc", "srcset": "https://si.imgix.net/a4e8c527/uploads/origins/42c17d18-ebc3-493d-b861-85316b57e03b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&c