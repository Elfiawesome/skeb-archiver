=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5961484876854d6cd7c7b0640507ec4d 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 470717, "client_id": 2949150, "nc": 161}, {"path": "/@Raspberry_dim/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 470717, "client_id": 3174751, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/10b6326a/uploads/origins/d04b802e-64f4-481f-a4dd-f0e07151d17c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7be2eb59b9521913609b2c5b5bbbc61", "srcset": "https://si.imgix.net/10b6326a/uploads/origins/d04b802e-64f4-481f-a4dd-f0e07151d17c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7be2eb59b9521913609b2c5b5bbbc61, https://si.imgix.net/10b6326a/uploads/origins/d04b802e-64f4-481f-a4dd-f0e07151d17c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db5fe35c33178b1fc8ff0c36a649884f 2x, https://si.imgix.net/10b6326a/uploads/origins/d04b802e-64f4-481f-a4dd-f0e07151d17c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f335e14d2e0b01eb285ac497aaa9f3bc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/10b6326a/uploads/origins/d04b802e-64f4-481f-a4dd-f0e07151d17c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b25601a23ab4961719c84b67a7d598a1", "srcset": "https://si.imgix.net/10b6326a/uploads/origins/d04b802e-64f4-481f-a4dd-f0e07151d17c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b25601a23ab4961719c84b67a7d598a1, https://si.imgix.net/10b6326a/uploads/origins/d04b802e-64f4-481f-a4dd-f0e07151d17c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=526472bf042d54ddbdcb7abaa1f8f7f9 2x, https://si.imgix.net/10b6326a/uploads/origins/d04b802e-64f4-481f-a4dd-f0e07151d17c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fa50cd8ed80d790a829e92d77e275034 3x"}, "body": "【夢主キャラクターデザイン依頼】\n\nこんにちは。\n原神に登場するキャラクター・楓原万葉の夢主である「白瀬 結衣（しらせ・ゆい）」のキャラクターデザインのブラッシュアップをお願いしたく、ご相談させていただきます。\nあわせて、彼女が占術に用いる小道具「鏡」のデザインについても、ご提案いただけますと幸いです。\n\nデザインにおいて、楓原万葉との明確な共通モチーフは必要ありませんが、もし可能でしたら、さりげなく関連性を感じられる要素を忍ばせていただけると嬉しいです。\n\n楓原万葉の公式立ち絵と並べても違和感のない、夢主としての完成度の高いビジュアルを希望しております。\n\n\n【キャラクター設定：白瀬 結衣】\n\t•\t稲妻在住、18歳前後の女性\n\t•\t稲妻の氷元素の神の目を所持（装着位置はお任せします）\n\t•\t一人暮らしをしており、旅の途中だった万葉に「一宿一飯の恩」を与えたことが、二人の出会いのきっかけ\n\t•\t鏡を用いた占術を得意とし、占いの際には鏡に波紋や映像が浮かぶなど、幻想的な演出が現れます\n\t•\t普段はお淑やかで感情をあまり表に出さず、ややジト目がち\n\t•\tしかし、万葉の前ではときに“愛が重い”一面を覗かせることもあります\n\n\n【デザインモチーフ】\n\t•\tモチーフ：鏡、プリズム\n\t•\tカラーパレット：氷元素を意識した寒色系を基調とした衣装\n\t•\t小道具：「占術用の鏡」\n　∟ 元素力により空中に浮かぶ\n　∟ 持ち手のない、幻想的かつ神秘的な意匠\n    ∟ 所謂、ゲーム内における法器武器\n\n\n※なお、デザイン案の儚い涼げな雰囲気はそのままに、特に白瀬の髪型は変更のなきようお願いいたします。\nまた、彼女は華奢な体つきで、胸元はほんのりと膨らみがある程度です。\n\n\n【参考：楓原 万葉】\n\t•\t稲妻出身の風元素使いであり、放浪の剣士\n\t•\tかつて名家「楓原家」の出身だったが、現在は自由な旅の途上にある\n\t•\t風のように軽やかで穏やかな性格ながら、内には静かな情熱を秘めている\n\n\nご不明な点や設定上の気になる点がございましたら、解釈やアレンジはご自由にしていただいて構いません。\n最後に、デザインしていただきました白瀬結衣につきまして、私自身もイラストを描いており、今後イラスト等の制作に使用させていただきたいと考えております。\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1KF9J_qr0-HzNmDegpaNBoFYshvmuG5Vl", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Raspberry_dim/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dcdc2fa6/uploads/origins/80e5aba3-06c5-407c-b138-79b94c68fc4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bbd836daefb5b7aac4754b9bac336085", "srcset": "https://si.imgix.net/dcdc2fa6/uploads/origins/80e5aba3-06c5-407c-b138-79b94c68fc4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFF