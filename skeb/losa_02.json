32129044481?s=21&t=eOnGPZwz-zXTaZnCLMNZiw", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@losa_02/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 26026, "client_id": 616689, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff4dcd63/uploads/origins/fd8227cc-50fe-4329-b10a-cf92cba658f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5be71f2f94712f94f31d897dae4da61d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff4dcd63/uploads/origins/fd8227cc-50fe-4329-b10a-cf92cba658f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de100b0250c828ee055ed55ba46c9615", "src_set": ""}, "body": "初めまして！\ncoefontの頃から存じております\nろささんの描く神秘的な雰囲気のあるイラストが好きなのでそういったイラストを描いていただきたいです！\n\nうちの子の風野茉礼を茉莉花(ジャスミン)の花と一緒に描いていただけたらと思います\n\n茉礼資料\nhttps://twitter.com/ssohsn/status/1475859032129044481?s=21&t=eOnGPZwz-zXTaZnCLMNZiw\n\n横髪を三つ編みにした男の子です。\nアホ毛が3本、タレ目で目の下にクマがあり、太眉という特徴があります。\n\nご検討よろしくお願いします😊\n\nhttps://twitter.com/ssohsn/status/1476787811961688067?s=21&t=eOnGPZwz-zXTaZnCLMNZiw", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 65255, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "こなた🚀", "screen_name": "konata506", "avatar_url": "https://pbs.twimg.com/profile_images/1886193121693925377/7fLoJzjl.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1106586100615659521/1696840387/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 1}, {"id": 2037758, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "油性零号機", "screen