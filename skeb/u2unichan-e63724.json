ubeサムネイル/Twitter等のSNSでの宣伝活動で使用予定\n\n・その他お願い\n頭や髪の毛は見切れないように描写して頂けたらと思います。また、可能であれば背景透過したものをPSDファイルでいただけると嬉しいです。\nもし手を描写するポーズの場合は、手は出さずに袖で描写していただけたら嬉しいです！\n\n上記の内容でご検討よろしくお願い致します\n\nhttps://drive.google.com/drive/folders/15W2uOEY1KL-NlyoVrANRsS3BkxXdySZx?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sio_anko2/works/261", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 866772, "client_id": 3524420, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/84e9b40f/uploads/origins/bbaf0cb3-a1fa-4ce9-8e2c-01c3c0974b72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e045ff192d57c4819828524874dfddd5", "srcset": "https://si.imgix.net/84e9b40f/uploads/origins/bbaf0cb3-a1fa-4ce9-8e2c-01c3c0974b72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e045ff192d57c4819828524874dfddd5, https://si.imgix.net/84e9b40f/uploads/origins/bbaf0cb3-a1fa-4ce9-8e2c-01c3c0974b72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bb2275c8f60b9cdb4faae83a47d15244 2x, https://si.imgix.net/84e9b40f/uploads/origins/bbaf0cb3-a1fa-4ce9-8e2c-01c3c0974b72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb19a448bdaf7939f1ea7ddb866c6fe3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/84e9b40f/uploads/origins/bbaf0cb3-a1fa-4ce9-8e2c-01c3c0974b72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e7d4828422f872995d8777741b7a553", "srcset": "https://si.imgix.net/84e9b40f/uploads/origins/bbaf0cb3-a1fa-4ce9-8e2c-01c3c0974b72?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e7d4828422f872995d8777741b7a553, https://si.imgix.net/84e9b40f/uploads/origins/bbaf0cb3-a1fa-4ce9-8e2c-01c3c0974b72?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr