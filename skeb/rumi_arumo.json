=crop&crop=top&w=200&h=200&s=4ae1ba2b9a48021b40e1b7f17f1e0d85", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fba8e20e/uploads/origins/692502a3-7b3f-4c4b-8eb8-eb7cbeb9ef23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=96f6f055e726155cba79b21a391e73bd", "src_set": ""}, "body": "はじめまして、かわいいポーズでドヤ顔の猫のイラストに興味があります。\n\nhttps://imgur.com/a/1Yyz0Qw", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rumi_arumo/works/183", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 41825, "client_id": 2999713, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a40051d1/uploads/origins/8867e2e5-5572-4201-a18f-7e1577a1cd05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=da8f72f77faaa25a105f36aa06e3d52a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a40051d1/uploads/origins/8867e2e5-5572-4201-a18f-7e1577a1cd05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=686d90a0779e5985349ba571312e6e94", "src_set": ""}, "body": "こんにちは、Arumoです！私のキャラクターの仕事をお願いしたいのですが、毛皮で覆われたネズミ人間です。https://imgur.com/a/yvNd6jb、できればポーズや表情はお任せしたいです！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rumi_arumo/works/182", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 41825, "client_id": 3233370, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4458e38/uploads/origins/b629ec36-2123-48b8-8631-ea438be2c6aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e2fa6a49503c3bf1fb2f3b073ae2e55", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4458e38/uploads/origins/b629ec36-2123-48b8-8631-ea438be2c6aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3bc09007cfa36875b23debc7aa951929", "src_set": ""}, "body": "こんにちは、また一緒に仕事ができてうれしいです～ 今回は一枚の画像を依頼したいです。\n1.私のキャラクターは、前腕が灰色で、顔に黄色い星、鼻にバンドエイドをした猫です。キャラクターは男の子ですが、女の子の写真が欲しいです。(男の子→女の子）\n2.今回は、ゲームパッドのような服を着て、ゲームパッドを手に持ちながら、背景の画面を指差して「一緒に遊ぼうか」と言っているキャラクターを希望します。\n3.キャラクターのバストサイズは巨乳で描いてください（ここ重要）。キャラクターは少しふっくらさせても構いません。\n4.具体的な動きや服装、背景は自由です。また、通常のバストサイズの差分写真を添付することが期待されます。写真は横長のものが好ましいです。\n以下は私のキャラクターの設定写真と参考資料です。\nhttps://drive.google.com/drive/folders/1KWMKZMf7xaugDVma0yTuCpZHzOjF_oDi?usp=drive_link\nai翻訳XwXのため、翻訳が明確でないかもしれません、私の依頼を受け入れていただきありがとうございます。❤❤", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rumi_arumo/works/181", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 41825, "client_id": 1824761, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ef12696/uploads/origins/0edf754f-efb0-47ba-bedb-1d9719215eb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=514339ec69d94394712f1df955762ac3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ef12696/uploads/origins/0edf754f-efb0-47ba-bedb-1d9719215eb2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95f52b50e8f569b3e8da04779e9ce220", "src_set": ""}, "body": "以前より描いて頂いている、オリジナルの狼の獣人（アイコンの絵の娘）のOL姿を描いていただけないでしょうか？\n週末に仕事を終えて帰宅し、着替える時間も惜しくて、そのまま冷蔵庫から缶ビールを手に取りそのままカシュッ！…的なシチュエーションで、服装はグレーのジャケットにスカートに白いシャツ、ふっくらもちもちのお腹とお尻はスーツに“ギュッ”と押し込まれてピッチピチに、胸もボタンを外して大きく開いた所から今にも溢れそうな特盛のサイズ感でお願いします。\n“仕事や服の窮屈さから解放された嬉しさ”“大きくズッシリ”“もっちりモフモフ”感を是非ともお願いします…！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rumi_arumo/works/180", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 41825, "client_id": 1740929, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0573f78f/uploads/origins/01505d6b-bbd6-4a0d-8651-011f4f83fd52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=271990eb482032bd215592cdf29c819f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0573f78f/uploads/origins/01505d6b-bbd6-4a0d-8651-011f4f83fd52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dc6749972bc99d0326f8c0476e4f9e97", "src_set": ""}, "body": "こんにちは！私は「マルス」と「メイ」の友達です。マルスとメイは過去にあなたにFF14のフロスガーを描いてもらいました。できれば私も描いてほしいです！名前は \"アベル \"で、自信に満ちた女性です。ポーズは「メイ」のために描いた原画のように左向きで、武器に手をかけ、少しにやけた表情をしてほしいです。参考資料では見えませんが、もし描いていただけるなら、帽子から耳が突き出ているのも希望します。\n簡略化はご自由に。\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1ZHDS77YswOLQw_haUmYD0mLnIQse-vGV?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rumi_arumo/works/179", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 41825, "client_id": 1581647, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/24466ffa/uploads/origins/0c94b739-688f-4fda-a67e-aff52d7d6cad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44fdb8609791b76008c05afd12eabef3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/24466ffa/uploads/origins/0c94b739-688f-4fda-a67e-aff52d7d6cad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1eff0a2a9db2464d45b03898e759fb5d", "src_set": ""}, "body": "はじめまして！\nYoutubeで活動している、なずみと申します。\n\n流水あるもさんが描かれるコメナさんがとても好きです！\n特に昨年の12月3日にXで投稿されたコメナさんや、11月5日にXで投稿された某キャラコスプレのコメナさんが大好きです！！\nよろしければあんな素敵なイラストで私自身を描いて頂きたく、ご依頼をさせていただきました！\nご受理いただけますと幸いです！！\n\n◆依頼内容\n私自身の姿「なずみ」のイラストをお願いいたします！\n個人の活動やサムネイルなどに利用したいため、背景透過版もいただけると非常に助かります！\nXやYoutubeなどで怒られない内容であれば、服装やポーズ、構図等すべておまかせで描いて頂きたいです！\n\nぜひご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1D70OxRoRCjGyRzaSMd-6H7i9VMuILjbT?usp=share_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 18312, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "てこ@けもケットC-35", "screen_name": "teteteko", "avatar_url": "https://pbs.twimg.com/profile_images/1509910410098782211/uxaWI-MO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/63707233/1649687882/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 32}, {"id": 18416, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "まいてぃ999", "screen_name": "mighty999", "avatar_url": "https://pbs.twimg.com/profile_images/1940685394355396610/xrt7lUo6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/108440128/1744934961/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "novel"}, {"genre": "correction"}], "nc": 161}, {"id": 44042, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "とーみつ。", "screen_name": "toumitu", "avatar_url": "https://pbs.twimg.com/profile_images/1394647788051337216/kE9rqzDw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/53058216/1463211236/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_