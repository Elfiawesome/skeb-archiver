合わせて変えていただいても構いません。胸がないのはデザインした方のこだわりなので、胸は貧しくお願いします。\n\n▼衣装\n\n資料の衣装 でおねがいします\n上着は着ていても脱いでいても構いません。\n\n▼使用用途\n\n個人Vtuber活動での使用\n\nTwitterなどSNSへの掲載（投稿・ヘッダー等)\n\nYoutube配信のサムネイル、ショート動画(歌ってみた)に使用させて頂く予定です。\n\n髪の毛や頭の先や肩などが切れないものですと助かります。\n\n納品につきましては\n背景と人物が分けられた透過処理データ\npngまたはPSDデータですと大変ありがたいです。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-FgNPwNLqMmAtvW2y61fceePvlK_QmLG", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shino_nome_3/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2592680, "client_id": 302886, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/64758654/uploads/origins/f3acc9a3-b042-45f7-b495-3188fa4dc04e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d5e9f64688a7f0f399d67b9e83218aa", "srcset": "https://si.imgix.net/64758654/uploads/origins/f3acc9a3-b042-45f7-b495-3188fa4dc04e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d5e9f64688a7f0f399d67b9e83218aa, https://si.imgix.net/64758654/uploads/origins/f3acc9a3-b042-45f7-b495-3188fa4dc04e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83ca3f884bc4c1cd12d0e999ddde8a09 2x, https://si.imgix.net/64758654/uploads/origins/f3acc9a3-b042-45f7-b495-3188fa4dc04e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4fe547a81647951adf57686e4f12526d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/64758654/uploads/origins/f3acc9a3-b042-45f7-b495-3188fa4dc04e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a109261dc55f058bb5c0cc155f0fccf", "srcset": "https://si.imgix.net/64758654/uploads/origins/f3acc9a3-b042-45f7-b495-3188fa4dc04e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a109261dc55f058bb5c0cc155f0fccf, http