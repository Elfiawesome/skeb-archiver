3fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=678543cb5f1ab159dfc73ecc673db6a4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8aa5b7af/uploads/origins/7abc4404-f180-4d75-b2bc-db92de311770?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=304ace7a5bd0a55e9eea21a9ed59a3f3", "srcset": "https://si.imgix.net/8aa5b7af/uploads/origins/7abc4404-f180-4d75-b2bc-db92de311770?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=304ace7a5bd0a55e9eea21a9ed59a3f3, https://si.imgix.net/8aa5b7af/uploads/origins/7abc4404-f180-4d75-b2bc-db92de311770?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0aadc1bd90aa54f1ba502c1172582d4b 2x, https://si.imgix.net/8aa5b7af/uploads/origins/7abc4404-f180-4d75-b2bc-db92de311770?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=065bfa5b25bd40c92bb7281f5ac58b04 3x"}, "body": "この前描いてくれた姉妹ちゃんを描いてもらおうと思います！\n妹が小学3年生、お姉ちゃんが小学6年生の頃でお願いします。\n時系列的には、2人が貝合わせを覚えてからしばらく経った後です。\n\n姉妹の私服はミニスカートでお願いします。\nシチュは、お母さんたちが家にいない間に、お姉ちゃんのベッドの上で、姉妹が対面座位の形(妹の両脚がお姉ちゃんの両脚の上に乗ってる感じです)で体をくっつけてベロチューしていたら、お姉ちゃんのベロの先が妹の歯が抜けたところに差し込まれていじられ、妹はなんともいえない快感を覚えちゃうという内容でお願いします！\n唾液の糸が引く描写も入れてくださるとうれしいです。\nできればお願いします！", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@reitoko8/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3153903, "client_id": 1796767, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d7a186c0/uploads/origins/86d8817d-8df3-4316-92d0-542eb5fbd960?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cc09dcea4533e289fee37bbec20f491", "srcset": "https://si.imgix.net/d7a186c0/uploads/origins/86d8817d-8df3-4316-92d0-542eb5fbd960?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cc09dcea4533e289fee37bbec20f491, https://si.imgix.net/d7a186c0/uploads/origins/86d8817d-8df3-4316-92d0-542eb5fbd960?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a14efaac8112062de2ae0ad01ad7c44b 2x, https://si.imgix.net/d7a186c0/uploads/origins/86d8817d-8df3-4316-92d0-542eb5fbd960?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=41b92e8a629be587260ba86c18caa971 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d7a186c0/uploads/origins/86d8817d-8df3-4316-92d0-542eb5fbd960?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4fc01614eb0b8ec98dd0e3de919ebbc", "srcset": "https://si.imgix.net/d7a186c0/uploads/origins/86d8817d-8df3-4316-92d0-542eb5fbd960?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e4fc01614eb0b8ec98dd0e3de919ebbc, https://si.imgix.net/d7a186c0/uploads/origins/86d8817d-8df3-4316-92d0-542eb5fbd960?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4a291cac63c45189173cea129cfc8238 2x, https://si.imgix.net/d7a186c0/uploads/origins/86d8817d-8df3-4316-92d0-542eb5fbd960?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=42398a8e64eaed46d33e511bc71b1891 3x"}, "body": "①この前描いてくれた姉妹百合えっち漫画がすごく良かったので、また姉妹百合を描いてもらおうと思います！\nお姉ちゃんが小学4年生、妹が小学1年生の頃でお願いします。\n2人の関係は前回のリクエストで書いた通りです。\nモノクロ漫画でお願いします。\n\n②姉妹がリビングで、お母さんがこっちを見ていない間にディープキスをしちゃうという内容でお願いします。\n時系列的には2人が近親相姦をしてからしばらくたって、お姉ちゃんも妹もえっちに慣れてきた頃です。\nちなみに2人はディープキスは経験済みです。\nディープキスはお母さんにクチュクチュ音が聞こえないように、いつも以上に慎重にする感じでお願いします。\n唾液のついた口元を手の甲で拭き取る描写もあるとありがたいです。\n\n③画像サイズはおまかせします！", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@reitoko8/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3153903, "client_id": 912171, "vtt_u