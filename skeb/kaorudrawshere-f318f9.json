ge_urls": {"src": "https://si.imgix.net/e44df10a/uploads/origins/5a52c1fb-b2b5-4059-a4b1-61c913128fd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb3f16a5e9bba1b778029753245da85d", "srcset": "https://si.imgix.net/e44df10a/uploads/origins/5a52c1fb-b2b5-4059-a4b1-61c913128fd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb3f16a5e9bba1b778029753245da85d, https://si.imgix.net/e44df10a/uploads/origins/5a52c1fb-b2b5-4059-a4b1-61c913128fd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3a39bc5fefd404c19ab55a86248757d7 2x, https://si.imgix.net/e44df10a/uploads/origins/5a52c1fb-b2b5-4059-a4b1-61c913128fd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=86fc5b92322a7054d97490decdbe5f9e 3x"}, "body": "Hello, I would like to request a wholesome artwork!\n\nCharacter: Morgan (マーク♀) from Fire Emblem Awakening. She has blue-colored hair and eyes.\nOutfit: Morgan should be wearing her mother's holy queen outfit (希望を統べる女王).  \nCharacter and outfit reference: https://imgur.com/a/TSAs1uR  \n\nExpression/Pose/Background: I would like a cute pose. The remainder of the details are free for you to decide. Please do something you are comfortable with.   \n\nImportant information:  \n- Do not include the sword and shield shown in the references.\n- For more helpful reference images and inspiration, please see the reference URL which contains past art I have requested.\n\nThank you for your time.\n\nhttps://drive.google.com/drive/u/1/folders/15vlgpWHqhG_XyIYrZw4_dPvMcCHr6Q8s", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kaorudrawshere/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3829039, "client_id": 3702637, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2ff36624/uploads/origins/c760f434-112f-4b34-bd63-59f09bb14147?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f61c1cb16d3259d21c136ee2383506e6", "srcset": "https://si.imgix.net/2ff36624/uploads/origins/c760f434-112f-4b34-bd63-59f09bb14147?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f61c1cb16d3259d21c136ee2383506e6, https://si.imgix.net/2ff36624/uploads/origins/c760f434-112f-4b34-bd63-59f09bb14147?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=88bc2e13bd76810d0009aaf817b655d8 2x, https://si.imgix.net/2ff36624/uploads/origins/c760f434-112f-4b34-bd63-59f09bb14147?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab176ba9e73385cb9be84f0ac7b74086 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2ff36624/uploads/origins/c760f434-112f-4b34-bd63-59f09bb14147?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8012322ad5e21558807c6ccfbd67c167", "srcset": "https://si.imgix.net/2ff36624/uploads/origins/c760f434-112f-4b34-bd63-59f09bb14147?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8012322ad5e21558807c6ccfbd67c167, https://si.imgix.net/2ff36624/uploads/origins/c760f434-112f-4b34-bd63-59f09bb14147?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ebc044489b18d7a2707b48e7557347a3 2x, https://si.imgix.net/2ff36624/uploads/origins/c760f434-112f-4b34-bd63-59f09bb14147?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0d332fef2dac6848bd83e1286646bee2 3x"}, "body": "Hello!\n\nI love your art, and I especially love your Persona 3 fanart!\n\nIf possible, I would like to request an illustration of my character, Maya:\n\nMaya:\nhttps://drive.google.com/drive/folders/1nF3jcZ6Nccx9_sDnMCgFQcaJtB-9787Y?usp=sharing\n(Please use her short hair design)\n\nI would like her to be in the same outfit as the protagonist of Persona 3 (Makoto Yuki):\n\nhttps://i.pinimg.com/736x/66/d6/5c/66d65c43c03d6b0ef8b029902d08c25b.jpg\n\nhttps://i.pinimg.com/736x/c2/b5/ce/c2b5ce11c7425194e8abad895e194682.jpg\n\n\nI would like for her pose to be the iconic pose of the protagonist:\n\nhttps://www.reddit.com/media?url=https%3A%2F%2Fi.redd.it%2Fxpy1qccitivc1.jpeg\n\nhttps://i.pinimg.com/1200x/1f/4d/8e/1f4d8e856f7bc26fd372318e6b6980cd.jpg\n\nhttps://i.pinimg.com/1200x/1f/4d/8e/1f4d8e856f7bc26fd372318e6b6980cd.jpg\n\n(Any variation of this is good!)\n\nFor her expression, I would like for it to be similar to the first pose reference photo. While her face might not reveal too much emotion, I would like for there to be determination in her eyes.\n\nFor Maya's skin color, please refer to this photo:\nhttps://drive.google.com/file/d/1nTL2RuwixIopSgwlUqehebWQOIPtdQwy/view?usp=sharing\n\nMaya's hair has two colors: black and blue. I would like for the blue parts to be changed to match Makoto's hair color (a dark blue). I would also like for her eye color to match his eye color as well!\n\nI would like to post the final picture to Twitter, with credit. \n\nThank you so much!", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1500892, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ろっぷちょっぷ/Illustrator", "screen_name": "ropchopgraphic", "avatar_url": "https://pbs.twimg.com/profile_images/1822579655125475328/IL0q13av.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2584537100/1782020607/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 17}, {"id": 2759722, "creator": true, "nsfw_acceptable": false, "acceptable": true, 