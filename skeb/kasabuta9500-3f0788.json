=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bb00bedaaeffdca300be8d8306f80385 3x"}, "body": "失礼します。\n今回も全裸デバフのイラストお願いしたいのですがよろしいでしょうか？\n「共謀して女性鯖(とマスター)を二度と衣服着用不可にするデバフを与えるエネミーを作ったものの、結局同じように全裸にされてしまった水着BBペレちゃん(褐色)とコヤンスカヤ」のイラストお願いします。\nお互い怒鳴りあってるような雰囲気でお願いします。\n可能でしたら“この後2人には当然制裁がくわわったものの、衣服着用不可デバフが解除されることは無かった”といったナレーションがあると嬉しいです\n検討の程よろしくお願いします。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kasabuta9500/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 632029, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/99188a17/uploads/origins/60127a01-466d-4622-b178-ceebbfeeb172?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c74d42089d1624cf959842932d423635", "srcset": "https://si.imgix.net/99188a17/uploads/origins/60127a01-466d-4622-b178-ceebbfeeb172?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c74d42089d1624cf959842932d423635, https://si.imgix.net/99188a17/uploads/origins/60127a01-466d-4622-b178-ceebbfeeb172?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eaa11abe666bfcd208340ed49346dea4 2x, https://si.imgix.net/99188a17/uploads/origins/60127a01-466d-4622-b178-ceebbfeeb172?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=755c67d4d0d123af3f80bf6be2e3227b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/99188a17/uploads/origins/60127a01-466d-4622-b178-ceebbfeeb172?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4535ac07755f59d93dc9997171bdc6c0", "srcset": "https://si.imgix.net/99188a17/uploads/origins/60127a01-466d-4622-b178-ceebbfeeb172?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4535ac07755f59d93dc9997171bdc6c0, https://si.imgix.net/99188a17/uploads/origins/60127a01-466d-4622-b178-ceebbfeeb172?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b4b8754b2a9485f5542a092c7a0fe8f6 2x, https://si.imgix.net/99188a17/uploads/origins/60127a01-466d-4622-b178-ceebbfeeb172?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=58543358ee75953be86071f2a4ef4ed2 3x"}, "body": "傘ブタ様のエッチハプニング系の漫画を拝見し、是非とも依頼したくリクエスト送信致します。\n\nプロデューサーがデレマスの大石泉と鷹富士茄子の着替え場面に遭遇するラッキースケベ漫画をお願いしたいです。\n\n大石泉(https://imas.gamedbs.jp/cg/idol/detail/123)\n鷹富士茄子(https://imas.gamedbs.jp/cg/idol/detail/131)\n\n遭遇時の格好\n大石泉ちゃん.......既にトップレス状態でパンツを脱ごうとしているところ\n鷹富士茄子さん.......パンツ＋黒ストッキング姿でブラを外したところ\n\n見られた時の反応としては\n大石泉ちゃん.......目を回しパニック\n鷹富士茄子さん.......「幸運ですね〜」と余裕の表情\n\n以上、長くなりましたがご検討の程よろしくお願い致します。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kasabuta9500/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 632029, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b212b1b/uploads/origins/0857f996-99ef-4ee7-974e-568e4b05ad9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11d7ee572b97df571f07e95a313abca6", "srcset": "https://si.imgix.net/5b212b1b/uploads/origins/0857f996-99ef-4ee7-974e-568e4b05ad9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11d7ee572b97df571f07e95a313abca6, https://si.imgix.net/5b212b1b/uploads/origins/0857f996-99ef-4ee7-974e-568e4b05ad9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13c2b38be02d143948578bcf6e4bb056 2x, https://si.imgix.net/5b212b1b/uploads/origins/0857f996-99ef-4ee7-974e-568e4b05ad9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2a36301ae4e19c50c0122e455d79dc75 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b212b1b/uploads/origins/0857f996-99ef-4ee7-974e-568e4b05ad9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71fb14b833ff78b3014b1fb8dfa91948", "srcset": "https://si.imgix.net/5b212b1b/uploads/origins/0857f996-99ef-4ee7-974e-568e4b05ad9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=71fb14b833ff78b3014b1fb8dfa91948, https://si.imgix.net/5b212b1b/uploads/origins/0857f996-99ef-4ee7-974e-568e4b05ad9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=096cdcaba35a97fc1f18a88fd2f1cead 2x, https://si.imgix.net/5b212b1b/uploads/origins/0857f996-99ef-4ee7-974e-568e4b05ad9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=558d26e50bee84ab8382ce8f946b3cb8 3x"}, "body": "FGOの水着巴御前（第三再臨）をお願い致します。\n【内容】\nスキルのデメリット効果でスタン状態になったところを魔猿数匹にエロいイタズラをされる漫画をお願いします。\n\n・スタン状態になり仰向けで倒れている所を魔猿に群がられてしまう\n・ビキニを破かれてしまう\n・胸や股を吸われたり、脚等を舐めまわされたりしまう。マスターに助けを求めるものの「このままながめてるのもいいか」という感じでガン見されてしまう。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kasabuta9500/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 632029, "client_id": 70470, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6f0e55f0/uploads/origins/476fe08d-64d0-403c-bfad-b2b20fd62ccc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d862d86554808a4fdd88ea7c12d84c3", "srcset": "https://si.imgix.net/6f0e55f0/uploads/origins/476fe08d-64d0-403c-bfad-b2b20fd62ccc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d862d86554808a4fdd88ea7c12d84c3, https://si.imgix.net/6f0e55f0/uploads/origins/476fe08d-64d0-403c-bfad-b2b20fd62ccc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ea42827402b8f50b62266a10f7b93f02 2x, https://si.imgix.net/6f0e55f0/uploads/origins/476fe08d-64d0-403c-bfad-b2b20fd62ccc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a5f9dae06b756434179c3c8de57bbfb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6f0e55f0/uploads/origins/476fe08d-64d0-403c-bfad-b2b20fd62ccc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=997d8b114275a155308b1434548ba088", "srcset": "https://si.imgix.net/6f0e55f0/uploads/origins/476fe08d-64d0-403c-bfad-b2b20fd62ccc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=997d8b114275a155308b1434548ba088, https://si.imgix.net/6f0e55f0/uploads/origins/476fe08d-64d0-403c-bfad-b2b20fd62ccc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6b698c902c8070712e3102f6f08b079c 2x, https://si.imgix.net/6f0e55f0/uploads/origins/476fe08d-64d0-403c-bfad-b2b20fd62ccc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1bac18ffbc2eb41789f8ba1f774152af 3x"}, "body": "失礼します。前回は素敵なイラスト納品ありがとうございました。今回も着衣不可デバフ系シチュのイラストお願いしてもよろしいですか？\n・「敵のデバフ攻撃で二度と衣服着用できなくなり、常時全裸にされた鬼一法眼師匠とスカサハ師匠(とぐだ男くん)」をお願いします。\n・師匠達は一応手で裸を隠しているものの、呆れた感じの表情でお願いします。(ぐだ男くんは赤面させてください)\n・また、カルデアの女性サーヴァント全員に全裸デバフが適用されています(あくまで裏設定程度に思って頂ければ)\nそれ以外は自由で構いません。以上の内容となりますがよろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kasabuta9500/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 632029, "client_id": 111990, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/41f29eeb/uploads/origins/d27ef702-6a71-4edb-b73f-0da2a6800525?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=577a4a8be9dc329aa8288236cbbb45f2", "srcset": "https://si.imgix.net/41f29eeb/uploads/origins/d27ef702-6a71-4edb-b73f-0da2a6800525?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=577a4a8be9dc329aa8288236cbbb45f2, https://si.imgix.net/