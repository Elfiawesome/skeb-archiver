=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a39f3f255e27b99f3f5502e82e8619b2, https://si.imgix.net/d30cab4a/uploads/origins/df734177-d194-4ca1-a3aa-7002ff09806e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a554a945d9286ca6e78d1a66a485ba2a 2x, https://si.imgix.net/d30cab4a/uploads/origins/df734177-d194-4ca1-a3aa-7002ff09806e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2d91948938856b3d08fa2ba1e348a60d 3x"}, "body": "SAKUI様\n初めまして。私は先生の作品がとても好きです。この度、もしご都合がよろしければ、下記２点のご依頼をご検討いただけますと幸いです。\n\n1. 私の猫の擬人化：\n   身長165～172cm前後の少年の姿で、甘えん坊でありながら少し気難しい性格です。猫耳としっぽはそのまま残し、ゴシック系の王子様風の服装でお願いいたします。それ以外の部分は先生の自由にお描きください。\n\n2. 私のOCの新しい衣装：\n   彼女に西洋風あるいはゴシックロリータ風の洋装を希望いたします。髪型は変更なしで、スカートの丈は膝丈から踝丈の間で、具体的な長さは先生にお任せします。参考資料はすべてURLにあります。\n\nできましたら、2人は別々の絵にしていただき、どちらにも衣装の背面デザインを描き込んでいただけますと嬉しいです。\n\n使用用途：個人用。\n\n金額不足などがありましたら再送していただけますと幸いです。難しいと判断されましたらキャンセルしていただいても構いません。\n\nご検討いただけますと幸いです。 よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1JcIPEbHzAsxJ6MkwXGKC9AYFY16Sj5AB", "nc": 152, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0_sakui_0/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3758959, "client_id": 2730494, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6cd7fde0/uploads/origins/2fc1dd17-ff76-4706-ac9f-96e6799e9d4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0dbf0185c0ee4ff8c3598e4aa7d9d0a", "srcset": "https://si.imgix.net/6cd7fde0/uploads/origins/2fc1dd17-ff76-4706-ac9f-96e6799e9d4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0dbf0185c0ee4ff8c3598e4aa7d9d0a, https://si.imgix.net/6cd7fde0/uploads/origins/2fc1dd17-ff76-4706-ac9f-96e6799e9d4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a6eaf7af0ad6a916ba51283347d7fd7e 2x, https://si.imgix.net/6cd7fde0/uploads/origins/2fc1dd17-ff76-4706-ac9f-96e6799e9d4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3290a5921f732be2d8484431f2ed5f2f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6cd7fde0/uploads/origins/2fc1dd17-ff76-4706-ac9f-96e6799e9d4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a32092f717b7156e928e2115e327ded8", "srcset": "https://si.imgix.net/6cd7fde0/uploads/origins/2fc1dd17-ff76-4706-ac9f-96e6799e9d4e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a32092f717b7156e928e2115e327ded8, https://si.imgix.net/6cd7fde0/uploads/origins/2fc1dd17-ff76-4706-ac9f-96e6799e9d4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7643ee599eee9ff356ff6c9f593b897c 2x, https://si.imgix.net/6cd7fde0/uploads/origins/2fc1dd17-ff76-4706-ac9f-96e6799e9d4e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=459cf3e06db9a75dd1e2e7a5d1abc73d 3x"}, "body": "SAKUI様はじめまして。\n新着作品よりSAKUI様のイラストを拝見し、キャラクターの特徴を活かした服飾デザインに惹かれており、\n募集開始のお知らせを受けて居ても立ってもいられずリクエストを送らせていただきました。\n早速で恐縮ですが、以下に詳細を記載いたします。\n\n▋‎‎‎キャラクター\nアイドルのOC2名のステージ衣装デザインをお願いしたいです。（お相手の許可はいただいております）\n通常時と5年後ifの資料どちらも添付しておりますが、描きやすい方を選んでいただけたらと思います。\n\n▋‎‎‎衣装デザインについて\nユニットのイメージとしてはキラキラの王道アイドルなのですが、テーマに合わせさまざまな雰囲気をまとえる2人でもあるため、SAKUI様の解釈でお好きなようにデザインいただければと思います。\n\n▋‎‎‎資料\n資料URLをご参照ください。わかりにくい箇所はご自由に改変していただいて構いません。\n過去にデザインしていただいた衣装もこちらにまとめておりますので、参考にしていただけたらと思います。\n\n▋‎‎‎用途\n個人鑑賞、SNSへの掲載、非営利目的のグッズ作成など\n\n金額不足や内容に失礼があった場合、ご都合がつかない場合は遠慮なくキャンセルいただいて構いません。\n以上、ご確認のほどよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1-561qeBKWNYBVFZEMcjID76gIKbeYx1v?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0_sakui_0/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3758959, "client_id": 3032600, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/894ee825/uploads/origins/36e8ab97-439d-48ef-993b-05300f47aa18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96c4373b0bb7936f62b90c28724b66d5", "srcset": "https://si.imgix.net/894ee825/uploads/origins/36e8ab97-439d-48ef-993b-05300f47aa18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96c4373b0bb7936f62b90c28724b66d5, https://si.imgix.net/894ee825/uploads/origins/36e8ab97-439d-48ef-993b-05300f47aa18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61a824d8efdfcb7cc8c088ed6098edd4 2x, https://si.imgix.net/894ee825/uploads/origins/36e8ab97-439d-48ef-993b-05300f47aa18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c0da690381ad6ff5d2bff901276e6b83 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/894ee825/uploads/origins/36e8ab97-439d-48ef-993b-05300f47aa18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4762ca131d521cf32752048e87361897", "srcset": "https://si.imgix.net/894ee825/uploads/origins/36e8ab97-439d-48ef-993b-05300f47aa18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4762ca131d521cf32752048e87361897, https://si.imgix.net/894ee825/uploads/origins/36e8ab97-439d-48ef-993b-05300f47aa18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0e7fbc59f02c7b0b674c7259ff005565 2x, https://si.imgix.net/894ee825/uploads/origins/36e8ab97-439d-48ef-993b-05300f47aa18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=91657b989aaa3c571fab331c7adea3bf 3x"}, "body": "SAKUI先生、こんにちは。先生のデザインが大好きです！！本当に格好良いです！格好良くて可愛い！！\n先生のスタイルがとても好きです！！未来系の戦闘キャラクターのように見えます。\n\n今回、私のオリジナルキャラクター（OC）の衣装を先生のいつものスタイルでデザインしていただきたいです。\n未来系でも、未来系＋中国風でも、未来系＋欧風でも構いません。とにかく自由に決めてください！！先生の好きなスタイルで描いていただければ大丈夫です！\n\nOCの設定：\n身分：非人間\n　・肉体は人間によって作られた産物で、人間が使用するための人工の道具。\n　・魂は実は外から来た幽霊で、そのことを隠している。\n外見：身長155cm、見た目は約13歳、実際にこの世界に生まれてまだ6ヶ月。\n性格：表面は静かでおとなしいが、実際には世界に強い好奇心を持ち、内心はとても活発。\n特徴：\n　・緑色のリボン（額に付けている、とても重要な固定の特徴）\n　・宝石のような緑の瞳\n　・整った前髪\n　・狐のように大きくふわふわした耳と尻尾\nOCの身分は未来の人造ツールです。\n先生は彼女を戦闘用の道具にしても、癒やし用の道具にしても構いません。\nOCのメインカラーは白と緑です。\n彼女には青い幽霊の友達がいて（三つの形態に変化する）、先生の配色に青が必要かどうかに応じて、描いても描かなくても大丈夫です。\n\nどうぞ自由に描いてください！\n\nhttps://drive.google.com/drive/folders/1a27hvrJf9NMOopCL1IaqgSj4Ex0D0f0s?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0_sakui_0/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3758959, "client_id": 1840831, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/753fcab4/uploads/origins/f1061228-6494-4681-a284-3ebe74c4e11c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=422d8785b296d1a6cf24945d07987bdb", "srcset": "https://si.imgix.net/753fcab4/uploads/origins/f1061228-6494-4681-a284-3ebe74c4e11c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=422d8785b296d1a6cf24945d07987bdb, https://si.imgix.net/753fcab4/uploads/origins/f1061228-6494-4681-a284-3ebe74c4e11c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e27f904019654bb9c8e61a319135194f 2x, https://si.imgix.net/753fcab4/uploads/origins/f1061228-6494-4681-a284-3ebe74c4e11c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9920919b38b7624dd20cc67bd55b0901 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/753fcab4/uploads/origins/f1061228-6494-4681-a284-3ebe74c4e11c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1bd8030d97781f94cff1c7f66cffb880", "srcset": "https://si.imgix.net/753fcab4/uploads/origins/f1061228-6494-4681-a284-3ebe74c4e11c?bg=%23fff&auto=