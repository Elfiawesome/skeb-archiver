、アイコンやヘッダーなど。\nおうまがとき運営:インスタンス告知時。\n依頼主（イチシキ太郎）:納品後に「霜さんに描いてもらいました〜」的な画像つきツイートを一度行うつもりです。\n\n以上です。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1V-W_ksUdIr8E1uTzsGVys4W-u98GB7cL", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cultus_klatawa/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3088027, "client_id": 977345, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ddd3bed9/uploads/origins/24a98c08-ef3a-4c80-912c-ffcec2b5bcd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=729dd870384f6c68ac51d5fbc1710888", "srcset": "https://si.imgix.net/ddd3bed9/uploads/origins/24a98c08-ef3a-4c80-912c-ffcec2b5bcd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=729dd870384f6c68ac51d5fbc1710888, https://si.imgix.net/ddd3bed9/uploads/origins/24a98c08-ef3a-4c80-912c-ffcec2b5bcd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=404ac44840f5a31c365eab1f2017dc9d 2x, https://si.imgix.net/ddd3bed9/uploads/origins/24a98c08-ef3a-4c80-912c-ffcec2b5bcd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ba46bd548fa2b119432d93bceb347c3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ddd3bed9/uploads/origins/24a98c08-ef3a-4c80-912c-ffcec2b5bcd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=530314053696fbdb0604c6727a09d306", "srcset": "https://si.imgix.net/ddd3bed9/uploads/origins/24a98c08-ef3a-4c80-912c-ffcec2b5bcd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=530314053696fbdb0604c6727a09d306, https://si.imgix.net/ddd3bed9/uploads/origins/24a98c08-ef3a-4c80-912c-ffcec2b5bcd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2970e446c0c1ce270aa3ea76522e0eca 2x, https://si.imgix.net/ddd3bed9/uploads/origins/24a98c08-ef3a-4c80-912c-ffcec2b5bcd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c47e2966dab15ab842079dc82f7d59a8 3x"}, "body": "じゃがりこさん(@zyaga_zyaga1004)を描いてください\n彼女は彼岸旅館おうまがときで働く女性で、歌を披露する芸者さんです。\n\nしっとりとした歌謡曲を歌うじゃがりこさんを描いていただければと思います。\n\nツイッター(X)への投稿やツイッター(X)・VRCのアイコンとして使用する許可を私鈴蘭とじゃがりこさん双方に欲しいです\nまた、VRC上のワールドにイラストの展示許可が欲しいです\n加えて、おうまがときの告知ツイートにもイラストを使用させて頂きたいです。\n\n資料1\nhttps://drive.google.com/drive/folders/1w_n8VuHVsVeT3HPnKkXTBQkUS9DzZzzt?usp=sharing\n\n資料2\nhttps://twitter.com/convallatoxin_2/status/1584882081850888197\n\nじゃがりこさん設定文\n彼氏の周りにいてほしくないの代表の女。\n現世で一度大好きだった人に裏切られたた過去から、オンリーワンをあきらめ、数々の男の愛人になることで快楽を得る女に落ちてしまった。\n唯一の楽しみは歌うことで、プロ歌手として活動していたが、ストレスから声が出なくなったことをきっかけに自●。\n死にさまよう中で逢曲時に迷い込んだ。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@cultus_klatawa/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3088027, "client_id": 977345, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/247e6a00/uploads/origins/f79bce79-f9ef-4821-ae57-8c1cd874609c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdfde1c66ebb693c63e929041a75d58d", "srcset": "https://si.imgix.net/247e6a00/uploads/origins/f79bce79-f9ef-4821-ae57-8c1cd874609c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdfde1c66ebb693c63e929041a75d58d, https://si.imgix.net/247e6a00/uploads/origins/f79bce79-f9ef-4821-ae57-8c1cd874609c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8534cc91106d597bb2bf2b31a392472a 2x, https://si.imgix.net/247e6a00/uploads/origins/f79bce79-f9ef-4821-ae57-8c1cd874609c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=829baed164df422648160b2232097275 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src":