=9952941b1aa5a98752013504caeddfd0 2x, https://si.imgix.net/8f60744b/uploads/origins/ff5a1cd9-fa15-402d-b813-ceaf3a967a2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d85332909c7ce4f91420d7cd958d8d26 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f60744b/uploads/origins/ff5a1cd9-fa15-402d-b813-ceaf3a967a2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d305968c4199d0bdf861785e5e7d81f", "srcset": "https://si.imgix.net/8f60744b/uploads/origins/ff5a1cd9-fa15-402d-b813-ceaf3a967a2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d305968c4199d0bdf861785e5e7d81f, https://si.imgix.net/8f60744b/uploads/origins/ff5a1cd9-fa15-402d-b813-ceaf3a967a2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d507338b6af651e39761778cbe50d518 2x, https://si.imgix.net/8f60744b/uploads/origins/ff5a1cd9-fa15-402d-b813-ceaf3a967a2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8d61eb042fd6e9372699e63fb740595b 3x"}, "body": "素敵なイラスト拝見しリクエストさせていただきました\nTRPGに使用する等身の全身イラストをお願いできませんか？\n\n資料のイメージからどちらの顔、髪型、色を選んでいただいても構いませんし、お任せで好きな子をデザインしていただいても構いません！\nポーズもお任せします\n\n背景透過PNGまたはPSDをお願いします。\n\n使用用途\nTRPG立ち絵\n個人観賞用印刷\n\nどうぞご検討お願いします\n\nhttps://drive.google.com/drive/folders/1-Zhp6nGMIpBMyTqeorwF2W6qUM-S9BYi", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@loousunset/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2942705, "client_id": 1466563, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/87271462/uploads/origins/9799facb-2318-4685-a030-b044951ce01f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ff90e481a85ed3e092d3d0879b87013", "srcset": "https://si.imgix.net/87271462/uploads/origins/9799facb-2318-4685-a030-b044951ce01f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ff90e481a85ed3e092d3d0879b87013, https://si.imgix.net/87271462/uploads/origins/9799facb-2318-4685-a030-b044951ce01f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f99bc0ae875280728107090f1ca08e00 2x, https://si.imgix.net/87271462/uploads/origins/9799facb-2318-4685-a030-b044951ce01f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1876397d235167096d891316ecd249db 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/87271462/uploads/origins/9799facb-2318-4685-a030-b044951ce01f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9bd5c12979f20108494086731e8ad96c", "srcset": "https://si.imgix.net/87271462/uploads/origins/9799facb-2318-4685-a030-b044951ce01f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9bd5c12979f20108494086731e8ad96c, https://si.imgix.net/87271462/uploads/origins/9799facb-2318-4685-a030-b044951ce01f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6bae8ca4c0a8e4ed28dedd666da07d17 2x, https://si.imgix.net/87271462/uploads/origins/9799facb-2318-4685-a030-b044951ce01f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7bf6f0170016776c439c3deb9fdf9b35 3x"}, "body": "こんにちは！\n今回はわたしのオリジナルキャラクター「銀」と「白金」のボーイズラブ漫画をお願いしたいです。\nそれぞれのキャラクターについては銀はこちらのツイートリンクのぷらいべったー( https://twitter.com/elements_oo/status/1435798009501995013?s=46&t=wFe76gGQioGO2XC8GzHJzw )、白金はこちらのツイートリンクのぷらいべったー( https://twitter.com/elements_oo/status/1440683546465619976?s=46&t=wFe76gGQioGO2XC8GzHJzw )をご参照ください。\n内容は自分のアイディアにない銀と白金のボーイズラブストーリーが読みたいので、お任せします。カップリングの左右に関しましても、こだわりや苦手はないので描きたいと思ったものを描いてください。R表現のぬるさもそら様にお任せします。\nストーリーお任せが難しければ、拙作のボーイズラブ小説( https://twitter.com/elements_oo/status/1445004360132403210?s=46&t=wFe76gGQioGO2XC8GzHJzw )がございますので、この作品のどこか気に入ったシーンやよかったと思うシーンを漫画化してください。\n\n作画について、色はモノクロで大丈夫です。仮にカラーをつけるとしても、簡易なもので構いません。背景も簡易なものか、目立つコマのみでも構いません。ゆる〜くいちゃいちゃしてる二人が見たいです。明るいネタでも暗いネタでも大好きですので、どちらでもお好きな方を描いてください。\n\n他に解釈の資料となるものに関してこちら( https://twitter.com/elements_oo/status/1574691917526609921?s=46&t=wFe76gGQioGO2XC8GzHJzw )や、こちら( https://twitter.com/elements_oo/status/1588671755144802304?s=46&t=wFe76gGQioGO2XC8GzHJzw )をご参照ください。また、当方苦手な性癖は一切ないので、何をぶつけても大丈夫です。描きやすいように描いていただければと思います。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 117364, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "五十嵐万剛", "screen_name": "idenma", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fmisskey%2F88ac99f3-2606-480c-b4dd-99a9d8d0dd74.png&avatar=1", "header_url": "https://media.misskeyusercontent.jp/misskey/24315e06-ec49-4a0c-beef-83acede9b9ea.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 33}, {"id": 346172, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "メガクラ禁止@(土)東３ ユ40b/(日)東７ Ｃ41a", "screen_name": "megacra", "avatar_url": "https://pbs.twimg.com/profile_images/1698521467841859584/5OkAPi2e.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1059670093/1748235668/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 49}, {"id": 1369951,