束(SMのアームバインダーみたいな)orマミフィケーション状態で足首から首の根元まで拘束\n\n足裏、足の指の間をくすぐる　くすぐりの刑\nくすぐる方法は同じくお任せ\n\n表情差分目隠し差分もヒカリのくすぐりの刑と同じで\n\n\nコチラのパターンでは猿轡orマスク差分や最初と最後の部分や表情差分をどうするかはご自由に\n\n\n改めて検討お願いします！", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hello_pty/works/15", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/dc66caa9/uploads/origins/67257152-d230-4baf-a86e-b7605a2f606f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0a545295a70fef448c2a59392ad3811e", "srcset": "https://si.imgix.net/dc66caa9/uploads/origins/67257152-d230-4baf-a86e-b7605a2f606f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0a545295a70fef448c2a59392ad3811e, https://si.imgix.net/dc66caa9/uploads/origins/67257152-d230-4baf-a86e-b7605a2f606f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b0d59941f7a55ef4899744d6e1fafdfd 2x, https://si.imgix.net/dc66caa9/uploads/origins/67257152-d230-4baf-a86e-b7605a2f606f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=339162c461b81c2c7a1c58a1ef3a90b8 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 889786, "nc": 32}, {"path": "/@Hello_pty/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 889786, "client_id": 1613308, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/37afb367/uploads/origins/17682ebb-de1c-44ed-bc11-2fc0e5627ab3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a99674ac54334afc928037215b8dd2f5", 