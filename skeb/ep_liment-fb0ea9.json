feab6c0/uploads/origins/d9102607-5399-4ee5-8478-d85702a0e515?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5097f42cfd2ba61ee19c0e4d31149d8c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4feab6c0/uploads/origins/d9102607-5399-4ee5-8478-d85702a0e515?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fef5e4339c70daf331001dc0bdf232fb", "srcset": "https://si.imgix.net/4feab6c0/uploads/origins/d9102607-5399-4ee5-8478-d85702a0e515?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fef5e4339c70daf331001dc0bdf232fb, https://si.imgix.net/4feab6c0/uploads/origins/d9102607-5399-4ee5-8478-d85702a0e515?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=478ce90d6114b4ac1fc4ad4c1433d557 2x, https://si.imgix.net/4feab6c0/uploads/origins/d9102607-5399-4ee5-8478-d85702a0e515?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fa88a64f68cb4f949212c5330ab23967 3x"}, "body": "こんにちは！はじめまして。\n\nふうりんそう先生のイラストの背景や構図が好きなんです。どのシーンも面白い物語の一部であるかのように見えます。\n\n私のコメディ・ロマンス漫画「暗殺者も英語を習いたい」のオリジナルキャラクター2人のイラストを描いていただきたいです。 \n\n森血夏（もり・ちなつ）は内気で不器用な暗殺者です。\n\nアリス・シンクレアは血夏ちゃんの元気な英語の先生です。\n\n血夏ちゃんとアリスちゃんが東京の街中や地下鉄の駅などで、楽しそうに一緒に歩きながらおしゃべりをしている様子を描いていただけませんか？できれば、前回のイラストのように、背景に血や暗殺が行われたことを示すようなものを加えていただけないでしょうか：\nhttps://twitter.com/ep_liment/status/1418879526361190400/photo/1\n\n明るいキャラクターと少し不穏な背景のコントラストがあると良いのですが、自由に変更していただいて構いませんので、よろしくお願いします。\n\n\nキャラ資料：\nhttps://pipmurphy.com/awtletrefs.html\n\nhttps://pipmurphy.com/awtletarchive.html\n\n用途：主にイラストを見て楽しむためです。できれば、個人サイトの「他のクリエイターの作品」に掲載したいのですが。ふうりんそう先生のTwitterのアカウントにリンクを貼ります。\n\nご検討いただけますと幸いです。よろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ep_liment/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2628467, "client_id": 118618, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3bb36a6b/uploads/origins/74951ffb-76cb-47b3-a323-7ef5762aa637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=487e9cb4751d5ce6bf95ac85f47f3293", "srcset": "https://si.imgix.net/3bb36a6b/uploads/origins/74951ffb-76cb-47b3-a323-7ef5762aa637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=487e9cb4751d5ce6bf95ac85f47f3293, https://si.imgix.net/3bb36a6b/uploads/origins/74951ffb-76cb-47b3-a323-7ef5762aa637?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a7251fb33328874f3c6302177be62956 2x, https://si.imgix.net/3bb36a6b/uploads/origins/74951ffb-76cb-47b3-a323-7ef5762aa637?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=834637b0ece290068ffd9410bf90653c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3bb36a6b/uploads/origins/74951ffb-76cb-47b3-a323-7ef5762aa637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a25767de7fa16a7fd464d2eaae3f4e3", "srcset": "https://si.imgix.net/3bb36a6b/uploads/origins/74951ffb-76cb-47b3-a323-7ef5762aa637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a25767de7fa16a7fd464d2eaae3f4e3, https://si.imgix.net/3bb36a6b/uploads/origins/74951ffb-76cb-47b3-a323-7ef5762aa637?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7411a1c89208114fce623afd866f12a7 2x, https://si.imgix.net/3bb36a6b/uploads/origins/74951ffb-76cb-47b3-a323-7ef5762aa637?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f1ae12aafe61f12ea705dc04641f85df 3x"}, "body": "ふうりんそう様\n\n私のOCの女の子2人をお願いします\n\n一人ずつでもまとめてでも良いです\n\nそれぞれレイヤー分けをお願いします\n\n構図服装髪型アクセサリー、小物などなど色々お任せします\n\n背景は凝った感じが良いです\n\n二人はチグハグで仲良しな恋人です\n\nよろしくお願いします\n\n\nhttps://drive.google.com/drive/folders/1-c3XFZhfR3LbmKQWIm9Ufu4PK5HBwz3h", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ep_liment/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2628467, "client_id": 2168110, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4bfe616/uploads/origins/06d43e03-ef62-46cc-aa57-aef1e04d4b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98b50d95b287898031a56b25bd0a1db9", "srcset": "https://si.imgix.net/f4bfe616/uploads/origins/06d43e03-ef62-46cc-aa57-aef1e04d4b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98b50d95b287898031a56b25bd0a1db9, https://si.imgix.net/f4bfe616/uploads/origins/06d43e03-ef62-46cc-aa57-aef1e04d4b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6464943b709c14803c7fb626d8b7169a 2x, https://si.imgix.net/f4bfe616/uploads/origins/06d43e03-ef62-46cc-aa57-aef1e04d4b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3232f77b29aa9172f4c442276c0ea6c9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4bfe616/uploads/origins/06d43e03-ef62-46cc-aa57-aef1e04d4b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e775afa0ea8736d52215448f7a646974", "srcset": "https://si.imgix.net/f4bfe616/uploads/origins/06d43e03-ef62-46cc-aa57-aef1e04d4b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e775afa0ea8736d52215448f7a646974, https://si.imgix.net/f4bfe616/uploads/origins/06d43e03-ef62-46cc-aa57-aef1e04d4b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9bd6ca218dcb6c2de63648cfd082043d 2x, https://si.imgix.net/f4bfe616/uploads/origins/06d43e03-ef62-46cc-aa57-aef1e04d4b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2639175b7131a5a996b4c4218629fb70 3x"}, "body": "絵のタッチがすごく好きな感じだったのでご依頼しました...！\n雑踏をテーマにうちのOCをお願いすることは可能でしょうか...？ \n参考までに設定は以下のとおりですが、デザインや構図など自由に描いていただいて構いません。また、描きたいテーマなど他にあれば自由に決めていただいて大丈夫です。\n███\n＜皇すらら＞ \n自分はマダマテによって生み出された皇すららのクローンではないかと疑っている。  \nオリジナルは数年前に事故死している。  \n無茶なクローニングで蘇らされているため、突然死することも度々あるが、死ぬ度にマダマテによって蘇らされている。\n\n＜マダマテ＞\n皇すららのペットの子犬。\n（皇すららは子犬と思い込んで子犬と言い張っているが、どちらかと言えばうさぎにも見えなくない。）\n名前の由来は「待て」が覚えられないことから。\n周囲の生命体を素材に皇すららのクローンを生み出し続ける元凶。\nオリジナルが仲良くしていた者にしか懐かず、その者だけはクローンの素材にされない。 \nマダマテの放つ胞子の影響を受けたものは、アメーバ体と呼称される化け物に変貌する。\nアメーバ体が一定量生み出されると、アメーバ体は一箇所に集合して子実体を形成する。 \n子実体頂部の核内で形成された皇すららのクローンは、急速に成長が促進され、数日ほどで元の姿と記憶を継承して排出される。\nなお、排出される以前の核内での事については個体差もあるが多くのクローンは夢として認識している。\n███\n宛名・背景はpsdでon/offできると幸いです。\n使用用途は個人活動全般(小説の挿絵等、SNSや個人サイト等でのキャラクター紹介・個人活動の告知等、コミッションでのリクエストのための参考資料等)を考えています。\nもしご都合が合えばよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-DC54qVFtGUFP-9T0gu-zLkbOKQFZ6TK", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ep_liment/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2628467, "client_id": 1994084, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b03b9586/uploads/origins/12688beb-c8f7-4a3c-84fd-5660c5fec2e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47993c0429858438c5eb9e88f957084f", "srcset": "https://si.imgix.net/b03b9586/uploads/origins/12688beb-c8f7-4a3c-84fd-5660c5fec2e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47993c0429858438c5eb9e88f957084f, https://si.imgix.net/b03b9586/uploads/origins/12688beb-c8f7-4a3c-84fd-5660c5fec2e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0222c71006dbab3b4f08d2157e503fe3 2x, https://si.imgix.net/b03b9586/uploads/origins/12688beb-c8f7-4a3c-84fd-5660c5fec2e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a7c99