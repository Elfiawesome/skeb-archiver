SNeKkb\n\n◆使用用途\n１　クライアントガイドラインに示される範囲に加え、非商用利用の個人用グッズへの利用（自分用のマグカップへのイラスト印刷等）\n\n２　Vtuberシマナガエナさん（@Ena_Shimanaga ）の配信活動に使用する許諾\n　○　シマナガエナさん本人のTwitter等SNSでの宣伝・告知画像\n　○　同本人のYouTube等の動画配信サイト（収益化済み）におけるサムネイルや投稿動画内における素材利用\n　○　クリエイター「サラキ」様からの個別許諾が得られた場合、許諾条件の範囲内におけるシマナガエナ様の配信活動に関連する有償グッズへのイラスト利用\n　○　上記に使用できる背景透過画像をセット\n　○　上記利用に必要な範囲での画像のトリミングなど、必要最小限の加工", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@saraki1119/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 19358, "client_id": 29647, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c8cadddd/requests/2395?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd5ec7117b005088f14cea2a2086056e", "srcset": "https://si.imgix.net/c8cadddd/requests/2395?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd5ec7117b005088f14cea2a2086056e, https://si.imgix.net/c8cadddd/requests/2395?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=deab0ec0046bcbd3c917ef0dc1331887 2x, https://si.imgix.net/c8cadddd/requests/2395?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e84d539e41c5e87134cdc9b642ea34ca 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c8cadddd/requests/2395?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2eaeb3c179517258c19ac76354a37a7", "srcset": "https://si.imgix.net/c8cadddd/requests/2395?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2eaeb3c179517258c19ac76354a37a7, https://si.imgix.net/c8cadddd/requests/2395?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=43833f2bfc4e634b0062c04dd320e485 2x, https://si.imgix.net/c8cadddd/requests/2395?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=20