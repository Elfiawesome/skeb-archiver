ます。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@iyo_yom/works/53", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4c5f8abb/uploads/origins/fa52b4bd-437b-450e-a180-b26a5b4d536a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=56f7ced8e63dc74f702648876192bf27", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1147438, "client_id": 864722, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@iyo_yom/works/52", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1147438, "client_id": 401919, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/29a3ab28/uploads/origins/99739234-63c1-45ad-918b-d32fbc1a63a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f8d9ba03a8251387c465ea45047c1bf", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/29a3ab28/uploads/origins/99739234-63c1-45ad-918b-d32fbc1a63a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=046bd49f66cfc5d84a6ea66e8dbb9bed", "src_set": ""}, "body": "美しいサキュバスのお姫様がいる。ピンクとブルーのかわいい髪にカラフルな大きな目。お姉さんタイプ。おっとりとした穏やかで優しい笑顔の持ち主。控えめな服を着ているが、カーヴィーなエロティックボディが見える。\n\nかわいい主人公の男の子がいる。\n目が大きく、小柄でかわいい。\n髪は長い。かわいい女性のヘアスタイル。\nペニスは柔らかいままで下を向いている。\n\n少年は世界を救った。彼は以前、王女を救った。\n少年は人間にではなく、サキュバスの王女に告白した。\n王女はとても喜んでいる。彼女は少年の本当の性欲を理解した。\n怪物ホモレイプ。\n\n(アートワーク）\n大きないやらしいモンスターのペニスがたくさん登場する。ペニスは馬よりも大きい。\n少年は大きなペニスによって容赦なく犯される。\nサキュバスは非常に愛情深い。彼女はいつも少年を抱きしめ、支えている。ディープキスをし、少年を抱き寄せ、母乳を与え、乳首をいじめるなど。\nその後、彼女はBDSMの服を着る。\n\n少年の小さなペニスが精液を噴き出す。彼の顔は泣