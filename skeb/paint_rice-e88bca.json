top&w=200&h=200&blur=200&s=3006f47783120a86259e7753bdd8bed6", "srcset": "https://si.imgix.net/061c900f/uploads/origins/9bd208fe-7e20-4e3b-92b2-782dfc3ada74?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3006f47783120a86259e7753bdd8bed6, https://si.imgix.net/061c900f/uploads/origins/9bd208fe-7e20-4e3b-92b2-782dfc3ada74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eec64b84c07132eb6ae9088d6e229744 2x, https://si.imgix.net/061c900f/uploads/origins/9bd208fe-7e20-4e3b-92b2-782dfc3ada74?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5382fcec862e9810019f5b3ae157091a 3x"}, "body": "はじめまして、先生！\n\n\nウマママのリクエストをお願いしたいです！\n\nメジロドーベルがトレーナーと結婚した未来の視点で、自分の娘とハグする絵をお願いしたいです。\n\nhttps://imgur.com/a/ELK9PN9\n\nこれはドーベルとその子供であるホウオウドリームの写真です。\n\nこれと似たポーズで、「ママ、大好き！」モードの娘ちゃんがドーベルに甘えている絵を描いてください。\n\n台詞も同様に温かい感じでお願いします。\n\n\nよろしくお願いします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@paint_rice/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3089349, "client_id": 3301566, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/453a0c1a/uploads/origins/7d3e5c98-c615-422e-88ea-1af438c75a7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=382e952c8452e4c841a18047c32e1884", "srcset": "https://si.imgix.net/453a0c1a/uploads/origins/7d3e5c98-c615-422e-88ea-1af438c75a7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=382e952c8452e4c841a18047c32e1884, https://si.imgix.net/453a0c1a/uploads/origins/7d3e5c98-c615-422e-88ea-1af438c75a7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3fc24d3b0a78e841f1df8a338791e377 2x, https://si.imgix.net/453a0c1a/uploads/origins/7d3e5c98-c615-422e-88ea-1af438c75a7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=db7eb8990f3b227022e09de1f422b2d9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/453a0c1a/uploads/origins/7d3e5c98-c615-422e-88ea-1af438c75a7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e784dc30911f9016e7a977996e96bbf", "srcset": "https://si.imgix.net/453a0c1a/uploads/origins/7d3e5c98-c615-422e-88ea-1af438c75a7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e784dc30911f9016e7a977996e96bbf, https://si.imgix.net/453a0c1a/uploads/origins/7d3e5c98-c615-422e-88ea-1af438c75a7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=687d7966484855e91068a2010746251f 2x, https://si.imgix.net/453a0c1a/uploads/origins/7d3e5c98-c615-422e-88ea-1af438c75a7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ea5ddd28535348c9a6864a7f3ee4398e 3x"}, "body": "お久しぶりです！らいす。さん！勇者です！\n今回もまた『J2主アイ』の漫画のネタが思いついたので、リクエストします！\n希望する登場人物、あらすじをご紹介します！\n\n①登場人物\n⒈主人公(ドラクエジョーカー2)\n・アーモンドアイ担当トレーナー\n・アーモンドアイの事を好意に想ってる\n\n⒉アーモンドアイ(ウマ娘)\n・主人公の事を好意に想ってる\n\n⒊ベロニカ(ドラクエ11)\n・⒈の主人公の先輩トレーナー設定\n・⒈の主人公を大事な後輩としてる\n\n②あらすじ\n⒈ある日、三人でトレセン商店街を歩いていた中、福引チャンスが開催されていた。\n↓\n⒉興味半分で三人は福引チャンスの報酬を見たら、特賞として温泉旅行付きがあったので、温泉が好きなアーモンドアイとベロニカは行きたがっていた。\n↓\n⒊日々、G1戦等で沢山勝利を収めたアーモンドアイ、日々お世話になってるベロニカに対してここはお礼の形になるのではないかと咄嗟に考えた主人公は、ここは自分が引くと2人に言うと、2人は嬉しくなり、目指すは特賞として女の子2人でエールとして応援する事になる。\n↓\n⒋主人公がくじで勇んで引いた結果、本当に見事特賞当てる事に成功！2人は凄く喜び眩しい笑顔になると、主人公は元々女の子慣れしていないという事もあり、照れた感じになった。商店街ではそんな3人の様子を微笑ましく見ていた。\n\n以上になります！\n前回のらいす。さんの『J2主アイ』はとても良かったので、今度も期待します！\n是非何卒ご承認の程よろしくお願いします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@paint_rice/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3089349, "client_id": 1640731, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/66084182/uploads/orig