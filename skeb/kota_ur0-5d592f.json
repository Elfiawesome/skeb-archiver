.net/f7e6e829/requests/95900_2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=537d7adfd3f5c4fa6d4e2220f795bad0 3x"}, "body": "こんばんは。スタイリッシュでファッショナブルな女の子二人を炬太郎さんの絵で見たいと思いリクエストしました。\n\n⚫︎女の子二人の年齢や服装や装飾、メイク、容姿などは炬太郎さんの好きが詰まった感じで構いません。\n⚫︎特殊な世界観より、現代的なイメージです。\n⚫︎二人の距離が少し近め（同じフレームに収まろうとするような距離感）だと大変嬉しいです。\n⚫︎ 絵のどこかに炬太郎先生のお名前（サイン？ ）を明記して頂ければ尚嬉しいです。\n\n⚫︎炬太郎さんご自身が部屋に飾りたくなるような…を基準に楽しく描いて頂ければ十分です…！\n\n⚫︎もし承認してくださったら、完成した絵は自分で印刷して部屋に飾る事を考えています💘\n\n以上になります。\n漠然としていて掴み難い内容で申し訳ありません。\n初めてskebを利用するので至らない点があるかと思います。安価な金額でいくつも箇条書きしてリクエストしてしまいお恥ずかしい限りですが、普段からお仕事・同人活動共に心から応援しています。\n\nお忙しい中ここまで目を通して頂いた事感謝します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 34729, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "どくらべ_dokurabe", "screen_name": "10nihati", "avatar_url": "https://pbs.twimg.com/profile_images/1627352339677085697/JkI4QeK1.png", "header_url": "https://pbs.twimg.com/profile_banners/127785413/1769612813/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 291844, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぺぽよ", "screen_name": "pepoyoPPY", "avatar_url": "https://pbs.twimg.com/profile_images/2039685246707503104/Y1ex6-ib.jpg", "header_url": "https://pbs.twimg.com/profile_banners/996864025634877440/1767278641/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "voice"}], "banned": false, "nc": 160}, {"id": 381492, "creator": true, "