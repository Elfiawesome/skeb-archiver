rc": "https://si.imgix.net/c271786b/uploads/origins/1277a9b8-06cd-4200-ab14-71700e2854cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1e0b673ea140cebd6f2459de68ebb36c", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 92373, "client_id": 1614854, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hana_tsuru_wo/works/353", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a7da799c/uploads/origins/342be5df-1f36-49dc-9b36-b8c4fa073766?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7477789ffaa0720d89ca312b4dbfdad2", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 92373, "client_id": 1936938, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hana_tsuru_wo/works/352", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 92373, "client_id": 3575618, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6f2b9af/uploads/origins/eee36467-c398-4b1e-99d1-6e74f092e9a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=daa9d85dc59d99febb6aa974c4a7f012", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6f2b9af/uploads/origins/eee36467-c398-4b1e-99d1-6e74f092e9a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0b14159723e429f96bfa159052ac433", "src_set": ""}, "body": "初めまして。素敵なイラストをいつもありがとうございます！はなつるヲ様の描く可愛らしい瞳が特に大好きで、日々癒されています。\n\nお忙しくなければ、OCのイラストの依頼をお願いしたいです。\n\n個人の観賞用として楽しみたいのと、友人をイメージしてOCを考えているので、その友人と自分(計2人です)でアイコンとしても使用したいのですが大丈夫でしょうか？\n\nもし大丈夫そうでしたら、キャラクターを2人、イラストも2つお願いしたいです。\n\n\n【キャラクターA】\n亜麻色の髪と瞳、垂れ目です。ゆるふわパーマのかかった長髪で、上品で大人しそうに見えるけど、好奇心旺盛な女の子。FGOのマリーちゃんみたいな雰囲気の子です。\n服装は制服のブレザーでお願いします。\n\n【キャラクターB】\n焦げ茶色の髪と瞳、丸くて大きめな目です。肩につかない程度の髪の長さで後ろで1つに纏めていて、親しみやすそうな、どことなくコーギーを連想させる雰囲気の女の子。\n服装はセーラー服でお願いします。\n\n2人とも華奢で細身な感じです。\n\n1枚目はつまらなそうにしている2人の、正面を向いたイラストをお願いしたいです。\nAとBの間にも距離があり、視線の先もお互いではなく、端を向いている感じです。それ以外のポーズは特に決まっていないので、描きやすい感じでお任せしたいです。\n\n2枚目は楽しそうに自転車に2人乗りをしている2人をお願いしたいです。斜め正面を向いている感じで、疾走感のある感じだと助かります。\n2枚とも背景はなしで、透過データで頂けますと助かります。\n\nOCなので、一応細かく書かせて頂きましたが描きやすいように描いてくれると嬉しいです。\n因みにお値段の方はもう全く検討がつかないので、適当な金額を入力しています。\n\n色々注文してしまいましたので難しければ、自転車2人乗りのイラストだけをお願いしたいです。それも難しいようでしたら、お断りして頂いて構いません。\n初めての依頼で慣れておらず、何か失礼があったら申し訳ありません。\n\nどうぞよろしくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hana_tsuru_wo/works/351", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7a705081/uploads/origins/95ac48f7-b14c-4b98-95f1-041744c908f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8eaddc6d422842e908055d73dc92912e", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 92373, "client_id": 1936938, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hana_tsuru_wo/works/350", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 92373, "client_id": 2391390, "vtt_url": null, "thumbnail_image_urls": {"src": 