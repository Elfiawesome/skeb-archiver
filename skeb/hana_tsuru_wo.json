": "art", "tipped": true, "creator_id": 92373, "client_id": 286127, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hana_tsuru_wo/works/357", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 92373, "client_id": 2767233, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/340b44ff/uploads/origins/5b8b8887-0c08-41d5-9d76-108827a1fbe5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4aecdd52a68ded39c50e1d2257695f4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/340b44ff/uploads/origins/5b8b8887-0c08-41d5-9d76-108827a1fbe5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d4ddea8149cb1574ca829cb5ee753893", "src_set": ""}, "body": "こんにちは、私のキャラクター「アクム」のデッサンをお願いしたいのですが！\n\n可能であれば、psdでファイルを提供していただけないでしょうか？(可能であれば、リファレンスにあるキャラクターの表情の違いも描いてください！（通常/他の表情の時は黄色い目、「YD3/6/8」の時は赤い目）\nカナリアの「ヨイドレ白洲」の楽曲カバーのため、アスペクト比16:9でイラストを描いていただけませんか？\n可能であれば、ドライブで参考にしたこのチャイナ風のシャツを着たキャラクターと、タバコの代わりにチャイナパイプ（ポーチなし）を吸っているキャラクターも描いてください！\nその他、あなたのスタイルに合うように要素を変更したり、追加したいものを自由に追加してください！\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1kfEfzU_U4KFNXsfvFhkBSPCd8uzn7ma9?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hana_tsuru_wo/works/356", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 92373, "client_id": 1166388, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/47ecc637/uploads/origins/66ec9862-4a51-455c-a6da-00013f7af85f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7fcc33d6b29b94297b8bd3d9e9a309e6", "src_set": ""}, 