=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b55fbeab34e2247f021032e41d2be22", "src_set": ""}, "body": "こんにちは！こんなに早くご連絡して大変申し訳ないのですが、前回の依頼がとても気に入りました。\nまた私のキャラクターを描いてほしいです。参考資料をご覧ください。\n\n好きなように描いてください。よろしくお願いします。\n\nhttps://drive.google.com/drive/u/1/folders/1Ovq10TsSCVzTP3Q_CPAaeJrvTpcYjrNR", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hana_tsuru_wo/works/345", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 92373, "client_id": 3386717, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ed6ee722/uploads/origins/2b9be9a2-c9cd-4297-8380-7121c613efd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=091df0f18c3a77891fa90808422b9022", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ed6ee722/uploads/origins/2b9be9a2-c9cd-4297-8380-7121c613efd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e7af3e2bf79994943bf6b481bb385cc", "src_set": ""}, "body": "こんにちは！FFXIVのキャラクターを描いてほしいです。\n\n彼女は一般的に控えめで、ほとんどの人に対して冷淡です。自分の能力だけでなく、プレゼンテーションにも誇りを持っており、孤独な印象を与える。\n\nスポットライトを浴びるのが好きで、その才能を発揮することを楽しんでいるが、実際は親しい友人や恋人に依存することが多く、少々空気が読めないところがある。  \n\n見た目とは裏腹に、料理など平凡なことが好きで、他人の世話を焼くのが得意。\n\n具体的なことはあなたにお任せします。\nありがとうございました。\n\nhttps://drive.google.com/drive/u/1/folders/1tRyXRKHecufliW6qUAngAjzJUtaMYzt0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hana_tsuru_wo/works/344", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 92373, "client_id": 45010, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7173e211/uploads/origins/64a5723f-3056-4e3f-a00f-9f42a76418e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=124987001ad73c94a369fa58381509fb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7173e211/uploads/origins/64a5723f-3056-4e3f-a00f-9f42a76418e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c01ec8ad0a87b4e879bd2fd7d8afe459", "src_set": ""}, "body": "この度はリクエストを描いてくださってありがとうございます！\n\n素敵できれいな作品を描いていただき、ずっと眺めてしまうほど嬉しいです。\n\nとても素敵なイラストだったのでskebの「印刷してお届け」を利用しようと思ったのですが、\n私の確認不足でプレビュー上のイラスト以外は利用出来ないことを、納品していただいてから知りました。\n\nそこでお手数おかけするのですが、先ほど納品いただいたイラストの宛名なしのものも\nskeb上で再度納品していただけないでしょうか？\n\n先ほど納品していただいたデータ上で宛名なしにできることは確認しております。\n\nもしよろしければ、ぜひよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hana_tsuru_wo/works/343", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 92373, "client_id": 45010, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/519c4256/uploads/origins/5be9ffa2-db2a-4a91-86b1-cbdc025a2e05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a3c8a9beb1176b3d2dcfb3dac3257ed", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/519c4256/uploads/origins/5be9ffa2-db2a-4a91-86b1-cbdc025a2e05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0cd436a22eedbc43855966fdc44c2fe", "src_set": ""}, "body": "初めまして！\nPixivでイラストを拝見し、私のオリジナルキャラの女の子をfateのメルトリリスと一緒に描いていただけないかと思いリクエストを送らせていただきました。\n\n描いていただきたいのは、オリキャラとメルトリリスが月明かりの下、湖の上に立って手を取り合って踊っている場面です。\n\nオリキャラはFGOのマスター礼装「月の海の記憶」(extraの月海原学園の制服)のタイツを履いてない服装を。\nメルトリリスは第一再臨でお願いしたいです。\n\nもし礼装が無理なら、参考資料でオリキャラが着ている服装でお願いします。\n\n\n私の中のオリキャライメージは以下のようになります。参考になれば幸いです。\n\n身長152cm。薄い藤色の髪に緑のつり目。\n後ろ髪の長さは肩につかないショート。サイドは後ろ髪より気持ち長め。肩より下のイメージです。\n正面右の跳ねた前髪と、サイドから顔にかかるはね毛？がポイント\n\n年齢は18前後。高校生です。\n普段はクールな感じの子ですが、懐いた人には甘えるタイプの女の子。\n慎重で、気になることがあればどうしてそうなるんだと考えてしまう。でも、決めるところはしっかりと決める。\nネットなど電脳系に強い。\n親友からもらったオレンジのペンダントを心の支えにしている。\n（参考資料にあるペンタント写真は紫ですが、中央部分のみオレンジ系にしていただきたいです）\n\nここまで読んでいただきありがとうございます。\n上記内容で問題ないようでしたら、ぜひよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1IPpbfrRazrEyCuCgdKnme0MQxsJdEld5?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1IPpbfrRazrEyCuCgdKnme0MQxsJdEld5?usp=drive_link", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hana_tsuru_wo/works/342", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 92373, "client_id": 702073, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d427edd3/uploads/origins/4e10b135-8831-44db-87cf-c79cbf9b8a49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80862405433a6eab6cee2a8810e944df", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d427edd3/uploads/origins/4e10b135-8831-44db-87cf-c79cbf9b8a49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=92dd8437a402bdacbd372f19b6fdf39b", "src_set": ""}, "body": "リクエストを受け入れてくれてありがとう！カラーもお願いします。\n\nhttps://skeb.jp/@hana_tsuru_wo/works/341", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hana_tsuru_wo/works/341", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 92373, "client_id": 702073, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3300d27c/uploads/origins/0527239c-981f-4ea0-b0b1-aacc644fb472?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=904a5343944b9a39157d75b4bb7c1d03", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3300d27c/uploads/origins/0527239c-981f-4ea0-b0b1-aacc644fb472?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=