23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f4dfe93c5ec76f4831171c8cc87366f", "src_set": ""}, "body": "こんにちは。以前マリーちゃんのような子、コーギーのような子の依頼をお願いした者です。とても愛らしい子達に毎日癒されながら過ごしております。その説は本当にありがとうございました！\n\nそしてお忙しい中申し訳ないのですが、またイラストをお願いしたいと思い、こちらを送らせていただきました。\n\n早速リクエストの内容なのですが、以前描いていただいたOCの子達が、海で楽しそうにしているイラストをお願いします。 \n\n詳しく、という程の説明でもないのですが、勢いのまま海に飛び込んで、そのまま楽しそうに泡と共に海の世界へと沈んでいく。\nそんな躍動感のある二人の一場面を切り取ったイラストが見たいのですが、可能でしょうか？ \n\n 服装は海なのでマリン服でお願いしたいです。 \n\n 使用用途は鑑賞や、友人と自分の二人でアイコンの使用にしたいなと思っています。\n\n因みにですが、金額の変更は問題ありません。\n\n色々書いてしまいましたが、はなつるヲ様の描く世界が大好きなので、兎に角はなつるヲ様が描きやすいように描いてくださると！助かります！\n\n段々と忙しくなる時期かと思いますので、ご縁があればで構いません。是非とも検討の程、よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hana_tsuru_wo/works/365", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d9feef4c/uploads/origins/64570ebb-cb42-481c-8428-dcd1128fd2d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9429b1378827a93ff90cabcb690708d6", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 92373, "client_id": 1936938, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hana_tsuru_wo/works/364", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 92373, "client_id": 1950083, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/563cadc3/uploads/origins/abc033e3-93f1-45f7-9105-57fab43a476e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4dba0918bb32ef3d3e148d34e7a0e8a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/563cadc3/uploads/origins/abc033e3-93f1-45f7-9105-57fab43a476e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8ef5b579d70d1d8497c7fe0b4fd735d", "src_set": ""}, "body": "こんにちは！今日はバニーの日ということで、セクシーなバニー姿のカルダを見てみたいと思います！好きなように描いてください。せっかくのバニー姿なので、色気や魅力に重点を置いてほしいです。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/10SrrNjLSijhRhZRCRzNrSSRU8P2DcjFJ?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hana_tsuru_wo/works/363", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1b8fe56e/uploads/origins/9ed2608d-acbf-49b7-8e96-626efc4203b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=280b47c5eda10ff78eb0b03e970e1bc6", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 92373, "client_id": 286127, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hana_tsuru_wo/works/362", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 92373, "client_id": 3032504, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/03e20067/uploads/origins/03bdc292-e8eb-4a1b-9d2d-78aa190a45a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed22af27944d4d2450a1c880bf6e5a7b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03e20067/uploads/origins/03bdc292-e8eb-4a1b-9d2d-78aa190a45a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f9e9393339f477c40f34a3de45700fa", "src_set": ""}, "body": "はなつるヲ様、初めまして。\n先生の素敵なイラストを拝見して、とても美しいと思ってリクエスト送らせていただきました。\n申し訳ありませんが、準備中の台湾VTuber 千眠のイラストを描いていただけますでしょうか？\n\nキャラ紹介：\n千眠は人間の夢に潜む幻想的な生き物、正体不明、見た目は大人の女性の様子です。髪型は眩しい銀髪ロング、スタイルは豊満で長身。右腕の内側、左胸の側面と左肩（後ろのほう）にほくろがあります。詳細は資料にご参考ください。\n\n服装：\nファイル名03styleの資料のような感じの服を描いていただきたいです。他の資料の服装でも問題ございません。\n\n内容：\nシチュエーションはデート中でアフタヌーンティーを楽しんでる様子です。ポーズと構図は先生にお任せいたします。\nもしよろしければ、一人称で視聴者に向いて何かをするような動き(食べさせるとか)をしていただければ嬉しいです。\n\n使用用途：\nSNS、サムネイル、配信、動画、グッズでの利用をいたします。\n納品形式：\nできればキャラと背景をレイヤー分けできるPSD資料をいただきたいですが、もし困難でしたらpng資料でも問題ございません。\n\n以上、ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1gh7CLQnU0eaE8MVYRJMLg-mot10IOW3J?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hana_tsuru_wo/works/361", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5bf9f947/uploads/origins/cb970a25-0cb0-44f5-b259-73e5537841a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b25a99fecc194b7dc23fc549672e2ec", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 92373, "client_id": 286127, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@hana_tsuru_wo/works/360", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 92373, "client_id": 1950083, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff4b4554/uploads/origins/6920b75f-f99d-4075-93dc-7a0a5e6f30d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77a36a40407f38d73bc6d95a3b34fd08", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff4b4554/uploads/origins/6920b75f-f99d-4075-93dc-7a0a5e6f30d4?bg=%23fff&auto=format%2