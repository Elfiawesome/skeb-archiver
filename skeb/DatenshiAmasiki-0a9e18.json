/uploads/origins/5c232ac0-cb49-4ed8-a7ad-58a2d1c2b639?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c8597f9714ac067cb884a649d90e717", "srcset": "https://si.imgix.net/b97d7111/uploads/origins/5c232ac0-cb49-4ed8-a7ad-58a2d1c2b639?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c8597f9714ac067cb884a649d90e717, https://si.imgix.net/b97d7111/uploads/origins/5c232ac0-cb49-4ed8-a7ad-58a2d1c2b639?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a89e53a25d2720fbff19816e3b71a3e9 2x, https://si.imgix.net/b97d7111/uploads/origins/5c232ac0-cb49-4ed8-a7ad-58a2d1c2b639?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43509a31da3a822af7157143acd2b9a0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b97d7111/uploads/origins/5c232ac0-cb49-4ed8-a7ad-58a2d1c2b639?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ceb9aa7da6d0e6b8acf189a82fc1b24", "srcset": "https://si.imgix.net/b97d7111/uploads/origins/5c232ac0-cb49-4ed8-a7ad-58a2d1c2b639?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ceb9aa7da6d0e6b8acf189a82fc1b24, https://si.imgix.net/b97d7111/uploads/origins/5c232ac0-cb49-4ed8-a7ad-58a2d1c2b639?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5454312eec6d923e3b1bf7aefb0d164b 2x, https://si.imgix.net/b97d7111/uploads/origins/5c232ac0-cb49-4ed8-a7ad-58a2d1c2b639?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=79de03d959f1337b45c34dd13eb272cc 3x"}, "body": "こんにちは。\nいつもお世話になっております。YouTubeで個人Vtuber活動している『白神さとね』と申します。\n堕天使アマシキVtuber🍊📕🌔🦇Skeb受付中🎨さんのTwitterでの素敵なイラストを拝見してぜひ依頼をしたく思い、リクエストを送らせていただきました。\n【依頼内容：今回2枚依頼したいです。】\n1枚目：Asmrやシチュエーション動画で使う予定です。背景は寝室でベットの枕やシーツを下に上目遣いをしながら普段着を着ている私のイラストを依頼したいです。ポンコツ要素を入れたいので、下着or胸がチラ見えしてる感じにお願いしたいです🙇‍♀️\n\n2枚目：わからせたくなるようなメスガキ系のイラストを依頼したいです。イメージとしてはVTuber活動をしている「しぐれうい」さんのロリキャラ風にお願いします。もし可能でしたら分からせられてる差分もお願いします。\n\nどちらもアレンジして頂いて大丈夫です。\n\nポーズと衣装、背景などのイメージは参考資料URLの方にまとめておきます。\n\n【使用用途】\nどちらもYouTube・X(旧：Twitter名)でのVtuber活動で使用したいので透過差分などがあれば助かります。\n\nhttps://drive.google.com/drive/u/0/mobile/folders/1TLSmDFtnjFFLgm0zYdF9_z2wAJ2pwVMt?usp=docs_web&sort=13&direction=a", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@DatenshiAmasiki/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 98929, "client_id": 2462762, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8df93781/uploads/origins/21a03443-9f60-4f91-859d-debb99240dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=836137f942f609bc4cd6d6f2b663000a", "srcset": "https://si.imgix.net/8df93781/uploads/origins/21a03443-9f60-4f91-859d-debb99240dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=836137f942f609bc4cd6d6f2b663000a, https://si.imgix.net/8df93781/uploads/origins/21a03443-9f60-4f91-859d-debb99240dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7661158692a26240b44bb1412bc70f00 2x, https://si.imgix.net/8df93781/uploads/origins/21a03443-9f60-4f91-859d-debb99240dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b1109832d0cbddb2434d1390c40740ff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8df93781/uploads/origins/21a03443-9f60-4f91-859d-debb99240dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8b68b19dd36ec1f89a06f06bd639a47", "srcset": "https://si.imgix.net/8df93781/uploads/origins/21a03443-9f60-4f91-859d-debb99240dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8b68b19dd36ec1f89a06f06bd639a47, https://si.imgix.net/8df93781/uploads/origins/21a03443-9f60-4f91-859d-debb99240dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=687f12dac6e3ce1da4290bae4eab99b1 2x, https://si.imgix.net/8df93781/uploads/origins/21a03443-9f60-4f91-859d-debb99240dcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=112c2509e5d256faca841f2fbc0f8121 3x"}, "body": "こんにちは！先月にFA描いて頂きましてありがとうございました。アマシキさんの絵柄がとても好みだったので、ぜひとも私のイラストを描いてほしくリクエストを送信しました。\n\n【依頼内容】\nちょっとえちちなへそ出しコーデのサンタ服でお願いします。リスナーさんに騙されて恥ずかしい服を着せられて恥ずかしがっているような雰囲気がいいです！ニーソの有無差分がもし可能でしたらお願いしたいです。\n\n資料はURLにて送ります。\n\n【使用用途】\nX(Twitter)やYouTubeでのV活動で使用したいので透過差分などがあると助かります。もしアマシキさんがよろしければグッズ販売などに利用したいとも考えております。\nお忙しいところ申し訳ありませんが、ご検討のほどよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1TLSmDFtnjFFLgm0zYdF9_z2wAJ2pwVMt?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@DatenshiAmasiki/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2c9a170f/uploads/origins/cf52982e-33fd-4efb-8ed4-94e147f992dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7de3f65d319406b70bd03081dfdfcaaa", "srcset": "https://si.imgix.net/2c9a170f/uploads/origins/cf52982e-33fd-4efb-8ed4-94e147f992dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7de3f65d319406b70bd03081dfdfcaaa, https://si.imgix.net/2c9a170f/uploads/origins/cf52982e-33fd-4efb-8ed4-94e147f992dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7dc06565f1ae554bb87fc7403ebe9124 2x, https://si.imgix.net/2c9a170f/uploads/origins/cf52982e-33fd-4efb-8ed4-94e147f992dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=