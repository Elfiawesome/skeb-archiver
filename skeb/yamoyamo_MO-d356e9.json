o use it as a thumbnail for my presentation!\n\nI'm very sorry, but I don't have a three-sided drawing. I'm very sorry but I don't have any three-sided drawings and I don't have much material. .......\nPlease check 🙇‍♂️\n\nI have attached a standing picture and the guitar I always use for delivery at the URL of the document.\n\nhttps://drive.google.com/drive/folders/1OKIsJwElxAwU-91jGnxW4AIV1RWlWkF2", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yamoyamo_MO/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a2f3779b/uploads/origins/0319c840-1fb3-4db8-afc9-be57cbe0f72b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=35aaa539462954a9c68b2aa774b8676d", "srcset": "https://si.imgix.net/a2f3779b/uploads/origins/0319c840-1fb3-4db8-afc9-be57cbe0f72b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=35aaa539462954a9c68b2aa774b8676d, https://si.imgix.net/a2f3779b/uploads/origins/0319c840-1fb3-4db8-afc9-be57cbe0f72b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41a99d515d9f54d1c69e8087fce94073 2x, https://si.imgix.net/a2f3779b/uploads/origins/0319c840-1fb3-4db8-afc9-be57cbe0f72b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d5108794b37273567321d896a6d4ec1c 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2704614, "nc": 0}, {"path": "/@yamoyamo_MO/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2704614, "client_id": 2029557, "vtt_url": nu