u do, please draw the darker version (on the left)\n\nAs for pose, anything would be fine!\n\nThank you for your consideration!\n\nhttps://imgur.com/a/dwf2c3G", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yamoyamo_MO/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2704614, "client_id": 2583586, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9de395a5/uploads/origins/3fbb17ce-3664-4f92-a0f8-89a4d90be15c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=237af2227f72f18ecd623fdcf70af1a1", "srcset": "https://si.imgix.net/9de395a5/uploads/origins/3fbb17ce-3664-4f92-a0f8-89a4d90be15c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=237af2227f72f18ecd623fdcf70af1a1, https://si.imgix.net/9de395a5/uploads/origins/3fbb17ce-3664-4f92-a0f8-89a4d90be15c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c2c884fe9f79333d1a4e7b52521c2546 2x, https://si.imgix.net/9de395a5/uploads/origins/3fbb17ce-3664-4f92-a0f8-89a4d90be15c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b494454b2f8558dc9c8f1f75f3bf52d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9de395a5/uploads/origins/3fbb17ce-3664-4f92-a0f8-89a4d90be15c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=462face0128913106bc0355ee14bc7f7", "srcset": "https://si.imgix.net/9de395a5/uploads/origins/3fbb17ce-3664-4f92-a0f8-89a4d90be15c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=462face0128913106bc0355ee14bc7f7, https://si.imgix.net/9de395a5/uploads/origins/3fbb17ce-3664-4f92-a0f8-89a4d90be15c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9cb5b7feff100a33de232ac1b8cb9c52 2x, https://si.imgix.net/9de395