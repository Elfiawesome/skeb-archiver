press&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6a0d1520e95bf55170c87e27185623c7 2x, https://si.imgix.net/aa3c7dad/uploads/origins/7238eca9-8798-4d1d-8a23-39d4e02ef200?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b060467edbe2ede552cc71e2e41060d3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa3c7dad/uploads/origins/7238eca9-8798-4d1d-8a23-39d4e02ef200?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=997941843706b06d752ad9b0d0f94641", "srcset": "https://si.imgix.net/aa3c7dad/uploads/origins/7238eca9-8798-4d1d-8a23-39d4e02ef200?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=997941843706b06d752ad9b0d0f94641, https://si.imgix.net/aa3c7dad/uploads/origins/7238eca9-8798-4d1d-8a23-39d4e02ef200?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ee9b896327947d37154c51af9c0e3bc3 2x, https://si.imgix.net/aa3c7dad/uploads/origins/7238eca9-8798-4d1d-8a23-39d4e02ef200?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a1479fd20a088b67058ec177f2f855b8 3x"}, "body": "こんにちは！\nいつもお世話になっております。\n凍結祭りでフォロワーさんがごっそりといなくなってしまい寂しいので、Mel-lightを描いて頂けないでしょうか…… \n可能であれば、私だけでなくフォロワーさんにも元気を出して貰えるようなかっこかわいい感じで……！\n\n構図などはもちろんお任せします！\n\n参考資料URL\nhttps://twitter.com/MelaleucaRaia/status/1611194186958794754?s=20&t=4MO6q3MJEQWQb7vTgNV9wA", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@peg_peg_egg/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1322876, "client_id": 1397759, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d18e6a5/uploads/origins/b280de77-be95-483c-af12-7fc336ebbac9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=891eeb374e9e95c52495d114444cc890", "srcset": "https://s