0&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f08b35391fbbd47dbeb7aec36b5c3856", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 6072, "client_id": 3535616, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@daito2141/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0fc155f7/uploads/origins/f7f55716-ef89-447d-8f70-205a99550256?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5202b9f87e0b8d31a8ed48b84514f658", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 6072, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 1, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@daito2141/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 6072, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c56ed43/uploads/origins/028e42fd-cd2e-4068-99a1-8d50f88ebec6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55f92007c3b7717afdc2ee4368ebce28", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c56ed43/uploads/origins/028e42fd-cd2e-4068-99a1-8d50f88ebec6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e767b3b93c3cfdd8d7c5e88a57e1ed73", "src_set": ""}, "body": "いつも作品楽しませていただいております。\nもし宜しければ以下の通りお願いいたします。\nフルカラーで希望します。\n\n※キャラ\n・全身が見切れずに入るようお願いします。\n・女性SP（黒髪ストレートの真面目なイメージ）\n・黒のパンツスーツ姿（一般的な女性SPのイメージです）\n・両手に極薄ゴム手袋着用\n・革靴の上にシューズカバー着用\nhttps://www.kaunet.com/kaunet/goods/42265108/\n・拳銃はPB（消音器装備）\nhttps://ja.wikipedia.org/wiki/PB_(%E6%8B%B3%E9%8A%83)\nhttps://en.kalashnikovgroup.ru/catalog/boevoe-strelkovoe-oruzhie/pistolety/pistolet-besshumnyy-pb \n・キャラ全体に返り血の付着は無し。\n\n※シチュエーション\n・実は裏切り者で、証拠を残さず警護対象と後輩の同僚1名（いずれも女性）を始末した後or始末中のシーン。\n・背景はセーフハウス室内の想定(適当で構いません)。\n・イラストとは直接関係ありませんが、後の展開はまず「仲間」が証拠品（PB等の小道具は退避前からあらかじめ持ち込まれ隠されていた）を回収し、本人は自作自演で撃たれて救援を呼ぶイメージです。\n・頼りになる優しい先輩が、実は最初から裏切っていた狡猾で冷酷なキャラだったという想定です。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@daito2141/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4e0a5e10/uploads/origins/e30c2c15-3393-4e22-9a6b-bd569e89896c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c8de179a9cbdf89a474e7d11efa575b2", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 6072, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@daito2141/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 6072, "client_id": 1467, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/525073dc/uploads/origins/0f42ef6d-abce-4fbf-9626-aab91dffd762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef9c9b405a58a785c72fbeca9d766c9c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/525073dc/uploads/origins/0f42ef6d-abce-4fbf-9626-aab91dffd762?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f4e5383f691c7f9f7d8434ffe75523c4", "src_set": ""}, "body": "いつもお世話になっております、月影楼と申します\n先生の募集開始をお見かけしリクをお送りいたしました。\n（頂いた再送依頼とは違う内容で申し訳有りません）\n\nうちのコ（OC）達の旅情風鉄道イラストをお願いいたします。\n\nキャラ：\n銀髪うちの子「アレクサンドラ」と褐色うちの子「シャリーファ」（設定資料は下記）、\n二人の旅行デート（※二人は”特に親密な\"関係です）。\n衣装は旅情や季節に合わせた身なりの良いおしゃれ着＆旅行コーデでお願いします。\n※スーツケースは個人的なこだわりなのですが、グローブトロッターのようなクラシックデザインにして頂けますでしょうか\n\t\nシチュ：\n先生がよく描かれている、ホームの電車と女の子の組合わせで、\nいわゆる高級寝台列車に今から乗り込んで旅に出発するシーンのイメージでお願いします。（スイートに乗る設定）\n電車に乗ろうとしている/電車の前で記念撮影/ホームに入線する電車を待っている　などの細かい情景はおまかせします。\n\t\n電車　：\n四季島・瑞風・ななつぼしといった高級寝台列車のどれかを選んで頂けますと幸いです\n車両のアングル（前から・後ろから・横から）はおまかせします\n\nロケーション：選ばれた電車に合わせた場所・季節のイメージで描いて頂けますと幸いです\n\n壁紙に使えるような横長比でお願いできますでしょうか。その他細かい点はおまかせ致します。\n\n宛名はPSDレイヤーでon/offできると嬉しいです。\n\nよろしくご検討お願いいたします。\n\n\nキャラ資料（アレクサンドラ＆シャリーファ）：\nアレクサンドラ基本設定：https://min.togetter.com/Re2WRf5\nシャリーファ基本設定：https://min.togetter.com/1hwbiSW\nツイッターモーメント：https://twitter.com/i/events/1206250841755156480\nこれまでのうちの子依頼：https://min.togetter.com/mqdCzfN", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@daito2141/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 6072, "client_id": 485865, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/170ca3a2/uploads/origins/8ada2854-d5b4-4a20-87b0-348d1becc406?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9077a5fd52cdf48331dd6fa0216a0152", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/170ca3a2/uploads/origins/8ada2854-d5b4-4a20-87b0-348d1becc406?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b7ab04b0375b223ea2430ed0e86df850", "src_set": ""}, "body": "どうも、はじめまして。\nこちらのカフカと列車の構図が凄く美しかったので似たような構図のイラストをオリジナルキャラクターでお願いします。\nhttps://x.com/daito2141/status/1650424348224765952\n\nオリキャラの艶乃（https://www.pixiv.net/artworks/94421156）と機関車は国鉄C62形蒸気機関車で。\n衣装は描く季節や場所にあわせて頂けると幸いです。\n後、艶乃の身長が188ｃｍ有る事に御配慮頂けると嬉しいです。\n\n問題が無ければ御検討のほどよろしくお願いします。\nm(_ _)m\n\nhttps://ja.wikipedia.org/wiki/%E5%9B%BD%E9%89%84C62%E5%BD%A2%E8%92%B8%E6%B0%97%E6%A9%9F%E9%96%A2%E8%BB%8A", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@daito2141/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 6072, "client_id": 128118, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d8710573/uploads/origins/d3bf894c-c018-4b93-bfaa-22d0a545c73f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae7acac22e0daa8977a1014eb16ffe00", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d8710573/uploads/origins/d3bf894c-c018-4b93-bfaa-22d0a545c73f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcfc466dd689240fe99c6af25f406ae5", "src_set": ""}, "body": "初めまして。\n\n恐れながら、ご挨拶ならびにリクエスト内容を送らせて頂きます。\n\n過去に『RAIL WARS! A』の表紙に惹かれて、先生のイラスト作品に興味を持ちました。\n\n先生の描く、凛とした表情の女性キャラと銃器との組み合わせが生み出す美しさに、強く魅力を感じます。\n\nまた、キャラクターや銃器、鉄道等に施された、陽の光に淡く照らさている様な表現も大変印象的で、先述の美しさに加えて仄かに幻想的な雰囲気すら覚えます。\n\n先生のイラストからは、有機物・無機物問わず、時に艶っぽさが、時に重厚感が濃密に香ってきて、銃器や鉄道に無知な私ではありますが、唸らされます。\n\nさらには、『銃×女子』のイラスト本では、オシャレにファッション要素まで溶かし込まれていて、非常に贅沢な味わいに感じられました。\n\n素敵ですね。\n\n改めまして、以下のリクエストを失礼致します。\n\nお恥ずかしながら、所謂「オリキャラ」や「うちの子」と呼ばれるものです。\n\nもしご縁がありましたら、是非腕を振るって頂けると嬉しいです。\n\nご検討の程、何卒宜しくお願い致します。\n\n\nキャラクター：姉の「涙（るい）」と、妹の「葉（よう）」です。（※1）\n構図・衣装等：先生のチョイスで、何かピンときた衣装・銃器等でコーディネートして頂けると大変嬉しいです。クール・キュート・セクシー、何れの雰囲気も大歓迎です。\n\n（※1）キャライメージにお付き合い頂けると幸いです。\n\n姉：アバウトな性格、天才肌、ポジティブ、頑張り屋な自慢の妹を甘やかしたい。\n妹：神経質、努力家、ネガティブ、姉には尊敬と嫉妬が半々でぶっきらぼうな態度。\n\n共に高校生で１歳差。姉の「紅涙」には“赤い涙”、妹の「紅葉」には“もみじ”の意味合いを含ませています。\n\n\n・キャラ資料（お目汚し失礼致します）（※2）\n\n姉（https://note.com/pokerface_4715/n/n20034c8055a3）\n妹（https://note.com/pokerface_4715/n/n53c499b97215）\n\n\n（※2）ある作品の世界観に合わせたキャラ故、便宜上作中の制服を着せていますが、その他は全てオリジナルです。\n\n\n※資料内の武器や小物（目薬・カプセル・ノートなど）は無視して頂いて問題ありません。先生の持ち味を優先して頂けたら幸いです。", "nc": 136, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 2694, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ちゅの", "screen_name": "chuno_", "avatar_url": "https://pbs.twimg.com/profile_images/1863842132617998336/kpPSsBXz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/79407182/1683107384/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 176}, {"id": 247664, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "KATくんちゃん", "screen_name": "kitmotkat", "avatar_url": "https://pbs.twimg.com/profile_images/1378343248725307392/DPIHFSsK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/988250307439222784/1649772190/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 160}, {"id": 474878, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "𝐆𝐮𝐮", "screen_name": "Guu8_", "avatar_url": "https://pbs.twimg.com/profile_images/1821217556155527170/6dcGyFzd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1036553916031201280/1686243664/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 49}, {"id": 1738259, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "識🍥skeb頑張ります", "screen_name": "siki_MHR", "avatar_url": "https://pbs.twimg.com/profile_images/1444617144868638721/QcOZzEcy.jpg", "header_url": "https://pbs.