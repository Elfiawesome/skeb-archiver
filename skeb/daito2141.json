works": [{"path": "/@daito2141/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 6072, "client_id": 130865, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b31f9180/uploads/origins/53b3df97-8bdc-4e42-9b54-ab39b6da53d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e583c00b2ccf6233f02ea56ba10fe0de", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b31f9180/uploads/origins/53b3df97-8bdc-4e42-9b54-ab39b6da53d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=369abd40f49afd0ff2d8b80651b80294", "src_set": ""}, "body": "はじめまして！\nドルフロのP90ちゃんを好きなように描いていただけませんか？\n銃もあれば嬉しいです。\n構図や衣装などはお任せします。\nご検討よろしくお願いします。\n\nこれからはアイデア出しだけです。\n下のアイデアを使わなくても大丈夫です。\n①P90ちゃんがこちらに走って突撃してきます。\n②P90ちゃんがこちらのドッグタグを回収してきます。\n③アリブレのスキンのP90ちゃんが戦術携帯ホルダーにある携帯をタップして、指示を出しています。\n\nキャラについて\nhttps://wikiwiki.jp/dolls-fl/P90#f08b27f6\n\n立ち絵\nhttps://iopwiki.com/wiki/P90#Gallery\nhttps://www.gfwiki.org/images/1/1f/Pic_P90_HD.png\nhttps://www.gfwiki.org/images/b/bc/Pic_P90_D_HD.png\nhttps://www.gfwiki.org/images/3/37/Pic_P90_2802_HD.png\nhttps://www.gfwiki.org/images/c/cb/Pic_P90_2802_D_HD.png\nhttps://iopwiki.com/images/c/cb/P90_costume2.png\nhttps://iopwiki.com/images/7/76/P90_costume2_D.png\nhttps://iopwiki.com/images/4/43/P90_costume3.png \nhttps://iopwiki.com/images/0/08/P90_costume3_D.png \n\nスキルアニメーション\nhttps://i.redd.it/cgivsavcg1221.gif", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@daito2141/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/76743769/uploads/origins/7b7110ef-7cb1-4a32-a452-9b6c37500394?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a6e72747ac344bbc960cc0e8a82192ee"