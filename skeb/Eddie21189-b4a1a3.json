45-89b8-00723e2ebe0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fef3628dde9b9b6337b266e480683017 2x, https://si.imgix.net/a00a95d5/uploads/origins/4fdb98fd-f3c7-4b45-89b8-00723e2ebe0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3dba89c4a7d4afda2b0f534a9705629 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a00a95d5/uploads/origins/4fdb98fd-f3c7-4b45-89b8-00723e2ebe0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=503159547ab1767d8682bedfd5d3af40", "srcset": "https://si.imgix.net/a00a95d5/uploads/origins/4fdb98fd-f3c7-4b45-89b8-00723e2ebe0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=503159547ab1767d8682bedfd5d3af40, https://si.imgix.net/a00a95d5/uploads/origins/4fdb98fd-f3c7-4b45-89b8-00723e2ebe0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1407212a1de66e7718fb069ad734ce1a 2x, https://si.imgix.net/a00a95d5/uploads/origins/4fdb98fd-f3c7-4b45-89b8-00723e2ebe0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=52dca0717041c8a218464744726ab7c6 3x"}, "body": "先日は古庄薫ありがとうございました。\n続編をお願いしたいです。\n資料参照願います。\n１さるしま艦長室。古庄が外からドアを開ける。中は暗い。彼女顔には表情がなく、\n瞳もハイライトはない。\n２暗い部屋は机やベッドの輪郭しか見えない。\nしかしそこに怪しく光る無数の赤い目が！\n３艦長室はRaTｔの巣となっていた。洗脳された古庄が手引きし、\n新たな繁殖場としていたのだ！\nその部屋の主は古庄ではなくネズミ。古庄は主のため奴隷としてつくす。\n胸をはだけ母乳を飲ませる。\n肛門で交尾する。\n手に乗せたネズミのペニスをご奉仕し、反対の手で手コキ。\n彼女自身は大量にトコロテンしつつ、無表情。\nベッドの上にはねずみの赤ん坊たち。古庄が生んだ。ここは子供の寝床、彼女は床で寝る。\n部屋にはチーズの食べかすや布、紙きれがかじられ散乱し、汚い。\n命令に従い彼女は奉仕し続け、気絶し倒れるまで狂乱の支配は続き、休まるときはない。\n\nという感じでお願いします、。\n前回と同じく、古庄は、頭から足先の全身図で、帽子、靴以外着衣。ノーパン、ストッキングは股間部を破り、いつでも交尾ができるようになっている。玉竿は淫水焼けでドス黒く変色。亀頭は赤黒い。\n勃起したペニスがスカートをめくりあげ状態で、お願いいたします。\n表情は悪堕ち、ただし頬の赤み、瞳のハイライトはない。\nスカートにしみ、床や足にゼリー状特濃精液の跡をつけながら、足先までの全身図が入る構成だと嬉しいです。\nアニメでは洗脳状態では表情が消え、目のハイライトがなくなる特徴があるので、こちらもそのようにお願いします。\n古庄ttps://www.pixiv.net/artworks/74239300\nttp://www.nicovideo.jp/watch/1460518351\n9;30～11;10、14;10、16;40、20;40、ぐらいの映像(ニコニコ１話、無料)を参考に。\nどうぞよろしくお願いいたします。\n\nhttps://www.pixiv.net/artworks/109616476", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Eddie21189/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 834593, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c25ebd50/uploads/origins/6c4b2bc9-9f37-4147-be92-ab04c678dfc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8afccb5b5a1c500396a74fcef75a9fa6", "srcset": "https://si.imgix.net/c25ebd50/uploads/origins/6c4b2bc9-9f37-4147-be92-ab04c678dfc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8afccb5b5a1c500396a74fcef75a9fa6, https://si.imgix.net/c25ebd50/uploads/origins/6c4b2bc9-9f37-4147-be92-ab04c678dfc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=810a86583497b675c08a011740f775a2 2x, https://si.imgix.net/c25ebd50/uploads/origins/6c4b2bc9-9f37-4147-be92-ab04c678dfc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d9c51822f001902e77aa341d7d367a0 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c25ebd50/uploads/origins/6c4b2bc9-9f37-4147-be92-ab04c678dfc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=483b39255f92808da7092560f119ced6", "srcset": "https://si.imgix.net/c25ebd50/uploads/origins/6c4b2bc9-9f37-4147-be92-ab04c678dfc5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=483b39255f92808da7092560f119ced6, https://si.imgix.net/c25ebd50/uploads/origins/6c4b2bc9-9f37-4147-be92-ab04c678dfc5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ae7420c814755fa6db4b4515c3795436 2x, https://si.imgix.net/c25ebd50/uploads/origins/