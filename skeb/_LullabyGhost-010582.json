していません。\n髪の色は灰色で、黄色ではありません。\n\nイメージ：白鴉\nスタイル：宗教・ゴシック\nシーン例：教会・礼拝堂・修道院・告解室・森・\n六翼の天使の像\n暗い、不穏的の表現も構わない、暗い雰囲気できれば嬉しいです！\nご自由に制作していただければ幸いです。\n可能であれば、装飾として白いカラスを描いていただけると嬉しいです（必須ではありません）。\n\n使用用途 : 鑑賞用。\n検討していただけますと幸いです。\n金額等不備があれば遠慮なく再送、キャンセルしていただいて大丈夫です。\nよろしくお願いします🙇\n\nhttps://drive.google.com/drive/folders/1Mo5K51786S2_LcXmUp_pYmN6Q_yC-p6t", "nc": 8, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 814740, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "みそか", "screen_name": "sm7t6", "avatar_url": "https://pbs.twimg.com/profile_images/1792225274584850432/msS6z442.jpg", "header_url": "https://pbs.twimg.com/profile_banners/803230041832198145/1721068590/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 1466913, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "めだかＨ2", "screen_name": "killifish_", "avatar_url": "https://pbs.twimg.com/profile_images/1959306089717248000/k3r7BBey.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1029339481122295808/1749563042/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 49}, {"id": 1940338, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "小宮", "screen_name": "comopon", "avatar_url": "https://pbs.twimg.com/profile_images/1518540555751370754/8D7aT8Iq.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_reque