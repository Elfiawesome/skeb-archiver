p&w=200&h=200&blur=200&s=941cd6a355268ae3d3c64d5e9631fdf4, https://si.imgix.net/d1e16be6/uploads/origins/a619d4a7-0a27-4ed1-81a0-3040e1b6d38a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b268ea011161192bacbe647351e4c162 2x, https://si.imgix.net/d1e16be6/uploads/origins/a619d4a7-0a27-4ed1-81a0-3040e1b6d38a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5d7ff2e2358f44629bc81ca2bd62a4eb 3x"}, "body": "こんにちは！前回お送りいただいた作品、本当に楽しませていただきました。今回は、私のもう一人のオリジナルキャラクター、アレックスを描いていただけませんか？彼はロシアに住む18歳の中国系ロシア人の高校生です。オタクっぽい見た目と、サメのような奇妙な歯のせいで、クラスメートからひどくいじめられています。 でも実は、こっそり殴られるのが好きなんです。ただ、恥ずかしがり屋なので誰にも言えません。あ、それと、学校の成績は実はすごく悪いんです……\n\n可能であれば、どんな衣装を描いていただいても、帽子をかぶった姿を描いていただけると嬉しいです。もしこのリクエストが不適切だと感じられたら、無理に引き受けずにキャンセルしてください！ 支払額が不足している場合は、修正した金額で再送しますので、遠慮なくお知らせください。ご配慮いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1Z_PN8H_76Agto93H1mHbkED0m1SXGFsj?usp=sharing", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takadaka_tks/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2593881, "client_id": 2554869, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c997c1a/uploads/origins/949e3716-e85e-4c03-bb41-daaa5a928658?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a398db0c7a588ba918a97e9f936d3a4e", "srcset": "https://si.imgix.net/0c997c1a/uploads/origins/949e3716-e85e-4c03-bb41-daaa5a928658?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a398db0c7a588ba918a97e9f936d3a4e, https://si.imgix.net/0c997c1a/uploads/origins/949e3716-e85e-4c03-bb41-daaa5a928658?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2283cb3c68b5ba74ca0413b2274777ae 2x, https://si.imgix.net/0c997c1a/uploads/origins/949e3716-e85e-4c03-bb41-daaa5a928658?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&