した\nにんてんどうのゼノブレイドというゲームをご存知ですか？多分ご存知じゃないかと私個人的に思いますが,\nゼノブレイド3 \"ミオ\"のコスチュームをしたルベルが見たいです!\n表情は恥ずかしいように 顔を赤くした表情がいいし,手で肩なんかを露出を隠すポーズがあるならベストです！太ももまで作業していただければ幸いです！\n(ちなみになんでよりによってこのキャラかというと声優ネタです)\n下の方に参考イラストがございますのでご確認ください, では、暑くてじめじめした天気の中でお互い頑張りましょう！ バイバイ~\nhttps://imgur.com/gallery/mio-xenoblade-3-mIHa5ig\nhttps://x.com/yanhong_lu/status/1493716017893507076", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@PEANYATTS/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3144163, "client_id": 3667228, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/82e10d33/uploads/origins/5ed3823c-7a82-44e5-9709-dd2bdbbc04b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6db2e0c8ccda935e179a0a01baea200c", "srcset": "https://si.imgix.net/82e10d33/uploads/origins/5ed3823c-7a82-44e5-9709-dd2bdbbc04b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6db2e0c8ccda935e179a0a01baea200c, https://si.imgix.net/82e10d33/uploads/origins/5ed3823c-7a82-44e5-9709-dd2bdbbc04b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02e3278c8db8d2ecbb2116fac01b7615 2x, https://si.imgix.net/82e10d33/uploads/origins/5ed3823c-7a82-44e5-9709-dd2bdbbc04b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e044e88de68902f10769d5ae46b7d4d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/82e10d33/uploads/origins/5ed3823c-7a82-44e5-9709-dd2bdbbc04b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84a2fa8cf3e0dd9aa382252a5255cf0d", "srcset": "https://si.imgix.net/82e10d33/uploads/origins/5ed3823c-7a82-44e5-9709-dd2bdbbc04b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84a2fa8cf3e0dd9aa382252a5255cf0d, https://si.imgix.net/82e10d33/upl