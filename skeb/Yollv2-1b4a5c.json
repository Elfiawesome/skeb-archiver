のデザインでアレンジしていただければ嬉しいです。\n女の子の方は笑顔、ふわふわした雰囲気、男の方は少しドライな雰囲気をもっています。\n\n・使用用途\n印刷業者様にお願いし、自分用のグッズ製作（ポスカやアクリルグッズなど）\nまた、壁紙として使わせて頂きたく思い、自分の電子媒体での鑑賞用を考えております。\n描いて下さる場合は背景透過があると嬉しいです。\nご料金が二人分足りない場合は追加して下さると助かります。お時間よろしければお願いいたします…！\n\nhttps://drive.google.com/drive/folders/13_YaHoROONjp1-ADX5jdi7_rWhHEuSUA?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@akidania/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1222028, "client_id": 3187609, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/538ad05d/uploads/origins/ccd34868-9776-484a-aaa9-7312c8617c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f099f3c5aeda62813239feef2aa43039", "srcset": "https://si.imgix.net/538ad05d/uploads/origins/ccd34868-9776-484a-aaa9-7312c8617c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f099f3c5aeda62813239feef2aa43039, https://si.imgix.net/538ad05d/uploads/origins/ccd34868-9776-484a-aaa9-7312c8617c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=365d0d694e91716f05774eed33692ad2 2x, https://si.imgix.net/538ad05d/uploads/origins/ccd34868-9776-484a-aaa9-7312c8617c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ddeb43d5e04b315f43adb01060e9029 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/538ad05d/uploads/origins/ccd34868-9776-484a-aaa9-7312c8617c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3dab309a092de9d2851fc4df24061190", "srcset": "https://si.imgix.net/538ad05d/uploads/origins/ccd34868-9776-484a-aaa9-7312c8617c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3dab309a092de9d2851fc4df24061190, https://si.imgix.net/538ad05d/uploads/origins/ccd34868-9776-484a-aaa9-7312c8617c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=75422a885d4577aea32a01bd494be40b 2x, https://si.imgix.net/538ad05d/uploads/origins/ccd34868-9776-484a-aaa9-7312c8617c7b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6571bf1923e20ca8c3efa77ae702a628 3x"}, "body": "お世話になっております！\nkitaruさんの明るく可愛いイラストが好きです。\n宜しければkitaruさんの明るい絵柄で、当方と友人の創作キャラを思うように描いて頂ければ嬉しいです。\n\n◇キャラクター\nリリー\nジェイド\n\n――\nジェイドに関しては概念、手等の体の一部での描写でも嬉しいです。\n（難しい場合はメイン：リリー一人で大丈夫です…！）\n描写範囲は金額に無理のない範囲でお願いします。\n\n目線こちらでなくて大丈夫ですので、宜しければ日常のような雰囲気のもの。\n難しければ描いて頂けるだけで嬉しいので、描きやすいポーズでおまかせします…！\n服装アレンジ、髪型等も変更していただいて大丈夫です。\n\n◇使用用途\n個人観賞、また、印刷業者を通した個人利用の範囲のグッズ（ポストカード等）にさせて頂きたいと思っております。\n\nご検討のほどよろしくお願いいたします…！\n\nhttps://drive.google.com/drive/folders/1yCVUdd4mUwwc5SDBh5_L5HOcc4lwsCwZ?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sousakuakaneko/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1919097, "client_id": 3187609, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a741749/uploads/origins/a8a95f09-03a0-40c4-b337-d8abe22fde9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdbb5f2a2a81bf77a125dbcb38f207d6", "srcset": "https://si.imgix.net/7a741749/uploads/origins/a8a95f09-03a0-40c4-b337-d8abe22fde9a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fdbb5f2a2a81bf77a125dbcb38f207d6, https://si.imgix.net/7a741749/uploads/origins/a8a95f09-03a0-40c4-b337-d8abe22fde9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=631475f044abd3ee22f4bac9430d1080 2x, https://si.imgix.net/7a741749/uploads/origins/a8a95f09-03a0-40c4-b337-d8abe22fde9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83cac3ab7d0b05f31dbe3576a15ec563 3x"}, "duration": null, "nsfw": false, "hardcore": false, 