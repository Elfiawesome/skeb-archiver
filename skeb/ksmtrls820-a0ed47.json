igins/44056d2a-8640-4a1e-8920-1452934d1019?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9d58d29d0a783dbf6353b5d2b04d126, https://si.imgix.net/2b0712f8/uploads/origins/44056d2a-8640-4a1e-8920-1452934d1019?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0c881160096e091300a8e6ca70e188df 2x, https://si.imgix.net/2b0712f8/uploads/origins/44056d2a-8640-4a1e-8920-1452934d1019?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=96a187df22d462997f5c7cdd9061e5f7 3x"}, "body": "こんにちは！最近あなたのSkebページを見つけて、あなたのアートスタイルがとても気に入りました！\n今、ボーカロイドの「狂想曲」のカバーをしているのですが、原曲のスタイル（音符と炎が飛び交う）で、私のキャラクター、アーティのアートワークを描いていただけませんか？\n\nアーティはクマの男の子で、目はオレンジ、髪と耳はブルーです。アーティの参考資料と原曲のアートワークをグーグルドライブのフォルダに添付しました：\nhttps://drive.google.com/drive/folders/1J-u_NmsM4V7xj1zewK5yarwkFi9E77cc?usp=sharing\n\n写真と全く同じである必要はありませんので、自由にアートしてください！\nご検討のほど、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1J-u_NmsM4V7xj1zewK5yarwkFi9E77cc?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ksmtrls820/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3314531, "client_id": 2668321, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3377563/uploads/origins/862d6ece-5896-49c1-980d-e7fb5bfd6d6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e26463e39520b9a4f57d5ebbac75fe59", "srcset": "https://si.imgix.net/e3377563/uploads/origins/862d6ece-5896-49c1-980d-e7fb5bfd6d6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e26463e39520b9a4f57d5ebbac75fe59, https://si.imgix.net/e3377563/uploads/origins/862d6ece-5896-49c1-980d-e7fb5bfd6d6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b139f610abc32a48c66b5f93971e96be 2x, https://si.imgix.net/e3377563/uploads/origins/862d6ece-5896-49c1-980d-e7fb5bfd6d6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=95ed88f55bcd3d1d58b02cafaa1e3829 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e3377563/uploads/origins/862d6ece-5896-49c1-980d-e7fb5bfd6d6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c33d1256a4ca5d6ec24a3ffbecc063c0", "srcset": "https://si.imgix.net/e3377563/uploads/origins/862d6ece-5896-49c1-980d-e7fb5bfd6d6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c33d1256a4ca5d6ec24a3ffbecc063c0, https://si.imgix.net/e3377563/uploads/origins/862d6ece-5896-49c1-980d-e7fb5bfd6d6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6048b3f56ba65870652cd70576200ddf 2x, https://si.imgix.net/e3377563/uploads/origins/862d6ece-5896-49c1-980d-e7fb5bfd6d6d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=59f5a48169c4b2238be2295a42b8754f 3x"}, "body": "初めまして。Vtuberとして活動している、森田カナメと申します。 \nXより作品を拝見し、ぜひ依頼させていただきたいなと思い、リクエストを送らせていただきました。 \nイラストを2枚お願いしたく思います🙇‍♂️  \n\n＊使用用途＊ \n・SNSの投稿やアイコン、YouTubeのサムネイルや、おはV、チャンネルアート等広報活動での使用 \n・配信や動画内での使用\n・グッズ制作(まだ制作は未定ですが制作する際には使わせていただきたいです。)\n＊NGがありましたら別レイヤーに記載いただけますと幸いです…！！\n\n＊内容＊ \n男の子ver(普段の姿)の森田カナメと、女の子verの森田カナメを一枚ずつお願いしたいです。 \n服は既存のもの、そうでないものどちらでも大丈夫です。\nポーズや構図はお任せしたいのですが、なるべく頭部などが切れていない方が嬉しいです…！  \n\n＊人物詳細＊ \nゲームといたずらが好きな人工知能AIです。 \n性別は人工知能のためありませんが、普段は男の子の姿をしています。(データを書き換えれば女の子の姿にもなれます) \n少しツンデレな部分もある生意気なガキっぽい性格です。 \n自分の作った製作者を探すために配信をしてマスター(視聴者さん)に情報をもらったり、助けてもらったりしています。 \n\n ＊お願い＊ \n頭部が切れていないキャラクターのみの透過データ(またはレイヤー分け維持保存したPSD)のサインなしバージョンもいただけますと、使用する際の自由度が高まりますのでお願いできますと幸いです…！  \n\n以下のツイートURLを服装、容姿の参考資料としてお使いいただけますと幸いです。  \n\n参考資料1 男の子ver \nhttps://drive.google.com/drive/folders/1TDd_mhBaJD1ZwYrNehES-p6TqS0xPiq4 \n\n参考資料2 男の子ver \nhttps://twitter.com/kaname_karupis/status/1637803599811219458?s=46&t=jcifdrt2qc8KAVdqpqgZGg  \n\n女の子ver参考資料 ミディアムぐらいの髪の長さで黄色いインナーが入っている。服はお好みで描いていただいて大丈夫です！ \nhttps://drive.google.com/drive/folders/1-1v2cvB17ML2hSO-rZxOzS9ZUkZrrbB9  \nご検討、よろしくお願い致します。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ksmtrls820/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3314531, "client_id": 1089551, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/675b5294/uploads/origins/76657e6e-e73b-422d-821e-8650537434a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffa50af364398dfd4831ca4c147b9936", "srcset": "https://si.imgix.net/675b5294/uploads/origins/76657e6e-e73b-422d-821e-8650537434a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffa50af364398dfd4831ca4c147b9936, https://si.imgix.net/675b5294/uploads/origins/76657e6e-e73b-422d-821e-8650537434a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e42818a0b76294b3b679cd51a7edd5f 2x, https://si.imgix.net/675b5294/uploads/origins/76657e6e-e73b-422d-821e-8650537434a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83758847a81353099d4c2d773894654a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/675b5294/uploads/origins/76657e6e-e73b-422d-821e-8650537434a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb906ccc06c8ed439ea05c03d19be6a4", "srcset": "https://si.imgix.net/675b5294/uploads/origins/76657e6e-e73b-422d-821e-8650537434a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb906ccc06c8ed439ea05c03d19be6a4, https://si.imgix.net/675b5294/uploads/origins/76657e6e-e73b-422d-821e-8650537434a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0c766c9b581bdb7e5136b3f62f6854af 2x, https://si.imgix.net/675b5294/uploads/ori