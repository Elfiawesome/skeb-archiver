色の涙のマーク\n\nhttps://www.deviantart.com/stash/0t7bcb07stx", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kyanoshi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3715236, "client_id": 2682356, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4b4f4170/uploads/origins/e85ee815-11a4-4b4f-b1ab-5ff1313ecd23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=163d3e189b5874b534ba133ec67c2f17", "srcset": "https://si.imgix.net/4b4f4170/uploads/origins/e85ee815-11a4-4b4f-b1ab-5ff1313ecd23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=163d3e189b5874b534ba133ec67c2f17, https://si.imgix.net/4b4f4170/uploads/origins/e85ee815-11a4-4b4f-b1ab-5ff1313ecd23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01490f59547f4c013420f89795607194 2x, https://si.imgix.net/4b4f4170/uploads/origins/e85ee815-11a4-4b4f-b1ab-5ff1313ecd23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be45fb09f1c8b7a60c9c56c836d13c66 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b4f4170/uploads/origins/e85ee815-11a4-4b4f-b1ab-5ff1313ecd23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=687b588e3f2bd40e93753696c0bb74f9", "srcset": "https://si.imgix.net/4b4f4170/uploads/origins/e85ee815-11a4-4b4f-b1ab-5ff1313ecd23?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=687b588e3f2bd40e93753696c0bb74f9, https://si.imgix.net/4b4f4170/uploads/origins/e85ee815-11a4-4b4f-b1ab-5ff1313ecd23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d7c3ca1215c187212af0701957e7cf8d 2x, https://si.imgix.net/4b4f4170/uploads/origins/e85ee815-11a4-4b4f-b1ab-5ff1313ecd23?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fi