V05yJnR4dGFsaWduPWNlbnRlciZ0eHRzaXplPTgwJnR4dHNoYWQ9MTAmZm09cG5nJnc9MTIwMA&marky=415&txt64=55yf5YCJIOeOhCDjgZTkvp3poLzjgIc&txtclr=fff&txtfont64=QXZlbmlyLUJsYWNr&txtfit=max&txtalign=middle%2Ccenter&txtsize=60&txtshad=10&auto=format%2Ccompress&fit=crop&crop=top&w=1200&h=630&s=c82854ce9a98bf9b7be382009a42ddfa", "skills": [{"genre": "art", "default_amount": 5000}, {"genre": "correction", "default_amount": 3000}], "payment_methods": {"credit_cards": {"jcb": {"nsfw": true}, "master_card": {"nsfw": true}, "visa": {"nsfw": true}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@pilo_kuro/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2255, "client_id": 3654088, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b20c45fe/uploads/origins/b8bd408c-7213-46cf-8cc8-7f9ddfa71034?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f859772d8c6483060b597658b33294dc", "srcset": "https://si.imgix.net/b20c45fe/uploads/origins/b8bd408c-7213-46cf-8cc8-7f9ddfa71034?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f859772d8c6483060b597658b33294dc, https://si.imgix.net/b20c45fe/uploads/origins/b8bd408c-7213-46cf-8cc8-7f9ddfa71034?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04d62b16910c671a084e578be9e3a242 2x, https://si.imgix.net/b20c45fe/uploads/origins/b8bd408c-7213-46cf-8cc8-7f9ddfa71034?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f756150e1222238d4101d277c9c2287 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b20c45fe/uploads/origins/b8bd408c-7213-46cf-8cc8-7f9ddfa71034?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7cbedbd680b75f48338037c91d84a0ac", "srcset": "https://si.imgix.net/b20c45fe/uploads/origins/b8bd408c-7213-46cf-8cc8-7f9ddfa71034?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7cbedbd680b75f48338037c91d84a0ac, https://si.imgix.net/b20c45fe/uploads/origins/b8bd408c-7213-46cf-8cc8-7f9ddfa71034?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1eb1a49d4b83ffa0829db64eae976693 2x, https://si.imgix.net/b20c45fe/uploads/origins/b8bd408c-7213-46cf-8cc8-7f9ddfa71034?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a2c70889af3d88776ac8ae04e45d1d28 3x"}, "body": "真倉 玄様、はじめまして。\nXでFF14のイラストから他の作品も拝見し、儚さと色気の両方を感じる素敵な絵柄や青の美しさにとても心惹かれました。特に宇宙煙草のイラストがテーマを含めて大好きです。\nもしよければ私と友人のOCを描いていただけないでしょうか（友人了承済み）\n\n▼OC\n英国ロンドンの探偵事務所で同居しているぐうたらな名探偵と世話焼きの助手。\n元はヴィクトリア朝後期（シャーロック・ホームズと同時代）のキャラですが現代コンバートもしています。\n\n①黒髪のほう（探偵 / 32歳 / 男 / 173cm / やや細身 / 一人称私 / 二人称君）\n・胸のあたりまでの黒髪、前髪で顔の左側の火傷跡を隠している\n・やや紫がかった淡い青の瞳、伏し目がち\n・②より肌の色が白い\n・耳に②の瞳の色のピアス、爪に黒のネイル\n・厭世的で怠惰だが謎への好奇心は人一倍強く、事件が起こると生き生きしだす\n・事件以外はすべて助手任せで酒ばかり飲んでいる\n・普段はお世話に甘えているが、自分を大切にしない助手を密かに心配しており、助手が弱っている時には庇護する側に回る\n・喫煙者。煙草を吸う理由は足りないものを埋めるため\n\n②茶髪のほう（助手兼医者 / 28歳 / 男 / 173cm / やや細身/ 一人称僕 / 二人称君）\n・ふわふわの茶髪、襟足長めでうなじが隠れるくらい\n・鮮やかなサファイアブルーの瞳、眼鏡は伊達\n・一見愛想はいいが実は気の短い皮肉家。重度の人間嫌いで他人に触れられるのも嫌がるほどだが探偵だけは例外\n・家事万能で時に小言をいい時に甘やかしながら探偵のお世話に明け暮れている\n・探偵に対しては心配症、自分のことには無頓着\n・精神的に不安定で感情表現が幼く、探偵に依存気味\n・探偵が煙草を吸うとジト目で見つめたり小言をいったり取り上げようとしたりする。半分は健康への心配、もう半分は煙草より自分を求めてほしい嫉妬めいた気持ち（無自覚）\n\n▼関係性\n関係としては相棒以上恋人未満だが抱いている感情はかなり重ため。お互いに相手がいないと生きていけないと思っている。\n頭を撫でたり手を繋いだり、ハグやキスは日常的にする距離感。\n\n▼希望\n現代設定で「煙草」をモチーフに、他はお任せでお願いしたいです。\n髪型や衣装は資料の現代服を参考にしてください。新規でお好きな衣装を着せるのやアレンジも大歓迎です。\nご自由に描いていただけたら嬉しいです！\n\n▼使用用途\n私と友人の鑑賞、個人利用範囲の印刷、非営利のグッズ作成\n\n金額不足の場合は再送していただければ幸いです。\n不備等あればご遠慮なくキャンセルしていただいて構いません。\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1LcXpoxtpYpqqRi9whTV6Jo3iOrayWsdK?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pilo_kuro/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2255, "client_id": 403231, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d424dbbd/uploads/origins/33d2a223-7f1c-4e4e-ad60-4b68dd31266a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9ea566e7cfaaf2dba083be92f1e5d12", "srcset": "https://si.imgix.net/d424dbbd/uploads/origins/33d2a223-7f1c-4e4e-ad60-4b68dd31266a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a9ea566e7cfaaf2dba083be92f1e5d12, https://si.imgix.net/d424dbbd/uploads/origins/33d2a223-7f1c-4e4e-ad60-4b68dd31266a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c56e3106a657c0c766c8f85f4d4986b2 2x, https://si.imgix.net/d424dbbd/uploads/origins/33d2a223-7f1c-4e4e-ad60-4b68dd31266a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=15a2eaa246bf082589593e1e6dd84cd5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d424dbbd/uploads/origins/33d2a223-7f1c-4e4e-ad60-4b68dd31266a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e7abed9cee058e651d1771c930e2ed0", "srcset": "https://si.imgix.net/d424dbbd/uploads/origins/33d2a223-7f1c-4e4e-ad60-4b68dd31266a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e7abed9cee058e651d1771c930e2ed0, https://si.imgix.net/d424dbbd/uploads/origins/33d2a223-7f1c-4e4e-ad60-4b68dd31266a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=37aaba025bb647d88fec305524b643e3 2x, https://si.imgix.net/d424dbbd/uploads/origins/33d2a223-7f1c-4e4e-ad60-4b68dd31266a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e665c308dcda23ccc7a091b5cc973259 3x"}, "body": "はじめまして！\nニコニコ動画でTRPG動画の投稿者をしております、\n流音と申します。\n\nリクエストの前に感想を送ります！\n\n先日、真倉さんが描いてくださったイラストを、友人経由で拝見しました。\nhttps://x.com/pilo_kuro/status/1842412157721620840\n\nとっても良いですね！！！！！！\n\n一目見たときから、素敵だなと思いました。\nシルエットの綺麗さと、淡く閃いた、日向の色をした光の当たり具合、\n星空のような黒の塗りと合わさって、非常に印象に残りました。\nそこに間違いなく、足を付けているのに、向こうに行ってしまいそうな。\nそんな印象がパッと目に入ります。\n白背景が空間に見えるのも、舞い散る楽譜の配置も、\nセンスがいいなーと思いました。\n\nイラストをアップにすると、\n思いがけないぐらい太めのペンで丁寧に描かれた線画が見えてきて、\n凄いですね。\n質感がある塗りと、なかなか見ない表情をした顔、\n服のシワの表現など、見応えが非常にあります。\n\n私が大好きなキャラクターと、大好きなお話のキービジュアルを、\nとっても素敵なイラストで可視化してくださり、\n非常にありがたいです！\n動画を制作するモチベが爆上がりしました！\n私が、彼が出演するTRPG動画の動画編集者ですので、\n大事なイラストを物語に載せて世の中にお届けできるよう、\n誠心誠意を尽くして進めていこうと思います。\n本当に、ありがとうございました！\n\n\n---\n\n感想とおひねりを渡したかっただけですので、\nリクエストはオマケです。\n\n一言で言えば、\n真倉さんが描いたGLORY-USのボーカルを見てみたい！　です。\n資料URLにいるキャラクターがいる一枚絵をお願いします。\n描くのはどの衣装でも構いません。\n\n何を描くか/構図/シーン/衣装デザイン変更/描き込み量などは\nすべてお任せします。\n\n\n【資料URL】\nhttps://drive.google.com/drive/folders/1lqsuZkGRRWHnShjYJgst7xFpEdNfK30h?usp=sharing\nhttps://drive.google.com/drive/folders/1XTwHdUx_qr9gmlYTG5G5nk92EGsklX4R?usp=sharing\nhttps://drive.google.com/drive/folders/1F77tTA4U6IWG5HvILxfIvKBryNHqE1cS?usp=sharing\nhttps://drive.google.com/drive/folders/16Ar6hE9H_qa1FHScUmBrLUwJG8q-fWXz?usp=sharing\nhttps://drive.google.com/drive/folders/1N70b1xqSpf3EaGH8oc1ISSsWdQ3b1u_N?usp=sharing\nhttps://drive.google.com/drive/folders/15UATBhVLvzzYa5OLvLZ5chGLaqGRLZjx?usp=sharing\n\n【キャラクターの設定】\n瀬名俊樹\n世界観：現代日本（一次創作キャラクター）\n一人称：俺\n身長：165cm　体格：ふつう\n年齢：20代後半\nタレ目で可愛げがある、ちょっと小柄なお兄さんキャラ。\n\n簡単な設定\nロックバンド「GLORY-US」のボーカル。\n（単独アリーナ公演を行えるクラスのアーティスト）\n同バンドのリーダーもやっている。ライブのMCでは盛り上げ役。\nゆるい雰囲気と自信ありげなドヤ顔が特徴。\n奔放なメンバーにノったり諌めたり言葉足らずを補足したりを、\n心から楽しくやっている。\nどちらかといえば良く喋る方。メンバー内でのまとめ役。\n声はツヤがあり伸びやかな中音から高音域。\n歌の天才であり、聴いたもの誰もが心に残る。\n音楽と仲間のことが大好き。\nその一方で、自分で自分の価値を認められない一面もある。\n仲間のおかげでだいぶ成長したが、ふとしたことで自己嫌悪に陥りがち。\n\n同ロックバンドのギター、\n瑛士とは高校の頃からの幼なじみで親友。\n\n\n以上です。\nこれからの活動も応援しています！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pilo_kuro/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "ar