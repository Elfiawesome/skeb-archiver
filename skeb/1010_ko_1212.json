c-42a8-b309-ce0a291b00c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=38ad04bce36ddee0d9fc8edd3f8326cb", "src_set": ""}, "body": "こんにちは、先日は可愛いルシードさんの肥満化絵をありがとうございました。\n\n今回はその絵みたいな感じでカレンさんの肥満化絵を見てみたいです！\n\n資料は雑誌のスクラップしかありませんが、一応送付しておきます。\n全身図のフルカラーが無いのが申し訳ないのですが、恐らくショートブーツも紺色だと思われます。\n\n今回はシャツでお腹を包んで欲しいのですが、ちらっと腹肉も見えてると嬉しいです。\n\nhttps://x.com/be_fe2/status/1915907072975376447?s=46", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1010_ko_1212/works/29", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3843c1c8/uploads/origins/06397071-42d0-4e59-ac67-b6bc91f35772?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b4865ef72807cf6d6589443581f2a9a6", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1482205, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@1010_ko_1212/works/28", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1482205, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/91f35654/uploads/origins/4a7404f2-1ebd-46b9-9811-fe2839f88aa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddf18a05bb75468b1bd58746e4922404", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/91f35654/uploads/origins/4a7404f2-1ebd-46b9-9811-fe2839f88aa4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6c1c3627728cd1ce54142785117abea", "src_set": ""}, "body": "お宅の子のポリプちゃんとポルーの二人でブーツ化をお願いしてもいいでしょうか？\n\n大まかな内容として↓\n･煙が晴れると二人ともブーツに変化しており、ポリフちゃんは資料ＵＲＬのブーツ化と同じ表情で慌ててほしいし、ポルーは冷静で居てほしいです。\n･モノとして使われないと戻れないとか理由で二人とも身に着けられる\n･履き続けた結果、二人揃って自分はブーツだと思い込んでしまう（黒目にぐるぐる）\n\n変化のさせ方は煙に巻かれる、ビームを受ける等、変化シチュに合いそうなのをお願いしたい（この部分は割愛しても構いません）\n\nhttps://x.com/1010_ko_1212/status/1449657331663335431/photo/1", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1010_ko_1212/works/27", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1482205, "client_id": 248293, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db3112aa/uploads/origins/b7749966-bf93-46de-9273-83ea61f565c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d89c9e63e45428321888cbe346a024f0", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db3112aa/uploads/origins/b7749966-bf93-46de-9273-83ea61f565c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=545a71577faf5e3bfb962ce5741b3a07", "src_set": ""}, "body": "いつも投稿作品を楽しみにしています。\n縦平面化の表裏のイラストをお願いします。\n\nうちの子の見た目はこちら→https://cdn.tw6.jp/i/tw6/combined_origin/1660/1265554_f16609_totalbody.jpg\n\n潰れ方は、女の子座りの体勢で潰されて、涙目で片頬がむぎゅっと押さえつけたような表情でお願いします。\n\n※アレンジOK、値上げ交渉による再送可\n\n差し支えなければ、よろしくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@1010_ko_1212/works/26", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8316c985/uploads/origins/4e6d0aff-9168-4dd3-b047-1b769c0a450a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7827add01196bcfdf35e58108df0d928", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1482205, "client_id": 344588, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore":