9-f2c6-4beb-908d-74cdc5475f6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec52a91b1d0d7dc4395676286abdce82", "src_set": ""}, "body": "こんにちは、\nV&Uの大下ミーティアの絵を依頼したいです。彼女はとても元気で健全なVtuberです。\n\nReference sheet: https://x.com/MeetaVNU/status/1680986645691092993?t=0tEPx8R3g5-809yZdJIAfQ&s=19\n\nアニメ『ご注文はうさぎですか?ただし、制服は青でお願いします。シャロの制服の耳あて部分は入れないでください。\n\n桐間祥朗：https://www.pixiv.net/en/artworks/75762495\n\nポーズは、両手でコーヒーを出してほしいです。できれば、かわいいクマのラテアートもお願いします。笑顔でお願いします！\n\n背景は、コーヒーと同系色でかわいいクマを描いてください。背景のデザインはお任せします。\n\n最後に、できれば背景なしの透明バージョンもお願いします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toketa_sekai/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1496959, "client_id": 2732041, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dcfc9f84/uploads/origins/44c36d51-8be8-42d2-a4bb-6e1897441b64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=087576c0f49d7e1b73f4c51e6549233c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dcfc9f84/uploads/origins/44c36d51-8be8-42d2-a4bb-6e1897441b64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ccdf747b0bfa49d8a1c6a56fd177f69d", "src_set": ""}, "body": "初めまして！\nYouTubeとツイキャスにて配信活動を行っています沖田ノヨメと申します。\n\n好きなvtuber 様のイラストを拝見して、とけたせかい先生を知りました！\nよろしければ当方のキャラも書いていただきたく、リクエストお送りさせていただきます。\n\n用途：配信活動（YouTube、ツイキャス、SNS等）で使用予定\nサイズ：お任せ\n衣装資料：https://drive.google.com/drive/folders/1e5qAChBqNUS2QckzAvDZyIAbHMI5j_7f?usp=drive_link\n衣装や髪型は複数ありますが、先生の好きな組み合わせでお願いします。\n\n普段は麻雀配信が多く、あまり勝てずにメンヘラ気味ですがなんだかんだ頑張るキャラです。\n\n勝手ながら可能でしたら活動のために背景透過版や髪の毛衣装の見切れなしだと大変ありがたいです。\nどうぞご検討よろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toketa_sekai/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1496959, "client_id": 2187469, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9c751eb/uploads/origins/539bf760-359b-47f0-9142-5d84920e0e15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8265d2ce1c9073ada9acdedcf6fdabe", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9c751eb/uploads/origins/539bf760-359b-47f0-9142-5d84920e0e15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f0c16d910dd3a3362ecdd853545a6e6", "src_set": ""}, "body": "とけたせかいさん、初めまして。\nさて、私が描いていただきたいのは、雀魂の七海礼奈です。\n参考資料（https://imgur.com/a/pZU6FF1）\nここからは補足事項になりますが、車椅子の描写につきましては、下の画像のように、上から下を見下ろした図、いわゆる鳥瞰の構図にしたり、別のキャラクター、もしくは物で車いすを隠すなどといった描き方でもOKです。\nそんな感じで私の相棒を可愛らしくお願いします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toketa_sekai/works/19", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b0c37959/uploads/origins/285b2ded-faee-4967-aec7-cb1994febda0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e0ba92a6ac34c5fe59e5f189b7aa3a1", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1496959, "client_id": 1660186, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@toketa_sekai/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1496959, "client_id": 2686506, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eff21e02/uploads/origins/6ac7c563-5631-4504-9be5-d1831fce9d4b?bg=%23fff&auto=format%2C