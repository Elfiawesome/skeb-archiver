3f56ca76/uploads/origins/f220f70b-fd79-4d8d-824b-3775e1d797ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e579004d0b89a876cf78d82467e922f5 2x, https://si.imgix.net/3f56ca76/uploads/origins/f220f70b-fd79-4d8d-824b-3775e1d797ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cdae1b21d73ec2f58162c3efca74c69c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f56ca76/uploads/origins/f220f70b-fd79-4d8d-824b-3775e1d797ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65d1395280b4b6868261a7e9d692cec7", "srcset": "https://si.imgix.net/3f56ca76/uploads/origins/f220f70b-fd79-4d8d-824b-3775e1d797ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65d1395280b4b6868261a7e9d692cec7, https://si.imgix.net/3f56ca76/uploads/origins/f220f70b-fd79-4d8d-824b-3775e1d797ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2f29cf91f7005b29effd3d8a9b66f993 2x, https://si.imgix.net/3f56ca76/uploads/origins/f220f70b-fd79-4d8d-824b-3775e1d797ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a033a43748a8ffa167a9f3a9359373ba 3x"}, "body": "It is nice to meet you.\nI would like to make this request because I have seen your wonderful drawings and I would like to commission you to draw a picture for me.\n\nI would like to request an illustration of Emma Aizawa and Luna Shiomiya in a school parody style.\nI would like them to wear black sailor uniforms. I will leave the situation, composition, pose, etc. up to you.\nIt would be great if the two of them can be friendly with each other.\nLuna Shiimiya's hairstyle should be the same as in the Buisupopu website! We would like her hairstyle to be the same as the initial image shown on the website of Buisupo! (https://vspo.jp/member/)\n\nThe use of this image is for icons and headers on X (formerly twitter), Discord, etc., and as wallpaper on smartphones.\nAlso, since we would like to use it as a wallpaper for smartphones, please make it a portrait size if possible.\n\nWe are very sorry that the content of this request is so vague, but we appreciate your cooperation.", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Gerbera152/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2465227, "client_id": 2886863, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b621eee/uploads/origins/bb7f7e4d-8114-4f2f-bc65-857d95edf769?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ffc10c40499a63af6250318d0c509f6", "srcset": "https://si.imgix.net/6b621eee/uploads/origins/bb7f7e4d-8114-4f2f-bc65-857d95edf769?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ffc10c40499a63af6250318d0c509f6, https://si.imgix.net/6b621eee/uploads/origins/bb7f7e4d-8114-4f2f-bc65-857d95edf769?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0ca5f6793798c3c5ade736219811df25 2x, https://si.imgix.net/6b621eee/uploads/origins/bb7f7e4d-8114-4f2f-bc65-857d95edf769?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8cf0e80efe42400e565d54478dad3906 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b621eee/uploads/origins/bb7f7e4d-8114-4f2f-bc65-857d95edf769?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c287f7b806592145f62979eb3f92b2cc", "srcset": "https://si.imgix.net/6b621eee/uploads/origins/bb7f7e4d-8114-4f2f-bc65-857d95edf769?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c287f7b806592145f62979eb3f92b2cc, https://si.imgix.net/6b621eee/uploads/origins/bb7f7e4d-8114-4f2f-bc65-857d95edf769?bg=%23fff&auto