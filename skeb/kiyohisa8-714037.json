.net/81cbad01/uploads/origins/8d5ad23e-cd4a-4bd6-a603-d6b0fba16d15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe48e887ee3c4497c962ceb4f5087db3 2x, https://si.imgix.net/81cbad01/uploads/origins/8d5ad23e-cd4a-4bd6-a603-d6b0fba16d15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b447a5762f48bde27451b7c26ed05d3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/81cbad01/uploads/origins/8d5ad23e-cd4a-4bd6-a603-d6b0fba16d15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6bbde7cc95fe8fcdd6c3481165d45b8", "srcset": "https://si.imgix.net/81cbad01/uploads/origins/8d5ad23e-cd4a-4bd6-a603-d6b0fba16d15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6bbde7cc95fe8fcdd6c3481165d45b8, https://si.imgix.net/81cbad01/uploads/origins/8d5ad23e-cd4a-4bd6-a603-d6b0fba16d15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f3adb8bb2c58ac65b9ccbf918a1336ca 2x, https://si.imgix.net/81cbad01/uploads/origins/8d5ad23e-cd4a-4bd6-a603-d6b0fba16d15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b9b568c4ead411fc9d0271c2599632d5 3x"}, "body": "先生初めまして．\n\n先生のEVA相関の絵を見て，憧れて，勇気を立って依頼を送ります！\n\n自分のOCを描いてくれませんか？\n\nヒロイン設定：帝国名門貴族の長女．容姿良し，気立て良し，そして正義の心を持つ，帝国騎士団の副団長を務める．実力は強い，炎の姫と呼ばれる，主に炎系の魔法を使用し，魔法種類は8種類まで使えます．次の帝国主権者候補と思われてる．しかし悪を許さないやり方は，彼女に敵対する人も少なくないになった．家に一人の兄上がいるが，しかし、兄の魔法は妹に劣る．\nOC参考画像：https://imgur.com/UwPugNt, https://imgur.com/inkagk7\n\nシナリオ: 一人境界外パトロール中に突然、敵の王国のエリート暗殺部隊に遭遇した．激しい戦いの後、散乱の髪には再びポニーテールを結び付けた様子を描いてください．脇が見える形です. (参考画像：要領先生から https://twitter.com/kanameryou9/status/1490981730366414848)\n背景は激戦した後，炎と壊滅した森と言う感じ．\n激しい戦い後ので，服はボロボロ，bloodが体や顔にこぼれた表現がありますように．剣はまだ彼女の隣に炎の魔法のエンチャント維持するまま，大地に刺さっています．\n\n※彼女の髪型はポニテで，片側の耳後には（揉み上げ？）髪の毛の垂下があります．私は髪の毛がとても気に入ってから，ご注意ください．\n※彼女の衣装は上半身はplain clothes，下半身はmilitary uniform．\nできれば煽情の感じをかいてください．\n\nご検討のほど何卒よろしくお願いします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kiyohisa8/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1547927, "client_id": 1191500, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8e1704be/uploads/origins/45db94ce-0546-4eb6-9408-e589cf16411e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=703bf3818a75529bb40d128b0dc887d6", "srcset": "https://si.imgix.net/8e1704be/uploads/origins/45db94ce-0546-4eb6-9408-e589cf16411e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=703bf3818a75529bb40d128b0dc887d6, https://si.imgix.net/8e1704be/uploads/origins/45db94ce-0546-4eb6-9408-e589cf16411e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=715a93d0a6cc9adb10e72269935d1691 2x, https://si.imgix.net/8e1704be/uploads/origins/45db94ce-0546-4eb6-9408-e589cf16411e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7a4f25539b3afc5b565da1a7090a4371 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8e1704be/uploads/origins/45db94ce-0546-4eb6-9408-e589cf16411e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23922285e58fd4714d85eb76e4966d53", "srcset": "https://si.imgix.net/8e1704be/uploads/origins/45db94ce-0546-4eb6-9408-e589cf16411e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23922285e58fd4714d85eb76e4966d53, https://si.imgix.net/8e1704be/uploads/origins/45db94ce-0546-4eb6-9408-e589cf16411e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a016bd40ad8b633a06bd7595024a1811 2x, https://si.imgix.net/8e1704be/uploads/origins/45db94ce-0546-4eb6-9408-e589cf16411e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bebd26728d8fa4c2b00683cb5dadefa8 3x"}, "body": "どうしても、もう一枚を描いていただきたくてコミッションしました。\n\n「白いプラグスーツを着た真希波・マリ・イラストリアス」です。\n\n先日、依頼したアスカの近くにいるというイメージを私は持っています。\n描いていただきたいのはマリが座っているか立っている絵です。\nポーズも構図もお任せします。\n\n私が考えたイメージです。\nアスカの隣で座っているマリ\nhttps://i.imgur.com/BL4cDE9.png\nマリがアスカを見つめているイメージです。\nhttps://i.imgur.com/avalF52.png\n\nアスカの隣で立って遠くを眺めているマリ\nhttps://i.imgur.com/3ItWuUd.png\nこんなイメージです。\nhttps://i.imgur.com/wzqWl9j.png\n二人がいる構図がありますが描いていただきたいのは「マリ」一人です。紛らわしくて申し訳ありません。\n\n座っている、もしくは立っているマリを魅力的に描いてほしいです。\nその為、参考はあくまで参考程度で構いません。\nお任せします。\n\n読んでいただき有難うございました。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kiyohisa8/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1547927, "client_id": 1191500, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/83eee2f1/uploads/origins/58a954bb-88aa-4186-95c5-a3b441826492?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db61776e400486ca64e67c3845ba092a", "srcset": "https://si.imgix.net/83eee2f1/uploads/origins/58a954bb-88aa-4186-95c5-a3b441826492?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db61776e400486ca64e67c3845ba092a, https://si.imgix.net/83eee2f1/uploads/origins/58a954bb-88aa-4186-95c5-a3b441826492?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb113f2c5374fedd33aecdc1e04b9b9e 2x, https://si.imgix.net/83eee2f1/uploads/origins/58a954bb-88aa-4186-95c5-a3b441826492?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bcfc1709bbe1971ead713b452c7c114e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/83eee2f1/uploads/origins/58a954bb-88aa-4186-95c5-a3b441826492?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7435c765e30e5ba98efaa294d4af568e", "srcset": "https://si.imgix.net/83eee2f1/uploads/origins/58a954bb-88aa-4186-95c5-a3b441826492?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7435c765e30e5ba98efaa294d4af568e, https://si.imgix.net/83eee2f1/uploads/origins/58a954bb-88aa-4186-95c5-a3b441826492?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4f7e57d5da270806b059d30dccd41f7e 2x, https://si.imgix.net/83eee2f1/uploads/origins/58a954bb-88aa-4186-95c5-a3b441826492?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ec26ac3f59a93b9e898caa8d798d7927 3x"}, "body": "はじめまして、Twitterやpixivで「白」のタイトルで描かれた二人の絵が魅力的だったのでコミッションしてみました。\n描いていただきたいのは、やはり「白いプラグスーツを着た式波・アスカ・ラングレー」です。\n朝日を浴び、高い構築物の上に立ち、緩い風が吹き髪が少し揺れている。\n\n自分が思った構図の参考です。すべてお任せします。\nhttps://i.imgur.com/B0XwY2A.png\n建物の背景などは暈して頂いてキャラクターの魅力を前面に出してほしいです。\n\n魅力的な「白いプラグスーツを着た式波・アスカ・ラングレー」を見てみたいです。\n私が思った構図などを示しましたがすべてお任せします。\n\n読んでいただいて有難うございます。よろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1829, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "柿坂(KAXAK)八鹿", "screen_name": "kaxak8", "avatar_url": "https://pbs.twimg.com/profile_images/821811069421174788/kpLesHdk.jpg", "header_url": "https://pbs.twimg.com/profile_banners/821806903403499520/1488242576/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 421855, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "Yuli", "screen_name": "yulitanbo", "avatar_url": "https://pbs.twimg.com/profile_images/2038959829084160000/zcFLHTBl.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4320123795/1633608313/1500x500", "appeal_receivable": true, "po