to=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea38221d302db84e905f49cee6b4fc5f, https://si.imgix.net/cf6d149b/uploads/origins/e86d71c3-86c0-497f-ab75-a45f022435e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b2445aee0064fa62cc882485d681400b 2x, https://si.imgix.net/cf6d149b/uploads/origins/e86d71c3-86c0-497f-ab75-a45f022435e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0bb02634cdd820cc804b6048ef4734ef 3x"}, "body": "スタン × ゲイリー・スケブ\n\nスタンとゲイリーは、二人きりで着替えをすることになった。 その理由については、作者の自由な解釈に任せるとして、水泳や体育の授業の後で残されたとか、いたずらで二人とも泥まみれになったとか、そんなところだろう。二人は服を脱ぎ始め、話しているうちに、スタンはゲイリーの信仰について皮肉なコメントを飛ばす。しかし、ゲイリーがズボンを脱ぎ、（少なくとも彼の体格や年齢にしては）巨大なペニスを露わにした瞬間、スタンは衝撃で言葉を失う。 スタンの突然の沈黙に気づいたゲイリーは、突如として欲情し従順になったスタンを巧みに利用する。ゲイリーはスタンに自分の睾丸を舐めさせ、スタンの熱心さに驚いた二人はさらに行為を続け、最終的にスタンがゲイリーのペニスをフェラチオし、顔面に射精される。ゲイリーはスタンを「洗礼」し、彼を「白く、喜びに満ちた」状態にする。結局のところ、スタンはモルモン教には敬意を抱いていないかもしれないが、ゲイリーのペニスには敬意を抱いているのだ。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SPmushicake/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3540745, "client_id": 3628000, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28180671/uploads/origins/1ba15fa6-7ec8-4117-ad9e-5cce78c2d55e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b525bc0befbbd83831047fb0de3ee70", "srcset": "https://si.imgix.net/28180671/uploads/origins/1ba15fa6-7ec8-4117-ad9e-5cce78c2d55e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b525bc0befbbd83831047fb0de3ee70, https://si.imgix.net/28180671/uploads/origins/1ba15fa6-7ec8-4117-ad9e-5cce78c2d55e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=053b223be7f0975eac1e9c6b87567a3a 2x, https://si.imgix.net/28180671/uploads/origins/1ba15fa6-7ec8-4117-ad9e-5cce78c2d55e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49675a5e170cb926908e465008c6d00e 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28180671/uploads/origins/1ba15fa6-7ec8-4117-ad9e-5cce78c2d55e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a49163417dda005c01690d0c8bf225b2", "srcset": "https://si.imgix.net/28180671/uploads/origins/1ba15fa6-7ec8-4117-ad9e-5cce78c2d55e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a49163417dda005c01690d0c8bf225b2, https://si.imgix.net/28180671/uploads/origins/1ba15fa6-7ec8-4117-ad9e-5cce78c2d55e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=96e783bae747dbb88e43d1b6798be46d 2x, https://si.imgix.net/28180671/uploads/origins/1ba15fa6-7ec8-4117-ad9e-5cce78c2d55e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=45275290e8faf1d1ad1cc1bc016cedb1 3x"}, "body": "Stick of Truthのゲームのワンシーンをベースにした、あなたの特定のNewkidのデザインに関わるリクエストに応じられないかと思ってたんだ。マクロ（大きさのもの）、ヴォア、ガスが含まれているので、それでよければと思います。必要であれば、もう少し高くても構いません。\n\nStick of Truthの中で、ニューキッドがパスポート用の写真を撮りに行くシーンの別バージョン。ニューキッドは、邪魔されて戦いを強いられるよりはと、下着姿になった後、一握りのノームの粉を変質者に投げつけ、彼らを縮ませる。欲望の代わりに恐怖で汗をかいた変態は、ニューキッドと彼のかなり印象的な膨らみを見上げる（私はニューキッドが比較的大きなペニスを持っているというアイデアが好きだが、あなたのデザインなので、あなたが望むならそうでなくても喜んで見る）。影のように迫ってくるニューキッドはお尻を下ろし、小さな変態の真上にホバリングする。一瞬、彼は安心するが、ニューキッドの腹部から不吉なうめき声が発せられる。  広い視野で見ると、ニューキッドは安堵の表情を浮かべながら、おならガスを大量に放出する。唖然とした被害者を抱き上げ、顔にかざす。ニューキッドは笑顔で服を脱ぎ始め、口に放り込んでゴックンと飲み込む。私はニューキッドのマナバーが補充される勝利画面のようなパネルのアイデアが好きだ（この縮んだ男がニューキッドのガス／マナの補給を助けることを示す）。ニューキッドの腹の中で変態は丸くなり、どうやって外に出ようかと声に出して考える。短いタイムスキップに切り替わり、ニューキッドがトイレに座って押しながら、パラディン・バターズが臭いにもかかわらずひたすら待っているのが見える。", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SPmushicake/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3540745, "client_id": 3628000, "vtt_