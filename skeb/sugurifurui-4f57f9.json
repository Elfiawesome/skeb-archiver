ます\n\n私のOCのタラとヴェラを描いてくれませんか？  タラは黒い肌、ヴェラはオレンジの肌です。\n\n二人とも角があり（耳はない）、瞳孔のないリングのある赤い目をしています（参考写真参照）。\n\nタラを上にして、参考ポーズと同じような位置で描いてほしいです。彼女は唇を舐めていて、目のリングは興奮して光っているはずです。\n\nヴェラはタラに両手を掴まれ、押さえつけられています。\n\nタラの胸は小さく、ヴェーラは平らである。\n\nその他は好きなように描いてください。\n\nありがとうございました。^_^\n\nhttps://drive.google.com/drive/u/0/folders/1-04fzHMmL50h9QrbaSbe7UGeFV3yWQTx", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sugurifurui/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2338622, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/15e75e0b/uploads/origins/8b4cde49-8598-43de-83c4-89743c7d2390?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f932995c64b64fd84d5faea3b2243ba", "srcset": "https://si.imgix.net/15e75e0b/uploads/origins/8b4cde49-8598-43de-83c4-89743c7d2390?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f932995c64b64fd84d5faea3b2243ba, https://si.imgix.net/15e75e0b/uploads/origins/8b4cde49-8598-43de-83c4-89743c7d2390?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e63d955b76166ffab304933b77041ec7 2x, https://si.imgix.net/15e75e0b/uploads/origins/8b4cde49-8598-43de-83c4-89743c7d2390?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=74164081a90c8e8754aaba3413407127 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/15e75e0b/uploads/origins/8b4cde49-8598-43de-83c4-89743c7d2390?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e40ba1f7e61f1294d25618d89a6d585", "srcset": "https://si.imgix.net/15e75e0b/uploads/origins/8b4cde49-8598-43de-83c4-89743c7d2390?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e40ba1f7e61f1294d25618d89a6d585, https://si.imgix.net/15e75e0b/uploads/origins/8b4cde49-8598-43de-83c4-89743