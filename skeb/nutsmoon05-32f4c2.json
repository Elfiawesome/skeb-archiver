ter.com/temari_ayaginu\n\n先生の描かれている衣装がとてもすてきでしたので、今回可能であれば、踊り子の衣装を着ているイラストを描いていただきたいです！\n先生の可能な限りセクシー寄りで描いていただけると嬉しいです。\nポーズ、構図、表情などは全ておまかせになってしまいますがよろしくお願いします。\n\n【綵てまりさん参考用画像】\nhttps://pbs.twimg.com/media/E5Zd65_VIAEzN4x?format=jpg&name=medium\n目の中にハートがあります。\n左目の下に泣きボクロがあります。\n\n【使用用途】\n綵てまりさん本人の使用許可を頂きたいです。※Twitter、配信サムネイル等に使用する可能性あります。\n\n【その他】\n人物・背景等がレイヤー分け出来るPSDデータで頂けると有難いです。\nあと、お手数ですが、サイン無しバージョンでのイラストも欲しいです！\n自分がスマホのみの為。こちらは無理にではないのでなくても大丈夫です。\n以上、お忙しい中だと思いますが、是非ご検討よろしくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nutsmoon05/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 874, "client_id": 514301, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c4dc301/uploads/origins/4c733770-1b5e-436b-914e-d3fdc693fd92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c49f1c49a64169b1de61798cb275863c", "srcset": "https://si.imgix.net/0c4dc301/uploads/origins/4c733770-1b5e-436b-914e-d3fdc693fd92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c49f1c49a64169b1de61798cb275863c, https://si.imgix.net/0c4dc301/uploads/origins/4c733770-1b5e-436b-914e-d3fdc693fd92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30a999c13279274279acfac138e630f3 2x, https://si.imgix.net/0c4dc301/uploads/origins/4c733770-1b5e-436b-914e-d3fdc693fd92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=470d9a93166ef286f956913593baf73e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c4dc301/uploads/origins/4c733770-1b5e-436b-914e-d3fdc693fd92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=66c3c370218fbf88842b2abd09a077d3", "srcset": "https://si.imgix.net/0c4dc301/uploads/origins/4c733770-1b5e-436b-914e-d3fdc693fd92?bg=%23fff&auto=format%2