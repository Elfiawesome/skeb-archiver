it=crop&crop=top&w=200&h=200&s=b18af1dcdc65c147201b5d286269e248, https://si.imgix.net/840e4eb3/uploads/origins/afe0f844-6287-4b32-84b5-26b7504efb10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b87a9ecbc5727cff5937c83dc1463e9 2x, https://si.imgix.net/840e4eb3/uploads/origins/afe0f844-6287-4b32-84b5-26b7504efb10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a03c74ef87c84b8edf4007bbe9c3a808 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/840e4eb3/uploads/origins/afe0f844-6287-4b32-84b5-26b7504efb10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=055c777305c9840905b2a1e15d047484", "srcset": "https://si.imgix.net/840e4eb3/uploads/origins/afe0f844-6287-4b32-84b5-26b7504efb10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=055c777305c9840905b2a1e15d047484, https://si.imgix.net/840e4eb3/uploads/origins/afe0f844-6287-4b32-84b5-26b7504efb10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7d23277f81476737b61d22233f5c6622 2x, https://si.imgix.net/840e4eb3/uploads/origins/afe0f844-6287-4b32-84b5-26b7504efb10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=85f2ab2100f56e7b91a0502290dd2b13 3x"}, "body": "蒼さん、こんばんは。お世話になっております。\n蒼さんの可愛い女の子イラストのファンなので、リクエストさせてください！\n\n今回描いて頂きたいのは、クトゥルフ神話TRPGシナリオの『Sinner's fairy tale』でペアの自陣探索者のHO3とHO4の女体化した姿です。\n意味の分からないリクエストで申し訳ないのですがふたりとも女体化した姿で描いて頂きたいです。\n\nビジュアルや設定は以下の資料にまとめてあります。(シナリオのネタバレはないですが、今までの立ち絵がすべて入っているので女体化以外もあります)\nhttps://drive.google.com/drive/folders/1bX9HGsG5rBzoCKRl03guGb23qShwxDeg?usp=drive_link\n\nシチュエーションや服装、髪型など全ておまかせしますので蒼さんが可愛いと思う姿で二人を描いて頂けると嬉しいです。\n※HO3の方は女体化した姿の時は髪が伸びています。\n\nあと個人使用の範疇でA5～B5くらいのサイズで印刷したりして楽しむ可能性があるため、文字などを別にしたPSDデータも頂けるととても嬉しいです。\n\nご縁がありましたら、よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@kneee_wkwk/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3046331, "client_id": 2859917, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4db55fd/uploads/origins/ad54df00-fd9f-49c0-a70b-1f98513312df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3995cbf88e51474bbef8e9f327314097", "srcset": "https://si.imgix.net/a4db55fd/uploads/origins/ad54df00-fd9f-49c0-a70b-1f98513312df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3995cbf88e51474bbef8e9f327314097, https://si.imgix.net/a4db55fd/uploads/origins/ad54df00-fd9f-49c0-a70b-1f98513312df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=30e47868f60e5dceff9da7aca23ab63c 2x, https://si.imgix.net/a4db55fd/uploads/origins/ad54df00-fd9f-49c0-a70b-1f98513312df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd748bfd547b0b5fcefdd18c6a58a53a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4db55fd/uploads/origins/ad54df00-fd9f-49c0-a70b-1f98513312df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2147972239d2e730581075de33c8b3a8", "srcset": "https://si.imgix.net/a4db55fd/uploads/origins/ad54df00-fd9f-49c0-a70b-1f98513312df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2147972239d2e730581075de33c8b3a8, https://si.imgix.net/a4db55fd/uploads/origins/ad54df00-fd9f-49c0-a70b-1f98513312df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0561c9d753af1e5980c6bdd2c2937f7a 2x, https://si.imgix.net/a4db55fd/uploads/origins/ad54df00-fd9f-49c0-a70b-1f98513312df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=014768541d1aa66dcd30d354ed637357 3x"}, "body": "お世話になっております。\nかのえさんのおしゃれなデザインが好きです！\n今回、「TRPGのキャラクターディスプレイ用のテンプレート」の作成をお願いしたくてリクエストいたしました。\n\n■概要\n・用途：Web上（主にX）での公開。\n・希望サイズ：縦横とも3000px程度の正方形\n・希望解像度：350dpi\n・希望保存形式：PSD\n\n自作のキャラクター立ち絵を合成し、キャラクター毎に一部を色変更して使用いたします。\n完成後にウォーターマークを付与して投稿する可能性があります。\n\nまた、キャラクターまとめとして個人的に印刷する可能性があります（あくまで個人利用の範囲に留め、商用利用はしません）。\n\n■デザインの中に入れて頂きたい項目/要素\n【項目】\n・TRPGのシステム名（略称可）\n・シナリオタイトル\n・ハンドアウト名\n（ハンドアウトが無い場合もあるのでON/OFFできると尚嬉しい）\n・キャラクター名\n・キャラクター名ふりがな、もしくはローマ字表記部分\n上記はWindowsでインストールできるフォントだと助かります。\n\n【要素】\n・キャラクターのイメージカラー（1色）に変更可能な部分\n　（色変更して良い部分を分かりやすいようにレイヤー分けして頂けたら幸いです）\n・キャラクターの立ち絵（全身）を配置する部分\n・キャレラクターの顔、またはお気に入りパーツのアップを配置する部分\n・印刷する可能性があるため、ぬりたし部分に項目が被らないようにしていただきたいです。\n　具体的にどのサイズで印刷するかは印刷しようとしたときに決めるので、項目を外側に行きすぎないように配置していただきますと助かります。\n\n\n他の項目・要素はお任せしたいです。\nご検討よろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usamaryuyo1/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1228497, "client_id": 2859917, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/19ebffdf/uploads/origins/d141563b-c135-41f0-864d-87dd4ab89906?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1789793ad33d0c9c4998ee525b6ab3e8", "srcset": "https://si.imgix.net/19ebffdf/uploads/origins/d141563b-c135-41f0-864d-87dd4ab89906?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1789793ad33d0c9c4998ee525b6ab3e8, https://si.imgix.net/19ebffdf/uploads/origins/d141563b-c135-41f0-864d-87dd4ab89906?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5ad5410c993e994cf972e42ad0dfab60 2x, https://si.imgix.net/19ebffdf/uploads/origins/d141563b-c135-41f0-864d-87dd4ab89906?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7245b54a94297c0225342ded89580fa1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/19ebffdf/uploads/origins/d141563b-c135-41f0-864d-87dd4ab89906?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8cb6e153a5bfcaa096d7838f265359e", "srcset": "https://si.imgix.net/19ebffdf/uploads/origins/d141563b-c135-41f0-864d-87dd4ab89906?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8cb6e153a5bfcaa096d7838f265359e, https://si.imgix.net/19ebffdf/uploads/origins/d141563b-c135-41f0-864d-87dd4ab89906?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eb8c95b39cad273534a711954c55b59a 2x, https://si.imgix.net/19ebffdf/uploads/origins/d141563b-c135-41f0-864d-87dd4ab89906?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=13cf3cc992c01272abc8bf60ecdc17ff 3x"}, "body": "こんにちは！\nこのたびはマイキャラを描いていただきたくリクエスト送信させていただきました。\n可能でしたら、個人鑑賞用にグッズにさせていただきたいです。\n\n・キャラクター\nhttps://drive.google.com/drive/folders/1h0LtZ0YR0mTGKIrAgWouvJRbFLHE4SJO?usp=drive_link\n\n5人のうち見た目などで気に入った子を誰でも良いので描いていただけると嬉しいです。\nみんなアイドルです。\n最後にまとめて参考的なものを置いておきますが、5人分書いておきますので読まなくても大丈夫です。\n\n服装・髪型はうさぴよさんのかわいいを詰めていただければと思います。\n自分では描かないものを見たいので、お任せさせていただきたいです。ヘアアレンジしてくれると嬉しいです！しなくてもいいです……！\n決めかねるようでしたら、フリルやリボン、セーラー、白いワンピース等が好きなのでそのあたりの気が向いたものを描いていただけますと幸いです。\n\n投げっぱなしですみません！ご縁がありましたらよろしくお願いいたします。\n\n\n・参考\n【なの】\nイメージカラー：黄、金\nイメージタイプ：ラブリー+ちょっとクール\n\n【ちえ】\nイメージカラー：水色\nイメージタイプ：ラブリー、ポップ\n\n【りの】\nイメージカラー：黄、金\nイメージタイプ：ラブリー+ちょっとクール\n\n【ちよ】\nイメージカラー：水色\nイメージタイプ：ラブリー、ポップ\n\n【しき】\nイメージカラー：ピンク\nイメージタイプ：ラブリー\n\nhttps://drive.google.com/drive/folders/1h0LtZ0YR0mTGKIrAgWouvJRbFLHE4SJO?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_conpt_/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2280921, "client_id": 2859917, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0f26f6f4/uploads/origins/28fedab5-db3d-4b96-ac32-f13b668f3274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8c6fd2a88a564ea1fcb0bd0300b15a6", "srcset": "https://si.imgix.net/0f26f6f4/uploads/origins/28fedab5-db3d-4b96-ac32-f13b668f3274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8c6fd2a88a564ea1fcb0bd0300b15a6, https://si.imgix.net/0f26f6f4/uploads/origins/28fedab5-db3d-4b96-ac32-f13b668f3274?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6336c93608e96ca4f763fd8c17acd08 2x, https://si.imgix.net/0f26f6f4/uploads/origins/28fedab5-db3d-4b96-ac32-f13b668f3274?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10c075894e6d04644f38f3a2d970460d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0f26f6f4/uploads/origins/28fedab5-db3d-4b96-ac32-f13b668f3274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da01b3b287518120a6c31a0e782b627c", "srcset": "https://si.imgix.net/0f26f6f4/uploads/origins/28fedab5-db3d-4b96-ac32-f13b668f3274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=da01b3b287518120a6c31a0e782b627c, https://si.imgix.net/0f26f6f4/uploads/origins/28fedab5-db3d-4b96-ac32-f13b668f3274?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a702458ace00cc8bd6abdece4db22843 2x, https://si.imgix.net/0f26f6f4/uploads/origins/28fedab5-db3d-4b96-ac32-f13b668f3274?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0b18db3146e85e49f92b2170a5b0efa2 3x"}, "body": "こんにちは。\n\nこの度、マイキャラのミニキャライラストを描いていただきたく、依頼させていただきました。\n可能でしたら、個人観賞用にアクスタ等にさせて頂きたいです。\n\n・キャラクター\nhttps://drive.google.com/drive/folders/1YA5RGh2UtmLhuLm6-7rf52w0rAOyYYUq?usp=sharing\n\n黒髪、金目\nイメージカラーは黄、金\nイメージタイプはラブリー+ちょっとクール\n\nグラフアートさんで描かれているミニキャラ、ヘアアレンジが大好きなので、\npapi様のかわいいと思うヘアアレンジをお願いさせていただきたいです。\n\n服装もアイドルっぽい衣装でお任せしたいです。\nアイドルっぽい服を描く気分でなければ、フリルやリボン、セーラー、白いワンピース等が好きなのでそのあたりの気が向いたものを描いていただけますと幸いです。\n\nグラフアートさんで描かれているミニキャラのデフォルメ具合、塗りの感じがとても好きなので、\nそのような絵柄で描いていただけると嬉しいです！\n\nご縁がありましたらよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1YA5RGh2UtmLhuLm6-7rf52w0rAOyYYUq?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 740245, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ゆふぃあ🐉♈", "screen_name": "yuffiiy", "avatar_url": "https://pbs.twimg.com/profile_images/2019797558798041088/JOCYt3lH.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2450811974/1694360559/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 153}, {"id": 1947103, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "佳奈", "screen_name": "eisenadler2", "avatar_url": "https://pbs.twimg.com/profile_images/1647963366927810566/AWsdrpL5.jpg", "header_url": "https://pbs.twimg.com/profile_banners/626415588/1688301520/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 2280921, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "もぐもぐpapi", "screen_name": "_conpt_", "avatar_url": "https://pbs.twimg.com/profile_images/1930170913900900354/qAFF6jIG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/935866887698653184/1748505714/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days":