d": 2561490, "nc": 16}, {"path": "/@kamee_f/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2561490, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/276bebfb/uploads/origins/8e197bb2-bc0a-4519-8189-c76aba1af3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6356d1ec1a8cc91931363891974f4e84", "srcset": "https://si.imgix.net/276bebfb/uploads/origins/8e197bb2-bc0a-4519-8189-c76aba1af3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6356d1ec1a8cc91931363891974f4e84, https://si.imgix.net/276bebfb/uploads/origins/8e197bb2-bc0a-4519-8189-c76aba1af3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c5c2b149597a771cda78ad0d959b1e20 2x, https://si.imgix.net/276bebfb/uploads/origins/8e197bb2-bc0a-4519-8189-c76aba1af3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ffef5ae53aab3e464bc47436392c62db 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/276bebfb/uploads/origins/8e197bb2-bc0a-4519-8189-c76aba1af3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c77023afadc7b4f8195ec3f6b624cc88", "srcset": "https://si.imgix.net/276bebfb/uploads/origins/8e197bb2-bc0a-4519-8189-c76aba1af3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c77023afadc7b4f8195ec3f6b624cc88, https://si.imgix.net/276bebfb/uploads/origins/8e197bb2-bc0a-4519-8189-c76aba1af3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0be820936c8afa46b0323b08f7ffd84f 2x, https://si.imgix.net/276bebfb/uploads/origins/8e197bb2-bc0a-4519-8189-c76aba1af3e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=77243b3629df140cad515fdbd9d60304 3x"}, "body": "お世話になっております、先日はステキなイラストありがとうございました。今回もジハンキーズ関連、加えて若干ややこしい差分希望ですがいったん見て頂けますでしょうか。\n\nhttps://www.110107.com/s/oto/page/carole_king?ima=0000&oto=ROBO004\nリンク先むかしの洋楽アルバムの記事なのですがこちら（アナログ盤画像）の女性をイチゴ牛乳持ったブリックパックのお姉さん（元の服でOK）、ちょっと焦点ぼけてる座布団猫をミケちゃんを思わせる三毛猫に置き換えて描いていただけますでしょうか。タイトルは「Brick Queen Strawberry」とかで…。部屋の細かいところはあまりこだわらず、陰影だけなんとなく雰囲気寄せていただけたらじゅうぶんです。\n\nそして差分なのですが陰影とタイトルぬけた状態で女性を優しげな表情のオオカミの女の子、猫をネコミミつけたベルミーくんに置きかえたバージョンを作成していただくことは可能でしょうか？けもふれの方でなく、かめえ様のまんがにときどき出てきてときめきトゥナイトごっこなどに興じている今泉かげろう？って子で。ベルミーくんはやる気なさげに座布団の上で寝仏のように右腕を下にして寝そべってる感じにしていただけたら。\n\nキャラ指定が紛らわしくてすみませんが、ご検討いただけましたら幸いです。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kamee_f/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2561490, "client_id": 2587953, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cf27e04e/uploads/origins/22510117-e304-44ee-9a9f-b6feaa6de686?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96c967622f2f940e7f828bdbda6bf0a8", "srcset": "https://si.imgix.net/cf27e04e/uploads/origins/22510117-e304-44ee-9a9f-b6feaa6de686?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96c967622f2f940e7f828bdbda6bf0a8, https://si.imgix.net/cf27e04e/uploads/origins/22510117-e304-44ee-9a9f-b6feaa6de686?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc3cd9b1192ec2bdf4c20dd8096b75de 2x, https://si.imgix.net/cf27e04e/uploads/origins/22510117-e304-44ee-9a9f-b6feaa6de686?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=11eaca239b16843bb3728bf59d69e7ff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cf27e04e/uploads/origins/22510117-e304-44ee-9a9f-b6feaa6de686?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0570e6966f35030fdf595be0febccd8b", "srcset": "https://si.imgix.net/cf27e04e/uploads/origins/22510117-e304-44ee-9a9f-b6feaa6de686?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0570e6966f35030fdf595be0febccd8b, https://si.imgix.net/cf27e04e/uploads/origins/22510117-e304-44ee-9a9f-b6feaa6de686?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=020299d9b337b6849f9243f371511533 2x, https://si.imgix.net/cf27e04e/uploads/origins/22510117-e304-44ee-9a9f-b6feaa6de686?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c24347dcd0e7633861b62e560a458bae 3x"}, "body": "かめえさんはじめまして！あぷべりと申します。\nこちらのイラストがとっても可愛くて、ぜひ私もレトロマンガ風にイラストを描いて頂きたくリクエストさせていただきました！\n→ https://skeb.jp/@kamee_f/works/2\n\n・こちらのレトロ漫画風で、構図はお任せします！コミカルな感じが大好きです。\n・私のキャラクターです（https://x.com/snoopy_gamble/status/1716288048504406111?s=20）\n・りんごがトレードマークです\n・性格は元気で楽しいことが大好きです\n・透過済みイラストもいただけますと幸いです\n・SNSや配信活動(サムネ、配信画面上など)に使用させていただきます\n　主に古いレトロゲームをプレイする際にSNSで使いたいと思っています\n\nお忙しいと思いますが、ぜひご検討宜しくお願い致します！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kamee_f/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2561490, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a6be71a/uploads/origins/1f7b5ab6-f2bc-4c92-8978-932450677a87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb07d7b5f55feda922072d259e85a36a", "srcset": "https://si.imgix.net/2a6be71a/uploads/origins/1f7b5ab6-f2bc-4c92-8978-932450677a87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb07d7b5f55feda922072d259e85a36a, https://si.imgix.net/2a6be71a/uploads/origins/1f7b5ab6-f2bc-4c92-8978-932450677a87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=146a03f2808f575a11b5cef098462c5c 2x, https://si.imgix.net/2a6be71a/uploads/origins/1f7b5ab6-f2bc-4c92-8978-932450677a87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88bb7f6562514db87082c6a250045951 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2a6be71a/uploads/origins/1f7b5ab6-f2bc-4c92-8978-932450677a87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27fb54b3c4d4506ef4b4b15e7fe3b323", "srcset": "https://si.imgix.net/2a6be71a/uploads/origins/1f7b5ab6-f2bc-4c92-8978-932450677a87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27fb54b3c4d4506ef4b4b15e7fe3b323, https://si.imgix.net/2a6be71a/uploads/origins/1f7b5ab6-f2bc-4c92-8978-932450677a87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=764769f63c564701b966145a583eefff 2x, https://si.imgix.net/2a6be71a/uploads/origins/1f7b5ab6-f2bc-4c92-8978-932450677a87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dde4add688cd0d27f246733e806de903 3x"}, "body": "お世話になります、いつもまんが楽しく拝見しております。\n前回は行き違いがあったようで残念でしたがもう一度チャンスいただけたらと思い再度リクエストさせていただきます。\nとはいえ新作お描きになられて間もないので今回はイラスト依頼とし、\nまんがは次回以降お願いできたらうれしいです。\n\nhttps://drive.google.com/file/d/1M6ndpS2bWZiTsHmRsfTd_AiaK7z9ODTq/view?usp=drive_link\n\nこちら昔のギャング映画と思われる作品のアナログ盤ジャケットなのですがこれをジハンキーズに置き換えたパロディ絵をお願いできますでしょうか。\n\n・中央のおじさんはBOSSの横顔（おさまり優先でパイプあってもなくてもOK）\n・右ピストルかまえた人物はMr.バーガー\n（ハンバーガーもしくはパーティープレートみたいなやつを差し出してる）\n・左の女性はブリックパックのお姉さん（自販機のイラストそのままでOK）\n・アーティスト名はジハンキーズでA面タイトル「釣り銭切れのシンフォニー」B面「釣り銭泥棒ども」\n（『オートスナック〜』とそろえていますが送りがな端折ってもOK）\n・回転数のマークは前回のものでその他細かい文字は省略していただく\n\nブーストで上乗せしようと思っていた分をあらかじめ含めた上で提示させていただいています。コミッション依頼する側としてそれなりに場数を踏んでおり、おまかせ金額では安すぎると思い…。\n\nご検討よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kamee_f/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2561490, "client_id": 2309212, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a0c6676a/uploads/origins/c938c8ee-4cfa-40c6-890a-e21d29593768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7df45a7856ced41bbc3501b6a8f641a", "srcset": "https://si.imgix.net/a0c6676a/uploads/origins/c938c8ee-4cfa-40c6-890a-e21d29593768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7df45a7856ced41bbc3501b6a8f641a, https://si.imgix.net/a0c6676a/uploads/origins/c938c8ee-4cfa-40c6-890a-e21d29593768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7e5ffa474fb295b53a2b04cb350963f 2x, https://si.imgix.net/a0c6676a/uploads/origins/c938c8ee-4cfa-40c6-890a-e21d29593768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1f91af3bf95497c228eaf7493fc9075 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a0c6676a/uploads/origins/c938c8ee-4cfa-40c6-890a-e21d29593768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c5b6056554493ecb7ecbb4916037578", "srcset": "https://si.imgix.net/a0c6676a/uploads/origins/c938c8ee-4cfa-40c6-890a-e21d29593768?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c5b6056554493ecb7ecbb4916037578, https://si.imgix.net/a0c6676a/uploads/origins/c938c8ee-4cfa-40c6-890a-e21d29593768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d63e9ecbc2008fe0cef85187642b2333 2x, https://si.imgix.net/a0c6676a/uploads/origins/c938c8ee-4cfa-40c6-890a-e21d29593768?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1cf2d1995e95abf890fc90de7ac2cd57 3x"}, "body": "はじめまして\nPS1などのゲームを主に遊んでいるVStreamerの空木めいと申します。\n以前よりpixivでかめえ様の描かれた東方やけもフレの漫画がとても好きで、何度も繰り返し拝見させていただいておりました\nスケブをされているとお見かけして、今回リクエストを送信させていただきました。\n\n【描いていただきたいもの】\nかめえ様がけもフレ漫画で描かれている、コミックスの表紙イラストを空木めいで描いていただきたいです\n構図などは全ておまかせいたします\n\n【空木めいの特徴】\n・レトロゲーが好き\n・まんじゅうの神様\n・ヴァーチャルレトロ関西地方に住んでいる\n・関西弁でゲラ\n三面図はURLをご参照くださいますと幸いです\n\n【使用用途】\ntwitterやその他SNSでの自身の宣伝の際に使用させていただきたいと思っております。商用での利用はいたしません。\n\n金額相場がわからずそのままの金額で送信しておりますので、金額が不足していたらリクエストの再送をいただけますとありがたいです。\n慣れぬリクエストで失礼な文面やおかしな文面になっていたら本当に申し訳ございません。\n\nもしよろしければ、ご検討いただけますと幸いです。\n長文失礼いたしました。\n\nhttps://twitter.com/UtsuG_mEi/status/1663390153237499904?t=isB9i2Y3pxhFr_Mk-GzTbA&s=19", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kamee_f/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2561490, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f00c80da/uploads/origins/c62bdcf1-b931-4359-bbde-bc29ca0dbbf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d49465f82d5e9acabdc1ae5ded1102a", "srcset": "https://si.imgix.net/f00c80da/uploads/origins/c62bdcf1-b931-4359-bbde-bc29ca0dbbf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d49465f82d5e9acabdc1ae5ded1102a, https://si.imgix.net/f00c80da/uploads/origins/c62bdcf1-b931-4359-bbde-bc29ca0dbbf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=475ca73d61f7708a24c8298f0de95f13 2x, https://si.imgix.net/f00c80da/uploads/origins/c62bdcf1-b931-4359-bbde-bc29ca0dbbf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8436e5d811fcfd04101ebc8afa8285cd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f00c80da/uploads/origins/c62bdcf1-b931-4359-bbde-bc29ca0dbbf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59c432d0c9e4c0a1dc3b757b077b2355", "srcset": "https://si.imgix.net/f00c80da/uploads/origins/c62bdcf1-b931-4359-bbde-bc29ca0dbbf1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59c432d0c9e4c0a1dc3b757b077b2355, https://si.imgix.net/f00c80da/uploads/origins/c62bdcf1-b931-4359-bbde-bc29ca0dbbf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=634512b64f73e052868791bfaf3ee9ea 2x, https://si.imgix.net/f00c80da/uploads/origins/c62bdcf1-b931-4359-bbde-bc29ca0dbbf1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6505badc2e02b368665e0bcf6a5c4830 3x"}, "body": "こんにちは、今日も元気にお過ごしでしょうか。\n\n東方さんの絵はとても好きです！シンプルな画風がとてもかわいいです。\n\nもしこのリクエストを受け入れていただけるのであれば、仮面姉妹が戦うマギアレコードの漫画が欲しいです。\n\n子供の頃の三姉妹のコミカルなシーンです。コルボーが姉たちとアホーゲで剣術をしようと提案します。その結果、ラピヌが勝ち、他の二人の姉妹は切られたアホーゲを嘆いている様子が描かれている。ラピヌが歓声を上げる中、イザボーが戸惑いながら部屋に入ってくる。\n\nご考察ありがとうございました。\n\n後はお任せします。💕\n\n姉妹の参考文献（幼少期）：https://images.puella-magi.net/d/d1/Minou_lapine_corbeau_childhood.jpg?20180314042440\n\nIsabeau reference: https://images.puella-magi.net/9/9a/Isabeau_%2819_yo%29.png?20220318163511", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 67212, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🧀プリ男", "screen_name": "masakadu", "avatar_url": "https://pbs.twimg.com/profile_images/2012860420445347840/pSMwXha_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/56108135/1614879816/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 129}, {"id": 235230, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "らら", "screen_name": "matsu_rra", "avatar_url": "https://pbs.twimg.com/profile_images/1641527800799830016/SGfkin8O.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4100950392/1735972467/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "compl