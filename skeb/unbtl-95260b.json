\u308b\u8a2d\u5b9a\u3067\u304a\u9858\u3044\u3057\u307e\u3059\n\u307e\u305f\u66f8\u304f\u304b\u3082\u7a0b\u5ea6\u3067\u3059\u304c\u30c9M\u5c0f\u8aac\u306e\u633f\u7d75\u306b\u5229\u7528\u3057\u305f\u3044\u3067\u3059\n\u30b7\u30c1\u30e5\uff1a\n\u7740\u8863\u8d85\u9b54\u4e73&\u7279\u5927\u7740\u8863\u30dc\u30c6\u8179\u59ff\u306e\u5929\u4e45\u9df9\u592e\u4e8c\u4eba(\u8089\u584a\u6deb\u9b54\u306e\u64ec\u614bor\u7591\u4f3c\u990c\u3067\u5236\u670d&\u30bb\u30fc\u30bf\u30fc\u8863\u88c5)\u306b\u5acc\u60aa\u30fb\u4fae\u8511\u3055\u308c\u306a\u304c\u3089\u3001\u8089\u584a\u6deb\u9b54\u306b\u8eab\u4f53\u3092\u62d8\u675f\u3055\u308c\u305fM\u7537\u304c\u30a2\u30ca\u30eb\u3092\u30a4\u30b8\u30e1\u3089\u308c\u306a\u304c\u3089\u5927\u91cf\u643e\u7cbe\u3055\u308c\u308b\u30c9M\u30db\u30a4\u30db\u30a4\u30b7\u30c1\u30e5\n\u4e8c\u4eba\u3068\u3082\u30b4\u30df\u3092\u898b\u308b\u51b7\u3081\u305f\u76ee(\u9854\u306e\u4e0a\u90e8\u3084\u76ee\u5143\u307e\u3067\u5f71\u304c\u304b\u304b\u308b\u611f\u3058\u3067\u30cf\u30a4\u30e9\u30a4\u30c8\u306a\u3057)\u3067\u3001\u5909\u614b\u30de\u30be\u3078\u306e\u5acc\u60aa\u611fMAX\u3092\u4e00\u5207\u96a0\u3059\u3053\u3068\u306a\u3044\u4fae\u8511\u306e\u8868\u60c5\u3092\u5e0c\u671b\u3057\u307e\u3059\n\n\u4e8c\u4eba\u3068\u3082\u9854\u306f\u5b8c\u5168\u518d\u73fe\u3057\u3066\u304a\u308a\u307e\u3059\u304cM\u7537\u306e\u55dc\u597d\u306b\u5408\u308f\u305b\u3001\u539f\u4f5c\u4ee5\u4e0a\u306e\u8d85\u9b54\u4e73&\u30dc\u30c6\u8179\u5316\u59ff\u3067\u3001\n\u66f4\u306b\u56db\u80a2\u7b49\u304c\u878d\u5408\u3057\u3066\u3044\u305f\u308a\u8089\u584a\u3068\u7d50\u5408\u3057\u3066\u3044\u305f\u308a\u5909\u8c8c\u3057\u3066M\u7537\u306e\u8eab\u4f53\u3092\u62d8\u675f\u3057\u3001\n\u89e6\u624b\u5316\u6307\u3067\u30da\u30cb\u30b9\u3084\u4e73\u9996\u3092\u5ad0\u3063\u305f\u308a\u80a1\u9593\u3092\u3059\u3063\u307d\u308a\u8089\u584a\u304c\u8986\u3063\u305f\u308a\u3001\u80cc\u5f8c\u306b\u7c98\u6db2\u307e\u307f\u308c\u306e\u89e6\u624b\u3084\u8089\u584a\u304c\u8822\u304d\u7287\u3081\u3044\u3066\u3044\u308b\u69d8\u5b50\u3092\u5e0c\u671b\u3057\u307e\u3059\n\n\u4e8c\u4eba\u3068\u3082\u5168\u8eab\u7c98\u5ea6\u306e\u9ad8\u3044\u7c98\u6db2\u307e\u307f\u308c\u3067\u5168\u8eab\u304c\u3069\u308d\u3069\u308d&\u3079\u3068\u3079\u3068\u3067\u3001\u8d85\u9b54\u4e73\u3084\u30dc\u30c6\u8179\u306b\u670d\u304c\u3079\u3063\u3068\u308a\u3068\u5f35\u308a\u4ed8\u304d\u3001\n\u4e21\u624b\u304c\u7c21\u5358\u306b\u6c88\u3080\u7a0b\u67d4\u3089\u304b\u304f\u3001\u7247\u4e73\u3060\u3051\u3067\u4e21\u8155\u3067\u62b1\u3048\u8fbc\u3081\u305a\u3001\u982d&\u80f4\u4f53\u4ee5\u4e0a\u30b5\u30a4\u30ba\u304b\u3064\u670d\u8d8a\u3057\u3067\u3082(\u30bb\u30fc\u30bf\u30fc\u306f\u30d4\u30f3\u30af\u8272\u306e\u900f\u3051)\u52c3\u8d77\u4e73\u9996\u304c\u308f\u304b\u308b\u7740\u8863\u8d85\u9b54\u4e73\u3068\u3001\n\u6700\u512a\u5148\u3067\u305d\u308c\u306b\u8ca0\u3051\u306a\u3044\u30b5\u30a4\u30ba\u306e\u7279\u5927\u7740\u8863\u30dc\u30c6\u8179(\u598a\u5a20\u6deb\u7d0b\u4ed8\u304d)\u304c(\u64ec\u614b\u3067\u4f5c\u3089\u308c\u305f)\u8863\u88c5\u306e\u4e2d\u306b\u30ae\u30c1\u30ae\u30c1\u306b\u62bc\u3057\u8fbc\u307e\u308c\u5f37\u8abf\u3055\u308c\u3001\n\u8d85\u9b54\u4e73\u3084\u30dc\u30c6\u8179\u5185\u90e8\u306b\u5b55\u3093\u3060\u3001\u7c98\u6db2\u307e\u307f\u308c\u306e\u5927\u91cf\u306e\u89e6\u624b\u304c\u8822\u304d\u5916\u304b\u3089\u898b\u3066\u3082\u6b6a\u306b\u5909\u5f62\u3057\u3066\u3044\u308b\u63cf\u5199\u5e0c\u671b\u3067\u3059\n\nM\u7537\u306f\u56db\u80a2\u3084\u80f4\u4f53\u3092\u8089\u584a\u6deb\u9b54\u3084\u7570\u5f62\u5316\u3057\u3066\u3044\u308b\u5f7c\u5973\u9054\u306e\u90e8\u4f4d\u306b\u3088\u308a\u62d8\u675f\u3055\u308c\u3066\u304a\u308a\u3001\u30da\u30cb\u30b9\u3084\u7389\u888b\u3001\u81c0\u90e8\u3092\u89e6\u624b\u3084\u8089\u584a\u7b49\u306e\u7570\u5f62\u5668\u5b98\u304c\u30e2\u30b6\u30a4\u30af\u4e0d\u8981\u30ec\u30d9\u30eb\u3067\u5b8c\u5168\u306b\u8986\u3063\u3066\u5185\u90e8\u3067\u30da\u30cb\u30b9\u3084\u524d\u7acb\u817a\u3092\u5ad0\u308a\u3001\u89e6\u624b\u3084\u8089\u584a\u