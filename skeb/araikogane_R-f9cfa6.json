パ」「フロントマスクモチーフの白縁ゴーグルorバイザーor眼鏡」といった出立ちのイメージがあります。\n構図に関しては、完全にお任せします。\n\n昨年1月に元所属チームが解散して以来、大変な状況が続く中で頑張っているアイドル的な車輌なので、少しでも「師匠」を知って好きになってくれる人が増えるきっかけになれば、という思いで依頼させていただきました。\n9月下旬開催の24耐に向けて、応援ツイートに使用させていただければと思います。\n\nhttps://dic.nicovideo.jp/a/%E3%83%9E%E3%83%B3%E3%82%BF%E5%B8%AB%E5%8C%A0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@araikogane_R/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 145639, "client_id": 482782, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb3a34ca/requests/82756_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c00664129a07cb6f1f61347cb93e6a83", "srcset": "https://si.imgix.net/eb3a34ca/requests/82756_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c00664129a07cb6f1f61347cb93e6a83, https://si.imgix.net/eb3a34ca/requests/82756_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7cf9beebec4b885356fc88f07985fbc 2x, https://si.imgix.net/eb3a34ca/requests/82756_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a07e1fe82311894b6a84228485c8326a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb3a34ca/requests/82756_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4561eb915017bfaff59f0186c96395c1", "srcset": "https://si.imgix.net/eb3a34ca/requests/82756_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4561eb915017bfaff59f0186c96395c1, https://si.imgix.net/eb3a34ca/requests/82756_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c1d047acfd642077badd82e1cdf9ed80 2x, https://si.imgix.net/eb3a34ca/requests/82756_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dfc560d06e4