mat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0974e1ce4d1890a741e6f37cfd7bb1ee, https://si.imgix.net/6a4e5a2d/uploads/origins/19392a07-2fb1-4eda-95bc-ad0c25a88c98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9dff1b87700713904485c282de1e3f5f 2x, https://si.imgix.net/6a4e5a2d/uploads/origins/19392a07-2fb1-4eda-95bc-ad0c25a88c98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e22d494dabaa34d45d18ae7e33af6809 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a4e5a2d/uploads/origins/19392a07-2fb1-4eda-95bc-ad0c25a88c98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8f8214e31ebf0e3668863668f660dfd", "srcset": "https://si.imgix.net/6a4e5a2d/uploads/origins/19392a07-2fb1-4eda-95bc-ad0c25a88c98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8f8214e31ebf0e3668863668f660dfd, https://si.imgix.net/6a4e5a2d/uploads/origins/19392a07-2fb1-4eda-95bc-ad0c25a88c98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=14336fb66019b14a03b6a249962678b0 2x, https://si.imgix.net/6a4e5a2d/uploads/origins/19392a07-2fb1-4eda-95bc-ad0c25a88c98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=be50d9826792cd8a34a8dfdcc814827f 3x"}, "body": "いつもイラスト拝見しております。\n\n今回依頼したいのは私が普段VRChatで使用しているアバターと私が普段使用している車です。\n構図等についてはお任せしたいと考えますが、縦横比は横長のイラストにしていただけると助かります。\nアバター資料　身長ちょっと高めで全身義体の高級サイボーグです。首筋に電脳通信用プラグがついています。\nhttps://x.com/seburof/status/1845876024023961933\n\n車資料　車種は日産ジュークのサンライトイエローです。\nオプションとしてルーフスポイラー(サンライトイエロー)、スポーツストライプ(ブラック)を選んでいただけると私が普段使用している愛車と同じ仕様になります。\nhttps://www.nissan.co.jp/SP/JUKE/COLOR/SIM/simulation.html\n\n以上\nよろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@araikogane_R/works/9", "private_thumbnail_image_urls": null, "private":