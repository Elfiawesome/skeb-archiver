top&w=200&h=200&blur=200&s=d49abc9bf389f85f812dfb22a83d3163", "src_set": ""}, "body": "またまたこんにちは!\n今回は私のOCの新しいデザインを作りましたので、妖怪ウォッチのフクロウと一緒に、一番左の人型バージョンを描いていただけませんか？\nフクロウは喜ばせることに熱心なキャラクターなので、私のOCにちょっと頭を下げてプレゼントを差し出しているのかもしれません...。また、私のキャラクターは、フクロウのことが少し好きで、喜んでいるように見えるのかもしれません。\n\nhttps://yokaiwatch.fandom.com/wiki/Fukurou\nhttps://toyhou.se/31284835.renaarr/35357322.shadowside-design\n\nありがとうございます", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nogizi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3213222, "client_id": 2755146, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/af867079/uploads/origins/4287201d-4041-4e8c-af6e-b0c0cc9d4d8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48c4beb4ff5860a6b7ddddc89343d4cc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/af867079/uploads/origins/4287201d-4041-4e8c-af6e-b0c0cc9d4d8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf4c1040db2fb4a7d9ec0000e89be2f3", "src_set": ""}, "body": "こんにちは！妖怪ウォッチのアンキーン/破怪と私のキャラクターを描いていただけませんか？https://toyhou.se/31284835.renaarr。\n\n私のOCは小さい海賊の男です...。彼は少し動揺しています。ウンキーンとは友達なんだけど、ウンキーンを超イケメンと思っていて、彼のデカさと強さに夢中になっている...。\nウンキーンは気づいてないし、気にしてないんだろうな。\n\n何がいいのかよくわからないけど、アンキーンの肩の上に座るとか、犬や猫のように抱っこされるとか！あるいは、食べ物を分け合うとか...。仲良くスパーリングとか？どんなアイデアでも構いません！\n\n他は何でもOKです^_^ ご検討よろしくお願いします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nogizi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3213222, "client_id": 3582558, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5e89510/uploads/origins/8d08d775-1d12-4cdb-bb0f-79016d4fdd01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c20cafd983d3d85f72cd6a18c6b3bbc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5e89510/uploads/origins/8d08d775-1d12-4cdb-bb0f-79016d4fdd01?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0813868665b308591341bc7c5e5fd07e", "src_set": ""}, "body": "こんにちは！ゲーム「A hat in time」のオリジナルキャラクターと車掌さんを描いていただけませんか？\n\n私のオク：\n名前はミロ。金髪の乱れた短髪で、ブルーグレーの目で、白人。青いジーンズに白いTシャツと黒いジャケット、赤と白の靴。よく顔を赤くして、本当にいい人そうに見える。\n\n参照\nhttps://media.discordapp.net/attachments/1357345421998948413/1357367421119496233/image.png?ex=67eff26b&is=67eea0eb&hm=edccd3b56e071e767a90d2e43727d8c41940cb45d4fde2836a153635942c452f&=&format=webp&quality=lossless\n\n指揮者：\n映画監督。普段は不機嫌で、いつも「ペックネック！」と叫んでいる。黒いスーツに紫のネクタイ、ピンのついた小さな黒い帽子をかぶっている。\n\n私が後ろからハグして、彼は不機嫌なふりをしようとしているが、赤面している。\n私のOCのサイズを車掌さんサイズに合わせてもらえますか？\n\n背景は特に問いません、ユニカラーで十分です！\nライトニングとシェーディングも必須ではありません！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nogizi/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3213222, "client_id": 3573704, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/41f4b626/uploads/origins/f7f1d789-36f7-4489-94b1-d4621f32bd7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=643cfcb316b0f2f8b68c35bff4f00d48", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/41f4b626/uploads/origins/f7f1d789-36f7-4489-94b1-d4621f32bd7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86975d3b42625c5053f5257d478cedb2", "src_set": ""}, "body": "大逆転裁判の亜双義一真君と成歩堂龍ノ介君をお願いしたいです。\n\n《背景》\n桜を風景に､成歩堂君が頭に乗せていた学帽がお姫様抱っこされたことによって宙に浮き、楽しそうに にゃそうぎ と ちゅうのすけも宙に浮いている構図でお願いします。\n\n《服装》\n亜双義：学ラン(シャツと黒ズボンとベルト)・赤鉢巻・腕章\n\n成歩堂：学ラン・外套・学帽・⚔️の日本刀\n\n《ポーズ》\n亜双義が成歩堂をお姫様抱っこ\n\n《表情》\n⚔️：にっこり笑っている(声に出して笑ってる感じの為口は開いてる) (亜双義の鉢巻はユラユラとさせて下さい)\n\n🍡：突然お姫様抱っこされて驚いた顔\n\n《持ち物》\n\n成歩堂：亜双義の日本刀を両手で大切に持っている。\n\nまた亜双義の学ランのジャケットと外套は大雑把に成歩堂に持たせていただければ！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nogizi/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3213222, "client_id": 3369288, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61f0212a/uploads/origins/0c5cf674-db19-4e92-b10e-d844e5da4a64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a73d3c7a834df80b7951d04f1e28978", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61f0212a/uploads/origins/0c5cf674-db19-4e92-b10e-d844e5da4a64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6f06d4e6f4cf9063583babc15c5bd11", "src_set": ""}, "body": "こんにちは！アリストテレスとビリーを星をバックに一緒に描いてくれませんか？ありがとうございます！二人のキャラクターはこれで十分だと思います！良い一日をお過ごしください！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nogizi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3213222, "client_id": 3316306, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b668f1b3/uploads/origins/e769e29f-6821-4f2e-9dbb-7d806dc86e85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c1eb6109beac08afcd71f48decfc6f0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b668f1b3/uploads/origins/e769e29f-6821-4f2e-9dbb-7d806dc86e85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c2baacdff8a5e5fc0fab5bd647a911d3", "src_set": ""}, "body": "【リクエスト】\n擬人化Billieちゃんと擬人化Fantoさん\n＋原型Oscarちゃんと小さい原型Barnabyさん\n\n【詳細】\nハリー・ポッターのホグワーツの制服を着た擬人化２人とOscarちゃんと小さいBarnabyさんをお願いします。\n\n●制服の寮はどこでも大丈夫です。\n\n●OscarちゃんとBarnabyさんはそれぞれ２人のフクロウポジションという設定で。\n\nあとの細かい部分はおまかせでお願いします😄", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nogizi/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3213222, "client_id": 139034, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6c13c63d/uploads/origins/3f5b533a-2840-40b0-981f-97d0e1427c6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e8a82fceaa22834ad1f5d9c5405ff077", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6c13c63d/uploads/origins/3f5b533a-2840-40b0-981f-97d0e1427c6d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b303d0f8ae5a59032cac26850510eab", "src_set": ""}, "body": "はじめまして！\nうちの子のトランサをお願いしたいです！\n装備については、待ち針や片方外れたハサミ…といったような裁縫に関する武器を手に持っており\n服装は既存ではなく、のぎじさんのイメージした服装でお願いしたいです！\nシチュエーションなどにつきましてはおまかせいたします！\n\nhttps://x.com/electeclair/status/1676939471470886913", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "from_archive": true}