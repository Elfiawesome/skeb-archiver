0cm。リンは幼い頃から熱心な読書家だった。大学では医学部生だったが、途中で神学部に転部した。 卒業後、彼は跡形もなく行方不明になった。その間、シベリアの森を旅し、村々を巡りながら司祭兼田舎医として活動していた。二十年後、彼は突然かつて住んでいた街に戻ってきた。大学の親友が彼を見つけたが、彼がPTSDと戦争の鮮明な幻覚に苦しんでいることに気づいた。リクエストを読んでいただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/13A1kdvZiTk6n3wDMT-8RWGHiId_jxtry?usp=sharing", "nc": 153, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@edazonojigoku/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3880626, "client_id": 2378340, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e541bca/uploads/origins/a6c5e6c6-5441-4310-b6ee-b0fe79786d38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0c767da19d1bbd8a786a7c5afb53a00", "srcset": "https://si.imgix.net/1e541bca/uploads/origins/a6c5e6c6-5441-4310-b6ee-b0fe79786d38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0c767da19d1bbd8a786a7c5afb53a00, https://si.imgix.net/1e541bca/uploads/origins/a6c5e6c6-5441-4310-b6ee-b0fe79786d38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3951c732e81bcc89a7847f11aaf8f13a 2x, https://si.imgix.net/1e541bca/uploads/origins/a6c5e6c6-5441-4310-b6ee-b0fe79786d38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d3d13eeb95530e2cddc2947abc599b78 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e541bca/uploads/origins/a6c5e6c6-5441-4310-b6ee-b0fe79786d38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=281e4805f4b2dbe5851b62aaca0de159", "srcset": "https://si.imgix.net/1e541bca/uploads/origins/a6c5e6c6-5441-4310-b6ee-b0fe79786d38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=281e4805f4b2dbe5851b62aaca0de159, https://si.imgix.net/1e541bca/uploads/origins/a6c5e6c6-5441-4310-b6ee-b0fe79786d38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=74cb93688717ad7f6064ed7d77b3dc6c 2x, https://si.imgix.net/1e541bca/uploads/origins/a6c5e6c6-5441-4310-b6ee-b0fe79786d38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6b4daf57d2d0e91372bbb2269add4f45 3x"}, "body": "はじめまして。\n作品の雰囲気と色使いがとても好きで、ぜひ描いていただきたく依頼いたしました。\n\n■ Aki（アキ）\n霧の町に転入してきた謎めいた少年。古典文学とロックが好き。耳と唇に複数ピアス。時々、小さな傷あとが現れる不思議な体質。\n\n■ Rika（リカ）\n町の旧家の娘で、穏やかで優しいがどこか掴めない少女。保健室を手伝い、標本作りと神秘学が好き。《黒薔薇日記》という夢の記録帳を持つ。\n\n■ 世界観\n一年中、霧に包まれた小さな閉ざされた町。町外れには昭和末期の施設跡が残り、不思議な噂がある場所です。\n\nどうぞよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/ro6jz4rzm3y1pzflz7r1k/APxGHKwy42TOi1gVUhP3Rl8?rlkey=jt5c9anrp5cxgwlejq5v70gdr&st=ikvxbxqw&dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 199240, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ッィ＠お疲れ様でした", "screen_name": "snswakaran", "avatar_url": "https://pbs.twimg.com/profile_images/1837434279816843267/XsL2r-1z.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3064877006/1708657796/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 33}, {"id": 594066, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "kita", "screen_name": "kitachan0v0", "avatar_url": "https://pbs.twimg.com/profile_images/1316817048802979840/YJXuTikh.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1454920898/1616063440/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days"