eptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@Damowind522/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3047655, "client_id": 2556644, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b11e1d57/uploads/origins/b5e902ce-c53c-4b84-9e6e-c1ab1428fc64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=696f518e2b10a8cc0518fdf060e03a76", "srcset": "https://si.imgix.net/b11e1d57/uploads/origins/b5e902ce-c53c-4b84-9e6e-c1ab1428fc64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=696f518e2b10a8cc0518fdf060e03a76, https://si.imgix.net/b11e1d57/uploads/origins/b5e902ce-c53c-4b84-9e6e-c1ab1428fc64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=daafb077069c61e596a9a26455c20ef2 2x, https://si.imgix.net/b11e1d57/uploads/origins/b5e902ce-c53c-4b84-9e6e-c1ab1428fc64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ff7f04d01eaa9f51403fdadc35b93be 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b11e1d57/uploads/origins/b5e902ce-c53c-4b84-9e6e-c1ab1428fc64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=609a860249a3b661bad9e770407e1abb", "srcset": "https://si.imgix.net/b11e1d57/uploads/origins/b5e902ce-c53c-4b84-9e6e-c1ab1428fc64?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=609a860249a3b661bad9e770407e1abb, https://si.imgix.net/b11e1d57/uploads/origins/b5e902ce-c53c-4b84-9e6e-c1ab1428fc64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=53323c8b4564e7180162b1849b817b9d 2x, https://si.imgix.net/b11e1d57/uploads/origins/b5e902ce-c53c-4b84-9e6e-c1ab1428fc64?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6e7dd0152e176dc49aeba69d1c780629 3x"}, "body": "大風老师，你好\n我想为我朋友的OC约一张图（带一个差分），人物的外观可以参考这个链接，已经从她那里获得了约稿的许可：\n【imgur.com/a/RWH9410】\n穿着的衣服希望是一件睡裙，风格与【https://drive.google.com/file/d/1xpLJfiBC3pTlPGmqpAkvn2M-c8UlNv_8】里面的相似，但是没有那么多的装饰。\n发饰的话适当画一些就好。\n\n场景：\n这个角色站立在墙边，处于一种叫【茶巾縛り】的状态，将裙摆提过头顶，与举过头顶并交叉在一起的双手捆绑在一起，完全把角色的头部罩住。\n角色的裙子下面穿着胸罩和内裤（风格与裙子接近即可），但是内衣分别被两个自行车锁锁在了两个不同的物体上（比如：排水管道、栅栏、消防栓、公共汽车站牌，等等）。这两个物体有一定的间距，所以角色必须维持一个轻微不自然的站姿，来防止内衣被扯掉。\n具体上锁的方法可以参考这张图【https://www.pixiv.net/artworks/82921045】里面内裤锁在灯杆上的方法。\n\n差分：\n希望有一个将裙子的一部分透明化，能看见角色羞耻和轻微恐惧的脸的差分。\n嘴巴里塞了一个布团来防止呼救。\n\n细节上可以自由调整，可以像例图里面那样加一些小道具。也可以通过墙壁上投影的方式表现出有人在围观，但是画面中不必出现其他人。\n\n非常感谢！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Damowind522/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3047655, "client_id": 2183059, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4c857610/uploads/origins/03f7395a-3e76-47d1-a6e9-8da25dffa015?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d5e1b5d505507e5544e8af38589083a", "srcset": "https://si.imgix.net/4c857610/uploads/origins/03f7395a-3e76-47d1-a6e9-8da25dffa015?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d5e1b5d505507e5544e8af38589083a, https://si.imgix.net/4c857610/uploads/origins/03f7395a-3e76-47d1-a6e9-8da25dffa015?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff3db89f26984508683e8c3331f3f4d3 2x, https://si.imgix.net/4c857610/uploads/origins/03f7395a-3e76-47d1-a6e9-8da25dffa015?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a2a03f60e65bf4bd59392e10fff52043 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4c857610/uploads/origins/03f7395a-3e76-47d1-a6e9-8da25dffa015?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=630978b7be96df4f142223b4e8e67251", "srcset": "https://si.imgix.net/4c857610/uploads/origins/03f7395a-3e76-47d1-a6e9-8da25dffa015?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=630978b7be96df4f142223b4e8e67251, https://si.imgix.net/4c857610/uploads/origins/03f7395a-3e76-47d1-a6e9-8da25dffa015?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9c9595b243c170c41b9d503e80c422c8 2x, https://si.imgix.net/4c857610/uploads/origins/03f7395a-3e76-47d1-a6e9-8da25dffa015?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a1d71d14852c78e06a08b1a5b6beb685 3x"}, "body": "很高興見到你。我會提出一個請求。 ○角色高野鈴菜（Memories Off 2）○服裝競技泳裝運動鞋（不穿襪子）○參考https://imgur.com/a/r10UlDu○被原地強姦時失禁高潮○詳情從近距離到公眾的狀態被監視。 （參考：https://ul.h3z.jp/ATQBiArc.jpg）雙手放在桌子或儲物櫃上，雙腿被其他人張開的情況。 （參考：https://ul.h3z.jp/Al2nNiJb.jpg） 胯部有泛黃的痕跡。她的乳頭從泳衣下直立起來。一副生氣的樣子。接下來是失禁。差點把我的眼白都剝落了。露出舌頭的表情。最後，讓尿液滴落。我的臉上滿是淚水、流鼻涕和口水。地點是教室或學校的其他地方。泳衣沒有任何損壞。沒有生殖器暴露。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Damowind522/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3047655, "client_id": 761455, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6acc719a/uploads/origins/082aced7-305a-493f-a3de-4e24e2cdb4db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e56de3f4358bc73cb3ef3ac207a6aee2", "srcset": "https://si.imgix.net/6acc719a/uploads/origins/082aced7-305a-493f-a3de-4e24e2cdb4db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e56de3f4358bc73cb3ef3ac207a6aee2, https://si.imgix.net/6acc719a/uploads/origins/082aced7-305a-493f-a3de-4e24e2cdb4db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed7b520fdb92000612f312859fc17d2d 2x, https://si.imgix.net/6acc719a/uploads/origins/082aced7-305a-493f-a3de-