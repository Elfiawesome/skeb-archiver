生意気な時もありますがめちゃくちゃビビり。\n・途中で成長が止まったままなので幼さを残しつつも中身はお姉さん。\n\n※他詳細は資料に添付してありますが、\n描きやすい形で改変可能です。\n\n◆備考 \nサムネ等に使用する為、キャラクターの左右が途切れないようにして頂けると助かります。\n差し支えなければPSDファイルで背景・キャラクターのレイヤーをお分けしたく存じます。\nもしくは背景有り/透過済みのPNGファイルでいただけますと幸いです。\nまた、金額設定に不備がございましたら再送いたしますのでお申し付けくださいませ。\n\nここまでの長文失礼いたしました！\n何卒よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/16bAdghLKXj-yXT22UJMNLA6TM3KKl2UD\n\nhttps://drive.google.com/drive/folders/16bAdghLKXj-yXT22UJMNLA6TM3KKl2UD", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@UTIDE_UTIDE/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2866527, "client_id": 2320319, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d4d4ec74/uploads/origins/1dadc832-4cbc-48c2-96f4-a47e1e2c33c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c91fab5d6493f1d419c1d45d3408e8f", "srcset": "https://si.imgix.net/d4d4ec74/uploads/origins/1dadc832-4cbc-48c2-96f4-a47e1e2c33c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4c91fab5d6493f1d419c1d45d3408e8f, https://si.imgix.net/d4d4ec74/uploads/origins/1dadc832-4cbc-48c2-96f4-a47e1e2c33c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=be24be91a424bd13c137e74afd8bc5fd 2x, https://si.imgix.net/d4d4ec74/uploads/origins/1dadc832-4cbc-48c2-96f4-a47e1e2c33c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9346ec5821fb60835f82f5ee335a7483 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d4d4ec74/uploads/origins/1dadc832-4cbc-48c2-96f4-a47e1e2c33c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68f395b78e1ed6b8fee364f06e3be413", "srcset": "https://si.imgix.net/d4d4ec74/uploads/origins/1dadc832-4cbc-48c2-96f4-a47e1e2c33c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=t