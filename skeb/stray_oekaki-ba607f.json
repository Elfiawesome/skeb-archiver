0&h=200&blur=200&s=a5bcb25a434bf1cc13af7905f9398a92 3x"}, "body": "あるすさん、初めまして。果心居士ちゃんの胸部換装verでの　https://x.com/stray_oekaki/status/1815327809100984832　の擬似膨乳シークエンスを依頼したいです。\n内容ですが、マスターの為に不自然に空いた胸の空間はどういう絡繰なっているのか教えてくれる果心居士ちゃん。↑の衣装で胸部分の穴にホースの付いた萎んだ風船またはボールを二つ通してそのまま空気を注入して　https://www.pixiv.net/artworks/142493803　みたいに　何段階か偽乳を空気で充填し擬似膨乳をしている姿を頼みたいです。可能でしたらボールや風船なので胸は丸く球形で色も白など単色で、正面を向いた状態で、別で肌色ver（本物胸）も見てみたいです。最終的に衣装の紐がくい込む程デカくしておｋです。セリフや効果音などお任せします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@stray_oekaki/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2775448, "client_id": 1240810, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de19068b/uploads/origins/977889fa-7572-4d9b-9053-3ecf48cecfa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=199d063b334fea3e1df35a7eb02f623d", "srcset": "https://si.imgix.net/de19068b/uploads/origins/977889fa-7572-4d9b-9053-3ecf48cecfa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=199d063b334fea3e1df35a7eb02f623d, https://si.imgix.net/de19068b/uploads/origins/977889fa-7572-4d9b-9053-3ecf48cecfa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a99aa6758863de4901e8261b250f1544 2x, https://si.imgix.net/de19068b/uploads/origins/977889fa-7572-4d9b-9053-3ecf48cecfa1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aaba3c3ce4e1438cb71282d745b6202f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/de19068b/uploads/origins/977889fa-7572-4d9b-9053-3ecf48cecfa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e32e9d725ca4a37d714021c2defe5f0", "srcset": "https://si.imgix.net/de19068b/uploads/origins/977889fa-7572-4d9b-9053-3ecf48cecfa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=to