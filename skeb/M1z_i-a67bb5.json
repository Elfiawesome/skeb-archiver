fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d556440ec3305a13b7fbc66e96d4bb51", "srcset": "https://si.imgix.net/a26f4ee3/uploads/origins/fc4f9017-32fa-4345-a7c8-5d1af3e5fc15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d556440ec3305a13b7fbc66e96d4bb51, https://si.imgix.net/a26f4ee3/uploads/origins/fc4f9017-32fa-4345-a7c8-5d1af3e5fc15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1b4b1e73ef9a616c0bec236ed371d0ea 2x, https://si.imgix.net/a26f4ee3/uploads/origins/fc4f9017-32fa-4345-a7c8-5d1af3e5fc15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4215718f10d48b984e15cbc3eb663abd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a26f4ee3/uploads/origins/fc4f9017-32fa-4345-a7c8-5d1af3e5fc15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d48c8e2b4cc91c629c72c0bd1c564f6a", "srcset": "https://si.imgix.net/a26f4ee3/uploads/origins/fc4f9017-32fa-4345-a7c8-5d1af3e5fc15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d48c8e2b4cc91c629c72c0bd1c564f6a, https://si.imgix.net/a26f4ee3/uploads/origins/fc4f9017-32fa-4345-a7c8-5d1af3e5fc15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4da9583e756b34ae45e72cbfb652600d 2x, https://si.imgix.net/a26f4ee3/uploads/origins/fc4f9017-32fa-4345-a7c8-5d1af3e5fc15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4f224ee1768d82a62c0baadf934a215a 3x"}, "body": "はじめまして！\n絵柄が気になったのでご依頼しました。\nもしよろしければ、うちのOCの「土御門ノア」をお願いすることは可能でしょうか？ \n参考までに設定は以下のとおりですが、自由に描いていただいて構いません。\n███\n土御門 乃亜（つちみかど のあ）\nウルフショートの少女。ベレー帽を被り左手薬指に指輪をしている。\n帰国子女で夏休みは海外で過ごす期間の方が長い。（母親の母国に幼なじみの恋人がいる）\n\n瑠璃の魔法使いの二つ名と星（力場）に干渉する能力を持つ。\nあらゆる力場を自在に歪める事が出来る事から、敵の攻撃をねじ曲げる事で、自分や味方を守ることに長けていた。守りの要であると同時に活発な性格だった事もあり、仲間内の精神的な支柱だった。\n\n誰よりも能力の開花が進んでいた事もあり、海外渡航中に悪魔達からの集中攻撃を受けながらも単身で逆に全滅させている。\nだが帰国途中、搭乗した飛行機ごと敵の攻撃を受けて他の乗客と共に洋上へ落下。\n落下する飛行機内での敵の撃退と乗客の救助に持てる力の限りを尽くすが、旅行先で受け続けた敵の集中攻撃への対処による度重なる過度な能力負荷の蓄積からか、戦闘中に突如オーバーロードを起こしてしまう。何とか敵の撃退には成功するが、乗客の無事を確認するとそのまま力尽きて洋上に沈んだ。\n\n土御門乃亜の死は、空港で彼女を待っていた仲間たちにも、その旅客機の墜落の報せと彼女が仲間たちに残していた防御フィールドの消失の二つから、すぐに察せられる所となる。\n\n土御門乃亜の死後、彼女の父親が彼女に代わって仲間たちのサポートを行っている。\n███\n使用用途は個人活動全般(小説の挿絵等、SNSや個人サイト等でのキャラクター紹介・個人活動の告知等)を考えています。\nもしご都合が合えばよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-DcMbFogyxGgeHc_yHapPPyQpWBnHoyO", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@suya_uiro03/works/129", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3448233, "client_id": 2489993, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e06db74e/uploads/origins/e8a69e7e-73d5-466c-9fc3-1abc6d3e283d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=275510362e24f7621b5b77d8f16b01c4", "srcset": "https://si.imgix.net/e06db74e/uploads/origins/e8a69e7e-73d5-466c-9fc3-1abc6d3e283d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=275510362e24f7621b5b77d8f16b01c4, https://si.imgix.net/e06db74e/uploads/origins/e8a69e7e-73d5-466c-9fc3-1abc6d3e283d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cfbbe079cc69844442f3add66ffffdff 2x, https://si.imgix.net/e06db74e/uploads/origins/e8a69e7e-73d5-466c-9fc3-1abc6d3e283d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88d236684c0217a1ef75fe8d4102efd1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e06db74e/uploads/origins/e8a69e7e-73d5-466c-9fc3-1abc6d3e283d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6632e25e55cd9c851a53dbb7acc53aa", "srcset": "https://si.imgix.net/e06db74e/uploads/origins/e8a69e7e-73d5-466c-9fc3-1abc6d3e283d?