ます。年齢は14歳です。瞳は銀色か白色で落ち着いた感じで。髪は参考のように乱れている。笑顔は穏やか。\n\nhttps://imgur.com/a/UyFTStC", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@M1z_i/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2489993, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d5eee79/uploads/origins/bcf6c9af-b2a1-42c8-8de8-25ab9c496aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce563075d3ad7594187f6ebb999e8538", "srcset": "https://si.imgix.net/4d5eee79/uploads/origins/bcf6c9af-b2a1-42c8-8de8-25ab9c496aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce563075d3ad7594187f6ebb999e8538, https://si.imgix.net/4d5eee79/uploads/origins/bcf6c9af-b2a1-42c8-8de8-25ab9c496aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=075388177ff06b8c4f6d597c140515a0 2x, https://si.imgix.net/4d5eee79/uploads/origins/bcf6c9af-b2a1-42c8-8de8-25ab9c496aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58136f23f5de73fb68217e9310063e46 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d5eee79/uploads/origins/bcf6c9af-b2a1-42c8-8de8-25ab9c496aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56c563ff5e8a6e39141052048e435b51", "srcset": "https://si.imgix.net/4d5eee79/uploads/origins/bcf6c9af-b2a1-42c8-8de8-25ab9c496aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56c563ff5e8a6e39141052048e435b51, https://si.imgix.net/4d5eee79/uploads/origins/bcf6c9af-b2a1-42c8-8de8-25ab9c496aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=da1d03f719aeedc8bf70e758ad3a2770 2x, https://si.imgix.net/4d5eee79/uploads/origins/bcf6c9af-b2a1-42c8-8de8-25ab9c496aa9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&f