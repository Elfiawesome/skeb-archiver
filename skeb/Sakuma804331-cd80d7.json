。\n\n▽使用用途\n個人観賞、自陣内での共有、作者様明記のうえでSNS等での個人利用(アイコンなど)\n\n▽要望など\nSDイラストをお願いしたいです。服装は立ち絵の通りだと嬉しいです……！表情などはお任せいたします！\n\n▽参考資料URL\nhttps://drive.google.com/drive/folders/13KToqLVn0KfBirE24VoeQLkrX-7DpRRi?usp=sharing\n二人分まとめてあります。\n\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/13KToqLVn0KfBirE24VoeQLkrX-7DpRRi?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sakuma804331/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3762435, "client_id": 3875166, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8c50db7/uploads/origins/0146228c-f0a4-4c60-9191-d81e99e907a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e5ee7e4d6a3c4e29534c4b7bb012dca", "srcset": "https://si.imgix.net/e8c50db7/uploads/origins/0146228c-f0a4-4c60-9191-d81e99e907a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e5ee7e4d6a3c4e29534c4b7bb012dca, https://si.imgix.net/e8c50db7/uploads/origins/0146228c-f0a4-4c60-9191-d81e99e907a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4219a57a5e25e60aec45e2ac8be5cb76 2x, https://si.imgix.net/e8c50db7/uploads/origins/0146228c-f0a4-4c60-9191-d81e99e907a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=237a8d0a5250a454fabf4d845f393602 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e8c50db7/uploads/origins/0146228c-f0a4-4c60-9191-d81e99e907a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9fdcb43faef4355946d4fe82576a4656", "srcset": "https://si.imgix.net/e8c50db7/uploads/origins/0146228c-f0a4-4c60-9191-d81e99e907a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9fdcb43faef4355946d4fe82576a4656, https://si.imgix.net/e8c50db7/uploads/origins/0146228c-f0a4