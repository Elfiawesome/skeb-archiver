い場合は、キャンセルまたは再送要請等をお願いいたします。\n\nお忙しい所恐縮ですが、ご検討よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1kkndK6KOSysc6o_8weUdaPKNBc_xmt5B", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sakuma804331/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3762435, "client_id": 2654091, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3624448b/uploads/origins/2a493d44-8fbf-4a39-9f83-ace37980cf10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0c229141d8017af3e9b9ca85f2a90b4", "srcset": "https://si.imgix.net/3624448b/uploads/origins/2a493d44-8fbf-4a39-9f83-ace37980cf10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0c229141d8017af3e9b9ca85f2a90b4, https://si.imgix.net/3624448b/uploads/origins/2a493d44-8fbf-4a39-9f83-ace37980cf10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c440bea80bbdbbeee6d627f4b46f8bd 2x, https://si.imgix.net/3624448b/uploads/origins/2a493d44-8fbf-4a39-9f83-ace37980cf10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e1ace3c379ee1f5766faf0671f5e4fea 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3624448b/uploads/origins/2a493d44-8fbf-4a39-9f83-ace37980cf10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a982d2d383079fefac769c5fc207a79", "srcset": "https://si.imgix.net/3624448b/uploads/origins/2a493d44-8fbf-4a39-9f83-ace37980cf10?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a982d2d383079fefac769c5fc207a79, https://si.imgix.net/3624448b/uploads/origins/2a493d44-8fbf-4a39-9f83-ace37980cf10?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9bb6eadca3d827afe6c70b632cb262d2 2x, https://si.imgix.net/3624448b/uploads/origins/2a