rks/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1858171, "client_id": 911894, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/52cf621e/uploads/origins/eccc873a-0135-4526-8ebc-4da9425ae2ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36b529d7e3afb27548ba888f528fbf1d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/52cf621e/uploads/origins/eccc873a-0135-4526-8ebc-4da9425ae2ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a5adad65efcb066ed4ba25eb070d040", "src_set": ""}, "body": "作品ページのようなアイコンを依頼したいです！\nskeb初めてでどこまでリクエスト可能か分からないのですが、青と黒を基調としてほしいのと、ショートヘア、SECRETの心臓Tが好きなので着用していたらうれしいです！\nよろしくお願いします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nogi_08080/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1858171, "client_id": 930828, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/acd59781/uploads/origins/2223f92a-1647-4c3a-9564-4e9e77a3b388?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=debef55d4b2b0b1147ddc1ec46171c98", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/acd59781/uploads/origins/2223f92a-1647-4c3a-9564-4e9e77a3b388?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64ce2d55e3bc626806a8996e7279f48b", "src_set": ""}, "body": "長年の大ファンで、自分のキャラのイラストをお願いしたいです。元気でおてんばな僵尸です。ポーズや表情は自由に描いてください。色合いも自分の好きな色に変更可能です。\nお守りのデザインも特に決まっていませんので、自由に描いてください。  \n\nありがとうございました。\n\nhttps://drive.google.com/file/d/1dGXPkXEWEJfTL37trLwGKaa_BT9CnB9J/view?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Nogi_