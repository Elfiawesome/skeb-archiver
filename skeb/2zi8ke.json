もしよろしければリクエストを受けていただけないでしょうか\nモデルはサービス終了したネットゲームのマイキャラクターになります\nお淑やかな性格でむっつりスケベ、胸は控えめのスレンダーな子で、お尻が性感帯です\n\n・希望する内容を箇条書きで（共通部分）\n恋人とのいちゃらぶセックス\n「依頼衣装」ファイルの衣装で、犬耳を着け、尻尾付プラグをお尻に挿入した状態（付け根のプラグが見えないような、尻尾だけお尻から伸びているような形状）\nもし可能であれば尻尾は無しでアナルセックス（案2）\nとろとろで気持ちよさそうな表情\n相手の描写は無くても構いません\nゲーム内モデルでは胸が大きいですが、控えめにアレンジをお願いします（Bカップ程度～つるぺたまでお好みで）\n服は着衣・半脱ぎ・下着のみ・全裸 でお任せします（細かい装飾などは省略やアレンジしていただいて構いません）\n顔が見える内容で、その他構図などは描きたいものでお任せします\n\n・案1\n犬になりきりながら気持ちよくなっているイメージ\n\n・案2\nアナルセックスで、おしりでとても気持ちよくなっているイメージ\n\n上記のような内容で喘ぎ声、セリフがあると嬉しいです\n可能であれば、絶頂・事後などの差分があると嬉しいです\n\nご検討をお願いします\n\nhttps://drive.google.com/drive/folders/1gXZVDfcsl66QZ8VxPLKFXERqQXKioNsJ", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2zi8ke/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3453964, "client_id": 538682, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/10f9d55d/uploads/origins/e59a8075-1925-4b96-b079-ab15b704de0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46695ac975d69a6b7a927f5dc2858fa3", "srcset": "https://si.imgix.net/10f9d55d/uploads/origins/e59a8075-1925-4b96-b079-ab15b704de0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=46695ac975d69a6b7a927f5dc2858fa3, https://si.imgix.net/10f9d55d/uploads/origins/e59a8075-1925-4b96-b079-ab15b704de0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=012a5d6f167f31e6ea043901f2eb5d73 2x, https://si.imgix.net/10f9d55d/uploads/origins/e59a8075-1925-4b96-b079-ab15b704de0a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b220a01bef272d04de977120420b5df1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/10f9d55d/uploads/origins/e59a8075-1925-4b96-b079-ab15b704de0a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7859c21f