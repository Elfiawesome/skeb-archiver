r=200&s=ff5c7e17a13a0a46cd7a409c7d2038b5, https://si.imgix.net/1d381b1e/requests/164137_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=86bfb779230dd9965f70f88851db7503 2x, https://si.imgix.net/1d381b1e/requests/164137_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4313b900b52ffa313a2ff26904bd771a 3x"}, "body": "はじめまして！ドルフロのP90のイラストをお願いできないでしょうか。\n服装はクリスマススキンです。\nP90は橋の欄干に寄りかかって可愛くて優しい笑顔をしています。後ろには川があって、夜空もあります。雪が少し振っています。光源は主に月光がいいと思います。\n\nめつりんさんのテンニンカのイラストみたいな雰囲気が見たいです。すごくきれいなイラストです！\nhttps://www.pixiv.net/en/artworks/82269119\n\nサイズ比率は16：9でお願いしたいですがよく合わなかったら変えてもいいです。\nよろしくお願いします。\n\n服装や基本情報\nhttps://wikiwiki.jp/dolls-fl/P90#q1575e30\nhttps://gfl.zzzzz.kr/doll.php?id=245\n\n服装（png）\nhttps://gfl.zzzzz.kr/img/characters/P90_2802/pic/pic_P90_2802.png\nhttps://gfl.zzzzz.kr/img/characters/P90_2802/pic/pic_P90_2802_d.png", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@m3turin/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 24012, "client_id": 57223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/888f5622/requests/142732_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7b4a46d1b05815e5767134659596a8d", "srcset": "https://si.imgix.net/888f5622/requests/142732_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7b4a46d1b05815e5767134659596a8d, https://si.imgix.net/888f5622/requests/142732_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d96557bf09485bf140ef4a2bb63d1b1f 2x, https://si.imgix.net/888f5622/requests/142732_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b5a31123e66372d71908b9ea0bdcb391 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/888f5622/requests