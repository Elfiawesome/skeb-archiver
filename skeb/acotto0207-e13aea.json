berのテーマソング／開始BGM用に依頼します。デザインは下記リンク先です。パロディ風ファンタジーキッチンに合うものが希望です。キャラクターは間抜けで、元気いっぱい、おバカで、クールです。クリーンなループ感のある曲にしてください。\n\n活気があり、スタイリッシュで、キャッチーな曲にしてください。配信中に私が離席している間のBGMとして使いたいのです。ジャズ、オーケストラ、エレクトロニック・スウィングのジャンル融合のような感じ。ご自由にアレンジしてください。参考ファイル内の「AkiraCommission」という画像が、このテーマソングに添える画像です。好きなインスピレーション源：あなたの「work 4」投稿\nTrainwreck of Electro Swing (Remix) - Pascal Michael Stiefelペルソナ5 - ラストサプライズバトル！ペニー - ポケモン スカーレット・バイオレットキャラバンパレスキャラクターデザイン: https://drive.google.com/drive/folders/1tZGHqFdRn8paKHpuy_EyF5Y-m_yy8hQL?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@acotto0207/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": false, "creator_id": 750067, "client_id": 3706068, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1925133612573483008%2F9EM3bQEV.png?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51b46e303090f611f356ec02c0e7b091", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1925133612573483008%2F9EM3bQEV.png?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51b46e303090f611f356ec02c0e7b091, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1925133612573483008%2F9EM3bQEV.png?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=482d5f95a48ba7389a4b3b5221691786 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1925133612573483008%2F9EM3bQEV.png?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=021a664b6631afb0b3887baa1ffe9eea 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/51c2a45b-f78b-47ce-bb19-c821dae34ece?response-content-disposition=inline&Expires=1784792089&Signature=QMwgTNr9TwMBGMdYf~KHf2N0iXorKxu~~W6pth7LZzH8wRTXSs2FZn~GTLDTa5vZvB-ciz74zOS6o2g-INmiJBte2uhsZICQp8OwqcpwycX