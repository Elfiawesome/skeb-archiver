cceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@uohc_net/works/122", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 7629, "client_id": 2811412, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/81ff7c04/uploads/origins/5e328f87-cdf4-4029-874b-13a219d082ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd8b533a9c9d535742db6ed0eebabbe5", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/81ff7c04/uploads/origins/5e328f87-cdf4-4029-874b-13a219d082ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e543958562a05222bb0aa2a75f78c6fb", "src_set": ""}, "body": "こんにちは、ドールズフロントラインのM1911のイラストをお願いします。M1911はモッズ3の衣装を着て、スカートを上げて鏡に向かって自撮りをしています。M1911はパンティをはいておらず、金髪の陰毛が生えている。彼女の陰毛はハート形に刈り込まれている。\n\nM1911は微笑みながら、吹き出しの中で \"See you again soon, my darling~ ❤️\" と言っている。\n\nM1911はまた、自撮り写真と司令官のことを考えて興奮しており、マン汁が数滴脚を伝っている。\n\nあと、M1911のスマホにMk23のチビのシールかチャームが貼ってあったらいいな。\n\nありがとうございました。\n\nhttps://drive.google.com/drive/folders/1MO__BPgVwp6RfU2Wv0_odR5E-LhNrpOK", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uohc_net/works/121", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c661eb4d/uploads/origins/e46120fe-960f-4a4e-bcb9-1449350fddd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=913fa1e99c72b92a3199ff2bbdc58a61", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 7629, "client_id": 2170899, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@uohc_net/works/120", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 7629, "client_id": 64695, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fb359e96/uploads/origins/905c8db0-323b-46d8-bace-660569c868b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88b0ea26ebdf319ef9bbae918739e8da", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fb359e96/uploads/origins/905c8db0-323b-46d8-bace-660569c868b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3a92f7adc43c692c0d03b495f279e66", "src_set": ""}, "body": "はじめまして、過去依頼作品を見ての雰囲気を気に入り今回依頼させて頂きました\n\n依頼内容はドールズフロントラインより、SV−98mod3とAR-15mod3のイラストです\n\nシチュとしては何件か過去に描かれていたホテルの寝室で大きめのベッドに座り２人で並んで座って指揮官を待っていた、コレから一晩中生本番セックス直前の状況\n\nAR-15はまだ少し恥ずかしげな感じで、でもコレからの行為に期待している表情\nSV−98はAR-15の腰に手を回して密着して座り、リードしている感じで少しレズっ気も感じる色気のある表情で指揮官を誘っている\n（戦場での相棒設定、でも2人とも指揮官が一番なので留意して貰えれば、難しい指定申し訳ありません）\n\n服装は2人ともバスローブ\n（98は白、15は黒系の両方薄手生地）\n\n差分で上半身脱ぎ（はだけ）、全裸を貰えれば嬉しいです\n\n髪型は98はポニテのまま、バンダナは無くても構いません、15は髪を解いている\n\n胸はSV−98は大きめに盛って貰ってもok（乳輪は小さめ）、AR-15は98と比べれば小さい程度に胸サイズ大きくしてもらって大丈夫です（キャラと絵としてのバランス取りとえっちさを優先して頂ければ）\n\n両名とも左薬指に誓約指輪付き、陰毛は両名無毛、または薄めでお願いします\n\n長々と指定してしまいましたが宜しければお願いします", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uohc_net/works/119", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/42629dcb/uploads/origins/b17f41cc-6cc3-4dbd-afe5-8ee485cbf9d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9decf0d833169110adf9c58ab81e4c45", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 7629, "client_id": 2170899, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore