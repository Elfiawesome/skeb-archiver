lient_id": 284832, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a77431a3/uploads/origins/d007568c-7dcf-4505-8c88-c58ab610aa6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f01ccae6c94f60a981f015fdee0ed76", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a77431a3/uploads/origins/d007568c-7dcf-4505-8c88-c58ab610aa6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3769f37f63cff2ebd1012049456a712a", "src_set": ""}, "body": "こんばんは！\n\n今までいい作品を見て、この機会にドルフロのリクエストをしようと思います。\n\nM2HBがウェディングドレスを着た姿をお願いしたいです。\n\nウエディングドレスのデザインはお任せしますが、スカートに横開きがあって足を出す要素はあるといいですね。\n\nできればお願いします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uohc_net/works/96", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cb3022ed/uploads/origins/98ad8c5f-135e-4cb6-8ea8-7ab3af159502?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ca29036109919772deb522b02ad8fd3", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 7629, "client_id": 1300169, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 51, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@uohc_net/works/95", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 7629, "client_id": 328467, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/86a84a43/uploads/origins/958db426-c4e1-45bf-a24e-40efd1b0544b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9ee7cb34a95a05cce15607c554ae9169", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/86a84a43/uploads/origins/958db426-c4e1-45bf-a24e-40efd1b0544b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=80a60394fc743651f76143a33b8017d9", "src_set": ""}, "body": "私の書いた小説に登場する香月理桜というキャラクターをお願いしたいです。\n\nこの話（https://www.pixiv.net/novel/show.php?id=21130143）のヒロインです。\n読んでいただかなくて大丈夫です。\n内容はこのヒロインが友人を庇うためにＡＶに出演することになるという内容です。\n\n見た目の設定は以下の通りです。\n・黒髪のストレートで長さは腰くらいまで\n・顔立ちは綺麗系\n・目はほんの少しつり目\n・身長は166cm\n・胸は大きい\n・お尻や太ももは平均的\n\nシチュエーションは拘束された理桜が何度も絶頂させられ、ぐったりとしているという様子を描いていただきたいです。\n黒革の首輪を嵌めていて、その首輪の金具に両手首の黒のベルトを鎖で繋がれているというような格好でお願いします。両手が首から10cmも離せないような感じです。\n（伝わりにくいと思うのでそれらしい商品のAmazonのページです。https://www.amazon.co.jp/dp/B07NWW9JY2）\n\n格好は全裸で、拘束具を嵌められ、ベッドの上で仰向けになってぐったりしている様子をお願いします。ほとんど失神していて、目は虚ろな感じに描いていただけると嬉しいです。\n両腕は首輪に拘束されるため折りたたんだ状態で、両脚はカエルのように開いてしまっているという格好です。\n\n開いた両脚の間には噴いてしまった潮でベッドシーツに大きな染みを作っているところも描いていただけると嬉しいです。\n\n作中に男性は登場しないのでコンドーム等の精液描写はなしでお願いします。\n\n細かくてすみませんが、よろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uohc_net/works/94", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 7629, "client_id": 1582697, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/21c3e327/uploads/origins/75316c96-42e1-4d09-9b76-a26311fb1075?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=32e5c43ac0c7dfcda70db273baa2f834", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/21c3e327/uploads/origins/75316c96-42e1-4d09-9b76-a26311fb1075?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e7dbafa00cd90452be193c72567aeca", "src_set": ""}, "body": "こんにちは。私のモデルを使った抱き枕のイラストが欲しいのですが、あなたがいくつか作っているのを見て、私も同じようなものが欲しいと思いました。私のモデルは両手を頭の後ろで組んで寝ていて、彼女は少し恥ずかしそうな表情で前を見ている。背景は、あなたが他の作品でやったように、白いシーツの上に置いてほしい。とてもセクシーなものを希望しますが、ヌードではありません（例えば汗のしずくを置くことは可能ですが、要約して私の服を脱がさないでほしいのです）。ポーズや表情など、異なるカテゴリーを含むすべてのリファレンスはgoogleドライブにあります。\n\nあなたとの仕事を楽しみにしています！\n\nhttps://drive.google.com/drive/folders/1n__7KB-tjCdSX29bcXUP7cvYtT4D5ofX?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@uohc_net/works/93", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 7629, "client_id": 1113717, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fed6a345/uploads/origins/5263d9a1-318d-4987-a3eb-5f47b53c95b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2e364e3a0af977e5fedfc88553bb0d18", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fed6a345/uploads/origins/5263d9a1-318d-4987-a3eb-5f47b53c95b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=426dc117f1eff91a62a4381453a71400", "src_set": ""}, "body": "https://drive.google.com/drive/folders/1YDmTzgAkzDW4sAleGPo9M3SlaoPtt2Fz?usp=sharing\n\nHey there! I would like to have the OC pictured above, in a similar pose and outfit as in the link below. As her hair is not that long you do not need to replicate the hair being over her breast. Only that the breast is still lifted like in the reference. \n\nhttps://freeimage.host/i/JTGVc4j\n\nThank you so much!!", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 81144, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "Shiki🔞", "screen_name": "shiki_sos", "avatar_url": "https://pbs.twimg.com/profile_images/1548598073005584384/5TNmEHEh.jpg", "header_url": "https://pbs.twimg.com/profile_banners/779614057976307712/1658049528/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_a