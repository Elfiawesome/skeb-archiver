がそう大量にいる筈もなく、その本当の正体は、PLがシナリオ前のPC作成で何度もダイスを振り直しては棄てられた「探索者のなりそこないの集合体=棄却されたCS達」が万人に好かれそうな見た目を模ったもの。\n「使って貰いたかった」「愛されたかった」が行動原理であり、\"選び選ばれた存在\"であるPL･PCを怨み、執拗につけ狙う。\n\n\n以上です、長くなり申し訳御座いませんが、何卒よろしくお願い致します。\n\nけの\n\nhttps://www.dropbox.com/s/htj8wnbfzszykaj/%E5%86%99%E7%9C%9F%202021-06-01%2015%2000%2007.png?dl=0", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 55230, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "謙清（けんせい）　Skeb募集中", "screen_name": "kenseiyorimichi", "avatar_url": "https://pbs.twimg.com/profile_images/1464235113798316037/AwOfUmlp.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2482927152/1541786811/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 22, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 32}, {"id": 1619848, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "hotate/お仕事募集中", "screen_name": "112yke_", "avatar_url": "https://pbs.twimg.com/profile_images/1801952181706534912/7N_6VlhA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1103891439178571776/1720070483/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 33}, {"id": 1696594, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "あごひげックス", "screen_name": "AgohigeX", "avatar_url": "https://pbs.twimg.com/profile_images/1876640719437516800/iMAoGWbV.jpg", "header_url": "https://pbs.twimg.com/profile_banners/715917246/1650361057/1500x500", "appeal_receivable": false, "popular_creator_r