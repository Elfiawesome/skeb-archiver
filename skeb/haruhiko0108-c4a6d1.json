年上。身長167cm\n女顔のまつ毛が長い男。美人で可愛い系の部類ですが目つきが悪くて不愛想。若干女々しい。\n割と短気だが真面目すぎるところもあり、大事な後輩のことになると考えすぎたり落ち込むことが多い。\n後輩からの好意に振り回されたり戸惑っていたが、絆されたりいろんな気付きを経てちゃんと後輩のことを好きになった。\n最近は後輩の前でだけ穏やかな顔をします。\n\n長くなりましたが、ご検討よろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/w7mr8jqrxjkyizzudz1ja/AOA7SUGzqhsE2VdP2Ht40Kc?rlkey=gqkdkettlgndtre5108cixhjc&st=3zo0ou6e&dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@fukahirepaitan/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 937538, "client_id": 906559, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/11baee54/uploads/origins/a2faf7dd-0165-4618-af71-194e120722f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df8e5b575922c03a3869d4cfce280fe0", "srcset": "https://si.imgix.net/11baee54/uploads/origins/a2faf7dd-0165-4618-af71-194e120722f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df8e5b575922c03a3869d4cfce280fe0, https://si.imgix.net/11baee54/uploads/origins/a2faf7dd-0165-4618-af71-194e120722f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1366f4147d1c0f57f9dc4b74f655f346 2x, https://si.imgix.net/11baee54/uploads/origins/a2faf7dd-0165-4618-af71-194e120722f9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00d31691814412746b11183ec7d35c9a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/11baee54/uploads/origins/a2faf7dd-0165-4618-af71-194e120722f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e93fde0b694814fb8075c10e90c420fa", "srcset": "https://si.imgix.net/11baee54/uploads/origins/a2faf7dd-0165-4618-af71-194e120722f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e93fde0b694814fb8075c10e90c420fa, https://si.imgix.net/11baee54/uploads/origins/a2faf7