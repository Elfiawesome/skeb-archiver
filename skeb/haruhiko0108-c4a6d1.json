r=200&s=cadfe04b60bb1a6fb3591937a398fdcb 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1857457677120700416%2FEZJuk0Zu.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c4e099fb206378424e50eb82c4b87e67 3x"}, "body": "ね雪P様、先日は素敵な曲をありがとうございました。\nあれから何度も聴き返しています。\nとても嬉しく、またリクエストを送信させていただきました。\n\nクトゥルフ神話TRPGの「ブリュンヒルデにさよならを」で使用した私と相方のOCになります。\n※相方には使用許可をいただいております。\n\n❖画像は資料参照ください\n\n■白い制服に橙目/霧辺煌臣/男\n快活な性格。見目がとても良い。日本とドイツのハーフ。\n橘内に対しても明るく接する。距離が近い。前のめり。\n笑う時は爽やかにパッと笑みを浮かべる。\n\n■紺の制服に橙目/橘内湊詩/男\n一言でいえばツンデレ。負けん気が強いがすぐ絆される。\n霧辺への対抗意識も強い。よく呻いたり吠えたり照れる。\n笑う時は眉を下げてへにゃりと笑う。\n\n■関係性\nお互いにピアノの才能を持つ高校3年生でありライバル。\n幼少の頃よりコンクールの一位を競い合う仲。\nお互いの通う学校は異なり、会うのはほぼピアノコンクールでのみだったが、\n最近は一緒に出掛けたり、お互いの家に泊まるなどの関係性が深まった結果、恋人関係になった。\n\n❖使用用途\n個人使用（アイコン使用、グッズ作成など）、相方との共有\n\n❖雰囲気\n青春、クラシック音楽、夜空、星の光、オレンジ、手を繋いだ時の体温、雨、ピアノ\n\n❖希望\nピアノ、ヴァイオリンなどで、夜に静かに聴きたくなるような曲調だと嬉しいですが、前回の曲がとても素敵だったので基本的には全てお任せします。\n\nご縁がありましたら、どうぞよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/qa3a6aji4kqagxthqosyh/ABpPBll_nYCv4sfOtEr6Z8E?rlkey=x9kw3q6ocy8vm1g3j1wb9qxpn&st=eo6oilgp&dl=0", "nc": 8, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@gebo_1111/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3215751, "client_id": 906559, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0ca99248/uploads/origins/89bdf3b0-cc2b-446d-bb2d-477e76e45e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7752293f935842d7a497b20035ca00e2", "srcset": "https://si.imgix.net/0ca99248/uploads/origins/89bdf3b0-cc2b-446d-bb2d-477e76e45e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7752293f935842d7a497b20035ca00e2, https://si.imgix.net/0ca99248/uploads/origins/89bdf3b0-cc2b-446d-bb2d-477e76e45e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=55b6cc78ce9ae4c9589c61426a54f9f3 2x, https://si.imgix.net/0ca99248/uploads/origins/89bdf3b0-cc2b-446d-bb2d-477e76e45e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=23c8c35515a0869947566945358b30ad 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0ca99248/uploads/origins/89bdf3b0-cc2b-446d-bb2d-477e76e45e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=023a80a0799be39cc9ab89357b1aee3d", "srcset": "https://si.imgix.net/0ca99248/uploads/origins/89bdf3b0-cc2b-446d-bb2d-477e76e45e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=023a80a0799be39cc9ab89357b1aee3d, https://si.imgix.net/0ca99248/uploads/origins/89bdf3b0-cc2b-446d-bb2d-477e76e45e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1620fd8b064025dc546e9dd95fdf710a 2x, https://si.imgix.net/0ca99248/uploads/origins/89bdf3b0-cc2b-446d-bb2d-477e76e45e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7e016a11e9869fa849b32d6d59828d8b 3x"}, "body": "ｹﾞﾎﾞさま\n先日は素敵なイラストをありがとうございました！\nとても嬉しく、再度リクエストさせていただきました。\nTRPG（CoC）で使用したうちよそのOCになります。※相方には使用許可をいただいております。\n\n❖画像は資料参照ください（卓報告画像、立ち絵、ネタバレなしの参考画像・SSがあります）\n❖隻腕のOCになりますので、苦手なようでしたら申し訳ありませんがキャンセルお願いいたします。\n\n■黒髪/黒羽 漣/男/29歳\n物静かで冷静な口調。汐遠を揶揄うのが得意。\n頭の回転が速く、行動に躊躇いがない。\nカフェを経営しており、汐遠に仕事を依頼したことから関係が始まる。\n汐遠に好意を抱いており、助手として働くこともある。\nじわじわ汐遠との関係性の外堀を埋めにきている。\n好きな子を虐めたい加虐心がある。\n相手との会話例：軽口が多め。相手を品定めするような話し方をする\n「頬へのキスは外国じゃ挨拶だよ」\n「こういう話をしたら、同情してくれる？」\n「それ告白？違うのか。そりゃ残念」\n\n■紫髪/朝咲 汐遠/男/26歳\n隻腕の探偵。基本は大人しいが黒羽を相手にすると短気＆我儘になる。\nいろいろあって両腕を失ったが利き手のみ義手をつけて仕事を続けている。\n黒羽のことは適当にあしらってるつもりが割と振り回されている。\n好きか嫌いかでいうと、よくわからないから苦手（嫌いではない）が、言いくるめられ絆されがち。\n最近は傘を武器にしている。\n相手との会話例：黒羽には敬語で話す\n「キスは合意を取ってからしてください！」\n「黒羽さん、それ取ってください」\n「あなたがそれを言うんですか？調子に乗らないでください」\n\n■関係性\n元は依頼人と探偵。今は探偵助手と探偵。\n互いの秘密と過去を知る関係。\n汐遠は文句を言いつつも自分の世話を黒羽に任せている。\n雇用上の契約があるため、基本的には汐遠が首輪をつけた状態だが、イニシアチブは黒羽が握りがち。\nシリアスにもギャグにもなる距離感と様子のおかしい相棒関係。\n\n❖使用用途\nグッズ、デスクトップ使用、相方との共有\n\n❖希望\n路地裏や軒下で雨宿りしている2人。夕方や夜の雰囲気。\n視線が重なってたり、同じものを見ていたり。\n少しだけ世界から隔離されたような空気感があると嬉しいですが、基本的に全てお任せします。\n\nご縁がありましたら、どうぞよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/s81tob41ywe7mxejbmwvx/ANOvS4l-hGnU8qYSDdz41Z0?rlkey=txn2afqmsqwlc6hfqa7q9eoo2&st=oonr2sld&dl=0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gebo_1111/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3215751, "client_id": 906559, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/898a69e3/uploads/origins/8aaaba76-3dae-43e1-93e6-5b4e6092a3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0541f81b348995dc049b7afd1c11098e", "srcset": "https://si.imgix.net/898a69e3/uploads/origins/8aaaba76-3dae-43e1-93e6-5b4e6092a3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0541f81b348995dc049b7afd1c11098e, https://si.imgix.net/898a69e3/uploads/origins/8aaaba76-3dae-43e1-93e6-5b4e6092a3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7a88838fe9effd4b7af2b82a365e663 2x, https://si.imgix.net/898a69e3/uploads/origins/8aaaba76-3dae-43e1-93e6-5b4e6092a3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=675df7878691088687112890ba6714ba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/898a69e3/uploads/origins/8aaaba76-3dae-43e1-93e6-5b4e6092a3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff38e1181c79b66a7d1c7041a25adc7e", "srcset": "https://si.imgix.net/898a69e3/uploads/origins/8aaaba76-3dae-43e1-93e6-5b4e6092a3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff38e1181c79b66a7d1c7041a25adc7e, https://si.imgix.net/898a69e3/uploads/origins/8aaaba76-3dae-43e1-93e6-5b4e6092a3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d67ebf46f2b8efc4651448b731721136 2x, https://si.imgix.net/898a69e3/uploads/origins/8aaaba76-3dae-43e1-93e6-5b4e6092a3cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b22bbd8e1dcdee7bba56f944ecf31a3a 3x"}, "body": "はじめまして。\nｹﾞﾎﾞ様の素敵な絵と鮮やかな色使いに惹かれ、リクエストを送らせていただきました。\n\nクトゥルフ神話TRPG「野狗子と薬師」で使用した私と相方のOCになります。\n※相方には使用許可を得ております。\n\n■赤い羽織の男/ウズ\n身長175cm程\n獣のような男。力も強いし自我も強い。\n寡黙で表情筋が固い。たまに笑う時はにやりと笑う\n野生的で勘が鋭い。力こそパワー派。よく食べる。\n\n■白い羽織の子/レンズ\n身長150cm程/女性\n薬師。薬草を扱うのに長けている。\n知識が豊富。感性と表情豊か。\n思い遣り深い子。思いきりがいい。\n\n■関係性\n文明が滅び退廃した世界を一緒に旅する仲。同じ釜の飯を食う\n自然の中を話しながら歩いたり、焚火を囲んで一緒に星を見たりする\n\n■雰囲気\n和、人と獣、終末世界、自然、草花、炎、生活、旅、呼吸\n\n■リクエスト内容\n川、植物、木々等自然物に囲まれている2人が見たいです。\n木々の合間から光が差し込む中で寝転がっていたり、座っていたり、魚を獲るなど\n自然の中で生活をしている姿を描いていただけないでしょうか。\n\n■用途\n個人使用（デスクトップ背景等）、相方との共有\n\nご縁がありましたら、どうぞよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/89hvql28s3uam9kro6eg1/ACWWa8PSgJqcddgG0152mCQ?rlkey=u55qdm4zni9xgfbq4louj403z&e=1&st=aodi8g61&dl=0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aa_inuyo/works/206", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2090237, "client_id": 906559, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b3b4881a/uploads/origins/dd79cfc6-b99b-4368-a245-1f673193d433?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40bf76e11a8deb7659045e33e1f66d0c", "srcset": "https://si.imgix.net/b3b4881a/uploads/origins/dd79cfc6-b99b-4368-a245-1f673193d433?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40bf76e11a8deb7659045e33e1f66d0c, https://si.imgix.net/b3b4881a/uploads/origins/dd79cfc6-b99b-4368-a245-1f673193d433?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f71e2fde1585a4a8e881ca84b96c21af 2x, https://si.imgix.net/b3b4881a/uploads/origins/dd79cfc6-b99b-4368-a245-1f673193d433?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=029cd1f617329082c61e3dcded5c2364 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3b4881a/uploads/origins/dd79cfc6-b99b-4368-a245-1f673193d433?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08bb9ceec916c966583e31bdfcf96b05", "srcset": "https://si.imgix.net/b3b4881a/uploads/origins/dd79cfc6-b99b-4368-a245-1f673193d433?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08bb9ceec916c966583e31bdfcf96b05, https://si.imgix.net/b3b4881a/uploads/origins/dd79cfc6-b99b-4368-a245-1f673193d433?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=70d93bc4cdfa95e4a1ea2441fd455084 2x, https://si.imgix.net/b3b4881a/uploads/origins/dd79cfc6-b99b-4368-a245-1f673193d433?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a97ad32882751b543f493916a132b300 3x"}, "body": "愛❗️🫶さま\nはじめまして。\n色使いがとても素敵なイラストをお見掛けしまして、リクエスト失礼いたします。\nTRPGで使用したOCになります。※相方には使用許可をいただいております。\n\n❖画像は資料参照ください\n\n■紫髪/紫眼の男：面手 文晃\n身長179cm/攻\nモデル・俳優業をこなす成人男性。\n顔、スタイルが良く、演技も評価は高いため人気もある現役の役者。\n西那以外の人間に興味がなく、思ったことをはっきり言う竹を割ったような性格。\n\n■黒髪/金眼の男：面手 西那\n身長169cm/受\nカフェのアルバイトをしている文晃の恋人。\nいろいろあって一度死んだが、いろいろあって生き返り文晃と付き合う関係になった。\nいろんなものに対して適当な緩い性格だが、文晃のことを一番に考えている。\n\n■関係性\n高校時代の同級生。当時の関係性は浅かったが、20歳を過ぎてから紆余曲折あり付き合う仲になった。\nおよそ毎回西那が煽るが、文晃の大きい愛に包まれいつも負ける。\n割とお互い以外どうでもいいと思っている。\n\n❖使用用途\n個人使用（デスクトップ背景に使用、グッズ作成など）、相方との共有\n\n❖希望\n月夜に、手を繋いで寄り添って歩いている二人が見たいです。\n月光で輪郭が照らされる中で、お互いに目を細めて見つめ合っている姿をお願いしたいです。\n\nご縁がありましたら、どうぞよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/3j1beqjvlayknlau0ji24/AGmwIfpJ_qTyqBLUmsDyUsQ?rlkey=de2oqyl2cxkyveb3sijm69brx&st=j6573j9j&dl=0", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@vat0uq/works/615", "private_thumbnail_image_urls": null, "private": false,