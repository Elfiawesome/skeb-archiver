net/81a78dbd/uploads/origins/1338a900-7813-4c07-b67d-42e854e8dcc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4eab552f9c0590e4e67d39c4958eed78 2x, https://si.imgix.net/81a78dbd/uploads/origins/1338a900-7813-4c07-b67d-42e854e8dcc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a64a15ba1dc3aad58882fef62664809 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 65720, "nc": 49}, {"path": "/@kuraimu21/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 65720, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4ae516f6/uploads/origins/9d08d98c-0337-4cb8-8ffc-896f57a3d05f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7b5bdeec49ac42188347d5b0c2d88d1", "srcset": "https://si.imgix.net/4ae516f6/uploads/origins/9d08d98c-0337-4cb8-8ffc-896f57a3d05f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7b5bdeec49ac42188347d5b0c2d88d1, https://si.imgix.net/4ae516f6/uploads/origins/9d08d98c-0337-4cb8-8ffc-896f57a3d05f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=39841bb87b3fe96a82388d8044d0fe47 2x, https://si.imgix.net/4ae516f6/uploads/origins/9d08d98c-0337-4cb8-8ffc-896f57a3d05f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c528bd898d1f204f6b9e7299675002db 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4ae516f6/uploads/origins/9d08d98c-0337-4cb8-8ffc-896f57a3d05f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af0ac2c4b0c3b4768aba257e7fd93ba6", "srcset": "https://si.imgix.net/4ae516f6/uploads/origins/9d08d98c-0337-4cb8-8ffc-896f57a3d05f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af0ac2c4b0c3b4768aba257e7fd93ba6, https://si.imgix.net/4ae516f6/uploads/origins/9d08d98c-0337-4cb8-8ffc-896f57a3d05f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9398ebf710e3c2b3c6085efa1ec62b26 2x, https://si.imgix.net/4ae516f6/uploads/origins/9d08d98c-0337-4cb8-8ffc-896f57a3d05f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a5c235041ca06d79fd5abcba885ebdff 3x"}, "body": "こんにちは。\nいつも素晴らしい作品をありがとうございます。\n可能であれば3.4ページほどのカラーのセリフ付きイラストか漫画をお願いしたいです。\n内容としてはいつもの作品に近いような操りもので、\n気の強そうな高飛車で大人なお姉さんタイプのキャラが変な操り装置を手に入れたキモオタに好き勝手操られるといった内容になります。\nキャラクターのデザインはお任せしますが、お姉さんは背が高くスタイルがよく、おっぱいは大きめにして頂きたいです。\n\n具体的な構成としては、\n①他人の身体を好きなように操る事の出来る装置を手に入れたキモオタ。\n②街でたまたまお姉さんを見つける。\n③こいつに決めた的な感じでキモオタはお姉さんに操り装置を発動する。\n④キモオタの命令で操られたお姉さんは着ていた衣服を一枚一枚少しずつ脱ぎ始める。\n⑤全裸になったお姉さんはキモオタの指示で恥ずかしいポーズをさせられる。\n⑥最後にキモオタが用意していた無様な衣装にお姉さんが着替えさせられて終了。\n\nといった流れになります。\n\n⑤の恥ずかしいポーズは高速ハイグレやおっぱい揺らし、不思議な美術館で作品をバカにしてしまった女の子のようなマッスルポーズなど、\nとにかく面白おかしいようなポーズをキモオタの命令で強制的にさせられているような感じでお願いします。\n⑥の無様な衣装としては自分のパンツを顔に被り、変態仮面のような衣装を着させられたお姉さんは、\n「変態女ただいま参上！」といったセリフと決めポーズを取って終了といったシーンでお願いします。\n(具体的な衣装はお任せします。無様な衣装であればなんでもOKです。)\nお姉さんの表情としては操られ恥ずかしがっていたり悔しがっている感じで、嫌がっている心の声なども入れて頂きたいです。\nセリフ等その他のものはお任せします。\n\n以上の内容でよろしければお願いいたします。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@KuwagataZaurus/works/135", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2723821, "client_id": 65720, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c345f2e8/uploads/origins/ab6e3901-5af9-4500-a91f-98cc4af31b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfd60d9c2cbf194095b42aa58c35ab4e", "srcset": "https://si.imgix.net/c345f2e8/uploads/origins/ab6e3901-5af9-4500-a91f-98cc4af31b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfd60d9c2cbf194095b42aa58c35ab4e, https://si.imgix.net/c345f2e8/uploads/origins/ab6e3901-5af9-4500-a91f-98cc4af31b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95cf87dfcf7ae40dfe0e97d1b1354368 2x, https://si.imgix.net/c345f2e8/uploads/origins/ab6e3901-5af9-4500-a91f-98cc4af31b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=326348af64bd2e9faff65a9d04a53942 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c345f2e8/uploads/origins/ab6e3901-5af9-4500-a91f-98cc4af31b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11762fda0351a0f5ac265d2297b35bdc", "srcset": "https://si.imgix.net/c345f2e8/uploads/origins/ab6e3901-5af9-4500-a91f-98cc4af31b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11762fda0351a0f5ac265d2297b35bdc, https://si.imgix.net/c345f2e8/uploads/origins/ab6e3901-5af9-4500-a91f-98cc4af31b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7d602e6d7c02023f3c3d4a25c4f56807 2x, https://si.imgix.net/c345f2e8/uploads/origins/ab6e3901-5af9-4500-a91f-98cc4af31b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1e62282350972f39be111e507f531b93 3x"}, "body": "こんにちは！いつもクワガタザウルスさんの作品を楽しく見させていただいております。 \nずっと迷っていたのですが、今回初めてリクエストを送信させて頂きました！\n\nhttps://x.com/KuwagataZaurus/status/1789494845004005533?t=0hGrPlkgCvdZO-xfv0bFlQ&s=19\n\n以前こちらで描かれておりましたアンテナ操りシチュが大変性癖に刺さりましたので送らせていただきます！\n\n\n☆リクエスト内容\nヒロインのママさんが、操作電波怪人シャルナクマさんにより、またしてもアンテナを頭に取り付けられてしまいます。\n\nそして、シャルナクマさんは前回敗北した時よりパワーアップしており、アンテナを取り付けた相手に自分と同じ動き、セリフを強制する力を手に入れています。\n\n・シャルナクマさんがまず動作テストと称して変なポーズ(ドラゴンボールのグレートサイヤマンの頭に手をのせるポーズ)をし、「動作テスト開始っ！」と叫ぶと、ヒロインのママさんも同じポーズをとりながら、同じセリフを言わされます。\n\n・次にシャルナクマさんががに股でコマネチのポーズをとりながら「コマネチッ！」と叫び、ヒロインのママさんも恥ずかしがりながらがに股でポーズをとり、同じセリフを言わされます。\n\n・最後にはっぱ隊の踊りを2人で踊りながら「YATTA!これで世界中の人間を支配してやるぞ〜！」と2人で叫ぶ。\n\n※もし余裕があればヒロインのミライちゃんが操られてコマネチのポーズをとらされている所も見てみたいです…！\n\n\n\n中々ニッチすぎるシチュエーションを送ってしまい、大変申し訳ございません…！\n\n かなりの特殊性癖なのでもし無理な場合は遠慮なく即キャンセルしていただいても構いません！\nよろしくお願い致します！", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 18457, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "えもんず（4代目）", "screen_name": "emons03", "avatar_url": "https://pbs.twimg.com/profile_images/1455446663284523008/Fm6GWG1H.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 161}, {"id": 24563, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ココネリ@新作出ました", "screen_name": "cacaodecocoa", "avatar_url": "https://pbs.twimg.com/profile_images/1767820058523500544/CpK9FwMc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2360766884/1725729160/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 177}, {"id": 1093591, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "さめめ", "screen_name": "sameme_gigli", "avatar_url": "https://pbs.twimg.com/profile_images/880239637112868865/qsWBVIMz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/880238009689399296/1514108752/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"gen