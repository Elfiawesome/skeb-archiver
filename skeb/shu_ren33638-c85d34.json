2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ed6f30188bb0a7356ddae5555b9d06a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b15b29c/uploads/origins/daf03a0a-50b4-4072-a556-e7ecbc036983?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=958972aeb97927ace388df2d03ccd09b", "srcset": "https://si.imgix.net/8b15b29c/uploads/origins/daf03a0a-50b4-4072-a556-e7ecbc036983?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=958972aeb97927ace388df2d03ccd09b, https://si.imgix.net/8b15b29c/uploads/origins/daf03a0a-50b4-4072-a556-e7ecbc036983?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2e1fffa5aec771d47b0bbf78903cc0a8 2x, https://si.imgix.net/8b15b29c/uploads/origins/daf03a0a-50b4-4072-a556-e7ecbc036983?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8efacf493d727a1b9e2d78d2ca5e5bab 3x"}, "body": "お初にお目にかかります。\nどんメス様の作品を拝見し、少女の肉体や性器の描写に惹かれた者です。\nもし宜しければ、オリキャラにて作品をお願いしたく、リクエストさせて頂きます。\n\n【概要】\n・オリキャラが自身の性器を広げて「くぱぁ」をしている作品をお願い致します。\n・具体的なポーズや衣装の状態については、どんメス様にお任せ致します。\n・オリキャラは「無表情で平然としている」様子で描いて頂きたく思います。本人が興奮しているような描写はNGとさせてください。\n・一応のシチュエーションとしては、性的なことに詳しくないオリキャラに付け込み、卑猥なポーズを取らせている……といった方向性を想像しています。\n・その他、不明点等は全てお任せ致します。\n\n【オリキャラ】\n『外見など』\n・名前は「シロ」。「兎っぽい」「無感情」な印象の小柄な少女。\n・銀髪のロングヘア／赤い眼／白い肌が特徴的。喉に切り裂かれたような古傷あり。\n・頭の耳のようなものはヘッドドレスの一部。実際の耳は普通の人間と同じ。\n・その他、容姿に関しては参考URLのイラストをご参照ください。\n『その他設定』\n・非合法研究組織によって生み出された強化人間。巨大な戦斧を軽々と振り回して戦う。\n・組織から逃げ出す際に喉を切り裂かれる大怪我を負っており、その後遺症で喋ることができない。\n・とてもぼんやりとした性格で、のんびりすることが好き。\n・性的には不感症。\n\n【参考URL】\nhttps://skeb.jp/@kajaneko/works/110\nhttps://drive.google.com/drive/folders/1Lr6Y-TZwg-fen6stGzIIpw39qVr0FHtp?usp=sharing\n\n【用途】\n・個人観賞\n・依頼時の参考画像\n・非営利用途での二次配布（知人への共有）\n\n以上となります。\nご一考の程、宜しくお願い致します。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shu_ren33638/works/2", "priva