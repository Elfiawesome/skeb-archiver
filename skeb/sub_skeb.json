ue, "creator_id": 3685760, "client_id": 3211553, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/569962ea/uploads/origins/4565e161-c6aa-4604-b0b3-3c683566e460?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35cd9bb485c0292f432ac3d4410b6c8b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/569962ea/uploads/origins/4565e161-c6aa-4604-b0b3-3c683566e460?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0212f4ddaac0e0afbc2bcad8222c715a", "src_set": ""}, "body": "筆遅さん、こんにちは。\n筆遅さんの絵柄とSDキャラが大好きで、オリジナルキャラのSDキャラ制作を依頼したいです。  \nキャラクター設定はこちらからご確認ください：  \nhttps://drive.google.com/drive/folders/1vM6lyWywGW2omCPlx0n9EYMxXlzYk__k  \n\n衣装はリンク内から自由に選択していただき、様々な表情（照れ/泣き/得意など）を描いていただけると大変嬉しいです❣️\n\nまた、こちらの作品の淡い線画と濃い外枠の表現が特に素晴らしかったので、同様のタッチで描いていただけると幸いです：  \nhttps://x.com/sub_skeb/status/1949444607743578323?s=46  \n\nご検討よろしくお願いします💖", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sub_skeb/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d0783858/uploads/origins/a226ce08-af9e-4296-8c79-b17d49387e92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59305876bbacc45392c1f8d779adc64c", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3685760, "client_id": 555744, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sub_skeb/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3685760, "client_id": 3462470, "vtt_url": null, "thumbnail_image_urls": {"src": "https: