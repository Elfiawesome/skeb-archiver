、元気っ子、赤髪、八重歯、アホ毛のサイドテールが特徴です。\nお得意なようにアレンジしていただいて問題ありません、服装は1，2枚目どちらでも大丈夫です！気持ち指輪を意識していただけるとありがたいですが、おまかせします！\n\n要望ばかりではございますが、ご検討よろしくお願いいたします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nyon_maru0/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3845063, "client_id": 3883945, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8057209c/uploads/origins/574704c3-a54c-476a-8b58-16b9ab9b6b85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed21e467e67e08e571be70d28ace9341", "srcset": "https://si.imgix.net/8057209c/uploads/origins/574704c3-a54c-476a-8b58-16b9ab9b6b85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed21e467e67e08e571be70d28ace9341, https://si.imgix.net/8057209c/uploads/origins/574704c3-a54c-476a-8b58-16b9ab9b6b85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0878df2b9175b890c9da7720a12f398 2x, https://si.imgix.net/8057209c/uploads/origins/574704c3-a54c-476a-8b58-16b9ab9b6b85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba3a1bf17e69e9b4e2f213290ddc35a1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8057209c/uploads/origins/574704c3-a54c-476a-8b58-16b9ab9b6b85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43e61fe73752851af600dd648b88fe8a", "srcset": "https://si.imgix.net/8057209c/uploads/origins/574704c3-a54c-476a-8b58-16b9ab9b6b85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=43e61fe73752851af600dd648b88fe8a, https://si.imgix.net/8057209c/uploads/origins/574704c3-a54c-476a-8b58-16b9ab9b6b85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aca9cfe70a2394c2c3e06a34a7e2facc 2x, https://si.imgix.net/8057209c/uploads/origins/574704c3-a54c-476a-8b58-16b9ab9b6b85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fb905e43a5e5cfed4a2dd26478ded8c8 3x"}, "body": "にょん様\nはじめまして、VTuber準備中の月守ねむりと申します。\n\nSkebで先生の新しいイラストを拝見し、透明感のある表現に惹かれたため、ぜひ先生にイラストをお願いしたく、ご連絡いたしました。\n\n構図はキャラクターをメインに、三面図にある扇子またはキセルを手に持っているようなイメージです。\nどちらを使用するかは、先生のお好みや作風に合わせて表現していただけましたら嬉しいです。\n\n耳や髪は画面の端で切れないよう、余裕を持った構図でお願いいたします。\n\nキャラクターには赤いアイメイクと泣きぼくろがあり、ネイルもしています。\n\n・参考資料\nhttps://drive.google.com/drive/folders/1w4dcbDF0QEruc3vvJt74NxEHdb-xl47N?usp=drive_link\n\n・納品形式\n宛名を別レイヤーにした、人物と背景が分かれたPSDデータや、人物のみの透過PNGもいただけたら幸いです。\n\n・使用用途\n各SNSのアイコン・ヘッダー、待機画面や配信画面など、VTuber活動で使用予定です。\n\n何卒ご検討のほどよろしくお願いいたします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nyon_maru0/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3845063, "client_id": 3720695, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e45e68ac/uploads/origins/912ed8fb-96f2-45fe-b564-e0d127c1f0f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ac54ca651fcd71cf1e7d680d6dd7087", "srcset": "https://si.imgix.net/e45e68ac/uploads/origins/912ed8fb-96f2-45fe-b564-e0d127c1f0f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ac54ca651fcd71cf1e7d680d6dd7087, https://si.imgix.net/e45e68ac/uploads/origins/912ed8fb-96f2-45fe-b564-e0d127c1f0f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb60b4b95c15e1da4e19727ea4e9b9cf 2x, https://si.imgix.net/e45e68ac/uploads/origins/912ed8fb-96f2-45fe-b564-e0d127c1f0f8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e5b36bc40646927e2f099124e879864 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e45e68ac/uploads/origins/912ed8fb-96f2-45fe-b564-e0d127c1f0f8?bg=%23fff&auto=format%2Ccompre