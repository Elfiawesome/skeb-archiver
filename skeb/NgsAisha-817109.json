る行為。\n\nまた、上記の目的のために、背景透過差分を頂けると幸いです。\n\n以上、長文となり恐縮ではございますが、ご検討いただけると幸いです。\n\nhttps://twitter.com/kurotuki_sakune/status/1334218359651536896?s=21&t=CDRSHPB7wkNRTMl83UPZzA", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@NgsAisha/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1651090, "client_id": 68243, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/677143a2/uploads/origins/fff65142-33b1-47c1-bcbf-eecb7990e3a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0005a2929262af39c95428361f9540e", "srcset": "https://si.imgix.net/677143a2/uploads/origins/fff65142-33b1-47c1-bcbf-eecb7990e3a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f0005a2929262af39c95428361f9540e, https://si.imgix.net/677143a2/uploads/origins/fff65142-33b1-47c1-bcbf-eecb7990e3a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d0b5f725af3360f1925280b068f6dedd 2x, https://si.imgix.net/677143a2/uploads/origins/fff65142-33b1-47c1-bcbf-eecb7990e3a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0a8d7213953bd0fae83e0e25d88382e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/677143a2/uploads/origins/fff65142-33b1-47c1-bcbf-eecb7990e3a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73b8b48248ae8844af0b496ce094e84a", "srcset": "https://si.imgix.net/677143a2/uploads/origins/fff65142-33b1-47c1-bcbf-eecb7990e3a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=73b8b48248ae8844af0b496ce094e84a, https://si.imgix.net/677143a2/uploads/origins/fff65142-33b1-47c1-bcbf-eecb7990e3a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2d83c4e13b72ac1419b632988937a548 2x, https://si.imgix.net