c45-4c52-9d82-5cfb3097ed2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56c0b6fefbf0a07e59a9a503780e2878", "srcset": "https://si.imgix.net/bab6de9d/uploads/origins/660388fb-8c45-4c52-9d82-5cfb3097ed2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56c0b6fefbf0a07e59a9a503780e2878, https://si.imgix.net/bab6de9d/uploads/origins/660388fb-8c45-4c52-9d82-5cfb3097ed2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f889890f53b64dd37341dc943ea70d78 2x, https://si.imgix.net/bab6de9d/uploads/origins/660388fb-8c45-4c52-9d82-5cfb3097ed2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7a486f89a54a02d2b92d91ee5b19f105 3x"}, "body": "お世話になります\n前回リクした牛コスさんと息子の続きです\n\n●構図\n男が後背位で髪を引っ張りながら元・牛コスさんをレイプ\n前半と後半で差分を分けて下さい\n断面図で胎児描写もお願いします\n\n●シチュ\n・前半\n相変わらずボテ腹風俗で働いている元・牛コスさん\nある日迎えた客は成長した息子だった\n彼は母の腹の子を犯し潰してチンポで堕胎し復讐を遂げる…\n\n・後半\n復讐に成功した息子は母を自分だけの物にして孕ませ続ける…\n\n●息子\n詳細不要\nゴリゴリの大人チンポ\n\n・前半\n「さっさとケツを向けろ…」\n「そうさ！俺だよ！アイツも俺がやってやった！」\n「だからその腹ン中のガキもやってやる！」\n「俺の子種で溺れろっ！俺のチンポで潰れろっ！」\n「チンポにガキが絡み付いて気持ちいいぜ！」\n「あの時は種付けを褒めてくれたじゃないか…マ・マ❤️」\n\n・後半\n「やっと僕の子でお腹いっぱいになってくれたね❤️」\n「ママのなか、とってもゆるゆるで優しいよ❤️」\n「最高の産みたがりマンコだね❤️」\n「自慢のママだよ❤️ママの子に産まれて良かった❤️」\n「ママは僕の物だっ❤️」\n「ママの卵子は僕が全部孕ませるからね❤️」\n「閉経するまでずーっと僕の子産み続けてね❤️」\n「ずーっと僕の子をお腹に孕んでてね❤️」\n「ママ❤️ママ❤️死ぬまで愛してるよママ❤️」\n\n●元・牛コスさん\n・共通\n年齢を重ねて更にだらしない体つきに、胸も垂れ気味\n髪は伸びて金髪に染め、肌も日サロで褐色\nお腹はパンパンに膨らんだボテ腹\n妊娠堕胎マークは更に増加\n\n・前半\n豹柄のギャル系衣装と濃いアイシャドウとケバい化粧\n「うわキツ」なボテ腹BBAギャル路線で何とか売っている\n\n「いらっしゃ〜い❤️ご指名ありがと❤️」\n「え？まさか…」\n「ひいっ！許して！やめて！乱暴にしないで！」\n「あの人の最後の赤ちゃんなの！」\n「アナタのきょうだいでもあるのよ！？」\n「いや…いやああああっ！！」\n\n参照の様に怯え顔\n「ブチッ」「グシャッ」など明らかに無事では済まなさそうな音\n\n・後半\n精神崩壊\n化粧は落として素顔、レイプ目\nお腹には真新しい堕胎マークが2つ増えている\n既存の物より大きく、目立つ位置に\n\n「あう…あう…」\n「ぼうや…ぼうや…」\n\nhttps://skeb.jp/@MIMATO68290010/works/5", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MIMATO68290010/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1397042, "client_id": 335424, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e0ce5492/uploads/origins/4217725b-7d68-4e6b-b311-b6092a940739?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e3daab6a23c4fd5ae644ef8564308ff", "srcset": "https://si.imgix.net/e0ce5492/uploads/origins/4217725b-7d68-4e6b-b311-b6092a940739?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e3daab6a23c4fd5ae644ef8564308ff, https://si.imgix.net/e0ce5492/uploads/origins/4217725b-7d68-4e6b-b311-b6092a940739?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d61412c812e444421909f175f18ae4d 2x, https://si.imgix.net/e0ce5492/uploads/origins/4217725b-7d68-4e6b-b311-b6092a940739?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ef3b31d7291a2141fc21684cae7e47e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e0ce5492/uploads/origins/4217725b-7d68-4e6b-b311-b6092a940739?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f12016e6ef7bc5b4397852afe8abe3b8", "srcset": "https://si.imgix.net/e0ce5492/uploads/origins/4217725b-7d68-4e6b-b311-b6092a940739?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f12016e6ef7bc5b4397852afe8abe3b8, https://si.imgix.net/e0ce5492/uploads/origins/4217725b-7d68-4e6b-b311-b6092a940739?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1162c41c344fb82f0297d68cdd52eb8e 2x, https://si.imgix.net/e0ce5492/uploads/origins/4217725b-7d68-4e6b-b311-b6092a940739?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0b297f88a1719d1b734db232810b50e8 3x"}, "body": "お世話になります\n情緒様の「母乳牛コスボテ」がとても素敵だったので、このイラストを元にした妄想シチュエーションを形にしたく、リクエストさせて頂きます！\n\n●構図\n牛コスさんが騎乗位でショタを逆レイプ\n無理やり精通・射精させている\n\n妊娠していない状態とボテ腹で差分を分けて下さい\n\n●シチュ\nショタは牛コスさんの実の息子です\n悪い彼氏(息子の実父)に「あのガキの種で妊娠できたらまた抱いてやるよw」と唆され、言われるままに息子をレイプして妊娠する…という妄想シチュエーションです\n\n●牛コスさん\n基本的に元イラストと同様に\nさらに肉付きを良くムチムチとだらしない体つきにして下さい\n普段は悪い彼氏の為にボテ腹風俗で働いています\nまた、悪い彼氏の命令通りに何度も出産と堕胎を繰り返しており、お腹には出産・堕胎それぞれのマークがいくつも刻まれています\n\n・前半\n乳首はピンク色で\nお腹はまだ膨らんでいません\n出来れば膣内の断面図と受精カットインもお願いします\n\n「ごめんね、ぼうや❤️」\n「あの人の…ぼうやのパパの命令なの❤️」\n「ぼうやのはじめてで孕むっ❤️」\n「ママのお腹におかえりなさい❤️」\n「うふふ❤️ママはここにいるわよ❤️」\n「さあ、もっと出して❤️」\n\n・後半\n乳首は黒く、母乳も噴き出しています\n大きく膨らんでパンパンのボテ腹でお願いします\n出来れば断面図で胎児の描写もお願いします\n\n「種付けしてくれてありがとっ❤️ぼうやっ❤️」\n「これであの人に抱いて貰えるっ❤️」\n「ママ嬉しいわっ❤️」\n「アナタを産んでよかったぁ❤️」\n「自慢の息子よぉ❤️」\n\n●ショタ\n詳細な容姿描写は不要、影と台詞だけでも構いません\n描写頂ける場合は、かなり小柄に、牛コスさんとの体格差を強調して下さい\n性器は可愛らしい短小サイズで剥けてない子供チンポです\n\n・前半\n突然の母の凶行に怯えています\n\n「ひっ　はなしてっ」\n「なにこれっ　おちんちんがへんだよお」\n「なんかくるっ❤️おしっこでちゃうっ❤️」\n「ママっ❤️だずげでっ❤️ママーっ❤️」\n\n・後半\n繰り返される種付け強制逆レイプで完全に精神崩壊しています\nひたすら射精するだけの毎日です\n\n「あー……うー……」\n「まま……まま……」\n\nhttps://www.pixiv.net/artworks/91879279", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MIMATO68290010/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1397042, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dba4b53c/uploads/origins/ad047324-8170-4f72-99b2-11a8563c8a3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5fbb4f70d8cca062a2295218e131a6a", "srcset": "https://si.imgix.net/dba4b53c/uploads/origins/ad047324-8170-4f72-99b2-11a8563c8a3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5fbb4f70d8cca062a2295218e131a6a, https://si.imgix.net/dba4b53c/uploads/origins/ad047324-8170-4f72-99b2-11a8563c8a3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=680db14fb6ab5819d090e70daa3035ea 2x, https://si.imgix.net/dba4b53c/uploads/origins/ad047324-8170-4f72-99b2-11a8563c8a3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=438889039eba2044490c745523909b7a 