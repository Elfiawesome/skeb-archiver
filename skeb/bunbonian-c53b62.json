-7f8a037da796?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a29e41876dc5fa1363e39a443bfc0600", "srcset": "https://si.imgix.net/7b7202c3/uploads/origins/23483e41-e737-4e21-9243-7f8a037da796?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a29e41876dc5fa1363e39a443bfc0600, https://si.imgix.net/7b7202c3/uploads/origins/23483e41-e737-4e21-9243-7f8a037da796?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=284408b34aa0a95f04030062856f5330 2x, https://si.imgix.net/7b7202c3/uploads/origins/23483e41-e737-4e21-9243-7f8a037da796?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f7b470e9d6f079c0fa4013d51755b4f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b7202c3/uploads/origins/23483e41-e737-4e21-9243-7f8a037da796?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15665edb75e1c9ccf995aef940aa8d67", "srcset": "https://si.imgix.net/7b7202c3/uploads/origins/23483e41-e737-4e21-9243-7f8a037da796?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15665edb75e1c9ccf995aef940aa8d67, https://si.imgix.net/7b7202c3/uploads/origins/23483e41-e737-4e21-9243-7f8a037da796?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f1332eabcd9cd2d0ac04b55e74dbded5 2x, https://si.imgix.net/7b7202c3/uploads/origins/23483e41-e737-4e21-9243-7f8a037da796?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a53058ac74165110ed95b6e4aa1f22f4 3x"}, "body": "咲-saki-の新子憧ちゃんとToLoveるの校長のラブラブセックスをお願いします\n\n体位はだいしゅきホールド、参考URLのような構図で校長と憧ちゃんが全身を密着させるように抱きあってセックスしている様子を、子宮口にぴったり密着させたペニスから子宮内に直接大量射精している断面図付きでお願いします\n\n服装は憧ちゃん、校長ともに全裸です\n\n「醜い竿役がかわいい女の子とギュッと抱き合い、おまんこだけでなく肌の感触を全身で堪能しながらセックス」というのが大事なポイントなので、\n憧ちゃんと校長はお互いに全身を隙間なくぴったりと密着させるように抱き合わせ、憧ちゃんの性器だけでなく裸体全てを校長が全身で味わいながらセックスしてる感じを出して貰えると嬉しいです\n憧ちゃんのえっちな身体を隠してしまうのは勿体ないかもしれませんが、ブクブクのメタボボディで容赦なく覆い隠して、醜く肥え太った校長とギュッ♡と抱きあってる密着感を際立たせて欲しいです\n\n\n可能であれば、以下のような差分&カットを追加で頂けるととても嬉しいです\n１．憧ちゃんと全身密着せっくす♡→子宮内にたっぷり射精→そのまま抜かずに何発も射精\nといったイメージの、憧ちゃんと抱き合ったまま膣内で何度も射精してる様子の差分\n膣内射精が大好きなので、膣内放尿は無しで、その分憧ちゃんの膣内で気持ちよ～く何発も射精し、注がれた大量の精子が結合部から溢れてベッドに精液の池を作っている様子を描いて欲しいです\n\n２．https://skeb.jp/@kariumeeee/works/73\nの左上のような、二人がキスしているカット\nキスは唇同士を重ねた濃厚なもので、二人の口の周りを唾液でベトベトにして何回もキスしてるのが窺えるようにして貰えると大変ありがたいです\n\nhttps://skeb.jp/@hikoukeiro/works/159", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bunbonian/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ec813686/uploads/origins/17c45a80-a991-45c2-b4a6-1bdd112c5e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=36f720dbb32a3b8650821ae357015a7d", "srcset": "https://si.imgix.net/ec813686/uploads/origins/17c45a80-a991-45c2-b4a6-1bdd112c5e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=36f720dbb32a3b8650821ae357015a7d, https://si.imgix.net/ec813686/uploads/origins/17c45a80-a991-45c2-b4a6-1bdd112c5e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=378ff7d8d69baa3925968ac767313b7f 2x, https://si.imgix.net/ec813686/uploads/origins/17c45a80-a991-45c2-b4a6-1bdd112c5e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=de324b927f38f95fead37b281dbd1f5a 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 39519, "client_id": 846559, "nc": 163}, {"path": "/@bunbonian/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 39519, "client_id": 989786, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a77d0e50/uploads/origins/abcd264b-e7f3-4f7c-9ea7-ec64a617c660?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80ea5495f93a4243b3d962fee498167b", "srcset": "https://si.imgix.net/a77d0e50/uploads/origins/abcd264b-e7f3-4f7c-9ea7-ec64a617c660?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=80ea5495f93a4243b3d962fee498167b, https://si.imgix.net/a77d0e50/uploads/origins/abcd264b-e7f3-4f7c-9ea7-ec64a617c660?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7befd7b2820e63dcff5348d241276d81 2x, https://si.imgix.net/a77d0e50/uploads/origins/abcd264b-e7f3-4f7c-9ea7-ec64a617c660?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=99e8c733654a7f61e7d6ea7bd3a23e88 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a77d0e50/uploads/origins/abcd264b-e7f3-4f7c-9ea7-ec64a617c660?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d52efc7b336fdf4cbf82c3a03ba214c6", "srcset": "https://si.imgix.net/a77d0e50/uploads/origins/abcd264b-e7f3-4f7c-9ea7-ec64a617c660?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d52efc7b336fdf4cbf82c3a03ba214c6, https://si.imgix.net/a77d0e50/uploads/origins/abcd264b-e7f3-4f7c-9ea7-ec64a617c660?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b61545d5e8018d8b27f39e3ec6854d11 2x, https://si.imgix.net/a77d0e50/uploads/origins/abcd264b-e7f3-4f7c-9ea7-ec64a617c660?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d420083419bbb618410513cb073dd8f 3x"}, "body": "お世話になります、こちらでは初めましてになります。\nPixivでいただいたライザのぷにオナで、ボテる快感にハマったライザがクラウディアを巻き込むイラストをリクエストさせていただきます。\n二人とも　https://twiman.net/user/344826552/illust/1182877796919459843　の水着で、松葉崩し・貝合わせをしている状態でお願いできますでしょうか。\nhttps://xn--r8jwklh769h2mc880dk1o431a.com/wp-content/uploads/2020/03/22/d014.jpgのような構図で、奥がライザ、手前がクラウディア。二人をぷにが取り囲んでいる状態にしていただきたいです。\nライザは片手で自分のおっぱいを揉みしだき、反対の手でクラウディアの太ももを掴んで自分の方に引き寄せ、まんを押し付けている状態にしていただけますでしょうか。クラウディアはライザの片足にしがみついている状態にしていただきたいです。\n二人とも股間の布はずらして貝合わせ、ブラははだけてぷににもみくちゃにされている状態にしていただきたいです。\n\nまた差分をお願いしたいのですが、\n１．ぷにボテのライザ(臨月腹)がクラウディアを引き寄せる。クラウディアは感じながらも不安そうな表情。\n２．ぷにが二人の間を移動し始める。ライザはトロ顔で少しお腹が小さくなり、クラウディアは口を開けて喘ぎながら、少しボテる。\n３．ライザの中にいたぷにがすべてクラウディアの子宮内へ。ライザのお腹は平らになり、よだれを垂らしながら愛しそうにクラウディアを見つめる。クラウディアは苦しそうにしながらもトロ顔。水着のお腹部分が少し裂ける。\n４．周りにいたぷにが再度ライザの中へ入り、二人とも臨月ボテ腹でアクメ。クラウディアのお腹はパンパンで水着がボテ腹に食い込む。二人のブレンドおしっこが股間からあふれる。\n\n細かく申し訳ありませんが、ご検討お願いいたします。", "nc": 51, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bunbonian/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 39519, "client_id": 57207, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09fbec11/uploads/origins/656b2c65-02ed-4319-a89f-c4263ab80cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10f5dd400d8a7a209efa2dc1ece93b66", "srcset": "https://si.imgix.net/09fbec11/uploads/origins/656b2c65-02ed-4319-a89f-c4263ab80cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=10f5dd400d8a7a209efa2dc1ece93b66, https://si.imgix.net/09fbec11/uploads/origins/656b2c65-02ed-4319-a89f-c4263ab80cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=33dcde0576bcbe148fa90368ad2dab05 2x, https://si.imgix.net/09fbec11/uploads/origins/656b2c65-02ed-4319-a89f-c4263ab80cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2aa68961899dfb87179d6fcaa579e87f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/09fbec11/uploads/origins/656b2c65-02ed-4319-a89f-c4263ab80cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=595064df78d6be80e115a14c504ca9b4", "srcset": "https://si.imgix.net/09fbec11/uploads/origins/656b2c65-02ed-4319-a89f-c4263ab80cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=595064df78d6be80e115a14c504ca9b4, https://si.imgix.net/09fbec11/uploads/origins/656b2c65-02ed-4319-a89f-c4263ab80cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b585f147a7a20da94ea844a2b32b01f7 2x, https://si.imgix.net/09fbec11/uploads/origins/656b2c65-02ed-4319-a89f-c4263ab80cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fe5be4bb0843368e6bfef16738d1ef17 3x"}, "body": "リクエストを送らせていただきます、先生のご都合等よろしければお願い致します。\nアズールレーンのヘレナ(原作で立ち絵がいくつかあるキャラですが、雰囲気や顔つき、表情はMETAの物を参考にお願い致します。胸は姉のセントルイス\nhttps://azurlane.wikiru.jp/index.php?%A5%BB%A5%F3%A5%C8%A5%EB%A5%A4%A5%B9\nと同じ位かそれ以上の大きさ、服はピンクのセーラー服、服はこの辺りの作品を参考にお願い致します)\nhttps://www.pixiv.net/artworks/62593933\nhttps://www.pixiv.net/artworks/90585090\nが指揮官(男性)の事が好き過ぎてKANZSENの人間を超える身体能力で強引に、愛液で濡れている自分のパンツ(パンツはこの辺りの作品を参考にお願い致します。)\nhttps://www.pixiv.net/artworks/88456924\nhttps://www.pixiv.net/artworks/87326565\nを彼の顔に鼻と口を塞ぐ様に被せて、露出させた自分の胸を彼に押し付けて逆レイプして中出しさせて、更なる中出しをねだる、とゆうシチュエーションのイラストをお願い致します。\n※出来れば、彼に対して大好きと囁きながら更なる中出しをねだるヘレナのセリフを入れて頂きたいです。\n※先生がおしっこ描写がお好きなのは存じた上での身勝手なお願いではありますが、入れて頂く場合おしっこするのはヘレナの方にだけして頂きたいです。\n\nhttps://azurlane.wikiru.jp/index.php?%A5%D8%A5%EC%A5%CA%28META%29", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bunbonian/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 39519, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/93f1e768/requests/166661_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce59102a4d230b5f18ad13676c794836", "srcset": "https://si.imgix.net/93f1e768/requests/166661_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ce59102a4d230b5f18ad13676c794836, https://si.imgix.net/93f1e768/requests/166661_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aea7c31d5964a223889e3a6fbaf81d8b 2x, https://si.imgix.net/93f1e768/requests/166661_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7dda0d17897a45f615023e8f4feefba 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/93f1e768/requests/166661_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15d727169f8dc77d17a591ff779c15af", "srcset": "https://si.imgix.net/93f1e768/requests/166661_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=15d727169f8dc77d17a591ff779c15af, https://si.imgix.net/93f1e768/requests/166661_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4e91a97fdfc351eb05cd5655a42a0563 2x, https://si.imgix.net/93f1e768/requests/166661_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d15058850c70017b8480d638673d87ac 3x"}, "body": "はじめまして。突然の依頼失礼します\n22/7の神木みかみちゃん（みかみん）というキャラクターのイラストをお願いしたいです\n京都出身でおっとりとした天然で可愛らしい女の子です。\n服装は「22/7 音楽の時間」公式サイトのキャラクターページで着ている緑色の制服衣装でお願いします\nシチュエーションは放課後の教室でノーパンノーブラで服をめくり上げ（もしくははだけさせて）胸が見えている状態で更にスカートもめくり下半身を見せて先生（僕です）を誘惑してる感じでお願いします（難しいようでしたら見せてくれるのは下半身だけでも可です）\n先生（僕です）は描かなくて大丈夫です！\n表情は恥ずかしくてドキドキしながらも見られたい、見られて嬉しいような感じで、やや上目遣いだと嬉しいです！\nぶんぼんさんの描かれる女の子の表情に惚れてリクエストを送らせていただいているので、ここに関してはそちらの感覚にお任せすれば間違いないかなと考えています…\n指定は以上です。\n他に不明点等あった場合もそちらの判断にお任せします。\nご承認いただけたら嬉しく思います。\nご検討のほどお願いいたします\n\nhttps://227-game.com/character/mikami.html", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bunbonian/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 39519, "client_id": 222862, "vtt_url": null, 