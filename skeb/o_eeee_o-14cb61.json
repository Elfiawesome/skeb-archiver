f&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eaf31b04b823d32667f19fd2f2a85daf 3x"}, "body": "ひとと先生\n\nはじめまして。\nSkebに掲載されているファンタジーな世界観でかわいくて素敵なイラストに惹かれ、ご依頼させていただきたいと思いました。\n今回お願いしたいのはVtuberの鳥宗ももさんにお贈りするファンアートになります。\n\nhttp://lit.link/torimunemomo\n＊二次創作の許可についても掲載されています。\n\n鳥宗さんはかわいくていつも笑ってる明るいイメージで、配信では相当おしゃべりで、最近は歌枠やホラー話の配信にもチャレンジしています。\nクソマロ焼却の配信などもしています。\n\nそんな鳥宗ももさんを先生の世界観で描いていただけませんか？\nよろしければ魔法要素などを取り入れていただけると嬉しいです。\nもちろん先生の思い描かれる別のシチュエーションでも構いません。\nポーズ、髪型、服装、持ち物、背景などのアレンジは全ておまかせいたします。\n\n使用用途はファンアートとしてのプレゼントですが、\n彼女の収益化された配信やSNS、グッズ販売などでも使用してもらいたいと考えています。\nキャラクターのみのPSDデータ、もしくは透過PNGデータ等も併せて頂けますと幸いです。\n\nご検討よろしくお願いいたします。\n\nhttp://lit.link/torimunemomo", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@o_eeee_o/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2155187, "client_id": 3675515, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4bd33713/uploads/origins/515c6c7b-7a87-41de-aa3a-214951973e06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bad59308973666857493434564588f09", "srcset": "https://si.imgix.net/4bd33713/uploads/origins/515c6c7b-7a87-41de-aa3a-214951973e06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bad59308973666857493434564588f09, https://si.imgix.net/4bd33713/uploads/origins/515c6c7b-7a87-41de-aa3a-214951973e06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e80f577f89e6d34d651454d7cff3d6c 2x, https://si.imgix.net/4bd33713/uploads/origins/515c6c7b-7a87-41de-aa3a-214951973e06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4fa03db00520897515e4be11b1ed24d8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4bd33713/uploads/origins/515c6c7b-7a87-41de-aa3a-214951973e06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c21afba2fe3390add1d4daa638109922", "srcset": "https://si.imgix.net/4bd33713/uploads/origins/515c6c7b-7a87-41de-aa3a-214951973e06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c21afba2fe3390add1d4daa638109922, https://si.imgix.net/4bd33713/uploads/origins/515c6c7b-7a87-41de-aa3a-214951973e06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ba5accfbce2f2495d9ba199bd72fb2b6 2x, https://si.imgix.net/4bd33713/uploads/origins/515c6c7b-7a87-41de-aa3a-214951973e06?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b04ffba40e4926f74da83407193521ac 3x"}, "body": "アークナイツのアーミヤのイラストをお願いします！\n\n構図\n・正面向き。\n・背後には『「アーミヤ」、炉心の終曲』が、背中合わせかつ低い位置で浮かんでいる。\n\n表情\n・アーミヤ:年相応の、少女らしく可愛らしい微笑み。\n・炉心アーミヤ:無表情。顔だけ振り返ってこちらを見ている。\n\n背景\n・「サルカズの炉辺奇談」をイメージした黒の背景(合わなそうであれば自由に変えてください。)\n\nお願い\n・アーミヤを明るめに、炉心アーミヤの方を暗めに描いていただきたいです。\n・何か変更する場合、笑顔のアーミヤと無表情な炉心アーミヤの対比を崩さないようにしてください。それ以外は自由に変更してもらっても構いません。\n・可能なら全身とバストアップ(2人の表情が収まる程度)の2パターンでお願いします。\n\n稚拙な部分があるかもしれませんが、何卒よろしくお願いします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@o_eeee_o/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2155187, "client_id": 3584279, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d03e598d/uploads/origins/a251cbf6-5d15-4368-b98b-f5dde3539d78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29fc164d9e8819354a06860f41e8f9ae", "srcset": "https://si.imgix.net/d03e598d/uploads/origins/a251cbf6-5d15-4368-b98b-f5dde3539d78?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29fc164d9e8819354a06860f41e8f9ae, https://si.imgix.net/d03e598d/uploads/origins/a251cbf6-5d15-4368-b98b-f5dde3539d78?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1495bd7c54dc77a76e8a2