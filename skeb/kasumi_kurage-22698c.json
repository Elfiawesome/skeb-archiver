か、どちらかお任せで\n靴はショートブーツ、靴下類はオーバーニーソックス\n頭には、ベレー帽のような帽子を斜めにかぶっている\n…といった、軍服と学生服を足して割ったようなイメージの服装を、サイズが合っていないものを無理に着ている感じでお願いします\n\n表情はぼーっとした、眠そうな感じ\nポーズはお任せ\n\nゲームや物語でのイメージ立場で言えば「剣も銃も魔法もある世界の、魔法学園生徒」\n属性でいうと「水属性」\nというイメージの少女をお願いします\nアレンジももちろん大歓迎です、可愛い・似合うと思うように描いて頂けると嬉しいです！\n\n・使用用途について\nTRPG・ツクール製ゲーム（非営利に限り）等での使用\nそれに伴う軽度の加工（切り抜きによるアイコン化、文字入れなど）\nについて、使用許可を頂きたいです\n\nhttps://skeb.jp/works/52796", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kasumi_kurage/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 43903, "client_id": 123526, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9dbcb9d0/requests/67747_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f73e2da2dbb0080a38897514abdde268", "srcset": "https://si.imgix.net/9dbcb9d0/requests/67747_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f73e2da2dbb0080a38897514abdde268, https://si.imgix.net/9dbcb9d0/requests/67747_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cbac7c665e6f3cb429b59746749be144 2x, https://si.imgix.net/9dbcb9d0/requests/67747_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=963c9f6b085123059c59d5b0fa5e9d41 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9dbcb9d0/requests/67747_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cc6aef5630c730419a2262faa439054", "srcset": "https://si.imgix.net/9dbcb9d0/requests/67747_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cc6aef5630c730419a2262faa439054, https://si.imgix.net/9dbcb9d0/requests/67747_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5c0e6b6cb593f22d211d2be2d98dc706 2x, https://si.imgix.net/9dbcb9d0/requests/6774