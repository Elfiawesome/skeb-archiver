drive.google.com/drive/folders/1RWcoZ2hu6B2WB7SePTUcvt5BZk5Zj0PQ\n\n金銭・スケジュール的に難しい際はお気軽に差し戻し下さい。ご検討のほどよろしくお願いします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 531722, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "しろまめ", "screen_name": "nekomame39", "avatar_url": "https://pbs.twimg.com/profile_images/1326379993878945794/6yDzqu01.jpg", "header_url": "https://pbs.twimg.com/profile_banners/884288981512273921/1631701098/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 2554924, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "惟月", "screen_name": "Izuki__zZ", "avatar_url": "https://pbs.twimg.com/profile_images/1916452955995488256/YXT2pB1j.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1867511922649903104/1782285045/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 2717557, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "yaguru@ログアウト", "screen_name": "yakyou_ice", "avatar_url": "https://pbs.twimg.com/profile_images/1995884484953247744/Bpe6KGcc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1596531295076524032/1791802239/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"gen