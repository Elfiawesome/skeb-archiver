200&s=a1b9f5ca67302fab0736b68d9e4eddcc", "src_set": ""}, "body": "こんにちは。先生の絵が気に入り、以前から申し込みたくて待ち望んでいた刹那、\n依頼依頼を受けるという知らせを受け、すぐに申込書を作成することになりました。\n\n私のキャラクターの女性化バージョンを申し込みたいです。\nキャラクターの外観は以下のLinkを参照してください。\n全体的な外観や表情の雰囲気などを把握できるよう、オリジナルキャラクター資料が入っているLinkもお渡しいたします。\n\nhttps://drive.google.com/drive/folders/1SQ5YCy_LULWhzRflNHoVD5bjQIc0gHPP?usp=sharing\nhttps://drive.google.com/drive/folders/1nE8dTNGrpCEhHu1Na7ox-hZq5tfvarOr?usp=sharing\n\nキャラクターが全身鏡の前で、片手で重要箇所を隠しているポーズを取り、\nスマートフォンで撮影しているシーンを見たいです。\n'ワンフィンガー・セルフィー'だと言ってますが、参考にしてほしいです。\n\nくれぐれもよく検討の上、ご承認いただければ幸いです。\nそれでは、よろしくお願いします。\n\n(念のためNSFWタグを付けておきました。 ご参考お願い致します。)", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kadomarco/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4bd3b6fb/uploads/origins/12157805-6b9b-41db-bb4b-c956adac6f8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bed6a2cb68493be091f2a7e6dd18c219", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 38357, "client_id": 1474221, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kadomarco/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 38357, "client_id": 646406, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9adc325/uploads/origins/98623ec8-e866-4e9c-b867-469e428fdf8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=043ee8e30cf4da822cd6efbdae7a9a5f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9adc325/uploads/origins/98623ec8-e866-4e9c-b86