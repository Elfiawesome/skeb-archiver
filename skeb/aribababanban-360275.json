nk you very much if you do this\n\nhttps://drive.google.com/file/d/1fAByK-m9FOu8guGAPD9thzgoQphwk1Ac/view?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aribababanban/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1104290, "client_id": 1301533, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/099be1e5/uploads/origins/fc896444-035d-4b06-a81f-5a5b17719e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=846e5e802e1cbd544349db0d5b41bfce", "srcset": "https://si.imgix.net/099be1e5/uploads/origins/fc896444-035d-4b06-a81f-5a5b17719e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=846e5e802e1cbd544349db0d5b41bfce, https://si.imgix.net/099be1e5/uploads/origins/fc896444-035d-4b06-a81f-5a5b17719e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=41d661881452fcc5b4e82d95b3f67dc2 2x, https://si.imgix.net/099be1e5/uploads/origins/fc896444-035d-4b06-a81f-5a5b17719e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bde3fe54a82cfd078ab02117522327f9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/099be1e5/uploads/origins/fc896444-035d-4b06-a81f-5a5b17719e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e976ecb1f873a63ae42de3d76716811", "srcset": "https://si.imgix.net/099be1e5/uploads/origins/fc896444-035d-4b06-a81f-5a5b17719e31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e976ecb1f873a63ae42de3d76716811, https://si.imgix.net/099be1e5/uploads/origins/fc896444-035d-4b06-a81f-5a5b17719e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ec655a1801472c478a54393477be9c67 2x, https://si.imgix.net/099be1e5/uploads/origins/fc896444-035d-4b06-a81f-5a5b17719e31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8e80c71abd6e102bb1f31ac120a1957d 3x"}, "body": "Hello, nice to meet you. I love your paintings. I’m happy you opened requests. Can you please draw my original character in your style? His race type is similar to a gnome or dwarf, so he's very short. His character theme is tomato and plants. About his personality: he likes to drink tea, he’s carefree, and likes to be comfortable. He is a farmer and fisherman. His ears and hands are large.  \n\nCharacter material: https://imgur.com/a/ju3kKZ0 \nYou can choose the expression and pose. Feel free to alter the outfit details.\nThank you very much!\n\nhttps://imgur.com/a/ju3kKZ0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@aribababanban/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1104290, "client_id": 177871, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/63fced6b/uploads/origins/1dc5f8e3-ad35-4046-9fbe-3935d610c1e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7660b62160983731682eae821d36b30", "srcset": "https://si.imgix.net/63fced6b/uploads/origins/1dc5f8e3-ad35-4046-9fbe-3935d610c1e1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7660b62160983731682eae821d36b30, https://si.imgix.net/63fced6b/uploads/origins/1dc5f8e3-ad35-4046-9fbe-3935d610c1e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7dbaa08b0c789f083d016f80d3457164 2x, https://si.imgix.net/63fced6b/uploads/origins/1dc5f8e3-ad35-4046-9fbe-3935d610c1e1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=210f19af90d7b26e4efdd3b22404d5da 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/63fced6b/uploads/origins/1dc5f8e3-ad35-4046-9fbe