うな、対になりつつも同一の存在のような感じ\n\nぶっちゃけずっと禿仝さまの八百比丘尼さんとかオロチさんの絵を見てて、禿仝さまにうちの子描いてもらいたいなぁ・・・・・・と昔から思ってました！！\n\nイメージとしては茶色の方は女の子で、白い方は男の子っぽさをひとつまみ……くらい？です！\n\nhttps://drive.google.com/drive/folders/1vvHQn_mlXZiszXlfnd5LK8_yXPRVBnY3?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 15502, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ミチヅキ8/23アルトヴァリエ大阪４号E５６", "screen_name": "BA666", "avatar_url": "https://pbs.twimg.com/profile_images/1928251389123383297/4rG5QG40.jpg", "header_url": "https://pbs.twimg.com/profile_banners/873129606/1733924628/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 21605, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "あおいゆみ🐰剣聖の幼馴染✨", "screen_name": "yumimimix", "avatar_url": "https://pbs.twimg.com/profile_images/1888945093559943168/L-Tf5Jel.jpg", "header_url": "https://pbs.twimg.com/profile_banners/113960098/1734015217/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 2143406, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "にふりす🍏drawing FA", "screen_name": "Nymph_Rhythm", "avatar_url": "https://pbs.twimg.com/profile_images/2036698880688173056/pWjHgCf4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1333433128380035073/1718494604/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip