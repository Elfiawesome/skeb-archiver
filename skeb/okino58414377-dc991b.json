1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2453440, "client_id": 3436395, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/71f0c11a/uploads/origins/d9498a3d-e1f3-41aa-a989-a2da2cb6e343?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b40080ca19a627302200e8b45002e5b9", "srcset": "https://si.imgix.net/71f0c11a/uploads/origins/d9498a3d-e1f3-41aa-a989-a2da2cb6e343?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b40080ca19a627302200e8b45002e5b9, https://si.imgix.net/71f0c11a/uploads/origins/d9498a3d-e1f3-41aa-a989-a2da2cb6e343?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61667fb62d465f3966fd8fa842442ca6 2x, https://si.imgix.net/71f0c11a/uploads/origins/d9498a3d-e1f3-41aa-a989-a2da2cb6e343?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f6fde14abe4cecfcc8ec51e97917616 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71f0c11a/uploads/origins/d9498a3d-e1f3-41aa-a989-a2da2cb6e343?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de106fca5e4e9a6066de73ecf76b6371", "srcset": "https://si.imgix.net/71f0c11a/uploads/origins/d9498a3d-e1f3-41aa-a989-a2da2cb6e343?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de106fca5e4e9a6066de73ecf76b6371, https://si.imgix.net/71f0c11a/uploads/origins/d9498a3d-e1f3-41aa-a989-a2da2cb6e343?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3f0c77c7d648878b009a604dd6ad8f23 2x, https://si.imgix.net/71f0c11a/uploads/origins/d9498a3d-e1f3-41aa-a989-a2da2cb6e343?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5fe28b2c97ea38cd616e4ad2e1d3184d 3x"}, "body": "いつも織木野様の素敵なイラストを拝見させていただいております。織木野様の絵柄で私の好きなVtuberさんを是非描いていただきたくリクエストさせていただきました。\n\n・内容 \n天神れいさんのイラスト\n└三面図が資料URLに格納してあります。立ち絵の服装で今回ご依頼させていただきたいです。\n└Twitterにて投稿していらした叶さんと椎名さんの天使のイラストがとても好きなので、神々しくも柔らかいテイストでお願いしたいです。\n└表情やイラストの全体イメージは優しく、儚い感じでお願いします。可愛らしいテイストが入っていても嬉しいです。\n・お願い \n織木野様に描いていただいたイラストをVTuber本人にプレゼントする用途で今回ご依頼させていただいております。（依頼にあたって事務所からの許可はおりています）\n頭部やパーツが切れていないキャラクターのみの透過データをいただけますと幸いです。   \nプレゼントを本人にした際に、SNSなどでの投稿・YouTubeやTwitchのサムネイルで使用する可能性がございます。\n・天神れいについて\n└ 人間のことが大好きな神様。\n天界では唯一神ゼウスと謳われる存在。\nこの世界には楽しいことが溢れてる反面、辛い現実が、暗い孤独が潜むことを知った彼は、笑顔と癒しを届けるために天界からこっそりと人間界にやってきた。（公式HPより引用）\n└誕生日:4/15 身長:175cm 血液型:AB型 利き手:左利き\n└大人びた達観した考えを持っている一方でイタズラ好きな子供みたいな側面も持っている人です。強い意志を抱いていてチャレンジ精神旺盛な印象です。\nイメージカラー：黄色\nサブカラー：青みの強い明るい紫\n\n上記にて依頼させていただきます。\n初めての依頼の為不備がありましたら申し訳ございません。どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/15-HnK-_bV0SXF_BL_r3mE32x49uxC52B", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 899508, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "よしお", "screen_name": "scomsio", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2F1643ff31-9fe7-49c5-a8d6-74e745d202d0.png%3Fsensitive%3Dtrue?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/a2332b22-d895-43ee-8c7f-713a5d903a09.png", "appeal_receivable": true, "popular_creator_rank": 76, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 21, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 1897990, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "新倉マカロ🦔🍦", "screen_name": "mcr2kura", "avatar_url": "https://pbs.twimg.com/profile_images/1888458233435889664/XL7AB1VO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1485608864443600898/1749911709/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": n