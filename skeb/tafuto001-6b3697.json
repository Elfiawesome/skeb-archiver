mgix.net/3e852cb2/uploads/origins/5aab66b9-5dbe-423e-ae1c-6883d95182a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=41e3c341cb4609526eb092733afae165 2x, https://si.imgix.net/3e852cb2/uploads/origins/5aab66b9-5dbe-423e-ae1c-6883d95182a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e011f733cf5df58e4742ec757c7a4302 3x"}, "body": "リクエストを度々してすみません。\n前回から陽暉楼のシーンを描いて頂いて感謝しかありません。\n今回、最後の桃若と珠子の取っ組み合ってる最後の見どころを桃若を「うちの妻・Y葉(27)」と珠子を「人妻湯恋旅行054」の方で描いて頂けたら是非よろしくお願い致します。\n\n太ももの付け根が見えそうで見えないようなシーンを再現でどうしても見てみたいです。\n\nシーン参考画像（7枚ありますが1番上にある画像の構図が好みです）\nhttps://imgur.com/a/IvQ0Yxz\n\n動画参考（5:12あたりです）\nhttps://m.youtube.com/watch?v=ZW17FJVIfgY\n\nいつも細かい要望すみません。すべて参考程度でタフト様の描きやすい描写で是非よろしくお願い致します。読んで頂いてありがとうございました。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tafuto001/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1136, "client_id": 1933920, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65fd18ea/uploads/origins/ea70ea4b-25e2-44c2-9b2a-ad508a5c6629?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b37096f298ab8d3a1217921def5ce6f", "srcset": "https://si.imgix.net/65fd18ea/uploads/origins/ea70ea4b-25e2-44c2-9b2a-ad508a5c6629?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b37096f298ab8d3a1217921def5ce6f, https://si.imgix.net/65fd18ea/uploads/origins/ea70ea4b-25e2-44c2-9b2a-ad508a5c6629?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69faa95a51dd71b6aacd6cbe6bbed043 2x, https://si.imgix.net/65fd18ea/uploads/origins/ea70ea4b-25e2-44c2-9b2a-ad508a5c6629?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=038eee83215a79eeda44889c31dadd4d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/65fd18ea/uploads/origins/ea70ea4b-25e2-44c2-9b2a-ad508a5c6629?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27fcad7783c06f87a3e033e4c63387e8", "srcset": "https://si.imgix.net/65fd18ea/uploads/origins/ea70ea4b-25e2-44c2-9b2a-ad508a5c6629?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27fcad7783c06f87a3e033e4c63387e8, https://si.imgix.net/65fd18ea/uploads/origins/ea70ea4b-25e2-44c2-9b2a-ad508a5c6629?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=49fcb6bbaf6a1657fe4c5defa0dd0a6b 2x, https://si.imgix.net/65fd18ea/uploads/origins/ea70ea4b-25e2-44c2-9b2a-ad508a5c6629?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=13682d1c727b3e7a110f10b431828490 3x"}, "body": "いつもリクエストさせて頂きすみません。\n陽暉楼のシーンで化粧台で桃若(タフト様に描いて頂いた着物の長髪の女性)が珠子(ショートカットの女性)に嫉妬され髪を引っ張られ押されて床にへたり込んだところを勝ち気な珠子が上から見下ろすシーンを描いて頂けないでしょうか。\n参考画像\nhttps://imgur.com/a/MsanADf\n\n参考動画(02:46頃です)\nhttps://m.youtube.com/watch?v=ZW17FJVIfgY\n\n当時のシーンが引きで画質が荒いので分かりにくくてすみません。このシーンをアップよりで表情が見えるように見たくてお願いさせて頂きます。\n\n全て可能ならで構いませんので前回の素晴らしかった作品のように珠子役をショートカットの浴衣の女性、桃若役をロングの着物の女性で是非お願い致します。\n\n長い要望すみません。読んで頂きありがとうございます。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tafuto001/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1136, "client_id": 1933920, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1169ee9/uploads/origins/d4e9ef50-2374-4231-a76c-db5fd50766ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7141335cc27f4e60626d2029b446f9f", "srcset": "https://si.imgix.net/d1169ee9/uploads/origins/d4e9ef50-2374-4231-a76c-db5fd50766ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7141335cc27f4e60626d2029b446f9f, https://si.imgix.net/d1169ee9/uploads/origins/d4e9ef50-2374-4231-a76c-db5fd50766ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd8f57d09bbccefb7b121da41ef8c413 2x, https://si.imgix.net/d1169ee9/uploads/origins/d4e9ef50-2374-4231-a76c-db5fd50766ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=47d290771068b38d37d297adbc4541bb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1169ee9/uploads/origins/d4e9ef50-2374-4231-a76c-db5fd50766ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=979010009d9564f19eb2bb803b828504", "srcset": "https://si.imgix.net/d1169ee9/uploads/origins/d4e9ef50-2374-4231-a76c-db5fd50766ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=979010009d9564f19eb2bb803b828504, https://si.imgix.net/d1169ee9/uploads/origins/d4e9ef50-2374-4231-a76c-db5fd50766ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e8c95bd27d8614186b7bff4908489109 2x, https://si.imgix.net/d1169ee9/uploads/origins/d4e9ef50-2374-4231-a76c-db5fd50766ea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f06f4124114ec4e0926153eefe026a0e 3x"}, "body": "前回、陽暉楼のジャケット絵で描いて頂きありがとうございました。描いて頂いた女性の隣の女性をタフト様の描き方で描いて頂けないでしょうか？\nモデルは人妻湯恋旅行054に出てる方です。\n参考\nhttps://www.dmm.co.jp/digital/videoa/-/detail/=/cid=h_101gs01209/\n描き方は浴衣で描いて頂けたら、浴衣の形や色はお任せ致します。良ければ是非お願い致します。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tafuto001/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1136, "client_id": 1933920, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d815ed1/uploads/origins/2eb107e3-9a01-414e-a7e9-5c576a030a0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bb853229be2d500d05bc2a2e1850f77", "srcset": "https://si.imgix.net/8d815ed1/uploads/origins/2eb107e3-9a01-414e-a7e9-5c576a030a0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1bb853229be2d500d05bc2a2e1850f77, https://si.imgix.net/8d815ed1/uploads/origins/2eb107e3-9a01-414e-a7e9-5c576a030a0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9c966d90d8022a32f05c43d17204d1b1 2x, https://si.imgix.net/8d815ed1/uploads/origins/2eb107e3-9a01-414e-a7e9-5c576a030a0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=308182c0415390ca5d2d6f2d081c77e4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d815ed1/uploads/origins/2eb107e3-9a01-414e-a7e9-5c576a030a0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68956c27b769839e07ddbb8893d00301", "srcset": "https://si.imgix.net/8d815ed1/uploads/origins/2eb107e3-9a01-414e-a7e9-5c576a030a0f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68956c27b769839e07ddbb8893d00301, https://si.imgix.net/8d815ed1/uploads/origins/2eb107e3-9a01-414e-a7e9-5c576a030a0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e2d7b75b403c1c13413688a43c91f225 2x, https://si.imgix.net/8d815ed1/uploads/origins/2eb107e3-9a01-414e-a7e9-5c576a030a0f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ed4bc142e4fcc0810e7b6c2560823410 3x"}, "body": "初めてリクエスト失礼します。\nPixivで和装や浴衣の作品をみて\n映画のジャケット写真を好みのセクシー女優の写真から是非お願いしたいです。\n\n陽暉楼という映画のジャケットが2人の女性が横になって写っているのですが左の派手な浴衣の女性を同じ構図で、うちの妻・Y葉(27)を寝取ってください44に出てくるセクシー女優のイメージで描いて頂けないでしょうか。女優の写真その2のほうが浴衣写真あります。\n\n陽暉楼ジャケット写真\nhttps://www.amazon.co.jp/dp/B00JIGG826/ref=as_li_ss_tl?ie=UTF8&linkCode=ll1&tag=primemoviestore-22#immersive-view_1661951351961\n\nセクシー女優写真　その１\nhttps://www.dmm.co.jp/digital/videoa/-/detail/=/cid=140c01997/\n\nセクシー女優写真その2\nhttps://www.dmm.co.jp/digital/videoa/-/detail/=/cid=140c02007/?dmmref=a7b036bc-9a8f4f0a4d9f58928c89ef3b0f00aaa0&i3_ref=recommend&i3_ord=3\n\n\nもし良かったら左の女性も浴衣姿で人妻湯恋旅行054に出てくる女性で描いて頂きたいです。\nhttps://www.dmm.co.jp/digital/videoa/-/detail/=/cid=h_101gs01209/\n難しい場合はまた別の依頼でお願いさせて頂きます。\n\nながい文読んで頂きありがとうございました\n浴衣のイメージはお任せ致します。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tafuto001/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1136, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/da4e2c6e/uploads/origins/4995b1fb-517b-4b04-804c-33ba07ecf056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e8da4c919d917a02ddb6f8aa9623f2d", "srcset": "https://si.imgix.net/da4e2c6e/uploads/origins/4995b1fb-517b-4b04-804c-33ba07ecf056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9e8da4c919d917a02ddb6f8aa9623f2d, https://si.imgix.net/da4e2c6e/uploads/origins/4995b1fb-517b-4b04-804c-33ba07ecf056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c24c743cfe9819a5b2020635f61d7541 2x, https://si.imgix.net/da4e2c6e/uploads/origins/4995b1fb-517b-4b04-804c-33ba07ecf056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8a01a7fcac2906a8d1aed995b4968190 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da4e2c6e/uploads/origins/4995b1fb-517b-4b04-804c-33ba07ecf056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ed9935cf492168b8d72dd3f3d39044b", "srcset": "https://si.imgix.net/da4e2c6e/uploads/origins/4995b1fb-517b-4b04-804c-33ba07ecf056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ed9935cf492168b8d72dd3f3d39044b, https://si.imgix.net/da4e2c6e/uploads/origins/4995b1fb-517b-4b04-804c-33ba07ecf056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0317f75e76634d40cc20728cd77988d6 2x, https://si.imgix.net/da4e2c6e/uploads/origins/4995b1fb-517b-4b04-804c-33ba07ecf056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=29158cfb3a8605d99b0cb7be6d27cace 3x"}, "body": "描かれてる作品に感銘を受けリクエストさせていただきました。\n\n古いジャンプの読み切りでご存知ないかもしれませんが、1993年に１話だけ連載していたものです\n（同作者の「超弩級戦士」の2巻に収録）\n\n作品名:魔剣戦記DECIDE\nキャラ名:セシリア（セシル）\nシーン:\n戦闘中、敵に剣を突き刺し倒したと思ったところ、抱き寄せられそのまま相手の両腕により拘束、首筋を吸血されるシーン\n参考:\nhttps://livedoor.blogimg.jp/ryonamoon/imgs/a/f/af0356dc.jpg\n\n詳細:\n吸血されながら、敵の股関から付き出した肉の剣により秘部を貫ぬかれ聖水を撒き散らしながら上記のように痙攣絶叫、絶頂している描写をお願いします。\n\n概ね原作の様な描写ですが、違いは\n1 少し多めに服ビリされ着衣のまま両胸ポロリ、プルン\n2 肉の剣に秘部を貫かれ、ﾄﾞｸｯﾄﾞｸｯと敵の精を注ぎ込まれている\n\n気高く強いセシルが油断不意打ちから\n戦闘状態のまま、激しく首筋を吸われ、あげくﾄﾞｸﾄﾞｸ精を注ぎ込まれる\n胸を放り出しながら\n嫌々しながら\n痙攣、絶頂を迎える姿を夢みていました\n\nすべてを網羅するアングルが難しいと思いますができる限りで結構です。\n\nお時間ある時でかまいませんので描いていただけると幸いです。\nよろしくお願いします。\n\nhttp://blog.livedoor.jp/ryonamoon/archives/1077155662.html", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tafuto001/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1136, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/80e4e009/requests/62269_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b9c926c4da0cc05f06be1fc8d90e690", "srcset": "https://si.imgix.net/80e4e009/requests/62269_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b9c926c4da0cc05f06be1fc8d90e690, https://si.imgix.net/80e4e009/requests/62269_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=778b6aaefd0e995f8b8229883664fd1b 2x, https://si.imgix.net/80e4e009/requests/62269_1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c05c81548a04625feb078fd91363a112 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80e4e009/requests/62269_1?bg=%23fff&aut