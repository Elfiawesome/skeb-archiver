a4d-b986-796baa483830?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=83dd3297a26e9a2276f5a68956e2284a 3x"}, "body": "こんにちは\n翔太が催眠術で家庭教師を誘惑する6ページの漫画をお願いします。下記URL参照。\n家庭教師はララという高校生で巨乳です。彼女のデザイン＝資料1、資料2\n翔太の名前はケン。\nP1) ララとケンはケンの部屋にいる。ケンは魔法の宝石（資料3）を使ってララに催眠術をかけ、セックスするよう命じる。\nP2) ララはシャツを開いて胸を露出させる。ケンは彼女の胸を触る。彼はすぐに彼女を快感に喘がせる。\nP3)二人はケンのベッドに乗る。ララは服を脱ぎ、仰向けになる。翔太はララの中にペニスをそっと挿入する。\nP4-5)ケンとララはセックスをする（体位＝資料4、資料5）。ケンの突きがララに快感を与え、催眠によって増幅される。ララは彼の突きによってイクように駆り立てられる。ララがオーガズムに達するとケンもオーガズムに達し、ララの子宮を精液でいっぱいにする。\nP6) セックスで喘ぐララからケンが降りる。ケンは魔法の宝石を使って再びララに催眠術をかけ、自分だけの恋人になるよう命じる。\nNG：膨らんだお腹\nご清聴ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1FyLTaH3HcJFi5aimWRszhTFKAb_DkbvP?usp=sharing", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kayumidome290/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 2954132, "client_id": 1121405, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/04b8124b/uploads/origins/12f01c18-d3d0-4f1c-84d0-fd96adf9336b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=797a391d59fe56bb7677678578c71e0d", "srcset": "https://si.imgix.net/04b8124b/uploads/origins/12f01c18-d3d0-4f1c-84d0-fd96adf9336b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=797a391d59fe56bb7677678578c71e0d, https://si.imgix.net/04b8124b/uploads/origins/12f01c18-d3d0-4f1c-84d0-fd96adf9336b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e57faac258df363a78998645f964b003 2x, https://si.imgix.net/04b8124b/uploads/origins/12f01c18-d3d0-4f1c-84d0-fd96adf9336b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=07ce75e73a9aaf8942bb4a4b21738aee 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/04b8124b/uploads/origins/12f01c18-d3d0-4f1c-84d0-fd96adf9336b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3fc1b325432608cd7e3e996674516d7f", "srcset": "https://si.imgix.net/04b8124b/uploads/origins/12f01c18-d3d0-4f1c-84d0-fd96adf9336b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3fc1b325432608cd7e3e996674516d7f, https://si.imgix.net/04b8124b/uploads/origins/12f01c18-d3d0-4f1c-84d0-fd96adf9336b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6b1283c4a97341b4edc7da6c17dc4cc6 2x, https://si.imgix.net/04b8124b/uploads/origins/12f01c18-d3d0-4f1c-84d0-fd96adf9336b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=446ea4170421258b13513414ad92e2a2 3x"}, "body": "こんにちは、あなたはこの女の子で乳房マッサージフェチを行うことができます https://www.pixiv.net/en/artworks/80096079 彼女はこのような1つの視点でショタにやっている https://www.pixiv.net/en/artworks/92411414#big_2 、ここにいくつかの詳細：\n1-ショタが仰向けに寝転がり、女の子の胸が頭の上で弾んでいるところから始まります。\n2- 少女は手コキを始め、ショタは乳首と乳房を吸う。\nショタが乳房に手を突っ込んでいる間、少女はペニスをしゃぶり始める。\n4- 次に、少女はショタの頭を乳房で覆い、左から右へマッサージを始める。\n5- 少女はショタの顔を前方から後方へマッサージし、ショタの上に乳房を引き抜く。\n6-ショタはまだ彼女の乳房を掴んだまま、彼女の口の中に精液を出す。\nありがとうございました。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kayumidome290/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2954132, "client_id": 8724, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/83f2a84a/uploads/origins/8acc0d73-a194-4859-b04f-19675adf69d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51c3355b48d55efafcbef0e8e22f39c1", "srcset": "https://si.imgix.net/83f2a84a/uploads/origins/8acc0d73-a194-4859-b04f-19675adf69d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51c3355b48d55efafcbef0e8e22f39c1, https://si.imgix.net/83f2a84a/uploads/origins/8acc0d73-a194-4859-b04f-19675adf69d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc3f04b444d87eebfc99e3a67b125cdf 2x, https://si.imgix.net/83f2a84a/uploads/origins/8acc0d73-a194-4859-b04f-19675adf69d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=79e0ade072a64e0b01c50856bae365b9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/83f2a84a/uploads/origins/8acc0d73-a194-4859-b04f-19675adf69d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef1b0efe72a9036bd3ef60ea3f22dc19", "srcset": "https://si.imgix.net/83f2a84a/uploads/origins/8acc0d73-a194-4859-b04f-19675adf69d5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef1b0efe72a9036bd3ef60ea3f22dc19, https://si.imgix.net/83f2a84a/uploads/origins/8acc0d73-a194-4859-b04f-19675adf69d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=02070cf765812cef58bf4cee36be0406 2x, https://si.imgix.net/83f2a84a/uploads/origins/8acc0d73-a194-4859-b04f-19675adf69d5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=767a42155bb5eaaec740a55c4bacf0ad 3x"}, "body": "また同じキャラの依頼になってしまうのですが\nおまかせで描いていただけませんか？\n\nhttps://imgur.com/a/eg45gdz", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kayumidome290/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2954132, "client_id": 146394, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35138fae/uploads/origins/69ebcb32-9d2e-4371-a73f-9e9651b86b02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ef4569fdc9afd6ac468e2066e9205aa", "srcset": "https://si.imgix.net/35138fae/uploads/origins/69ebcb32-9d2e-4371-a73f-9e9651b86b02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8ef4569fdc9afd6ac468e2066e9205aa, https://si.imgix.net/35138fae/uploads/origins/69ebcb32-9d2e-4371-a73f-9e9651b86b02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b3ea0035ac412749626311e7e091caf9 2x, https://si.imgix.net/35138fae/uploads/origins/69ebcb32-9d2e-4371-a73f-9e9651b86b02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8dce24a81b704412e09c900fb906a20a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/35138fae/uploads/origins/69ebcb32-9d2e-4371-a73f-9e9651b86b02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=943677ef924b85410f5ccf95876a6eb5", "srcset": "https://si.imgix.net/35138fae/uploads/origins/69ebcb32-9d2e-4371-a73f-9e9651b86b02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=943677ef924b85410f5ccf95876a6eb5, https://si.imgix.net/35138fae/uploads/origins/69ebcb32-9d2e-4371-a73f-9e9651b86b02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4a1954a0334df3c51381586063442190 2x, https://si.imgix.net/35138fae/uploads/origins/69ebcb32-9d2e-4371-a73f-9e9651b86b02?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1f2b759855fa3c4a21e7441bbb73b14c 3x"}, "body": "生尻突き出した女教師がイカされまくる漫画の続き7ページをお願いします\n\n■概要\n・蒼大はぜつりんで、ここぞとばかり遥先生の2穴を嬲り続ける\n・徹底的にイカされまくるが、最後まで快楽堕ちや屈服はしない\n\n■内容\np7\n・中出し絶頂が収まらない中、睨みつけ中出しに文句を言うが\n　あざ笑うかのように膣奥突くピストン再開\n・度重なる絶頂で更に敏感となった躰はイキっぱなしとなる\np8\n・膣ピストンされながら弱点の敏感アナルを親指でイジられ\n　遥は文句言いながらも過敏に反応\n・蒼大が用意していた電動アナルビーズを奥まで挿入され絶叫アクメ\np9～11\n・激しい膣ピストンと振動アナルビーズでケツ穴ほじりの\n　後背位2穴責めによる連続絶頂アクメ地獄でイキ狂う遥\n・イキすぎて限界を超えやめるよう何度も叫ぶが、無慈悲な責めは止まらない\n・激ピストンで膣奥までゴリゴリ抉られ、絶叫アクメし続ける\n（表情見える尻アップ構図でイキまくるシーンを3ページたっぷり）\np12\n・とどめにアナルビーズ引き抜きながらの中出しで絶叫＆大絶頂\n（大ゴマで。アナルは広げすぎない）\n・それでも責めは終わらない\np13\n・数時間経過、後背位2穴責めのアクメ地獄は続く\n（再びアナルビーズも刺さっている）\n・躰はたっぷり開発され、心身ともに疲弊しきっている\n・今後もハメまくる宣言の中出しで大絶頂\n\n■電動アナルビーズ\n・同サイズの球が隙間なく連結、コードレス\n・球はシリコン素材＆アナルを広げすぎないサイズ\n・下記を全て同サイズの球7個にしたイメージ\n　https://t.ly/ryfRT\n\n■NG項目\nアヘ顔、極端な舌出し、ひょっとこ顔、♡目、白目、虚ろ目、苦痛系、傷\n断面図・透過、尻肉波打ち、垂れ乳・乳揺れ、腹ボコ、放尿、鼻水、落書き\n\n■構図\n・今回も「表情が見える生尻アップ構図」をたくさん\n（各ページ1つ以上、特に大きめのコマ）\n　-後背位で、膝や太ももは奥に曲げるなど尻を強調\n　-尻は割れ目はっきり、ピストンで尻のラインは歪めない（丸みある桃尻で）\n　-1構図で表情（”両目”、口）、背中＆腰、結合部と小陰唇が見える\n　-両目は閉じない\n　-p12の中出し時は、上記＋顔を上げ左向き（両目必須）、尻は若干右向きで\n　　腰が尻に隠れない　（参考）https://t.ly/YYVaM\n・局部修正は黒線で\n・構図イメージ\n\nhttps://t.ly/pjWAC", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kayumidome290/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2954132, "client_id": 510691, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42fe6ba4/uploads/origins/674e1f61-510b-45f8-b5e2-b44d338a2f80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac533dfa8722f7b7faec2848e575feb4", "srcset": "https://si.imgix.net/42fe6ba4/uploads/origins/674e1f61-510b-45f8-b5e2-b44d338a2f80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ac533dfa8722f7b7faec2848e575feb4, https://si.imgix.net/42fe6ba4/uploads/origins/674e1f61-510b-45f8-b5e2-b44d338a2f80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d7b352b52409a03497558afb7301bb98 2x, https://si.imgix.net/42fe6ba4/uploads/origins/674e1f61-510b-45f8-b5e2-b44d338a2f80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=466915ac57ce8e9a085360212cf47710 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42fe6ba4/uploads/origins/674e1f61-510b-45f8-b5e2-b44d338a2f80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d70dc1636e9df8a4169221628fa0fce1", "srcset": "https://si.imgix.net/42fe6ba4/uploads/origins/674e1f61-510b-45f8-b5e2-b44d338a2f80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d70dc1636e9df8a4169221628fa0fce1, https://si.imgix.