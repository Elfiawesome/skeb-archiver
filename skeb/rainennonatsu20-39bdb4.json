353af7a/uploads/origins/8fa9210a-0001-455f-a009-489798a26ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4dfb8e1ced97bfd0acd3c0c015e855f, https://si.imgix.net/b353af7a/uploads/origins/8fa9210a-0001-455f-a009-489798a26ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c199a84d84d9452549937f9b4483b793 2x, https://si.imgix.net/b353af7a/uploads/origins/8fa9210a-0001-455f-a009-489798a26ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d1e589012f9bc09ca93d4016d7648e8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b353af7a/uploads/origins/8fa9210a-0001-455f-a009-489798a26ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffb527176166f6dec06547c33c15e078", "srcset": "https://si.imgix.net/b353af7a/uploads/origins/8fa9210a-0001-455f-a009-489798a26ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffb527176166f6dec06547c33c15e078, https://si.imgix.net/b353af7a/uploads/origins/8fa9210a-0001-455f-a009-489798a26ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=612d346c04753350a24a6f5f4fe77806 2x, https://si.imgix.net/b353af7a/uploads/origins/8fa9210a-0001-455f-a009-489798a26ad6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=54a2bf7fe7aea5f9eb13a00433792aaf 3x"}, "body": "はじめまして！こちらでのリクエストを検討しております。『TARI TARI』の坂井まひると『夜は猫といっしょ』のキュルガのイラストをよろしいでしょうか。\nイラスト内容はまひるが座ってキュルガを抱きかかえて撫でて可愛がっているシーンです。\n坂井まひるは劇中で亡くなってしまい幽霊なので身体が透けており、頭上には天使の輪っかと背中に白い翼もお願いいたします。\nまた、和奏の中の人の声優は『夜は猫といっしょ』のキュルガと同じであり、キュルガと娘との面影を重ねている様子です。服装も天使っぽい感じです。\nまひる→https://www.pixiv.net/artworks/28981937#big_0\nキュルガ→https://www.pixiv.net/artworks/100516650#big_0\n差し支えなければ背景は坂井家の墓でお願いいたします。\n長文失礼いたしましたが、よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}