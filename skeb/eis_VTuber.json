mat%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c118bd618c2c2b765bed188d11357116 2x, https://si.imgix.net/92a5aa82/uploads/origins/8bfa7d36-4adf-458a-aeb0-4f055152f47a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=92eb0399dfac17f722b25645132f9d56 3x"}, "body": "こんにちは\n\nチルノになってしまった人のイラストをお願いします\n鏡を見ているチルノになった人視点でお願いします\n\nセリフ\n「何これ！あたい、チルノになってる！？」\n「バカって言われるの嫌なんだけど…」\n(吹き出しを2つ書く)\n※セリフなし版もお願いします\n\n大袈裟に驚いていて、少し困っている感じでお願いします\n表情の参考：\nhttps://1drawstorage.blog.fc2.com/blog-entry-2472.html\n※青ざめは不要です\n\n鏡だと分かるように反射の光を入れてほしいです\n参考：\nhttps://pbs.twimg.com/media/GF5HHGnaMAALjTw?format=jpg\n\n氷の羽根を描き忘れないようお願いします\n\n---\n\nできれば、ポケダン風の画面の差分もあれば嬉しいです\n(チルノ自体は同じで構いません)\n\n画面の参考：\nhttps://www.pokemon.co.jp/ex/dungeon_magnagate/outline/images/img_story_01_game_08.jpg\nhttps://www.pokemon.co.jp/ex/dungeon_magnagate/outline/images/img_story_01_game_02.jpg\n\nその場合のセリフ(下のダイアログの部分)\n「じ…自分の　すがたが……\nチルノに……！！」\n\n---\n\nよろしくお願いします", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eis_VTuber/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2745796, "client_id": 1318798, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e127086/uploads/origins/731154a3-ba1b-4e1b-8983-af398a7b46d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3d84905eb2771d6e4fdf14d500419d3", "srcset": "https://si.imgix.net/3e127086/uploads/origins/731154a3-ba1b-4e1b-8983-af398a7b46d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e3d84905eb2771d6e4fdf14d500419d3, https://si.imgix.net/3e127086/uploads/origins/731154a3-ba1b-4e1b-8983-af398a7b46d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f05d8fb44bdc2fb99c8a88bb951542a 2x, https://si.imgix.net/3e127086/uploads/origins/731154a3-ba1b-4e1b-8983-af398a7b46d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b3ee9daa45634bc6f65cb1bb94c561d9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e127086/uploads/origins/731154a3-ba1b-4e1b-8983-af398a7b46d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01ac3f9775cc491a1be25f3abb2240bc", "srcset": "https://si.imgix.net/3e127086/uploads/origins/731154a3-ba1b-4e1b-8983-af398a7b46d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01ac3f9775cc491a1be25f3abb2240bc, https://si.imgix.net/3e127086/uploads/origins/731154a3-ba1b-4e1b-8983-af398a7b46d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=72cd4036c3597440fd5aefd45f3e849d 2x, https://si.imgix.net/3e127086/uploads/origins/731154a3-ba1b-4e1b-8983-af398a7b46d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e0ced28f4817d1d19d2c3c96a019dbe7 3x"}, "body": "はじめまして。検索から失礼します。\n\n東方LostWordの秘封レミリア(小さな悪魔令嬢)をお願いします。\n公式の立ち絵のように、椅子に座っている感じでお願いします。\n\n羽根を描き忘れないでください。\nまた、帽子のリボンは(第三者視点で)左側で、雫を3つ付けてください。\n(この2点は必ず立ち絵通りがいいので、よろしくお願いします)\n\nhttps://x.com/touhou_lw/status/1672902452088131587?s=46\n\nまた、アイコンサイズにトリミングしたものもあれば嬉しいです。\n\n何卒、よろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eis_VTuber/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2745796, "client_id": 2735288, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f262ad1d/uploads/origins/994805b5-3180-49e9-bee6-4684cbaf8029?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c652e81f835aecbf8dcdc50c3debffb", "srcset": "https://si.imgix.net/f262ad1d/uploads/origins/994805b5-3180-49e9-bee6-4684cbaf8029?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c652e81f835aecbf8dcdc50c3debffb, https://si.imgix.net/f262ad1d/uploads/origins/994805b5-3180-49e9-bee6-4684cbaf8029?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3dfb4061c9eb071672394616801ff8ba 2x, https://si.imgix.net/f262ad1d/uploads/origins/994805b5-3180-49e9-bee6-4684cbaf8029?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f2bd941258cb4ffef8ad9d015814d921 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f262ad1d/uploads/origins/994805b5-3180-49e9-bee6-4684cbaf8029?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52c9eb127565b7e17375fb4fca2074d1", "srcset": "https://si.imgix.net/f262ad1d/uploads/origins/994805b5-3180-49e9-bee6-4684cbaf8029?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52c9eb127565b7e17375fb4fca2074d1, https://si.imgix.net/f262ad1d/uploads/origins/994805b5-3180-49e9-bee6-4684cbaf8029?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=68cfa8f6981988105902f6476f43b3aa 2x, https://si.imgix.net/f262ad1d/uploads/origins/994805b5-3180-49e9-bee6-4684cbaf8029?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1c63fd0cb76e6c4de9926a53100eb23e 3x"}, "body": "こんにちは。私のサキュバスOCのアートピースが欲しいです。彼女は汗をかきやすく、彼女の体と角は自然に蒸気を発生させます。彼女の口には氷の塊があり、それをしゃぶっています。でも彼女はとても暖かくて湯気が出ているので、氷塊はすぐに溶けてしまう。トップレスで胸と乳首を見せてほしい。でもパンティは履いたままにしてほしい。彼女の尻尾には、冷凍庫から別の氷塊をつかんでほしい。溶けた氷を体中に垂らしてほしい。一番たくさん氷塊をつけたいのは、胸とおへその下。あとはお任せします。貴重なお時間を割いていただきありがとうございました。\n\nhttps://drive.google.com/drive/folders/105sTOQeK8xnIajm1g-nuApdFVxJIZEa-?usp=drive_link", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eis_VTuber/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2745796, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/550