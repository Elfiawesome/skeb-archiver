だけると大変助かります…！ \n★X以外のSNSやプラットフォームで使用する際は、お名前を都度記載させていただきます。(サムネイルモデル時のみ記載できない場合がございます)\n\nhttps://x.com/Sazanami_Win/status/2044651766927835535?s=20", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tz1un/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4014747, "client_id": 1485439, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57f4745b/uploads/origins/d8211b5c-1b06-451c-be20-27f493b7a103?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=258cc392e344a8a8a3b7685617c53526", "srcset": "https://si.imgix.net/57f4745b/uploads/origins/d8211b5c-1b06-451c-be20-27f493b7a103?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=258cc392e344a8a8a3b7685617c53526, https://si.imgix.net/57f4745b/uploads/origins/d8211b5c-1b06-451c-be20-27f493b7a103?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4cd1b2639eebe8daa198dd638996a3b 2x, https://si.imgix.net/57f4745b/uploads/origins/d8211b5c-1b06-451c-be20-27f493b7a103?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12b1a45eabaf61644c9c25bfd96485d2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57f4745b/uploads/origins/d8211b5c-1b06-451c-be20-27f493b7a103?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bbb904791b634cb3068561c19dea6f3f", "srcset": "https://si.imgix.net/57f4745b/uploads/origins/d8211b5c-1b06-451c-be20-27f493b7a103?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bbb904791b634cb3068561c19dea6f3f, https://si.imgix.net/57f4745b/uploads/origins/d8211b5c-1b06-451c-be20-27f493b7a103?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=912928c55dde140d5b168aaf93a589ab 2x, https://si.imgix.net/57f4745b/uploads/orig