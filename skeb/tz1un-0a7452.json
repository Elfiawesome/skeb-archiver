の衣装でもいいですし、全く関係ないものでも大丈夫です！\n構図などもお任せ致します。\n\n柏壬（はくみ）\n22歳、薄緑のロングヘアーに薄緑の瞳、170cmで高身長のコスプレ趣味のお姉さん。胸はHカップでボンキュッボンなタイプです。妹と一緒にコスプレをするのが趣味。髪を伸ばしてるのはいろいろアレンジできるから。腰下までの長さです。\n\nご縁がありましたら、よろしくお願いします。\nhttps://drive.google.com/drive/folders/1jqMr3hmcZtI4Pbkjvhu2E8_xiN3yJni5\nhttps://drive.google.com/drive/folders/1rMpeaTqE_NIfZI4au9Uve-y6UVHkmi2g", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tz1un/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4014747, "client_id": 2997562, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/861536fe/uploads/origins/f8d99117-3773-4b5a-a5a9-d86e78214234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa117d9479b1bf95b2447bba2defb765", "srcset": "https://si.imgix.net/861536fe/uploads/origins/f8d99117-3773-4b5a-a5a9-d86e78214234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa117d9479b1bf95b2447bba2defb765, https://si.imgix.net/861536fe/uploads/origins/f8d99117-3773-4b5a-a5a9-d86e78214234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cd75cd42a662f1adbc3cd6a31f692604 2x, https://si.imgix.net/861536fe/uploads/origins/f8d99117-3773-4b5a-a5a9-d86e78214234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5db5dfb0219de14eed0dfcd391eb5c9b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/861536fe/uploads/origins/f8d99117-3773-4b5a-a5a9-d86e78214234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efed40031f47f32373b4c48ebdb48160", "srcset": "https://si.imgix.net/861536fe/uploads/origins/f8d99117-3773-4b5a-a5a9-d86e78214234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efed40031f47f32373b4c48ebdb48160, https://si.imgix.net/861536fe/uploads/origins/f8d99117-3773-4b5a-a5a9-d86e78214234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=82811b40a816f8ea48e089d9764d0d53 2x, https://si.imgix.net/861536fe/uploads/origins/f8d99117-3773-4b5a-a5a9-d86e78214234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c0829ea6fe7c6dbaa51c1e1b963c5fe7 3x"}, "body": "こんにちは！\n個人Vtuberのたまﾁｬﾝと申します。\n新着から𝑵𝒆𝒓𝒖𝒌𝒐様のイラストを拝見し、気になったためリクエストお送りいたします✨\n\n▪内容\nVTuber「珠夜ハナビ」のいたずらっこっぽい表情を描いていただきたいです！\n\n\n◾︎キャラデザ\n【向かって右】 に泣きぼくろ、【向かって左】に八重歯。\n瞳に花火があがりますが、描写有無はお任せします。\n\n◾︎使用用途\nSNSや収益化済みの配信関連(サムネイル・配信画面等)でのVTuber活動で使用。\n\n◾︎その他\nサムネ利用のため人物の背景透過があると嬉しいです！\nまた、可能であれば頭部や髪左右の見切れが無いと大変有難いです。\n\nご縁がございますと幸いです。\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1nIxEmw0jpTV_yVdQAJv0gRO8f1H-Aseu?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tz1un/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4014747, "client_id": 2440400, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bb97067d/uploads/origins/a0fb61f5-aff9-4f0d-b509-9f556326d238?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a650848275cbd73bc9dd611461884e99", "srcset": "https://si.imgix.net/bb97067d/uploads/origins/a0fb61f5-aff9-4f0d-b509-9f556326d238?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a650848275cbd73bc9dd611461884e99, https://si.imgix.net/bb97067d/uploads/origins/a0fb61f5-aff9-4f0d-b509-9f556326d238?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d739f5d27cc163c64ffabd447865f4fa 2x, https://si.imgix.net/bb97067d/uploads/origins/a0fb61f5-aff9-4f0d-b509-9f556326d238?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e012f9862b5bc2b311ac647aef3a7702 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https: