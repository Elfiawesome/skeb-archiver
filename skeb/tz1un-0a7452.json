x.net/0600b8f0/uploads/origins/6d69d063-cdb6-4b36-b226-e0bae191fdc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3ae69f1c368b97966fa8705353704d04 2x, https://si.imgix.net/0600b8f0/uploads/origins/6d69d063-cdb6-4b36-b226-e0bae191fdc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=00f3b5b754f134ce9d7db28cdc8eca31 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0600b8f0/uploads/origins/6d69d063-cdb6-4b36-b226-e0bae191fdc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=606843a93f54b3d18b07dff1388d53a9", "srcset": "https://si.imgix.net/0600b8f0/uploads/origins/6d69d063-cdb6-4b36-b226-e0bae191fdc3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=606843a93f54b3d18b07dff1388d53a9, https://si.imgix.net/0600b8f0/uploads/origins/6d69d063-cdb6-4b36-b226-e0bae191fdc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a6754cb865403a23ed6ccae7cf366ab4 2x, https://si.imgix.net/0600b8f0/uploads/origins/6d69d063-cdb6-4b36-b226-e0bae191fdc3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=161c7280b0ef2b709fad9257f64d62c5 3x"}, "body": "こんにちは、はじめまして。\nhttps://skeb.jp/@tz1un/works/2\nhttps://skeb.jp/@tz1un/works/3\n上記の最新作や過去作品を拝見し、そのクオリティの高さに強く惹かれました。\n艶やかで立体感のある綺麗な髪の表現、目、頬、口が可愛い豊かな表情、シワや陰影の上手な服飾、\nと魅力的な点がたくさんあり、是非イラストをお願いしたいと思いました。\n特に、キューティクルばっちりな髪の描写やキュートな表情が好みで、うちの子も可愛く描いていただけると嬉しいです。\n\n少しマニアックな要素を含みますが、以下のようなオリキャラ(うちの子)の女の子を描いていただけませんでしょうか。\n以下は参考画像ですが、セーラー服のデザインや表情・ポーズ・構図は自由です。\nhttps://drive.google.com/drive/folders/1RIJ2bUUoPHZDhYmSZ5NlFco0yYrqRyDg?usp=sharing\n\n以下、リクエスト内容です。\n\n■女の子\n・艶やかな黒髪の前髪ぱっつん、少し内巻きのショートボブ、横髪・後ろ髪は口のラインくらいで切り揃えている、襟足はソフトに刈り上げ(構図次第で見えなくてもOK)\n・半袖のセーラー服\n・元気な感じ\n■シチュエーション\n・右腕にケガでギプスをしていて、三角巾で首から吊っている\n　‐首と肘のところの三角巾の結び目を見える位置にお願いします(資料URLご参照ください)\n　　(細かいですが…首の方は結び目1つ、三角巾の端が2つ、肘の方