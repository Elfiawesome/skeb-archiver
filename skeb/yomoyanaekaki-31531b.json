456?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f37ea0048fcaa5ca2473ab06c6cc18b", "srcset": "https://si.imgix.net/b5a09d5d/uploads/origins/9948872b-b3b2-4778-9df9-b4b41c642456?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f37ea0048fcaa5ca2473ab06c6cc18b, https://si.imgix.net/b5a09d5d/uploads/origins/9948872b-b3b2-4778-9df9-b4b41c642456?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=501e1567cac78b468c23712cbd15ed52 2x, https://si.imgix.net/b5a09d5d/uploads/origins/9948872b-b3b2-4778-9df9-b4b41c642456?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d257b3fb541fa93fa50beac01cf5c535 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5a09d5d/uploads/origins/9948872b-b3b2-4778-9df9-b4b41c642456?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b77c33bb61540d8fc4a176605d24354", "srcset": "https://si.imgix.net/b5a09d5d/uploads/origins/9948872b-b3b2-4778-9df9-b4b41c642456?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b77c33bb61540d8fc4a176605d24354, https://si.imgix.net/b5a09d5d/uploads/origins/9948872b-b3b2-4778-9df9-b4b41c642456?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=74b2a949e20f967bb6fc305415b02445 2x, https://si.imgix.net/b5a09d5d/uploads/origins/9948872b-b3b2-4778-9df9-b4b41c642456?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6cbd9af34bd84f68eb4b6dd099110dc6 3x"}, "body": "Sasa Can Yomoya Sama\n\nIt is nice to meet you.\nI was browsing skeb when I came across your page, and I saw your illustrations on X as well!\nI really like your manga-like style, your penmanship, and the way you draw the lines of the body!\nI was wondering if you could draw my child, so I sent a request...!\nI would like to leave the composition and situation to you, but I would appreciate it if you could draw any area from the bottom of the chest to the whole body in an unsafe atmosphere...!\nWe would appreciate it if the file format for delivery is PSD.\nI would appreciate your consideration.\nThank you very much in advance.\nPlease take care of yourself and enjoy the hot weather...!\n\nhttps://drive.google.com/drive/folders/13PIDJGCrP472uaTxvdNf33wAfTi6ch_K?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yomoyanaekaki/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2439667, "client_id": 79576, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f8bc1258/uploads/origins/fb7ff96d-a86f-4689-ae9d-bebc820ef472?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f9eceaf14d164ff3dea1648cc84f780", "srcset": "https://si.imgix.net/f8bc1258/uploads/origins/fb7ff96d-a86f-4689-ae9d-bebc820ef472?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0f9eceaf14d164ff3dea1648cc84f780, https://si.imgix.net/f8bc1258/uploads/origins/fb7ff96d-a86f-4689-ae9d-bebc820ef472?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b4c59578ab8e8a425705c3d41158b1b 2x, https://si.imgix.net/f8bc1258/uploads/origins/fb7ff96d-a86f-4689-ae9d-bebc820ef472?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4546376a6eb4350f66246a4368099a5d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8bc1258/uploads/origins/fb7ff96d-a86f-4689-ae9d-bebc820ef472?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=848ff192d808aa940d46addd5dd1507a", "srcset": "https://si.imgix.net/f8bc1258/uploads/origins/fb7ff96d-a86f-4689-ae9d-bebc820ef472?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=848ff192d808aa940d46addd5dd1507a, https://si.imgix.net/f8bc1258/uploads/origins/fb7ff96d-a86f-4689-ae9d-bebc820ef472?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=879fbd8d1042c14d3b6452a169d0e29c 2x, https://si.imgix.net/f8bc1258/uploads/origins/fb7ff96d-a86f-4689-ae9d-bebc820ef472?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fc9d03f88fc60701330172e46330cc44 3x"}, "body": "Hello, Sasa Can Yomoya-san!\nI really liked your keynary the other day.\nI will send you a request, if you don't mind, please consider it.\n\nCould you please draw my daughters, Fukabami and Kamichi?\nI can draw them together or individually, or if it's too difficult, I can draw one of them.\n\nWe will leave everything up to you, including the specific composition, situation, and costumes.\nBoth of them should have breasts, no matter how big they are, but please make sure they are not too small.\n\nThank you in advance!\n\n\nHukabami\nhttps://drive.google.com/drive/folders/1-3mD8PkicZ09BTpPouT0PcS12eo08rSF\n\nKAMICHI\nhttps://drive.google.com/drive/folders/1-cFf1cFjiEQO70VVD_CCI48Z96KztLGb", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": []}, "price_history": {"art": [{"amount": 8000, "recorded_at": 1758905941.642091}, {"amount": 5000, "recorded_at": 1771230299.426315}], "voice": [{"amount": 2000, "recorded_at": 1758905941.642091}, {"amount": 3000, "recorded_at": 1779879008.950183}], "correction": [{"amount": 500, "recorded_at": 1758905941.642091}]}, "custom": {"from_archive": true}}