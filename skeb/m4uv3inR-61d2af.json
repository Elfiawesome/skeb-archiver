j54YXR7sQljwrz7H9k?usp=share_link\n\n上記の内容でお受けいただけるようでしたらよろしくお願い致します。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@WVfwo_jobs/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3024488, "client_id": 2959773, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ece2b376/uploads/origins/b20a591d-6a55-4e5a-ac7e-3f25a03465fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e46bbbbd9640e020484930cb37758ca2", "srcset": "https://si.imgix.net/ece2b376/uploads/origins/b20a591d-6a55-4e5a-ac7e-3f25a03465fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e46bbbbd9640e020484930cb37758ca2, https://si.imgix.net/ece2b376/uploads/origins/b20a591d-6a55-4e5a-ac7e-3f25a03465fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a50efdd2d55ae97371a687f8375c469a 2x, https://si.imgix.net/ece2b376/uploads/origins/b20a591d-6a55-4e5a-ac7e-3f25a03465fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2d532a544751c2d58737b28d9895fcf3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ece2b376/uploads/origins/b20a591d-6a55-4e5a-ac7e-3f25a03465fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a44e95a08403d6d27e5778714a310173", "srcset": "https://si.imgix.net/ece2b376/uploads/origins/b20a591d-6a55-4e5a-ac7e-3f25a03465fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a44e95a08403d6d27e5778714a310173, https://si.imgix.net/ece2b376/uploads/origins/b20a591d-6a55-4e5a-ac7e-3f25a03465fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ff3370db1916c17200ef845254c2da2a 2x, https://si.imgix.net/ece2b376/uploads/origins/b20a591d-6a55-4e5a-ac7e-3f25a03465fa?bg=%23fff&auto=f