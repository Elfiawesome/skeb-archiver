gins/f82cd37e-3e75-4c8b-a679-1de8bc03280a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=01a5a505327ba435a22edf05a8e76353, https://si.imgix.net/d4c473e0/uploads/origins/f82cd37e-3e75-4c8b-a679-1de8bc03280a?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=5242704c0c63fbf2cb20c1637a757301 2x, https://si.imgix.net/d4c473e0/uploads/origins/f82cd37e-3e75-4c8b-a679-1de8bc03280a?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=ba1dacdb38d73df3cc3cd4f5ad62e55a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d4c473e0/uploads/origins/f82cd37e-3e75-4c8b-a679-1de8bc03280a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=7381c4dae1ac341e98f0702f6bbc1d5e", "srcset": "https://si.imgix.net/d4c473e0/uploads/origins/f82cd37e-3e75-4c8b-a679-1de8bc03280a?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=7381c4dae1ac341e98f0702f6bbc1d5e, https://si.imgix.net/d4c473e0/uploads/origins/f82cd37e-3e75-4c8b-a679-1de8bc03280a?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=64495af21aba59319be93b3cd244b8c3 2x, https://si.imgix.net/d4c473e0/uploads/origins/f82cd37e-3e75-4c8b-a679-1de8bc03280a?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c3fb8f599133b62adbf719bc5b104667 3x"}, "body": "騙月ライム様\n\nお世話になっております。花一華と申します。\n騙月ライム様の優しい絵が大好きです！\n\n騙月ライム様の描く可愛いミニキャラでぜひうちの子たちを見てみたいと思い、リクエストを送らせていただきました。\n\n\n【使用用途】\n個人鑑賞、個人使用の範囲内でのグッズ化、SNSアイコン等に使用\n可能でしたら、キャラクター単体のものや、PSDファイルもいただけますと嬉しいです。\n\n\n【キャラクター】\nクトゥルフ神話TRPG「花冷えに亡く季節」を遊ぶ際に作成したオリジナルキャラクター\n\n名前：アイヴィー・ルネッタ(Ivy Lunetta)\n性別：女\n年齢：16歳\n身長：158cm\nその他：鎖骨あたりまである金髪に水色のインナーカラー。水色の目。両サイドを三つ編みにしている。いつもにこにこ笑顔で、スキップが上手。\n「一緒に行きましょ、アレイナ！」\n\n名前：アレイナ・シーク(Alayna Sheik)\n性別：女\n年齢：16歳\n身長：149cm\nその他：かなり長い白髪。青とピンクのオッドアイだが、ピンク目は隠れている。動きが大きく表情豊か、いつもおどおどしている。身体から綺麗な花が咲いている。\n「ぼ、僕なんかがほんとに、いいんでしょうか……？」\n\n\n【関係性】\n1番大好きでかけがえの無い友達。色違いのヘアピンを身に付けている。アイヴィーがアレイナの手を引くことが多い。\n\n\n構図・表情はお任せします！\n内容の不備や金額の調整がありましたら、キャンセルや再送をお願いいたします🙌\n\nだんだんと日差しが暑くなってまいりましたが、どうかお身体にはお気を付けてください。\n\nhttps://drive.google.com/drive/folders/197TSjeaU2SLZf9WxVNbv25VN0pUNpaVF", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 886449, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ィォ", "screen_name": "15coro_aaa", "avatar_url": "https://pbs.twimg.com/profile_images/1402946017742315523/UW0fxNO8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1382404387373424640/1697659259/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 55, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 1371443, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぽた", "screen_name": "watari2107", "avatar_url": "https://pbs.twimg.com/profile_images/1985915978648272896/qrdWQEE-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1413985412796674051/1762314242/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 1557377, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "騙月ライム ご依頼募集中", "screen_name": "Katatsuki_S", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2F560b38e7-0a43-43af-aae3-f3f0ea7ce65f.gif?avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/110c0537-2aba-4b76-a6b6-82a1093de827.gif", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requeste