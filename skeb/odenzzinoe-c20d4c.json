able_same_genre": true}, {"path": "/@odenzzinoe/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 725652, "client_id": 473768, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9f808b4/uploads/origins/4efd9e7f-9cd8-4327-b493-5d8f25ec724a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f66c9517f4ab3f77fa16eb8fe74a89c9", "srcset": "https://si.imgix.net/e9f808b4/uploads/origins/4efd9e7f-9cd8-4327-b493-5d8f25ec724a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f66c9517f4ab3f77fa16eb8fe74a89c9, https://si.imgix.net/e9f808b4/uploads/origins/4efd9e7f-9cd8-4327-b493-5d8f25ec724a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5051265081adf653ef31705d61fda0f 2x, https://si.imgix.net/e9f808b4/uploads/origins/4efd9e7f-9cd8-4327-b493-5d8f25ec724a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b66fb4622be24c4c7f7cd87738e70025 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9f808b4/uploads/origins/4efd9e7f-9cd8-4327-b493-5d8f25ec724a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36cc1357712307a9658c13dadd4b798e", "srcset": "https://si.imgix.net/e9f808b4/uploads/origins/4efd9e7f-9cd8-4327-b493-5d8f25ec724a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36cc1357712307a9658c13dadd4b798e, https://si.imgix.net/e9f808b4/uploads/origins/4efd9e7f-9cd8-4327-b493-5d8f25ec724a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1538c1e4623ffd78a63a0e98d95aefa9 2x, https://si.imgix.net/e9f808b4/uploads/origins/4efd9e7f-9cd8-4327-b493-5d8f25ec724a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3ba183ce52beeb3620882a1bb7b73b8e 3x"}, "body": "こんにちは、リーマにエネルギーブレードを見せるための別のポーズをお願いしたい