0&s=8021b1499b71f5b25e72e1d76063f49f, https://si.imgix.net/b0a50f93/uploads/origins/6af828fb-2ecf-40e4-b867-64f0632d5839?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=df65b2dfed7ae706f53918f333f45598 2x, https://si.imgix.net/b0a50f93/uploads/origins/6af828fb-2ecf-40e4-b867-64f0632d5839?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e8efff04fe601165ef7b8a01cc028892 3x"}, "body": "Hello sensei! I love the eerie atmosphere of your art and hope I can request my character.\n\nSATURN:\n- An octopus alien from the deep sea of an unknown planet. It was experimented on by scientists and became a cruel and destructive monster.\n- It likes to incite chaos and violence for fun, and feels no remorse for its actions. It thinks humans are funny and weak.\n- Its personality shifts constantly. Sometimes it is feminine and flirty. Other times it is crass, sadistic, and disruptive.\n- Its skin is poisonous.\n- It can drain a planet's ocean completely and turn into a giant leviathan.\nMotifs: deep space, ocean, octopus, sea angels, eels, hunger, greed\n\nFeel free to draw it in whatever outfit you wish. Please cancel or resend if the amount is not enough, thank you!\n\nReference images: https://drive.google.com/drive/folders/1E_ULBGn0d4wS4JyhF7_F5R6BVWnjf3G2", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hernia052/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3538194, "client_id": 3890037, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/023c4bc5/uploads/origins/fcfdf5dc-df65-4b4d-87ca-3426144576f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ad7d6aafc891ac1f349e1dc1646b1dc", "srcset": "https://si.imgix.net/023c4bc5/uploads/origins/fcfdf5dc-df65-4b4d-87ca-3426144576f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&