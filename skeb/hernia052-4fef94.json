ove it if you could draw them both in a dark alleyway posing like yakuzas agaisnt a wall or metal staircase\n\nThank you so much for considering my request !!", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hernia052/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3538194, "client_id": 3278613, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5efc9372/uploads/origins/981e354e-58aa-4de3-82c8-6e2785286e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebd860725afbd280299c1181d0976daf", "srcset": "https://si.imgix.net/5efc9372/uploads/origins/981e354e-58aa-4de3-82c8-6e2785286e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebd860725afbd280299c1181d0976daf, https://si.imgix.net/5efc9372/uploads/origins/981e354e-58aa-4de3-82c8-6e2785286e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1bd714c6b982396483a98554a44c4fa8 2x, https://si.imgix.net/5efc9372/uploads/origins/981e354e-58aa-4de3-82c8-6e2785286e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa12049be8c63a4b494a5a5b2991c98f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5efc9372/uploads/origins/981e354e-58aa-4de3-82c8-6e2785286e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bd329a6be737586a709e09054cc647a", "srcset": "https://si.imgix.net/5efc9372/uploads/origins/981e354e-58aa-4de3-82c8-6e2785286e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bd329a6be737586a709e09054cc647a, https://si.imgix.net/5efc9372/uploads/origins/981e354e-58aa-4de3-82c8-6e2785286e6f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b232a89e2ace7714e400668719c40db6 2x, https://si.imgix.net/5efc9372/u