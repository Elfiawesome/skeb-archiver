hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f3abf4d6/uploads/origins/4829a5b6-169a-4366-954a-841bbe00383d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecd381ab95482bfa3611e0c3008c9a45", "srcset": "https://si.imgix.net/f3abf4d6/uploads/origins/4829a5b6-169a-4366-954a-841bbe00383d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecd381ab95482bfa3611e0c3008c9a45, https://si.imgix.net/f3abf4d6/uploads/origins/4829a5b6-169a-4366-954a-841bbe00383d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d9b1e86f15cb95f48e76f0c42872aba3 2x, https://si.imgix.net/f3abf4d6/uploads/origins/4829a5b6-169a-4366-954a-841bbe00383d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3bb96f1b72eae83a3902b1c589eee643 3x"}, "body": "初めまして！\nエイヂさんのイラスト全般が好きなのですが、特にSDイラストやケモ化のイラストが好きで、今回skebを開けられたツイートを見て勢いで送らせて頂きました！\nもし金額や内容に不備等ございませんでしたら、お受けして頂けますと幸いです\nよろしくお願いいたします🙇✨\n\n【希望内容】\n朝顔orネモフィラモチーフの龍🐉を描いて頂けると嬉しいです！\n\n\nこれから段々と暑くなっていきますが、心身共に健康な状態でお過ごしくださいますと幸いです\nここまで読んでくださり、ありがとうございました！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tamagoDX1414/works/157", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 583942, "client_id": 1212166, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/660664a6/uploads/origins/411a091b-019c-4862-8569-c2d1302ebc42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6df5a1468b47ed76c526296f0e7d62e1", "srcset": "https://si.imgix.net/660664a6/uploads/origins/411a091b-019c-4862-8569-c2d1302ebc42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6df5a1468b47ed76c526296f0e7d62e1, https://si.imgix.net/660664a6/uploads/origins/411a091b-019c-4862-8569-c2d1302ebc42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=132a78c75c0b03066cf6353f18de8897 2x, https://si.imgix.net/660664a6/uploads/origins/411a091b-019c-4862-8569-c2d1302ebc42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71b53c24fa91f22cefa9cfd26613c67d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/660664a6/uploads/origins/411a091b-019c-4862-8569-c2d1302ebc42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a0697ab03b5d2cec43f2238ca53da65", "srcset": "https://si.imgix.net/660664a6/uploads/origins/411a091b-019c-4862-8569-c2d1302ebc42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a0697ab03b5d2cec43f2238ca53da65, https://si.imgix.net/660664a6/uploads/origins/411a091b-019c-4862-8569-c2d1302ebc42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=05aedf665aa9e39868db5fe8a027d955 2x, https://si.imgix.net/660664a6/uploads/origins/411a091b-019c-4862-8569-c2d1302ebc42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4c1b3a2a6efe622bd0c4f94e78f34c7b 3x"}, "body": "初めまして！つい先日サイレン清掃会社を通過させて頂きました！\nシナリオ内容はもちろんのこと、出てくるNPCが全員かっこいい可愛い子ばかりで、話が進んでいく毎にどんどんと魅了され、最終的には一人で語り絵を投げる為だけのアカウントを作るほど、サイレン清掃会社の沼にはまってしまいました…\n\n今回ご依頼させて頂きたいイラストは、自宅HO1と讙とのワンシーン+SDをお願いさせて頂けないかと思い、リクエストを送らせて頂きました\n\n【希望内容】\n◆讙のSDイラスト\n服装は立ち絵のまま\nもしもあんどう本舗さんが描けるデザインだと判断して頂けるようでしたら、自陣の制服を着せて頂けると嬉しいです…\n◆＋で可能でしたら自宅キャラのSDもお願い致します\n\n◆讙が自宅キャラの頭を撫でてくれている\nそれに対して自宅は恥ずかしいからやめろ！と嫌がっている様子のイラスト\n\n◆讙が自宅キャラに抱き着いてくれている\nそれに対してやめろー！と顔を少し赤目らせながらも、口だけで振り払わず、抱きしめられているイラスト\n\n\n自宅キャラの髪型で面倒な描き込み部分がありますが、あんどう本舗さんの描きやすいよう、省いて頂いて構いません\nあんどう本舗さんに描いて頂けるだけで幸せですので…\n自陣の服装に関しましても、模様などの描き込みは省いて頂いて大丈夫です！\n\n【讙とHO1の関係について】\n勤続年数は10年ですが、出会ってからの付き合いの長さは20年近くになる仲です\n自宅は讙の事をお兄ちゃんまたは叔父さんのように慕っています\n\n普段は飄々としており、自陣に対してはおちゃらけたり、抱き着いたりするようなキャラです\n一番年齢が上にも関わらず、一番幼い性格をしております\n会社の皆の事は大事に思っており、特に自陣と讙、新しく入ってきた藍くんの事は大好きです\nしかし、讙に関しては家族同然に思っている為か、讙に抱き着く行為やおちゃらける行為をしません\n自宅曰く、恥ずかしいそうです\n\nなので、本当は抱き着きたいし褒められたいけど、三十路近い男が年上に対してそのような事は出来ない…と我慢しているのに対し、讙からの唐突な褒められ撫でられをされてやめろ！と怒りつつも喜んでいる顔がチラ見えしてしまうようなワンシーンをお願いさせて頂きました\n\nシナリオを購入出来ていない為、讙のキャラへの解釈違いがございましたら、申し訳ございません\nこちらの内容、立ち絵などに問題はがなければ、お受けして頂けますと幸いです\nあんどう本舗さんの体調とメンタルを優先してお過ごしくださいますと嬉しいです\nここまで読んでくださり、ありがとうございました！\n\n【CS】\nhttps://charasheet.vampire-blood.net/4939761\n\n【立ち絵】\nhttps://twitter.com/hekiruri42/status/1683502306254540800?s=20\n四神班になります\n讙を四神(五神)に例えるなら麒麟だね！なんて自陣と話してました", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 136879, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "KANtarou", "screen_name": "Higeeeeeeeeee8K", "avatar_url": "https://pbs.twimg.com/profile_images/879337010640568321/7HyMJr6d.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3166258608/1570018284/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 2496364, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Enchel🐾お仕事募集中", "screen_name": "Enchel", "avatar_url": "https://pbs.twimg.com/profile_images/2014153220793458688/m88EMZAR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/15274865/1755776841/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 49}, {"id": 2906038, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "月美夜🦊🎊", "screen_name": "miya_hani", "avatar_url": "https://pbs.twimg.com/profile_images/1675823264344715271/