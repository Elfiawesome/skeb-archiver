w=200&h=200&blur=200&s=1094c62625040ce537123ecbe5568a01 2x, https://si.imgix.net/7adc0af9/uploads/origins/c575ad8d-b849-4819-9e64-2a6a18cf9820?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4da7f862b2ed7f2435a7f9fd57823331 3x"}, "body": "個人ＶTubaの上観鈴さんの絵を依頼したいのですがよろしいですか？\n\n\n描いてほいイメージは、\nToAliceの可愛い服を着させてください。\n先生が上観鈴さんに似合うToAliceさんの服を見繕ってくれませんか？\n絵のイメージは、休日にうしまる（ツイにいるうしみたいなの）と帝国民（ちんちろ）と遊んでいましたらゲリラ豪雨にあい服がずぶ濡れになった感じで頼みます。\n先生が描いて世に出てる作品はどれも可愛くとても魅力的です。先生の作品に加えさせてください。\n\n使用用途は、私のSNSでの使用許可と上観鈴さんの使用許可が欲しいです。\n上観鈴さん（モデルですが）VTuberの活動(観鈴さんのSNSでの使用許可と。週間予定表や、YouTubeでのサムネ等での)配信活動に使用させていただくことが可能ですか？YouTubeチャンネルでは、スパチャ解禁してます。\n商用利用になります。\n上観鈴さんの配信活動に利用させて貰いたいです。可能でしたら制作お願いします。\nまた、人物だけの透過pngやpsdデータのご用意お願いします。\nまた、できましたら全身描いてもらいたいです。\n\n\nどうかご検討お願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gd_tach/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2861323, "client_id": 456509, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92cdbde2/uploads/origins/dea52e7c-27ac-4248-b4be-23b2a8030862?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db2b3c2257dc129ceb8d516fe504bd09", "srcset": "https://si.imgix.net/92cdbde2/uploads/origins/dea52e7c-27ac-4248-b4be-23b2a8030862?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db2b3c2257dc129ceb8d516fe504bd09, https://si.imgix.net/92cdbde2/uploads/origins/dea52e7c-27ac-4248-b4be-23b2a8030862?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=879d93f2d152d7e89c46f5aad588daed 2x, https://si.imgix.net/92cdbde2/uploads/origins/dea52e7c-27ac-4248-b4be-23b2a8030862?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c05e63e3eb95a4c7a2ac4231b535b7d1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix