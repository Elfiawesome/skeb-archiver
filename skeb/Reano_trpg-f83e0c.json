=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1508959297879b18a5f699223bc26d9d, https://si.imgix.net/ec8c344f/uploads/origins/8bcbc309-40ac-467d-91fc-c8d5fb24e3c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=551e2846da7afa424b7cef9a585b1334 2x, https://si.imgix.net/ec8c344f/uploads/origins/8bcbc309-40ac-467d-91fc-c8d5fb24e3c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0580cecdde30bc1f3aa24380d33ffe28 3x"}, "body": "れあのさんこんにちは！\nスケブ開設ありがとうございます！\n\n今回は私と私の相互のTRPGのキャラクターで、デフォルメイラスト依頼を送らせてもらいます\n\n2人は刑事のバディで、信頼して背中を預け合える関係です。\n先輩と後輩の関係性でもあり、赤髪の男性は教育係も兼任しています。\n各自の資料、軽い設定についてはリンク先のGoogleDriveに入っています。\n\n使用用途は\n個人での鑑賞（キャラクター製作者の相互にも共有）\nSNSでの使用（クリエイター様のクレジットは表記します）\nをしたいと思っています\n\n構図などはれあのさんにお任せします…！\n\nご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1t4SDyi1tKzVdi1tImy9XTpl-U4ombvdh", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@TOKONI_FUSU/works/55", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2740857, "client_id": 2622580, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a2178425/uploads/origins/4e35c7ae-70c6-41c2-ac19-1863430d8b33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ce9af88b8cdb26a70b5401fc869237a", "srcset": "https://si.imgix.net/a2178425/uploads/origins/4e35c7ae-70c6-41c2-ac19-1863430d8b33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ce9af88b8cdb26a70b5401fc869237a, https://si.imgix.net/a2178425/uploads/origins/4e35c7ae-70c6-41c2-ac19-1863430d8b33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f4b158c50c0274233375bfccd9802d3 2x, https://si.imgix.net/a2178425/uploads/origins/4e35c7ae-70c6-41c2-ac19-1863430d8b33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7ea03545923f9372b24946b55a7e627e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a2178425/uploads/origins/4e35c7ae-70c6-41c2-ac19-1863430d8b33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2367f4d60c643d22e5d4be32764222d", "srcset": "https://si.imgix.net/a2178425/uploads/origins/4e35c7ae-70c6-41c2-ac19-1863430d8b33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2367f4d60c643d22e5d4be32764222d, https://si.imgix.net/a2178425/uploads/origins/4e35c7ae-70c6-41c2-ac19-1863430d8b33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ccca9719b6de557083e092b83ccab2c 2x, https://si.imgix.net/a2178425/uploads/origins/4e35c7ae-70c6-41c2-ac19-1863430d8b33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a2282fefd2c430272a72ec5987a03c86 3x"}, "body": "初めまして。\nいつも素敵なイラストを陰から拝見しております。\n今回はOCの依頼で、新クトゥルフ神話TRPG『プルガトリウムの夜』の探索者二名を描いていただきたく参りました。\n\n▮キャラクター(関係性:バディ)\n\nピンク髪の方(HO1)　193cm　男　36歳\n髪をピンクに染め、カラーサングラスを付け見た目は刑事らしくないが今までの実績で許してもらっている班長。髪を染めているせいか若く見られがち。面倒見いいが、そこに付け込まれることが多く苦労人。HO2に振り回されることはあるが、本人も嫌ではない。芯はしっかりしているため、自分の言いたいことはしっかり伝えられる。\n\n薄茶色髪の方(HO2)　168cm　男　25歳\nとても明るく元気で社交的。HO1に飯を奢ってもらおうとしたり、年上相手に冗談をズバズバと言えるほどはっきりとしている。目上歳上に態度を変えない。「～っスね！」が口癖。\n\n▮使用用途\nスマホ･iPadの壁紙、観賞用等\n\n構図や雰囲気等はかっこいい感じにして頂けたら嬉しいです。\n何卒宜しくお願い致します。\n\nhttps://www.dropbox.com/scl/fo/9hyj3s62jd74fw5rk5wzx/AI9kQAfpgjWvdj_EyBuiRBY?rlkey=t6v90hk8pwtk0my9x1ij14zyf&st=1wzix4gl&dl=0", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ORE_ORE_7/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3477970, "client_id": 2622580, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6952fa86/uploads/origins/a9091edd-6ca4-4436-aef5-bae074e931c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200