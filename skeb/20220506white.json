37-4f31-9022-c6021cc8d541?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6364a590d62bf507b01ae18fd9248cfc 2x, https://si.imgix.net/c7aa5fca/uploads/origins/d35afe36-9437-4f31-9022-c6021cc8d541?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cf596d8677599fc453bfe0e35475f7bf 3x"}, "body": "こんにちは、あなたの絵が大好きです！\n私のキャラクター \"bbarto \"と友達のキャラクター \"Yousoro \"の絵をお願いしたいです。\nどんなポーズでもいいのですが、bbartoとYousoroがビキニを着て、お互いに喜んでいるところを描いてください。）\n\nどんな作品が出来上がるか、楽しみにしています。\n\nbbarto参考：https://imgur.com/a/Mj4eR4J\nユウソロ参考：https://imgur.com/a/UsYyQru", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@20220506white/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2455637, "client_id": 2263183, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e2660ad/uploads/origins/dd498dad-c890-4aec-9b64-600a35c64a31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4003c39e66e53513fb1483738bfda14", "srcset": "https://si.imgix.net/3e2660ad/uploads/origins/dd498dad-c890-4aec-9b64-600a35c64a31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f4003c39e66e53513fb1483738bfda14, https://si.imgix.net/3e2660ad/uploads/origins/dd498dad-c890-4aec-9b64-600a35c64a31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd04494a516cc57ed168c234fd8582bf 2x, https://si.imgix.net/3e2660ad/uploads/origins/dd498dad-c890-4aec-9b64-600a35c64a31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82aac560da39d5990b716883701c5c26 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e2660ad/uploads/origins/dd498dad-c890-4aec-9b64-600a35c64a31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8006d2523308ff20415d3e0bcb56e5a9", "srcset": "https://si.imgix.net/3e2660ad/uploads/origins/dd498dad-c890-4aec-9b64-600a35c64a31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8006d2523308ff20415d3e0bcb56e5a9, https://si.imgix.net/3e2660ad/uploads/origins/dd498dad-c890-4aec-9b64-600a35c64a31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=119a17fbb2ddcff8e5d3dd5f1b5bb017 2x, https://si.imgix.net/3e2660ad/uploads/origins/dd498dad-c890-4aec-9b64-600a35c64a31?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d9f3229608b5bf7f3b7c34e5a5609176 3x"}, "body": "お世話になっております。。\n\n『ウマ娘プリティーダービー』より\n「ジェンティルドンナ」（身長167cm・B95・W63・H87推定F cup）\nhttps://umamusume.jp/character/gentildonna\nと\n「ヴィルシーナ」（身長158cm・B83・W53・H78推定Ecup）\nhttps://umamusume.jp/character/verxina\nのコンビをリクエストお願いしたいです。\n\n・衣装はメタリックな金ビキニでお願いします。\n・体型は本来の設定より胸囲が大きめでムチムチした感じにして頂きたいです。\n・妖艶な表情でセクシーな感じの構図でお願いしたいです。\n・全身または全身からひざあたりまで描画をお願いします。\n・細かいポーズはお任せいたします。\n\n【差分】\n・ビキニの柄差分で星条旗ビキニをお願いします。\n・肌の色差分でこんがり日焼けした肌をお願いいたします。\n・恥じらっている表情差分をお願いします。\n・舌ペロしている挑発的な表情差分をお願いします。\n\n・サンリオのポムポムプリンが好きなのでポムポムプリンをあしらった髪飾りをつけて頂きたいです。\n　髪飾りのデザインはお任せいたします。\nhttps://www.sanrio.co.jp/specialsite/team-purin/\n\n・♦以前描いて頂いた三女神のように2人セットの他に1人単体の別個の画像も頂けるとありがたいです。\n\n・♦ウマ娘は尻尾があって人耳がないことを留意して頂けたら幸いです。\n\n・♦原寸大PSDデータと宛名入りpngファイル、宛名無しpngファイルで納品していただけると幸いです。\n\n・♦PSDはレイヤー統合前でファイル内で差分・宛名が切り替えられる形式でお願いいたします。\n\nご検討の程何卒宜しくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@20220506white/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ceb18a23/uploads/origins/30bbc845-436f-4db4-9baf-ba238ad24b4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cc56fa9e5e32907b249882e95a9e3449", "srcset": "https://si.imgix.net/ceb18a23/uploads/origins/30bbc845-436f-4db4-9baf-ba238ad24b4