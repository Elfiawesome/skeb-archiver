せていただきます。\n\n\n参考画像\nワンダフル立ち絵\nhttps://drive.google.com/file/d/1in-K_Jv_0KKnjQqpPo6QBea6CQGuuK1D/view?usp=drivesdk\n\nワンダフルと仲間たち（木漏れ日の中で過ごす情景）\nhttps://drive.google.com/file/d/1EREJAdzVOckrODALcbzII2Dfb3TxBA8U/view?usp=drivesdk", "nc": 0, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 11221, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "らの🦖🦕低浮上", "screen_name": "u_rano", "avatar_url": "https://pbs.twimg.com/profile_images/1566388890/________.jpg", "header_url": "https://pbs.twimg.com/profile_banners/137247926/1637574670/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 161}, {"id": 33170, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "西田ユウ", "screen_name": "nishida_yuu", "avatar_url": "https://pbs.twimg.com/profile_images/1466724577665376256/rV_e01Oo.jpg", "header_url": "https://pbs.twimg.com/profile_banners/884308838333034496/1680846599/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 1221576, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "mtn", "screen_name": "mtnmy_", "avatar_url": "https://pbs.twimg.com/profile_images/1859435710383783936/GEK1s5jk.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1152227079120801792/1782059042/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "c