ていただきます。\n\n\n参考画像\nワンダフル立ち絵\nhttps://drive.google.com/file/d/1in-K_Jv_0KKnjQqpPo6QBea6CQGuuK1D/view?usp=drivesdk\n\nワンダフルと仲間たち（木漏れ日の中で過ごす情景）\nhttps://drive.google.com/file/d/1EREJAdzVOckrODALcbzII2Dfb3TxBA8U/view?usp=drivesdk", "nc": 129, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 546567, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "でし", "screen_name": "odayakaodesi", "avatar_url": "https://pbs.twimg.com/profile_images/2101366373381517312/oTkmgVNm.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1147537547221848064/1786207896/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 1257415, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "も森", "screen_name": "momomo__ri", "avatar_url": "https://pbs.twimg.com/profile_images/1351083476968157188/RrvGlecg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1201756451066134529/1623567516/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 1796363, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "紺 ( kon )", "screen_name": "knn___e", "avatar_url": "https://pbs.twimg.com/profile_images/1719588817064349696/JbEJ4ggF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1364601367168380930/1688203778/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "acc