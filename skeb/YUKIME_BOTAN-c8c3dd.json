ボカロ曲モチーフでもOKです。セクシーなものでも問題ありません！\n雪目ぼたん様の趣味やフェチ、性癖などを全開で盛り込んでいただければと思います。\n（前髪は片目隠れでお願いします。表情豊かだとうれしいです。）\n\n\n\n人物の透過PNGかPSDを合わせて頂ければ嬉しいです。\n\n\n用途はXでの投稿や収益化したライブ配信や動画、アイコンやヘッダー使用、ネットプリント、グッズ、ファンボックスなどのVTuberとしての活動で使用させていただければと思っております。\n\n立ち絵などの資料は下記URLから確認していただければと思います。\n\n\n\nスケブでの依頼は慣れていないので至らない点があると思いますが、よろしくお願いします。\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nhttps://lit.link/mewaurora\n\nhttps://lit.link/mewaurora", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@YUKIME_BOTAN/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3123826, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3b7b13f8/uploads/origins/030da597-0361-405a-83d7-db873ae39db1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d9b91832f1577ca567b12df35abd5fa", "srcset": "https://si.imgix.net/3b7b13f8/uploads/origins/030da597-0361-405a-83d7-db873ae39db1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d9b91832f1577ca567b12df35abd5fa, https://si.imgix.net/3b7b13f8/uploads/origins/030da597-0361-405a-83d7-db873ae39db1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d470f04383f0c1ec5cb000f56fe918d2 2x, https://si.imgix.net/3b7b13f8/uploads/origins/030da597-0361-405a-83d7-db873ae39db1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=038d71109464368e41259af87ca30b3f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3b7b13f8/uploads/origins/030da597-0361-405a-83d7-db873ae39db1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0119a1ba2edbe49b2e18faf6f37cc478", "srcset": "https://si.imgix.net/3b7b13f8/uploads/origins/030da597-0361-405a-83d7-db873ae39db1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0119a1ba2edbe4