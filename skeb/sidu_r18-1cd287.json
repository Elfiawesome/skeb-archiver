ins/30b73945-90bd-4e4b-9369-47f8045c08dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=895f554844b0b449207ef1564a4211ed", "srcset": "https://si.imgix.net/6af22d93/uploads/origins/30b73945-90bd-4e4b-9369-47f8045c08dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=895f554844b0b449207ef1564a4211ed, https://si.imgix.net/6af22d93/uploads/origins/30b73945-90bd-4e4b-9369-47f8045c08dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ed228a7a5891cee800198e8ec9f6117 2x, https://si.imgix.net/6af22d93/uploads/origins/30b73945-90bd-4e4b-9369-47f8045c08dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=96a8b63bff59ade4706a290ddcdf4a0d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6af22d93/uploads/origins/30b73945-90bd-4e4b-9369-47f8045c08dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc8d1248a66cee7ef39b11b8411e710a", "srcset": "https://si.imgix.net/6af22d93/uploads/origins/30b73945-90bd-4e4b-9369-47f8045c08dc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc8d1248a66cee7ef39b11b8411e710a, https://si.imgix.net/6af22d93/uploads/origins/30b73945-90bd-4e4b-9369-47f8045c08dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bdaeeb289b1c1313490aaba7783bfbdb 2x, https://si.imgix.net/6af22d93/uploads/origins/30b73945-90bd-4e4b-9369-47f8045c08dc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc86f3476dd748834c5c8426d8cf83e3 3x"}, "body": "リクエストお願いします。\n\n頭が良く成績優秀だがケアレスミスを恐れて一問に時間をかけすぎてしまいあまり点数が伸びないことに悩んでおり親に家庭教師をつけてもらった生徒ちゃん　\nしかし弱点克服の理由で行われたのが　問題を解いてる間家庭教師が生徒ちゃんの胸・乳首を弄ってくるという変な練習がされるようになった。生徒ちゃんはもちろんこんなのおかしいと思ってるがこの練習をしてから解くスピードが上がり点数も伸びてきて何とも言えない・抵抗できない状況になってしまった　というかんじです。\n\n乳首を弄ってくるときに「ほら手が止まってますよ集中して」「ミスを怖がらないで」「大丈夫、君なら絶対できるよ」と優しく励ましててほしいです。\n生徒ちゃんは涙目になってそうです。\n\n・生徒ちゃん　高校２年生、清楚で真面目・優しい雰囲気、胸はGカップと巨乳でスタイル良し　髪型はショートカット　感度弱め\n・家庭教師　有名大学現役生　優男で好青年な印象　かなりモテる\n\n\n以上になります　キャラクターの姿は自分もぼんやりとしていて足りないとこはしづさんにおまかせしたいです。よろしくお願いします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sidu_r18/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ab94d50f/uploads/origins/d33d035f-0113-4eaf-80a0-7633738d6502?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d1e3a60cd9a9a581c372737609eab5c2", "srcset": "https://si.imgix.net/ab94d50f/uploads/origins/d33d035f-0113-4eaf-80a0-7633738d6502?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d1e3a60cd9a9a581c372737609eab5c2, https://si.imgix.net/ab94d50f/uploads/origins/d33d035f-0113-4eaf-80a0-7633738d6502?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ccbd517185acf6146f02daebb9b0ec42 2x, https://si.imgix.net/ab94d50f/uploads/origins/d33d035f-0113-4eaf-80a0-7633738d6502?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=45df558c073bb5f00d5ba2d2a799bd82 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 2845204, "client_id": 2776404, "nc": 49}, {"path": "/@sidu_r18/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2845204, "client_id": 22735, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a4e5ba3/uploads/origins/e22f3745-5e6d-4495-82c1-e8450b2fc00e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1048ff4fd9e5b0900ab792a64714e1b3", "srcset": "https://si.imgix.net/9a4e5ba3/uploads/origins/e22f3745-5e6d-4495-82c1-e8450b2fc00e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1048ff4fd9e5b0900ab792a64714e1b3, https://si.imgix.net/9a4e5ba3/uploads/origins/e22f3745-5e6d-4495-82c1-e8450b2fc00e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b88ac1a0bb6c4cf0ac906fb1a6d78448 2x, https://si.imgix.net/9a4e5ba3/uploads/origins/e22f3745-5e6d-4495-82c1-e8450b2fc00e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1440ed0c058cdce51ccf7434d7739099 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a4e5ba3/uploads/origins/e22f3745-5e6d-4495-82c1-e8450b2fc00e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=014fb76a9ff5c37168362dfcf4b83544", "srcset": "https://si.imgix.net/9a4e5ba3/uploads/origins/e22f3745-5e6d-4495-82c1-e8450b2fc00e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=014fb76a9ff5c37168362dfcf4b83544, https://si.imgix.net/9a4e5ba3/uploads/origins/e22f3745-5e6d-4495-82c1-e8450b2fc00e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=70e47a2bec863419c39e5142fefef6ef 2x, https://si.imgix.net/9a4e5ba3/uploads/origins/e22f3745-5e6d-4495-82c1-e8450b2fc00e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=216e158f7bd65529afc8e655a2f87609 3x"}, "body": "しづ先生はじめまして！以前どなたかがお題箱に投稿されていた不良男子×風紀委員のシチュが大好物なので是非アレンジしてリクエストさせてください！みんなが憧れる風紀委員長はとっくに年下不良君の女にされちゃっていて、昼に不良君を注意するのは夜にお仕置きされて、不良君に征服感を楽しんで貰うため…というシチュです！\n2人のキャラ付けとしては、3年の強く正しく美しく、皆んなが憧れる風紀委員長先輩(サイハイ黒スト着用のサラサラ艶々黒髪ロングの巨乳ちゃん)と、1年の喧嘩とセックスが強いオレ様系で容赦無い不良くん(金髪日サロで、年下だけど委員長より大きくてガタイ良い)でお願いします！指導しないといけない立場の年上の女性が、年下の優秀な雄に雌にされて逆に指導されちゃう感じです！\n構図ですが、1コマ目は昼間にタバコを吸っている不良くんに委員長が注意(タバコ、制服の着こなし、金髪、不純異性交友など) しているけど、不良くんはニヤニヤしながら委員長を獲物を見る目で見下ろしてからかっている感じでお願いします！\n2コマ目は夜にお仕置き逆指導をされちゃっているシーンをお願いします！体位は対面立位で、不良君は片手で委員長のお尻を鷲掴みにして逃げられないように引き寄せつつもう片方の手で委員長の乳首をカリカリして、じっくり委員長の奥をデカチンでゴリゴリ追い詰めていじめている感じでお願いします。委員長は不良君のデカチンに子宮ごと持ち上げられているせいで、ビクビク痙攣しながら爪先立ちして、不良君をメス顔で見上げて下さい。セリフは不良君が色んな言葉責めと命令(風紀委員長が乳首でアヘってんじゃねーよ、もっとキツく締めろ、舌出せ、イケ等)して委員長が全部従っている感じでお願いします！委員長は汗や愛液を垂れ流しながら不良君の命令に嬌声混じりに答えるのが限界なのに対して、不良君は汗一つかかず目の前のメスをいじめて反応を楽しんでいる強者の余裕たっぷりな感じでお願いします！", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sidu_r18/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2845204, "client_id": 1793917, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fb56eb4d/uploads/origins/9ea4f536-16a1-4b8c-9635-d858e6c04a3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d772a0c29932919d7e6bb99246d17a0", "srcset": "https://si.imgix.net/fb56eb4d/uploads/origins/9ea4f536-16a1-4b8c-9635-d858e6c04a3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d772a0c29932919d7e6bb99246d17a0, https://si.imgix.net/fb56eb4d/uploads/origins/9ea4f536-16a1-4b8c-9635-d858e6c04a3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=326b195b86a844a36b50c421eec58434 2x, https://si.imgix.net/fb56eb4d/uploads/origins/9ea4f536-16a1-4b8c-9635-d858e6c04a3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1ce0bfd086c3b5bdcc2d81d5238432a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fb56eb4d/uploads/origins/9ea4f536-16a1-4b8c-9635-d858e6c04a3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=536aaa54af9884a4421ad1026ab7ba9f", "srcset": "https://si.imgix.net/fb56eb4d/uploads/origins/9ea4f536-16a1-4b8c-9635-d858e6c04a3b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=536aaa54af9884a4421ad1026ab7ba9f, https://si.imgix.net/fb56eb4d/uploads/origins/9ea4f536-16a1-4b8c-9635-d858e6c04a3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1ee13e9ca15ba88b557334993a4b4a6f 2x, https://si.imgix.net/fb56eb4d/uploads/origins/9ea4f536-16a1-4b8c-9635-d858e6c04a3b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=48ebd297b838cdc35815d112bccec7a5 3x"}, "body": "しづ様\n突然のメッセージに驚かせてしまい申し訳ございません！\nX（旧Twitter）にて『（BLのリクエストも）全然大丈夫です！』と拝見したので、可能であれば私の自創作BL小説のキャラクターをお願いしたいです！\n\n作品名【そんなに可愛がらないで】\n※資料URL先に表紙イラスト（拡大版）を掲載していますので、ご参考までに！\n\n可能であれば攻め受け両方、難しい場合は攻め（リンク先イラスト右側、金髪の青年）をお願いしたいです！\n2人が可能な場合はヤンデレな攻めに笑顔で迫られて赤面しながら戸惑っているオドオド内気受けを、\n攻め1人の場合は『笑顔を浮かべながら受けに迫っている』と分かるような構図をお願いしたいです！\n\nしづ先生の描かれるイラスト、初めてpixivで（ヤンキー君×令嬢ちゃん）拝見してからずっとずっと大好きです！\nこうして大好きなしづ先生にリクエストを送る機会をいただけて、光栄です！///\n\nこれからも応援しています！\nここまでお読みくださり、ありがとうございました！\n\nhttps://estar.jp/novels/25968952/viewer?page=1", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sidu_r18/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/acb0bb0b/uploads/origins/84e34f94-b880-442d-9fea-431bb9bbca2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b9220155253bd1ce2747ee9ae7f99ee5", "srcset": "https://si.imgix.net/acb0bb0b/uploads/origins/84e34f94-b880-442d-9fea-431bb9bbca2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b9220155253bd1ce2747ee9ae7f99ee5, https://si.imgix.net/acb0bb0b/uploads/origins/84e34f94-b880-442d-9fea-431bb9bbca2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e5bb1693642cf3406e923ce197928353 2x, https://si.imgix.net/acb0bb0b/uploads/origins/84e34f94-