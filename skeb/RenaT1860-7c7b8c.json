//si.imgix.net/5a49fb33/uploads/origins/2ba3b9f3-2874-404b-a3f4-8b9da325bd6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=093bb95f9e3737b2034d56b2456fbee5 2x, https://si.imgix.net/5a49fb33/uploads/origins/2ba3b9f3-2874-404b-a3f4-8b9da325bd6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91ab886b3d54ab6ab8f5cb5dce74e7a9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a49fb33/uploads/origins/2ba3b9f3-2874-404b-a3f4-8b9da325bd6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d33aa8d33847bb845a9aa5432d397ab", "srcset": "https://si.imgix.net/5a49fb33/uploads/origins/2ba3b9f3-2874-404b-a3f4-8b9da325bd6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4d33aa8d33847bb845a9aa5432d397ab, https://si.imgix.net/5a49fb33/uploads/origins/2ba3b9f3-2874-404b-a3f4-8b9da325bd6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=97600dc289842db18e4031adab398db5 2x, https://si.imgix.net/5a49fb33/uploads/origins/2ba3b9f3-2874-404b-a3f4-8b9da325bd6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d59b18621fb528df952f4b77d6009212 3x"}, "body": "はじめまして！\n突然のリクエスト失礼いたします。ヴィオラと申します。\nとなか様の作品を閲覧させていただき、物凄く構図や表情、シチュエーションなどが好みで、ぜひうちよそでコミックが見たくリクエストさせていただきました…！\n\n設定\n\n灰色、赤メッシュの男の子 \n名前:早乙女 恕(さおとめしのぶ)\n身長:168cm\n相手の呼び方:音音\n設定:映像クリエイターの才能を持っている男の子。活発なタイプではないが、恋人の音音の、自分に対するストーカーじみた行動(盗撮や抜け毛を集めたもの等)を発見すると、頬を膨らませてむすっと怒る様な可愛いところがある。\n恋人の行きすぎた行動にも最終的に許してしまうちょろい所があり、同棲という名の軽く軟禁状態だがあまり気にしていなかったりする。\n\n金髪の男の子\n名前:心音音音(こころねねおん)\n身長:178cm\n相手の呼び方:恕\n設定:世界的有名なヴァイオリニストで、テレビなどに出演することも多い、容姿端麗金持ちスパダリ。\n他人の前では常に笑った様な糸目だが、恕の前では嘘や話を逸らす時以外は目を開けた状態が多い。\n恕以外の人間に興味がない。\n元よりストーカー体質で、恋人である早乙女恕のことを全て知ってなければ気が済まず、度の超えた束縛をしている。\n紳士的な一面と変態的な一面が4;6くらいで出る様な男。\n実はヴァイオリンどころか音楽自体煩くて好きではないが、恕が好きだというので今も続けている。\n\n関係性+普段の様子\n恋人。音音が恕に惚れ込み、猛アタックをした末、初めは冗談だと思っていた恕徐々に絆され付き合うことになった。\n現在は同棲中\n普段は音音が恕に強く愛を向けていて、恕からは照れながら愛を返してくれる様な感じです。\n\n簡単要約関係:激重ストーカー男と危機感のない男の子の恋人関係。音音✖️恕\n\n使用用途:個人鑑賞/保存/SNS紹介/個人で楽しむグッズ作成\n\n資料等: https://drive.google.com/drive/folders/1_5gMRQhwihCSI0yGBSJMqVVKepPPq7RI\n\nその他:シチュエーションはどの様な物でも大歓迎です！金髪男の愛の重さが見れたら嬉しかったりします…!\n服装等は資料の服でもオリジナルでも大丈夫です！\n参考までに画像を載せております。\nお忙しい所恐縮ですが、ご検討いただけると幸いです…！\n\nhttps://drive.google.com/drive/folders/1nHW3Vx1Rz-z8XPHvFOvlDI7TV_fVdB8p", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1234033, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "いんげん", "screen_name": "seiya_ingen", "avatar_url": "https://pbs.twimg.com/profile_images/1322046696461750272/RRNuwPOw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2580087272/1776583949/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 1534322, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "丗", "screen_name": "argt", "avatar_url": "https://pbs.twimg.com/profile_images/1985890690304524288/m48jS46G.jpg", "header_url": "https://pbs.twimg.com/profile_banners/944008446155702272/1724869783/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 6, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}], "banned": false, "nc": 176}, {"id": 1542844, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "き", "screen_name": "kirentono", "avatar_url": "https://pbs.twimg.com/profile_images/1688908908889604097/R8I-Rtx-.jpg", "header_url": "https://pbs.twimg.com