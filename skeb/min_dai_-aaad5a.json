連れ込みご奉仕を強要しているというシチュエーション。\n\n全体的に断ることができず、ちっぱいを使った奉仕を強要され悔しそうに応じているといった感じでお願いします。\n・片手で服をめくってちっぱいを露出させ、悔しそうな表情を浮かべたり、\n・上半身ヌード＋ランドセル姿でちっぱいを吸われて思わず感じてトロ顔になってしまったり、\n・裸ランドセルでパイズリを要求されやや涙目ながらも悔しそうにしている\nといったシーンがあると嬉しいです。\n\n女の子について服装はお任せしますが、\n胸は「おやすみくまさん」のみみちゃんのように無乳で乳首も小さめでお願いします。\nまた、上記作品の女の子をイメージしていますが、体格や身長はもっと小さくても構いません。\n\n注文が多くて申し訳ありません。\nどうかよろしくお願いします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@min_dai_/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6a3daa5d/uploads/origins/bb986b42-c7a9-4b56-8482-5573bbded35b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=12632fe5ba7b24f0293709a6b98378d8", "srcset": "https://si.imgix.net/6a3daa5d/uploads/origins/bb986b42-c7a9-4b56-8482-5573bbded35b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=12632fe5ba7b24f0293709a6b98378d8, https://si.imgix.net/6a3daa5d/uploads/origins/bb986b42-c7a9-4b56-8482-5573bbded35b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4834f4d725adb4cf890feb120b916759 2x, https://si.imgix.net/6a3daa5d/uploads/origins/bb986b42-c7a9-4b56-8482-5573bbded35b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8656831f1e64ce5ee91e76734a81fc62 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 652802, "client_id": 874288, "nc": 176}, {"path": "/@min_dai_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 652802, "client_id": 442252, "vtt_url": null, "thumbnail_image_urls": 