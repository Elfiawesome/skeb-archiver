f1c/uploads/origins/77095f10-133f-4baf-9b81-111e2ccd8e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52ae55ab3b564fc130c74fd133d88f95", "srcset": "https://si.imgix.net/4b4baf1c/uploads/origins/77095f10-133f-4baf-9b81-111e2ccd8e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52ae55ab3b564fc130c74fd133d88f95, https://si.imgix.net/4b4baf1c/uploads/origins/77095f10-133f-4baf-9b81-111e2ccd8e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cabc20a679b41d93c6cd0a8d0b0d3187 2x, https://si.imgix.net/4b4baf1c/uploads/origins/77095f10-133f-4baf-9b81-111e2ccd8e8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=85fcf767fec9e5e949294f17cc142baa 3x"}, "body": "こんにちは。あなたの絵は美しく、構成が良いですね。あなたのスタイルで、私のOCのイラストを描いていただけませんか？\n\n私のOCは22歳の女性会社員の死神です。身長が160cmと低く、スリルと危険が好きな体育会系のおてんば娘です。明るく元気な一匹狼・インディペンデントタイプ。いつも楽しく、精一杯生きることをモットーにしている。\n\nイラストのポーズはお任せしますが、表情は自信満々でちょっとドヤ顔な感じでお願いします。背景は朝日やゴールデンタイムのような暖色系でお願いします。舞台は都会でお願いします。目を引くような明るい構図になるよう、アーティスティックな裁量でお願いします\n\nこのイラストはSNSで使用するほか、私のフリーWeb小説の表紙（縦横比2:3）にも使用したいと思っています。お断りや、もっと高くしてほしいなど、お気軽にお申し付けください。\n\nご検討よろしくお願いします～。\n翻訳がうまくいかず申し訳ありません。\n\nhttps://drive.google.com/drive/folders/1zsN9Dagm93YGrD2E5NX7NofPry0_MWMl?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@wata_223/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2469656, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/be683420/uploads/origins/acab2b35-e3f9-41f3-8976-5adcf9ffb430?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2d23f5d14f4ef23fa4bbe6a90d3fddf", "srcset": "https://si.imgix.net/be683420/uploads/origins/acab2b35-e3f9-41f3-8976-5adcf9ffb430?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f2d23f5d14f4ef23fa4bbe6a90d3fddf, htt