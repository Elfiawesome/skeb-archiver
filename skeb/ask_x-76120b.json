天真爛漫で春をまとっている雰囲気。\nルクが体に触られるのが苦手なのを知っているのでアルエットからルクにあまり触ろうとしない(ほんとは触れたい)\n\nルク(攻め)\nいつも超然としていて感情をほとんど表にださない\nアルエットへの独占力は半端じゃない\n体に触られるのは苦手だけど克服したいと思っている\n\n・イラスト内容\nルクとアルエットが百合うぇっちをしているイラストをお願いしたいです。\nルクがアルエットを愛撫していてアルエットが不意にルクの体に傷を付けちゃうシーンがあるとうれしいです。\n\n多くの方にエヴァーメイデンを知ってもらいたいので、Twitterなどで公開していただけると嬉しいです。\n\n以上となります。よろしくお願いいたします。\n\nhttps://liar.co.jp/ever-maiden/index.html", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ask_x/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5434, "client_id": 318525, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac84c822/uploads/origins/efc709f2-6308-4f84-9e44-bee17967801b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=032d583dce9a2321df36205e112c1962", "srcset": "https://si.imgix.net/ac84c822/uploads/origins/efc709f2-6308-4f84-9e44-bee17967801b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=032d583dce9a2321df36205e112c1962, https://si.imgix.net/ac84c822/uploads/origins/efc709f2-6308-4f84-9e44-bee17967801b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=277eac1713c62d6e1a88fdea93fbffce 2x, https://si.imgix.net/ac84c822/uploads/origins/efc709f2-6308-4f84-9e44-bee17967801b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4953abbf290186997c305a1c6dc557a4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac84c822/uploads/origins/efc709f2-6308-4f84-9e44-bee17967801b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6be5736475603bfc4bca0621770f57bf", "srcset": "https://si.imgix.net/ac84c822/uploads/origins/efc709f2-6308-4f84-9e44-bee17967801b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6be5736475603bfc4bca0621770f57bf, https://si.imgix.net/ac84c82