492e/uploads/origins/163be658-7596-40b0-b191-6ee3ae653da1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8424fd47d7a3b313ceb735e418187125", "srcset": "https://si.imgix.net/0469492e/uploads/origins/163be658-7596-40b0-b191-6ee3ae653da1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8424fd47d7a3b313ceb735e418187125, https://si.imgix.net/0469492e/uploads/origins/163be658-7596-40b0-b191-6ee3ae653da1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b51032d1e6dcd06c9886f39875fe8666 2x, https://si.imgix.net/0469492e/uploads/origins/163be658-7596-40b0-b191-6ee3ae653da1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1cf9a49279731c2b18c30ff0bed06fd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0469492e/uploads/origins/163be658-7596-40b0-b191-6ee3ae653da1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79e8aa97612464bec6da9a25274480ce", "srcset": "https://si.imgix.net/0469492e/uploads/origins/163be658-7596-40b0-b191-6ee3ae653da1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=79e8aa97612464bec6da9a25274480ce, https://si.imgix.net/0469492e/uploads/origins/163be658-7596-40b0-b191-6ee3ae653da1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f9646d8b97bee72bdf615a429fb59238 2x, https://si.imgix.net/0469492e/uploads/origins/163be658-7596-40b0-b191-6ee3ae653da1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=81e95b9c2e0fc7c189dac4df37744151 3x"}, "body": "またまたこんにちは。イセウルのTRPGの絵が素敵ですね。私のキャラのタカラのTRPG絵も描いてください! \n\nhttps://drive.google.com/drive/folders/1r4OvPAkD3u5K1MpOVD40XRIF1w9AKyDw?usp=sharing\n\n髪の毛はグラデーションでお願いします! 下は薄いピンクの色合いです。狐耳、頭羽、王冠も忘れないでください。\n\n瞳孔は白です。瞳孔は白で、切れ長です。\n\n表情は、イライラ、ドヤ顔、はにかみ、などなど、描けますか？牙や鋭利な歯も描いていただけると嬉しいです。ポーズはおまかせします。\n\nブーツの底は赤です。\n\nありがとうございました。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Haya_Yaba/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2489372, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/75237b7d/uploads/origins/68b10e78-2c9f-4c71-9dd8-e196a187fab9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c26c6072932b31217c2371cc5b564bd", "srcset": "https://si.imgix.net/75237b7d/uploads/origins/68b10e78-2c9f-4c71-9dd8-e196a187fab9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c26c6072932b31217c2371cc5b564bd, https://si.imgix.net/75237b7d/uploads/origins/68b10e78-2c9f-4c71-9dd8-e196a187fab9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9b0f134db0c30167ba81aff2bbc17e76 2x, https://si.imgix.net/75237b7d/uploads/origins/68b10e78-2c9f-4c71-9dd8-e196a187fab9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62ecc3b787b25272e065967c13699321 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/75237b7d/uploads/origins/68b10e78-2c9f-4c71-9dd8-e196a187fab9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f0c076b66dd27c46ddecbeb4bfe263b", "srcset": "https://si.imgix.net/75237b7d/uploads/origins/68b10e78-2c9f-4c71-9dd8-e196a187fab9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f0c076b66dd27c46ddecbeb4bfe263b, https://si.imgix.net/75237b7d/uploads/origins/68b10e78-2c9f-4c71-9dd8-e196a187fab9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7ceac17a22ffce5ad4ca3168a8439415 2x, https://si.imgix.net/75237b7d/uploads/origins/68b10e78-2c9f-4c71-9dd8-e196a187fab9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2d1445a58cad2d0a2b4ed1004fbb15b6 3x"}, "body": "はじめまして、新着イラストから知りました、目付きが悪かったり青ざめたり表情豊かな姿やSF系創作の時のシチュ、twitterの婬魔くんちゃん（引っかかりそうなので文字替え）が好みでした。\nうちの子のオリショタを描いて頂きたく思い依頼させて頂きます。\n\n●キャラ設定\n・中性的（男の娘）な少年の魔族（婬魔）です。\n・悪の組織の幹部で、魔法が得意な設定です。\n　鞭を武器にし、鞭は魔法を使う時、杖の役割も持ちます。\n　魔法タイプなので素の力は少年の見た目相応に非力です。\n・Sっ気の強い生意気で小悪魔な性格です。\n　妖艶さや余裕のあるクール系に憧れ、平常時はそう演じていますが\n　本当は直情的で子供っぽく、そして打たれ弱いオスガキです。\n　煽って調子に乗ってわからせられるタイプ。\n　婬の魔なのでいやらしい事も好き。\n・筋肉が少なく華奢で太ってはいないが柔らかめ。\n　腹筋や線が無くスラッとしてて綺麗なおなかでおへそは普通の縦。\n　少年ですが中性的な魔族なのでお尻が少し大きめ等女性的に見える特徴も一部あります。\n　一応八重歯があり笑うと少し見えます。\n・コスチュームは軍服+ボンデージなイメージで、全体的にレザーやエナメル的なテカった光沢の出る感じの素材。\n　ホットパンツは鼠蹊部が見えるくらい股上が浅いローライズで、チャックは後ろ側まで続いています。\n　ブーツの踵は高めのヒールでお願いします。\n\n●詳細\n立ち絵が好きなので、全身の立ち絵を描いて頂きたいです。\nポーズはおなかやおへその隠れない構図で、それ以外はある程度自由にお任せしたいです。\n基本の表情もポーズに合わせたものをお任せしたいです、表情差分で\n・怒った表情\n・調子に乗って煽ってニヤついてるオスガキ表情\n・命の危機に激しめに恐怖し涙目で震え怯えている表情\n・微笑み、または悪そうな笑み\n・恥ずかしさで赤面\n等の表情がいくつかあると嬉しいです、全てでなくても大丈夫です。\n\n描いて頂いたイラストは他の方にイラストをお願いする際の参考資料としても使用させていただくかもしれません。\n\nTRPGをやるわけではないのですが、立ち絵自体が好きなので依頼したく思いました。\n受けて頂けると嬉しいです、よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1YWKys3lbCKuEIdM8aGsQoXGrznHfOKeQ", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Haya_Yaba/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e6685657/uploads/origins/87b5a3d6-b275-41bf-8d11-289ce5704cec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=019aa6f46e7acb833b4ea7c4b50c51a9", "srcset": "https://si.imgix.net/e6685657/uploads/origins/87b5a3d6-b275-41bf-8d11-289ce5704cec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=019aa6f46e7acb833b4ea7c4b50c51a9, https://si.imgix.net/e6685657/uploads/origins/87b5a3d6-b275-41bf-8d11-289ce5704cec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold