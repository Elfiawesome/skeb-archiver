ize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8cc8b86f7395e487235a89259d06e682 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1734088506228817920%2FaQ7TXdfM.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b575642b7cdf97ccc7fed79d7910735 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1734088506228817920%2FaQ7TXdfM.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=300e7fdd8990ce34c76f802fdceaad0c", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1734088506228817920%2FaQ7TXdfM.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=300e7fdd8990ce34c76f802fdceaad0c, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1734088506228817920%2FaQ7TXdfM.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4afc5d7afa387ba1af59474af2907d39 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1734088506228817920%2FaQ7TXdfM.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e0e8589de8b5361a5e94a9c414c61c17 3x"}, "body": "はじめまして。卓すきから来ました！\n\nTRPGの恋人前提シナリオ用に生まれたBLうちよその小説をおまかせでお願いしたいです。（よその親御さんには許可をいただいております。長さ、形式も希望ございません。\n設定はほぼ事前すり合わせで作ったものであり、該当シナリオのネタバレはありません。\n\n【設定】\n中学、高校と一緒に通った同級生。\n十佳の家が剣利の家の倍のゲームを所蔵していたのをきっかけによく家に遊びに行く仲になる。二人ともあまり交友関係も部活動もアクティブではないこともありずっとそれを続けた。テ●リスの対戦を延々とできるタイプ。\n\n県内の別の大学に進学したが、より遠くに通学するために一人暮らしを始めた十佳の家に剣利が遊びに行き、\n「十佳の家の方が俺の大学も近いんだよね」\n「じゃあ明日こっから学校行っちゃえば」\nということを繰り返しほぼ同棲状態となる。\nその過程でいつの間にか恋人関係になった。何があったんですかね……。（フンワリ）\n\nその状態のままそれぞれ就職してしまったため、28歳になってやっと二人で余裕をもって住める家への引っ越しと結婚を考え始めている。周囲に祝福されているカップル。\n\n\n●剣利（ハヤリ）（攻め寄りリバ）　キャラクターデザイン：ps\n現在28歳のITエンジニア系職。元パソコン部。\nどちらかというと気持ちに理性が持っていかれる方。ロボット掃除機をペットだと思っている。\n柔らかいぶっきらぼう口調。内心かなり十佳にデレデレしているので他人に対してはもう少しそっけない。\n「十佳」\n「おまえ」\n「どーも」\n「俺はまあ、なんとかする」\n「なんか、それもどうなんだろ」\n「不安なのはそうだから、見てて」\n\n●十佳（ジッカ）（受け寄りリバ）　キャラクターデザイン：間さん\n現在28歳の事務系職。元文学部。\n部屋を綺麗に保つことが苦じゃない方。ロボット掃除機をペットだとは思えない。\n爽やか優しい口調。剣利よりちょっぴりだけ背が高い。\n「剣利」\n「君」\n「……そうか」\n「じゃあ僕もお供しますよ」\n「無理はしないで」\n\n\nリンク先は外見イメージとちょっぴりログです。\n\nNSFWつけておりますが、幅を広げるためであり必須ではありません。\n方針必要な場合は「こういう二人なら昔こんなことあったんじゃないかな」という方向性の日常ものが嬉しいです。\n\nご一考よろしくお願いいたします！\n\nhttps://drive.google.com/file/d/1GxQJdgIgorYE6fqdLaG2XcBEPQJrxEeY/view?usp=sharing", "nc": 40, "word_count": 4665, "transcoder": "text", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@youho0309/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 483363, "client_id": 2000658, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/25b5a16d/uploads/origins/1ea15f36-2e35-43b0-962c-29914212072a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00c6e17fb4fe8b95b969b687e4217f1d", "srcset": "https://si.imgix.net/25b5a16d/uploads/origins/1ea15f36-2e35-43b0-962c-29914212072a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00c6e17fb4fe8b95b969b687e4217f1d, https://si.imgix.net/25b5a16d/uploads/origins/1ea15f36-2e35-43b0-962c-29914212072a?bg=%23fff&auto=format%2Ccompress&fm=web