f50c51b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8548dd6d62c5384a5dd5857ab269661d", "srcset": "https://si.imgix.net/11c0459d/uploads/origins/65271723-ee62-44de-bad3-62e6f50c51b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8548dd6d62c5384a5dd5857ab269661d, https://si.imgix.net/11c0459d/uploads/origins/65271723-ee62-44de-bad3-62e6f50c51b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eac780c32addef864bf1ae12cfa7fee2 2x, https://si.imgix.net/11c0459d/uploads/origins/65271723-ee62-44de-bad3-62e6f50c51b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f58a8d3d3fcd158734d5d50307839a73 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/11c0459d/uploads/origins/65271723-ee62-44de-bad3-62e6f50c51b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cedc2774901174229302802663a9bc0e", "srcset": "https://si.imgix.net/11c0459d/uploads/origins/65271723-ee62-44de-bad3-62e6f50c51b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cedc2774901174229302802663a9bc0e, https://si.imgix.net/11c0459d/uploads/origins/65271723-ee62-44de-bad3-62e6f50c51b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6992e480d465270b93645e7578a33449 2x, https://si.imgix.net/11c0459d/uploads/origins/65271723-ee62-44de-bad3-62e6f50c51b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=825b859428622e157ace0e52004e4da2 3x"}, "body": "私は司祭のイラストを見て、このキャラクターについて考えてほしいと思った。\nエクソシスター・マルファ\n\nscenario : 悪い噂を聞いて教会に忍び込む。彼女はその教会の修道女のコスチュームに変装するが、神父は彼女に儀式的なセックスをするように言う。問題を避けるため、彼女は彼とのセックスに同意する。\n\n*その他、描きやすい服装で構いません。\n*彼女がダークサイドに転向する前に、この物語は噂の一つかもしれない(!?)。\n*私のアイデアのリクエストは変更可能です。\n\nhttps://imgur.com/a/pOrum43", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genr