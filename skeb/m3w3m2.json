お願いします！\n\nシチュ\nベッドに座った着衣の柳井アリスに全裸のショタがしがみついて腰をヘコヘコ振っている\n柳井アリスはペットを可愛がったり赤ちゃんをあやすような笑顔でににこにこしている\n母乳がシャツから染み出てると嬉しいです\n\n柳井アリスについて\n身長149cm\nスリーサイズB106（L）W58H102\nインナーカラーとシルクハット、ハイライトのない目がトレードマーク、トランジスタグラマーな色素薄めの女性です\nエセお嬢様言葉で喋り、ダウナーな見た目とは裏腹に結構テンションが高いです\n色仕掛けが得意で手のひらで男の人を転がします\n衣装や体型は書きやすいように多少改変していただいても構いません\n資料URL\nhttps://x.com/salicevitaminC/status/1697816871092039893\n\nモブショタについて\n白ハゲモブっぽく描いてください\nショタのオンオフ差分も書いていただけると嬉しいです\n\nよろしくお願いします", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@m3w3m2/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3612235, "client_id": 130788, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd926069/uploads/origins/ac2370b5-0888-49ea-97ea-a9d23ca967a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7efd9db4ed22a126a519741f5cd6599b", "srcset": "https://si.imgix.net/bd926069/uploads/origins/ac2370b5-0888-49ea-97ea-a9d23ca967a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7efd9db4ed22a126a519741f5cd6599b, https://si.imgix.net/bd926069/uploads/origins/ac2370b5-0888-49ea-97ea-a9d23ca967a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4644e9430db37038b08f8ae8ebc3b0ce 2x, https://si.imgix.net/bd926069/uploads/origins/ac2370b5-0888-49ea-97ea-a9d23ca967a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=290167bcba1d2a17ccf65e53d4227e9c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bd926069/uploads/origins/ac2370b5-0888-49ea-97ea-a9d23ca967a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=891de63d12205c1d2f3b1e30ec491924", "srcset": "https://si.imgix.net/bd926069/uploads/origins/ac2370b5-0888-49ea-97ea-a9d23ca967a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=2