な武器を生成することが可能。敵の血液からも生成できるので、追い詰めても、追い詰められても強くなる恐ろしい能力を持つ。\nまた、痛覚がないため体を上下に切断されても敵を追いかける。首が切断されようともどこからか響き渡るような声で喋る。\n人との対話は好き。距離感を履き違えないか、どう話していいのかが分からない。\n身体的な痛みを理解できない。心の痛みはわかる。\n知らないのは怖い、でも、踏み込む勇気はない。言葉にするには何かが足りない。\n\n\n何卒よろしくお願い致します！🍰\n\nhttps://drive.google.com/drive/folders/1V_Sa92gdNqzchyY_Ose4V4cU4brluhMz", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1404809, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "カエルカー", "screen_name": "mkng15iii", "avatar_url": "https://pbs.twimg.com/profile_images/1503019400588591108/rSsJvRvx.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4497246072/1667649045/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "comic"}, {"genre": "art"}], "banned": false, "nc": 177}, {"id": 2305150, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "森", "screen_name": "doto_mori", "avatar_url": "https://pbs.twimg.com/profile_images/1519155753667665921/lj1DNil7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1517002922600853504/1759244048/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 2634511, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぴ", "screen_name": "pchandayo_", "avatar_url": "https://pbs.twimg.com/profile_images/1734525854007582720/PgjMa983.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1733484939365289984/1748775944/1500x500", "appeal_receivable": false, "popular_creator_rank": null,