\nまた、痛覚がないため体を上下に切断されても敵を追いかける。首が切断されようともどこからか響き渡るような声で喋る。\n人との対話は好き。距離感を履き違えないか、どう話していいのかが分からない。\n身体的な痛みを理解できない。心の痛みはわかる。\n知らないのは怖い、でも、踏み込む勇気はない。言葉にするには何かが足りない。\n\n\n何卒よろしくお願い致します！🍰\n\nhttps://drive.google.com/drive/folders/1V_Sa92gdNqzchyY_Ose4V4cU4brluhMz", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1744763, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ᴇʀᴍ⚡️", "screen_name": "erm_nkcn", "avatar_url": "https://pbs.twimg.com/profile_images/1756978248549031937/BdMoP9FO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1330469555165081600/1686373032/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 70, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 1928612, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "もんごす", "screen_name": "_mongos_mongo", "avatar_url": "https://pbs.twimg.com/profile_images/1679482020764991489/7Mid-EaZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1230153148771127296/1722256940/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "video"}], "banned": false, "nc": 17}, {"id": 2876142, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ﾏｯｸﾛ", "screen_name": "m_96_1", "avatar_url": "https://pbs.twimg.com/profile_images/2114290918954295296/n1s1ZoP2.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1038788192047001600/1792921211/1500x500", "appeal_receivable": false, "popular_creator_rank": 78, "request_master_rank": null, "first_reque