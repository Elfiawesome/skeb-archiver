n\n穏やかで優しさに溢れつつ、常に含みのある喋り方をし、気が付けばそこにいるような人物。\nやさしい怪異、コワいだけでいい人と呼ばれていますが、欲望に忠実な面もある。長い髪が揺れると枯草の擦れるような音がします。とにかく身長が高い。とにかく小さい子供が大好き。\n\n-------------------------\n\n怖井さまの作られる、描かれる「こわい」「お化け」の感触がとてつもなく好きなので\nこちらのキャラクターから感じられた「お化け」感を、怖井さまの感覚のまま、製作して頂ければ幸いです。\n\nお忙しい中とは存じますが、もしよろしければご検討よろしくお願い致します。", "nc": 8, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@nakagore/works/25", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 7116, "client_id": 470301, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9b7d5d69/uploads/origins/e6e3e06d-09ae-4631-96da-ad8e9385fd58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=418886513bbb868bdf63038a658683ca", "srcset": "https://si.imgix.net/9b7d5d69/uploads/origins/e6e3e06d-09ae-4631-96da-ad8e9385fd58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=418886513bbb868bdf63038a658683ca, https://si.imgix.net/9b7d5d69/uploads/origins/e6e3e06d-09ae-4631-96da-ad8e9385fd58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bccd6f8b17a8dc6623876b0a38beae52 2x, https://si.imgix.net/9b7d5d69/uploads/origins/e6e3e06d-09ae-4631-96da-ad8e9385fd58?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6dad2096d0323b5a80be03cb1a0caa5d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9b7d5d69/uploads/origins/e6e3e06d-09ae-4631-96da-ad8e9385fd58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f78221b9eb6c0a4d25799882d3e8a74", "srcset": "https://si.imgix.net/9b7d5d69/uploads/origins/e6e3e06d-09ae-4631-96da-ad8e9385fd58?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8f78221b9eb6c0a4d25799882d3e8a74, https://si.imgix.net/9b7d5d69/uploads/origins/e6e3e06d-09ae-4631-96da-ad8e9385fd58?bg=%23fff&auto=format%2C