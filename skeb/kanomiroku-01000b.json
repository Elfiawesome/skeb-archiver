4cbe6/uploads/origins/866568b7-2790-46dd-adc0-e223ef932597?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c56e1a052bc4fcdbf6532bf77b0c9fc0, https://si.imgix.net/8b94cbe6/uploads/origins/866568b7-2790-46dd-adc0-e223ef932597?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=181812698295ab2015241c98f98d552b 2x, https://si.imgix.net/8b94cbe6/uploads/origins/866568b7-2790-46dd-adc0-e223ef932597?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5972b5c87a1d570dcdefdc54d6ff953 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b94cbe6/uploads/origins/866568b7-2790-46dd-adc0-e223ef932597?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95a814aa3de110e779d32db6db57eeee", "srcset": "https://si.imgix.net/8b94cbe6/uploads/origins/866568b7-2790-46dd-adc0-e223ef932597?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95a814aa3de110e779d32db6db57eeee, https://si.imgix.net/8b94cbe6/uploads/origins/866568b7-2790-46dd-adc0-e223ef932597?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0e7f952de2fc27b7a659c89297c7a6a5 2x, https://si.imgix.net/8b94cbe6/uploads/origins/866568b7-2790-46dd-adc0-e223ef932597?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=932bf9a4713c8ab89d2d7e1a19d1a616 3x"}, "body": "つみの様\n\n初めまして。Vtuberとして活動しております、神野みろく(かのみろく)と申します。\nSkebの検索にて大変素敵なロゴ作品を拝見し、ぜひご依頼させていただきたくメッセージをお送りいたしました。\n\n◆ご依頼したい作品\nYouTubeの動画シリーズ「あくまで自由時間」(4月頃スタート予定)のロゴイラスト制作をお願いいたします。\n（可能であれば、ロゴに使用したモチーフなどの要素の透過PNGもいただきたいです。）\n\nロゴにしていただきたい文字：　神野みろくの　あくまで自由時間\n（読み：かのみろくの　あくまでじゆうじかん）\n※日常の時間を利用したり、仕事を全力で終わらせて、悪魔で人間のVtuber神野みろくが”あくまで”自由時間を楽しむ動画シリーズです。\n\n【詳細】\nハッシュタグ：＃あくまでじゆうじかん\n\nキャッチコピー：「残業対よろ！(対戦よろしくお願いします)」の精神で仕事に邁進する多忙な半人半魔だけど、楽しそうなことはいろいろ削ってでもなんでもやっちゃう！\n\n動画シリーズ詳細：ねんど・レジン・DIY・３Dプリンター等での工作、おいしいご飯やお菓子を作ること・食べること、歌うことなどなど、時間が無い中でも楽しそうなことに全力で挑戦する様子を公開していきます。\n\nカラー：水色・紫・黒などを使用しパステル調でかわいらしいフォントだと嬉しいです。\n日中・太陽・天使等よりかは、月・星・夜・悪魔のイメージですが、全体の色味が暗くなりすぎない方が嬉しいです！\n\nデザイン要素：悪魔らしいモチーフと時間を感じさせるモチーフ(時計など)があると嬉しいです！\n\n【参考資料】\nhttps://drive.google.com/drive/folders/18B5XxsizRV4wv--OhxQlm44zgZyZS2lU?usp=sharing\n\n【使用用途】\n・YouTube・Twitch等の配信、投稿やアイコン・ヘッダー\n・各種SNSでの投稿・アイコン・ヘッダー\n\n◆納品形式\nPSD または透過 PNG 形式での納品を希望いたします。\n\nお忙しいところ恐縮ですが、ご検討のほどよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 379316, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "相原にこ@Osaka Art & Design 参加", "screen_name": "aiharanico", "avatar_url": "https://pbs.twimg.com/profile_images/1296688625577365504/uy0wFOD_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2842586239/1664383897/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 0}, {"id": 1255645, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "注意力が3万", "screen_name": "con30000", "avatar_url": "https://pbs.twimg.com/profile_images/2037555840480419841/cIcdcvFR.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1140216272/1774629880/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 20, "skills": [{"genre": "art"}], "nc": 1}, {"id": 2241725, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "しのぐ", "screen_name": "shinoggs", "avatar_url": "https://pbs.twimg.com/profile_images/1623670059263746048/wvMlGZNG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1542533