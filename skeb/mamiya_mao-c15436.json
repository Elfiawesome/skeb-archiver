=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b6affc444581541dff6fc97313b4e156 2x, https://si.imgix.net/f01a718d/uploads/origins/3d7ce863-266a-4888-b352-b621d55b13d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=780bdd04c1b4fdb04c89397fa91b4272 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f01a718d/uploads/origins/3d7ce863-266a-4888-b352-b621d55b13d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90012f1a5af8890fed2a6ac61e0c8134", "srcset": "https://si.imgix.net/f01a718d/uploads/origins/3d7ce863-266a-4888-b352-b621d55b13d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90012f1a5af8890fed2a6ac61e0c8134, https://si.imgix.net/f01a718d/uploads/origins/3d7ce863-266a-4888-b352-b621d55b13d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3a9f6a435669f14f483de448c38d3e62 2x, https://si.imgix.net/f01a718d/uploads/origins/3d7ce863-266a-4888-b352-b621d55b13d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bfcf6ab3f2ae688cc72c03d3247765fc 3x"}, "body": "初めて依頼させて頂きます。\nスタンドマイクで正面から熱唱する勝気な笑顔の魔宮マオさんをお願いします。\n右手はマイク左手は前に伸ばす形でお願いします。\n上半身だけで大丈夫です。\n衣装はスクール衣装でお願いします。\n全体的に学園祭のライブみたいなイメージを考えています。\n歌枠のサムネ等にも自由に使って頂ければと思います。\nもちろん上記の全てはあくまで理想なのでやりにくい部分は変えて頂いて大丈夫です。\n\nよろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mamiya_mao/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 101410, "client_id": 3031440, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b233b0f/uploads/origins/a65437fe-53b0-4668-94c0-4df03d430ed3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55abd834ce382487f74b9fd827a8c16c", "srcset": "https://si.imgix.net/