な雰囲気のイラストでお願いしたいです！\n\nお手数をお掛けしますが、何卒宜しくお願いいたします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mamiya_mao/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 101410, "client_id": 3140157, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/98faefb0/uploads/origins/a47dc2ed-a8b7-4aec-a2e7-f0f529603382?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c0431f81a8a5aa5785247d287616f77", "srcset": "https://si.imgix.net/98faefb0/uploads/origins/a47dc2ed-a8b7-4aec-a2e7-f0f529603382?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c0431f81a8a5aa5785247d287616f77, https://si.imgix.net/98faefb0/uploads/origins/a47dc2ed-a8b7-4aec-a2e7-f0f529603382?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bcbe20400b32401fdbca9013ee00a2cc 2x, https://si.imgix.net/98faefb0/uploads/origins/a47dc2ed-a8b7-4aec-a2e7-f0f529603382?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e768da9cf42699eb5d50eb4cf638505d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/98faefb0/uploads/origins/a47dc2ed-a8b7-4aec-a2e7-f0f529603382?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ebf067bdf49e5b44e527c327b4eab5af", "srcset": "https://si.imgix.net/98faefb0/uploads/origins/a47dc2ed-a8b7-4aec-a2e7-f0f529603382?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ebf067bdf49e5b44e527c327b4eab5af, https://si.imgix.net/98faefb0/uploads/origins/a47dc2ed-a8b7-4aec-a2e7-f0f529603382?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=588d4271c891d973deeaded3d2885f43 2x, https://si.imgix.net/98faefb0/uploads/origins/a47dc2ed-a8b7-4aec-a2e7-f0f529603382?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&