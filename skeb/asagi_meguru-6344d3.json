ok.com/@tenten_tenya?_r=1&_t=ZS-95kSN1qLkXY\n･男性\n･デフォルトは猫耳無しですが、今回は全て浅葱 めぐる様にお任せ致します！\n･可愛い、少しチャラい雰囲気\n･性格は犬系男子\n（詳細は添付の参考資料URLをご確認ください）\n【構図・イメージ】\n浅葱 めぐる様の得意なタッチで、詰め込みイラスト、または1枚絵をお願いしたいです。表情なども全て浅葱 めぐる様におまかせできると嬉しいです。髪の毛や体の1部が見切れていない構図であると嬉しいです。\n【使用用途】\n岬てんや様ご本人に限り、SNSでの活動報告、動画のサムネイル、配信等、活動全般、商用利用の可能性もございます。\n個人的な観賞用。\n【納品形式】\nもし可能であれば、人物と背景と文字が分かれたデータでいただけますと、活動で使いやすくなるため大変助かります。\n\nお忙しいところ恐縮ですが、ご検討いただけますと幸いです。よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1KWCa87dkGnHvxRCAKgDQP5XeHgCcj9FW", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 2293420, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "PECHANKO🌺", "screen_name": "_VQ_QU_", "avatar_url": "https://pbs.twimg.com/profile_images/2052520707767390208/LvnQc9OY.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1576585425048973313/1759983100/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 2620286, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "いかわさ🦑(チゲ味)", "screen_name": "Midori_annte23", "avatar_url": "https://pbs.twimg.com/profile_images/1772462509385269248/3WO5dS3i.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1288136668696809473/1711452276/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 110, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 2754428, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "WH♢Z/サブ垢", "screen_name": "hyper_whoz", "avatar_url": "https://pbs.twimg.com/p