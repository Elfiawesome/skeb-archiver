23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52b875659ae52b51da8cb856ad21549c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b3654ae/uploads/origins/cc73ee7e-c0a0-4a0c-9815-5433f5bee87e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1f3f50ba15cc19aacbddf78af6da73a", "srcset": "https://si.imgix.net/2b3654ae/uploads/origins/cc73ee7e-c0a0-4a0c-9815-5433f5bee87e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e1f3f50ba15cc19aacbddf78af6da73a, https://si.imgix.net/2b3654ae/uploads/origins/cc73ee7e-c0a0-4a0c-9815-5433f5bee87e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f25f5ca1b24793d1aa5cd8ad1b9fe08e 2x, https://si.imgix.net/2b3654ae/uploads/origins/cc73ee7e-c0a0-4a0c-9815-5433f5bee87e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ba55edef392e84d7b218c5f59c9903cd 3x"}, "body": "誘導されましたので改めてのご連絡失礼いたします。\n秘封オンリー即売会や企画などイベントを主催しております、猫です。\nこの度は、秘封蓮花蝶イラストの掲載企画のお誘いでご連絡をいたしました。\n\n今回秘封蓮花蝶では、12月にウェブでイラスト掲載企画を開催いたします。\n『秘封倶楽部誕生20周年を祝う』をテーマとした作品を募集しております。\n当イベント告知SNSと当イベントウェブサイトで画像が掲載されます。\nまた実際に合同誌を発行し皆様の作品を掲載いたします。発行された後は各地のイベント・同人ショップで頒布いたします。\nこの企画に合う秘封作品をお創り頂きたくお願い申し上げます。\nイラスト作品に指定する仕様は\n・サイズはB5（182×257mm）、縦\n・解像度はカラーの場合350dpi、モノクロの場合600dpi\n・ファイル形式はJPG、PNG、PSDのいずれか\n・CMYK\n・全年齢向け\nでお願いいたします。\nまた\n\nこちらのご確認もお願いいたします。\n\n『秘封倶楽部誕生20周年を祝う』カタチを描いて頂きたく思います。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Harumachine/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 275865, "client_id": 2377598, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de5ba48f/uploads/origins/f97641b3-a86e-4222-94e0-2a04ec8a44c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e857d4f9