ve.google.com/drive/folders/1z-U7R_Adzn7hjvhNbnHRK8Mz0rV-TVNI", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@po_to_pu/works/21", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5abbdf3d/uploads/origins/4f517885-49d3-4316-8fd2-9af56440dce9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2dfd8449b7647839a7ef7684e9393007", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1254371, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@po_to_pu/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1254371, "client_id": 2178819, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ddb32340/uploads/origins/459fc880-8e20-4201-8199-ae761f440ce8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9291c8f8bb886c986190d3c8600c85e8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ddb32340/uploads/origins/459fc880-8e20-4201-8199-ae761f440ce8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=595b285b856100f058ddfb941501e1d6", "src_set": ""}, "body": "ぽとぷさん、初めまして！あなたイラストはとても素敵です!\nよろしければ、私のOCカップルをお願いしたい。\n設定は兄妹だが、女攻めの成分があるので、ご注意してください。\n性転換バージョンもURL内に含まれている、お好きなバージョンをお選びください。\n服装はお任せ致します。\n可能なら詳しい設定はURLの「完全版」でチェックしてください。\n\n金額が足りない場合、再送要請をお願いします。\n\nhttps://drive.google.com/drive/folders/1Ea9ZkRbr2gDfpHT0nD7muO6XFD3Xm2-a?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@po_to_pu/works/19"