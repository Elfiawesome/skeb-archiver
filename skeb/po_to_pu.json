。(※資料が2つあるのですが、ウルフカットの方をお願いしたいです)\n\n基本的に全ておまかせしたいのですが、もし可能であればOCが楽器のベースケース（ドライブ内に資料あります）を後ろに背負っている状態を描いていただけると嬉しいです！\n\n○イラストの使用用途\nSNSのアイコンやヘッダー、他の方への依頼用の資料\n\n依頼内容が金額と見合わない場合や、難しい場合は再送又はキャンセルしていただいて構いません。ご検討いただけますと幸いです。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1-l39qaGVAV67HJKkoZntxbw4om8PYcVD", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@po_to_pu/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ffa99ae9/uploads/origins/6d37fa77-e069-4521-980d-1ebb2755a41d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d480a1cdb5ee3d446d3a010ae4fd3952", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1254371, "client_id": 1244499, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@po_to_pu/works/8", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/86b4dc3d/uploads/origins/196a5c91-b38c-452b-b921-4aab2a0e79a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=94462c4cbeb93102bc997365786880aa", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1254371, "client_id": 1737748, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@po_to_pu/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1254371, "client_id": 2112164, "vtt_url": null, "thumbnail_i