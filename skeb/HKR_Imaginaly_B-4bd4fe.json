のてっぺんから股間までを写したバストアップを、以下のようなシチュエーションでセリフ付きの差分を用意して欲しいです。\n\n1枚目：ニヤけた表情でこちらを煽り、今からオナペットになることを宣言してオナニーを催促してくる。\n\n2枚目：わざとらしく大袈裟なアへ顔と淫語をこれでもかと織り込んだ媚びるような喘ぎ声で射精を催促してくる。\n\n3枚目：射精後。優しい態度で褒めてくれる。\n\nよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1jUv87DsnPJO7pNY_UW8SRfyrto7lmJwm", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@Norio_times/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 407274, "client_id": 372939, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6da1a66a/uploads/origins/628ebeee-a600-431e-a957-8582af0ba61b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=498b6cd66c8a788e83cf02e4064871c3", "srcset": "https://si.imgix.net/6da1a66a/uploads/origins/628ebeee-a600-431e-a957-8582af0ba61b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=498b6cd66c8a788e83cf02e4064871c3, https://si.imgix.net/6da1a66a/uploads/origins/628ebeee-a600-431e-a957-8582af0ba61b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ae164406b6accf8cd1e7ccc187bd942 2x, https://si.imgix.net/6da1a66a/uploads/origins/628ebeee-a600-431e-a957-8582af0ba61b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=28f09f3eed70e33e3ac9dac899112fba 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6da1a66a/uploads/origins/628ebeee-a600-431e-a957-8582af0ba61b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee92c4d1c8ef6863e6209ef5c7120655", "srcset": "https://si.imgix.net/6da1a66a/uploads/origins/628ebeee-a600-431e-a957-8582af0ba61b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ee92c4d1c8ef6863e6209ef5c7120655, https://si.imgix.net/6da1a66a/uploads/origins/628ebeee-a600-431e-a957-8582af0ba61b?bg=%23fff&auto