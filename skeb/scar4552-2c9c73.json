 "creator_acceptable_same_genre": true}, {"path": "/@scar4552/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2618626, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/681c2c35/uploads/origins/b0cd1f21-8ad7-4349-82c5-41a05fc0af5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53ff30af7192f5aff3b63e81a4ccba93", "srcset": "https://si.imgix.net/681c2c35/uploads/origins/b0cd1f21-8ad7-4349-82c5-41a05fc0af5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53ff30af7192f5aff3b63e81a4ccba93, https://si.imgix.net/681c2c35/uploads/origins/b0cd1f21-8ad7-4349-82c5-41a05fc0af5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cae51f8f2bc77afb0ad3c40a89883712 2x, https://si.imgix.net/681c2c35/uploads/origins/b0cd1f21-8ad7-4349-82c5-41a05fc0af5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d312702c45c697b454d29cfb096b8f5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/681c2c35/uploads/origins/b0cd1f21-8ad7-4349-82c5-41a05fc0af5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b96ebf5f58992f012a765c4b42213032", "srcset": "https://si.imgix.net/681c2c35/uploads/origins/b0cd1f21-8ad7-4349-82c5-41a05fc0af5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b96ebf5f58992f012a765c4b42213032, https://si.imgix.net/681c2c35/uploads/origins/b0cd1f21-8ad7-4349-82c5-41a05fc0af5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a2124d9db45d5b47056ae30772659d43 2x, https://si.imgix.net/681c2c35/uploads/origins/b0cd1f21-8ad7-4349-82c5-41a05fc0af5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=144eaf754dfbce4bfecec39436a02eae 3x"}, "body": "Hi.\n\nI would like to request two images of Donna Troy losing to Vega from Street Fighter. References below:\n\nImage 1: Donna is on her knees. She is holding her stomach, which has been slashed badly. She has of other, smaller slashes on her, on one shoulder, on a leg, higher up on her chest. These slashes are each in groups of three, as they have been done with Vega's claw. She is looking up at her tormentor, who is out of shot, but his arm Is visible and his claw is at her throat, and she knows she is defeated.\n\nImage 2: Donna is face down on the floor. Blood is pooling around her throat, which has been slashed. She has loads of slashes over her now. Vega's foot is on the top of her head. If possible, these slashes have torn through her pants, revealing her ass.\n\n\nExtra image references:\n\nhttps://static.wikia.nocookie.net/marvel_dc/images/f/f9/Tales_of_the_Titans_Vol_1_3_Textless.jpg/revision/latest?cb=20230927025656\n\nhttps://upload.wikimedia.org/wikipedia/en/4/45/SSFVega.png\n\nhttps://static.wikia.nocookie.net/marvel_dc/images/f/fc/Titans_2025_Annual_Vol_4_1_Textless_Variant.jpg/revision/latest/scale-to-width-down/1000?cb=20250802003403", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@scar4552/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/9605625b/uploads/origins/4ccb46eb-4694-4f39-a970-2d85b154a3ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5f9e7204c57ef6dac792c50d2e70ef3c", "srcset": "https://si.imgix.net/9605625b/uploads/origins/4ccb46eb-4694-4f39-a970-2d85b154a3ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5f9e7204c57ef6dac792c50d2e70ef3c, https://si.imgix.net/9605625b/uploads/origins/4ccb46eb-4694-4f39-a970-2d85b154a3ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2