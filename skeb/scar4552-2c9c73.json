 true}, {"path": "/@scar4552/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2618626, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/165cbd66/uploads/origins/792f9146-edd7-42b8-9a2d-ae38574a275b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d81679388464379ac6c20235d516b15", "srcset": "https://si.imgix.net/165cbd66/uploads/origins/792f9146-edd7-42b8-9a2d-ae38574a275b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d81679388464379ac6c20235d516b15, https://si.imgix.net/165cbd66/uploads/origins/792f9146-edd7-42b8-9a2d-ae38574a275b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=35feaf773fc3327d7588995b91b80499 2x, https://si.imgix.net/165cbd66/uploads/origins/792f9146-edd7-42b8-9a2d-ae38574a275b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=57e13175896bd146ded343c7992fb2ff 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/165cbd66/uploads/origins/792f9146-edd7-42b8-9a2d-ae38574a275b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc98882fa6967e74f888df4381ca0824", "srcset": "https://si.imgix.net/165cbd66/uploads/origins/792f9146-edd7-42b8-9a2d-ae38574a275b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bc98882fa6967e74f888df4381ca0824, https://si.imgix.net/165cbd66/uploads/origins/792f9146-edd7-42b8-9a2d-ae38574a275b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e3b90d3920835b947b94094bc54d73ae 2x, https://si.imgix.net/165cbd66/uploads/origins/792f9146-edd7-42b8-9a2d-ae38574a275b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=536f1cf3012e31ea43bc513450f9a948 3x"}, "body": "Hello!\n\nI love how detailed your works are in showing the violence of naval battles on a shipgirl! \n\nThe character I'd like to request is Azur Lane's Zuikaku. She is sent alone as a distraction against countless enemy aircraft. All her aircraft are deployed and shot down, and she heroically evades attacks but is easily overwhelmed. She faces death heroically and is mercilessly bombed, hit with rockets and strafed until only one of her breasts remain on water among the entrails.\n\nIf possible, please show her floating in water, naked, all limbs dismembered and waiting helplessly for the end before she is thoroughly destroyed. \n\nI enjoy your creativity in body damage, so I will leave the details of violence to you. I only ask that Zuikaku's head to be one of the last things to explode so she can make more expressions of pain until she dies.", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@scar4552/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/11ffedda/uploads/origins/c0785c64-5ad9-4d8a-9a76-13b72e061858?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f2e1f8d59698fda0649b7f5c5392efc8", "srcset": "https://si.imgix.net/11ffedda/uploads/origins/c0785c64-5ad9-4d8a-9a76-13b72e061858?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f2e1f8d59698fda0649b7f5c5392efc8, https://si.imgix.net/11ffedda/uploads/origins/c0785c64-5ad9-4d8a-9a76-13b72e061858?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ccdb8f95b1b36a18ff1ea7ca4024ae83 2x, https://si.imgix.net/11ffedda/uploads/origins/c0785c64-5ad9-4d8a-9a76-13b72e061858?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txts