c967a993d5a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84292b3596a2ae231f68c75ab1976ff4, https://si.imgix.net/3828c48c/uploads/origins/03b65d59-5e65-444d-bbed-c967a993d5a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0c752716a60569189ebd9d6347d39174 2x, https://si.imgix.net/3828c48c/uploads/origins/03b65d59-5e65-444d-bbed-c967a993d5a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=de1aa09461297f598c913d2c2173e2e1 3x"}, "body": "かこちゃん様、先程は失礼致しました。\n改めましてリクエストさせていただきます。\nいつもイラストを拝見しております！\n以前、ヒトモシとチラチーノのイラストのリクエストをした者です。\nかこちゃん様のとても可愛らしい絵柄が大好きでskebをやっていることに気づいて嬉しくてリクエストしてしまいました！\n是非私と相方の夫婦OCを描いていただきたくリクエストさせていただきました。\nこちらの夫婦OCはTRPGで使用してる探索者です。\n\n\n▶簡単なパーソナルデータ\n1人目 : 夏子(カコ)\n女性/164cm\n大人しく物静かな印象の美人、冷静で仕事ができる。綺麗好き。\n花に触れている時や一樹と居るときは表情が柔らかくなり、ふわりと微笑むことがある。\n\n2人目 : 一樹(カズキ)\n男性/174cm\n夏子の1歳下の後輩。片眼隠れ。落ち着いた雰囲気の男性で、物腰柔らかい。\n例えるなら大型犬。愛情深く（夏子への）独占欲や（夏子に近付く男に対する）嫉妬心をよく抱く。\n\n▶用途（いずれも個人利用の範囲内におさめます）\n・対象キャラクターを登場させるTRPGセッションでの活用（立ち絵、スチルなど）\n・アクリルスタンドやカレンダーなどグッズ制作用データとしての活用\n・SNSへの納品報告およびアイコンやヘッダーへの活用\n※上記用途については、相方にも同様の許可を頂ければと思います。\n\n▶資料\nhttps://drive.google.com/drive/folders/1WbLzZqsMvuHbEKYL7MI_g2A5CKE_dVR8?usp=sharing\n\n人物画(ミニキャラでも可)のふたりが資料の中にあるたぬき(一樹)＆きつね(夏子)と仲良くしているイラストを希望します。\nもし人物画が難しければ、たぬき＆きつね化しているふたりのイラストのみでも構いません！お好きなように描いていただけますと幸いです。お任せします！\nもし可能でしたら人物と背景をレイヤーで分けられるよう(PSD希望)にしていただきたいです。\n\nかこちゃん様のかわいいケモイラストが大好きです！これからも応援しています。\n最後になりますが、ご縁がありますと幸いです。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kako_xox/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3419068, "client_id": 3378621, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89aae7b8/uploads/origins/82d5ebd8-4d74-4315-9af7-e83121c902c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1b486ccb57825b4c5410d0c37c7d196", 