5-78f86761256a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b372aa696faabfa50d2accd058250ee, https://si.imgix.net/127b38b7/uploads/origins/c68c914e-2b69-44e5-a435-78f86761256a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3bdeef43560fa3e406820c621ba8b3cd 2x, https://si.imgix.net/127b38b7/uploads/origins/c68c914e-2b69-44e5-a435-78f86761256a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3a7355f712d5ef6affa4bbb9ade10411 3x"}, "body": "タキノセ様初めまして。\nSpoonというアプリで配信を予定しているSonoと申します。\nタキノセ様の素敵な絵を拝見し、是非イラスト作成をして頂きたいと思い依頼いたしました。\n\n依頼内容は以下のようになっております。\n\n【用途】\nxやSpoonのアイコン、配信中の背景画像\n\n【人物の大きさ】\nバストアップ\n\n【髪の毛】\n耳にかけている切りっぱなしの短めボブ、青に近い黒髪\n\n【見た目】\n猫目の切れ長、三白眼気味、瞳は青色、頬にほくろ\n\n【服装】\nおまかせ\n\n【ポーズ】\n上から撮られている、上目遣い\n\n【背景】\n暗めのグラデーション\n\n【サイズ】\nおまかせ\n\n【参考画像】\nhttps://pin.it/Aytrydcw5\n\n以上の内容でご検討よろしくお願いいたします。\n\nhttps://pin.it/Aytrydcw5", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takinose_015/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1867488, "client_id": 2746168, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1915a1b3/uploads/origins/b3518293-50b6-456d-ba73-6dc556bfe45c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aae2b0e61f28bd6e4507745eeaaaa974", "srcset": "https://si.imgix.net/1915a1b3/uploads/origins/b3518293-50b6-456d-ba73-6dc556bfe45c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aae2b0e61f28bd6e4507745eeaaaa974, https://si.imgix.net/1915a1b3/uploads/origins/b3518293-50b6-456d-ba73-6dc556bfe45c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e95434d92aced2ea1e3e8faff0564ce7 2x, https://si.imgix.net/1915a1b3/uploads/origins/b3518293-50b6-456d-ba73-6dc556bfe45c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6ea4ef3b4c45771535d7c024c93334dd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1915a1b3/uploads/origins/b3518293-50b6-456d-ba73-6dc556bfe45c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c627691a99c1808c4bc479346298b04", "srcset": "https://si.imgix.net/1915a1b3/uploads/origins/b3518293-50b6-456d-ba73-6dc556bfe45c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c627691a99c1808c4bc479346298b04, https://si.imgix.net/1915a1b3/uploads/origins/b3518293-50b6-456d-ba73-6dc556bfe45c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b042f62b88752685fb40a5a51405efc5 2x, https://si.imgix.net/1915a1b3/uploads/origins/b3518293-50b6-456d-ba73-6dc556bfe45c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4bc98cbcd6dc78bed0cee07f93e5a8c6 3x"}, "body": "初めまして、タキノセ様。\nボイス投稿者のイルと申します。\nタキノセ様のイラストを拝見し、ぜひ描いて頂きたく、依頼させて頂きました。\n\n【サイズ（出来れば）】\n１６：９　\n1280×720ピクセル以上\nJPEG形式\n\n【モチーフの花】\n赤いツバキ（和風）\n\n【見た目】\n黒髪ロング、切れ長の赤い眼\n\n【表情】\n妖艶な微笑み\n\n【服装】\n着物姿\n\n【ポーズ】\nおまかせ\n\n【使用用途】\nYouTubeのサムネイル、Xのアイコン\n\n以上になります。\nお忙しいところ恐縮ですが、どうかよろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takinose_015/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1867488, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/73671b8e/uploads/origins/ae3b38f0-6bf3-4fcf-8e81-dd4d8409cbd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec1087309209acbde0df41cc2afa8ec2", "srcset": "https://si.imgix.net/73671b8e/uploads/origins/ae3b38f0-6bf3-4fcf-8e81-dd4d8409cbd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec1087309209acbde0df41cc2afa8ec2, https://si.imgix.net/73671b8e/uploads/origins/ae3b38f0-6bf3-4fcf-8e81-dd4d8409cbd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=697b20b39e91009c5c0bdcbcff8532a2 2x, https://si.imgix.net/73671b8e/uploads/origins/ae3b38f0-6bf3-4fcf-8e81-dd4d8409cbd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6dd900bdcfc38c798a67c3c2c2e601f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/73671b8e/uploads/origins/ae3b38f0-6bf3-4fcf-8e81-dd4d8409cbd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2fee052cf3ba4e0ed04f06275dbaaa2f", "srcset": "https://si.imgix.net/73671b8e/uploads/origins/ae3b38f0-6bf3-4fcf-8e81-dd4d8409cbd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2fee052cf3ba4e0ed04f06275dbaaa2f, https://si.imgix.net/73671b8e/uploads/origins/ae3b38f0-6bf3-4fcf-8e81-dd4d8409cbd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8707083c5d0c27891628169e4cf5a637 2x, https://si.imgix.net/73671b8e/uploads/origins/ae3b38f0-6bf3-4fcf-8e81-dd4d8409cbd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a920dd88bde92cbb9e689664ce032473 3x"}, "body": "はじめまして。\nお忙しいところ申し訳ございません。\nタキノセさんのイラストが気に入り\n大好きな夜の配信者にプレゼントさせて\nもらいたくお願いさせてください\n\n髪色、目、服装などは全ておまかせで\nかっこいい感じでお願いしたいです\nタバコ、ネックレスをつけてくれると\n嬉しいです\n\nご検討宜しくお願い致します！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takinose_015/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1867488, "client_id": 2185114, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97a255f8/uploads/origins/ecf92520-cc03-43c1-a7f0-b1f08d1ce060?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d3bf0e036756444610521946e012cba", "srcset": "https://si.imgix.net/97a255f8/uploads/origins/ecf92520-cc03-43c1-a7f0-b1f08d1ce060?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d3bf0e036756444610521946e012cba, https://si.imgix.net/97a255f8/uploads/origins/ecf92520-cc03-43c1-a7f0-b1f08d1ce060?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45215dbaf1c0ee1c8998e7310e99680e 2x, https://si.imgix.net/97a255f8/uploads/origins/ecf92520-cc03-43c1-a7f0-b1f08d1ce060?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=09741b2857fcedc32c798ddddedc3a35 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97a255f8/uploads/origins/ecf92520-cc03-43c1-a7f0-b1f08d1ce060?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4fe2609168f9beca9917c1d00973b32e", "srcset": "https://si.imgix.net/97a255f8/uploads/origins/ecf92520-cc03-43c1-a7f0-b1f08d1ce060?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4fe2609168f9beca9917c1d00973b32e, https://si.imgix.net/97a255f8/uploads/origins/ecf92520-cc03-43c1-a7f0-b1f08d1ce060?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab90706739fc4b66b50bddd3482c4fa3 2x, https://si.imgix.net/97a255f8/uploads/origins/ecf92520-cc03-43c1-a7f0-b1f08d1ce060?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c7b61a32326a15ac7b3223b165155679 3x"}, "body": "はじめまして、613(muimi)と申します。\nかわいらしいイラストを拝見し、ぜひご依頼させていただきたく失礼致します……！\n\n自創作のうちの子「くろの」をお願いしたいです。\n【資料】URLの27枚目「七種くろの」とあるほうの右側立ち絵のほう\n\n少し特殊なご依頼なのですが、タキノセ様の目元の描き方がとても好きなので、目元にクローズアップしたイラストをお願いしたいです。\n顔まわり～目元のアップで大丈夫なので、目元でぐっと惹きこむようなイラストでお願いできませんでしょうか……！\nご要望については、よそのイラストで恐縮ですがこちら(https://twitter.com/granbluefantasy/status/1629058824836644865)のようなイメージで\n・少し目を見開き気味でこちらを覗き込むような表情\n・白目の球体感があるような感じ\n・虹彩の放射状のすじの描写がある（描写の仕方や程度はお任せ）\n・できれば、目(瞼)の輪郭がなるべく繋がっていて目尻や目頭がわかるような感じ\n・瞼や涙袋、睫毛の描き方はタキノセ様の普段描かれているような感じ\nでお願いしたいです……！\nまた、「くろの」は自創作における女神のような存在で、並行世界の未来をすべて見渡すなどの強力な時の魔法を使うキャラクターです。\n力を行使するときに「左目(オレンジ色のほう)に文字盤模様が浮かぶ」特徴があるので、ぜひその様子をイラストにして頂きたいです……！\n文字盤模様のデザインはお任せしますが、資料にもあるようにローマ数字が書いてあるようなイメージです。\n\nもしよろしければ、ご検討いただけると幸いです。\nよろしくお願いいたします！\n\nhttps://www.pixiv.net/artworks/84561489", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takinose_015/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1867488, "client_id": 1384181, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d409e29/uploads/origins/200a0fc0-7b58-4164-babd-04cac1e156f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=544c482a14d0cf5b42a5f22ac0e7a0b8", "srcset": "https://si.imgix.net/0d409e29/uploads/origins/200a0fc0-7b58-4164-babd-04cac1e156f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=544c482a14d0cf5b42a5f22ac0e7a0b8, https://si.imgix.net/0d409e29/uploads/origins/200a0fc0-7b58-4164-babd-04cac1e156f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60c59005f0fa65d0caec9bb5cd7c2205 2x, https://si.imgix.net/0d409e29/uploads/origins/200a0fc0-7b58-4164-babd-04cac1e156f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3231ac4d373a795146491154ebe6d4ed 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d409e29/uploads/origins/200a0fc0-7b58-4164-babd-04cac1e156f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d44e9fa461427f002c48ac561eecb8f9", "srcset": "https://si.imgix.net/0d409e29/uploads/origins/200a0fc0-7b58-4164-babd-04cac1e156f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d44e9fa461427f002c48ac561eecb8f9, https://si.imgix.net/0d409e29/uploads/origins/200a0fc0-7b58-4164-babd-04cac1e156f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop