8f2-fce6666e2430?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2f0743ccd6965d1eb6292508f943deef 2x, https://si.imgix.net/f3fce8f2/uploads/origins/8eca0413-0559-49e1-98f2-fce6666e2430?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3f4a9ffb84d6798e011a35428dfdd969 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f3fce8f2/uploads/origins/8eca0413-0559-49e1-98f2-fce6666e2430?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8723b71bf79e2c43fb72a5d7df270c17", "srcset": "https://si.imgix.net/f3fce8f2/uploads/origins/8eca0413-0559-49e1-98f2-fce6666e2430?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8723b71bf79e2c43fb72a5d7df270c17, https://si.imgix.net/f3fce8f2/uploads/origins/8eca0413-0559-49e1-98f2-fce6666e2430?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ed4685b0a366fe427e6c662cd8113115 2x, https://si.imgix.net/f3fce8f2/uploads/origins/8eca0413-0559-49e1-98f2-fce6666e2430?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0629d70ee16c31c4a03e1b2cae3f93bb 3x"}, "body": "お世話になっております、藍染アメリです。\nいつも本当に素敵なイラストを有難うございます！\nまたリクエストさせて頂きたくお送りしました。\n\n前回同様、個人Vtuber「藍染アメリ」のキャラクターイラストをお願いいたします。\n\n＜キャラ基本情報・資料＞\n\n立ち絵（固定ツイ）\nhttps://x.com/aizomeameri105\n動いた様子（お披露目時の配信になります）\nhttps://www.youtube.com/watch?v=tcYhQ7NVUZc\n\n★性格・特徴\n・メイン衣装はオオルリアゲハをモチーフにした衣装を着ています。\n・声は穏やかなタイプですが、性格は負けず嫌いで脳筋。\n\n＜キャラ資料補足＞\n後ろの髪型はハーフアップに大きな蝶風のリボンがついているイメージです。\nパピヨン（犬）の耳をモチーフにしているので、蝶型ですが周りが少しギザギザしてます。\n腰付近に大きめのリボンがついています。\n\n-----------------------------------------------------------------\n\n＜お願いしたい内容＞\n\n★表情\nさくらぎちりこ様にお任せ\n\n★ポーズや構図\n手にプロコンを持って座ってゲームをしている様子をお願いします。\n←向きの顔と←寄りの目線でお願いしたいです。\n※イメージとしては、プレイしているゲーム画面の方を見ている感じです。\n\nもし正面ポーズがいいなという場合は、上記特に気にせず描いて頂けたらなと思います。\n\n\n＜参考資料＞\nプロコン\nhttps://shop.hikaritv.net/shopping/commodity/plala/2010014576/\n\n上記参考資料を元に、藍染アメリのモチーフを取り入れたデザインや色にアレンジして頂けると嬉しいです。\n\n\n＜その他衣装について＞\n衣装はルームウェアをお願いしたいと思っています。\nカーディガンもしくはパーカーにキャミソール＋ショートパンツセットで\n足元はスリッパを履かせてもらえると嬉しいです。\nルームウェアに合わせて調整頂きたいので、髪型はさくらぎちりこ様のセンスにお任せいたします。\n（胸の露出はやや控えめに、お腹は見えないタイプのデザインでお願いします）\n\n★参考資料\nhttps://jp.pinterest.com/pin/7951736837191048/\nhttps://jp.pinterest.com/pin/9781324183402388/\nhttps://www.minana-jp.com/products/detail/235877\n\n＜描画範囲＞\n可能であれば全身でお願いしたいのですが、\n作業負担的に難しそうであれば膝上くらいまであると嬉しいです。\n（その際は足元のスリッパ等はスルー頂いて大丈夫です～！）\n\n※youtubeのサムネに使用したい為、サイズ調整で縮小する際に使いやすいというのが大きな理由となります。その他キャラの上（頭部分）と左右（肩や衣装など）が見切れないよう描いて頂けると助かります。\n\n＜サイズ＞\nさくらぎちりこ様の他作品と同じでお願いできればと思います。\n\n-----------------------------------------------------------------\n＜その他＞\n\n★使用用途\n・個人で活動する上でSNSやyoutubeでのサムネ・アイコン・ヘッダーなどで使用致します。\n・ネットプリントを利用し、ファンの方へイラストをプレゼントする場合がございます。\n\n\n★データについては、背景があれば背景とキャラレイヤー・サインを分けてご準備頂けますと幸いです。\n\nそれではご検討のほどよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@cherrrry_treee/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2293978, "client_id": 1249073, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1611cdf1/uploads/origins/389c9764-97c1-40f6-bb73-37e81b75c2a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3fcd7ba812af0dc58b86c7f1c7eb8bc", "srcset": "https://si.imgix.net/1611cdf1/uploads/origins/389c9764-97c1-40f6-bb73-37e81b75c2a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3fcd7ba812af0dc58b86c7f1c7eb8bc, https://si.imgix.net/1611cdf1/uploads/origins/389c9764-97c1-40f6-bb73-37e81b75c2a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d78c7c22556cf18084793e20c2bfada 2x, https://si.imgix.net/1611cdf1/uploads/origins/389c9764-97c1-40f6-bb73-37e81b75c2a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7567b2c2cd1ed7636edf5