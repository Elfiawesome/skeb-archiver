隅から隅まで大好きが詰まっていて、大切に何度も見返しております。\n\nもしよろしければ、前回と同じキャラクターをリクエストさせていただけないでしょうか。\n甘めのイチャ…とした雰囲気で、可能であれば資料フォルダ内のスーツで描いていただけると大変嬉しいです！\nその他、イラストの形式等はカマ様の描きやすいものでお任せとさせていただきたいです。\n\n＊攻め→赤髪ポニテ\n・182cm / 30歳 / 職業：刑事\n・堅物、忠犬タイプ。受けに翻弄されがち\n\n＊受け→金髪、眼鏡\n・175cm / 32歳 / 職業：刑事\n・プライドエベレストの女狐、高笑いが似合うタイプ\n\nお忙しいところ恐縮ではございますが、ご検討いただけましたら幸いです。\n\nhttps://drive.google.com/drive/folders/1ZbttebDe-9gV0Nn07MCOJSAgRgIZ6p5m?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ok_Ma3/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 5480, "client_id": 2843600, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/509318fe/uploads/origins/f109e7fb-27c8-44a1-9d60-14e537bd8f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6344435675160ce6e173ad326e510ba0", "srcset": "https://si.imgix.net/509318fe/uploads/origins/f109e7fb-27c8-44a1-9d60-14e537bd8f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6344435675160ce6e173ad326e510ba0, https://si.imgix.net/509318fe/uploads/origins/f109e7fb-27c8-44a1-9d60-14e537bd8f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=562a3405ccc3e9e401d1b63da18fef52 2x, https://si.imgix.net/509318fe/uploads/origins/f109e7fb-27c8-44a1-9d60-14e537bd8f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=055229240557e0d846e1ef1a75b6734f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/509318fe/uploads/origins/f109e7fb-27c8-44a1-9d60-14e537bd8f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e4a7e3ed60baaf19a217269197c7fdd", "srcset": "https://si.imgix.net/509318fe/uploads/origins/f109e7fb-27c8-44a1-9d60-14e537bd8f8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e4a7e3ed60baaf19a2