compress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eac8519454e5cb5931e2925c0e1f1df5", "srcset": "https://si.imgix.net/d3c149cf/uploads/origins/3a00cc8d-a60d-4e8a-adc8-6669f3fda6da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eac8519454e5cb5931e2925c0e1f1df5, https://si.imgix.net/d3c149cf/uploads/origins/3a00cc8d-a60d-4e8a-adc8-6669f3fda6da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f918deabd9bc082cb3d88fdf9f949c37 2x, https://si.imgix.net/d3c149cf/uploads/origins/3a00cc8d-a60d-4e8a-adc8-6669f3fda6da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7b36fc8baa0c470d53a4a3272422f457 3x"}, "body": "シラノさん、こんにちは \n海外から失礼します。\nシラノ先生の素敵なイラストいつも拝見させていただいております。 \n今回、新しいオリジナルキャラクターのイラストをかいていただきたくリクエストさせていただきました🙇🏻‍♀️\n キャラクターの詳細は以下にまとめています。 \n\n ·外見は、身長は176cmです。 黒髪で羊毛のようなくるんとした巻き髪、緑色の瞳・涙ぼくろ・たれ目・黒縁メガネが特徴でございます。 \n\n·性格は穏やかで優しく、小さなお子さまにも好かれるタイプです。祖父の古本屋を手伝っており、出来立ての温かいおにぎりが好きで、好きな動物は亀です。 \n【使用用途】\n · 個人鑑賞\n ·第三者へ依頼を行う際の資料としての提示 \n—\n お忙しい中お目通しいただきましてありがとうございます。\n ご縁がありましたら幸いです。何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Bfbu-XpYaLdp_XrZkXCeq_wywfDmA3Xq", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shirano_info/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3172679, "client_id": 2062115, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ac98b36/uploads/origins/4a68be56-11fa-4427-9ea5-9be9a05ef9ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1d05c79a6ab38ac2d83df57c9521199", "srcset": "https://si.imgix.net/8ac98b36/uploads/origins/4a68be56-11fa-4427-9ea5-9be9a05ef9ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b1d05c79a6ab38ac2d83df57c9521199, https://si.imgix.net/8ac98b36/uploads/origins/4a68be56-11fa-4427-9ea5-9be9a05ef9ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f93bfc1e7d622bfcf66a34ae674ad121 2x, https://si.imgix.net/8ac98b36/uploads/origins/4a68be56-11fa-4427-9ea5-9be9a05ef9ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66386b528c2cfa6ac2b9293a8c662702 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ac98b36/uploads/origins/4a68be56-11fa-4427-9ea5-9be9a05ef9ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1db21af43c66fce13585b62c5f71249d", "srcset": "https://si.imgix.net/8ac98b36/uploads/origins/4a68be56-11fa-4427-9ea5-9be9a05ef9ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1db21af43c66fce13585b62c5f71249d, https://si.imgix.net/8ac98b36/uploads/origins/4a68be56-11fa-4427-9ea5-9be9a05ef9ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c0879e98ccf169120bacf695ca083612 2x, https://si.imgix.net/8ac98b36/uploads/origins/4a68be56-11fa-4427-9ea5-9be9a05ef9ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=169d9884eedd9dc9e44f9a9d9b502ac4 3x"}, "body": "またお会いできて嬉しいです！前回は素晴らしい作品をありがとうございました！\nもし興味があれば、私のオリジナルキャラクターの新しいアートワークをお願いしたいです。\n彼女はオリジナルのウマ娘で、何でも分かち合おうとしますが、時には過激になりすぎることもあります。\nこの衣装のデザインは「幸福な王子」、ディオニュソス、タロットのカップの6をイメージしています。\n自由に描いてください！ありがとうございました！\n\nhttps://drive.google.com/file/d/16IG7m7h3xzrayHCN_i6BNbylHZGek5uE/view?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shirano_info/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3172679, "client_id": 3527605, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/70e4ddd6/uploads/origins/5505551e-0bff-458d-b1dc-70cdf1029791?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=760bb862a