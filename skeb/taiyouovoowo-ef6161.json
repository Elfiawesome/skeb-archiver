\n青髪の男性は24歳の刑事で、真面目で堅物な性格をしています。\n感情をあまり表に出さず、相棒のやり方を気に入らないと思うことも多いです。\n一方、茶髪の男性も24歳の刑事で、気分屋で少し短気なところがあります。\n先のことをあまり考えずに行動してしまうタイプです。\n二人は性格が正反対でよく衝突しますが、最終的にはお互いを信頼し、支え合っている関係です。\n\n服装は参考URLに添付した画像のものをご参考にしていただければ幸いです。\n構図は日常のワンシーンのような雰囲気で描いていただけると嬉しいです。\nもし可能でしたら、全体的な構図やポーズなどは先生様にお任せしたいです。\n\n作品は個人的な壁紙として使用させていただきたいと考えております。\n\n長文を最後までお読みいただき、誠にありがとうございました。\nご検討のほど、どうぞよろしくお願いいたします🥺\n\nhttps://drive.google.com/drive/folders/1Ysc0MmqkNS_cX15oR7wj8gJPgwp5FZRO", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@sobakonattou07/works/1042", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1057632, "client_id": 3798341, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/de68f90d/uploads/origins/fda9e7ac-7586-4fc4-8226-8db802380c09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dc943d926732526a196aeb201b11edd", "srcset": "https://si.imgix.net/de68f90d/uploads/origins/fda9e7ac-7586-4fc4-8226-8db802380c09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6dc943d926732526a196aeb201b11edd, https://si.imgix.net/de68f90d/uploads/origins/fda9e7ac-7586-4fc4-8226-8db802380c09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f90650fd14a4be4fed98afc48ff199d4 2x, https://si.imgix.net/de68f90d/uploads/origins/fda9e7ac-7586-4fc4-8226-8db802380c09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e800fb17b0bee4e898906a0091270889 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/de68f90d/uploads/origins/fda9e7ac-7586-4fc4-8226-8db802380c09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb287e443de6efccee98e1bbc0141db7", "srcset": "https://si.imgix.net/de68f90d/uploads/origins/fda9e7ac-7586-4fc4-8226-8db802380c09?bg=%23fff&auto=format%