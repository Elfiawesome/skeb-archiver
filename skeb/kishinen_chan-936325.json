3fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27f31bb02ab1dd57c01b5243c1ea0118, https://si.imgix.net/fb3f0e5e/uploads/origins/4a3f3869-9b8c-46d2-aa7f-e9b268bbacc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=178e609cdede660ccab39bc414602b4b 2x, https://si.imgix.net/fb3f0e5e/uploads/origins/4a3f3869-9b8c-46d2-aa7f-e9b268bbacc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a043fbd31a6d92cd582d94ce99de2957 3x"}, "body": "初めまして、いつもきねしんさんのかわいらしく素敵なイラストに癒されております。\nアークナイツのカニパラートとマゼランのイラストを依頼させていただきます。\nそれぞれデフォルト衣装の状態で、急にマゼランに尻尾を抱きしめるようにもふもふされて少しビックリするカニパラートといったシチュエーションでお願いしたいです。\nカニパラートはできればフードを被ったままの状態でお願いします。\nおまかせになってしまう部分が多くて申し訳ないのですが、良ければお受けいただければと思います。\n以上です。これからもきねしんさんの素敵なイラストを楽しみにしています。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kishinen_chan/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2910851, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c75df500/uploads/origins/0f4b8ac4-a45f-43ec-99c8-e2d144c2dfc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0970cb9c4b70b5f1fcfc5b52485bff3b", "srcset": "https://si.imgix.net/c75df500/uploads/origins/0f4b8ac4-a45f-43ec-99c8-e2d144c2dfc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0970cb9c4b70b5f1fcfc5b52485bff3b, https://si.imgix.net/c75df500/uploads/origins/0f4b8ac4-a45f-43ec-99c8-e2d144c2dfc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c05e0cf5eecb14293d20dc02d68026f9 2x, https://si.imgix.net/c75df500/uploads/origins/0f4b8ac4-a45f-43ec-99c8-e2d144c2dfc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e589fe790615ece39998742bc523275 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.im