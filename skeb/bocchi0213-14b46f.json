927-2a7a-4e23-945f-8fb41236d121?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ceca918498c506f4607289710392c0a4, https://si.imgix.net/aa3a5949/uploads/origins/b8966927-2a7a-4e23-945f-8fb41236d121?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=acdd3a6a6d8a1b016932fd198958aeb5 2x, https://si.imgix.net/aa3a5949/uploads/origins/b8966927-2a7a-4e23-945f-8fb41236d121?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=184f41ca25a879634c46be1a70463584 3x"}, "body": "初めまして。\nドレス姿のタクトちゃんのイラストを拝見しました。ぜひリクエストの検討をお願いします。\n\nワンピースまたはサマードレスを着たデアリングタクト（ウマ娘）のイラストをお願いします。\n構図や衣装デザインは好きに描いて頂いて構いません。\n\n以上、よろしくお願い申し上げます。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bocchi0213/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2534931, "client_id": 769953, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e3203244/uploads/origins/77ffba60-5264-444e-99f5-bc4139d39234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5ca3a08b07fa1e95d8c64eb8c20cee1", "srcset": "https://si.imgix.net/e3203244/uploads/origins/77ffba60-5264-444e-99f5-bc4139d39234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5ca3a08b07fa1e95d8c64eb8c20cee1, https://si.imgix.net/e3203244/uploads/origins/77ffba60-5264-444e-99f5-bc4139d39234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d90e75d511f4c07bd71fe71f05c06a63 2x, https://si.imgix.net/e3203244/uploads/origins/77ffba60-5264-444e-99f5-bc4139d39234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c150fa5fd21e07ecf2172b2743c0399 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e3203244/uploads/origins/77ffba60-5264-444e-99f5-bc4139d39234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc96630833869731fff16c60aad8beb6", "srcset": "https://si.imgix.net/e3203244/uploads/origins/77ffba60-5264-444e-99f5-bc4139d39234?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cc96630833869731fff16c60aad8beb6, https://si.imgix.net/e3203244/uploads/origins/77ffba60-5264-444e-99f5-bc4139d39234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f5a4d071d807e70e27ca299e03391995 2x, https://si.imgix.net/e3203244/uploads/origins/77ffba60-5264-444e-99f5-bc4139d39234?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0b44bbc1ff26a2b0e080768027436160 3x"}, "body": "ぼっちぃ様、リクエスト失礼します。\nアピール文と記載されたリンク先、拝見させて頂きました…！\nもしよろしければ描いて頂きたいと思い、リクエストを送らせて頂きました。\n\n募集時の通り「綺麗なロングヘアのデュラハンの女の子」という内容です。\n以下詳細を記しておりますので、内容ご確認の上でご検討・ご対応頂ければ幸いです。\n色んなクリエイターの方の発想力・想像力・創作力にお任せしたいので、詳細文のほとんどは他の方と同じ内容になっております。その点ご容赦くださいませ。\n\n【詳細】\n・髪の長さは頭３つ分かそれ以上の長さが好ましいです。綺麗で長い髪を表現して頂きたいためご負担がかかると思いますが宜しくお願いします。\n\n・ヘアアレンジに関しては、お団子やシニヨンなどといったまとめ髪は避けてください。\n　髪の長さが分かる状態で一部分や全体を結ぶ・巻く・編み込むなどのアレンジはお好みで描いて下さい。\n\n・服装に関してはキャラに合うと思った衣装をお好みで着せてあげてください。\n\n・首の表現に関しては\n　①肌色で塗る\n　②タートルネックのような首元が隠れる・襟のある服装で見えなくする\n　③アクセサリーやチョーカー等による着飾りで隠す\n　などの方法を用いたマイルドな表現をお願いします。別アイデアでも構いません。\n　ただし、性的表現や猟奇的表現・「首から炎や煙が出ている」という表現は避けてください。\n\n・分離した頭や首の扱いについて\n　過去に私がリクエストして描いて頂いた作品やSkebの該当キーワードの検索のURLを記載するので、そちらを参考にして頂くか、「こういうのもアリでは…？」と思えばそちらでも構いません。お好みで構図を決めてください。\n　首部分に関しては頭側と体側に半々に分かれるように描かれていると嬉しいです。\n\n・可能であれば書いて頂いた際の没ラフやおまけを添えて頂けたり、創作時のコンセプト等を描いて頂けると嬉しいです！\n　表情やポーズなどの差分に関してはあればあるほど嬉しいですが、その分負担になると思いますのでご判断お任せします。\n\n・納品はPSDファイルでの納品をお願いします。\n　差分などはファイル内に同梱して頂けると幸いです。\n\n・ご不明点等があった際はお好みで判断して描いて下さい。\n\n長文になりましたが、内容以上になります。ご検討くださいませ。\n\nhttps://skeb.jp/search?q=%22%E3%83%87%E3%83%A5%E3%83%A9%E3%83%8F%E3%83%B3%22&t=works&menu=1&artwork=1", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creat