g=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f616500825b443cc13553f59b86e38d, https://si.imgix.net/896481c5/uploads/origins/bbdeb2c6-e4e7-41b2-b115-83579ceebf9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b986a67479a5dbde20cf0c2ed59b649f 2x, https://si.imgix.net/896481c5/uploads/origins/bbdeb2c6-e4e7-41b2-b115-83579ceebf9a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=31efc067c2e28d84ff8f9390643c551e 3x"}, "body": "Hokanさん、\nはじめまして！Hokanさんの絵が好きですので、絵を描いてもらってもいいですか？\n御子神シズクというアイドルの衣装を着ている土居球子を描いてもらいたいと思います。\nポーズを角の手振りにしたら嬉しいです！\n衣装とポーズの参考イメージを用意しましたので、是非ご覧ください。(https://imgbox.com/g/jI1JdF7ZMy)\n最後まで読んでくださってありがとうございました！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HOKAN_YP/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1791947, "client_id": 3541476, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/27f858b9/uploads/origins/c5058a83-5eb8-4e04-9e7b-77f09ab41409?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18f52b5c82b58b6d11b7929d073d77b9", "srcset": "https://si.imgix.net/27f858b9/uploads/origins/c5058a83-5eb8-4e04-9e7b-77f09ab41409?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=18f52b5c82b58b6d11b7929d073d77b9, https://si.imgix.net/27f858b9/uploads/origins/c5058a83-5eb8-4e04-9e7b-77f09ab41409?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64c0079ebc7cdd64f16e550da1d91e6b 2x, https://si.imgix.net/27f858b9/uploads/origins/c5058a83-5eb8-4e04-9e7b-77f09ab41409?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d644b24b840e688550bf5d711cf2322 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/27f858b9/uploads/origins/c5058a83-5eb8-4e04-9e7b-77f09ab41409?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aea9f0c7c6ce5e81e9c446009493fc78", "srcset": "https://si.imgix.net/27f858b9/uploads/origins/c5058a83-5eb8-4e04-9e7b-77f09ab41409?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aea9f0c7c6ce5e81e9c446009493fc78, https://si.imgix.net/27f858b9/uploads/origins/c5058a83-5eb8-4e04-9e7b-77f09ab41409?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a9cb15f00f5265169dd8c44815bc8345 2x, https://si.imgix.net/27f858b9/uploads/origins/c5058a83-5eb8-4e04-9e7b-77f09ab41409?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=48fd861c7df20f1e72d7adaa753607a0 3x"}, "body": "恐れ入ります、新規リクエスト失礼いたします。\n\n■キャラ\n山伏しずく(楠芽吹は勇者である)\n\n■内容\n構図:直立でこちらに左手を差し伸ばしている様子、表情は緩めの穏やかそうな笑顔でお願いします。\n服装:冬制服\n背景:白と水色(#CBF9FFほど)のグラデーションでお願いいたします。横縁の部分にナズナを散りばめていただけるとありがたいです。\nイメージ図は以下の通りです。\nhttps://drive.google.com/file/d/1mKP9L9eOvs7r4mGwHNFius6hHyfMS56v/view?usp=drivesdk\n\n■用途\n利用目的ですが、自作のTCGスリーブの作成用になります。販売、譲渡の目的はございませんが業者を通して印刷を行う、不特定多数の目に入る可能性があるなど個人利用の範疇からは逸脱すると考えております。\n\n■サイズ\n横67mm、縦92mm、解像度は350dpiでお願いいたします。また、2mmほどの単色青色の縁取り(#00E1FFほど)と5pt以上の大きさで右下に「illust:○○」と製作者表記を入れた差分を用意していただけるとありがたいです。\n\n依頼内容は以上となります。\n上記にない部分につきましてはおまかせでお願いいたします。曖昧なリクエストで大変恐縮ですが、ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1mKP9L9eOvs7r4mGwHNFius6hHyfMS56v/view?usp=drivesdk", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@HOKAN_YP/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1791947, "client_id": 72062, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a33f8ebc/uploads/origins/d4f05baf-2283-41e3-8cdd-bd736e235fc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c394cfb02b14db802dd3fa6eb0c46301", "srcset": "https://si.imgix.net/a33f8ebc/uplo