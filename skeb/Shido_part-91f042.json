フなどはお任せ致します。描いていただける場合はレイヤーを分けて擬音、セリフの有無を分けられるようにしていただけると幸いです。\nもしも宜しければ差分として、①中出しされて絶頂する瞬間と②事後の余韻に浸っている状態もお願いします。\n以上、性癖ド直球のリクエストですが、ご検討のほど宜しくお願い致します。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 181068, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "はての 🔞", "screen_name": "abchateno", "avatar_url": "https://pbs.twimg.com/profile_images/1759642576037249024/3tOOBAC4.png", "header_url": "https://pbs.twimg.com/profile_banners/1044155938863632386/1709796518/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 186252, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ソラ", "screen_name": "fukuisora", "avatar_url": "https://pbs.twimg.com/profile_images/581336231734157312/ETdfNjE1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/98512037/1561931532/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 49}, {"id": 907923, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "あおぺん★Skeb作品倉庫", "screen_name": "aogiri_p", "avatar_url": "https://pbs.twimg.com/profile_images/1606805831760371712/m6JFSRva.jpg", "header_url": "https://pbs.twimg.com/profile_banners/33315519/1671927630/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_ex