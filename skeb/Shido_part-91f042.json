5_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86f28c73775e7728ea1b4970d1c8c4a9, https://si.imgix.net/03a445a6/requests/255015_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=427b9c301f9a0d9d25b1d776ab5a7cc1 2x, https://si.imgix.net/03a445a6/requests/255015_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=14200619748821da0a0ba67fbc51d8ec 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/03a445a6/requests/255015_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd460c394c7735da9dad57d6bd1c88bd", "srcset": "https://si.imgix.net/03a445a6/requests/255015_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd460c394c7735da9dad57d6bd1c88bd, https://si.imgix.net/03a445a6/requests/255015_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fb2017eabf96625d9be0967425d95a6a 2x, https://si.imgix.net/03a445a6/requests/255015_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=790b892624d60a7ac65a445e09d7c66b 3x"}, "body": "はじめまして、リクエストをお願いします\nFGOの水着ジャンヌが拘束されて水着のショタにくすぐられたりする直前のイラストをお願いいたします。\n服装は第二再臨(上着なし)で、水着をずり下ろしておっぱい丸出しの状態でお願いします。\nジャンヌは椅子に座って両腕を後ろ手で拘束して、両足を揃えて前に突き出して拘束してください。\n両足は裸足で、脱がされたビーチサンダルを足元に揃えて置いてください。\n構図は、裸足の足の裏とおっぱいを強調したアングルでお願いします。\nジャンヌの表情は、困ったような感じで、優しい雰囲気でお願いします。\n何をするのか少年に聞いている台詞をお願いします。\n差分をお願いします。\n1 乳首責め\n少年がジャンヌの両方の乳首をくりくりといじっている。\n困ったような感じで、少し感じている表情でお願いします。\n少年を優しく諌めるような台詞をお願いします。\n2足の裏くすぐり\n少年がジャンヌの足の裏を両手で優しく撫で回している\nびっくりした表情で、くすぐったさで口元に笑みを浮かべている表情でお願いします。\nびっくりしてくすぐったさを訴える台詞をお願いします。\n3 足の裏くすぐり\n少年がジャンヌの足の裏を両手で思い切りくすぐっている。\n思い切り笑いながら首を振り回している感じでお願いします。目尻に涙を滲ませてください。\n笑い声の台詞をお願いします。\n4 事後\n少年がジャンヌの隣でジャンヌのおっぱいを撫でている。\n呆れた感じの表情で、優しい雰囲気でお願いします。\n疲れたことを訴える台詞をお願いします。\n顔とおっぱいに汗を浮かべてください。\n少年はすべて赤面した表情でお願いします。\n差分が多く、難しい依頼かと思いますが、ご検討よろしくお願いいたします。", "nc": 1