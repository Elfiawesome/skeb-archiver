です！お任せします！\n\n使用用途としては、SNSのアイコンに設定したり、身内（鍵アカウント）に見て貰ったりしたいです（？）\n\n金額が見合わなかったり、資料不足によるキャンセルなどもちろん構いません。\nお忙しいところ恐縮ですが、何卒ご検討のほどよろしくお願いします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@tykchiyo/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 219373, "client_id": 3602254, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e25896a2/uploads/origins/5cbc94a5-7f6a-465c-99d6-c9bdb26b7493?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=693634465f15e842d2eddaae04c9fc46", "srcset": "https://si.imgix.net/e25896a2/uploads/origins/5cbc94a5-7f6a-465c-99d6-c9bdb26b7493?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=693634465f15e842d2eddaae04c9fc46, https://si.imgix.net/e25896a2/uploads/origins/5cbc94a5-7f6a-465c-99d6-c9bdb26b7493?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e4f963cdb2da647ced69968bd5edfc32 2x, https://si.imgix.net/e25896a2/uploads/origins/5cbc94a5-7f6a-465c-99d6-c9bdb26b7493?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d31d964e729e878c48c99ed596a5a9a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e25896a2/uploads/origins/5cbc94a5-7f6a-465c-99d6-c9bdb26b7493?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b863b49db178fe83b5f8927d3aba3a3c", "srcset": "https://si.imgix.net/e25896a2/uploads/origins/5cbc94a5-7f6a-465c-99d6-c9bdb26b7493?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b863b49db178fe83b5f8927d3aba3a3c, https://si.imgix.net/e25896a2/uploads/origins/5cbc94a5-7f6a-465c-99d6-c9bdb26b7493?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7bda3dfad9fb9af227f0da2aba9d5a8f 2x, https://si.imgix.net/e25896a2/upload