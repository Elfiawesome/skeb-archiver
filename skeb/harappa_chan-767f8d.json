rcset": "https://si.imgix.net/010071bc/uploads/origins/f873f443-0661-45b1-bdb0-81d0a12fbf5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c2a11d1cd2ccf616dea85c2056add0b, https://si.imgix.net/010071bc/uploads/origins/f873f443-0661-45b1-bdb0-81d0a12fbf5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8332b5d7c7b46795a28924fa2483a860 2x, https://si.imgix.net/010071bc/uploads/origins/f873f443-0661-45b1-bdb0-81d0a12fbf5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5bcaf58ab6eb6e0a60ca82aef8ebfe39 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/010071bc/uploads/origins/f873f443-0661-45b1-bdb0-81d0a12fbf5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a4c62131d9b2efc71c862c07c971c59", "srcset": "https://si.imgix.net/010071bc/uploads/origins/f873f443-0661-45b1-bdb0-81d0a12fbf5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a4c62131d9b2efc71c862c07c971c59, https://si.imgix.net/010071bc/uploads/origins/f873f443-0661-45b1-bdb0-81d0a12fbf5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=676ddc5c2bc5423693caafc9f5497315 2x, https://si.imgix.net/010071bc/uploads/origins/f873f443-0661-45b1-bdb0-81d0a12fbf5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2775e9e624bd2b45240137a5cdede774 3x"}, "body": "はっぱさん！！skeb開設おめでとうございます＆ありがとうございます！！\nはっぱさんの絵が本当に大好きなので嬉しいです（；；）\nという訳で早速ですが依頼をお願いしたく馳せ参じました……！\n\n今回お願いしたいのは、一次創作（TRPG）のキャラクター達です！\n以下簡潔な詳細となっております↓\n\n□犬駆まわる-黒い髪の毛の方　私の探索者です\n22歳/男/164cm/新米刑事\n頭頂部にアホ毛があり、額の左側にバッテンの傷跡があります。\n真面目なので基本的に仏頂面です。口を開けると八重歯が見えます。\nややツンデレ気味で、相棒のギギくんによく振り回されています。\n\n□ギギ-白い髪の毛の方　友人の探索者です\n男/175cm（+厚底5cm）/まわるのパートナーロボット\n天使の輪っかのような装飾と猫耳ヘッドセット、ドッグタグをつけています。\n感情が豊かでとても明るくニコニコしています。\n大型犬のような振る舞いで、子供のようなあどけなさがチャームポイントです。\n\n□資料\nhttps://drive.google.com/drive/folders/1cGBs5hyEMBj_hxOLGzk0Xaezzm6cq5UQ?usp=drive_link\n\n衣装は描きやすいように改変していただいて構いません。\nシチュエーションや構図なども全て描きやすい形で大丈夫です！お任せします！\n\n使用用途としては、SNSのアイコンに設定したり、身内（鍵アカウント）に見て貰ったりしたいです（？）\n\n金額が見合わなかったり、資料不足によるキャンセルなどもちろん構いません。\nお忙しいところ恐縮ですが、何卒ご検討のほどよろしくお願いします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1162495, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "まなもこ🐟➰🍌", "screen_name": "m_fancys", "avatar_url": "https://pbs.twimg.com/profile_images/1761750197036830720/R-S0T9I4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/817568651393974273/1708868965/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 129}, {"id": 2593848, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "はとばゆき🕊🌱@skeb募集中", "screen_name": "yuki_hatoba", "avatar_url": "https://pbs.twimg.com/profile_images/1992976315151163392/Be6N1f2i.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1326179418021064705/1648365034/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 0}, {"id": 2620286, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "いかわさ🦑(チゲ味)", "screen_name": "Midori_annte23", "avatar_url": "https://pbs.twimg.com/profile_images/1772462509385269248/3WO5dS3i.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1288136668696809473/1711452276/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_ra