9732-194d76a190df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=030fb6f37510997dab0aebb5af97eb15", "srcset": "https://si.imgix.net/c8842696/uploads/origins/cbb7f35a-0f3a-4343-9732-194d76a190df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=030fb6f37510997dab0aebb5af97eb15, https://si.imgix.net/c8842696/uploads/origins/cbb7f35a-0f3a-4343-9732-194d76a190df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a6a0905aef0aa7e2042dadc6bcd26499 2x, https://si.imgix.net/c8842696/uploads/origins/cbb7f35a-0f3a-4343-9732-194d76a190df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1dc1d3572e548a09afa0bd1c93bc4684 3x"}, "body": "はじめまして。\n偶然イラストを拝見し、とても素敵だったためリクエストさせていただきました。\n\n近未来の世界観で「自然との共生」をテーマにした、現代ファンタジー作品のキャラクターを縦構図でお願いしたいです。\n\n全体の色味はお任せしますが、緑や水色など自然を感じる色味が入ると嬉しいです。\n\n使用用途は、小説の表紙・挿絵・SNS掲載・グッズなどの商用利用（将来的に電子書籍での出版を含む）を予定しております。\n\nキャラクター要素は参考画像を元に、\n・暗めの紫色の目\n・全体的に黒と紫がミックスされているウルフカット\n・チョーカーと両耳に多数のピアス\n・工具や文房具を引っ掛けている茶色い合皮の装飾\nは個性として残して頂ければ幸いです。細かい指定はございませんので、着崩しやアレンジ、デザイン変更等はお任せします。\n\n両腕に異なるデザインのタトゥーが見えると嬉しいです。また、ズボンの上に短めの腰巻きスカートを合わせていただけると助かります。\n\n手首に黒いブレスレット型の通信機器を付けることは可能でしょうか。（難しければ無くても大丈夫です）\n\n28歳の男性社会人で無口な性格のため、表情は真顔でお願いします。\n器用な技術者で、架空の乗り物や機械のメンテナンスを行い主人公を支えるキャラクターです。作業中の雰囲気が伝わるような表現だと嬉しいです。\n\n構図・ポーズ・背景もお任せいたします。\n\n参考資料が簡単な立ち絵のみで恐縮ですが、かっこよく仕上げていただけますと幸いです。\n\nSKebでの依頼に不慣れなため、不備がありましたら申し訳ございません。\nお忙しい中恐縮ですが、ご検討のほどよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1vw7_KpRGdPSMFQlArEtvVeVVHr0UjGdC/view?usp=drivesdk", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KalinNote667/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ecb77a8f/uploads/origins/54d9b082-0853-4440-8a73-765f95055534?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PR