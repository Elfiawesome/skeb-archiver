23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b2d1a785aeba976e63641f08203eecbb", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/10ee2017/uploads/origins/965f478e-0d43-40e1-a35c-27d340f99640?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2bbf65277f5f942d01790bc5521f81ff", "src_set": ""}, "body": "こんにちは。日頃よりの投稿心より楽しませて頂いております。また先だっての依頼では大変お世話になりました。その画と直近の素晴らしい投稿を見込みまして、同じネタになってしまい恐縮ですが、今一度 アズールレーンより「ネプチューン」さん を描いて頂けませんか。\n構図は資料URLの、引用リポスト先を参考にしていただければと… 言ってしまうと最近流行りの「お前それ次やったらマジで〝これ〟だからな」に便乗しただけなのですが、是非彼女のそんな画を見たく思いまして… 台詞を入れるとしたら「指揮官様、それをまたなさいますと〝これ〟ですわよ」と言ったところでしょうか。\nより詳しく要望を言いますと…\nデフォルトの衣装（胸元の透明な、透けてる部分はあっても無くても大丈夫です）で、膝より上くらいを描いてもらって、正面又は彼女に見下ろされる様な、こちらを煽る、悪戯っぽいまたは妖艶な表情で。彼女のトレードマークたるトライデントを胸と脚に挟んでいると歓びます。（内股で立っている、若しくは女の子座りのような感じで）\n難しい様であれば上半身のみ、下着や水着、いっそ全裸でも構いません！（NSFWはONにしておきます）\nトライデントは刃が上下どちらでも、こちらも描写が難しければ最悪無くても構いません。\n可能であれば表情や簡単なポーズ違いの差分等あると、また上記の台詞があると悦びますが… いずれも余裕がありましたらで構いません。\n背景はお任せします。普通の部屋や寝床、水辺だったり、簡素なものやこちらも無くても大丈夫です。\n例によってスマホでの見るのを想定しているので縦長の画で、分かりやすく描きやすく『盛って』貰えれば幸いです。\n旬な、ネットミームなネタですがゆっくり描いてもらって構いません。ご検討頂けますと幸いです。\n\nhttps://x.com/lng_14a/status/1896862268501188619?s=46&t=nXUz4zB6Bne_HSFL6XPWFA", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Tsuri_pi/works/36", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f98583ca/uploads/origins/eb07ff3e-df4e-4bd8-8649-4993a062891b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=28e6688f9b6c8259bb9e3d2c4fb35c83", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2612865, "client_id": 1117724, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "wo