tps%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2033510310762680322%2F36BA3x67.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fdef90981d48bebbfa770f56ecb76143 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2033510310762680322%2F36BA3x67.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2140cfc4d06b48e7b4a897805ed86b2", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2033510310762680322%2F36BA3x67.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2140cfc4d06b48e7b4a897805ed86b2, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2033510310762680322%2F36BA3x67.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aab546aaae19e045c4b256178bf30401 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2033510310762680322%2F36BA3x67.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9c5105134462ca0cf1456bd49778dd9b 3x"}, "body": "こんにちは！またまた私です!私のキャラを描いてくれてありがとうとてもかわいく仕上がりました！(笑)あと、ライターさんもやってらっしゃるみたいなので、同じOCのハンターイディアカンサスにも書いていただけたら嬉しいなと思って！\n\nSkebに文章を依頼するのは初めてなので、間違いがあったらごめんなさい。\n書きやすい言語で書いてください！私の方で翻訳しますので、ご安心ください！\n\nイディアカンサスとウルピアヌスの間で何か書いてほしい！ウルピアヌスの記事はこちらで読めます： https://arknights.wikiru.jp/?%E3%82%A6%E3%83%AB%E3%83%94%E3%82%A2%E3%83%8C%E3%82%B9\n\n二人で簡単なキャンプに行くところを書いてもらってもいいですか？釣りに行って、釣った魚を料理して、屋外でテントで寝るとか！人里離れた場所にハイキングに行くこともできます。\n\nウルピアナスはイディアを気にかけていることを表には出さないし、口にも出さない。むしろ、彼のイディアに対する責任感は、イディアの訓練や教育に対する厳しさを通して示されている。こうしてウルピアヌスは、イディアがどんな障害にも立ち向かえるよう、できる限りの準備をさせる。トレーニングのおかげで、イディアはウルピアヌスの性格や仕事ぶりをいろいろな面で受け継いでいる。イディアは普段は真面目で論理的だ。シーボーン狩りを原動力とし、常に任務の遂行を優先する。\n\n表向きには普通の気遣いを見せないが、互いのために行動し、互いの安全を確認することで気遣いを示す。互いを褒め合うことはほとんどなく、言葉遣いはかなり悪い。触れ合うこともあまりない。\n\n自由に書いてください！短編でも長編でも構いません！\n\n今回も依頼を考えていただきありがとうございました！またご一緒できるといいですね！\n\nhttps://drive.google.com/drive/u/2/folders/1MbW0GFJ94Cj93GE2GynXR-qTbUPxMufo", "nc": 144, "word_count": 2152, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@Kokuroumiko/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3750968, "client_id": 2870324, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a38dd9c0/uploads/origins/4f569c47-4e18-44a3-b1ac-25e5c93e62d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0b235446e26de7f829659b4ca5e184d", "srcset": "https://si.imgix.net/a38dd9c0/uploads/origins/4f569c47-4e18-44a3-b1ac-25e5c93e62d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0b235446e26de7f829659b4ca5e184d, https://si.imgix.net/a38dd9c0/uploads/origins/4f569c47-4e18-44a3-b1ac-25e5c93e62d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f193c5d548bf833b9bb213142f06558 2x, https://si.imgix.net/a38dd9c0/uploads/origins/4f569c47-4e18-44a3-b1ac-25e5c93e62d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d6a6567935dd42b7da7183ca579eb785 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a38dd9c0/uploads/origins/4f569c47-4e18-44a3-b1ac-25e5c93e62d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b5355655d581d5b1af884a73e82359a", "srcset": "https://si.imgix.net/a38dd9c0/uploads/origins/4f569c47-4e18-44a3-b1ac-25e5c93e62d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b5355655d581d5b1af884a73e82359a, https://si.imgix.net/a38dd9c0/uploads/origins/4f569c47-4e18-44a3-b1ac-25e5c93e62d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f1029ba274c32ee7574ed71d2f8849e0 2x, https://si.imgix.net/a38dd9c0/uploads/origins/4f569c47-4e18-44a3-b1ac-25e5c93e62d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d191d90cb2900b0ebbba6404bf284e54 3x"}, "body": "こんにちは！はじめまして！たまたまSkebのプロフィールを見て、あなたのキャラクターがかわいいと思いました！\n\n私のOCを描いていただいてもよろしいでしょうか？文章も絵も描けるんですね！かっこいいですね\n\nタイトルは「ハンター・イディアカンサス」ですが、ニックネームは「イディア」とします！元々は「アークナイツ」用に作ったんだけど、TRPG/DnD（ダンジョンズ＆ドラゴンズ）でも使うよ！\n\nイディアは元は人間だったのですが、ある実験によってハイブリッド・モンスターとなり、\"デレリウム \"というモンスターの遺伝子と力が混ざってしまい、見た目が変わってしまいました。物語の中では、\"デレリウム \"によって堕落した者たちが登場する。彼は半分魚のような怪物のような姿になり、その力を使って堕落した生き物を狩る！\"デレリウム \"は紫色の結晶なので、彼の血も紫色になった！\n\n彼を要約すると、\"イディアは他のモンスターを狩るためにモンスターになった\"。悲しい話だが、彼は他の人々を守るためにそうしたのだ。彼は自分の使命を果たすことにとても集中している！\n\n彼の表情はクールにも獰猛にも見える！イディアは堕落したモンスターを専門に狩る強いハンターなので、戦闘力は高い。アークナイツ』や『ブラッドボーン』の \"深淵の狩人 \"からヒントを得るのもいいだろう！\n\n彼は基本的に真面目な性格だ。笑顔を見せることはなく、自分の仕事を全うし、どんな犠牲を払っても良い狩りをすることだけを考えている。\n\n彼の資料では、鼻の傷が目立たないかもしれません。彼の鼻の傷跡を目の間に正確に描いてください！鼻の傷は低すぎないように！彼の手と爪は緑色に変色しており、手首付近にはわずかに通常の肌の色のグラデーションが見られる。\n\n私のリクエストを考慮していただき、ありがとうございます！お値段が足りないようでしたら、私の依頼をお断りしてください！\n\nhttps://drive.google.com/drive/u/2/folders/1MbW0GFJ94Cj93GE2GynXR-qTbUPxMufo", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 535015, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "りっぱ", "screen_name": "radioinpepper", "avatar_url": "https://pbs.twimg.com/prof