Tubeにはなく、専用サブスクにしかない(アマプラは入ってないため不明)ので断念しています。なので本当に自由で大丈夫です。\n\n\nいつも配信ありがとうございます。そしてお勤めお疲れ様です。カナリさんの配信が人生の楽しみになっています。これからも応援しています！", "nc": 1, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@MMnoki_Chan/works/8", "private_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1906937010952286208%2F8zO-7wKe.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8b3f46c7d548aa1839a1c250acbc64a3", "src_set": ""}, "private": true, "genre": "voice", "tipped": false, "creator_id": 2866736, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@MMnoki_Chan/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2866736, "client_id": 3172200, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54a1ccfc/uploads/origins/63a0fc5b-55c7-4be8-97ed-608194dbf43c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90ca4f1224a3c6a8d16031a44f2dd4ba", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54a1ccfc/uploads/origins/63a0fc5b-55c7-4be8-97ed-608194dbf43c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f4aca47035b92b6296e4e00d6cabc88", "src_set": ""}, "body": "しきみさんのおまかせで\n締め切りはいつでもどうぞ！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MMnoki_Chan/works/6", "private_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1906937010952286208%2F8zO-7wKe.