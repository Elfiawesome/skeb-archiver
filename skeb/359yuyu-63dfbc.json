afeada35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71dcb3386c15cc9b97125745f3683be9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8703599c/uploads/origins/37d4e86d-0ef9-49ee-a2c9-ab40afeada35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6be7c1c7b6ab8c944b3c73a4a994c0ad", "src_set": ""}, "body": "こんにちは。\nhttps://x.com/359yuyu/status/1893376280176845253\n私のOC \"SKETCH \"の同じような4マスレイアウトの絵をお願いしたいと思っていました。昨日一日中その画像を見ていました。個人的なアイコンとして使いたいので、同じような雰囲気が欲しいです。\n\nSKETCHのアクセントカラーは黒、赤、白です。URLの最初の参考画像には黄色とオレンジが入っていますが、これは外れです。無視してください。\n\n ありがとうございました！  🖤🤍❤️\n\nhttps://imgur.com/a/oc-sketch-KKBBfHO", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@359yuyu/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2371626, "client_id": 3051732, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7740d367/uploads/origins/fc47ee30-b2ba-405c-8bed-5b1f9439163c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92a5ab91d9c2b964d80351e27f104aa0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7740d367/uploads/origins/fc47ee30-b2ba-405c-8bed-5b1f9439163c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bcdacdeecdcc4f87b9cf86b0a86d36dd", "src_set": ""}, "body": "こんにちは、\n\nGEN5ウノヴァン・サムロットをお願いしたいのですが。\n\nありがとうございます。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@359yuyu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2371626, "client_id": 2049373, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c1fbb40/uploads/origins/d428fced-a03f-4446-ac20-956c7739162c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37969b17885ea04445e752953cf6be3e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c1fbb40/uploads/origins/d428fced-a03f-4446-ac20-956c7739162c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40258cf5a571efe0daf205650d418ed5", "src_set": ""}, "body": "アブソルを描くことになる。\nImgurのリンクには2つのリファレンスがある。古いリファレンスはアブソルの服の位置を示している。新しいリファレンスは、衣服、素材、毛皮の両方のデザインをより更新したものだ。新しいリファレンスでは詳細が不明瞭な部分もあるので、以下にどのように見えるべきかの詳細を列挙する。\n\n重要なディテール\n* 首のバンダナは骸骨の顎のシルエットをしている。\n* アブソルには、頭の右側、ブレードの近くから突出した小さめの白髪がある。\n* 右足に鉄でメッキされた膝当てをズボンの上からつけている。\n* 新しいデザインでは、頭部に包帯を巻いていません。\n* 左腕の袖にあるべきシンボルがある。\n* 緑のズボンはやや長めだが、アブソルの足の近くでロールアップされている。緑色のズボンの素材は、新しいデザインでは縫い合わされていないように見えます。ズボンの素材はセミボールドのグリーンデニムになっている。\n* ズボンの下は腰に包帯を巻いている。\n\nありがとう！\n\nhttps://imgur.com/a/380U9Mu", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@359yuyu/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2371626, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7cc6ec3b/uploads/origins/fea1987f-4026-4f0f-8f41-a3c97aabb893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85cac2eec94866e8578a31b6ed25f720", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7cc6ec3b/uploads/origins/fea1987f-4026-4f0f-8f41-a3c97aabb893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=afaec3c46150ce979797204d24018d37", "src_set": ""}, "body": "こんにちは！僕のソルの絵をお願いします。\n彼はアブソル＋リカンロクのフュージョンです。\n好きなように描いてください。\n\nhttps://drive.google.com/drive/folders/109AjWTbszHz8IhAx_Icl2QmgANAHsk7r?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@359yuyu/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2371626, "client_id": 540698, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3bae4d03/uploads/origins/88add6b6-d68d-41c9-8f14-c1876995c096?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=11246ae391915e9022aaa3b0d2907d78", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3bae4d03/uploads/origins/88add6b6-d68d-41c9-8f14-c1876995c096?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10aeb0a4e235aa68eeebf04ed341655f", "src_set": ""}, "body": "Hello! I love the way you draw absol and was wondering if you would be interested in drawing a similar character! \nI hope you are interested and have fun with them!\n\nhttps://www.dropbox.com/scl/fi/w9kyc2xlq7rla4ifvpqn6/Zipdramon-2.png?rlkey=gzwaus0396js9g0cyshoi81kk&dl=0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@359yuyu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2371626, "client_id": 1973558, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/83786577/uploads/origins/c6d6beaa-9529-4987-b822-b87b831d2b96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=01b245c7460319e61f64eee5392c36bb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/83786577/uploads/origins/c6d6beaa-9529-4987-b822-b87b831d2b96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4fe244f5f6bce2e55f29745e95981b83", "src_set": ""}, "body": "こんにちは！いつもアブソルのイラストを拝見しているのですが、もしよろしければ私のアブソルとホンチクロウのフュージョンのイラストをお願いしたいです！彼はカフェのオーナーで、（眠いせいもあるのですが）かなり遠慮がちなので、フォルダの最初の絵のようにカフェミックスのようなスカーフを巻いている可能性もありますが、それ以外のポーズや表情はお任せして大丈夫です！よろしくお願いします！よろしくお願いします！^v^)b\n\nhttps://drive.google.com/drive/folders/1uE1Jbs-HlS9cHSH4dtLAflRp13EsarHB?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@359yuyu/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2371626, "client_id": 2640703, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db4af9be/uploads/origins/0b48bf41-4276-45c1-b243-be94a354c8da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=599dafd084b7e039a7bcc909040985cc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db4af9be/uploads/origins/0b48bf41-4276-45c1-b243-be94a354c8da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19ac945bf009f88b4a7e5fcb1ffb59cf", "src_set": ""}, "body": "こんにちは！素敵な一日をお過ごしですか？^^\n\nできれば、ポケモンOCの二人が一緒にアクションポーズをしているイラストが欲しいです。二人の個性をうまく表現していただけると嬉しいです。\n\n参考\nエスピオンとドラパルトの融合：\nhttps://www.furaffinity.net/view/52917000/\nhttps://www.furaffinity.net/view/52917134/\n\nアンブレオンとフーパの融合：\nhttps://www.furaffinity.net/view/52296412/\n\n飄々とした性格のエスペオンのハイブリッド。猫に似ている。部分的に透明になることができ、スピリチュアル・ウィスプを呼び出すことができる。\n\nウンブルオン（ブラッキー）のハイブリッドはもっとやんちゃだ。物静かだが楽しいことが大好きで、いたずら好きだ。また、フーパと同じような指輪を作ることができるが、この指輪はピンクの炎で光る。\n\n絵のスタイルは自由です。私はアーティストのユニークなアートスタイルを見るのがとても好きなので、好きなようにあなたのスタイルに合わせてください。\n\nありがとう！お元気で！\nお元気で！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@359yuyu/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2371626, "client_id": 802186, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/182224e8/uploads/origins/3c71cde2-864e-4fe1-85ca-993d8e8acd63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aca9b592969b304def42526d7baf06c6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/182224e8/uploads/origins/3c71cde2-864e-4fe1-85ca-993d8e8acd63?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=799d1b9f2b531fff2ba0d90e1a4c2be9", "src_set": ""}, "body": "ゆゆさん、初めまして！\nいつもアブソルの素敵なイラストを拝見しております。\n\n\n私のオリキャラである白牙を描いてもらってもよろしいでしょうか？\n\n彼女は顔の左側に爪痕のような大きな傷があり、シルバーの十字架がついたネックレスをかけています。\n彼女のレファレンスは以下のサイトにまとめられています(※R-18の作品もあります)\n\nhttps://www.furaffinity.net/gallery/tenebscuro/folder/957440/The-Outside-the-Wilderness\n髪型のデザインは前後していますが、最近の作品では安定してきているのでそちらを参照してもらえると分かりやすいです。\n\n彼女の詳細な設定は、以下のリンクにある作品の概要欄に記載されています。\nhttps://www.furaffinity.net/view/40903255/\n\n\n\nポーズや表情はゆゆさんのアイデアにお任せしたいと思います。\n彼女は儚く、物憂げで、心から笑うことは殆どありません。そういった様子を描いてくれてもいいですし、自分の過去と罪に葛藤している(詳細は概要で)様子、あるいはシンプルに微笑んでいたり、バトルやアクションシーンを描いてもらっても構いません。\n\n\nご検討のほどよろしくお願いします。\n\nありがとうございました。\n\n\nTenebscuro", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 20027, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "矢澤 豆太郎🐣", "screen_name": "yzw_mmtr", "avatar_url": "https://pbs.twimg.com/profile_images/1538896370186465281/dK3UAIby.jpg", "header_url": "https://pbs.twimg.com/profile_banners/875197349663956992/1726323885/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "skills": [{"genre": "art"}], "nc": 1}, {"id": 493518, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🔚せみまる", "screen_name": "potatopotatoto", "avatar_url": "https://pbs.twimg.com/profile_images/1496098016503398400/8CkGe8It.jpg", "header_url": "https://pbs.twimg.com/profile_banners/896149745810366464/1585749881/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": n