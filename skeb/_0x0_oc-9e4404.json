=200&s=3837095019835df95a23220346482adc 2x, https://si.imgix.net/8f060bb4/uploads/origins/de1b0c78-1302-40bf-9619-faba538ed30e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=567d2de46aee756744460f38e2971a9e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8f060bb4/uploads/origins/de1b0c78-1302-40bf-9619-faba538ed30e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b79059e6e33906b5a15d70993fab57a", "srcset": "https://si.imgix.net/8f060bb4/uploads/origins/de1b0c78-1302-40bf-9619-faba538ed30e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b79059e6e33906b5a15d70993fab57a, https://si.imgix.net/8f060bb4/uploads/origins/de1b0c78-1302-40bf-9619-faba538ed30e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=35db55b4d3f4f154ea1a2631a48662a6 2x, https://si.imgix.net/8f060bb4/uploads/origins/de1b0c78-1302-40bf-9619-faba538ed30e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8edc5579e56abe81ac123bf0816288eb 3x"}, "body": "はじめまして！\nとてもイラストが好みでしたのでリクエストさせていただきました。\n\n11/30の0時頃に投稿されていました赤髪の女の子のイラストがとっても好みですので、そういった画風で描いていただけると嬉しいです。\n\n描いていただきたいOCの特徴\n・センター分けレイヤーカット茶髪ロング（資料にある髪を結んでいるSDのような前髪があっても構いません）\n・こちらから見て左目のほうに泣きぼくろ\n・資料では青っぽい黒色の瞳ですが、髪と同じか髪より少し明るい茶色でお願いします。\n・資料の中には2枚ほどムッとした表情がありますが、単体では表情豊かです。\n・服装は描きやすいように、描きたいように描いていただいて構いません。資料内のものでも大丈夫です。\n\n金額不足等気軽に再送していただければ嬉しいです。ご縁ありましたら嬉しいです！\n\nhttps://www.dropbox.com/scl/fo/cvco82j9m0zfnx0ae897w/ACgfNVZYh9S5mUh3uRsmTtg?rlkey=vh6j6biua168a2a83e0qym10k&st=tge9q6jy&dl=0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_0x0_oc/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2646361, "client_id": 3712465, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix