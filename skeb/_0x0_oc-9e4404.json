ですが、🎡様がTwitterにて2024年12月頃に掲載されているミジスアのイラストや、2025年7月26日掲載の左画像（自探たち、という文言と共に載せられているもの）のような画風で描いてもらえますと、とっても嬉しいです🍀\n\nお時間のある際にご確認のほど、宜しくお願いいたします☺️\n\n詳細▶︎こども悪魔。年齢は13、4歳程度。性格はわがままで天邪鬼。精神的にも身体的にも年相応の幼さがありおっちょこちょいで人見知り。よく笑い、よく泣き、よく怒る、感情豊かな子。大きく笑うと八重歯が見えるのが特徴。自分の容姿に関して少なからずの自信を持っている。\n\nhttps://drive.google.com/drive/u/0/mobile/folders/1XKqTUdJ6ZZMX6EDWcxz1NXJpyWvtLL1c?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_0x0_oc/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2646361, "client_id": 3213527, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/07b2c5e2/uploads/origins/6944fef7-ea9d-45bc-ab4b-72b898f976bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a14fcc494d93fe01870f665721ed2a76", "srcset": "https://si.imgix.net/07b2c5e2/uploads/origins/6944fef7-ea9d-45bc-ab4b-72b898f976bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a14fcc494d93fe01870f665721ed2a76, https://si.imgix.net/07b2c5e2/uploads/origins/6944fef7-ea9d-45bc-ab4b-72b898f976bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8501141534ac79df0c829bcb13cc7ee4 2x, https://si.imgix.net/07b2c5e2/uploads/origins/6944fef7-ea9d-45bc-ab4b-72b898f976bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=430fe1bacbfa150e65f84fd85e633e46 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/07b2c5e2/uploads/origins/6944fef7-ea9d-45bc-ab4b-72b898f976bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=282b3186ae99eb75a9f06878d27daa31", "srcset": "https://si.imgix.net/07b2c5e2/uploads/origins/6944fef7-ea9d-45bc-ab4b-72b898f976bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=282b3186ae99eb75a9f06878d27daa31, https://si.imgix.n