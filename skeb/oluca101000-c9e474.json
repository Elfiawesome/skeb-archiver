60038b/uploads/origins/c2dfe462-a138-4854-a106-bc5773a5b8ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b61dddc30cac5ca9818538da3021520 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff60038b/uploads/origins/c2dfe462-a138-4854-a106-bc5773a5b8ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3808c59be6a2b6eab06d1e1908e4f6f4", "srcset": "https://si.imgix.net/ff60038b/uploads/origins/c2dfe462-a138-4854-a106-bc5773a5b8ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3808c59be6a2b6eab06d1e1908e4f6f4, https://si.imgix.net/ff60038b/uploads/origins/c2dfe462-a138-4854-a106-bc5773a5b8ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2b6a0dcc1f1c9fe102bcc8d5c83695a3 2x, https://si.imgix.net/ff60038b/uploads/origins/c2dfe462-a138-4854-a106-bc5773a5b8ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bba438a029a60a8c02b4a7837118da77 3x"}, "body": "いつもお世話になっております。\nイラスト楽しく拝見させて頂いております。\n遅くなって申し訳ありませんが、本日は依頼の第一弾としてゲーム「elona」と「elin」に登場します神、「癒しのジュア」様をリクエストしに参りました。\n商用問わず二次創作は可能と確認してはございますが、不都合ありましたら依頼を破棄して頂ければ幸いです。\n\n構図やポーズとしては、アクリルスタンドにありそうな立ち姿、又は(椅子が描かれていないが座っているような状態の)座った姿で、手を広げ、微笑んでいてくださると助かります。\n\n要約しますと上半身すし三昧のポーズ、下半身は立っているか座っているかはお任せとなります。\n\n特に厳密な指定ではありませんので、ポーズ違ったりしてもジュア様が描かれていればOKです！\n\n最後になりますが、いつも綺麗な絵を見せていただきありがとうございます。筆も早いのでたくさんの作品を見られて嬉しいです。\nこれからも健やかに作品を生み出していただければ幸甚でございます。\n以上、よろしくお願い申し上げます。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@_Ohana_0606/works/517", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3024076, "client_id": 3564416, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/93b31df9/uploads/origins/a4700a0e-fb62-4e0f-811e-7f66e8ee6a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b3e8a8564c04c6e692c6dc2960f0793", "srcset": "https://si.imgix.net/93b31df9/uploads/origins/a4700a0e-fb62-4e0f-811e-7f66e8ee6a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b3e8a8564c04c6e692c6dc2960f0793, https://si.imgix.net/93b31df9/uploads/origins/a4700a0e-fb62-4e0f-811e-7f66e8ee6a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed4f883c3c56d54a84c927983b51ec69 2x, https://si.imgix.net/93b31df9/uploads/origins/a4700a0e-fb62-4e0f-811e-7f66e8ee6a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e179cd835cd9eae2c2fccc385c21c888 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/93b31df9/uploads/origins/a4700a0e-fb62-4e0f-811e-7f66e8ee6a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7bd49802e40668cce83b9312f9771e4", "srcset": "https://si.imgix.net/93b31df9/uploads/origins/a4700a0e-fb62-4e0f-811e-7f66e8ee6a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a7bd49802e40668cce83b9312f9771e4, https://si.imgix.net/93b31df9/uploads/origins/a4700a0e-fb62-4e0f-811e-7f66e8ee6a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=158d6a77b46f10a901f23239a1ad2d97 2x, https://si.imgix.net/93b31df9/uploads/origins/a4700a0e-fb62-4e0f-811e-7f66e8ee6a2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9087f9e616e689d5fd58031048cd1bac 3x"}, "body": "初めて依頼させていただきます！\nスマホケースにさせて頂きたいので、正面に配置した時に映えるよう簡単な背景付きの透過画像を頂きたいです。\nまた、キーホルダーにもさせて頂きたいので、キャラクター単体の透過画像も頂きたいです。\n\n以下、文面でのキャラクター設定と、デザインと質感の参考にして頂きたいイラストです。\n【性別・年齢】\n男性／見た目20代半ば（実年齢80歳前後）\n【身長】180cm\n【種族】人間に近い地球外生命体\n\n【外見】\n・髪型：赤紫のウルフカット。内側のロングヘアをポニーテールに結んでいる\n・瞳：紫色の虹彩、桃色の瞳孔\n・服装：薄紫のシャツ＋青紫のベスト＋白と赤のコート\n・左腕は自作の義手で、右腕は生身\n・首の後ろに黒い触手が縦に2本生えている(分かりにくいですが、片方が首、もう片方がポニーテールに巻きついている)伸縮・操作可能（手の代わりになる）\n・首には、妹の形見が入ったペンダントを着用\n\n【性格・設定】\n・理知的で落ち着いた性格。化学と物理が得意\n・妹を亡くし、自身も左腕を失った過去を持つ\n・その後、地球に逃れて現在は組織の上層部メンバー（トップ3の一人）\n・部下や出来事を記録する「記録係」的な役割を担っている\n・記録用の本をまとめる自室あり\n\n【ポーズ・表情の要望】\n柔らかい笑顔で、義手を構えている(突き出すというよりは性格に見合うよう穏やかに持ち上げているイメージ)\n\nhttps://drive.google.com/drive/folders/1VdRpdLqH_qvYUXhmhDxDPG0LPHzhZfeX", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 214024, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🏳", "screen_name": "3hkokki", "avatar_url": "https://pbs.twimg.com/profile_images/1617199424203288576/uEaxWKQM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/309014027/1754371092/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 160}, {"id": 738812, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "うめづかうめこ♦️skeb募集中", "screen_name": "umeumeduka", "avatar_url": "https://pbs.twimg.com/profile_images/1366750675430821889/_-YTMcX8.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1261950118908948486/1732285966/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "banned": false, "nc": 176}, {"id": 2991136, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "篠崎もちめ", "screen_name": "sisisi_sio", "avatar_url": "https://pbs.twimg.com/profile_images/1940336648891326464/Ah4EIvWu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1568936754396405760/1751447011/1500x500", "appeal_receivable": false