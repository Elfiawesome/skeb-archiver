う色でお任せします。\n･ 服装はPSO2NGSキャラクターのように、露出があって、チャリさんの好みとイメージで放浪の軽装魔剣士傭兵っぽい服装をお任せします。\n･ 体の紋様は上半身だけに付けて欲しいです。紋様はPSO2NGSキャラクターのタトゥーをアレンジするか、新しいの描くか、チャリさんにお任せします。\n注文が多すぎだと思わせたら申し訳ないです。\nどうかよろしくお願いします。\n( \" _  _)\n\nhttps://drive.google.com/drive/folders/1VhI-xvLvzmu9tpvuXSyXQEQG_SMpaVaf", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@starodinblack/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2094262, "client_id": 766102, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/baaa95b8/uploads/origins/ea14e1e0-dd70-4d96-9fab-2853ddba0d15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7313de1c10e134958de9117750d2bef7", "srcset": "https://si.imgix.net/baaa95b8/uploads/origins/ea14e1e0-dd70-4d96-9fab-2853ddba0d15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7313de1c10e134958de9117750d2bef7, https://si.imgix.net/baaa95b8/uploads/origins/ea14e1e0-dd70-4d96-9fab-2853ddba0d15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f2cf3455d5d72f0917acee4a7346dcb 2x, https://si.imgix.net/baaa95b8/uploads/origins/ea14e1e0-dd70-4d96-9fab-2853ddba0d15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3965a278bfe06e0563d7b2ee3b525dcf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/baaa95b8/uploads/origins/ea14e1e0-dd70-4d96-9fab-2853ddba0d15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2484d742c0ababe0edbeb1f1e752f60", "srcset": "https://si.imgix.net/baaa95b8/uploads/origins/ea14e1e0-dd70-4d96-9fab-2853ddba0d15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2484d742c0ababe0edbeb1f1e752f60, https://si.imgix.net/baaa95b8/uploads/origins/ea14e1e0-dd70-4d96-9fab-2853ddba0d15?bg=%23fff&auto=format%2Ccompr