る方法を知っている。\n\n二人が一緒にするのが好きなことは、おいしいお菓子を食べること、勉強すること、ガーデニングをすること、音楽を聴くこと、花畑で一緒に楽しむこと。\n\n2種類の衣装がありますので、お好きな方をお選びください。\n\nご検討ありがとうございました、\nお好きなように描いてください。\n\n再送すみません、参考文献をリンクするのを忘れていました。\n\nhttps://sta.sh/21im0okqzhuk?edit=1", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hiyo_Limited/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3215445, "client_id": 2840374, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9b3cc174/uploads/origins/96b2f629-7e4a-4f76-9eab-f85aacbcfba8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3eade09a34fca167dca66aec0f54e935", "srcset": "https://si.imgix.net/9b3cc174/uploads/origins/96b2f629-7e4a-4f76-9eab-f85aacbcfba8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3eade09a34fca167dca66aec0f54e935, https://si.imgix.net/9b3cc174/uploads/origins/96b2f629-7e4a-4f76-9eab-f85aacbcfba8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f44de250b322599df8bb9cec7612ba45 2x, https://si.imgix.net/9b3cc174/uploads/origins/96b2f629-7e4a-4f76-9eab-f85aacbcfba8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=496ddc653c100e1a058433d2df081763 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9b3cc174/uploads/origins/96b2f629-7e4a-4f76-9eab-f85aacbcfba8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3de1a630f2e0bdd038f53aa614f932a", "srcset": "https://si.imgix.net/9b3cc174/uploads/origins/96b2f629-7e4a-4f76-9eab-f85aacbcfba8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3de1a630f2e0bdd038f53aa614f932a, https://si.imgix.net/9b3cc174/uploads/origins/96b2f629-7e4a-4f76-9eab-f85aacbcfba8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s