p&fit=crop&crop=top&w=200&h=200&s=c9352b625110496f9aa69e15e8623da9", "srcset": "https://si.imgix.net/abced3c1/uploads/origins/3ceeaa80-112f-4e6e-af34-2e3c2079efd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9352b625110496f9aa69e15e8623da9, https://si.imgix.net/abced3c1/uploads/origins/3ceeaa80-112f-4e6e-af34-2e3c2079efd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4bf1dca762852df2a2ffd084655f6647 2x, https://si.imgix.net/abced3c1/uploads/origins/3ceeaa80-112f-4e6e-af34-2e3c2079efd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1f76256d86f33b1b1193e69b27b36135 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/abced3c1/uploads/origins/3ceeaa80-112f-4e6e-af34-2e3c2079efd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd96310ea96cf54fcd9fd898a22cfd78", "srcset": "https://si.imgix.net/abced3c1/uploads/origins/3ceeaa80-112f-4e6e-af34-2e3c2079efd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd96310ea96cf54fcd9fd898a22cfd78, https://si.imgix.net/abced3c1/uploads/origins/3ceeaa80-112f-4e6e-af34-2e3c2079efd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=17c610b8c1024b13848dc72eb7eefce6 2x, https://si.imgix.net/abced3c1/uploads/origins/3ceeaa80-112f-4e6e-af34-2e3c2079efd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=78da5cbfb88f3fc30fafd6204ab6aca0 3x"}, "body": "はべみる。さん、初めまして。\n今回のリクエストは以下の内容となっております。\nよろしくお願い致します。\n\n【依頼内容】\nこいしがふたなりの霊夢と両手でラブ握りしながら、騎乗位でイチャラブセックスしているイラスト。\n\n【依頼内容の詳細】\n・こいしはサードアイを身につけている。\n・こいしには猫耳と尻尾が生えている。\n・霊夢には狐耳と尻尾が生えている。\n・こいしはよだれを垂らして虚ろな目で霊夢を見つめながら、嬉し涙を流している。\n・霊夢の男性器はこいしのフリルスカートの中で隠れていて見えない構図になっている。\n・こいしは破れた黒パンストを履いている。\n・霊夢は白ストッキングを履いている。\n・こいしは(帽子以外の)全てのフリル服を着ている。\n・こいしの上半身の服が乱れていて、黒インナーが見えてしまっている。\n・こいしは黒い長手袋を身につけている。\n・霊夢は白い長手袋を身につけている。\n・霊夢はスカートとドロワーズとパンツ以外のフリル服は全て着ている。\n・霊夢とこいしの全てのリボンはフリル\n・背景は博麗神社の室内", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@habemiru_012/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3266473, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5c6d4a38/uploads/origins/169936f9-29f4-4309-981a-13101adeb106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=868ba23a28f7f6c3c7d5bbb83c217dc6", "srcset": "https://si.imgix.net/5c6d4a38/uploads/origins/169936f9-29f4-4309-981a-13101adeb106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=868ba23a28f7f6c3c7d5bbb83c217dc6, https://si.imgix.net/5c6d4a38/uploads/origins/169936f9-29f4-4309-981a-13101adeb106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dfb0e878d5434bdf93d47b0deb33b03d 2x, https://si.imgix.net/5c6d4a38/uploads/origins/169936f9-29f4-4309-981a-13101adeb106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d1b10714db0332fa9a2bcf92f997954c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5c6d4a38/uploads/origins/169936f9-29f4-4309-981a-13101adeb106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f02c1c8a23d504d41180507da11278e", "srcset": "https://si.imgix.net/5c6d4a38/uploads/origins/169936f9-29f4-4309-981a-13101adeb106?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4f02c1c8a23d504d41180507da11278e, https://si.imgix.net/5c6d4a38/uploads/origins/169936f9-29f4-4309-981a-13101adeb106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7ae45e27dbaf0b9c07bfac7c062a2692 2x, https://si.imgix.net/5c6d4a38/uploads/origins/169936f9-29f4-4309-981a-13101adeb106?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=81e1f533c232539e49ac189ad832f0bf 3x"}, "body": "貴方の可愛らしいイラストに惹かれました\nR-18なイラストになりますが、よろしければリクエストさせて頂きたいです\n\n●キャラクター\n古明地こいし\n\n●シチュエーション\n・黒タイツ越しにオナニーしている\n・大股開きで座ってる、あるいはベッドに寝そべってる\n・オナニー中と絶頂している差分を希望\n・絶頂時に潮吹き\n・絶頂時の表情は目を瞑ってる\n・オナニー中は「くちゅくちゅ」、絶頂時は「プッシャアアア」的な効果音あり\n・オナニー中は喘ぎ声、絶頂時は「イク♡イッちゃう♡」的なセリフあり\n・喘ぎ声は「おっ」「お゛っ」といったもの以外で\n・タイツにランガードのような太い線あり", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@habemiru_012/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3266473, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/31d69191/uploads/origins/2cf690c0-745f-4f97-96b1-7a1c076f3d11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6693ef29b710b54f3b31bfd48007f861", "srcset": "https://si.imgix.net/31d69191/uploads/origins/2cf690c0-745f-4f97-96b1-7a1c076f3d11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6693ef29b710b54f3b31bfd48007f861, https://si.imgix.net/31d69191/uploads/origins/2cf690c0-745f-4f97-96b1-7a1c076f3d11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=816ceecf68efb52f2897fdb9753cebdb 2x, https://si.imgix.net/31d69191/uploads/origins/2cf690c0-745f-4f97-96b1-7a1c076f3d11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0dbef6ecb03a0907351592535e264841 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/31d69191/uploads/origins/2cf690c0-745f-4f97-96b1-7a1c076f3d11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=240802e539fe2d39c6e91b439c8cb5b9", "srcset": "https://si.imgix.net/31d69191/uploads/origins/2cf690c0-745f-4f97-96b1-7a1c076f3d11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=240802e539fe2d39c6e91b439c8cb5b9, https://si.imgix.net/31d69191/uploads/origins/2cf690c0-745f-4f97-96b1-7a1c076f3d11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d03aa940187261ed9b8d7d5ce7f6c34e 2x, https://si.imgix.net/31d69191/uploads/origins/2cf690c0-745f-4f97-96b1-7a1c076f3d11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dc9c1c7ace7d435f3e62b81ed008d18a 3x"}, "body": "初めまして、よろしくお願いします。\n今回のリクエストは古明地こいしが\n自分の黒タイツへおしっこを\nおもらししちゃうのイラストを描く、\nあなたは次の詳細なシーンを\n描くことができますか？\n\n（1）\nこいしちゃんがおしかまするで\nもじもじするのシーン。\n\n（2）\nこいしちゃんの黒タイツを\nおしっこが\"じーわ\"するシーン。\n\n（3）\nこいしちゃんのおしかまを\nもう無理して、おしっこに\nポタポタするまで黒タイツを\nおもらしびちょびちょするシーン。\n\n（4）\n最後におしっこをおもらしが\nいっぱいに\"ジョロロロ • • •\"して、\nこいしちゃんを波がポロポロした\n初めましての顔のするシーン。\n\nこのイラストを描く\nもう大丈夫ですか？", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 17233, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "む", "screen_name": "urouror", "avatar_url": "https://pbs.twimg.com/profile_images/1032579525345869824/JOzQW99c.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 176}, {"id": 84592, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "どん", "screen_name": "Donelectric", "avatar_url": "https://pbs.twimg.com/profile_images/1983103100065067013/30kOjK1q.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1122348222578429954/1618133045/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": 