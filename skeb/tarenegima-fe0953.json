ying lightly in the wind) (https://imgur.com/a/INQF6Je)\n\nPlease maintain the thickness and leg line of the thigh as the image of the next link, rather than the character's thighs and legs as thin as the original image.\nhttps://www.pixiv.net/artworks/88480064 //\nhttps://www.pixiv.net/artworks/89031002 // )\n\nThank you for reading my long request.", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tarenegima/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 823502, "client_id": 488162, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1618983f/uploads/origins/4c1c9d6a-11fb-4451-b878-7a480768af3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5de4f3cd67d6344ed1901b059b75784a", "srcset": "https://si.imgix.net/1618983f/uploads/origins/4c1c9d6a-11fb-4451-b878-7a480768af3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5de4f3cd67d6344ed1901b059b75784a, https://si.imgix.net/1618983f/uploads/origins/4c1c9d6a-11fb-4451-b878-7a480768af3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=020b61e1aa1b4388e8770434b34881df 2x, https://si.imgix.net/1618983f/uploads/origins/4c1c9d6a-11fb-4451-b878-7a480768af3a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9a83bd80d9afe6c2b5877f15dc556c6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1618983f/uploads/origins/4c1c9d6a-11fb-4451-b878-7a480768af3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dfd4c5f7031c0e2d6eba381a45d1951a", "srcset": "https://si.imgix.net/1618983f/uploads/origins/4c1c9d6a-11fb-4451-b878-7a480768af3a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dfd4c5f7031c0e2d6eba381a45d1951a, https://si.imgix.net/1618983f/uploads/origins