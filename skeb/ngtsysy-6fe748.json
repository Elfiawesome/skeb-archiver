\n特にポーズや表情などの指定はありません。\n難しい場合、どちらか1人でも大丈夫です。\nまだあまり深く練れている子達ではありませんので、ゆるしてさんの好きに描いていただければ幸いです。\nご検討の程よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1Y2TP3EmZUOsXZqcJTxIl9U82pVPC577c", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@k4ou_2/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3552589, "client_id": 3516977, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/07f281e1/uploads/origins/603b4759-06f8-4973-a9e9-a5e59dcb5021?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d59b432dd7a662325bc51f6a99943cb1", "srcset": "https://si.imgix.net/07f281e1/uploads/origins/603b4759-06f8-4973-a9e9-a5e59dcb5021?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d59b432dd7a662325bc51f6a99943cb1, https://si.imgix.net/07f281e1/uploads/origins/603b4759-06f8-4973-a9e9-a5e59dcb5021?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bcbd93918cc4618a69f43409cc9160e9 2x, https://si.imgix.net/07f281e1/uploads/origins/603b4759-06f8-4973-a9e9-a5e59dcb5021?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f1f6007d566645e3d9c4b5df2bd720b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/07f281e1/uploads/origins/603b4759-06f8-4973-a9e9-a5e59dcb5021?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb1cbd7cf9931d5222779b19ee3dacec", "srcset": "https://si.imgix.net/07f281e1/uploads/origins/603b4759-06f8-4973-a9e9-a5e59dcb5021?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb1cbd7cf9931d5222779b19ee3dacec, https://si.imgix.net/07f281e1/uploads/origins/603b4759-06f8-4973-a9e9-a5e59dcb5021?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ef139bbff615e87fafee974b70395072 2x, h