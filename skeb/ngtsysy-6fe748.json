ull, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff6581c3/uploads/origins/8ac27bab-6a7b-4426-9ba0-0e1d5ba0a1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1180c084783d69d3cc484a06d9b88b9b", "srcset": "https://si.imgix.net/ff6581c3/uploads/origins/8ac27bab-6a7b-4426-9ba0-0e1d5ba0a1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1180c084783d69d3cc484a06d9b88b9b, https://si.imgix.net/ff6581c3/uploads/origins/8ac27bab-6a7b-4426-9ba0-0e1d5ba0a1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=445159cde48f1bebc1aebee0d44299c4 2x, https://si.imgix.net/ff6581c3/uploads/origins/8ac27bab-6a7b-4426-9ba0-0e1d5ba0a1f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9876d91043e7ded816e7f83323aeb7e6 3x"}, "body": "こんにちは、いつもお世話になっております！\n今回リクエストさせて頂くイラストは\n『最年少で組織のカウンセラーをしているOC』\nとなります。\n\n┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈\n【OCの特徴】\n髪:ピンク髪に紫のメッシュのお団子ヘア\n※リメイク前は左上にお団子、右下に毛先のみまとめた簡単なお団子\n顔:三白眼でピンク色目、左目下に星のステッカーを貼っており、ギザ歯\n服装:白衣に薄紫色のワイシャツ、黄色と黄緑のルーズソックス、ビビットピンクのヒール\n\n所有物など:棒付きいちご飴、バインダーなど\n性格:勉学において成績が非常に優秀だが授業や業務報告はサボりがち。立場より対人での関わりやすさを重視し、砕けた喋り方でフランクに接してくる。\n\n【備考】\nリメイクしたての出来たてホヤホヤのOCで、これといったイメージが決まっていないため、表情･構図の指定はありません。\nまた、髪型についてリメイク前とリメイク後の二種類ありますので、⚰️さんから見て馴染みのある方を自由に描いてもらえると嬉しいです。\n\n【使用用途】\n・個人鑑賞\n・SNSへのアップロード、別垢への転載(アイコンやヘッダーに使用させていただく場合があります)\n\nご縁がありましたらよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1Sfo7rLWN3fdsvTQbGep_eAaDmNuUQpZq", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@koroshite_1228/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3768474, "client_id": 3516977, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/58a77455/uploads/origins/aec315da-c0bf-4d3c-8791-41d1af618203?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&c