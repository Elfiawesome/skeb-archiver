用\n・壁紙としての配布\n・商用利用\n\n◆納品形式◆\nPSD形式で、キャラクター・背景・エフェクトを分けていただけますと嬉しいです。\n\n◆キャラクターのポイント◆\n・うさ耳、尻尾がついています\n・衣装の花はミスミソウとなっております\n・白、水色が基本カラーとなっております\n・前面からの参考画像しかないので見えない部分は雰囲気で描いていただけるとうれしいです\n\n◆参考フォルダ◆\nhttps://drive.google.com/drive/folders/1l4G736PXOY5l7TyET9ENrmTB7eJjMBry?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kituneto_suzu/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4052272, "client_id": 3351437, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/112b33ca/uploads/origins/bfc4f288-d6e0-486a-be77-1c8a7a0f563e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc83d67c8b41cc3267d7909400190701", "srcset": "https://si.imgix.net/112b33ca/uploads/origins/bfc4f288-d6e0-486a-be77-1c8a7a0f563e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc83d67c8b41cc3267d7909400190701, https://si.imgix.net/112b33ca/uploads/origins/bfc4f288-d6e0-486a-be77-1c8a7a0f563e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=26d492d0dd87fd5bfa146ef97d4bd33c 2x, https://si.imgix.net/112b33ca/uploads/origins/bfc4f288-d6e0-486a-be77-1c8a7a0f563e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c00a67648c93940be2d747dde6b51771 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/112b33ca/uploads/origins/bfc4f288-d6e0-486a-be77-1c8a7a0f563e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7fe412a2518c2ff887fa1c9c1a81c909", "srcset": "https://si.imgix.net/112b33ca/uploads/origins/bfc4f288-d6e0-486a-be77-1c8a7a0f563e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7fe412a2518c2ff887fa1c9c1a81c909, https://si.imgix.net/112b33ca/uploads/origins/bfc4f288-d6e0-486a-be77-1c8a7a0f563e?bg=%23fff&auto=forma