et/42538986/uploads/origins/773b796d-b17c-4338-925b-8289c6c8cabc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1a0c51c90f5d083e824acfbf31f88ad 2x, https://si.imgix.net/42538986/uploads/origins/773b796d-b17c-4338-925b-8289c6c8cabc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd5baeeca9d7886d36bfe21d5c35d4ed 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42538986/uploads/origins/773b796d-b17c-4338-925b-8289c6c8cabc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=51df82e7373035b196229ac585903511", "srcset": "https://si.imgix.net/42538986/uploads/origins/773b796d-b17c-4338-925b-8289c6c8cabc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=51df82e7373035b196229ac585903511, https://si.imgix.net/42538986/uploads/origins/773b796d-b17c-4338-925b-8289c6c8cabc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=df1c25958cbd30f36f6e71b7a0eb1f80 2x, https://si.imgix.net/42538986/uploads/origins/773b796d-b17c-4338-925b-8289c6c8cabc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=66d55d8c34b7d4d3de2dd6967335c147 3x"}, "body": "こんにちは、味噌チョウセン先生！\n私は海外からのファンです。先生の描く漫画がとても好きで、先生の美しい絵と想像力豊かなストーリーに惹かれています！\nぜひ私のオリジナルキャラクターを描いていただきたいです！\n兄が弟をかばい、弟が兄に片思いし、弟の方が兄より背が高い。\n\n二人のやり取りをイラストにしてほしいです。服装を変えたり、弟の髪型を調整したりできるので、好きなように作ってください！\n\n最後になりましたが、お読みいただきありがとうございました！\n\nhttps://drive.google.com/drive/folders/1EywTs8qxJYgcJNjCmHD5UJHawKoI75py?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miso00sen/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2975414, "client_id": 1665801, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cb9814ca/uploads/origins/9c1dabdb