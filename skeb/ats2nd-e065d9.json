9584505d 2x, https://si.imgix.net/1ca113cc/uploads/origins/d31f30b6-ed2f-46dc-97e0-5d47f2f24ea6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d8a2e0b1a7d6d72678be70b848e85518 3x"}, "body": "こんにちは！\n\n『崩壊：スターレール』の「ホタル」のイラストをお願いしたいです！\n\nこれまでの作品と同様に、彼女が敗北して拘束されている様子を描いてください。服は引き裂かれ、触手に犯されている状態です。具体的な構図はご自由にお任せしますが、必ず胸が見えるようにしてください。 可能であれば、射精シーンも追加していただけると幸いです。\n\nホタル（Firefly） - https://imgur.com/a/rJTw9IY\n\nご検討いただきありがとうございます！", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ats2nd/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2993620, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/abdd568f/uploads/origins/141205fb-17a1-4d1f-a13d-67daf993c6f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6d02e9a4851c392486e65cde223a2af", "srcset": "https://si.imgix.net/abdd568f/uploads/origins/141205fb-17a1-4d1f-a13d-67daf993c6f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f6d02e9a4851c392486e65cde223a2af, https://si.imgix.net/abdd568f/uploads/origins/141205fb-17a1-4d1f-a13d-67daf993c6f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7895d4c6eaa440faf25b6b3dbed22594 2x, https://si.imgix.net/abdd568f/uploads/origins/141205fb-17a1-4d1f-a13d-67daf993c6f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f26293752d91d321d5a76cd5ab80811f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/abdd568f/uploads/origins/141205fb-17a1-4d1f-a13d-67daf993c6f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ac07dbc8140e7c50ac51412439b139d", "srcset": "https://si.imgix.net/abdd568f/uploads/origins/141205fb-17a1-4d1f-a13d-67daf993c6f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ac07dbc8140e7c50ac51412439b139d, https://si.imgix.net/abdd568f/uploads/origins/141205fb-17a1-4d1f-a13d-67daf993c6f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b0d833e1fe55604f3d2c7a939395ad62 2x, https://si.imgix.net/abdd568f/uploads/origins/141205fb-17a1-4d1f-a13d-67daf993c6f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=193031f09937b78f062089e48f9f3a54 3x"}, "body": "先生、またこんにちは。\n\n前回の作品、ありがとうございました：https://skeb.jp/@ats2nd/works/11\n\nとても気に入りました。キャラクターの表情も素晴らしく、全体の構図も絶妙ですね。特に、「ミヤコ」が人間のような手で相手の胸を攻撃しつつ、触手で「ユメ」の人間のような手足を拘束し、触手だけで反撃しようとする「ユメ」の様子が最高です！\n\n先生には本当にこの分野の才能がありますね。そこで、別のパラレルワールドを舞台にした、レズバトル／キャットファイトの作品をもう1つお願いしたいです。 舞台は遥か未来で、二人の少女は次のような例（https://www.pixiv.net/user/2043329/series/195467）のように、セクシーなロボットに改造されています。\n\n二人は今やロボットであるため、感情は鈍っていますが、痛みや快感は依然として感じることができます。前回の作品と同様に、できるだけ荒々しく、かつ官能的な戦いにしてください。彼女たちが手を部分的に様々な大人のおもちゃに変形させて互いに使い合う様子も想像できますが、構図はお好きなように描いてください！", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ats2nd/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2993620, "client_id": 475131, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7d0c5152/uploads/origins/6120a81e-f25c-48c2-889f-5e0604d80b54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=607146e3efd4bf4ab9fd121d0eefa30a", "srcset": "https://si.imgix.net/7d0c5152/uploads/origins/6120a81e-f25c-48c2-889f-5e0604d80b54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=607146e3efd4bf4ab9fd121d0eefa30a, https://si.imgix.net/7d0c5152/uploads/origins/6120a81e-f25c-48c2-889f-5e0604d80b54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca52a8409598d44fbdd28df09df46663 2x, https://si.imgix.net/7d0c5152/uploads/origins/6120a81e-f25c-48c2-889f-5e0604d80b54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b66820c7f3284c1a86d10f4c7ff54276 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7d0c5152/uploads/origins/6120a81e-f25c-48c2-889f-5e0604d80b54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3496621cc7361850911cba883b9ec889", "srcset": "https://si.imgix.net/7d0c5152/uploads/origins/6120a81e-f25c-48c2-889f-5e0604d80b54?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3496621cc7361850911cba883b9ec889, https://si.imgix.net/7d0c5152/uploads/origins/6120a81e-f25c-48c2-889f-5e0604d80b54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a078c398bf9b33c5d18d2b704ba21a4e 2x, https://si.imgix.net/7d0c5152/uploads/origins/6120a81e-f25c-48c2-889f-5e0604d80b54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a6769c74097768b511ad101449eb5a2f 3x"}, "body": "ゼンゼロ儀玄の機械触手とアームバインダーがきめ細かく丁寧に\n描かれており、凛々しい顔も気に入ったので依頼したいです。\nスターオーシャンアナムネシスのレイミ・サイオンジをお願いします。\n彼女は、どんな過酷な環境にも身体を順応する特異体質の持ち主です。\n人類が滅亡し機械だけが残り戦争している世界で、機械兵に捕まり地下研究施設にて\n研究用モルモットとして自分の武器を利用され、人間弓としてイキ我慢させられるシチュエーションです。\n■描いてほしい状況\n人間弓として拘束され、口で弓を引いている状態（機械はレイミを興奮させ繰り返し弓を射出させる実験中）\n■シチュ詳細\n舞台かつ背景は無機質な地下室。\nレイミに向かって斜め横から観るような構図でつま先まで全身が良く見えるアングル。\n全裸の状態で両腕をレイミイメージカラーのアームバインダーで拘束されている。\n躰には機械触手がぐるぐる巻きついておっぱいの重みを確かめるように下乳を持ち上げたり、\n鷲掴みしている。\n両足は弓のように反り返って自分の武器と一体化し\n強制開脚拘束されているポーズ。\n躰はリクライニング状態で胸の谷間を通して弓を咥えて引いている。\n台座は無機質な機械台座。\n脚中心にマジックアームや機械触手で動けないように固定されている。\n逃げられないよう首輪と台座は繋がれている。\nピンク色の光のアクメビームを撃つ機械触手が尻から口まで貫通している。\n機会触手が冷凍保存された精液を膣に放出しながら穿ち、お腹が膨らんでいる。\n■表情\nフーフー息が漏れ余裕がなく悔しそうな睨みつけ顔「はやく拘束を解いて」的な表情。\n■表情差分（弓を射出後）\n・人類最後の生き残りで羞恥心がなくなり舌だしトロ顔\n・永遠に助けの来ない光を失ったレイプ目で「お願いもう許して」と口から機械触手の先と舌を出しながら\n懇願する顔（マジックアームでアゴくいされている）\n■装備\n・全裸ベースに胸を強調するようなボンデージ\n・手前に来る左脚は生足で奥側の右脚は黒ブーツ\n・栄養剤と媚薬追加用首輪\n■留意点\nクールキャラが、無様な拘束をされているのが好きです。\n表情と弓重視でお願いします。\n最近の作品のゼンゼロ儀玄さんの塗りが気に入ったので自分のも同じような塗りで依頼したいです。\n余力あればVR洗脳目隠し差分をお願いします。\n宜しくお願いします。\n\nhttps://drive.google.com/drive/folders/1juj6nXLS6WclhMmPaHYVzzRXEll3VR_H?usp=sharing", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ats2nd/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2993620, "client_id": 915250, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8260cda4/uploads/origins/4481027e-f84f-4976-a48a-23c95f921056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2eeeec47a44f4d51f19f6796fec3972d", "srcset": "https://si.imgix.net/8260cda4/uploads/origins/4481027e-f84f-4976-a48a-23c95f921056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2eeeec47a44f4d51f19f6796fec3972d, https://si.imgix.net/8260cda4/uploads/origins/4481027e-f84f-4976-a48a-23c95f921056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dcb0384247e5eeb40c4ab648fcb3a648 2x, https://si.imgix.net/8260cda4/uploads/origins/4481027e-f84f-4976-a48a-23c95f921056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=15782fba5dfa31bfeee28d3925894dd6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8260cda4/uploads/origins/4481027e-f84f-4976-a48a-23c95f921056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5241ba6f4678a2688f9e05818d42f1a5", "srcset": "https://si.imgix.net/8260cda4/uploads/origins/4481027e-f84f-4976-a48a-23c95f921056?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5241ba6f4678a2688f9e05818d42f1a5, https://si.imgix.net/8260cda4/uploads/origins/4481027e-f84f-4976-a48a-23c95f921056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eaa2330de658dd4c495b003d99455958 2x, https://si.imgix.net/8260cda4/uploads/origins/4481027e-f84f-4976-a48a-23c95f921056?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=912847fb7fa2951abfe391a00f06c7c3 3x"}, "body": "先生、こんにちは！\n\n私のオリジナルキャラクター「クインシー」を、性別を逆転させて、淫乱でチンポ中毒の女子高生にした姿を、2コマ漫画か「ビフォー・アフター」形式で描いてください！\n\nクインシーの参考資料：Ref URLをご確認ください\nクインシーは、カフェを兼ねた魔法店の店長で、魔法使いや時には悪魔である常連客を多く迎えています。\n普段は親切ですが、控えめで物静かな性格で、友人を大切にする一方で、より変態的な一面を隠しています。\n禁断の魔法を修練しており、さらに数体のサキュバスと契約を結んでいます。\n\nこのシナリオでは、変身アイテムとして丸メガネかネックレスを希望します。\n「ビフォー」では、不気味に光るアイテムをクインシーが装着する様子、あるいは装着してエネルギーが閃光を放ち、驚いた表情のクインシーを描いてください。\n「変身後」は、ペニスに囲まれた女性化したクインシーで、貪欲で淫らな表情を浮かべている様子にしてください。\n\nNTRのようなシチュエーションの雰囲気を醸し出してください！\nオプションとして、\n日焼けした肌、ハート型の目、渦巻き状の目をしたバリエーションもいくつか欲しいです！\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1DbighMsUI2ILVEKaa4cvD-xyyJ_-9AGA", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ats2nd/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2993620, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f6105ee5/uploads/origins/521f60f0-cd13-41ce-8674-518c327d22ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54121cfb87e57859b28e48b7b372330e", "srcset": "https://si.imgix.net/f6105ee5/uploads/origins/521f60f0-cd13-41ce-8674-518c327d22ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54121cfb87e57859b28e48b7b372330e, https://si.imgix.net/f6105ee5/uploads/origins/521f60f0-cd13-41ce-8674-518c327d22ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc414b722efb10e00f6488bb15434e15 2x, https://si.imgix.net/f6105ee5/uploads/origins/521f60f0-cd13-41ce-8674-518c327d22ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d87b2bf811392923ea08b2c384c2b90c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f6105ee5/uploads/origins/521f60f0-cd13-41ce-8674-518c327d22ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d630774f0b657f2c1194b3c2a6123e3", "srcset": "https://si.imgix.net/f6105ee5/uploads/origins/521f60f0-cd13-41ce-8674-518c327d22ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9d630774f0b657f2c1194b3c2a6123e3, https://si.imgix.net/f6105ee5/uploads/origins/521f60f0-cd13-41ce-8674-518c327d22ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5703f74401f78d58a63b29453769f54d 2x, https://si.imgix.net/f6105ee5/uploads/origins/521f60f0-cd13-41ce-8674-518c327d22ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a190b1dfa00210cc28d91a6e63d27007 3x"}, "body": "私の登場人物2人による、エロティックなレズビアンバトル／キャットファイトを描いてほしいです。\n\n「ミヤコ」（奔放でスケベ、少し生意気で、卑怯な手も厭わない）：https://drive.google.com/drive/folders/1T3eXco4pdNrzJXCrw6tieBJ34FkmZC88\n「ユメ」（色気たっぷりで、意外にも変態的。勝つためなら手段を選ばない）：https://drive.google.com/drive/folders/1loLf8gbWwDnEMiATD_YtShzY6Ur8YZtC\n\n彼女たちのライバル関係は、相手が反撃できなくなるまで強制的にオーガズムに達させることに焦点を当てています。二人の絆は極めて強く、時空や宇宙さえも超越しています。\n\n両者とも触手を持つタコ娘という設定でのバトルを希望します。参考例はこちら：https://drive.google.com/drive/folders/1J0tTQe8RhKa-Af1wVonAvYBrO0SEGfId\n\nバトルはできるだけ官能的に描いてください。両者が触手で互いを激しく犯し合い、痛みと快楽の狭間で身もだえする様子を描いてください。涙と絶頂の衝動を必死にこらえながら、互いに睨み合っているような描写があれば理想的です。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ats2nd/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c11fab28/uploads/origins/72f80529-f668-4f62-aafc-4fe0a890bf75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bda40e8556324da87e6553536916a26f", "srcset": "https://si.imgix.net/c11fab28/uploads/origins/72f80529-f668-4f62-aafc-4fe0a890bf75?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=m