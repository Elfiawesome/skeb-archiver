-a140-70fd6a094029?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=772395aeaaf332fcdba013299083bae7", "srcset": "https://si.imgix.net/98a0586a/uploads/origins/7b020a14-5241-40db-a140-70fd6a094029?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=772395aeaaf332fcdba013299083bae7, https://si.imgix.net/98a0586a/uploads/origins/7b020a14-5241-40db-a140-70fd6a094029?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=639f47230be68d828165b1fb00327f37 2x, https://si.imgix.net/98a0586a/uploads/origins/7b020a14-5241-40db-a140-70fd6a094029?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b4db31d45a1c055e496e3396f13ebc36 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/98a0586a/uploads/origins/7b020a14-5241-40db-a140-70fd6a094029?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40c0bfd2d61d5f28098bed1818024251", "srcset": "https://si.imgix.net/98a0586a/uploads/origins/7b020a14-5241-40db-a140-70fd6a094029?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40c0bfd2d61d5f28098bed1818024251, https://si.imgix.net/98a0586a/uploads/origins/7b020a14-5241-40db-a140-70fd6a094029?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1b1ef334b4eba73956117327d4edf5f5 2x, https://si.imgix.net/98a0586a/uploads/origins/7b020a14-5241-40db-a140-70fd6a094029?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eafdc75bf1d1213958fc68d559853b8d 3x"}, "body": "リクエストします。\n\n艦隊これくしょんのリシュリューが休日で私服で街を散策してたところを、声をかけられて下着モデルを頼まれて撮影しちゃう作品をお願いします。\n\nリシュリューは私ほどの美貌ならモデルやるのも当たり前よねぐらいの余裕で引き受けるようにお願いします。\n\n色とりどりの色んな下着を着用して、時には誘惑する表情を浮かべたり、恥ずかしがる表情を浮かべるようにお願いします。際どい下着も余裕で着こなすようお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kakikukeko3331/works/