iew?usp=drivesdk\n\n部屋着\nhttps://drive.google.com/file/d/1nIK3GkoNBusG-xt4MoV8Y7sRXfn07Vfq/view?usp=drivesdk\n\n【シチュエーションや構図、ポーズ】\nシチュエーションの詳細や構図、ポーズ、背景の詳細はお任せしますので、こば様の筆の乗るままにうちの子をえちかわに描いていただけますと幸いです！  \n\n【その他】\n・バストサイズは大きめに\n・こば様のご対応可能な範囲でエッチさのギリギリを攻めたイラストをお願い出来ますととても嬉しいです…！\n\n【使用用途】\n個人鑑賞\n\n以上になります。\nお任せする部分が多く恐縮ですが何卒ご検討の程よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1rVWtHmCKWYvT1eptY_b9I2IzeAXXGSBC", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kobako42/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/849b465a/uploads/origins/19fbb24e-9429-46db-84ba-13f076f76e67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9fa03e79b40794c2a64c3f26209200bb", "srcset": "https://si.imgix.net/849b465a/uploads/origins/19fbb24e-9429-46db-84ba-13f076f76e67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9fa03e79b40794c2a64c3f26209200bb, https://si.imgix.net/849b465a/uploads/origins/19fbb24e-9429-46db-84ba-13f076f76e67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b67d2dc885a7f60fdff3be7927aa4416 2x, https://si.imgix.net/849b465a/uploads/origins/19fbb24e-9429-46db-84ba-13f076f76e67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=482e247eba4a3d165afe033bb48a53de 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1140172, "client_id": 1110131, "nc": 129}, {"path": "/@kobako42/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1140172, "c