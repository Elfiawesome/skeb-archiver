去作の制服エマ立ちバックような構図をお願いしたいです。\n胸は爆乳で可能であればアヘ顔などもお願いしたいです。\n\nご検討よろしくお願い致します。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mattari_2019/works/180", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b5004df1/uploads/origins/d17d74a6-3dc2-4e69-8b17-9447f1783b8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=72a05c942ab0df10c99c003d7b9f73be", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 106561, "client_id": 307754, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@mattari_2019/works/179", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 106561, "client_id": 210831, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9adc5834/uploads/origins/7830e7c2-bf20-4f35-918a-111103fcaa43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d7b3090681afd76454f87c7e7794e2d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9adc5834/uploads/origins/7830e7c2-bf20-4f35-918a-111103fcaa43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fc150f3e6498d0dac6355fc8f46a6fd7", "src_set": ""}, "body": "いつもイラストをありがとうございます。\nまた依頼をさせていただきます。\n\n■キャラクター\nアクエリオンEVOLのMIX\n\n■シチュエーション\nMIXを捕まえたアルテア軍の男はこのまま連れ帰ってもどうせ男性化するか死んでしまうかのどちらかだと考えて帰還中の事故を装いMIXごと失踪。\n記憶改竄処置で「自分達は将来を誓った恋人同士である」という記憶を刷り込まれたMIXは誰も知らない無人島で子作りセックスしまくり妊娠。\nボテ腹セックスライフにどハマりするMIXのイラストをお願いいたします。\n\n■その他\n・胸は特盛りでお願いします\n・眼鏡は外さないでください\n・体位は正常位で恋人繋ぎさせてください\n\nご検討のほどよろしくお願いいたします。\n\nhttp://aqevol.com/character/04.php", "nc": 33