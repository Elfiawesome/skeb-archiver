r_id": 67736, "client_id": 2632531, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0bc96b10/uploads/origins/4aa877e2-0124-4387-95d5-1837fe2bee04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b6206ee27376792420267a6cd677516", "srcset": "https://si.imgix.net/0bc96b10/uploads/origins/4aa877e2-0124-4387-95d5-1837fe2bee04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b6206ee27376792420267a6cd677516, https://si.imgix.net/0bc96b10/uploads/origins/4aa877e2-0124-4387-95d5-1837fe2bee04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2c30e4f1973e769a1d98b5c8b6ac9e38 2x, https://si.imgix.net/0bc96b10/uploads/origins/4aa877e2-0124-4387-95d5-1837fe2bee04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=26af2d6607bf3820ba6ace1db58a18f1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0bc96b10/uploads/origins/4aa877e2-0124-4387-95d5-1837fe2bee04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7f6f25013f0875d1b130f439fd61346", "srcset": "https://si.imgix.net/0bc96b10/uploads/origins/4aa877e2-0124-4387-95d5-1837fe2bee04?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d7f6f25013f0875d1b130f439fd61346, https://si.imgix.net/0bc96b10/uploads/origins/4aa877e2-0124-4387-95d5-1837fe2bee04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9e6d850194c33af643752ac0f95c3734 2x, https://si.imgix.net/0bc96b10/uploads/origins/4aa877e2-0124-4387-95d5-1837fe2bee04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ae8cb2add440b5fc86b0b6f349f34202 3x"}, "body": "初めまして。\nRAIL WARS!より、「桜井あおい」と「小海はるか」の18禁イラストをリクエストさせて頂きます。\n以下のように描いて頂けると嬉しいです。難しいようであれば、無理に指定と同じように描いて頂かなくても構いません。\n\n●構図\n　桜井・小海の二人が並んで立っている。二人の位置等はお任せします。\n\n●服装\n　二人とも公安隊の制服(冬服)で、胸のところだけジャケットやシャツをはだけさせ、乳房を露出している格好。下半身の露出はなし。胸の露出以外は普段通りの姿。\n　制帽や白手袋等の着用の有無、ネクタイの処理は、作者様の裁量で決めて頂いて構いません。\n\n●ポーズ・表情\n　桜井の表情は笑顔(自身ありげ・いたずらっぽい等のイメージ)で、自らの乳房を両手で下から持ち上げているようなポーズ。\n　小海の表情は恥ずかしげに目を逸らし、手を前で組んでいるようなポーズでお願いします。\n　どちらも、頬を赤らめていると尚良いです。\n\n●胸\n　乳房のサイズは、原作と同等かそれ以上(極端に人間離れしていない程度)でお願いします。\n　乳首や乳輪は、作者様基準でごく平均的なものを描いて頂けると幸いです。\n\n●背景\n　作者様の裁量にお任せします。無背景でももちろん構いません。\n\n以上になります。色々と指定しましたが、あくまで無理のない範囲でお付き合い頂き、対応できない指定については無視して頂いて結構です。何卒、ご検討の程よろしくお願い致します。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@zerosman/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 67736, "client_id": 1447825, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9d3e31a8/uploads/origins/22a2bab8-ae03-42b6-a34b-f0b89527edc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c71b88d51ac7d7488cfdab93b5048e68", "srcset": "https://si.imgix.net/9d3e31a8/uploads/origins/22a2bab8-ae03-42b6-a34b-f0b89527edc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c71b88d51ac7d7488cfdab93b5048e68, https://si.imgix.net/9d3e31a8/uploads/origins/22a2bab8-ae03-42b6-a34b-f0b89527edc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28b1340510fa0a81962b4728b8c9786c 2x, https://si.imgix.net/9d3e31a8/uploads/origins/22a2bab8-ae03-42b6-a34b-f0b89527edc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de5ee00407afc1c18c7efccb01cff3dd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9d3e31a8/uploads/origins/22a2bab8-ae03-42b6-a34b-f0b89527edc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84c383415e34155e72098714ffaad456", "srcset": "https://si.imgix.net/9d3e31a8/uploads/origins/22a2bab8-ae03-42b6-a34b-f0b89527edc4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84c383415e34155e72098714ffaad456, https://si.imgix.net/9d3e31a8/uploads/origins/22a2bab8-ae03-42b6-a34b-f0b89527edc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e9ae88f3dd4fe6135e636e4196ae6eb1 2x, https://si.imgix.net/9d3e31a8/uploads/origins/22a2bab8-ae03-42b6-a34b-f0b89527edc4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=63fb3ae8d6af674ab36630cc5841bb39 3x"}, "body": "【リクエスト概要】\nモノクロ　R18エロ漫画　8ページ前後（できれば）\n\n【ジャンル】\nリリカルなのは\n\n【キャラ】\nレティ提督×リンディ提督\n\n【プレイ内容】\n趣味と実益を兼ねたAV動画配信をする淫乱人妻たち\n人妻バニーの不倫ふたなりレズセックス♥　ということで、バニーガール姿のリンディ提督とレティ提督のハードセックス\nレティ提督が攻め　リンディ提督が受け\nレティ提督はふたなり化（金玉なし！）してリンディ提督を犯しまくる感じでお願いします\n濡れ場ではバニガコスを着用したまま　乳や秘所だけ露出して絡み合う\n流れは、パイズリ→バック→正常位\nラストの正常位はぎゅううう♥と手を恋人つなぎしたままピチャピチャ舌を絡め合う淫靡なレズキスしながら大量射精\nそして、リンディ提督の卵子にレティ提督の精子が　ちゅぷん♥　と、受精してしまうコマで〆\n\n『お願いしたいこと』\n※二人はお互い人妻だけどお互いの体に夢中な感じで\n※人妻なのでむっちむちのドスケベエロ爆乳　乳輪もいつもよりデカめでお願いします\n※リンディ提督は母乳が出る\n※ラストの正常位では　種付けとか赤ちゃんできちゃう　的な妊娠匂わせセリフを入れていただきたい\n\n以上、長くなりましたが\n\n是露巣さんの同人誌など、なのはストライカーズ前後時期くらいから、かれこれ10年来の愛読者で\n今回初めて好きなジャンル好きなキャラ好きなシチュ好きな作家さんとして、リクエストさせていただきました\nどうかご一考のほどをお願いします", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@zerosman/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 67736, "client_id": 1433570, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d039740/uploads/origins/f93acc22-9dea-449e-826a-18eb091a7218?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c8ea3d7b4ae2f6778b661d9c85436f4", "srcset": "https://si.imgix.net/4d039740/uploads/origins/f93acc22-9dea-449e-826a-18eb091a7218?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c8ea3d7b4ae2f6778b661d9c85436f4, https://si.imgix.net/4d039740/uploads/origins/f93acc22-9dea-449e-826a-18eb091a7218?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=2