頼をさせていただくので、なんかこう、ふわふわしたようなことしか言ってないような気もするのですが、指定していない部分や理解が及ばない部分はアガタさんの感性にお任せしようかなと思います！アガタさんの元で通過した『祓え一閃』がとても楽しかったので、せっかくならと硯をお願いさせていただきたく…！お引き受けいただけたら幸いです。\n何卒よろしくお願いいたします。\n\nしんぐう", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 690248, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "faPka🍤", "screen_name": "fapkapukapuka", "avatar_url": "https://pbs.twimg.com/profile_images/1403302588817100805/3EdNs2Tq.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1155067224228372480/1775044360/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 128}, {"id": 1079411, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "f", "screen_name": "_n__ff", "avatar_url": "https://pbs.twimg.com/profile_images/1537875182786052096/LcNzu-Rj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1294218272053719040/1634344620/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 1191811, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "semicolon@skeb募集中", "screen_name": "semi_semi_man", "avatar_url": "https://pbs.twimg.com/profile_images/1938649739689631746/lyAeRkLI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1357480968416710656/1767338218/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept