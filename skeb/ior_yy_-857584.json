n・個人鑑賞\n・相方のフォロワーさんへのイラスト共有\n・利益の発生しない個人的なグッズの作成\n・SNSのアイコンやヘッダーへの使用（使用時はお名前とID記載）\n\n\n▪️資料URL\nhttps://drive.google.com/drive/folders/1ZCETKHXSoHV1ukkGVYjgAwDJb7Zg8VyB\n\n\nキャラクターの服装や髪型など、分かりにくい部分があれば書きやすいように簡略化・改変していただいてかまいません。\nお忙しい中だと思いますが、ご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1ZCETKHXSoHV1ukkGVYjgAwDJb7Zg8VyB", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ior_yy_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 990849, "client_id": 3252081, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f330ac6/uploads/origins/ae96773d-5095-4989-b5c8-c76b072a7859?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55884610cdabc779115547fd49b98f07", "srcset": "https://si.imgix.net/3f330ac6/uploads/origins/ae96773d-5095-4989-b5c8-c76b072a7859?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=55884610cdabc779115547fd49b98f07, https://si.imgix.net/3f330ac6/uploads/origins/ae96773d-5095-4989-b5c8-c76b072a7859?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=333ee070d67fcc42c059f316dfbe920c 2x, https://si.imgix.net/3f330ac6/uploads/origins/ae96773d-5095-4989-b5c8-c76b072a7859?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c95477c29e03d06964e595bb0db5f057 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f330ac6/uploads/origins/ae96773d-5095-4989-b5c8-c76b072a7859?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b018becddf8ccfb4d29ce95456a8afda", "srcset": "https://si.imgix.net/3f330ac6/uploads/origins/ae96773d-5095-4989-b5c8-c76b072a7859?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b018becddf8ccfb4d29ce95456a8afda, https://si.imgix.net/3f330ac6/uploads/origins/ae96773d-5095-4