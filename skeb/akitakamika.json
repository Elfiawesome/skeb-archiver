et/9142e1c1/uploads/origins/79feae37-8c7e-4ce5-a91f-22ffdf725059?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0c697f74c5f12fc278f0159f6a826a8a, https://si.imgix.net/9142e1c1/uploads/origins/79feae37-8c7e-4ce5-a91f-22ffdf725059?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed908c88f0ffef2faffd0540cd2bf734 2x, https://si.imgix.net/9142e1c1/uploads/origins/79feae37-8c7e-4ce5-a91f-22ffdf725059?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=939997a8af750bb80d9aa3eb6aee0822 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9142e1c1/uploads/origins/79feae37-8c7e-4ce5-a91f-22ffdf725059?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e107bb33d8c7beaa890e436d4a91c5ff", "srcset": "https://si.imgix.net/9142e1c1/uploads/origins/79feae37-8c7e-4ce5-a91f-22ffdf725059?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e107bb33d8c7beaa890e436d4a91c5ff, https://si.imgix.net/9142e1c1/uploads/origins/79feae37-8c7e-4ce5-a91f-22ffdf725059?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6e3164fdbf465157510f26940984e7e4 2x, https://si.imgix.net/9142e1c1/uploads/origins/79feae37-8c7e-4ce5-a91f-22ffdf725059?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3bd49ca3cab9d1add2a8a72d8065660e 3x"}, "body": "Hゲームのバッドエンド百合シーンをリクエストしてもよろしいでしょうか？アームズブレス?\n出典：https://www.dlsite.com/maniax/work/=/product_id/RJ304391.html\n\n主人公はベスと呼ばれるアンドロイドの少女。彼女は研究所で作られた殺人マシンで、近くの森に逃げ込んだ。そこには、同じく脱走した実験体であるアルラウネがいます。ベスは倒され、そしてツルで犯される......。\nリンク先の1枚目と4枚目のプレビュー画像から、この状況を確認することができます。\n\nポーズは、https://www.pixiv.net/en/artworks/88074266 に近いものを希望します。\n二人の顔が見えるようにしてください、二人は情熱的なキスをしています（口を閉じたキスです）。ベスはキス中にオーガズムを感じているため、表情はアヘ顔になっています。ベスの両穴にはツルが射精しており、彼女の衣装はズタズタに引き裂かれています。彼女は鮮やかに赤らんでいる。\n\nご検討のほど、よろしくお願いいたします", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akitakamika/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1149293, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28c2a731/uploads/origins/71283de6-cd5d-4378-9cc0-82ed2b157776?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0e20ace6094558d03763e06215be054", "srcset": "https://si.imgix.net/28c2a731/uploads/origins/71283de6-cd5d-4378-9cc0-82ed2b157776?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0e20ace6094558d03763e06215be054, https://si.imgix.net/28c2a731/uploads/origins/71283de6-cd5d-4378-9cc0-82ed2b157776?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d689e77467e54e12c0e2f50033b6e82 2x, https://si.imgix.net/28c2a731/uploads/origins/71283de6-cd5d-4378-9cc0-82ed2b157776?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a265ca9115214ba1c4aecb31ce4cfeda 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28c2a731/uploads/origins/71283de6-cd5d-4378-9cc0-82ed2b157776?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b74e97c8f76f81eeb9c813c1725516a7", "srcset": "https://si.imgix.net/28c2a731/uploads/origins/71283de6-cd5d-4378-9cc0-82ed2b157776?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b74e97c8f76f81eeb9c813c1725516a7, https://si.imgix.net/28c2a731/uploads/origins/71283de6-cd5d-4378-9cc0-82ed2b157776?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ffad026e35882347d4c981b2d9a9903a 2x, https://si.imgix.net/28c2a731/uploads/origins/71283de6-cd5d-4378-9cc0-82ed2b157776?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a8c9ef6e2c29d03092472aa66ea7b13c 3x"}, "body": "あき様は百合レズが好きな方なので\n「夏神楽」の退魔巫女「音羽桂香」が雪女に犯されるという\nシチュエーションをリクエストしてみようと思いました。\n\nhttps://www.debonosu.jp/debonosu/game/natsu/character.html?chara=0\nhttps://www.debonosu.jp/debo/game/reimeiki_17/index.html\n\n神楽シリーズでは定番ネタなのですがこの娘だけはないのです…\n\n神楽シリーズにおける雪女の特徴として\n\n①ディープキスをして冷気と冷たい唾液を送り込む\n②氷で作った疑似男根を生やして女を犯し\n　それから妖気の混じった液を子宮に放つ\n\nというものです\n毎度だいたい参考画像のような感じになってます\nキスをしながらの正常位セックスですね\n雪女の性格は母性的であったりドＳだったり様々です\n\nモノが生モノではなく氷ですので趣味でないかもしれませんが\nその場合は気軽にキャンセルなさってくださいませ\n\nhttps://dec.2chan.net/up/src/f46027.jpg", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 10454, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "他んぼ", "screen_name": "hokanbo", "avatar_url": "https://pbs.twimg.com/profile_images/1441058258542743552/-BzzBGIk.jpg", "header_url": "https://pbs.twimg.com/profile_banners/101177212/1756862803/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 176}, {"id": 26784, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "TORANKI_MJ🔞", "screen_name": "tranquillianus", "avatar_url": "https://pbs.twimg.com/profile_images/1800837224394797056/Qbk7Lx2i.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3169365619/1718187948/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 40, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 33}, {"id": 55986, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "２号", "screen_name": "2go_", "avatar_url": "https://pbs.twimg.com/profile_images/344513261571085971/4b67d0c2b7