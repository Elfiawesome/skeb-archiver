るモデル活動。\n髪を切らない分には結うなり編むなり巻くなりと髪型変えたりする。\nキュートな服もセクシーな服も着るが、服によって恥ずかしがることもある。\n服や髪型をどうするか、何枚描くかはお任せします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 118230, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "キユー", "screen_name": "KIYU_queue", "avatar_url": "https://pbs.twimg.com/profile_images/1992938738151030784/7XaOegQW.jpg", "header_url": "https://pbs.twimg.com/profile_banners/30816721/1595238661/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 0}, {"id": 201555, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Sirotuki", "screen_name": "Sirotuki_nown", "avatar_url": "https://pbs.twimg.com/profile_images/1645529993756413954/1I2pMxjU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1023244582056644608/1725803295/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 2126674, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "bi nazuka", "screen_name": "bi_oekaki", "avatar_url": "https://pbs.twimg.com/profile_images/1591958265012822016/p6IC3ly9.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1223981413310988294/1708089826/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 80, "skills": [{"genre": "art"}], "