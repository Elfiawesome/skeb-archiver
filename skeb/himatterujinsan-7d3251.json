るモデル活動。\n髪を切らない分には結うなり編むなり巻くなりと髪型変えたりする。\nキュートな服もセクシーな服も着るが、服によって恥ずかしがることもある。\n服や髪型をどうするか、何枚描くかはお任せします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 443348, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "wss.s", "screen_name": "wsss_rauha", "avatar_url": "https://pbs.twimg.com/profile_images/1373565254181953540/N_owhCfL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1190246398509211648/1613312756/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 1326306, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "れいとうまち", "screen_name": "reitumachi", "avatar_url": "https://pbs.twimg.com/profile_images/2035743960053006336/P6lY-_7P.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1395697934100881414/1713391368/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 1652098, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "犬プール", "screen_name": "1nupool", "avatar_url": "https://pbs.twimg.com/profile_images/1726188705382301696/k3SFA2Va.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1289480335793639424/1681900890/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "video"}], "banned": fa