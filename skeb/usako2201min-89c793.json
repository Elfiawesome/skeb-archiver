申します\nウさ子様のイラストを拝見させていただきぜひ自分も書いていただきたいとおもいリクエストさせて頂きました！\n使用用途\n収益化済み配信、サムネ等\nSNSでの投稿、アイコン等\n商用利用をつけて頂きたいです\n\n表情、ポーズなどはウさ子様におまかせでお願いしたいです\n\n國神李月↓\n神界から人間界へ料理修業にきた現役シャム猫調理師\n食べるのが大好きな明るく元気な女の子\nチルく、時々Ponしながらゲーム配信をしています\n\nお忙しいと思いますがぜひご検討いただければと思います\nよろしくお願いします\n\nhttps://drive.google.com/file/d/1OWw0W_BBiM58xIBmuTqZMTvaSbweDSQh/view?usp=drivesdk", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@usako2201min/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3932015, "client_id": 3936455, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4e937e31/uploads/origins/a07e844e-2aa6-4b77-9b75-b4a1768b2fb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13730919473dde5a1b328ced1fe1b1c1", "srcset": "https://si.imgix.net/4e937e31/uploads/origins/a07e844e-2aa6-4b77-9b75-b4a1768b2fb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13730919473dde5a1b328ced1fe1b1c1, https://si.imgix.net/4e937e31/uploads/origins/a07e844e-2aa6-4b77-9b75-b4a1768b2fb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4cc8ab2598d74b37ae589ce997463a16 2x, https://si.imgix.net/4e937e31/uploads/origins/a07e844e-2aa6-4b77-9b75-b4a1768b2fb4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c67d67ab644ab247946a9f647852b40a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4e937e31/uploads/origins/a07e844e-2aa6-4b77-9b75-b4a1768b2fb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e09b9f89cec723efa554c431f96fdde", "srcset": "https://si.imgix.net/4e937e31/uploads/origins/a07e844e-2aa6-4b77-9b75-b4a1768b2fb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e09b9f89cec723efa554c431f96fdde, https://si.imgix.net/4e937e31/uploads/origi