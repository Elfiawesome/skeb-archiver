=200&blur=200&s=d7197504ba9f864b46c16f9ebc30854a 3x"}, "body": "こんにちは！\n\n「豚のレバーは加熱しろ」のブレースの真上からの主観視点で挿入してハメてる中出しバックセックスおなしゃっす！！！\n私のポートフォリオを参照していただければ、どういう構図か非常にわかりやすいと思います。\n\n背景は薄暗い森の中で。\n服装は作品内で着ているローブお願いします！\n\nアニメ8話の15分あたりのような、無表情で！\n悪人に手籠めにされて虚ろになってるシチュです！\nセックスしつつこっち振り向いている感じですかね\n\n服はきたまま、ローブをたくし上げてお尻が見えてる感じで！\n\n筆が乗れば、ローブのフードを被ってる・無し差分、表情の泣き顔差分もお願いします。\n\n太ももに薄いオレンジのおぱんつ引っかけてください！！！（色はpccsのlt6のイメージ）\n\n画像サイズは縦3000ピクセル以上の大きな画像で、psdでお願いします！", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@HRAgu2/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3567197, "client_id": 461653, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a92cd2f/uploads/origins/9f56a9f1-72b0-4376-a8fc-e441e7ac7841?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7231dde9e0c951d792fc87a6a4bf3452", "srcset": "https://si.imgix.net/8a92cd2f/uploads/origins/9f56a9f1-72b0-4376-a8fc-e441e7ac7841?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7231dde9e0c951d792fc87a6a4bf3452, https://si.imgix.net/8a92cd2f/uploads/origins/9f56a9f1-72b0-4376-a8fc-e441e7ac7841?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5d3443f29ffd5706c7ac9fa0bd1e840 2x, https://si.imgix.net/8a92cd2f/uploads/origins/9f56a9f1-72b0-4376-a8fc-e441e7ac7841?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6f828fda050247a1bae29bc77e0813ff 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8a92cd2f/uploads/origins/9f56a9f1-72b0-4376-a8fc-e441e7ac7841?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2375bcb0dd1261f25085fa4b0d35656e", "srcset": "https://si.imgix.net/8a92cd2f/uploads/origins/9f56a9f1-72b0-4376-a8fc-e441e7ac7841?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2375bcb0dd1261f25085fa4b0d35656e, https://si.imgix.net/8a92cd2f/uploads/origins/9f56a9f1-72b0-4376-a8fc-e441e7ac7841?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9371a8510ce9315c03b0974209e0889f 2x, https://si.imgix.net/8a92cd2f/uploads/origins/9f56a9f1-72b0-4376-a8fc-e441e7ac7841?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b46ef0bbc2ea6bb9aa4efaff18d86c36 3x"}, "body": "初めまして\n\n赤城さん（艦これ）が思い余って提督を押し倒してエッチしているイラストをお願いします\n\n・赤城が上の体位\n・提督を慰め癒してあげたいという気持ち半分、単に好機と見た女としての感情半分\n・提督は映らなくて良いです。映っても単色のシルエットなど簡略的なもので顔は無し。\n・艤装は無しで、いつもの服か簡素な私服\n・胸は開けて見えていてほしいです\n・提督に思いの丈をぶつけるような台詞を書いて下さい\n\nとにかく感情強めで、鎮守府の立ち上げ当初から秘書艦として仕えている提督の御相伴に預かって談笑していたら珍しく酔った口から自分にも恋人はいたが配属前に深海棲艦に襲われて亡くしてしまいそれ以来浮ついた話は無いというような話を聞いた赤城さんが行動に移している姿を見たいですご検討願います", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@HRAgu2/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3567197, "client_id": 1186578, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/284d8d76/uploads/origins/b145d88c-5e3b-4df7-a251-1607ecff7da3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6501824b0e5aea93dc456ecfa499c8e", "srcset": "https://si.imgix.net/284d8d76/uploads/origins/b145d88c-5e3b-4df7-a251-1607ecff7da3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e6501824b0e5aea93dc456ecfa499c8e, https://si.imgix.net/284d8d76/uploads/origins/b145d88c-5e3b-4df7-a251-1607ecff7da3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f1c75200e9490e78fa86f99963be2cd 2x, https://si.imgix.net/284d8d76/uploads/origins/b145d88c-5e3b-4df7-a251-1607ecff7da3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39147c8e4ab141c49a3603b8c7d60cc6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/284d8d76/uploads/origins/b145d88c-5e3b-4df7-a251-1607ecff7da3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c21e4747c6f2626e4f4e38ab2abea6c3", "srcset": "https://si.imgix.net/284d8d76/uploads/origins/b145d88c-5e3b-4df7-a251-1607ecff7da3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c21e4747c6f2626e4f4e38ab2abea6c3, https://si.imgix.net/284d8d76/uploads/origins/b145d88c-5e3b-4df7-a251-1607ecff7da3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3fcd3dc6f76d14ad714d134002e2bf34 2x, https://si.imgix.net/284d8d76/uploads/origins/b145d88c-5e3b-4df7-a251-1607ecff7da3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b3d5342cdbac6bdf52d0250910ad7156 3x"}, "body": "ジュネ(殴)10のハラナリさんこんにちは( ᐛ )\nふと雲龍のケッカリ後のボイスを聞いて\nあ、こういう絵が欲しいなと思いリクエストさせて頂きました\n\n構図は、最前線で指揮してる提督に流れ弾が飛んで来て生死不明で雲龍が急いで来て、倒れてる提督を見つけて崩れ落ち提督の左手を雲龍が両手で握って雲龍が［提督生きてますよね？］って言って\nルート分岐(生きてるverは提督が生きてて、「 あぁ生きてるよ雲龍」)って言って雲龍が泣きながら「良かった」って言ってるシーンと\n(提督戦死verは提督は何も返答せずに、雲龍は「...」何も喋らない)シーンの計3枚をお願いしたいです\n\nもし可能なら雲龍と提督両方に指輪は付けてほしいですプラスでTwitterのヘッダーにしたいので横長こちらも可能ならお願いします\nご検討の程宜しくお願い致します(＞人＜;)", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@HRAgu2/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3567197, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d5b22f0/uploads/origins/7e6b4839-8ba1-47a5-87af-079726b551f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df6659ca3076af1685a5b62d133a15c0", "srcset": "https://si.imgix.net/8d5b22f0/uploads/origins/7e6b4839-8ba1-47a5-87af-079726b551f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df6659ca3076af1685a5b62d133a15c0, https://si.imgix.net/8d5b22f0/uploads/origins/7e6b4839-8ba1-47a5-87af-079726b551f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b9f4eec173359e5b6185303bfd60b01b 2x, https://si.imgix.net/8d5b22f0/uploads/origins/7e6b4839-8ba1-47a5-87af-079726b551f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34ed5c40443c741d83d2b5eff35df6d2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d5b22f0/uploads/origins/7e6b4839-8ba1-47a5-87af-079726b551f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db68ade6e267ad1de76fe8d4059b757b", "srcset": "https://si.imgix.net/8d5b22f0/uploads/origins/7e6b4839-8ba1-47a5-87af-079726b551f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db68ade6e267ad1de76fe8d4059b757b, https://si.imgix.net/8d5b22f0/uploads/origins/7e6b4839-8ba1-47a5-87af-079726b551f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fff04780392689ff1092d84e21134d7a 2x, https://si.imgix.net/8d5b22f0/uploads/origins/7e6b4839-8ba1-47a5-87af-079726b551f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3665a26130e9835a9c5141698a5fae72 3x"}, "body": "艦娘に危害を加えるのは深海棲艦だけじゃないってことで…\nキャラは艦これの照月ちゃん\nおっぱい丸出しのパンイチ（胸は大きいけど乳首はまだ小さいザＪＣと言わんばかりな年頃の女の子のおっぱいでお願いします！）\n単艦退避中に海賊に捕まった模様\n照月の頭に拳銃突きつけながらフェラさせてる\n顔に少しアザがあり、悔しそうに男を睨みながら涙を流しジュッポジュッポ♡と激しいフェラをする照月\n「ヘヘッ…、艤装が大破してりゃただのガキも同然…こんなもんよ…」\n「イきそうだ…射精すぞ…！！」\nビュグッ♡ビュグッ♡と口内射精\n「あぁ〜たまんねぇなぁ！ガキの口マンコは！」\n出し切った後にちゅぽん♡と口からチンコを離し「うぅ…」と泣きながら口を拭う照月\n違う男に髪を掴まれまた口にチンコを突っ込まれる照月\n「んぐぅ！」\n「おっと！休む暇はないぜぇ！奴隷として売り捌くまでしっかりと楽しませてもらうからなぁ！」\n\n以上です！\n竿は可能なら黒海苔で！\nデータはpsdで頂きたいです！", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@HRAgu2/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3567197, "client_id": 643959, "vtt_url": null, "thumbnail_image_urls": {"src": 