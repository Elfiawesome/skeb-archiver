fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1ece6daa6c7db5ac0ac695c9a404c76", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2544c040/uploads/origins/0a519698-7834-4bd1-b884-5b3a3cf14628?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ff16d74d68fb31d2ef12c86460ec8f3", "src_set": ""}, "body": "今回は、エロガキとの暗号バトルの一環として、 濃姫さんが「箱の中身はなんだろな」をさせられるシチュエーションをリクエストさせていただきます。しかし、中身が何か分からないままエロガキのチンポを触り続けてしまい、結果としてエロガキを射精に導いてしまう... という流れになります。もし分かりづらい点や不都合がございましたら、適宜調整していただいて構いません。どうぞよろしくお願いいたします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AdamSarcv/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 219571, "client_id": 468449, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/831dbcb1/uploads/origins/6597eaa0-4bfc-4e8f-b28e-4898f672514a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cefde8f7156f3f09bbe90c08c5ce5a5f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/831dbcb1/uploads/origins/6597eaa0-4bfc-4e8f-b28e-4898f672514a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6fbbe8df216046845f041914d8fd261c", "src_set": ""}, "body": "今回は、潜入捜査とある組織にしていた蜂起星さんが、その組織の宴会でセクハラされたり、酔った勢いでズボン越しにおちんぽを揉まされたり、そのままエスカレートして生おちんぽをしごかされ、生搾りザーメンを自分のジョッキに入れられ、宴会芸としてそれを一気飲みさせられるシチュエーションをリクエストさせていただきます。\n分かりづらかったり何か問題があれば変更していただいて大丈夫です。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AdamSarcv/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 219571, "client_id": 468449, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7d18c297/uploads/origins/db6ce201-ebff-4bf8-b738-012f9e024e02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee0068fc1b46f0cf4644e592f2fabaa0", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7d18c297/uploads/origins/db6ce201-ebff-4bf8-b738-012f9e024e02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02acba23acd3db9a7cc8d769afd808df", "src_set": ""}, "body": "不沈空母本体のサルベージを協力して貰う代わりに、政府高官の息子であるエロガキの包茎チンカスチンポをチン媚びしながらチン嗅ぎレビューと恋人にするようなキスをチンポにさせられる要塞村さん。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AdamSarcv/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 219571, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/84dfb3f9/uploads/origins/a8c1701c-5c32-4f93-b912-0b0d70d14376?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2d3b831d58f3eac5a8b0c311a033a067", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/84dfb3f9/uploads/origins/a8c1701c-5c32-4f93-b912-0b0d70d14376?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5dcae75b2e9a4a60f62273db37bea626", "src_set": ""}, "body": "はじめまして\nいつも暗号学園を含めたジャンプ掲載のマイナーな漫画のR18イラストを描いてくださり誠にありがとうございます\nあなたのおかげでいつも救われています\n初Skebなため至らぬ点があればご容赦ください\n暗号学園のR18イラストで、東洲斎組といろはのハーレムエッチをお願いします\n\n■希望のイラスト\n概要：綿菓子と多夕がいろはを挟み込み動けないようにしつつ、享楽が騎乗位でいろはとSEXをしているシーン\n綿菓子と多夕は代わる代わるいろはとディープキスしていて、キスしてない方は耳元で｢自分達の事はオナホだとでも思って好きに犯していい｣｢財産も地位も全部捧げるから結婚して一緒に幸せになって欲しい｣みたいなセリフを囁いている\n享楽はSEXに夢中で吐息といろはの名前を呼ぶくらいでセリフは無し\nいろはは最初は説得しようとしたり(キスで塞がれるため何も言えない)抵抗しようとしているが、段々抵抗が弱々しくなってついに射精してしまう\nいろはが射精する時は享楽が身を乗り出してキスをして、2人は｢びゅ〜っ♡｣って射精の音を囁いて射精のサポートする感じでお願いします\n射精後に着床したことを示す図も入れてくれると嬉しいです\n\n□セリフの傾向\n綿菓子\n最初は襲ったことへの申し訳なさから謝罪や責任は取る的な事を言ってるけど、最後の方では｢あなたがかっこよすぎるのもいけないんですよ♡｣みたいな逆ギレ責任転嫁も混ざったセリフ\n多夕\n最初は上から目線な態度だけど、最後の方では｢アタシとお前に似たかわいい赤ちゃん沢山作るからな♡｣みたいな好意と愛情が漏れ出てるセリフ\n\n□シチュエーション\nいろはへの好感度が限界突破した東洲斎組が我慢できなくなり、いろはを襲ってしまうというシチュエーションでお願いします\n\n\n□構図\n稚拙ながら自作のイラストで構図の例を作成致しました\n見苦しいですが参考程度にこのような感じでお願いします\nもちろん完全に従う必要は無いため自由に変えていただいて結構です\n\nhttps://f.yourl.jp/023253b7/", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AdamSarcv/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 219571, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/facd73a4/uploads/origins/66386cdf-a7a5-42fb-ba94-b0316195c165?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e0bcd43dfe14f3c2daa63b66c6ef364e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/facd73a4/uploads/origins/66386cdf-a7a5-42fb-ba94-b0316195c165?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f331e3f663e9ceb7e89605c8f7e20f6c", "src_set": ""}, "body": "土下座でめちゃくちゃお願いされて渋々チンカス汚チンポを顔コキさせてくれる綿菓子さん", "nc": 179, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AdamSarcv/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 219571, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/258fcc93/uploads/origins/4fd89d08-501c-40bc-8e1d-d96dc2a5591f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60a23afd26767920533b6cac055bacc5", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/258fcc93/uploads/origins/4fd89d08-501c-40bc-8e1d-d96dc2a5591f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9f05ae2ca75e94f2a32a1925e7e498c", "src_set": ""}, "body": "お疲れ様です。\nいつも作品楽し