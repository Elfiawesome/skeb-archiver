n血液（けつえき）： 青色（あおいろ）\n能力（のうりょく）： 獲物（えもの）に「安全（あんぜん）」という幻覚（げんかく）を見せる催眠（さいみん）ガスを分泌（ぶんぴ）し、その隙（すき）に捕食（ほしょく）を行う。\n職業（しょくぎょう）： 殺し屋（ころしや）\n外見の特徴：普段は冷静で無表情ですが、狩りの瞬間だけ瞳孔が黒から淡いピンク色に変化します。\n舌は蛇のように分かれ、口元には小さな牙が見えます。髪は蔓のように自発的に動き、感情や食欲が揺らぐと、生き物のように伸びていきます。\n\n感想をもとに自由に描いていただければ幸いです。作品は商業的に使用されません。\n\nありがとうございます\n\nhttps://drive.google.com/drive/folders/18j0G-0ZVdUneNMqQ7NRwYkZlvX8bBscY?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ss___a__/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2698687, "client_id": 1102914, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62189c52/uploads/origins/b576b804-6b92-4a41-b443-7e2c7e0319fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=881932ddee65771f0e42dbbc640410b9", "srcset": "https://si.imgix.net/62189c52/uploads/origins/b576b804-6b92-4a41-b443-7e2c7e0319fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=881932ddee65771f0e42dbbc640410b9, https://si.imgix.net/62189c52/uploads/origins/b576b804-6b92-4a41-b443-7e2c7e0319fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70bb733905405a3b2c3f9a62c2282a3c 2x, https://si.imgix.net/62189c52/uploads/origins/b576b804-6b92-4a41-b443-7e2c7e0319fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d27b6cfe44e0b4b0ad646b867c2c9fd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62189c52/uploads/origins/b576b804-6b92-4a41-b443-7e2c7e0319fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82bdaaf851e706162e3d290e44aea876", "srcset": "https://si.imgix.net/62189c52/uploads/origins/b576b804-6b92-4a41-b443-7e2c7e0319fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82bdaaf851e706162e3d290e44aea876, https://