思いますがご検討頂けますと幸いです。  よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1pcgo4MferIcK5FSM0pop6HeKKba4qd8L", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@untgomi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3706950, "client_id": 2976519, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/922b9544/uploads/origins/87cf7a3b-75dc-445f-a372-261a954ccc83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9b995ae153ce19b7313d652abe89bb8", "srcset": "https://si.imgix.net/922b9544/uploads/origins/87cf7a3b-75dc-445f-a372-261a954ccc83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b9b995ae153ce19b7313d652abe89bb8, https://si.imgix.net/922b9544/uploads/origins/87cf7a3b-75dc-445f-a372-261a954ccc83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5d7029e24322d23649a775018ce702e 2x, https://si.imgix.net/922b9544/uploads/origins/87cf7a3b-75dc-445f-a372-261a954ccc83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=53e6865dcaba953ba485ad892fbedaa5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/922b9544/uploads/origins/87cf7a3b-75dc-445f-a372-261a954ccc83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab7b86e12e8a8ad9108a547de7c73c81", "srcset": "https://si.imgix.net/922b9544/uploads/origins/87cf7a3b-75dc-445f-a372-261a954ccc83?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab7b86e12e8a8ad9108a547de7c73c81, https://si.imgix.net/922b9544/uploads/origins/87cf7a3b-75dc-445f-a372-261a954ccc83?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b7e6cf20ccc2d4af98612b8681793e0c 2x, https://si.imgix.net/922b9544/uploads/origins/87cf7a3b-75dc-445f-a372-261a954ccc83?