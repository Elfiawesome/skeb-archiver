てください！彼はピンクやブルーのかわいらしい服装が好きで、かわいいスニーカーやコンバースが一番好きです。\n\n体格は女性的で小柄。小さな男の子で、手も繊細（服に合わせてネイルを塗るのが好き）。\n\n性格はまだ未完成だが、いい子だ。唖なので話すことができず、手話とノートでコミュニケーションをとっている。\n\n 彼の笑顔は明るいです！モチーフはイチゴと鳥です！もしそういったものを取り入れてもらえたら、とてもありがたいです。\n\n ジェーンを考えてくれたら嬉しいです！ありがとうございました。🙇‍♂️", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@untgomi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3706950, "client_id": 2850616, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/412b6d48/uploads/origins/870ce992-0e5d-44df-a890-255173a8258f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe7d516c385d9e4cfdcfc249171c08b2", "srcset": "https://si.imgix.net/412b6d48/uploads/origins/870ce992-0e5d-44df-a890-255173a8258f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fe7d516c385d9e4cfdcfc249171c08b2, https://si.imgix.net/412b6d48/uploads/origins/870ce992-0e5d-44df-a890-255173a8258f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=de7de63990c660f4dd338fb850f8e573 2x, https://si.imgix.net/412b6d48/uploads/origins/870ce992-0e5d-44df-a890-255173a8258f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a394d1d0291c7ba65d2b509fecdcf3c1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/412b6d48/uploads/origins/870ce992-0e5d-44df-a890-255173a8258f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9a15d64e37f0a01aaec02b5505d8cd9", "srcset": "https://si.imgix.net/412b6d48/uploads/origins/870ce992-0e5d-44df-a890-255173a8258f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9a15d64e37f0a01aaec02b5505d8cd9, https://si.imgix.net/412b6d48/uploads/origins/870ce992-0e5d-44df-a890-255173a8258f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=