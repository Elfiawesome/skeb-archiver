7699093-27fb-4e38-960a-bd99f66ec98a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c90827dde2dbbb3359efcb90ad62c72, https://si.imgix.net/0aa970af/uploads/origins/f7699093-27fb-4e38-960a-bd99f66ec98a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4b54cd70fe785d300eb38d5dc0c32ac5 2x, https://si.imgix.net/0aa970af/uploads/origins/f7699093-27fb-4e38-960a-bd99f66ec98a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=32ea9b1af28967191f8245110b3d8ad0 3x"}, "body": "こんにちは、ヒーン様！\nあなたの作品がとても好きです。もしよろしければ、ぜひ私のOCを描いていただけると嬉しいです。\n\n特別な条件はありません。二人の性格の範囲内であれば、どんなやり取りを描いても自由です！\nリンク先に設定の詳細と情報を記載しました。描きたいコスチュームも自由です！\n\n金額が足りない場合、再送いただければと思います。良ければご検討いただけますと幸いです。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1ZPG8co0rVU-VH4RkqoZbidYWnJkY5b4C?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@untgomi/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3706950, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e346ac23/uploads/origins/65d5498a-de7f-4ee8-98a3-b492c42f1c27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5338039ea4a6228eb382afebb4b768c", "srcset": "https://si.imgix.net/e346ac23/uploads/origins/65d5498a-de7f-4ee8-98a3-b492c42f1c27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5338039ea4a6228eb382afebb4b768c, https://si.imgix.net/e346ac23/uploads/origins/65d5498a-de7f-4ee8-98a3-b492c42f1c27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89d3cf6d85c8efa0325952c160380224 2x, https://si.imgix.net/e346ac23/uploads/origins/65d5498a-de7f-4ee8-98a3-b492c42f1c27?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e607f49f92f0d09eb2eb479a970836c 3x"}, "duration": null, "nsfw": false, "hardcore": fal