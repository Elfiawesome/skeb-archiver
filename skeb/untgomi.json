ff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=448ecfe127978cebfab16b74339ec80b, https://si.imgix.net/25792779/uploads/origins/bea069f7-30f6-40ae-896e-9e7c8de72878?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3d5c4297f12153a674f519fc813f96fa 2x, https://si.imgix.net/25792779/uploads/origins/bea069f7-30f6-40ae-896e-9e7c8de72878?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=637b6011518526b287b626ac4b82ebd9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/25792779/uploads/origins/bea069f7-30f6-40ae-896e-9e7c8de72878?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8181638c33414608b47584f8dc4e25cb", "srcset": "https://si.imgix.net/25792779/uploads/origins/bea069f7-30f6-40ae-896e-9e7c8de72878?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8181638c33414608b47584f8dc4e25cb, https://si.imgix.net/25792779/uploads/origins/bea069f7-30f6-40ae-896e-9e7c8de72878?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=441198a2a0b4197949fd2c1994584b0d 2x, https://si.imgix.net/25792779/uploads/origins/bea069f7-30f6-40ae-896e-9e7c8de72878?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c48e4aec0401767f732a5eb2a02c7b8c 3x"}, "body": "ヒーン先生こんにちは。\nヒーン先生の作品がとても好きです！ もしよろしければ、ぜひ私と友人のCOC探索者を描いていただきたいです。\n\nもし依頼内容や金額が合わない、また資料に誤りがある場合は、再度リクエストを送り直していただければ幸いです。\nその他ご不明な点がございましたら、依頼をキャンセルしていただいても構いません。\nありがとうございます！\n\nhttps://drive.google.com/drive/folders/1uUEhes35k2l2tFUchiHToDkqz-kSNQt3?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@untgomi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3706950, "client_id": 2998972, "vtt_url": null, "thumbnail_image_urls": {"src":