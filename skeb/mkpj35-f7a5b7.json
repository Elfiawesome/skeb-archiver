uto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3e55977ca9442c7c0e7ae1923b54278b 3x"}, "body": "こんにちは、私は翻訳機を使っています。表現が不適切であればご容赦ください。 【依頼内容】 みやこさんの描く白黒漫画がすごく好きです💕 私のオリジナルも描いていただけると嬉しいです↓ https://drive.google.com/drive/folders/1-5PkKkp-WFRi63PlFgFGMnjEJo0LKV3p https://drive.google.com/drive/folders/1-5U-7HsTxuaE3gTF4q8uB8czsDUTwBTz 【キャラクター】 茶髪の女の子のキャラクター設定は、元気いっぱいの子犬系小学生です。彼は学業成績も体力も非常に悪く、特別なスキルもありませんが、とても人気があります。彼は方向感覚が悪く、記憶力も悪く、野菜が嫌いで、アイスクリームが大好きです。高さ約122cm。 黒髪の少女のキャラクター設定は、不死身で戦闘が得意だが常識に欠ける半妖の戦闘狂少女。彼は生意気で自信家で、人をいたずらするのが好きで、子供のように扱われることを嫌います。身長約151cm。 【注目ポイント】黒髪の少女は左目にハイライトがなく、右目のハイライトは星型、黒クマがあり、口の左下隅にホクロがあり、右手の包帯が左手より長い。 1人でも2人でも描けます。描いた内容は全部皆さんにあげたいので、気軽に遊んでくださいね(⁎⁍̴̛ᴗ⁍̴̛⁎)", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mkpj35/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3522639, "client_id": 2962543, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3864fbc0/uploads/origins/2a8204b8-6095-4903-961f-46794a489a0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e49988116ecfb8534e98f63e652e00de", "srcset": "https://si.imgix.net/3864fbc0/uploads/origins/2a8204b8-6095-4903-961f-46794a489a0e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e49988116ecfb8534e98f63e652e00de, https://si.imgix.net/3864fbc0/uploads/origins/2a8204b8-6095-4903-961f-46794a489a0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=efa2f08e92a35404a181665eaf90f01a 2x, https://si.imgix.net/3864fbc0/uploads/origins/2a8204b8-6095-4903-961f-46794a489a0e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0319b77b847845771585d1ca19ee8549 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3864fbc0/uploads/origins/2a8204b8-6095-4903-961f-46794a489a0e?bg=%23fff&