status/2022296697406415226\n\n幼なげな顔つきに青い瞳、色白の肌。\n身長は155cmの小柄。胸が大きい！\n資料画像の星と羽の髪飾りは必須です。\n\n片手にハンドベルを持つ。色とデザインは服装に合うイメージでお任せ。\n\n衣装の仔細はこちら。動画で失礼します。\nhttps://www.youtube.com/live/Noo0tBpkS_M?si=wAuxzWCI2dNaqBDr\n\n●ポーズなど\n背景は、聖歌隊が歌う聖堂のような建物内。\n木造建築であれば詳細お任せ。\n\nねむさんが片手でハンドベルを持ち、楽しそうに歌を歌っている。\n両目は開き、口も開く。\n口を閉じた差分もお願いします。\n\nねむさんの全身、頭から足元までを描いてください。\n大きな胸のボリューム感は大変重要です！\n\n可能であれば資料イラスト右側の、ケープを纏った差分もお願いします！\n\nねむさんの頭部全体を、イラスト枠内に収めて描いてください。\n人物だけを切り抜いた透過PNG or PSD形式納品があると助かります。\n※配信のサムネイルに利用しやすい為です。\n完成されたイラストは、白羽ねむ様ご本人による\nYoutube配信サムネイル、SNSの投稿等での使用許可を頂けると助かります。\n（ご使用なさらない場合もあります）\n\nご不明な点はお任せします！\n\nhttps://x.com/monaka_0326_/status/2022298565666918668", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aznasub/works/192", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 947711, "client_id": 970135, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a120cd62/uploads/origins/f4eaa0b7-fd1e-4fd4-b5e7-4a4f4ee892dc?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=6baaeec07fb8113d8a3ab3abc5d19ec9", "srcset": "https://si.imgix.net/a120cd62/uploads/origins/f4eaa0b7-fd1e-4fd4-b5e7-4a4f4ee892dc?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=6baaeec07fb8113d8a3ab3abc5d19ec9, https://si.imgix.net/a120cd62/uploads/origins/f4eaa0b7-fd1e-4fd4-b5e7-4a4f4ee892dc?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=30e0ebde6d2dacf45414c4c5ec1c4b94 2x, https://si.imgix.net/a120cd62/uploads/origins/f4eaa0b7-fd1e-4fd4-b5e7-4a4f4ee892dc?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=22f691c75637240c46528982d1187323 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a120cd62/uploads/origins/f4eaa0b7-fd1e-4fd4-b5e7-4a4f4ee892dc?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=436878bbdc78691618e2c42001e1