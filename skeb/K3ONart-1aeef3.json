=200&blur=200&s=fb2cc47afd91afacf7252c4852881bb1 2x, https://si.imgix.net/3834fc04/uploads/origins/77fe3e65-adce-48a7-8da7-9b43cf20ed48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=79886571bf8744e07b6b804e7225b5a0 3x"}, "body": "前回はありがとうございました。\nオリキャラの竜人シリュウがトラブルに見舞われた姿のイラストを\n情景イメージの内容からお任せしますので宜しければお願いします。\n\n・情景イメージ\n前回描いて頂いたこちらの続きイメージで\nhttps://skeb.jp/@K3ONart/works/10\nシリュウが財宝が置かれた部屋にやってきて周囲を確認していると\n少し離れた所に自分より二回り大きいくらいの幼竜が象られた金の像を見つけて\nあちこち触れて素晴らしいオブジェを持ち帰りたいと思っていたら\n不意に寒気を感じて触っていた手から金色の膜が広がっていって\nシリュウが自分の手や身体を見ながらアッと大きな口を開けたまま光沢が輝く金の像と化して新しい財宝になってしまったイメージ\n\n・シリュウ参考画像\nhttps://drive.google.com/file/d/1-g9y0ZEEtYGUAOp9MiPqWUj5_zIXLbS5/view", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@K3ONart/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 459565, "client_id": 17413, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c5a5a031/uploads/origins/df2dd008-bcc8-4f62-ae20-fd7137d4ed18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22be3188309ffe2268258c0a005ae505", "srcset": "https://si.imgix.net/c5a5a031/uploads/origins/df2dd008-bcc8-4f62-ae20-fd7137d4ed18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22be3188309ffe2268258c0a005ae505, https://si.imgix.net/c5a5a031/uploads/origins/df2dd008-bcc8-4f62-ae20-fd7137d4ed18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0280c887a8b7220520faa8683fc8aff 2x, https://si.imgix.net/c5a5a031/uploads/origins/df2dd008-bcc8-4f62-ae20-fd7137d4ed18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e12c1a387846ffc973f7e3c8de919bbc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c5a5a031/uploads/origins/df2dd008-bcc8-4f62-ae20-fd7137d4ed18?bg=%23fff&auto=format%2Ccompre