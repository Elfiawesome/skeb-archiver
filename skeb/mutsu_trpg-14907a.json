e_same_genre": true}, {"path": "/@mutsu_trpg/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2606226, "client_id": 1028966, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d4eadccd/uploads/origins/c2ded5a1-98fd-4e1e-a9a3-9037fb99e7ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a85f5398708bf4fa89ea80330cb8e6ac", "srcset": "https://si.imgix.net/d4eadccd/uploads/origins/c2ded5a1-98fd-4e1e-a9a3-9037fb99e7ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a85f5398708bf4fa89ea80330cb8e6ac, https://si.imgix.net/d4eadccd/uploads/origins/c2ded5a1-98fd-4e1e-a9a3-9037fb99e7ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d4ac413504b4b15d0c58332944bc4019 2x, https://si.imgix.net/d4eadccd/uploads/origins/c2ded5a1-98fd-4e1e-a9a3-9037fb99e7ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=62b1a498f440319f531b3b80063204a6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d4eadccd/uploads/origins/c2ded5a1-98fd-4e1e-a9a3-9037fb99e7ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=415bd019e34f0db3487d0850ff91accb", "srcset": "https://si.imgix.net/d4eadccd/uploads/origins/c2ded5a1-98fd-4e1e-a9a3-9037fb99e7ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=415bd019e34f0db3487d0850ff91accb, https://si.imgix.net/d4eadccd/uploads/origins/c2ded5a1-98fd-4e1e-a9a3-9037fb99e7ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6a953e9c76a17baad1bd3160848b94a6 2x, https://si.imgix.net/d4eadccd/uploads/origins/c2ded5a1-98fd-4e1e-a9a3-9037fb99e7ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3950c6cf9dfc3f1a85c8d382b31dcab2 3x"}, "body": "継続探索者の和服立ち絵の依頼をしたいです！\n今回お願いする探索者を、榎日シユ様作の灯路帰譚( https://www.pixiv.net/novel/show.php?id=16922246 )というシナリオで遊ぶ候補として考えています。\n灯路帰譚は探索者が和服を着るそうなので、灯路帰譚に行く場合でも、その他別のシナリオで私服差分としてでも使いたいなと思っています。\n\n探索者のキャラシURLは https://iachara.com/char/view/2467180 です。通過したシナリオ名のメモ欄にはネタバレが含まれますのでご注意ください。\n見た目については、GoogleドライブのURLを資料URLに添付いたします。\n「薊道 小春(あぜみち こはる)」という女の子で、見た目はオシャレですが中身はちょっと残念なところもある女の子です。明るく元気で、逞しいところもあります。女の子らしい、というよりは元気、という印象が目立ちます。\n\n和服の具体的なイメージは、伝統的な着付けというよりは少し洋風にアレンジしてある和服だと嬉しいです。\n帯締めの代わりにベルトを使ったり、中に立ち襟のシャツを着ていたり、襟がレースであったり、着物の下からスカートが覗いていたり、ブーツを履いていたり等々が洋風なイメージです。(イメージを挙げただけなので、全部取り入れてほしいというわけではないです！！)\n\n色味は、メインが青～藍系に、\nうちよそのお相手のイメージカラーが黄色(カラーコード#f0e68cあたり)なので、もし差し色などに迷われたら黄色を入れていただけると嬉しいです。\n\n服装ではないのですが、むつきさんの描かれる細かいネイルや、金属など小物の塗りがとっても好きです。\nお願いする探索者も普段ネイルをしているので、何か爪に施していただけるととても嬉しいです。\n\n可能な限り詳細にとのことだったので、かなり詳細に書いてみたつもりですが、\n足りなければ依頼キャンセルなどでお申しつけくださいませ。\n\n何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1flWuSYWbZl_FOqFw1wK00iGicXEkqwas?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1366068, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "お、", "screen_name": "ooo_0926", "avatar_url": "https://pbs.twimg.com/profile_images/1976456505617678337/k4n0GrRE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1393369213792751620/1768864254/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 33}, {"id": 1865298, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "こぞめ", "screen_name": "xxx_czm", "avatar_url": "https://pbs.twimg.com/profile_images/2026811849938026496/mbqfGxHd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1444839112494628874/1745334680/1500x500", "appeal_receivable": true, "popular_creat