n\n【セリフ】\n候補生(セリフのみ)\n「先生、地元の猟師さん達が同行を申し出てくれてますが」\n\n能代先生\n「願ってもないわね、この辺りについて私たちは知らない事ばかりだし」\n\n※逃走中の潜入型深海棲艦を追跡中、みたいなシチュエーションを想定しています\n\n\n以上のようなオーダーでお願いしたいです\n必要と判断されたアレンジは是非していただけたらと思います\n内容が多岐にわたってしまっているのですが、是非今回も四十川さんに描いて頂けたらと、心待ちにしております\nどうぞよろしくお願いいたします", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@whale_Shark_sig/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 969613, "client_id": 1461403, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ad48bca/uploads/outputs/06580def-c1dc-4a56-bae5-b41cf6d1ce08?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=8df50adab75885ea2b89c66aeede3eee", "srcset": "https://si.imgix.net/8ad48bca/uploads/outputs/06580def-c1dc-4a56-bae5-b41cf6d1ce08?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=8df50adab75885ea2b89c66aeede3eee, https://si.imgix.net/8ad48bca/uploads/outputs/06580def-c1dc-4a56-bae5-b41cf6d1ce08?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=5016acf6f4cd9ea0245af46924e4c458 2x, https://si.imgix.net/8ad48bca/uploads/outputs/06580def-c1dc-4a56-bae5-b41cf6d1ce08?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=7903705fe8c57de39de10d68ac635732 3x"}, "duration": 32, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ad48bca/uploads/outputs/06580def-c1dc-4a56-bae5-b41cf6d1ce08?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=49309f15e6540f963d5de0883da72a96", "srcset": "https://si.imgix.net/8ad48bca/uploads/outputs/06580def-c1dc-4a56-bae5-b41cf6d1ce08?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=49309f15e6540f963d5de0883da72a96, https://si.imgix.net/8ad48bca/uploads/outputs/06580def-c1dc-4a56-bae5-b41cf6d1ce08?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4616e9b1486141550ddee64