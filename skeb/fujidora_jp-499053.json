auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=597607d5bd8302b78ba53fa6fc25379c 3x"}, "body": "Good evening! I love your scenic art and was hoping to request work in 16:9 featuring these two characters. They are traveling companions so any type of world or scenery is fitting. Anything you would have fun drawing is best!\n\nhttps://drive.google.com/drive/folders/1Ex0secCczZVkMpzJDpv_fuXd7BghROnq\n\nhttps://drive.google.com/drive/folders/1vRjnSEAS_edQLxEF0hwUR9II6_NOz09O", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fujidora_jp/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3480606, "client_id": 2850907, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a68b77a9/uploads/origins/14349b57-18d3-48e6-ac1b-d5c6ef79e711?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fda66128e3ac05fe041c2126670d64f0", "srcset": "https://si.imgix.net/a68b77a9/uploads/origins/14349b57-18d3-48e6-ac1b-d5c6ef79e711?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fda66128e3ac05fe041c2126670d64f0, https://si.imgix.net/a68b77a9/uploads/origins/14349b57-18d3-48e6-ac1b-d5c6ef79e711?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cfda7966d9b8dd8481d88effb9c50723 2x, https://si.imgix.net/a68b77a9/uploads/origins/14349b57-18d3-48e6-ac1b-d5c6ef79e711?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0ccf96b9fed80671e925dde109f07b7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a68b77a9/uploads/origins/14349b57-18d3-48e6-ac1b-d5c6ef79e711?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3cc9b1fca3f0418c27fc21938f7430f", "srcset": "https://si.imgix.net/a68b77a9/uploads/origins/14349b57-18d3-48e6-ac1b-d5c6ef79e711?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3cc9b1fca3f0418c27fc21938f7430f, https://si.imgix.net/a68b77a9/uploads/origins/14349b57-18d3-48e6-ac1b-d5c6ef79e711?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c9c80519d1c23183736fb0ffc02d8835 2x, https://si.imgix.net/a68b77a9/uploads/origins/14349b57-18d3-48e6-ac1b-d5c6ef79e711?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=101318b5c29234c8a60ce8fcd604c1fa 3x"}, "body": "はじめまして。\nリクエスト失礼します。\n私の創作キャラを描いていただきたいです！\nちょっと不幸体質な女子高生です。\n\n絵師様の自然の壮大さが際立つイラストがとても好きなので、背景メインで描いていただけるとうれしいです。\n\n夏休みを楽しむ姿が見たいです。\n不思議な雰囲気の夏祭りに行ったり、山を冒険したり、海のある街を散策したり…絵師様のイラストで見たい風景が絞りきれないので、場所はおまかせします！\n\n好きなように楽しく制作してください！\n服の着方なども変えて大丈夫です。\n\n使用用途：観賞用\n\n検討していただけますと幸いです。\n\n金額等不足あれば遠慮なく再送、キャンセルしていただいて大丈夫です。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1ambi29EEl_Q1JikZNzT6d4gh8_mepeNl", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 66222, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "_", "screen_name": "Kan_MiRai", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Ff6b0cc90-a793-4115-840f-b347d84946c7.png&avatar=1", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 492924, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "エイゴニ", "screen_name": "eisuri", "avatar_url": "https://pbs.twimg.com/profile_images/1262578213672202246/VMjpGqpK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/801718896881324032/1591199555/1500x500", "appeal_receivable": false, "popu