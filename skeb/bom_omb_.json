86ea2b1c9f09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3b60d9ce545a98151024133e88382ca7 2x, https://si.imgix.net/5caf47c3/uploads/origins/20594c9b-a956-4c2a-8693-86ea2b1c9f09?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=30f8cfda49047882633218e06db450c3 3x"}, "body": "こんにちは。高槻やよいさんとの写真をお願いできますか？\n\nセクシーなポーズで下品に話す弥生のヌードが見たいんです。彼女はとてもムラムラしていて、家族が寝ている間にセックスしたいんです。彼女は自分がとてもうるさいことを知っているけれど、誰も起こさないように気をつけるから大丈夫と見る人に約束する。\n\n彼女は静かにすることに失敗し、プロデューサーに後ろから犯されたり髪を引っ張られたりしながら、大声で下品なことを言う。彼女は家族に見られても気にせず、大声でオーガズムを感じながらラフなセックスをすることに集中しすぎている。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@bom_omb_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3491449, "client_id": 2546040, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/91ade846/uploads/origins/e66b9727-ef2d-4fbc-afc6-ad22fcf7116e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75cf7a5c22a1db35f2893bbca0049c93", "srcset": "https://si.imgix.net/91ade846/uploads/origins/e66b9727-ef2d-4fbc-afc6-ad22fcf7116e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75cf7a5c22a1db35f2893bbca0049c93, https://si.imgix.net/91ade846/uploads/origins/e66b9727-ef2d-4fbc-afc6-ad22fcf7116e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=06b1f1b2797a1386a80199566c1f2b65 2x, https://si.imgix.net/91ade846/uploads/origins/e66b9727-ef2d-4fbc-afc6-ad22fcf7116e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ced115ba0cefba022f0e740d3eedb140 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/91ade846/uploads/origins/e66b9727-ef2d-4fbc-afc6-ad22fcf7116e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98bcafb08d6e75ecbc039f92deba2546", "srcset": "https://si.imgix.net/91ade846/uploads/origins/e66b9727-ef2d-4fbc-afc6-ad22fcf7116e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98bcafb08d6e75ecbc039f92deba2546, https://si.imgix.net/91ade846/uploads/origins/e66b9727-ef2d-4fbc-afc6-ad22fcf7116e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d97f7f47d4d4d00d40c223aafce7d7ef 2x, https://si.imgix.net/91ade846/uploads/origins/e66b9727-ef2d-4fbc-afc6-ad22fcf7116e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d067015c6c86f505c14c9b441251ee17 3x"}, "body": "リクエスト失礼します。\nアイドルマスターミリオンライブの木下ひなたとプロデューサーのイチャラブエッチ漫画を依頼します。\nひなたとプロデューサーは既に何度もエッチしている関係、という設定で以下のような内容をお願いしたいです。\n(ページ数や台詞等細かい部分はお任せします。また、内容については省略・改変等して頂いて構いません)\n\n・シチュエーション\n普段のエッチではいつも受け身でプロデューサーに気持ち良くされているひなたが今回は自分から積極的にプロデューサーを気持ち良くさせようとするも、\nプロデューサーが想像以上の絶倫で途中から攻守逆転されてしまい、結果普段より激しいセックスをするシチュ。\n\n・シチュの詳しい詳細\n普段のエッチではプロデューサーに身を委ねて気持ち良くされているひなたが、いつも一方的にされるだけでなく自分からプロデューサーを気持ち良くしてあげたいと考え、\n今回のエッチでは「今日はあたしがプロデューサーを気持ち良くしてあげるねぇ」的な感じで自分が優位に動ける騎乗位の体位でセックスを行う。\nひなたは持ち前の体力と培ったテクニックを活かしながらプロデューサーを数回射精させるも、\nプロデューサーがひなたの想像を上回る絶倫であった(普段のエッチではプロデューサーがひなたを気遣って1・2回の射精で終わっていた)為、\n数回射精したにも関わらずペニスの勃起が収まらない事にひなたが戸惑う。\n直後、逆に騎乗位で気持ち良くさせようと尽くしてくれるひなたの姿を見て興奮が収まらなくなったプロデューサーに攻守逆転されてしまう。\nその後正常位の体位に変えられ、歯止めが聞かなくなったプロデューサーがひなたの膣内をペニスで激しく突きながらセックスを続行し、\n騎乗位セックスで既に体力を使っていたひなたはなすがままにされ快感に溺れる。\nプロデューサーが更に何度か射精をしてようやく収まった事後、精魂尽き果てた状態でベッドに倒れ込んでいるひなたを見てプロデューサーは「やりすぎた」と謝りつつも、\nひなたが自分を気持ちよくさせようとしてくれた事に感謝の気持ちを述べ、ひなたも嬉しそうに微笑みながら互いにキスをする。\n\n以上ご検討をよろしくお願い致します。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 232, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "クェッツァー＠イラリク募集中", "screen_name": "j1S0dbMKRA", "avatar_url": "https://pbs.twimg.com/profile_images/1369900710079336449/NEmQBhRP.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1