-b6abe9ead4e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fed559cb09f303050bfa40fff0da9c43", "srcset": "https://si.imgix.net/74a41e7a/uploads/origins/b075e8f1-cf31-488a-b56a-b6abe9ead4e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fed559cb09f303050bfa40fff0da9c43, https://si.imgix.net/74a41e7a/uploads/origins/b075e8f1-cf31-488a-b56a-b6abe9ead4e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed529cbf178edbcb036a75eb62ea3c6d 2x, https://si.imgix.net/74a41e7a/uploads/origins/b075e8f1-cf31-488a-b56a-b6abe9ead4e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a6a8fe1d58503d18d2d5ad228f465b0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/74a41e7a/uploads/origins/b075e8f1-cf31-488a-b56a-b6abe9ead4e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=869bb8b1f5b284c22fa5e116dc9d7cc3", "srcset": "https://si.imgix.net/74a41e7a/uploads/origins/b075e8f1-cf31-488a-b56a-b6abe9ead4e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=869bb8b1f5b284c22fa5e116dc9d7cc3, https://si.imgix.net/74a41e7a/uploads/origins/b075e8f1-cf31-488a-b56a-b6abe9ead4e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=362038bebd418ae1b249f7d820b98552 2x, https://si.imgix.net/74a41e7a/uploads/origins/b075e8f1-cf31-488a-b56a-b6abe9ead4e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=abe06e5489b2c4535cb551bed2507a85 3x"}, "body": "Skebエリカの続きイラストをお願いします。\nエリカは悪い傭兵たちから救出されたものの、男たちから受けた性の快楽と多人数に求められる悦びを忘れる事ができず悶々とした日々を送っていた。\n　ボーダー休業中に極東の温泉に旅行することになりそこの混浴露天風呂で\n行きずりの男性客(複数)と乱交するシチュエーションをお願いします。\n1枚絵(差分2枚)でお願いします。\n\nモザイクなんですが黒色の棒で何本か減らしてもらえるとありがたいです...\n\n・エリカの服装は混浴用に着た白のマイクロビキニ(ズレて乳首は露出している)\n\n・エリカは自分の身体をみて勃起してしまった男たちを鎮めようとして積極的に男たちに身体を許している\n\n・エリカの表情は悲壮感はなく、頬を赤らめながらも久しぶりの硬い肉棒に囲まれて悦んでいる表情でお願いします。\n\n・エリカの体位は立ちバック(岩盤の露天風呂に入っていて足から膝あたりは温泉に浸かっている)で後ろから男に膣に挿入されている(ビキニをずらしての挿入)\n\n\n・サンドウィッチされるように前から男のブツを咥えているorフェラしている\n\n・他の男たちは揺れているエリカの胸に我慢できず見ヌキorエリカ手コキ,我慢して順番待ちしている(構図的に難しければカットして下さい)\n\n・男たちの誰かが(前後、順番待ちの男の誰かが)片方の胸を優しく揉んでいる\n\n台詞をお願いします。\n\n通常時\nエリカ「皆さん,遠慮しないでもっと私の身体で気持ちよくなって下さい🖤」(喘ぎながら)\n\n男性客A(30代)「はあはぁ...マ○コ気持ち良すぎてもたない...締まる！」\n\n男性客B(中年)「フェラも気持ち良すぎてたまらん...もう出そうだ！」\n\n男性客C「後でAVのタイトル聞いとこうぜ...絶対カメラ回ってるよ」\n\n射精時\nエリカ「絶頂した台詞」(思案お願いします。)\n\n男性客A,B,見抜きしていた客「射精る！！」\n※中出しでお願いします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@WASPrade/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d3f3c96b/uploads/origins/f689911e-1dd4-42a2-924c-8f3ff1166f03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6f7582cfe0000ef6594bdff9d4ac834d", "srcset": "https://si.imgix.net/d3f3c96b/uploads/origins/f689911e-1dd4-42a2-924c-8f3ff1166f03?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6f7582cfe0000ef6594bdff9d4ac834d, https://si.imgix.net/d3f3c96b/uploads/origins/f689911e-1dd4-42a2-924c-8f3ff1166f03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5617faf1117a533b84dc532f3c4f2ddc 2x, https://si.imgix.net/d3f3c96b/uploads/origins/f689911e-1dd4-42a2-924c-8f3ff1166f03?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=57919a9bafae5e7939634fcfe487cddf 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 71437, "nc": 50}, {"path": "/@WASPrade/works/6", "private_thumbnail_image_urls": null, "private"