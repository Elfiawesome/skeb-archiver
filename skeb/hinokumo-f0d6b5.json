15c3c/uploads/origins/45dbe3b3-bd41-46b4-b9fb-bc139ac30793?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=adf6dfd7546167dd884f83f1156aae59", "srcset": "https://si.imgix.net/47615c3c/uploads/origins/45dbe3b3-bd41-46b4-b9fb-bc139ac30793?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=adf6dfd7546167dd884f83f1156aae59, https://si.imgix.net/47615c3c/uploads/origins/45dbe3b3-bd41-46b4-b9fb-bc139ac30793?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=40d2bc5dbb5c265adb142f3a20d90883 2x, https://si.imgix.net/47615c3c/uploads/origins/45dbe3b3-bd41-46b4-b9fb-bc139ac30793?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=33549f85b15d81c2a47cdd9b3227b644 3x"}, "body": "こんにちは、\n\n「Mountain」という作品、とても気に入りました！私のVTuberオリジナルキャラクター「ソル」を描いていただけたら嬉しいです。\n\nソルは、炎のような赤とオレンジ色の髪をした犬型の宇宙海兵隊員で、左右非対称で少し垂れ下がった犬の耳、ふさふさしたしっぽ、牙、そして異色眼が特徴です。 彼はサイバーパンク／SFの世界に生きるキャラクターです。元気いっぱいで、少しおっちょこちょいですが、楽しむことや笑うことが大好きです。衣装は、お好きなものを何でも構いません！\n\nポーズ、表情、背景はなんでも構いません。ただ、新しい衣装を着せていただけると嬉しいです。可能であれば、筋肉を見せている姿も描いていただけると嬉しいです。 参考までに、添付した過去の依頼作品の写真をすべてご覧ください。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/u/1/folders/17LFANSrO_HkFRXU_TnD-5RH2YiF7edmO", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hinokumo/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3927465, "client_id": 2495946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d902ba4/uploads/origins/52959d17-b869-4616-a66f-d0c8fa11a52e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db3edf3982566069f562e39f82a2afa4", "srcset": "https://si.imgix.net/5d902ba4/uploads/origins/52959d17-b869-4616-a66f-d0c8fa11a52e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db3edf3982566069f562e39f82a2afa4, https://si.imgix.net/5d902ba4/uploads/origins/52959d17-b869-4616-a66f-d0c8fa11a52e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8fb5c70822748e7ba1b0c33986a9fdee 2x, https://si.imgix.net/5d902ba4/uploads/origins/52959d17-b869-4616-a66f-d0c8fa11a52e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=53ecd1faf5111ce7b7182c6f95d10ab4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d902ba4/uploads/origins/52959d17-b869-4616-a66f-d0c8fa11a52e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9876509112f18c8447d84d42df6acab1", "srcset": "https://si.imgix.net/5d902ba4/uploads/origins/52959d17-b869-4616-a66f-d0c8fa11a52e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9876509112f18c8447d84d42df6acab1, https://si.imgix.net/5d902ba4/uploads/origins/52959d17-b869-4616-a66f-d0c8fa11a52e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7f53872abbbf44820e488eaa1aa891d5 2x, https://si.imgix.net/5d902ba4/uploads/origins/52959d17-b869-4616-a66f-d0c8fa11a52e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5bfbd7ae66e2aaca86ee90f6c521ad2d 3x"}, "body": "こんにちは！はじめまして！私のキャラクターと友人のキャラクターについて、お願いしてもよろしいでしょうか？\n\n✨️キャラクター\n[1] ロビン・“ルビー”・ルーズベルト\n- 24歳 // 1.87m // 男性\n- 子犬のような性格。 好奇心旺盛で、陽気で遊び好き、そしていちゃつくのが大好きです。しかし、信じられないほど不注意で、無知で、頑固な一面もあります。\n- ヌライト軍の新兵であり、ルーズベルト家の唯一の息子\n- 子供の頃から非常に甘やかされ、放置されてきました。両親は彼に規律を学ばせるために軍へ送り出しました\n- レッドと恋に落ちるまでは、軽い交際を繰り返していた\n- 鋭い牙のような歯\n\n[2] レッド\n🥀レジナルド・“レッド”・リドリー\n- 42歳 // 1.92cm // 男性\n- ヌライト軍の訓練教官\n- 厳格で規律を重んじる。 無意味なことを一切許さず、他者に対して「厳しい愛」をもって接することで気遣いを示す。数々の喪失を目の当たりにしてきたため、長年の間に疲れ果ててしまっている\n- 左足は膝のすぐ上から始まるロボットの義足である。勤務中はほとんど毎日これを装着しているが、一日の勤務が終わると、よりシンプルな機械式の義足に交換する。\n- 料理をすることはあまりないが、作る時は大抵スープになる。それ以外では身の回りの世話が苦手で、調子の悪い日はパンとコーヒーだけで済ませる。\n- 睡眠に問題があり、通常は疲れ果てて再び眠りにつけるようになるまで、空を眺めて時間を過ごす。それ以外の時は、暇つぶしに読むための本を部屋に山積みにしており、特に殺人ミステリー系の本に傾倒している\n\n✨️関係\n二人は教官と訓練生として出会い、ルビーはレッドを困らせるのが大好きだった。最初はルビーの好奇心が二人を結びつけたものの、やがて本物のカップルになった。ルビーはレッドの人生における光となる。\n\n✨️参考\nhttps://drive.google.com/drive/folders/1JI6PDDZu4mAeEJ-m90wXOPpUUp6xn1yO\n構図やポーズはご自由に選んでください！\n\nご検討いただきありがとうございます！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hinokumo/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8414a3ea/uploads/origins/eec6729a-f0e2-425a-88df-ef0906be58fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc5f2dff54bec52d44beacffb28ca4eb", "srcset": "https://si.imgix.net/8414a3ea/uploads/origins/eec6729a-f0e2-425a-88df-ef0906be58fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dc5f2dff54bec52d44beacffb28ca4eb, https://si.imgix.net/8414a3ea/uploads/origins/eec6729a-f0e2-425a-88df-ef0906be58fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=8bee975cfa56a8a1fbef81ff00729fcd 2x, https://si.imgix.net/8414a3ea/uploads/origins/eec6729a-f0e2-425a-88df-ef0906be58fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=696d579c5d3d3d5f57dd2651ec3aeb5c 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3927465, "nc": 33}, {"path": "/@hinokumo/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/af27f907/uploads/origins/6e7f75c2-787c-4f4f-921b-be6ca2265ed2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0faf333ad827ca028eb9f2548