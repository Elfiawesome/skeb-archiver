e_urls": {"src": "https://si.imgix.net/976e5c61/uploads/origins/a83b52fd-e450-4e5c-b43c-dee77cdfa114?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9e1d9c780e3dc7cf4e3ffdbf87c05dc", "srcset": "https://si.imgix.net/976e5c61/uploads/origins/a83b52fd-e450-4e5c-b43c-dee77cdfa114?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9e1d9c780e3dc7cf4e3ffdbf87c05dc, https://si.imgix.net/976e5c61/uploads/origins/a83b52fd-e450-4e5c-b43c-dee77cdfa114?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3fbf30c953d5ad2741070488853210f 2x, https://si.imgix.net/976e5c61/uploads/origins/a83b52fd-e450-4e5c-b43c-dee77cdfa114?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e35d11157b222bcb3bb828a5e9e915b2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/976e5c61/uploads/origins/a83b52fd-e450-4e5c-b43c-dee77cdfa114?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3346c7cfce4a3bbb1e1b1d91f5bfa12", "srcset": "https://si.imgix.net/976e5c61/uploads/origins/a83b52fd-e450-4e5c-b43c-dee77cdfa114?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d3346c7cfce4a3bbb1e1b1d91f5bfa12, https://si.imgix.net/976e5c61/uploads/origins/a83b52fd-e450-4e5c-b43c-dee77cdfa114?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3fa2763ca27ce451ca17e51e6a56876b 2x, https://si.imgix.net/976e5c61/uploads/origins/a83b52fd-e450-4e5c-b43c-dee77cdfa114?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3eaf83dd2abd139037d66741fb0010d8 3x"}, "body": "巡様、こんにちは。\n差し支えなければ、巡様に下記の資料にあります、3人の1枚絵を描いていただきたいと思い、この度はご依頼失礼します。\n\n┈┈┈┈┈┈┈┈┈┈\n①(HO1)男性\n身長：175cm\n年齢：21歳\n性格：ゲーマー。口数は多い方では無い。いつも半歩後ろで見守ってくれている。②と③のことが大事だが、それは表に出さない。だが、結構身内主義。大切だと思ってくれている。\n\n②(HO2)女性\n身長：158cm(＋厚底5cm)\n性格：幼なじみのことは大好きだし、私が守らなきゃ！という姉御肌みたいなところがある。幼なじみには優しいが、軽度の人間恐怖症があるため、身内のみにひっついたり抱きついたり愛を伝えたりする。\n\n③(HO3)女性\n身長：160cm超え\n年齢：21歳\n性格：ツンデレ(ツンがとても多い)。実験が好き。①や②のことは大切だと思っているが、外にあまり出ず交流が最も薄い。②のひっつき癖を嫌がりはするが本当は素直になれないだけ。\n\n［3人の関係］\n小学校からの幼なじみ。\n②は幼なじみが大好きな気持ちを全面に出すし、『私はあんたたちのこと好きだよ』と平然と伝え、幼なじみを守ると決めているリーダー的な人物。①と③(特に③)は幼なじみのことを好きだけど、それをほぼ表に出すことはないので一般人の目から見たら②の一方通行に見えるが、実は3人とも同じぐらい幼なじみ(お互い)が大事。\n\n・在住：3人とも東京。(池袋や新宿が舞台)\n・通過CoCシナリオ名：救世主\n・身長順：②<③<①\n┈┈┈┈┈┈┈┈┈┈\n\n構図など全て巡様のご自由に描いていただければと思います。\n使用用途はSNSでのアイコン・ヘッダーでの使用、個人の壁紙での使用となります。\n\n可能であれば、comisson文字あり・なし、背景と人物でレイヤー分けを同封していただけると嬉しいです。\n\n金額不足であれば再送していただけると幸いです。\nご検討の程、お願い致します。\n\nhttps://drive.google.com/file/d/187MT6qfiB3mFtqS9vPpA7TtsW9y_pMbu/view?usp=drivesdk", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 52621, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "幎メイジ", "screen_name": "77___2", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar/media.misskeyusercontent.jp%2Fio%2F08b48a5e-3b12-4b9e-b439-067bf92c27b7.png?avatar=1", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 663892, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "コバヤシ⁉️", "screen_name": "iaia_58", "avatar_url": "https://pbs.twimg.com/profile_images/1879864942024916993/qF118kpe.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1668309895777763328/1759167662/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 45, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}], "banned": false