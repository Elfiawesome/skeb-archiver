聞いて褒めてくれてまんざらでもなく内心喜んでたりする様子を描いて下さい。両方とも構図と体勢は同じで構いません。私服は下記URLのアプリ版私服を、水着はフクキタルのイラストで着ていた様な紐ビキニでデザインは似合いそうなものをお任せします。\nhttps://imgur.com/a/P7DoNHR\n\nタルマエらしい胸やお尻大きめの太もも等むちっとした少しふくよかな体型で描いて頂けれたらと思います。\n\n構図と体勢はお尻側からのアングルで両目とも見えるくらい振り向かせて横からの胸も見えるグラビア的な形で、ある程度下からのアングルにして私服姿はアプリ内でも見えるミニスカートの中のスパッツが見えたりビキニはお尻がよく見える様に描いて頂けたらと思います。\nその他はお任せします。シチュを描写さえして頂ければアレンジして頂いても問題ありません。\nよろしければお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Chikuwa3681/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3905173, "client_id": 2587337, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3ffb18c3/uploads/origins/ea230d2b-8844-48b4-b65f-194910982a39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7c1d4cca1213af8f40ce500d70a7e05", "srcset": "https://si.imgix.net/3ffb18c3/uploads/origins/ea230d2b-8844-48b4-b65f-194910982a39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7c1d4cca1213af8f40ce500d70a7e05, https://si.imgix.net/3ffb18c3/uploads/origins/ea230d2b-8844-48b4-b65f-194910982a39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0dd4f6117dee8f6fa1488a41a06dac3 2x, https://si.imgix.net/3ffb18c3/uploads/origins/ea230d2b-8844-48b4-b65f-194910982a39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=256f542923d66cadb0f1afd91d156ce6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3ffb18c3/uploads/origins/ea230d2b-8844-48b4-b65f-194910982a39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4621f0c683820cd3f11bfa2fe785e83", "srcset": "https://si.imgix.net/3ffb18c3/uploads/origins/ea230d2b-8844-48b4-b65f-194910982a39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4621f0c683820cd3f11bfa2fe785e83, http