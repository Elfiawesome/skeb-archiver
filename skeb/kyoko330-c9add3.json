:男\nツッコミ気質の柴犬モチーフの人間です。\nサイバー系の異世界在住。みんなの世界と行き来してます。\nゲーム配信多めで、たまに雑談しています。\n\n\n資料URLにはXの固定用ツイートを置いています。\n\n長くなってしまい大変恐縮ですが、\nご都合よろしければ、お願い致します!\n\nhttps://x.com/Camellia_End_V/status/1928747430650196233?s=20", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kyoko330/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 59992, "client_id": 2382231, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/63cc2d41/uploads/origins/2e9b2051-8f3e-4ed3-950c-72e7456941ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54242131a7126f6f09c1f99cd0ad67cf", "srcset": "https://si.imgix.net/63cc2d41/uploads/origins/2e9b2051-8f3e-4ed3-950c-72e7456941ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=54242131a7126f6f09c1f99cd0ad67cf, https://si.imgix.net/63cc2d41/uploads/origins/2e9b2051-8f3e-4ed3-950c-72e7456941ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abc1a1a7924ef3c64eb6284e669a3690 2x, https://si.imgix.net/63cc2d41/uploads/origins/2e9b2051-8f3e-4ed3-950c-72e7456941ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=50ab6b7efc82c8a6f2e8bc5b5fb40f2e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/63cc2d41/uploads/origins/2e9b2051-8f3e-4ed3-950c-72e7456941ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f19580e715a03c95615249d621a54814", "srcset": "https://si.imgix.net/63cc2d41/uploads/origins/2e9b2051-8f3e-4ed3-950c-72e7456941ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f19580e715a03c95615249d621a54814, https://si.imgix.net/63cc2d41/uploads/origins/2e9b2051-8f3e-4ed3-950c-72e7456941ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f30e15374a545d0a902ec