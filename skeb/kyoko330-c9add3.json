のドヤ顔」「おめめグルグル青ざめウヘェ」の表情差分あり。\n・背景透過済みですとありがたいです。\n\n●使用用途。\n・配信、動画のサムネイル。\n・Xなどの宣伝画像などに使用する可能性あり。\n\nよろしくお願いいたします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kyoko330/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 59992, "client_id": 789201, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9201e16a/uploads/origins/d1d8dcbb-26b2-4cd8-a1d6-b978b001097f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1981aad94ee5030e69e8f017a5ebff8", "srcset": "https://si.imgix.net/9201e16a/uploads/origins/d1d8dcbb-26b2-4cd8-a1d6-b978b001097f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1981aad94ee5030e69e8f017a5ebff8, https://si.imgix.net/9201e16a/uploads/origins/d1d8dcbb-26b2-4cd8-a1d6-b978b001097f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0fdd8747e317140f1b03d73ceaf90b49 2x, https://si.imgix.net/9201e16a/uploads/origins/d1d8dcbb-26b2-4cd8-a1d6-b978b001097f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=847bcd70c7a870912404db03ff40ec45 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9201e16a/uploads/origins/d1d8dcbb-26b2-4cd8-a1d6-b978b001097f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e76ce561e27cd6dcd193959bbac96a86", "srcset": "https://si.imgix.net/9201e16a/uploads/origins/d1d8dcbb-26b2-4cd8-a1d6-b978b001097f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e76ce561e27cd6dcd193959bbac96a86, https://si.imgix.net/9201e16a/uploads/origins/d1d8dcbb-26b2-4cd8-a1d6-b978b001097f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=38b1c1edf7aff4d03ed57c7e29934824 2x, https://si.imgix.net/9201e16a/uploads/origins/d1d8dcbb-26b2-4cd8-a1d6-b978b0