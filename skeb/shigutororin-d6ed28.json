ress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6d484a4db2dd20848f5aebc4cf63e62e 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 266214, "client_id": 147006, "nc": 160}, {"path": "/@shigutororin/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 266214, "client_id": 55547, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c59d000f/requests/47835_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d1988e5f5c47e042b497e09ecc629ab", "srcset": "https://si.imgix.net/c59d000f/requests/47835_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d1988e5f5c47e042b497e09ecc629ab, https://si.imgix.net/c59d000f/requests/47835_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=455bd9bb8af55d57fd618ade31e176fa 2x, https://si.imgix.net/c59d000f/requests/47835_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61ee48b392a669f62be02c9cdefadcb4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c59d000f/requests/47835_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e4049a9e478f52d85da200282d06ecf", "srcset": "https://si.imgix.net/c59d000f/requests/47835_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1e4049a9e478f52d85da200282d06ecf, https://si.imgix.net/c59d000f/requests/47835_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a60a2c99681b2a9f6d1b4477a1c0e7a1 2x, https://si.imgix.net/c59d000f/requests/47835_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=451fde15fed69f6a254539205e63ad9d 3x"}, "body": "前作と同じく〇田ちゃんの続編をお願いさせて頂きたいと思います。\n服装は前作からの続きと言う事で、前作と同じ格好・服や体への落書きの状態でお願いします。\n(後ほど公衆便所などの落書きを追加)\n\n前作でベンチにガムテープで固定されてしまった〇田ちゃん。\n何とかテープを解き逃げ出すことに成功したが、穴あきスポーツウェアに体中への落書きと言う恥ずかしい格好のため、ひとまず身を隠せれる場所を探し公園内を移動。\nすると人気の無い公園の外れにある公衆トイレを発見し、ひとまず避難することに。\n女子トイレに入るかと思ったが、〇田ちゃんは事もあろうにスリルを再び求め男子トイレへ入ったのである。\n\n汚れた男子トイレ中の小便器に座り、腰を前に突き出したいわゆる「エロ蹲踞」の格好で興奮からか、\n〇田ちゃんはオナニーを始めてしまう。\nしかし、一心不乱でオナニーに夢中になっていたせいでトイレに入ってくる人に気づかず、\nオナニーしている所を見つかってしまう。\n突然の事で放心状態になり、動けなくなってしまった〇田ちゃんは見つかった人に写真を撮られ、\n脅かされてしまい、全身におしっこと精液を盛大にぶっかけられ、身体には「公衆便所」などと\n追加の落書きを描かれ、便器にされてしまう。\n\n早く帰っていればよかったのに、変態改造ウェアの格好のままトイレでオナニーしたことを後悔しても\n時すでに遅く、全身おしっこと精液まみれの姿のまま「私、もう普通の生活に戻れないのかな・・・」と\n絶望に打ちひしがれてしまう差分を頂けると嬉しいです。\n\n【格好の参考】\n他絵師様のものになりますが、資料URL先の様な格好のイメージでお願いします。\n\nhttps://www.pixiv.net/artworks/63357664", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shigutororin/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 266214, "client_id": 55547, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9fca92f/requests/40138_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=659ba5ea0f4d738bd77dfa888d1af4e9", "srcset": "https://si.imgix.net/d9fca92f/requests/40138_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=659ba5ea0f4d738bd77dfa888d1af4e9, https://si.imgix.net/d9fca92f/requests/40138_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=215f65bef1ed3dcae3bbaaf317ecdc2c 2x, https://si.imgix.net/d9fca92f/requests/40138_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=784bd0cc33a18c072754d2f6a4b39fce 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9fca92f/requests/40138_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45817d4efb2c1ce479a3db2ca8e755a7", "srcset": "https://si.imgix.net/d9fca92f/requests/40138_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45817d4efb2c1ce479a3db2ca8e755a7, https://si.imgix.net/d9fca92f/requests/40138_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3c276de6021d4f32b3e50851e0f36b54 2x, https://si.imgix.net/d9fca92f/requests/40138_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=294332fc9de33a96a31f783df38a2dfb 3x"}, "body": "初めてご依頼させて頂きます。宜しくお願い致します。\nしぐとろ様の2018年5月9日のTwitter投稿で描かれておられる「お洋服が盗まれた露出っ子」さんのその後のイラストをお願いしたいと思います。\nhttps://twitter.com/shigutororin/status/993898157535875074\n\n体へエッチな落書きをして露出する快感に目覚めてしまった露出っ子さん。\n次は変態改造した洋服を着ての露出に挑戦。\n上下セパレート型のスポーツウェア(上着の色や形はお任せしますが、下着は黒スパッツでお願いします)を\n着ているが、乳首と局部部分の生地を自分でハート穴にカットしており、着衣のまま乳首と局部を露出。\n見つかるかもしれないと言う興奮からか、露出している局部からは愛液が大量に流れ出て、両足先までビチャビチャに垂れている。\n\n上着とスパッツの間に見える体には、前回と同じような卑猥な落書きを色々と自分で描いており、\n乳首部分をハート穴にカットされたウェアの上着には「変態改造ウェア」と書いている。\n\nこの格好で深夜の公園のベンチに座り露出していたら人に見つかり、手をと足をベンチに縛られ\n大股開きの格好で身動きが取れない状態にされたまま、全身に精液をぶっかけられ肉便器にされてしまうイラストをお願い致します。\n\nもし可能であれば、変態改造ウェアで露出したことを後悔しても時すでに遅く、自業自得ながらも目のハイライトが無くなり、「私この後どうなってしまうんだろうか」と言う虚ろな表情の差分を頂けると嬉しいです。\n\n【その他】\nサイズはできるだけ大きめのキャンパスで、宛名やしぐとろ様のサインが\nオン・オフ出来るように別レイヤーに分けて頂けるとありがたいです。\n\n【衣装・体への落書き参考】\nhttps://skeb.jp/works/31500\n私が他のクリエイター様へお願いさせて頂いた別作品ですが、ハート穴衣装や落書きのイメージとして\nご参考にして頂ければ幸いです。\n\n以上、細かい指定が多く申し訳ございませんが、ご検討のほどよろしくお願い致します。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@shigutororin/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cc29b649/requests/40060_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2537b48a43560c4a50e4f127141de782", "srcset": "https://si.imgix.net/cc29b649/requests/40060_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVAT