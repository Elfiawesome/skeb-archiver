uploads/origins/5ef7fb97-d7bf-4645-9d6c-8d99eb9f0758?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=224a91647c633ce6cd098eb9dec804f8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c3ad7d77/uploads/origins/5ef7fb97-d7bf-4645-9d6c-8d99eb9f0758?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5515b7d9008f128ab1e6203fb67a4653", "srcset": "https://si.imgix.net/c3ad7d77/uploads/origins/5ef7fb97-d7bf-4645-9d6c-8d99eb9f0758?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5515b7d9008f128ab1e6203fb67a4653, https://si.imgix.net/c3ad7d77/uploads/origins/5ef7fb97-d7bf-4645-9d6c-8d99eb9f0758?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=96c99205ce79130cbed99fba937bb9c5 2x, https://si.imgix.net/c3ad7d77/uploads/origins/5ef7fb97-d7bf-4645-9d6c-8d99eb9f0758?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=283fb7b2fed0ba357e32ed7704bea096 3x"}, "body": "こんにちは。🐶と申します。\nスケブを1枚お願いしたく、リクエストさせていただきます。\nフロロー判事のイラストをお願いしたいです。\n映画の中で判事が「もっとゆっくり間を空けて。痛みをよく感じるように」と語る場面があります。\nこの台詞から、体罰や折檻にも慣れているフロロー判事をイメージしました。\nそこで、ムチを手にしたフロロー判事が、こちらを見ながら怪しく妖艶に微笑んでいるようなイラストをお願いしたいです。\n「これから私に鞭打ちをする」というシチュエーションをイメージしています。\n判事の表情や仕草は、格好良く、妖しく、少し色気のある雰囲気だと嬉しいです。\n背景や構図などの細かい部分はおまかせします！\n描きやすいように自由にアレンジしていただいて大丈夫です。\n使用用途ですが、問題がなければ個人のスマートフォンの壁紙として使用と、コンビニ等の印刷機で印刷し、自宅で飾りたいと思っております。\nどうぞよろしくお願いいたします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@266notre/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2076636, "client_id": 4084713, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/adabf35f/uploads/origins/45f750c3-2ea4-4667-8faf-b55ca03f3ff6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b86c278c00