}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@yuubenoumi/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3771034, "client_id": 2138007, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/360ba7e1/uploads/origins/0b053f61-7179-4758-ba13-74f352228ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b28c1ef4be34094934eb72a32051d97", "srcset": "https://si.imgix.net/360ba7e1/uploads/origins/0b053f61-7179-4758-ba13-74f352228ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1b28c1ef4be34094934eb72a32051d97, https://si.imgix.net/360ba7e1/uploads/origins/0b053f61-7179-4758-ba13-74f352228ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c307581771520defd448f62671cc0dec 2x, https://si.imgix.net/360ba7e1/uploads/origins/0b053f61-7179-4758-ba13-74f352228ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fbb9ba36f005e23aa6e40d7ede1dac19 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/360ba7e1/uploads/origins/0b053f61-7179-4758-ba13-74f352228ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24c386ece70f7f138dba755eb3fb8981", "srcset": "https://si.imgix.net/360ba7e1/uploads/origins/0b053f61-7179-4758-ba13-74f352228ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24c386ece70f7f138dba755eb3fb8981, https://si.imgix.net/360ba7e1/uploads/origins/0b053f61-7179-4758-ba13-74f352228ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4d6bb547ab8675bbf578de335dd77ae4 2x, https://si.imgix.net/360ba7e1/uploads/origins/0b053f61-7179-4758-ba13-74f352228ff5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3eb583a99b9c5f458214926228098324 3x"}, "body": "絵柄がすごく好みで大好きです！！\n\nオリジナルキャラクター2人のイラストをお願いします。\n魔女（名前：ジュエ・ラヴィ【Jouer la vie】）と、彼女に従うフェンリルの青年（名前：ルフ・フェンリオス【Lufe Fenrios】）の主従関係のワンシーンでお願いしたいです。\n二人の関係性や雰囲気を重視して頂けると嬉しいです。\n■ キャラクター詳細\n【魔女：ジュエ・ラヴィ（Jouer la vie）】\n外見\n　明るいピンク色の長髪。\n　前髪ぱっつんで、後ろ髪の一部に小さな三つ編みがあります。\n　身長はやや低め。\n　胸は大きめ（強調めで大丈夫です）。\n　つり目気味の強気な美少女。\n衣装\n　黒×金を基調とした魔女風ローブ。\n　露出は少なめですが、身体のラインが分かるデザイン。\n性格・雰囲気\n　少し寂しがりの魔女。\n　ルフの主であり、彼に対して少し意地悪く余裕のある態度を取ります。\n　口元や目元が “余裕の笑み” を浮かべている印象です。\n【フェンリル：ルフ・フェンリオス（Lufe Fenrios）】\n外見\n　身長約200cmの長身青年。\n　髪は銀〜白系の長髪。\n　人の姿でも 狼耳と尻尾があります。\n　身体つきはがっしりとした狼系の大柄体型。\n衣装\n　黒〜灰を基調としたシンプルな軽装。\n　首には魔女がつけた首輪（装飾品としてデザイン自由）があります。\n性格・雰囲気\n　寡黙で本能的にジュエへ絶対服従。\n　主従として従っていますが、気持ちはジュエへ強く想いを寄せている 状態です。\n■ 二人の関係性（絵柄に反映していただきたい部分）\n魔女（ジュエ）＝主\nフェンリル（ルフ）＝従\nただし ルフのほうが主へ強く想いを寄せている 主従の距離感です。\nジュエは余裕のある表情で、ルフは少し緊張している・意識している表情だと嬉しいです。\n\n■ 希望構図（メイン）\n片腕と腰でしっかり抱き上げている構図です。\nジュエは軽く身体を預けるように腕をルフの首へ回し、密着した状態になっています。\n二人の顔はすぐ近くにあり、\n鼻先が触れそうな距離で見つめ合う、親密な角度です。\nルフの方は少し見上げるような位置、ジュエは見下ろすような位置関係になります。\nルフは頑張って迫っているけれど少し緊張気味\nジュエは彼を見ながら余裕のある微笑\nルフの耳がぴんと立っている\n尻尾が緊張で揺れ気味だと可愛いです\nジュエの胸元との身長差で距離感にドキッとするような空気があると嬉しいです\n首輪が見えるアングルだと助かります\n\n※ 上記はあくまで希望で、構図・ポーズ・雰囲気等は絵師様のセンスでアレンジ歓迎です。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yuubenoumi/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d60ed56d/uploads/origins/18fd476e-c657-4495-a1ec-d590f9c814cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=96f85af49d83b65933d697f1ad2bd02d", "srcset": "https://si.imgix.net/d60ed56d/uploads/origins/18fd476e-c657-4495-a1ec-d590f9c814cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=96f85af49d83b65933d697f1ad2bd02d, https://si.imgix.net/d6