・ユカ」、身長155cm前後のルージュのウィスプボーイ（フェムボーイ）です。表情は主にノンシャラン/退屈/シリアスである。精霊/幻獣であるため、作品の雰囲気によっては周囲に光り輝くオーラを放つイテレーションがある。\nまた、性格もさばさばしているような、エレガントでクールな感じなので、それを表現できるようなポーズにしたいです。\n\n作品に使われているテクスチャーが、研磨されているようで好きです。キャラクターや背景は好きにやらせてもらいます。もし可能であれば、私の音楽作品のアルバムジャケットやバナーとして使用したいです。(その際は、必ずクレジットと報酬をお支払いします。）\n\nご配慮いただき、本当にありがとうございました！～<3\n\nhttps://drive.google.com/drive/folders/1ueKVfQTI5qY9mKkdi_kUwIi8V-NZsoEC?usp=share_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@arikemgo/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bcf7b9ca/uploads/origins/8084043a-706f-4855-8ead-d8f715db5ba1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=732d8dcbf697e5b806e9e2b7c699a210", "srcset": "https://si.imgix.net/bcf7b9ca/uploads/origins/8084043a-706f-4855-8ead-d8f715db5ba1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=732d8dcbf697e5b806e9e2b7c699a210, https://si.imgix.net/bcf7b9ca/uploads/origins/8084043a-706f-4855-8ead-d8f715db5ba1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3888126a578f2162cda777d5e6ff6eed 2x, https://si.imgix.net/bcf7b9ca/uploads/origins/8084043a-706f-4855-8ead-d8f715db5ba1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1d64ccc46fee8873e4c429fb13556778 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2624346, "client_id": 936937, "nc": 129}, {"path": "/@arikemgo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2624346, "client_id": 