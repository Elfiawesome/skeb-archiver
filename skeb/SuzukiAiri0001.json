 [{"path": "/@SuzukiAiri0001/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3568475, "client_id": 1960223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/261658c2/uploads/origins/7819dd99-b6b8-4463-b14e-89de348c86bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0f7f6cd630787e39b1abd4b6f02b45b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/261658c2/uploads/origins/7819dd99-b6b8-4463-b14e-89de348c86bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=09e3027598a82aeaf3537e9abff9c244", "src_set": ""}, "body": "鈴木アイリさん初めまして。\n東方にて可愛いイラストを扱っている方と存じましたので、是非ご依頼させて頂きましたら幸いです……！\n\nやや奇抜な内容で恐縮ですが、もしよろしければ東方projectの「河城にとり」に格闘ゲーム「ヴァンパイア」シリーズの「リリスの衣装をコスプレ」をさせたイラストをお願いできるでしょうか？\n個人的に直感的にハマってしまった謎の組み合わせなので、他人に説得力を持って説明できるものではないですが、「それでも私はこれが好き」という組み合わせではあります。\n鈴木アイリさんも可愛いくも少女っぽさのあるにとりちゃんを描かれていたのを確認いたしましたので、是非そのお手前にて描いて頂けましたらと思う次第です。\n\n一応コスプレがメインとなります、なるべくならで十分ですが、全身が拝める構図にて衣装姿を堪能させていてくだされば非常にありがたいです。\nただ一点、にとりちゃんのいつもの帽子はそのまま被って頂く方が個人的には好ましいので、そこだけ注文をつけさせて頂ければありがたく存じます……！\nその他の表情や構図・ポーズなどについては、鈴木アイリさんのセンスをそのまま光らせて頂ける形でOKです！\n（しいて言えば恥じらい方向の方が好みですが、より良く仕上げられる構図が降りてくださったのならばそちらで問題ございません！）\n\n無茶な注文とは存じますが、何卒よろしくお願いいたします！\n\nhttps://www.pixiv.net/artworks/55194620", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 398772, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "にじべル", "screen_name": "nijiberu", "avatar_url": "https://pbs.twimg.com/profile_images/1770421432910303232/ILqFcU8N.jpg", "header_url": "https://pbs.twimg.com/profile_banners/943149786/1493620906/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30,