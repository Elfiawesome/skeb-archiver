さんの作品にとても刺激を受けているので、このようなモノクロのスタイルにカラーでアクセントをつけたものをお願いしたいです。\nhttps://twitter.com/k_o465/status/1536156465701978112?s=21&t=3W4zKdPcvBfsM63geO26RA\nhttps://twitter.com/k_o465/status/1535233768121724928?s=21&t=3W4zKdPcvBfsM63geO26RA\n\nもしよろしければ、SNSでも使いたいです。よろしくお願いします🙇。\n\nhttps://drive.google.com/drive/folders/1DBmYwOGoRlnEKC2qpgA8W4Fs3EQA2qVs", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@k_o465/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1263090, "client_id": 512988, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ba35374c/uploads/origins/9a1e17a9-728b-432d-9cb5-31206a8742e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51548ed45ecea22df83fd443c10ecaf7", "srcset": "https://si.imgix.net/ba35374c/uploads/origins/9a1e17a9-728b-432d-9cb5-31206a8742e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51548ed45ecea22df83fd443c10ecaf7, https://si.imgix.net/ba35374c/uploads/origins/9a1e17a9-728b-432d-9cb5-31206a8742e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=953981a0ca8e80180a4921b82599001e 2x, https://si.imgix.net/ba35374c/uploads/origins/9a1e17a9-728b-432d-9cb5-31206a8742e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=212c8ce602b6ecb7f7f0c7e8b2de634f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ba35374c/uploads/origins/9a1e17a9-728b-432d-9cb5-31206a8742e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5664dc2ea62aea7169643aa23dad340f", "srcset": "https://si.imgix.net/ba35374c/uploads/origins/9a1e17a9-728b-432d-9cb5-31206a8742e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5664dc2ea62aea7169643aa23dad340f, https://si.imgix.net/ba35374c/uploads/origins/9a1e17a9-72