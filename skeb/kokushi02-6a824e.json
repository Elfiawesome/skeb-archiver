e_genre": false}, {"path": "/@kokushi02/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2014418, "client_id": 47658, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc1d419e/uploads/origins/bccc5768-9ceb-4954-9127-e269da974b84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=983454757d5643d35be427e4d91c34ac", "srcset": "https://si.imgix.net/bc1d419e/uploads/origins/bccc5768-9ceb-4954-9127-e269da974b84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=983454757d5643d35be427e4d91c34ac, https://si.imgix.net/bc1d419e/uploads/origins/bccc5768-9ceb-4954-9127-e269da974b84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fc7415647fcf92c0c67375c775bb0cb2 2x, https://si.imgix.net/bc1d419e/uploads/origins/bccc5768-9ceb-4954-9127-e269da974b84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=756b7065f049edf80aeab24a97c0d910 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc1d419e/uploads/origins/bccc5768-9ceb-4954-9127-e269da974b84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=088624cd022efa19c58245d96510f254", "srcset": "https://si.imgix.net/bc1d419e/uploads/origins/bccc5768-9ceb-4954-9127-e269da974b84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=088624cd022efa19c58245d96510f254, https://si.imgix.net/bc1d419e/uploads/origins/bccc5768-9ceb-4954-9127-e269da974b84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=840a194166e6ef1a7519ac80ab40a2b3 2x, https://si.imgix.net/bc1d419e/uploads/origins/bccc5768-9ceb-4954-9127-e269da974b84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=acb296ef26efdf5f6600f139c0b85a08 3x"}, "body": "いつも素晴らしいイラストありがとうございます\n\n\n以前ツイッターで馬獣人化したサレン描いてらしたのでそれに似た感じのものを依頼します\nプリコネのクウカ(髪の色と同じ馬耳と尻尾、玉まで黒い馬チンポ)と\nウィザーズシンフォニーのシルヴィア(https://www.arcsystemworks.jp/wizards_symphony/character_05.html)(こちらは（https://skeb.jp/@kokushi02/works/16)みたいなサイズのただの巨根で)\nがお互い向き合って気持ちよさそうな表情で兜合わせ、もしくは双方のちんちんを手コキしているふたなり化イラストをお願いします\n\n・二人共玉あり(血管はなし)、クウカは陰毛あり(髪の毛と同じ色)。\n　サイズは胸に届くより大きく背よりは低い、\n　二人ともわかる程度には差異がある(黒紫さんのキャラに対するペニスイメージがある場合はそちら優先で)\n・衣装はできればありで(クウカは☆3,6どちらでも、衣装細部は簡略化してもらって構いません)\n・消しはモザイクではなく黒線\n・消し以外レイヤーは出来るだけ統合しないで\n\nご検討の程よろしくお願いします", "nc": 59, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kokushi02/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2014418, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b486719e/uploads/origins/84b7d392-69bd-4417-9455-8c076831cb30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d36f9be69591e0b046c27eb5410f458d", "srcset": "https://si.imgix.net/b486719e/uploads/origins/84b7d392-69bd-4417-9455-8c076831cb30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d36f9be69591e0b046c27eb5410f458d, https://si.imgix.net/b486719e/uploads/origins/84b7d392-69bd-4417-9455-8c076831cb30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0179b7914003143ab79dd935c9d8ea0 2x, https://si.imgix.net/b486719e/uploads/origins/84b7d392-69bd-4417-9455-8c076831cb30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=18ee930c3b2ccca7a6cbb4fab956ad18 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b486719e/uploads/origins/84b7d392-69bd-4417-9455-8c076831cb30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d20c9ec52352999d6c241fe4769d1aa", "srcset": "https://si.imgix.net/b486719e/uploads/origins/84b7d392-69bd-4417-9455-8c076831cb30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7d20c9ec52352999d6c241fe4769d1aa, https://si.imgix.net/b486719e/uploads/origins/84b7d392-69bd-4417-9455-8c076831cb30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=35964ac77a3dac520d0fc7884bb86baf 2x, https://si.imgix.net/b486719e/uploads/origins/84b7d392-69bd-4417-9455-8c076831cb30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=de9b55c0fa5caca1b9b0b8ff2bb74b93 3x"}, "body": "機動戦艦ナデシコのルリを乳首チンコで超根巨玉なふたなりにして欲しいです\n\nニヤリとピースしている感じで、衣装に穴を空けて竿を露出しています。\n射精シーンでは雪歩や智恵理のようにオホ顔絶頂で、喘ぎ声の描き文字も入れて欲しいです。\n乳首チンコ側は玉なしの方が嬉しいですが、描く上であった方がしっくり来るようでしたら\n作者様の感性を優先して頂いて大丈夫です。\n\nまた、線画は落書きやそのまとめで投稿されているようなラフで力強い方が好きでして、\n失礼な話かもですが、普段のカラー落書きのような仕上がりにしていただければと思います。\n\n長くなってしまいましたが、お題箱感覚で描いて頂ければ幸いです。\n（描きづらい要素はカットして頂いて大丈夫です。）\nお気に召しましたらよろしくお願いします。", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kokushi02/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2014418, "client_id": 1611368, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/914e30ba/uploads/origins/415e04bc-2ccc-4b8f-a61a-deb545ad9976?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1335189a5dd216b1e30029d551bff9b9", "srcset": "https://si.imgix.net/914e30ba/uploads/origins/415e04bc-2ccc-4b8f-a61a-deb545ad9976?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1335189a5dd216b1e30029d551bff9b9, https://si.imgix.net/914e30ba/uploads/origins/415e04bc-2ccc-4b8f-a61a-deb545ad9976?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb9f74b3f7eb60ae3f4339b47433af52 2x, https://si.imgix.net/914e30ba/uploads/origins/415e04bc-2ccc-4b8f-a61a-deb545ad9976?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=badb1605d72b73018cb974207a4d4711 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/914e30ba/uploads/origins/415e04bc-2ccc-4b8f-a61a-deb545ad9976?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=210c16fa7995d3799ca1f5382f9f43d1", "srcset": "https://si.imgix.net/914e30ba/uploads/origins/415e04bc-2ccc-4b8f-a61a-deb545ad9976?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=210c16fa7995d3799ca1f5382f9f43d1, https://si.imgix.net/914e30ba/uploads/origins/415e04bc-2ccc-4b8f-a61a-deb545ad9976?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6a4506a4c43b8c219601e667ae74b7ab 2x, https://si.imgix.net/914e30ba/uploads/origins/415e04bc-2ccc-4b8f-a61a-deb545ad9976?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc873ba17fe6438a034be04c860a5983 3x"}, "body": "原神の旅人(女)とモナをお願いしたいです。\n\n旅人(女)\n腋毛陰毛あり、ふたなり、デカくて垂れ気味の玉あり、馬ちんぽで首ぐらいの長さまであり、太さは体の3分の1ぐらいでチンカス付き。\n乳輪はまぁまぁでかめ、チクチンも生えていて玉つきで上向き、肩ぐらいまでの長さ。\n服は(https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQDgq7Fu8QFN8Oc6aOYcU79BG93TOVHZRn4Zw&usqp=CAU)のように腕の装飾のみという感じ。\n\nモナ\n整えた陰毛と腋毛、デカクリ、ちんこはなし。原作ぐらいのおっぱいに陥没巨パフィーニップル。\n服は(https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTgLZ1kpBEodRiJ_oWQQX7tL_YxjZXkLACTFQ&usqp=CAU)の原作のような服でお腹のタイツがなく、胸の部分と股の部分が大きく✧(ひし形の星)マークに空いていて、乳首の部分に✧(ひし形の星)マークのニップレス付き。\n\nシチュ\nバックの体位で旅人がモナの腕をしっかり掴み、後ろから股を通してちんこを見せ槍してムワァとなっている。\n旅人は我を忘れて興奮しており、モナは目を見開いて何が何だか分からない様子。\n\n可能であれば差分として挿入して腹ボコしている様子や射精差分、旅人がセックス中に自らチクチンを扱いて射精する差分、セックス中や射精中のオホ顔、モナのニップレスが剥がれて勃起した巨乳首が顕になっている様子、ちんこを抜いて精子が溢れてアヘトロ顔しちゃう様子など、なくても構わないので黒柴さんの可能な範囲でお願いしたいです。\n\n不明なところや細かいところは黒柴さんの性癖で補間して貰って構いません。\n長い文で、煩わしい依頼だとは思いますが、是非お願いしたいです！", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kokushi02/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2014418, "client_id": 1082723, "vtt_url": null, "thumbnail_image_urls": {"src":