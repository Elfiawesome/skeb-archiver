.com/app/2804960/_/\n\n以上、お手すきで諸々ご承知いただけた際にご検討いただけたら大変光栄でございます。\n\nよろしくご検討のほどお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1ARFjPVLN2nwMOm1OsRgx2JhTQHdQq-mZ?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@paldynojosh/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 91500, "client_id": 1199743, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d9b7501/uploads/origins/69a3d7e4-d93b-404d-b42b-d1f242819d38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cef1db9b7e85c57886aeae27f94a951", "srcset": "https://si.imgix.net/0d9b7501/uploads/origins/69a3d7e4-d93b-404d-b42b-d1f242819d38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4cef1db9b7e85c57886aeae27f94a951, https://si.imgix.net/0d9b7501/uploads/origins/69a3d7e4-d93b-404d-b42b-d1f242819d38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c28bab58c63846bb80b4b42e32305feb 2x, https://si.imgix.net/0d9b7501/uploads/origins/69a3d7e4-d93b-404d-b42b-d1f242819d38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=733a54a7597b59022a203db3ad07da5c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d9b7501/uploads/origins/69a3d7e4-d93b-404d-b42b-d1f242819d38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14b416e916dccae7ed1e55cd625bc1e7", "srcset": "https://si.imgix.net/0d9b7501/uploads/origins/69a3d7e4-d93b-404d-b42b-d1f242819d38?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14b416e916dccae7ed1e55cd625bc1e7, https://si.imgix.net/0d9b7501/uploads/origins/69a3d7e4-d93b-404d-b42b-d1f242819d38?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f24b0408435716914f944c2cb0c22cc4 2x, https://si.img