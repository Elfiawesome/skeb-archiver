t=PRIVATE&s=0b4a5aa9841c43d5d89697166882c4c6", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2634363, "client_id": 3096520, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Kyosuke1413koba/works/20", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bf1c08fa/uploads/origins/a42cd00d-3adf-4e62-aa85-8c43d758e933?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=479d85304b3f1d1301201ffed8e3ae61", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2634363, "client_id": 1949587, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Kyosuke1413koba/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2634363, "client_id": 706365, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aa3a354f/uploads/origins/5a5c09fc-5e1f-42cc-ada0-2ce811e35ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1988ae844f2770e17203dc47a643bb39", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa3a354f/uploads/origins/5a5c09fc-5e1f-42cc-ada0-2ce811e35ef9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31c021a1ad735280db4707c8445d27be", "src_set": ""}, "body": "はじめまして。\nXで冷やしホムラちゃんのイラストをお見掛けし、\n涼やかで透明感ある美しさに惹かれました。\nhttps://x.com/Kyosuke1413koba/status/1941105019778105748\nまた、Skebで納品されているこちらのイラストも良かったです。\nhttps://skeb.jp/@Kyosuke1413koba/works/8\n小林きょうすけ様の絵柄で推しを見てみたいと思い、リクエストさせていただきます。\n普段描かれないタイトルと思いますが、ご一考いただけますと幸いです。\n\n【作品】フラワーナイトガール\n【キャラクター】ブルーロータス\n【衣装】進化前衣装\n【シチュエーション】\n表情は笑顔。\n全身、または膝から上が入るような構図でお願いします。\nポーズにはとくに指定はありません。\nその他の詳細はおまかせとさせてください。\n\n■参考情報\n・おっとりした雰囲気でしっかり者のお姉さんといった性格です。\n・Wikiで視認しづらいですが左右に泣き黒子があります。\nhttps://drive.google.com/drive/folders/1i7pl60WVwA8zNha3l8MFH4K1ukeRGruw?usp=sharing\n\nhttps://xn--eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%83%96%E3%83%AB%E3%83%BC%E3%83%AD%E3%83%BC%E3%82%BF%E3%82%B9", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kyosuke1413koba/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2634363, "client_id": 2683234, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/652928f4/uploads/origins/b9733fe8-f4ab-4016-a6cb-dc3e6dcaed71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6fc50e79527cdb84f04ee1db82540d74", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/652928f4/uploads/origins/b9733fe8-f4ab-4016-a6cb-dc3e6dcaed71?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4195b0e5fb27a54b6a3f1dee24531c18", "src_set": ""}, "body": "こんにちは！前回のリクエストの作品がとても気に入ったので、また別の作品をリクエストしたいです。\n\nミュージックビデオのアートワークです。曲はFuture Awaits (https://www.youtube.com/watch?v=ofMYZB1UmT0&pp=ygUNZnV0dXJlIGF3YWl0cw%3D%3D) です。\n\nあと、VTuberを3着描いて欲しいです。\n\n最初の衣装はMelia (Xenoblade 1 DLC)です。私の角をMeliaの翼に置き換えて、私のVTuberの髪型はそのままにしてください！\n\nつ目はカスタム衣装のイージスの衣装です。髪型は画像＜Luna_Main_Outfit＞にある髪型でお願いします。角は私のイージスモデルにある角を使ってください。\n\n3つ目の衣装はゼノブレイド3のAです。その衣装は私のvtuberのロングヘアーバージョンを使ってください。\n\n私のドラゴンの翼は描かないでください。\n\n可能であれば、背景は3種類にしてほしい。フォルダの中に参考資料があります。\n\nキャラクターは別々に、そして一緒に登場させてください。\n\n量が足りない場合は追加でお願いします！ありがとうございました！\n\nhttps://drive.google.com/drive/folders/16Z8y0n4DAIBQ4GY8OOVE2GmKpcF6r9K3?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kyosuke1413koba/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2634363, "client_id": 2683234, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea203827/uploads/origins/cbf7f614-5f02-4cdd-a820-15c372de4f87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ddc8dbe8fa09d752868a53e097bc9e93", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea203827/uploads/origins/cbf7f614-5f02-4cdd-a820-15c372de4f87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23693caf54726a1887ec11eced13685d", "src_set": ""}, "body": "こんにちは！VTuberのイラストをお願いしたいのですが。\n\n彼女は宇宙から来たドラゴンで、願いを叶えてくれます。性格はとても自信家でわがままで、自分を神様のように思っています。\n\n胴体、肩、太ももの肌は青く、星が描かれています。髪と翼にも夜空が宿っている。\n\n手に三日月を持ち、自信に満ちた邪悪な表情と夜空を背景にしてほしい。\n\nソーシャルメディアやライブストリームにも使いたい。\n\nご検討よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1TkPxwYu3PCzNRPIsmxJ2sLcFFr2tNAsh?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kyosuke1413koba/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2634363, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3bed3579/uploads/origins/a10fa3d9-237f-4e08-b33c-2a1a062674c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db952e2ef1f98c7fa7f2eb4d98afcc57", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3bed3579/uploads/origins/a10fa3d9-237f-4e08-b33c-2a1a062674c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50cf4db5d925d921da5fa9f0e36d2ba9", "src_set": ""}, "body": "こんにちは！YouTubeでストリーマーをしている神城リタです。この夏、友達とゼノブレイド2をテーマにしたTTRPGを配信するのですが、4人のキャラクターのイラストを描きたいと思っています。このアートワークは、ストリーミングやビデオ目的だけでなく、ソーシャルメディアでも使用するつもりです。キャラクターの詳細は参考URLにあります。必要であれば、デザインにあなた自身の個人的なスタイルを追加し、色に若干の調整を加えることができます。\n\n可能であれば、キャラクターは別レイヤーで分けてください。また、各キャラクターのニュートラルな表情、喜怒哀楽の表情も別レイヤーでお願いします。背景は不要です。ドライバーとブレードのキャラクターは隣り合わせで描いてください。\n\nhttps://imgur.com/a/xTFCLiM", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kyosuke1413koba/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2634363, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/12200ad0/uploads/origins/f0187c9c-b247-4bc0-9808-be6559a8471f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b83cb7e330f457abad0f36729122ff17", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/12200ad0/uploads/origins/f0187c9c-b247-4bc0-9808-be6559a8471f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e265a2c2b4b1bf221816230dcf162f84", "src_set": ""}, "body": "こんにちは、ゼノブレイドのリクエストを送りたいと思います。かっこいいポーズのモンドを持ったタイオンです。背景もポーズも自由にデザインしてください。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kyosuke1413koba/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/be327035/uploads/origins/80189075-cd24-4d98-a31a-652b7d7e0628?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d3cbeafbf07aaf8a8fa32a7ff365a4f7", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2634363, "client_id": 2964848, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Kyosuke1413koba/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2634363, "client_id": 2442343, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6272ca01/uploads/origins/91b6f3c7-f8d6-4496-8b90-11afdb8f36f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=28782a1818942b63dabd8eb4e137857f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6272ca01/uploads/origins/91b6f3c7-f8d6-4496-8b90-11afdb8f36f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1275f1550b5ad63a28d3737890136940", "src_set": ""}, "body": "京介へ、\n\n前回のリクエストに応えて描いてくれてありがとう！私のリクエストに応えてくれて、今でもニヤニヤしてしまいます！焚き火に照らされたパイラとマイスラがとても綺麗でした！\n\nもっとお仕事が必要なようなので、少しお手伝いしたいと思いました！今回、私は自分のリクエストを隠したくない！\n\nお願いは簡単で、パイラとマイスラをまた描いてください。覚えてるかな？それ以外のことは完全にお任せします！好きなように描いてください！PyraとMythraの衣装、構図、位置も全てお任せします！\n\nお願いしたいのは、あなたのイラストの美しさで私を笑顔にしてくれること！あなたのイラストをx.comのプロフィール画像とバナーに使いたいです！\n\nありがとうございました！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kyosuke1413koba/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2634363, "client_id": 3399726, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e877cdc/uploads/origins/cc1eb781-1784-4251-bd99-98799cf8687b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05d757d02a75a20e6e7a662cdf16628a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e877cdc/uploads/origins/cc1eb781-1784-4251-bd99-98799cf8687b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=808c0ab8444d9ff4ff38a01b9c112b8c", "src_set": ""}, "body": "ゼノブレイド3のユズリハをお願いしたいです…！(初skebリクエストなので抽象的ですみません)", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kyosuke1413koba/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2634363, "client_id": 2825700, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0cccc5bf/uploads/origins/ba41ca9c-1edc-4e4a-a996-3884b9aefa79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e25b067c17a29f3f7cdc6b5efe0bbf5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0cccc5bf/uploads/origins/ba41ca9c-1edc-4e4a-a996-3884b9aefa79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a42c996227c4c64268761db9c9c6848a", "src_set": ""}, "body": "また戻ってきたよ！\n\n以前は素晴らしいグリマーのイラストをありがとうございました。私のお気に入りのひとつで、彼女の魅力を見事に表現してくれました。今回は、私が本当に楽しいと思ったカジュアルなシナリオを提案したいと思います。\n\nマイスラ／ヒカリとレックスが一緒にゲームをしているシーンを描いていただけませんか？\n\n舞台はレフトヘリアのコリーヌの家でも構いません。\n\nhttps://static.wikia.nocookie.net/xenoblade/images/3/32/Corinne%27s_House.jpg/revision/latest?cb=20230805185916\n\nhttps://www.xenoserieswiki.org/w/images/thumb/c/cc/A_Moment%27s_Peace_Heart-to-Heart.jpg/800px-A_Moment%27s_Peace_Heart-to-Heart.jpg\n\nマイスラ／ヒカリには、カジュアルな服装で、いつものティアラと羽の髪飾りはあるものの、あなたのこの作品と同じようなお団子ヘアにしてもらいたい：\n\nhttps://x.com/Kyosuke1413koba/status/1833138937981989172/photo/1\n\n胸にフルコアのクリスタルをつけた彼女を描いてください。\n\nレックスはゼノブレイド3のエンディングで少し老け込んだような姿でもいいです：\n\nhttps://pbs.twimg.com/media/GYxPCEyWIAMyd1f?format=jpg&name=large\n\nマイスラ／ヒカリはゲームに夢中で、やや緊張した表情をしているが、それでも目に見えて楽しんでいる。レックスは「うわー、この子、本当に熱中してる！ちょっとかわいいけど」とぎこちなく笑う。2人ともSwitchのプロコントローラーを持っている：\n\nhttps://m.media-amazon.com/images/I/71INYpPDGzL.jpg\n\n2人が楽しんでいる様子にフォーカスしているため、何のゲームをプレイしているかを見せる必要はない。\n\n新年明けましておめでとうございます！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kyosuke1413koba/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2634363, "client_id": 1321707, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8ff56dec/uploads/origins/c63e29aa-abda-41d4-92fc-43de9c49f9a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07b7afa1444d5efd51a330087e3234dd", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ff56dec/uploads/origins/c63e29aa-abda-41d4-92fc-43de9c49f9a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c720d218fb796ccccb755a4e6626167f", "src_set": ""}, "body": "こんにちは！ゼノブレイドクロニクル3のグリマー（カギロイ）を描いた絵がとても気に入ったので、リクエストさせてください！\n\nゼノブレイドクロニクル3のニアの普段着を描いていただけませんか？彼女のデザインは下のリンクに参考資料があります：\n\nニア（ゼノブレイド3）デザイン：https://imgur.com/a/mom0aCp\n\nニアが地平線を見下ろしているような、切なげな笑みを浮かべているような表情を描いてほしいです。どのようなポーズで描くかは自由です。\n\n環境としては、ゼノブレイド3のキャプトコーンピーク地方のような環境を希望します。下のリンクにロケールのリファレンスを用意した：\n\nキャプトコーンピーク参考：https://imgur.com/a/LDvJZG8\n\nその他の詳細については、皆様のご判断にお任せいたします。ご検討のほど、よろしくお願いいたします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kyosuke1413koba/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7205c15e/uploads/origins/78369022-e7f1-4b15-b72a-e0b225dc0536?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=32141f203ebff06c6f3d44e15293791f", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2634363, "client_id": 3096520, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Kyosuke1413koba/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2634363, "client_id": 2825700, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e54edefa/uploads/origins/b4040440-2043-4b0a-b82a-d4690f58082d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b8e06b427086643208fb274bcafa97f7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e54edefa/uploads/origins/b4040440-2043-4b0a-b82a-d4690f58082d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c35fc91b8bafcfb44719874f6b4f1dd6", "src_set": ""}, "body": "再びこんにちは！少し前に届けていただいたウラジレーナの素敵な写真をお願いした者です。ありがとうございました！もしよろしければ、またリクエストしたいのですが、今度はゼノブレイド3のグリマー/カギロイをお願いしたいです。\n\n星降る夜、キャンプファイヤーでリュートを演奏しているシーンを描いていただけませんか？リラックスした笑顔で。\n\nご検討よろしくお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kyosuke1413koba/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/50352d15/uploads/origins/30f4939c-9522-4843-a5bc-82d832c5e7f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=161a1ba28c9bdb68dbdb55f56ae9501c", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2634363, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Kyosuke1413koba/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7720e51e/uploads/origins/060ce2b2-0b57-4b51-a1a4-43324ad3874a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5607f09c39719d7526667d9fd68b380c", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2634363, "client_id": 3096520, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Kyosuke1413koba/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/68b3627d/uploads/origins/e26c8222-158f-4bcd-af7d-c774737fcc4f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=04f06c5d2a26003fdc633b94ff0a35d7", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2634363, "client_id": 2442343, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 129, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@Kyosuke1413koba/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2634363, "client_id": 2964848, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d2718489/uploads/origins/edad9499-6a35-451a-b822-173c7872b345?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7e8488ab4fc4fc9dbff6d56d1810f16", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d2718489/uploads/origins/edad9499-6a35-451a-b822-173c7872b345?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=099bd19bfe8ff8e63fede8a03357173a", "src_set": ""}, "body": "Dear Mr Kysosuke,\nI have been a huge fan of your art and I hope this request finds you well. I am a phd student working with ultrafast laser systems; If you look at this year’s physics nobel prize, this is exactly the field we are working on. As our really, really “fancy” and expensive laser has stopped working for two months already, I have promised my co-worker that if the laser was not fixed by November, I would commission an artwork of personifying our laser as a cute, tsundere girl. Unfortunately, it is highly unlikely the laser’s company would manage to fix the laser by the end of this week, I could do nothing but turning this dire situation into a good joke in the office. The detailed request is as followed:\n1.\tPlease design and draw a full body artwork of our laser system in the form of a tsundere girl. Feel free to design her whatever you like, but if you want to give her glasses then please also provide a variant of her without wearing glasses. You could find the picture of our laser and its logo in the following link (the logo on the laser will light up when you turn it on, which is pretty cool)\n\nhttps://drive.google.com/file/d/1VCgCDbHKzsDImZ8Gr63xpXbOz368EiYL/view?usp=sharing\n\n2.\tTo help you visualise the “personality” of our laser, you could consider the following stories:\ni)\tShe is an extremely talented and expensive laser system, but her output power is extremely strong (her laser can easily burn through a wall), therefore we have to work very cautiously around her\nii)\tShe got a strong temper and she can be easily embarrassed when being complimented. For example, after spending weeks of maintenance, she had finally produced an experimental data with the highest quality we could ever imagine. We are ecstatic and praised her for the entire day. However, she got so flustered to the point she stopped working the next morning.\niii)\tShe was secretly very lonesome; Her parents (the laser company) always neglected her as they are very busy with their jobs. This is also why it often takes weeks for them to response to us whenever the laser has issues.\nFeel free to show the completely artwork publicly, but please do not show the laser logo in the publicised artwork, otherwise I would get into deep trouble :)\n\nThe follow zip file also contains translated text from chatgpt, as there is some mistranslation with deepl. Please feel free to take reference from it, but rest assured, the official commission will still only be based on the text given on Skeb and whatever the autotranslation gave you on the site.\nhttps://drive.google.com/file/d/1VCgCDbHKzsDImZ8Gr63xpXbOz368EiYL/view?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kyosuke1413koba/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2634363, "client_id": 267144, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/449259a0/uploads/origins/da42217c-d67a-40aa-808d-927c32a6aa47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13ec0edc7e5686a765adaf2e41ac13ae", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/449259a0/uploads/origins/da42217c-d67a-40aa-808d-927c32a6aa47?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd896a2208e0db6af719e9ebe067c28d", "src_set": ""}, "body": "本来はもっと先に予算をご用意出来てからリクエストさせていただきたかったのですが、ピンチのご様子でしたので足りないとは分かりつつも急ぎご必要かと思いリクエストを送らせていただきます\n\n\n内容\n当方のオリキャラの中からお好きなキャラを選んでいただきそのキャラと弾力のある割れないシャボン玉との絡みイラスト\n\nキャラデザ\n資料URLのリプライよりお好きなキャラを選んでください\n\n衣装\n元々のキャラデザの衣装に限定しませんので季節のイベントに合った衣装や着せてみたいと思った衣装などご自由に描いてください\n\nシャボン玉\nぽよんぽよんとゴムのような弾力のある割れないシャボン玉\nという設定でキャラと絡めてください\nシャボン玉は内側からも外側からもいくら力を加えても形を歪めるだけで割れることがないため、中に閉じ込められると膜をいくら叩いたり蹴ったりしても膜が伸びるだけで出られなかったり抱きついたり上に乗ったりしてもぽよんぽよんと形を歪めるだけというシャボン玉でお願いいたします\n\nその他\nお任せいたします\n\n以上が内容となります\nTLのメディア欄より拝見したチャイナ服のキャラの張りのある絵柄に一目惚れし是非とも当方のオリキャラでも張りのある大変豊かな胸での可愛いキャラを描いていただきたいです！\n本来リクエストしたかった金額よりも低くなってしまい申し訳ございませんが、もしよろしければ何卒よろしくお願いいたします\n\nhttps://twitter.com/syabon09/status/1339556724034863104?t=UHsKcsHpAfP0aGzBY4yMsA&s=19", "nc"