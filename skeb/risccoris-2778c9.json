い描写を可能ならお願いします。\n普段の帽子も外してokです。その代わりにコサージュか麦わら帽子などを希望です。\n表情は両目開き＆口閉じのほほえんだ感じに。\n\nまた可能な場合、オプション的な描写として、トロピカルジュースを乗せたトレイを飛行機で吊るしている描写もお願いします。\n\nhttps://wikiwiki.jp/senkan-girl/No252%20%E3%82%AF%E3%83%AA%E3%83%BC%E3%83%96%E3%83%A9%E3%83%B3%E3%83%89", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@risccoris/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2806676, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cadf6350/uploads/origins/9bba2607-2fa9-4d72-93ed-467c8d5fa5f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4edaab909f028e8b6ba65e1ce8e42248", "srcset": "https://si.imgix.net/cadf6350/uploads/origins/9bba2607-2fa9-4d72-93ed-467c8d5fa5f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4edaab909f028e8b6ba65e1ce8e42248, https://si.imgix.net/cadf6350/uploads/origins/9bba2607-2fa9-4d72-93ed-467c8d5fa5f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ec52e27e62194da2458b904b3e8c856e 2x, https://si.imgix.net/cadf6350/uploads/origins/9bba2607-2fa9-4d72-93ed-467c8d5fa5f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=714f298dfdeb39e30ae002434c87ec2a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cadf6350/uploads/origins/9bba2607-2fa9-4d72-93ed-467c8d5fa5f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1eb04bb99aa070141ff93740a725d23c", "srcset": "https://si.imgix.net/cadf6350/uploads/origins/9bba2607-2fa9-4d72-93ed-467c8d5fa5f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1eb04bb99aa070141ff93740a725d23c, https://si.imgix.net/cadf6350/uploads/origins/9bba2607-2fa9-4d72-93ed-467c8d5fa5f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200