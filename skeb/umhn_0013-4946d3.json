Shaula/シャウラ\nスラム出身の年齢不詳(二十代前半)。身長187cm。ダンスが得意。\nモチーフはサソリ・蠍座。\n\n構図や衣装・雰囲気等はお任せいたします。\n断片的な資料しかなく大変申し訳ありませんが、ぜひとも海花様の解釈で書いていただけますと幸いです。\n\n描くのが難しい場合や不備がある場合は遠慮なく再送要請や拒否等していただいて構いません。\nご検討のほど、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/19NPcY8wpXZ_3DuIzsOipqKBTkOwyB8YA?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@umhn_0013/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3899708, "client_id": 1437512, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ecf074f5/uploads/origins/58ecf72a-0d26-45a5-a842-76950dc5adb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e75d886f2f1bc40ae2a746f9d2a007f", "srcset": "https://si.imgix.net/ecf074f5/uploads/origins/58ecf72a-0d26-45a5-a842-76950dc5adb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e75d886f2f1bc40ae2a746f9d2a007f, https://si.imgix.net/ecf074f5/uploads/origins/58ecf72a-0d26-45a5-a842-76950dc5adb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=60c42d32918c47474f1985861a066dd7 2x, https://si.imgix.net/ecf074f5/uploads/origins/58ecf72a-0d26-45a5-a842-76950dc5adb1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e3074c07089e7077f31bebc750d6d23c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ecf074f5/uploads/origins/58ecf72a-0d26-45a5-a842-76950dc5adb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9401148f25225f8cd413c5646ad6434", "srcset": "https://si.imgix.net/ecf074f5/uploads/origins/58ecf72a-0d26-45a5-a842-76950dc5adb1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9401148f25225f8cd413c5646ad6434, https://si.imgix.net/ecf074f5/uploads/origins/58ecf72a-0d26-45a5-a842-76950dc5adb1?bg=%23fff&auto=form