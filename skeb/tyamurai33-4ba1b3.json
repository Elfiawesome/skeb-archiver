.net/c5ac08bc/uploads/origins/29146699-1053-49c3-8646-842b42260b26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a4ca99b733763a84b03b5f71b72d9e2", "srcset": "https://si.imgix.net/c5ac08bc/uploads/origins/29146699-1053-49c3-8646-842b42260b26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a4ca99b733763a84b03b5f71b72d9e2, https://si.imgix.net/c5ac08bc/uploads/origins/29146699-1053-49c3-8646-842b42260b26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e674763eaea7d2cea02b475b8e41a2e1 2x, https://si.imgix.net/c5ac08bc/uploads/origins/29146699-1053-49c3-8646-842b42260b26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eb6d19eb1f77ae39dabb36de3194783b 3x"}, "body": "ねえ、あなたのアートスタイルが本当に好きなの!私のキャラクター、イザベル・ヴィテリがグレアとエッチなことをしているところを描いていただけませんか？彼女は背が高く、深く日焼けした肌と真っ黒な瞳を持っています。バストは大きく、ウエストは細く、ヒップは大きく、太ももは太い。\n\nそんなイザベルを『進撃のバハムート』『グランブルーファンタジー』のグレアと一緒に描いて欲しいです!\nグレアはとてもとても大きな胸で描いてください。グリアの胸は頭より大きいはずです。\nこんな感じです。https://imgur.com/a/uVajSly\n\nイザベルはグレアの後ろにいて、グレアの体の周りに手を伸ばしてグレアの胸を掴んでいます。\nイザベルがグレアの胸の大きさに魅了されているように見える中、グレアはイザベルが彼女の大きな胸を揉みしだき、深く赤面しています。\nイザベルはグレアの胸をかなり強く揉みしだき、揉みまくっている。\nグレアはイザベルを止めようとはせず、冷酷に胸を揉みしだき、揉みしだく。\n\nポーズ参照。\nhttps://imgur.com/a/sgYb1QE\nイザベル・ヴィテリの参考文献。\nhttps://imgur.com/a/sfzZgbI\nGreaのリファレンス。\nhttps://imgur.com/a/jRwxH2G\n\nhttps://imgur.com/a/sfzZgbI", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tyamurai33/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 433584, "client_id": 2145939, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e785b4f/uploads/origins/322941ac-83fd-4897-9b8f-9e1c5f75c860?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bb2e32d27d0465bca3a786afb37ee70", "srcset": "https://si.imgix.net/3e785b4f/uploads/origins/322941ac-83fd-4897-9b8f-9e1c5f75c860?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7bb2e32d27d0465bca3a786afb37ee70, https://si.imgix.net/3e785b4f/uploads/origins/322941ac-83fd-4897-9b8f-9e1c5f75c860?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e855fec448c1ba24b7595b427f911eb3 2x, https://si.imgix.net/3e785b4f/uploads/origins/322941ac-83fd-4897-9b8f-9e1c5f75c860?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9583ab26589b0b4eab2e23ef8b924b49 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e785b4f/uploads/origins/322941ac-83fd-4897-9b8f-9e1c5f75c860?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5bd5f0db294d38d1937211d77bcb44ef", "srcset": "https://si.imgix.net/3e785b4f/uploads/origins/322941ac-83fd-4897-9b8f-9e1c5f75c860?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5bd5f0db294d38d1937211d77bcb44ef, https://si.imgix.net/3e785b4f/uploads/origins/322941ac-83fd-4897-9b8f-9e1c5f75c860?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f25d6fafe08e3891754e63f3bd0b8159 2x, https://si.imgix.net/3e785b4f/uploads/origins/322941ac-83fd-4897-9b8f-9e1c5f75c860?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e1bd953b115f49c380d8077c40c5a827 3x"}, "body": "こんにちは！私はあなたの作品の大ファンです。私のキャラクター、イザベル・ビテリがアズールレーンのリノと変態なことをしているところを描いていただけないでしょうか？\nイザベルは背が高く、深く日焼けした肌と真っ黒な瞳を持っています。バストは大きく、ウエストは細く、ヒップは大きく、太ももは太い。\n\nレノは「レノ文乃」の衣装で描いてください。https://imgur.com/a/Q9xFKxd。\nまた、レノの胸は頭よりずっと大きくしてください。\n\nイザベルとレノの全身を描いてください。\n\nポーズは提供されたこのアートに近いものをお願いします：https://imgur.com/a/DHPdueI\nイザベルは八雲ゆかり、レノは八雲蘭のポジションを担当します。\nイザベルがレノの手首を掴むのではなく、レノの胸を掴むようにお願いします。\nつまり、イザベルがリノにキスをしようと身を乗り出しているときに、イザベルもリノの胸を揉んだり触ったりしているわけです。\n\nイザベルの顔にムラムラした表情をつけて、リノが恥ずかしそうにしているところをお願いします。\n\nレイヤーを透明にして分離してください。\n\nイザベル・ヴィテリ参考\nhttps://i.imgur.com/JThZXAF.jpg\n\nhttps://i.imgur.com/JThZXAF.jpg", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tyamurai33/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/02402968/uploads/origins/765815f8-30c3-4859-9dce-c946edeb5cea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ed4dc26e1f90a0f1611839d585beaef", "srcset": "https://si.imgix.net/02402968/uploads/origins/765815f8-30c3-4859-9dce-c946edeb5cea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7ed4dc26e1f90a0f1611839d585beaef, https://si.imgix.net/02402968/uploads/origins/765815f8-30c3-4859-9dce-c946edeb5cea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=323816551ea6260d45bfd891cb6491f3 2x, https://si.imgix.net/02402968/uploads/origins/765815f8-30c3-4859-9dce-c946edeb5cea?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d56f104428a9d250eae9db64df6d5947 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 433584, "nc": 161}], "sent_works": [], "similar_creators": []}, "price_history": {"art": [{"amount": 10000, "recorded_at": 1783254548.798211}], "correction": [{"amount": 500, "recorded_at": 1783254548.798211}]}, "custom": {}}