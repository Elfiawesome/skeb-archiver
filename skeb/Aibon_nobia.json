うございます」と微笑んで挨拶する感じでお願いします。\n風太郎視点で描写して下さい。\n寝起きのため頭のリボンは無しでお願いします。\n\n【その他】\n背景はそれとなく分かる程度で大丈夫です。\nご検討のほどよろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Aibon_nobia/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 322885, "client_id": 1668919, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d356333/uploads/origins/aa227761-1262-4078-9cdf-7a1db68d4118?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=839d84c0624d8bfacdbe6a6d31b201cf", "srcset": "https://si.imgix.net/5d356333/uploads/origins/aa227761-1262-4078-9cdf-7a1db68d4118?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=839d84c0624d8bfacdbe6a6d31b201cf, https://si.imgix.net/5d356333/uploads/origins/aa227761-1262-4078-9cdf-7a1db68d4118?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cbfa40ac7d156ebbeef5bdde603d5c65 2x, https://si.imgix.net/5d356333/uploads/origins/aa227761-1262-4078-9cdf-7a1db68d4118?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fdc1387e1a3c4e8c2e874b5243e636f7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d356333/uploads/origins/aa227761-1262-4078-9cdf-7a1db68d4118?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f08c505b06f1b0ce705853bdd14609c2", "srcset": "https://si.imgix.net/5d356333/uploads/origins/aa227761-1262-4078-9cdf-7a1db68d4118?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f08c505b06f1b0ce705853bdd14609c2, https://si.imgix.net/5d356333/uploads/origins/aa227761-1262-4078-9cdf-7a1db68d4118?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8e13777d70b4b73db094ee870ebbc672 2x, https://si.imgix.net/5d356333/uploads/origins/aa227761-1262-4078-9cdf-7a