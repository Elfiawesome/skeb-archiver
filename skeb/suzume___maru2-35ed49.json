uto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d61ee69eb14ff6d125ba251473ef800c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4f6eb4bf/uploads/origins/cec3306e-d36d-46ae-b2a9-19d184b0cd4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec5c660e404e52de82d2193edd19bf62", "srcset": "https://si.imgix.net/4f6eb4bf/uploads/origins/cec3306e-d36d-46ae-b2a9-19d184b0cd4a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec5c660e404e52de82d2193edd19bf62, https://si.imgix.net/4f6eb4bf/uploads/origins/cec3306e-d36d-46ae-b2a9-19d184b0cd4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3fd3bd727c632c45a649adbfd67bab65 2x, https://si.imgix.net/4f6eb4bf/uploads/origins/cec3306e-d36d-46ae-b2a9-19d184b0cd4a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f4c2f505d82e2dca83cc3eba85671271 3x"}, "body": "雀丸様、度々とお世話になります。\nよろしければVtuverの暁城ゼットちゃんの一枚絵を描いてほしいです。\n雀丸様のムキムキ男性の絵を見てぜひともゼトちゃんを描いて頂きたく…\n\n【サイズや解像度】描きやすいようにご自由にお選びください。\n【ファイル形式】ご自由にお選びください。\n【色】カラーでお願い致します。\n【資料参照】URLに服装資料が通常衣装と新衣装がありますが描きやすい方をお選びください。\n【背景】不要です。\n【ポーズやシチュエーション】男らしさの中に可愛らしさも混じってる感じで描いてくださるとうれしいです。筋肉描くの上手マンを発揮してくださると非常に喜びます…。\n【備考】あげる場合本人の暁城画タグをいれてくれると届くので嬉しいです。おまかせします。\n\nhttps://x.com/zet_akatsuki/status/1715834885586505780", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@suzume___maru2/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1528053, "client_id": 2979101, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bfedac99/uploads/origins/64b23921-e89f-43b1-b462-66a1a01a07d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b03603a3d2932305ae681ca28e50d10", "srcset": "https://si.imgix.net/bfedac99/uploads/origins/64b23921-e89f-43b1-b462-66a1a01a07d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b03603a3d2932305ae681ca28e50d10, https://si.imgix.net/bfedac99/uploads/origins/64b23921-e89f-43b1-b462-66a1a01a07d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7ce8799611fc712ec2e862e89ccc980d 2x, https://si.imgix.net/bfedac99/uploads/origins/64b23921-e89f-43b1-b462-66a1a01a07d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f6052cc42ac35a92e5e1eff25d03a9f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bfedac99/uploads/origins/64b23921-e89f-43b1-b462-66a1a01a07d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88e8d3e4b1da293ff13aace5a410dee4", "srcset": "https://si.imgix.net/bfedac99/uploads/origins/64b23921-e89f-43b1-b462-66a1a01a07d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88e8d3e4b1da293ff13aace5a410dee4, https://si.imgix.net/bfedac99/uploads/origins/64b23921-e89f-43b1-b462-66a1a01a07d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cb2565cdd027a292805ae8a1292a53f7 2x, https://si.imgix.net/bfedac99/uploads/origins/64b23921-e89f-43b1-b462-66a1a01a07d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b7cee27e5d0a9498ec80adf68a8a8471 3x"}, "body": "雀丸さんお疲れ様です。\n版権が可能でしたら海外カートゥーン作品「ボージャックホースマン」からボージャック(馬の方)&Mr.ピーナッツバター(犬の方)をお願いしてもよろしいでしょうか？\n雀丸さんの描くケモノが好きでずっと機会をうかがっておりました…\n\n下記に海外ウィキですが資料を貼らせていただきます。\n雀丸さんの絵柄バリバリで並んでいる所を描いていただけると幸いです。\nピーナッツバターくんのほうはニッコリ笑って犬の歯が出ている所、ボージャックのほうはそんなピーナッツバターに呆れている(嫉妬しているため塩対応が多い関係です)jジト目顔をしていると嬉しいです。\n\nふたりは年代が色々あるのですがボージャックは「2000s-S6E07」というデザイン、ピーナッツバターは「Current」だと嬉しいです。年齢としては50代前半と40代後半です。Gallaryという所を押すと作中のキャプチャがたくさん見れるのでご参考ください\nhttps://bojackhorseman.fandom.com/wiki/BoJack_Horseman\nhttps://bojackhorseman.fandom.com/wiki/Mr._Peanutbutter\n\nめちゃくちゃ見たいです。何卒ご検討よろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@suzume___maru2/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1528053, "client_id": 1693946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1e5eb8c5/uploads/origins/bcaa3d33-e378-4a0c-a8d9-a92e7f2a3e2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7b03c6061fbcaaa7eaeab3ebd210af9", "srcset": "https://si.imgix.net/1e5eb8c5/uploads/origins/bcaa3d33-e378-4a0c-a8d9-a92e7f2a3e2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b7b03c6061fbcaaa7eaeab3ebd210af9, https://si.imgix.net/1e5eb8c5/uploads/origins/bcaa3d33-e378-4a0c-a8d9-a92e7f2a3e2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ef6323c204acc8f82623eb1c589ea3b 2x, https://si.imgix.net/1e5eb8c5/uploads/origins/bcaa3d33-e378-4a0c-a8d9-a92e7f2a3e2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=223e55c048f55c3d36d4474193eff1c7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e5eb8c5/uploads/origins/bcaa3d33-e378-4a0c-a8d9-a92e7f2a3e2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11b9729ed4ce46a2815c2eafca52cc1e", "srcset": "https://si.imgix.net/1e5eb8c5/uploads/origins/bcaa3d33-e378-4a0c-a8d9-a92e7f2a3e2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=11b9729ed4ce46a2815c2eafca52cc1e, https://si.imgix.net/1e5eb8c5/uploads/origins/bcaa3d33-e378-4a0c-a8d9-a92e7f2a3e2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=af0a9677b25a674569127752ec235e88 2x, https://si.imgix.net/1e5eb8c5/uploads/origins/bcaa3d33-e378-4a0c-a8d9-a92e7f2a3e2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=338ba990b660756eda39d3b724d55aaa 3x"}, "body": "はじめまして！Twitterに投稿されていたイラストが素晴らしかったので依頼をさせていただきました\nリクエストなのですがけものフレンズのテングコウモリちゃんがセルリアンとのバトルで敗北し、その後にえっちな乱暴されているイラストをお願いします。\nシチュエーションとしましては、バトルに負けてボロボロなテングコウモリちゃんが複数の人型セルリアン（単色等で簡略化しても大丈夫です）に背後からチョークスリーパーのような、または首に腕を回されて絞め上げられており、別のモブセルに胸（巨乳）をブラ越しに揉まれたりして下さい\n服装もセーラー服やスカートが破れてパンツが見えていたり、片方からブラとデカ胸が露出していて下さい\n大柄な人型セルリアンに首を絞め上げられて足はバタつかせてる感じで、下駄は片方脱げて裸足になっていて下さい。ブラやパンツの色や形はお任せします\n表情は絞め落とされている感じではなく、「あぐっ…」と苦しそうに涙を流して嫌がっている感じでお願いします。\nングちゃんの身体にはあまり酷くない、あまり出血してない程度に戦闘で敗北した際に付いた傷や怪我をしていて下さい\n雀丸さんのイラストは指先まで丁寧に描かれていましたのでングちゃんの足指や足爪等、足に力を入れていただければ幸いです…！\nもしよければ差分でブラ無しバージョンや「かはっ…！」ってなってる表情差分もお願いします…！\nテングコウモリちゃんの資料です\nhttps://twitter.com/ATK400DEF600/status/1661870168035958784?t=i4f7r3YS5OLEEJs-y8wDtg&s=19\nhttps://twitter.com/ATK400DEF600/status/1770019494867656868?t=ascJsK_VlsUIs2w323ILSQ&s=19\n長文失礼しました。どうぞよろしくお願いします！", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@suzume___maru2/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1528053, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4aa1c132/uploads/origins/a0644963-6877-44a5-b121-4c4f03104163?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aee025089ab2aba37efd2bb1637e0185", "srcset": "https://si.imgix.net/4aa1c132/uploads/origins/a0644963-6877-44a5-b121-4c4f03104163?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aee025089ab2aba37efd2bb1637e0185, https://si.imgix.net/4aa1c132/uploads/origins/a0644963-6877-44a5-b121-4c4f03104163?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1cb89e97edd7275deda454b5cbf94128 2x, https://si.imgix.net/4aa1c132/uploads/origins/a0644963-6877-44a5-b121-4c4f03104163?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=196fea2d6060a514766d527472479810 3x"}, "duration": null,