re": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/387c74e9/uploads/origins/0a0d840a-3caf-485c-a435-ea88c9dda395?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f238f8d4ff0d98a8841acb7eb58d077", "srcset": "https://si.imgix.net/387c74e9/uploads/origins/0a0d840a-3caf-485c-a435-ea88c9dda395?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f238f8d4ff0d98a8841acb7eb58d077, https://si.imgix.net/387c74e9/uploads/origins/0a0d840a-3caf-485c-a435-ea88c9dda395?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b1321c0920d734ceed018a249390dd8f 2x, https://si.imgix.net/387c74e9/uploads/origins/0a0d840a-3caf-485c-a435-ea88c9dda395?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c0c20d96c830f54e0a52cbcb27c3c803 3x"}, "body": "お疲れ様です。\n月葉チリンです！\n\nまだまだ残暑続く９月ということで、まだまだ暑いから水着を着たっていいじゃない！\nということで水着のフォニチリンてぇてぇイラストをお願いしたいと思います。\n今回の資料に（ミスってなければ）新しい水着を貼ってありますのでそちらの衣装でお願いします。\n構図はだいたいおまかせで、くろむさんの癖をもりもりに盛り込んだ感じでくんずほぐれつ（くろむさんの描きたいor描ける範囲で）させていただければなと思います！\nフォニチリンの二人でSNSやYoutubeで使うかもなので、背景透過版もあると助かります。\n\nお忙しい中連続でのリクエストになってしまいますが、ご無理のない範囲でよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/19n5cGs98fbhEUuDP6K8sXLNsSmIpXfie?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amkt_krm/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1271066, "client_id": 2238763, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cdb75ee8/uploads/origins/48811f67-79a9-4b7d-a247-b1b15117197f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29a79e4791d63667a385007536e278df", "srcset": "https://si.imgix.net/cdb75ee8/uploads/origins/48811f67-79a9-4b7d-a247-b1b15117197f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29a79e4791d63667a385007536e278df, https://si.imgix.net/cdb75ee8/uploads/origins/48811f67-79a9-4b7d-a247-b1b15117197f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1dc1a8d2afee33ff3b40b98e4a8c254 2x, https://si.imgix.net/cdb75ee8/uploads/origins/48811f67-79a9-4b7d-a247-b1b15117197f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4918407fcb261fbec028c3d3e1753950 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cdb75ee8/uploads/origins/48811f67-79a9-4b7d-a247-b1b15117197f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75afb1ba8cefc5c59f0057bc34877110", "srcset": "https://si.imgix.net/cdb75ee8/uploads/origins/48811f67-79a9-4b7d-a247-b1b15117197f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75afb1ba8cefc5c59f0057bc34877110, https://si.imgix.net/cdb75ee8/uploads/origins/48811f67-79a9-4b7d-a247-b1b15117197f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=23ab5d299bd24a0d2814bd54bbd9967e 2x, https://si.imgix.net/cdb75ee8/uploads/origins/48811f67-79a9-4b7d-a247-b1b15117197f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1aa5e99f6f527fff91cb43f152f5961a 3x"}, "body": "くろむさん爆誕おめでとうございます！\n銀狐Vtuberおじさんの月葉チリンです。\nてぇてぇコンビユニット【フォニチリン】のてぇてぇイラストをお願いしたいと思います。\nコンビの二人分のお願いになりますので、無理そうでしたらキャンセルしていただいて大丈夫です。\n\nモデルはフォニチリンの月葉チリンとフタツナフォニーの二人です。\n構図的には私が右側で（トレードマークの月が見えるので）\n幸せそうにほっぺたをくっつけあってる感じが嬉しいです。\n恋人っぽさがでていれば大体大丈夫なのでそんな感じでお任せします。\n\n通常衣装と水着衣装の差分が欲しいとは思いますが、無理そうでしたら通常衣装の方だけでも大丈夫です。\n立ち絵やサムネに使うことも考えていますので、背景透過差分もあると助かります。\n\n猛暑が続いておりますので大変だと思いますが、ご無理なさらぬようお気を付けください。\n\nhttps://drive.google.com/drive/folders/19n5cGs98fbhEUuDP6K8sXLNsSmIpXfie?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amkt_krm/works/10", "private_thumbnail_image_urls": null, "private": false