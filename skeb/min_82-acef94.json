core": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2688badd/uploads/origins/476d95b1-7c27-4583-9cfe-8c5af73c6a49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0730e2d6f84bb314bf7f1031368c857c", "srcset": "https://si.imgix.net/2688badd/uploads/origins/476d95b1-7c27-4583-9cfe-8c5af73c6a49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0730e2d6f84bb314bf7f1031368c857c, https://si.imgix.net/2688badd/uploads/origins/476d95b1-7c27-4583-9cfe-8c5af73c6a49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0804b3df2024265a1d33d1f5034d6e63 2x, https://si.imgix.net/2688badd/uploads/origins/476d95b1-7c27-4583-9cfe-8c5af73c6a49?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=202db66f3f3e6125f84adeb8d32962b9 3x"}, "body": "ミナミ様\n\nはじめまして、こんにちは。昔からのミナミ様のファンです！\nもしよろしければ、ごく短い何コマかの漫画を描いていただきたくリクエストさせていただきました。2コマでも全然構いません。\n\n【使用範囲】\n個人での利用です。完成した絵をミナミ様がツイッターなどに載せられた場合、ブルースカイにてアドレスを転記したいです。\n\n【キャラクターについて】\nロマンスグレーのお爺さま、もしくはおじさま\n・痩身\n・すっきりと整えられた銀髪\n・ヒゲなし\n・目の色はヘーゼルと言えばいいのか、だいたい薄緑〜榛色みたいなイメージです\n・眼鏡（老眼鏡なのでなくても大丈夫です）\n・皺のないシャツ、スラックス（イメージなので全身は描かなくて大丈夫です）\n\n【希望内容】\n・こちらを見て微笑んで欲しいです。\n孫に話しかけられて「ん？」と目を細めて返事をするように微笑むでも、メガネを外しながらでも、赤ちゃんをあやすようにでも、親友に笑いかけるようにでも、恋人に笑いかけるようにでも、愛情や情が感じられるようなものであれば何でも構いません。\n・その他は全てお任せします。\n\n資料が無く申し訳ありません。\nよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 359828, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぞの【Skeb受付中🤗】", "screen_name": "eos32peg01362", "avatar_url": "https://pbs.twimg.com/profile_images/621674957752274944/HxPAT88Z.jpg", "header_url": "https://pbs.twimg.com/profile_banners/173149645/1484232555/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_