rop=top&w=200&h=200&blur=200&s=05b82371fa46c8a600cfa5722cf450de 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fwww.gravatar.com%2Favatar%2F%3Fd%3Didenticon?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=43a595144a017cd488624dd0dec2083a 3x"}, "body": "いつもお世話になっています！にゃるきーちゃんです！\nイベント告知用のボイスをお願いします。\n\n\n内容ですが、アニメの次回予告のような感じで落ち着いた語り口調で話していただいて、最後の部分だけエヴァンゲリオンの次回予告の決めセリフのような雰囲気でお願いしたいです。\n\n若干言葉と言葉の間を編集することはあるかもしれませんが、行間の空気を読んで頂きながら、だいたい40秒前後に収まるスピードだと丁度良く思っています。\n\nご検討よろしくお願いいたします。\n\n\n\n\n\nリクエスト文章\n\n\n（つきあかりさんの雰囲気で）\nわたし、やっと大切な事に気がついたんだ、、、\n\n\nイベントに使おうと思っていたワールドが\n消えてしまっているかもしれない事に、、、\n\n\n\nコンセプトは決まっていた、、、\n\n\n手伝ってくれる人も増えて、日程も決めて、、、\n\n\n\n\n\nもう一度、あのワールドに行こうと思ったんだけど、、、どうしても見つからないんだ、、、\n\n\n一体どこに行ってしまったの、、、？\n\n\n\n\nでもやらなきゃ、、、！私がんばる、、、！\n\nきっと待ってくれている人達が居るから、、、\n\n\n\n（ここから元気な感じで）\n次回ワタリノさんアバター集会、テーマは「喫茶店」\n\nさぁイベントに向かってUnity!Unity!\n\n\n絶対来てくれよなっ！\n\n\n\n\n-------------------------------------------------\n最後ちょっとふざけちゃいましたがギャップ萌え楽しみにしています(*´ω`*)♪", "nc": 144, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}, {"path": "/@moonlite_san/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 493477, "client_id": 944744, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/e667313b-ce5e-4685-b71d-048d71fba829?response-content-disposition=inline&Expires=1782413715&Signature=mFUEzPJa6B8TClxUvQ3AEaZ8tNgkZWCxJx9OkZQStooPm7k9jyAnDvxoFe~lpWtkFo9RcZ4gn-pGCjOioqd4sxEkbhT6bodPzILCvU5JK9yot7NVVBtvT2ORDevQBhcahNwqXcJdCymhm3gcTdU683dF7e4kFajI8BeQiZHKAQndnGby0aNcaoZ5KsPcUaEB2-ocHGnyTBYJ-smWwfCtagKV3-GiCiEFaSFVHocp5XLGvWoXidLOCjcOengUe1bvyjIKZ07glJkvyWGGer61K8BnmNfvi5jU~qa2n9DuKutBPe9wWssengXSlqPOUGJ50POCMb7XkEwHFR4MZcS2rw__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fwww.gravatar.com%2Favatar%2F%3Fd%3Didenticon?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5036736e