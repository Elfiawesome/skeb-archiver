x.net/71343d53/uploads/origins/46d2d95a-c49c-4200-bfd7-60fdf587b66d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3553545f30138f8c4d27e653d55efca0, https://si.imgix.net/71343d53/uploads/origins/46d2d95a-c49c-4200-bfd7-60fdf587b66d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e817cdb3a404c6273fb8a5b7cc013d82 2x, https://si.imgix.net/71343d53/uploads/origins/46d2d95a-c49c-4200-bfd7-60fdf587b66d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4c1bb69178f82ceeda8941d2823e8b5a 3x"}, "body": "ぷちのさんこんばんは！\n柚木そるです！\n今回依頼したいのは、ぷちのさん(イラストレーター)の上にぷちのちゃんが座ってるイラスト？\nお膝の上でお目目キラキラで何か食べてるぷちのちゃん？\nウサちゃんをさらにぷちのちゃんが抱えてるもありです！\n\nぷちのさんは片手で頭撫でて、片手にペン？\nぷちのちゃんをぬいぐるみみたいにぎゅってしててもいいです！\n背景等はおまかせで！\nもし可能でしたら、お二人それぞれの差分もよろしければ！\n\nぜひ、ご縁があれば\nよろしくお願いいたします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@putinoria/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3017263, "client_id": 1323448, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/da81166d/uploads/origins/8cc06a88-6b3a-40d2-904a-d5d0154c1706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d0d7fe55f5cf931070ec952c63d31b5", "srcset": "https://si.imgix.net/da81166d/uploads/origins/8cc06a88-6b3a-40d2-904a-d5d0154c1706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d0d7fe55f5cf931070ec952c63d31b5, https://si.imgix.net/da81166d/uploads/origins/8cc06a88-6b3a-40d2-904a-d5d0154c1706?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f44f12f1cc1bf36aa84dc3f78f5bcce1 2x, https://si.imgix.net/da81166d/uploads/origins/8cc06a88-6b3a-40d2-904a-d5d0154c1706?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b08b8c7c53e4d0fb2441f7e464e666b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da81166d/uploads/origins/8cc06a88-6b3a-40d2-904a-d5d0154c1706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52df4699ed9945c3e709be865db108e5", "srcset": "https://si.imgix.net/da81166d/uploads/origins/8cc06a88-6b3a-40d2-904a-d5d0154c1706?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=52df4699ed9945c3e709be865db108e5, https://si.imgix.net/da81166d/uploads/origins/8cc06a88-6b3a-40d2-904a-d5d0154c1706?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=088965c1a602b08486c2dc0700cd9854 2x, https://si.imgix.net/da81166d/uploads/origins/8cc06a88-6b3a-40d2-904a-d5d0154c1706?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=812563a45f9b44582b23fb8a8a295873 3x"}, "body": "ぷちのさんこんばんは！\n今回依頼したいのは御神体ちゃんです！\n御神体ちゃんの特徴 \n・〈好きな事〉食べる事、ダラダラする事、お昼寝、意外と掃除、小物制作、読書ゲーム等室内娯楽全般 、でも何故か気ままなお散歩に出かけることもある\n\n・〈苦手な事〉知人未満の人との会話、感情を伝える事、日頃の整理整頓 \n\n・〈好きな物〉スタバのフラペチーノ、ふかふかのクッション \n\n・〈苦手な物〉熱い物(猫舌)、直射日光 \n\n【特徴】\n 感情が余り表に出てこない不思議ちゃん 、親しい人には笑顔になったりする 結構面倒くさがり、外に出る事も面倒くさがる、でもスタバを奢ってあげると言うと目をキラキラさせて付いてくる。 平均以上親しくなると めんどくさいと言いながらもたまに料理を作ってくれたり世話をやいてくれる。そして無言で褒め讃えよアピールをしてくる\n\n〜背景ストーリー〜\n御神体として崇められた怪物が外で生活したいと願った末の擬態した姿(本体は目玉の方)\n外の世界に興味津々ではあるが、あまり周りの人と関わりたくはない\n衣装をチェンジしても必ず赤い球と目玉の何かはどこかに付いている(ブレスレットとかにもなったりする)\n性別は無いが、姿は女の子\n1番擬態してると楽な体型らしい\n\n衣装デザインの条件\n・必ず衣装のどこかに👁のような模様がある(御神体の擬人化なので)\n・赤い丸🔴のような装飾がどこかにある(多くなくてもよい！)(元になったスタバのスイーツに沢山カエルの卵みたいなのが付いていたため)\n\n髪型や、髪の長さなども自由でも大丈夫です！！\n自由に描いてください！\n参考資料\n\nhttps://x.com/FA_YUZUKI/status/1668917856594173952?t=tVegCHIXep5ZwNJZcz8FaA&s=19", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@putinoria/works/2", "private_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1837794729339375618%2FX_Ao6GXD.jpg?bg=%23fff&auto=format%2Ccompress&fm=web