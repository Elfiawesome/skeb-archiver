集中が復帰してるのを見て、いても経ってられず送ってしまいました。\n前回のイラストが好きすぎて盛っています。気負わず描いていただければ幸いです。\n\n資料urlは春とありますが、イメージは春か冬でお願いします。\n\n★★★★★詳細★★★★★\n\n書いていただきたいキャラクターの詳細が\n・青肌・黄緑目の十時が入ったしいたけアイ\n・青と黄緑色がイメージカラー\n・身長と胸は大きくない\n・首筋裏で結った侍おさげ\n上記が満たされれば基本的には満足です。\n\n・服装と細やかな要望等は参考urlにありますが上記が満たされていれば無視で構いません。\n・髪にメッシュを入れたいなと思った場合は前髪か横髪か一部分だけでお願いいたします。髪の反射光で色がつくのは好きです。\n\n参考urlにはありませんが追加の選択肢として\n・でかい分厚い重装甲のようなダッフルコートに中は薄着のTシャツ（働いたら負けくらいのラフなシャツ）で「私はどこにでもいますし、どれも本物なんですよ」とプリントして欲しい\n・下半身は細く見えるように締め上げる感じのハイソックス、と短パンか膝上半ズボン\nで構図はお任せします。\n\n\n★納品していただきたいもの\n1枚絵\n差し支えなければラフ画も好きなのでいただけると幸いです。\n\n以上が依頼内容となります。\nここまでお時間頂きありがとうございます。\n楽しみにしています、よろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1ujdxiWRrEVWT9visdMEM6pgnL-9-6Cuf/view?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@migiashi_itai/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 723402, "client_id": 1039623, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ad7e5b8/requests/273828_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d2648cdc0f5181c748ebff9303b58c3", "srcset": "https://si.imgix.net/6ad7e5b8/requests/273828_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1d2648cdc0f5181c748ebff9303b58c3, https://si.imgix.net/6ad7e5b8/requests/273828_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ef1e178e346f7f58899f58e6cef7c3a 2x, https://si.imgix.net/6ad7e5b8/requests/273828_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd74cd253c2e061b76e4b2fd2aeab3fe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ad7e5b8/requests/273828_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d69c73307962613aed9da6e5aa3821ed", "srcset": "https://si.imgix.net/6ad7e5b8/requests/273828_0?bg=%23fff