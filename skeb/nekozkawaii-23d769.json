4-3383-4dc4-b054-638a7f337b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36db539e082e152d265cc1ba72b6c367", "srcset": "https://si.imgix.net/6e744378/uploads/origins/1fe68794-3383-4dc4-b054-638a7f337b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36db539e082e152d265cc1ba72b6c367, https://si.imgix.net/6e744378/uploads/origins/1fe68794-3383-4dc4-b054-638a7f337b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76d8b5cbdbb6e5829ef05e78965eb333 2x, https://si.imgix.net/6e744378/uploads/origins/1fe68794-3383-4dc4-b054-638a7f337b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a17f8b0626156c927a44274b919a66c5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e744378/uploads/origins/1fe68794-3383-4dc4-b054-638a7f337b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f53d972557735d621866e13225785b31", "srcset": "https://si.imgix.net/6e744378/uploads/origins/1fe68794-3383-4dc4-b054-638a7f337b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f53d972557735d621866e13225785b31, https://si.imgix.net/6e744378/uploads/origins/1fe68794-3383-4dc4-b054-638a7f337b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e5379bc13e0d2cd1e875b52acc7b1a89 2x, https://si.imgix.net/6e744378/uploads/origins/1fe68794-3383-4dc4-b054-638a7f337b1f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b242c12450d2ea173324c7001ea77927 3x"}, "body": "初めまして！新人VTuberの雨喵Yumeowと申します。\n猫耳娘少女の水系魔法使いです\nイラストがとても綺麗で、一目惚れしたため、依頼させていただきたくご連絡いたしました。\n私が猫が大好きなので、私と猫が一緒に遊んでいるシーンを描きたいと思います。（オレンジの猫と、目の色が私と同じ白い猫、そしてシャム猫の3匹が希望です。）\n\n\n【納品形式】  \n携帯の壁紙として使いたいので、9：16（縦長）のサイズでお願いします。\nPSD形式で、背景とキャラクターはレイヤー分けをお願い致します\n\n何卒お願いいたします。使用用途は、SNSへの投稿、また活動における配信や動画にて使用させていただく予定です。\n\nhttps://drive.google.com/drive/folders/10GzEeaOdgjLiu61uT0nkhH76aNCl6M7r", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nekozkawaii/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3092601, "client_id": 1484741, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9352fe80/uploads/origins/70a8d983-8803-4cf2-bb3f-831ea51e00f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1d135a7a789c00781ced5d6f2d50c48", "srcset": "https://si.imgix.net/9352fe80/uploads/origins/70a8d983-8803-4cf2-bb3f-831ea51e00f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1d135a7a789c00781ced5d6f2d50c48, https://si.imgix.net/9352fe80/uploads/origins/70a8d983-8803-4cf2-bb3f-831ea51e00f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=82d8c0f1b1c10c595eecd5736262c43b 2x, https://si.imgix.net/9352fe80/uploads/origins/70a8d983-8803-4cf2-bb3f-831ea51e00f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=252c38a389158d8bae7e405b6f2f7855 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9352fe80/uploads/origins/70a8d983-8803-4cf2-bb3f-831ea51e00f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3083dc4495f3a1a87f3e55574b5b9b14", "srcset": "https://si.imgix.net/9352fe80/uploads/origins/70a8d983-8803-4cf2-bb3f-831ea51e00f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3083dc4495f3a1a87f3e55574b5b9b14, https://si.imgix.net/9352fe80/uploads/origins/70a8d983-8803-4cf2-bb3f-831ea51e00f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a7c241505dc566a9e2978852ac16532a 2x, https://si.imgix.net/9352fe80/uploads/origins/70a8d983-8803-4cf2-bb3f-831ea51e00f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&