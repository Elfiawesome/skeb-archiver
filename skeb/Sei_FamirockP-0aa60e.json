ラは人間が深海で発見した古代生物です。本体は石油のようなコロイド物質で、人体に侵入して体の活動を制御することができる。人間の脳を持ってから自分自身の研究を始めた。研究者であると同時に、研究された実験品でもある。\n物語では悪役を務めるが、彼も彼の物語の主人公。\n\nちょっと不気味な雰囲気かもしれない、でも全体的に寂しさを感じさせる曲をよろしくお願いします。\nもちろん、キャラクターにインスピレーションを得ての場合、自由に作曲も構いません。", "nc": 1, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}, {"path": "/@Sei_FamirockP/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": true, "creator_id": 505995, "client_id": 1774207, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1319823934506758145%2F8BWCWjBo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=490afe2a02bee642496b7ff529e871c7", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1319823934506758145%2F8BWCWjBo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=490afe2a02bee642496b7ff529e871c7, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1319823934506758145%2F8BWCWjBo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c34cdf4621a791f87a8e8058a80c90ad 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1319823934506758145%2F8BWCWjBo.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9a586b02d4afdb4a3d380320efe4533 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/a138e195-9013-45c9-ab5b-3f866b917e9f?response-content-disposition=inline&Expires=1781863983&Signature=X5gZvxeCFKm5OdjFpqJegJoLilTqjH4otD7XWXZ0J2JQC2YzGAkGSBQOFweXFS4QRcUbzpxnvK1H5OTAAhu8d4G2P2EYNaf33D9IlKl3fTue7iDcfoortCzA6FOeKmZ0eE~EqthmmTkj9aJn~lYorAHIWj81QoD7z2x4I56xfxmi9IopA7c5i96yN~J2bzPaFSugDQARIdw6j7jGtRIFW1uLs7CYIbjxsnBy~MKKMUk~F707-XUyPfQ~QYzkLRkghVQb40xV~710ijIguobnghsXM8LiPGEW2rhPvOgNzRwhoEMSq4mkSa5C-OzaJL6GSwRCYO5~JKVatYWVtxmxbQ__&Key-Pair-Id=K1GS3H53SEO647", "duration": 130, "nsfw": fal