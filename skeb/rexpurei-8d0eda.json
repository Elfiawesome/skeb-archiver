2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d3475c9be4d12acf25b1cd418f06a993, https://si.imgix.net/9c025e07/uploads/origins/ea2755e1-6faa-48a9-8378-160b00fbc29a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1e605dad716290768da6d505658eface 2x, https://si.imgix.net/9c025e07/uploads/origins/ea2755e1-6faa-48a9-8378-160b00fbc29a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3246edc20d3c5aa1ce266a87000f645f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c025e07/uploads/origins/ea2755e1-6faa-48a9-8378-160b00fbc29a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a18e7eb5eb391caeecf8bbfd8c45c3a", "srcset": "https://si.imgix.net/9c025e07/uploads/origins/ea2755e1-6faa-48a9-8378-160b00fbc29a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a18e7eb5eb391caeecf8bbfd8c45c3a, https://si.imgix.net/9c025e07/uploads/origins/ea2755e1-6faa-48a9-8378-160b00fbc29a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5fd91186a35465f2853182808ecf69a8 2x, https://si.imgix.net/9c025e07/uploads/origins/ea2755e1-6faa-48a9-8378-160b00fbc29a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0ce4c0fdb9663a2e0f70b24800d5cca2 3x"}, "body": "初めまして。\n艶やかで美しく、均整の取れた裸体と素敵なバストの納品絵に一目惚れしてリクエストいたします。\nただ、ニッチな内容ですので、お気に召さなければ遠慮なくお断り下さい。\n\n『ドラゴンクエストⅢ』に登場する女戦士を描いて頂けますでしょうか。\n私のパーティーキャラとしての独自設定になります。\n\n資料URLと以下URLのビキニアーマーや装備をベースに、アレンジを加えて下さい。\nhttp://animeru.net/wp-content/uploads/f0f7888506aed16dd4b531db62b39a8d.jpg\n\n外見は『COBRA』に登場するドミニク・ロイヤルのような20代前半くらいのグラマラスな美女で、\nベースの女戦士の青い髪から金髪へ、\n特徴的な前髪とシャギーとして頂き、後ろ髪の撥ねはベースの女戦士より控えめにお願い致します。\nhttps://cdn-ak.f.st-hatena.com/images/fotolife/k/kemoxxxxx/20160816/20160816202001.jpg\n\n精霊ルビスを信仰しており、盾にルビスを模したレリーフを入れて頂けますと幸いです。\nただ、予算的に見合わなければ要りません。\nhttps://dq-walk.news/wp-content/uploads/2020/04/68c7ff34fabdc099c4554b824f61f08a.jpg\nhttps://resize.blogsys.jp/f1c84b0bc04508f533075a0472e8afeb42a651bb/crop1/220x220/http://livedoor.blogimg.jp/toram7miyu/imgs/a/8/a8ccea93-s.jpg\n\nバラモスの呪いで玉有フタナリにされています。\n後天性ペニスのため洗い方を知らず、元々おしゃれに無頓着だったこともあり、\n悪臭が匂い立つような黄色く濁った恥垢でびっしりと覆われたペニスが前垂れの上側からはみ出るほど大きく、前垂れの下からも押し上げていてクッキリとモッコリしています。\n本人は悪臭は多少気にしていますが、どうしようもない感じです。\n\n教会では呪いが解けず、バラモスを倒して呪いを解くために勇者に同行しています。\n\n以上となりますが、ご検討よろしくお願いいたします。\n\nhttp://animeru.net/wp-content/uploads/589aec0a31719752ba19c805f8ff8716.jpg", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rexpurei/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 342355, "client_id": 175182, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b44e35a7/uploads/origins/feb45206-7eaf-4c20-892b-30354dcaa6fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba9d882206710d42f95ea59b3be7dc17", "srcset": "https://si.imgix.net/b44e35a7/uploads/origins/feb45206-7eaf-4c20-892b-30354dcaa6fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba9d882206710d42f95ea59b3be7dc17, https://si.imgix.net/b44e35a7/uploads/origins/feb45206-7eaf-4c20-892b-30354dcaa6fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b6ed61ff4d4ce371dc7617b8ab39a0bf 2x, https://si.imgix.net/b44e35a7/uploads/origins/feb45206-7eaf-4c20-892b-30354dcaa6fa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=42870c0e74b9f4b7b710dcdf1dea7cca 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b44e35a7/uploads/origins/feb45206-7eaf-4c20-892b-30354dcaa6fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f22b851fb2fd2a2d5e060b7a0003277", "srcset": "https://si.imgix.net/b44e35a7/uploads/origins/feb45206-7eaf-4c20-892b-30354dcaa6fa?b