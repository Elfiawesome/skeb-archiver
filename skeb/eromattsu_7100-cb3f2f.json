0e215da8ad380b39c2d 2x, https://si.imgix.net/7dc6a125/uploads/origins/bfd3b0e2-20e7-40a2-835b-80c535ea4d1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f27651d8a0585d1e980c504510b650bf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7dc6a125/uploads/origins/bfd3b0e2-20e7-40a2-835b-80c535ea4d1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8fb5e1a0c84eacd513797049ac3f657b", "srcset": "https://si.imgix.net/7dc6a125/uploads/origins/bfd3b0e2-20e7-40a2-835b-80c535ea4d1d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8fb5e1a0c84eacd513797049ac3f657b, https://si.imgix.net/7dc6a125/uploads/origins/bfd3b0e2-20e7-40a2-835b-80c535ea4d1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8c54ef0e2c822a14e1d3f73e2d950d33 2x, https://si.imgix.net/7dc6a125/uploads/origins/bfd3b0e2-20e7-40a2-835b-80c535ea4d1d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=48ffeced0d0bb8740d885c2418d42744 3x"}, "body": "巨大な馬チ○ポ型のディルドスクワットでアへ顔アクメをキメる遊戯王OCGの《RAI-MEI》と《ワルキューレ・フィアット》、《ワルキューレ・ツヴァイト》の三人をリクエストします。\n\nキャラの造形は\n・全員頭身高めのむちむち、股間の少し上に届き下半身が普通に見えるくらいの超乳\n・服装はカードと同じ物(RAI-MEIの全身の装飾はシンメトリーでお願いします)で乳首と乳輪は大きめかつ勃起してパフィーニップル状態の物が布地越しにくっきりと浮き出ている。\n・髪型はRAI-MEIが腰まで届く長さ途中で稲妻型の折れ曲がりがあり、太さのあるツインテール。フィアットも資料だと分かりづらいですがシンメトリーのツインテールです。\n・性格のイメージはそれぞれお好きなようにお願いします。\n\n三人が横並びしている姿(中央はRAI-MEI固定)を頭から太ももまで写し、以下のようなストーリーで台詞付きの差分を用意して欲しいです。\n\n挿入前。淫語混じりの嘘喘ぎや扇情的な表情など、いかにも余裕のある態度でこちらを挑発しながら、二人でマスターに自分達の痴態を見てもらうよう声を掛ける。また三人それぞれの斜め手前に馬ぺニス型の巨大なディルドが置かれている。\n↓\n挿入時。全員立ったままの姿勢からスクワットの要領でディルドを挿入し、その衝撃で間抜けな叫び声を上げ即堕ちアへ顔アクメを晒す。\n↓\n挿入後。激しく腰を振りながらディルドのピストンにより軽めのアへ顔でオホ声混じりの淫語を連発しよがっている。\n↓\n同時絶頂。ディルドが根本まで完全に挿入され汚い口調で淫語を絶叫しながらイき、思い切り白目を剥いたここ一番の変顔に片足突っ込んだアへ顔になる。\n\nよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1JTPfY698ve9fO6-JxjxkgncH_mtg6dvP", "nc": 56, "word_count": 0,