子達(フックのモグラ党や他)はふたなりで本物のがあるのにナターシャは無い…。そんな魔女ばあ事ナターシャにペニバンを装着させフック達は攻略する\n\n\nモブの女の子は1以上居れば何人居ても構いません。ナターシャやフック、モブキャラ達のセリフorモノローグはお任せします\n\n射精や絶頂、全体の流れ等色々差分を！\n\n\n完全敗北イヴリン♡の作品をpixivで拝見し興味を惹かれて参考にしました。改めて検討よろしくお願いします", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@eromattsu_7100/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3501178, "client_id": 1197892, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d67cdaf/uploads/origins/8a5bafa1-2915-4228-a4cd-76cf183c1cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a94ba774c5096797f3363796af97bebd", "srcset": "https://si.imgix.net/4d67cdaf/uploads/origins/8a5bafa1-2915-4228-a4cd-76cf183c1cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a94ba774c5096797f3363796af97bebd, https://si.imgix.net/4d67cdaf/uploads/origins/8a5bafa1-2915-4228-a4cd-76cf183c1cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d46b38678a2a403529c3b69e77840c52 2x, https://si.imgix.net/4d67cdaf/uploads/origins/8a5bafa1-2915-4228-a4cd-76cf183c1cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=16eea6558b19ccd1ddb9718b28e7432d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d67cdaf/uploads/origins/8a5bafa1-2915-4228-a4cd-76cf183c1cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74454619b72cbb8c25434c5f19da1566", "srcset": "https://si.imgix.net/4d67cdaf/uploads/origins/8a5bafa1-2915-4228-a4cd-76cf183c1cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74454619b72cbb8c25434c5f19da1566, https://si.imgix.net/4d67cdaf/uploads/origins/8a5bafa1-2915-4228-a4cd-76cf183c1cfd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab6e49