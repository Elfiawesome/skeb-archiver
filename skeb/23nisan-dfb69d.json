 アリアは怒りながら顔を赤らめ、激しく嫉妬しています。\n\nバリエーションとして、その後アリアが姉に負けじとグランに強引にキスし、婚約者に自分が誰のものか思い知らせるシーンをお願いします。フォリアは面白そうに、満足げな表情をしています。\n\n参考画像\nhttps://catbox.moe/c/9rbthn\n\nその他の詳細は、ご自由にお任せします。\nご検討いただきありがとうございます。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@23nisan/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3961643, "client_id": 2231946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bdbfdde4/uploads/origins/3b143617-84a8-49de-82a3-fc88621931c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eda91aa8377a2c00afe89aebe84d4d00", "srcset": "https://si.imgix.net/bdbfdde4/uploads/origins/3b143617-84a8-49de-82a3-fc88621931c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eda91aa8377a2c00afe89aebe84d4d00, https://si.imgix.net/bdbfdde4/uploads/origins/3b143617-84a8-49de-82a3-fc88621931c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=caa313772fa3551fbe78fa884366ba83 2x, https://si.imgix.net/bdbfdde4/uploads/origins/3b143617-84a8-49de-82a3-fc88621931c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=941ed30d85fbfab15346325011fd9395 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bdbfdde4/uploads/origins/3b143617-84a8-49de-82a3-fc88621931c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55e08afd73f4e2d2c59d8fce0a106f49", "srcset": "https://si.imgix.net/bdbfdde4/uploads/origins/3b143617-84a8-49de-82a3-fc88621931c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=55e08afd73f4e2d2c59d8fce0a106f49, https://si.imgix.net/bdbfdde4/uploads/origins/3b143617-84a8-49de-82a3-fc88621931c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f2f0fadd89568db53c4bc098c4a