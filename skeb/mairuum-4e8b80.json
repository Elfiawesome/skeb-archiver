ういう態度なら次からもうしてあげないんだからねっ。\nもう知らない。\n…きゃっ。なに急に？そんなに強く抱きしめたら苦しいよ。\nありがと、って？ふふ。\nわかればよろしい。\nちょっとは元気出た？\nうん、なら良かった。\nちょっと頼りないかもしれないけど、しんどくなった時は、ちゃんと頼ってね？\nうん、約束。\nね、じゃあもう1回、ぎゅってしよ？", "nc": 0, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}, {"path": "/@mairuum/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 135487, "client_id": 142528, "vtt_url": "https://fcdn.skeb.jp/uploads/21908/0/vtt/0.vtt?response-content-disposition=inline&Expires=1781177234&Signature=OxMXLIMl1pWCXE6lxbbRe7oKFJ6e5oZgR-ViC~CJDJbb7nJ2UbyJjlimDmF227zgd0PWABKiqcOR-LeSvsK0H923wwjSCkzMMHdQK~kIt6A1pcDRxv1SFJHSQbRxZK~7mvE12eTSHjQofL9by5JHZBHUJDBrWkqaHZBetCTYdkEHGl4Ae~3xZQZBxcoM3gm1XDm1P-0L2Vhffv5FkkFVjJv83pwdljxeda~mSv2MoklittXv~K6Rlol11UX~VTHDOIdCIoWrfaVU-QsFZKpK88yznYYBCYDB6GfQfetJkMoJftXF5Bar7oIRuBI23NUebvRC8FzJyiAmN~ku4eNlGw__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1750753448759525376%2F7jDI_Wyb.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6277b00f835c4e9afbe7d9cc50321722", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1750753448759525376%2F7jDI_Wyb.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6277b00f835c4e9afbe7d9cc50321722, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1750753448759525376%2F7jDI_Wyb.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ac2f0a19b83dd9c0c9a609a3e6c5da2 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1750753448759525376%2F7jDI_Wyb.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=723982a380ca393020f029a1ff1d8cf0 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/21908/0/mp3_128k/0?response-content-disposition=inline&Expires=1781177234&Signature