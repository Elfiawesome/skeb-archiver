ff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=818e5d96d0e68c6fec037287f0cbcb2b", "srcset": "https://si.imgix.net/eea84821/uploads/origins/1b50f5e2-8dcc-4a3d-a635-83540a7b4807?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=818e5d96d0e68c6fec037287f0cbcb2b, https://si.imgix.net/eea84821/uploads/origins/1b50f5e2-8dcc-4a3d-a635-83540a7b4807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4709ff958cb0501991c7d5269df6e546 2x, https://si.imgix.net/eea84821/uploads/origins/1b50f5e2-8dcc-4a3d-a635-83540a7b4807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=efadc80b84359b962d2311e0d6e12d82 3x"}, "body": "こんにちは！あなたの画風がすごくクールだと思いました！私はVTuberで、キャラクターは「トッキ」です。\n\nもし描いてくださるなら、トッキはいつも疲れている、働きすぎのウサギのサラリーマンです。仕事が終わった後は、ゲームをしたり、お酒を飲んだり、タバコを吸ったりするのが好きです。間違えるとすぐに動揺してしまいますが、正解するととても得意げになります。\n\n得意げなポーズや恥ずかしそうなポーズがおすすめですが、必須ではありません！もし可能であれば、参考画像のように、尖った牙、顔のほくろ、四角い瞳を再現していただけると最高です！ほくろは顔の右側にあります（頬に1つ、目の近くの上の方に1つ）。\n\nSNS（投稿やアイコン）で使用させていただきます。\n\n改めて、本当にありがとうございます！\n\nhttps://drive.google.com/drive/folders/195GpF9zVhkLdon-Pqu29Y4lRdK7gtlEH?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nemui_kuuhuku0/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3750005, "client_id": 2231946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fde2522d/uploads/origins/f71f2eaa-9532-481c-955d-a8b0181596c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04079572c7dacfe6e6c8bc934cbb232f", "srcset": "https://si.imgix.net/fde2522d/uploads/origins/f71f2eaa-9532-481c-955d-a8b0181596c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04079572c7dacfe6e6c8bc934cbb232f, https://si.imgix.net/fde2522d/uploads/origins/f71f2eaa-9532-481c-955d-a8b0181596c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8cc6e47636122013c26f1c9b3160e608 2x, https://si.imgix.net/fde2522d/uploads/origins/f71f2eaa-9532-481c-955d-a8b0181596c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c73812940ef74da712936bb07460d69f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fde2522d/uploads/origins/f71f2eaa-9532-481c-955d-a8b0181596c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8a3d213a494942e6e19199207347464", "srcset": "https://si.imgix.net/fde2522d/uploads/origins/f71f2eaa-9532-481c-955d-a8b0181596c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8a3d213a494942e6e19199207347464, https://si.imgix.net/fde2522d/uploads/origins/f71f2eaa-9532-481c-955d-a8b0181596c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=732f65e70909c7113fcabcf258340ee4 2x, https://si.imgix.net/fde2522d/uploads/origins/f71f2eaa-9532-481c-955d-a8b0181596c9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fb43e9f83277c2688e6914bf9afcfcf0 3x"}, "body": "はじめまして、新着クリエイター一覧から過去作品に惹かれてきました\nもしよろしければリクエストを受けていただけないでしょうか\nサービス終了したネットゲームのマイキャラクターがモデルのうちの子になります\n\n・希望する内容を箇条書きで\nお淑やかで大人しめな性格の子です\n「依頼衣装（ドレスまたは夏服）」というファイルの衣装を着せてあげてください\n（もしくは「その他衣装」から飛べるフォルダの中にお好みの衣装があれば、そちらを着せてあげてください）\nゲーム内モデルでは胸が大きいですが、控えめにアレンジをお願いします（Bカップ程度～つるぺたまでお好みで）\n耳と尻尾は付けてあげてください\n表情・仕草・ポーズについてはお任せします\n見た目からのイメージで描いていただければと思います\n\nご検討をお願いします\n\nhttps://drive.google.com/drive/u/0/folders/1gXZVDfcsl66QZ8VxPLKFXERqQXKioNsJ", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nemui_kuuhuku0/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3750005, "client_id": 3574130, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/