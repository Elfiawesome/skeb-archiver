60-df12c567b68b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f75981a6637ceb34aaca7a19eb9e7ae8, https://si.imgix.net/11c53597/uploads/origins/1d1868de-d5a8-488d-9b60-df12c567b68b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b5c913a9c1daee46ee4ede2db92877f4 2x, https://si.imgix.net/11c53597/uploads/origins/1d1868de-d5a8-488d-9b60-df12c567b68b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=69b4eff1749bc93e33236e91c2bcb7d1 3x"}, "body": "こんばんは。今回は宇宙とSFを主題にイラストをお願いします！\n2つの要素をキャラクターと背景で分けてもらっても構いませんし、両方融合してもらっても大丈夫です。\nPCの壁紙にしたいのでアス比は横長でお願いします。タイトルは「cutting-edge」です。\n\n最近、SF小説「一億年のテレスコープ」やビジュアルノベル「ステラーコード」を読みました。\n参考になるかわかりませんが、資料の1つとして見てもらえればと思います。\n\nいつもどおりゆっくりで大丈夫です。よろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@4ugaii/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 124539, "client_id": 779969, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c285982e/uploads/origins/c177410c-23d6-4141-8374-76b91d5f06db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=185331099eb66e6905a57d4530b30983", "srcset": "https://si.imgix.net/c285982e/uploads/origins/c177410c-23d6-4141-8374-76b91d5f06db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=185331099eb66e6905a57d4530b30983, https://si.imgix.net/c285982e/uploads/origins/c177410c-23d6-4141-8374-76b91d5f06db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1ce3616ba73d16708dc4b80a85f0e046 2x, https://si.imgix.net/c285982e/uploads/origins/c177410c-23d6-4141-8374-76b91d5f06db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=34092adac46f681fc1b7d62774ee8d05 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c285982e/uploads/origins/c177410c-23d6-4141-8374-76b91d5f06db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e02de636a613ca574df6d3cd270af0f7", "srcset": "https://si.imgix.net/c285982e/uploads/origins/c177410c-23d6-4141-8374-76b91d5f06db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e02de636a613ca574df6d3cd270af0f7, https://si.imgix.net/c285982e/uploads/origins/c177410c-23d6-4141-8374-76b91d5f06db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cdaaf4e5a613067839b90fadfe4e87c5 2x, https://si.imgix.net/c285982e/uploads/origins/c177410c-23d6-4141-8374-76b91d5f06db?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b324e3b6641bd45730f5953703af6307 3x"}, "body": "SUGAI先生\n再送要請ありがとうございます…！\n条件を変更しました。\nまた、いくつかサンプル画像を追加しました。\n一部だけ依頼を追記させてください\n※耳介が少し出ていますがゲームの仕様です。普通の耳介でお願いします。\nワンピーススカートの色を希望させてくださいメインカラーは黒、差し色で暗めの紫色を入れてほしいです\n紫の瞳がトレードマークなため瞳の存在感をつけてほしいです(余談ですが紫色が大好きです)\nよろしくお願いいたします。\n\n以下依頼文\nはじめまして、先生の描かれる色使い、キャラクター雰囲気、表情、光源…がすごく癖に刺さりまして…\n特に投稿名「butterfly」に惚れ、依頼させていただきました。\n(透け版のほうのぽわっとした光源使いがすごく好きです…)\nもしよろしければ、ゲーム内OCのイラストを描いていただけないでしょうか？\n\n用途\n額に入れて自室に飾らせていただきたいと考えています。\n※商用利用はしません\n\nサンプルの画像をURL先にまとめています。\n\nキャラクターの特徴を書かせていただきます。\n※参考画像を資料URLに載せています。お手数ですが、ご確認いただけますと幸いです。\n\n名前　ベーフェデル\n切れ長の眼、紫色の瞳、灰色の髪、陶磁器のような肌、犬歯が出ている、少し尖った耳\n黒いマニキュア、目の下側にある赤のアイライン、羽のイヤリングをつけているといった特徴のキャラです\n※頭頂のアホ毛は描かないようにお願いします。アホ毛は無視で大丈夫です。\n※何かの参考になれば…\n直接関係ないですが、本キャラのイメージは毒蛇と友人からよく言われてます\n性格等 冷徹、掴みどころがない、謎めいてる、哲学・心理学好き、ポーカーフェイス\n\n表情\n犬歯が見える感じでニヤッと悪い感じの表情をさせてほしいです\n(もし可能でしたら…「グエーｗ」のようなベロ出し差分をいただけないでしょうか…\n厚かましく申し訳ありません…)\n\n服装\n「butterfly」のようなワンピーススカート系…？でお願いします。\n細かいデザインは先生のセンスにお任せとさせていただけないでしょうか？\n(あまり良いデザインを思いつけないため…)\n可能でしたら透け要素をいただけると嬉しいです…\n\n上記のキャラ特徴に記載していないアクセ等\nこちらももし可能でしたらアメジストのアクセサリーを描いてほしく…\n主張しすぎない大きさの三角系、正方形系、長方形系、どれかのカットをした宝石がついている\nブローチまたは指輪を描いてほしいです。描きやすいもので大丈夫です。\n※宝石の反射等、作画コストが非常に高いかと思いますので無理でしたら\n　添付画像のようなドックタグ2枚組を描いてほしいです。\n　名前などはそれっぽく描いて頂ければ大丈夫です。\n\n構図\n「butterfly」のような1枚絵をお願いしたく…\nポーズ等についても先生のセンスにお任せとさせていただきたいです…\n(あまり良いポーズを思いつかないため…)\n\n光源\n「butterfly」透け版のようにぽわっと照明で照らされてる感じにお願いします。\n\nお忙しいところ申し訳ありません…受諾いただけると大変うれしいです。\nお手すきの際の制作…後回しでも問題ありません…！\n何卒よろしくお願いいたします…！\n\nhttps://drive.google.com/drive/u/0/folders/1Jv9teTw2UwNlF57t10d3l0QIbEWEt-R3", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@4ugaii/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 124539, "client_id": 1484223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0deb9c2d/uploads/origins/8e7111a2-6332-4268-86cc-fe715620accb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04a2ea9195cb72af90647518417011ba", "srcset": "https://si.imgix.net/0deb9c2d/uploads/origins/8e7111a2-6332-4268-86cc-fe715620accb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04a2ea9195cb72af90647518417011ba, https://si.imgix.net/0deb9c2d/uploads/origins/8e7111a2-6332-4268-86cc-fe715620accb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=687b7996bd5102f3bd65ee6ab114ea0e 2x, https://si.imgix.net/0deb9c2d/uploads/origins/8e7111a2-6332-4268-86cc-fe715620accb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b9e48b9e44a6ee2b47b922807c98a95 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0deb9c2d/uploads/origins/8e7111a2-6332-4268-86cc-fe715620accb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6dcab105ed0413959a5bfef5eb024b2b", "srcset": "https://si.imgix.net/0deb9c2d/uploads/origins/8e7111a2-6332-4268-86cc-fe715620accb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6dcab105ed0413959a5bfef5eb024b2b, https://si.imgix.net/0deb9c2d/uploads/origins/8e7111a2-6332-4