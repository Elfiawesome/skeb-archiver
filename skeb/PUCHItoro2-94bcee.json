\n・構図やポーズ等はお任せ致したいです。\n・居酒屋で唐揚げや枝豆など定番メニューを沢山注文して美味しそうにビールを飲んでる(飲んでる最中でなくてもOKです。)\n・居酒屋定番メニューの中にちくわを一本描いていただきたいです。\n・お手数になってしまうのですが人物のみの透過ファイルをいただきたいです。\n\nお忙しい事と思いますが、ご検討していただけると幸いです。\n\nhttps://lit.link/natsumemei88", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@PUCHItoro2/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1678505, "client_id": 2507019, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1bd1a2cb/uploads/origins/258b02f3-e69d-4346-9f53-c889ad28ab97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f62dca1d97568ef97795b657de6bb442", "srcset": "https://si.imgix.net/1bd1a2cb/uploads/origins/258b02f3-e69d-4346-9f53-c889ad28ab97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f62dca1d97568ef97795b657de6bb442, https://si.imgix.net/1bd1a2cb/uploads/origins/258b02f3-e69d-4346-9f53-c889ad28ab97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68d371332be04be43b3dcd0ad1fd99e8 2x, https://si.imgix.net/1bd1a2cb/uploads/origins/258b02f3-e69d-4346-9f53-c889ad28ab97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c42669b0c1e247a2c134019b68a4b7e9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1bd1a2cb/uploads/origins/258b02f3-e69d-4346-9f53-c889ad28ab97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1842dd8d29ae99f325ea61b6a64d869b", "srcset": "https://si.imgix.net/1bd1a2cb/uploads/origins/258b02f3-e69d-4346-9f53-c889ad28ab97?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1842dd8d29ae99f325ea61b6a64d869b, https://si.imgix.net/1bd1a2cb/uploads/origins/258b02f3-e69d-4346-9f53-c889ad28ab97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8852c