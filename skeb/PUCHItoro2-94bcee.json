format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6065392adb4dfe0e0e69593fb84a41ae, https://si.imgix.net/9daeb985/uploads/origins/ee872583-5d75-472d-b3b5-209d2bc52eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ff00c9228c3f97f11dbaedfdf71e139a 2x, https://si.imgix.net/9daeb985/uploads/origins/ee872583-5d75-472d-b3b5-209d2bc52eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0bec2dc8103c6393f30ba2da2e121904 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9daeb985/uploads/origins/ee872583-5d75-472d-b3b5-209d2bc52eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05f221cf369bf64469de99039658c278", "srcset": "https://si.imgix.net/9daeb985/uploads/origins/ee872583-5d75-472d-b3b5-209d2bc52eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=05f221cf369bf64469de99039658c278, https://si.imgix.net/9daeb985/uploads/origins/ee872583-5d75-472d-b3b5-209d2bc52eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6152e7fca30eb986c825a7d2e70a2d4e 2x, https://si.imgix.net/9daeb985/uploads/origins/ee872583-5d75-472d-b3b5-209d2bc52eaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cf16f5db051163be9eb257259f0fade2 3x"}, "body": "ぷちトロ様\n\nはじめまして、こんにちは！\n\n準備中の新人VTuberの七夜月（ななよづき）と申します。\n\nぷちトロ様の絵をたまたま目に入って、絵のスタイルがとてもお気に入りですので、もし可能でしたら是非私のキャラクターを描いていただきたく、リクエストをお送りさせていただきました。\n\nテーマ：2024年お正月（構図やデザインなどはお任せ致します！）\n\n特にこのスタイルがとても好きです！https://x.com/PUCHItoro2/status/1478697836216995840?s=20\n\nキャラクター資料を添付いたします。\n\nキャラクター設定：6人のお姉さま達と一緒に天界から人間界に観光しに来た天女の七夜月。秋葉原で謎の店員さんに可愛い獣耳に付けられ、まさか外せれなくなりました。ショッピングなどにはしゃぎ過ぎて、羽衣をなくし、お姉さま達に放置され、人間界に残された。\n\n用途はSNSや配信画像に使用する予定ですので、1280 × 720 (16:9)でお願いいただければ幸いです。また、テキストや背景のあり・なしバージョンもお願い頂ければ幸いです！\n\n金額はもし低すぎでしたら、アピールをお願いいただければ幸いです。\n\nお忙しいところ恐縮ですが、ご検討をお願いいただければ幸いです。\n\nどうぞよろしくお願いいたします。\n\n七夜月\n\nhttps://drive.google.com/drive/folders/1OthI3UC_wSmuajOOJGNwQuM41KNJCKFd?usp=share_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@PUCHItoro2/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1678505, "client_id": 2212589, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aa8d18cd/uploads/origins/b03d6295-6d19-412f-81b0-9532d63acfd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=102517b53812697230bf6b847c243995", "srcset": "https://si.imgix.net/aa8d18cd/uploads/origins/b03d6295-6d19-412f-81b0-9532d63acfd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=102517b53812697230bf6b847c243995, https://si.imgix.net/aa8d18cd/uploads/origins/b03d6295-6d19-412f-81b0-9532d63acfd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc4394ceace2d8af73b0081440b97994 2x, https://si.imgix.net/aa8d18cd/uploads/origins/b03d6295-6d19-412f-81b0-9532d63acfd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=25395706e070af5dba8503ff92516926 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa8d18cd/uploads/origins/b03d6295-6d19-412f-81b0-9532d63acfd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44ea6e20bb1008d14cdf683e6046f181", "srcset": "https://si.imgix.net/aa8d18cd/uploads/origins/b03d6295-6d19-412f-81b0-9532d63acfd2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44ea6e20bb1008d14cdf683e6046f181, https://si.imgix.net/aa8d18cd/uploads/origins/b03d6295-6d19-412f-81b0-9532d63acfd2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7cbccc4e5b3a54172fd5c512b4efb488 2x, https://si.imgix.net/aa8d18cd/uploads/origins/b03d6295-6d19-412f-81b0-9532