の指輪をつけています。\n\n\nまた、URLに＜First Sight＞というラベルの付いた、より詳しい幼少期のバックストーリーフォルダーを追加しました！よろしければご覧いただけますが、ご覧にならなくても全く問題ございません🥺\nどうかご自由にお描きください。 いつもながら、ご検討本当にありがとうございます> <❤️✨\n\nhttps://drive.google.com/drive/folders/1-_qZdBiVePV8nzgM3PQsl8YW2mZ7xrCF", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@33335_sub/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/49aedbd4/uploads/origins/7c325c74-e588-45f1-aee2-f997ae54e38a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59353bc75a386d9ef7e92bfacb523a0a", "srcset": "https://si.imgix.net/49aedbd4/uploads/origins/7c325c74-e588-45f1-aee2-f997ae54e38a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59353bc75a386d9ef7e92bfacb523a0a, https://si.imgix.net/49aedbd4/uploads/origins/7c325c74-e588-45f1-aee2-f997ae54e38a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5ccc9f592a1e7873ab9aaa0bfa8340a4 2x, https://si.imgix.net/49aedbd4/uploads/origins/7c325c74-e588-45f1-aee2-f997ae54e38a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4e0b0fb9bc7738629da1ac3d6734d603 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 3962610, "client_id": 2509179, "nc": 1}], "sent_works": [], "similar_creators": [{"id": 203686, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "春子", "screen_name": "hrk_83n", "avatar_url": "https://pbs.twimg.com/profile_images/2000544438301736960/I4uV3ejj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1904362650601246720/1761796293/