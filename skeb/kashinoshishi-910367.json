2%B5%E3%83%B3%E3%83%95%E3%82%A7%E3%82%B9】\n\n○シチュエーション\n・腕をあげて恥ずかしそうに腋を見せている２人\n\ntwitterで腋のことをつぶやかれていたのを見てご依頼しました。よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kashinoshishi/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1728772, "client_id": 7477, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2b5e4a13/uploads/origins/1c06e880-781f-4cb0-9add-c8b0ce1310a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8577065fcae52d08ea892f6f964dd9e", "srcset": "https://si.imgix.net/2b5e4a13/uploads/origins/1c06e880-781f-4cb0-9add-c8b0ce1310a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8577065fcae52d08ea892f6f964dd9e, https://si.imgix.net/2b5e4a13/uploads/origins/1c06e880-781f-4cb0-9add-c8b0ce1310a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1acb2a37f4cb6528ddf25b20e8acd38b 2x, https://si.imgix.net/2b5e4a13/uploads/origins/1c06e880-781f-4cb0-9add-c8b0ce1310a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e2c3dae482f6f87a9d03a176710c696 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2b5e4a13/uploads/origins/1c06e880-781f-4cb0-9add-c8b0ce1310a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8fc1a339320297e7d48d4981a548d99", "srcset": "https://si.imgix.net/2b5e4a13/uploads/origins/1c06e880-781f-4cb0-9add-c8b0ce1310a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8fc1a339320297e7d48d4981a548d99, https://si.imgix.net/2b5e4a13/uploads/origins/1c06e880-781f-4cb0-9add-c8b0ce1310a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=003c9b2b9bfeb4a4bc24e1de55387c2a 2x, https://si.imgix.net/2b5e4a13/uploads/origins/1c06e880-781f