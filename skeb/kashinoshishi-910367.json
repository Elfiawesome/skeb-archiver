-9131-a4b4496e66d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ec0641d99b63742b7c8ef224672d9336 2x, https://si.imgix.net/f31ab4eb/uploads/origins/633c022e-1f9c-4f5c-9131-a4b4496e66d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6d34d8a39127705135868eb7d0e76eb1 3x"}, "body": "はじめまして。\n私のオリキャラのイラストをリクエストします。\n\nリクエスト内容\n･キャラクター：\n私のオリキャラ『斗光千梨』（とこう　せんり）\n\n･キャラクターの特徴：\n飄々としたおじさん臭い性格でクールな雰囲気\nスレンダー体型っぽいですが全身ムチムチで胸は巨乳(F~Gカップ程度) \n衣装や髪型、髪色は参考資料の『新立ち絵』『キャラシート』をご参照ください\n\n･構図など：\nタイツ越し(ランガード有)の脚や臀部を魅せるような構図\nやや際どい感じでも大丈夫です\n\nその他細かい要素はおまかせします\n\nご検討よろしくお願いいたしします。\n\nhttps://drive.google.com/drive/folders/1d8GA5px-CHEYkOW4roTOoXTT2BHyfZjD", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kashinoshishi/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1728772, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6645efb/uploads/origins/bcff0d63-a8af-44da-b543-21efc12f27e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e58dd7df9a603f79d9c517a5605c043", "srcset": "https://si.imgix.net/b6645efb/uploads/origins/bcff0d63-a8af-44da-b543-21efc12f27e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e58dd7df9a603f79d9c517a5605c043, https://si.imgix.net/b6645efb/uploads/origins/bcff0d63-a8af-44da-b543-21efc12f27e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1877a31f32cd7b53eb697553a5d14e1c 2x, https://si.imgix.net/b6645efb/uploads/origins/bcff0d63-a8af-44da-b543-21efc12f27e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bececa935e6482aa340b017494db78ee 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6645efb/uploads/origins/bcff0d63-a8af-44da-b543-21efc12f27e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ed72593936c367cf2f2fecc6ff11e2b", "srcset": "https://si.imgix.net/b6645efb/uploads/origins/bcff0d63-a8af-44da-b543-21efc12f27e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ed72593936c367cf2f2fecc6ff11e2b, https://si.imgix.net/b6645efb/uploads/origins/bcff0d63-a8af-44da-b543-21efc12f27e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=983568ba397dcc0063fc1f5f3692f8e5 2x, https://si.imgix.net/b6645efb/uploads/origins/bcff0d63-a8af-44da-b543-21efc12f27e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7fb2a570131a25106aa4f8a19240e24d 3x"}, "body": "初めまして、かしのしさんのskeb内でのリクエストイラストを発見して依頼したいと思いましたので送らせていただきます。\n\nキャラ：桐野紗枝（マギアレコード　魔法少女まどか☆マギカ外伝）\n衣装：魔法少女衣装\nポーズ：全身絵でお任せ（ソウルジェムのイヤリングを右耳につけているのでお願いします）\n\n髪の毛の端の部分がエメラルドグリーンのような感じになってるのでお手数ですが念のため確認お願いします。\n下記ページの下段に公式絵によるイラストギャラリーがいくつかありますので良ければ参考にして下さい。\nhttps://wiki.puella-magi.net/Sae_Kirino", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kashinoshishi/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1728772, "client_id": 112400, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/28f9ddea/uploads/origins/b6f8d78c-d4e8-4502-9344-0bf09da2770d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7799aa1fd915c4d0d1c5c8b6bccdc0a7", "srcset": "https://si.imgix.net/28f9ddea/uploads/origins/b6f8d78c-d4e8-4502-9344-0bf09da2770d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7799aa1fd915c4d0d1c5c8b6bccdc0a7, https://si.imgix.net/28f9ddea/uploads/origins/b6f8d78c-d4e8-4502-9344-0bf09da2770d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d187656cc69f3630ae707595e1346f27 2x, https://si.imgix.net/28f9ddea/uploads/origins/b6f8d78c-d4e8-45