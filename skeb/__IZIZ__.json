/origins/51e6b603-c83d-4624-9026-717b9e86bde2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=63cb63150a65ddcdcb740d43c3c77536", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1981154, "client_id": 226222, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@__IZIZ__/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1981154, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/49e626ba/uploads/origins/0611c5d9-aef9-4b0c-b8c4-6a30fad51f50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=34ffbae45e8e36986a695a5061bda311", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/49e626ba/uploads/origins/0611c5d9-aef9-4b0c-b8c4-6a30fad51f50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cbb16f140e0bff11668ad72ca54f930c", "src_set": ""}, "body": "素敵なイラストいつも楽しみにしております。\nもしよろしかったら下記の内容でお願いいたします。\nシチュ地雷でしたら申し訳ありません。\n\n■キャラクター、シチュエーション\n舞姫ちゃん、雪姫ちゃんがショタにケツを揉まれながら大量の使用済みコンドーム入りのゴミ袋をゴミ出ししている場面。\n・台詞例\nショタは「早く戻って続きしようよ～」と生意気な感じ。\n舞姫ちゃんは「外ではやめなさいよあんたねぇ💢」みたいな怒り気味な感じ。\n雪姫ちゃんは「あっ……どうも～」とこちらに気付き恥ずかしがりながら挨拶。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@__IZIZ__/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1981154, "client_id": 329919, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/082fe981/uploads/origins/5be221dd-51a1-4412-9916-0239af60a85b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdf3e011baac43229a7c7dc384b4fb65", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/082fe981/uploads/origins/5be221dd-51a1-4412-9916-0239af60a85b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aca43bf0d145e4f0267bd4d497ef0fc1", "src_set": ""}, "body": "いつもお世話になっております。\nリアル知人のいるアカウントなのであまり過度な反応はできませんが、舞姫ちゃんにぶちまけたい欲求は多分にあります(笑)\n\n自分の性癖を押し付けたく依頼させていただきます。\n\nキャラ\n舞姫ちゃん\n\n衣装\nおっぱい露出でその他はお任せ。\n\n竿役\n可能なら先日の紫色の触手モンスター\n不可なら人間で\n\nシチュ\n自分の自慢のおっぱいを使わせてぶっかけを欲求する舞姫ちゃん\n\n「あんたのザーメンでトリートメントするんだから、さっさとこのでかパイまんこ使って匂い(くっさい)ザーメンぶっかけなさいよ」とおっぱいを乱暴に揉ませてパイズリぶっかけを要求\n\n可能なら\n「あんただけ気持ちよくなってどうすんのよ!乳首つねりなさいよ」と乳首責めも要求\n\nぶっかけられた後は\n「はー、最高(さいってー)、最高(さいてい)の気分だからお詫びとして中だし10発しなさいよ」とノリノリの御様子。(ハート目)\n\nセリフはだいたいなので舞姫ちゃん本人にあわせていただけると助かります。\nでかパイまんこはおっぱい(巨乳)の呼びかた+(お)まんこorオナホに変更可\n\n匂い(くさい)は好みのにおいという意味で使わせてもらってますので「臭」という字はNGで\n\nシチュがささらない、舞姫ちゃんは絶対こんなこと言わないなどでしたらキャンセルで\n\n差分増加による増額はお受けしますのでキャンセルから再送いただけたらと思います。\n\n以上よろしくお願いいたします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@__IZIZ__/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1981154, "client_id": 523856, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b9e88655/uploads/origins/8da5d88e-42cf-4eaa-9d31-3534658dffa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1c8cf7dd6bc7b2eed47f4aaa2520b413", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b9e88655/uploads/origins/8da5d88e-42cf-4eaa-9d31-3534658dffa1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e84a63e3ee3dfc07d4e7f30e92bed6f9", "src_set": ""}, "body": "神崎さんお疲れ様です！\n普段お描きになられているイラストのムチムチ具合がとても大好きで、見たい欲が爆発したためご依頼させていただきます！\n\n◯依頼キャラ\n・矢来美羽（お好きな服装で）\n\n◯構図\n以前神崎さんがお描きになられたお尻強調舞姫ちゃん絵くらい、スカートからパンツが見えているお尻を強調しつつ\n下記のURLのイラストのように顔をこちらに向けて欲しいです。\nhttps://www.pixiv.net/artworks/73907293\n\n◯差分\n・神崎さんのオリキャラ蓮くんくらいイケメン顔の　六連佑斗　の気持ち良さそうな顔があるカットイン（横顔）が左上に欲しいです。（切り替え可能）\n・また、お尻におちんちんをすりすりしてる差分、挿入差分、膣内射精差分もあれば嬉しいです。\n・上記に合わせた美羽の表情差分\n\n本当に長文になってしまい大変申し訳ありませんが、ご検討してもらえると嬉しいです！\n何卒宜しくお願い致します。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@__IZIZ__/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/21a64ae8/uploads/origins/0a9650c3-fb5d-431a-af39-9165c0fa7d93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=00cefa403fd28ef48f4e5b27107fd118", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1981154, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@__IZIZ__/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e0331a5f/uploads/origins/1e38362f-8699-4807-8246-1b12e1925463?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ce6ffeacade510b8b989890e20784e9b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1981154, "client_id": 92768, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@__IZIZ__/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1981154, "client_id": 2499091, "vtt_url": null, "thu