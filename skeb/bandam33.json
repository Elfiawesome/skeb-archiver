。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bandam33/works/18", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b8bcb13b/uploads/origins/c0a95c82-771e-4548-91d4-9a612c47872a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3a405b56ac1c352e3db8bdb471e182f6", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 966535, "client_id": 525147, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@bandam33/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 966535, "client_id": 300792, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f2c4a74f/uploads/origins/77efe7b7-32ec-4da0-a9f0-f7e64ab69dfc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50ff96f555c2a5684af5b01e23c4f5e1", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f2c4a74f/uploads/origins/77efe7b7-32ec-4da0-a9f0-f7e64ab69dfc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5831e31bdac07e7e0ee68017b3853333", "src_set": ""}, "body": "こんにちは、契約のためのイラストを探しています。\n登場人物は私のオリジナルキャラクター\nフルスケッチ： https://photos.app.goo.gl/5P1oXpwCAmrTj9Co7\n10代の冒険者という設定\n\nレジェは私のキャラクターの服を着ていて、\"それは難しい \"と恥ずかしそうに言うのですが\n私のキャラクターがレジの服を着て、\"そういう着方もあるのか \"と言っている。\n\n本当にありがとうございました。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bandam33/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 966535, "client_id"