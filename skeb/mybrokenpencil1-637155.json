23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=24ad910048a7b0325762dec36f11ddbe 3x"}, "body": "あなたのイラスト、すごくかっこいいです！大好きです！\n\n私のキャラクターの面白いプロフィールアイコンをいくつか描いていただけないでしょうか？SNSで使いたいんです。選択できる2人のキャラクター（イノリかグウェン）のリンクを添付しました。 どちらのキャラクターを選んでも、どんな服装で描いていただいても構いませんので、お好きなほうを自由に選んでください。ご自身のアイデアに合わせて服装を変更していただいても大歓迎です。もしどちらのキャラクターもお気に召さない場合は、遠慮なくお断りください！\n\nポーズについては、キャラクターがカメラにぎゅっと押し付けられているようなものがあれば嬉しいですが、他にもアイデアがあればぜひ教えてください。\n\nイノリは気難しく、対人恐怖症で、巨大な剣を持っています。 \n\nグウェンは生意気で、魔女であることを自慢していますが、実は帽子の下に隠れている生き物が魔法を唱えているのが彼女の秘密です。火の玉を放とうとしても、その生き物が全く違うことをしてしまうことがあり、そんな時は「わざとやったんだ」とごまかさなければならない場面もあります。\n\nhttps://drive.google.com/drive/folders/1GivOs-UQkcJc2TBiIkHQlRRnIOlODdid?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mybrokenpencil1/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4042013, "client_id": 2761913, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cfa863a7/uploads/origins/ca1a015f-4822-4aa7-8e24-016ebcd63321?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1aae3b33c0af4dd6a0a35472e48627d4", "srcset": "https://si.imgix.net/cfa863a7/uploads/origins/ca1a015f-4822-4aa7-8e24-016ebcd63321?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1aae3b33c0af4dd6a0a35472e48627d4, https://si.imgix.net/cfa863a7/uploads/origins/ca1a015f-4822-4aa7-8e24-016ebcd63321?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f94420e61507efae5b306ad1830f3a4 2x, https://si.imgix.net/cfa863a7/uploads/origins/ca1a015f-4822-4aa7-8e24-016ebcd63321?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df4dddb0f539473ce5b5c38df89c856b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cfa863a7/uploads/origins/ca1a015f-4822-4aa7-8e24-016ebcd63321?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8ac7147b87fa6a71a6fe366f10f5662", "srcset": "https://si.imgix.net/cfa863a7/uploads/origins/ca1a015f-4822-4aa7-8e24-016ebcd63321?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8ac7147b87fa6a71a6fe366f10f5662, https://si.imgix.net/cfa863a7/uploads/origins/ca1a015f-4822-4aa7-8e24-016ebcd63321?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e6f8f9f7f0cd87338bc805a89f252e73 2x, https://si.imgix.net/cfa863a7/uploads/origins/ca1a015f-4822-4aa7-8e24-016ebcd63321?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ef346c047a71f8138374b71ac56ee020 3x"}, "body": "先生、こんにちは。先生の落書き風の画風がとても気に入っています。私のオリジナルキャラクター（OC）のアクションシーン、例えば剣を振るったり、首を伸ばしたりする様子などを描いていただけないでしょうか。自由に、リラックスして思い切り描いていただければと思います。\n▼【キャラクター設定】\n\n名前：蒼藍星\n年齢：20+\n出身地：旧大陸\n身長：175\n職業：モンスターハンター\n武器：太刀\n\n【性格】\nとても豪快だが、新大陸の団員の多くと同じように、旧大陸の人々からは変わり者扱いされている。龍が大好きで、かつてメスのファイアドラゴンの卵を持ち帰って孵化させようとしたところ、「これは食材にするものだ」と叱られたことがある。\n【外見】\n黒茶色の髪、茶色の瞳で、少し琥珀色のような感じ。頬には少し赤ちゃんのようなふっくら感がある。\n\n【モチーフ・要素】\n薬草　アイルー猫　焼き肉　ドラゴンエッグ　木 フワフワクイナ\n\n【経験】\n旧大陸にいた頃からすでに一定の成果を上げていたが、新しいモンスターを発見することにも憧れていたため、第5期調査団は彼女にとってこれ以上ないほどぴったりだった。aiboが迷った時はがっつり食べるという考え方に大賛成！暇な時には料理を習って、aiboに味見してもらい、評価してもらっている。\n戦闘中、あるアイテムを探すためだけに慌てふためいてポケットをくまなく探してしまうことがよくある。ボス、次はアイテムをあちこちに散らかす癖を直したほうがいいよ、ニャー\n\n本体フワフワクイナ\n\nhttps://drive.google.com/drive/folders/1UHYhGwJ9pl18V9Oft5NO6ECjL9FUL6bQ", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mybrokenpencil1/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4042013, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fd3cd8c7/uploads/origins/a96131f7-a52f-4a4f-ae8f-44cd54c10889?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4172006327767db21b9bf4c2493b2a0", "srcset": "https://si.imgix.net/fd3cd8c7/uploads/origins/a96131f7-a52f-4a4f-ae8f-44cd54c10889?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d4172006327767db21b9bf4c2493b2a0, https://si.imgix.net/fd3cd8c7/uploads/origins/a96131f7-a52f-4a4f-ae8f-44cd54c10889?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e6a3261a06f999e98718d5e191ea23c 2x, https://si.imgix.net/fd3cd8c7/uploads/origins/a96131f7-a52f-4a4f-ae8f-44cd54c10889?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4246d5ea40d8e3223f7f531f0108191b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fd3cd8c7/uploads/origins/a96131f7-a52f-4a4f-ae8f-44cd54c10889?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bbb9f5844a76df828c0320140979ba8", "srcset": "https://si.imgix.net/fd3cd8c7/uploads/origins/a96131f7-a52f-4a4f-ae8f-44cd54c10889?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4bbb9f5844a76df828c0320140979ba8, https://si.imgix.net/fd3cd8c7/uploads/origins/a96131f7-a52f-4a4f-ae8f-44cd54c10889?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=56bbd059f00229bcfe08726593f3e8f3 2x, https://si.imgix.net/fd3cd8c7/uploads/origins/a96131f7-a52f-4a4f-ae8f-44cd54c10889?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cb4916b23422b61864562aa1afd7f553 3x"}, "body": "こんにちは！私のオリジナルキャラクター（OC）を2人、描いていただけませんか？\n\n1人目は、威厳のある佇まいを持つ、強大な剣の聖人です。髪は黒で、瞳は緑色。身長は175cmです。白い蝶の髪飾りは、彼女のキャラクターにとって重要な要素ですので、ぜひそのまま残していただけると助かります。\n\nもう一人のキャラクターは、彼女の相棒です。女性のような格好をしていますが、実は男性なので、体を描く際はその点を考慮してください。身長は150cmです。髪色は淡いピンクです。生意気なところがありますが、彼なりの方法で役に立ってくれる存在です。\n\n剣の聖女は、相棒を守る使命を負っています。彼女はそれを誇りに思っていますが、おそらく決して口には出さないでしょう。相棒はそのことを知っており、いつもそのことで彼女をからかっています。\n\nhttps://imgchest.com/p/9p4n9xzdw7n", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mybrokenpencil1/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4042013, "client_id": 2761913, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8b9e0e25/uploads/origins/f1e01c81-cf55-40c4-8d25-26d92b664c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51d805750446cf2666a05eeeb7c168e3", "srcset": "https://si.imgix.net/8b9e0e25/uploads/origins/f1e01c81-cf55-40c4-8d25-26d92b664c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51d805750446cf2666a05eeeb7c168e3, https://si.imgix.net/8b9e0e25/uploads/origins/f1e01c81-cf55-40c4-8d25-26d92b664c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e5cb81e9fc95d2f0ae62da0ff63dc43f 2x, https://si.imgix.net/8b9e0e25/uploads/origins/f1e01c81-cf55-40c4-8d25-26d92b664c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f9919ceb8a9d7716539783573835459 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8b9e0e25/uploads/origins/f1e01c81-cf55-40c4-8d25-26d92b664c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=622e837692a93d8a77d8c0476a83ecc0", "srcset": "https://si.imgix.net/8b9e0e25/uploads/origins/f1e01c81-cf55-40c4-8d25-26d92b664c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=622e837692a93d8a77d8c0476a83ecc0, https://si.imgix.net/8b9e0e25/uploads/origins/f1e01c81-cf55-40c4-8d25-26d92b664c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7ebd36d227eacd9ac4aa63b9950acf8c 2x, https://si.imgix.net/8b9e0e25/uploads/origins/f1e01c81-cf55-40c4-8d25-26d92b664c5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7e96064c5386e1f6734f4f656ada83d8 3x"}, "body": "またお邪魔して申し訳ありませんが、私のTRPGの探検家のイラストを描いていただけないでしょうか。\nキャラクターイラストや挿絵は、お好きなものをお選びいただけます。衣装も同様です！たくさんの種類がありますので、お気に入りのものや描きやすいものを選んでください。\n\n▼【キャラクター設定】\n\n名前：沢田 雪乃（さわだ ゆきの）\n年齢：22歳\n出身地：大阪\n身長：160cm\n職業：怪異事件を専門とする記者\n\n【性格】 明るく活発で、どこか柴犬のような雰囲気のある女の子です。 好奇心旺盛で冒険好きですが、少しだけ気が強く、わがままなところもあります。 家族から大切に育てられたため、少し甘えん坊な一面もあり、自分なりの考えやこだわりをしっかり持っています。\n\n【モチーフ・要素】 ・骨 ・柴犬 ・ビデオカメラ ・古生物 ・化石 髪は基本的に茶髪で、白い部分は本人が自分で入れたメッシュです。 眉毛は「豆豆眉」のような、丸く小さめの眉をしています。\n\n物語の舞台は、クトゥルフの神々が存在する現代の世界観だ。オリジナルキャラクター（OC）である雪乃は、幼い頃から生まれつき社交的だが、物言いが少しわがまますぎる！「せめて少しは控えめにしなさい」。両親や友人たちはそう雪乃を評するが、初めて会う見知らぬ人にとっては、彼女は少し付き合いづらい人物に映るかもしれない。そのため、学生時代の雪乃は常に大人気の「リーダー的存在」だったが、小学3年生の夏のある夜、いたずら好きな男子生徒に怪談を聞かされ、その場で泣き出してしまった――！「恥ずかしすぎる」という思いから、それ以来、雪乃は二度とこうしたことに怖がらないと決心し、むしろ自ら進んで怪談やホラーストーリーに触れるようになった。大人になって、彼女は従兄の沢田翼（彼の兄）と同じように、記者になった。過去には、幽霊が写ったカメラや、深夜に暴走した「幽霊映画館」（まるで映画の内容が現実になったかのような）と戦ったこともある。今、心霊現象を専門に調査する同好会に入りました。\n\n【使用用途】 個人利用のみ ・スマートフォンの壁紙 ・SNS等のアイコン などを予定しております。 可能でしたら、完成品のPSDデータも納品していただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1v-eKegqeLI3s95Ywlf0rc_h1AIGiPFTQ", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mybrokenpencil1/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4042013, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a5568ead/uploads/origins/2e145bb1-b704-45a2-aebd-e52ca646da17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f899cdb1cbf14c44f838677f7367cc1e", "srcset": "https://si.imgix.net/a5568ead/uploads/origins/2e145bb1-b704-45a2-aebd-e52ca646da17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f899cdb1cbf14c44f838677f7367cc1e, https://si.imgix.net/a5568ead/uploads/origins/2e145bb1-b704-45a2-aebd-e52ca646da17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8d2dd65c83cfbd73ab5e160f29baa3e3 2x, https://si.imgix.net/a5568ead/uploads/origins/2e145bb1-b704-45a2-aebd-e52ca646da17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=565be40e77fc704ace588d5790798c61 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5568ead/uploads/origins/2e145bb1-b704-45a2-aebd-e52ca646da17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b9ad6b1cb1bd72fd79625fde760ede4", "srcset": "https://si.imgix.net/a5568ead/uploads/origins/2e145bb1-b704-45a2-aebd-e52ca646da17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b9ad6b1cb1bd72fd79625fde760ede4, https://si.imgix.net/a5568ead/uploads/origins/2e145bb1-b704-45a2-aebd-e52ca646da17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=55bbea5ea0ccaf733001069fc409e645 2x, https://si.imgix.net/a5568ead/uploads/origins/2e145bb1-b704-45a2-aebd-e52ca646da17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=588ea659f2e3c43a84920cec953a7910 3x"}, "body": "ちょっと変わったお願いなのですが、以下のプロンプトに基づいてキャラクターをデザインしていただけませんか？\n\n異世界に転送されてしまい、生き残るために偉大な魔法使いのふりをしなければならない、ちっぽけな負け犬少女。 彼女には魔法を使う能力など全くありませんが、大きな帽子をかぶった小柄な少女が、実は完全な詐欺師でありながら、そう呼ばれると激怒してしまうという設定が、私にはとても面白く思えます。彼女は、持たない力を装い続けながら、人間の知恵と機転を駆使して、魔法の試練を乗り越えなければなりません。 例えば、火炎瓶を投げつけてから「ファイアボール！」と叫び、無知な村人たちに魔法のように見せかける。そして「ほら！ 魔法が使えると言ったでしょ！」と自慢する。\n\n彼女はショートヘアで、小柄、胸は小さい設定にしたい。メインカラーは赤、青、黒。 彼女は手振りが豊かで、話すペースはかなりゆっくりで、どこか疲れたような口調ですが、偽りの魔法の腕前を擁護する時だけは、声のトーンを上げて激しく怒ります。可愛らしいキャラクターにしてほしいです。\n\nそれ以外は、お任せします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mybrokenpencil1/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4042013, "client_id": 1210901, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ef7f42d/uploads/origins/dc0c2dc0-aaf7-4d92-9379-233fc559d14a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b87bc3d8e407c17a0e5fd0ad5536a8ba", "srcset": "h