いいてんきさん、こんにちは！あなたの絵のスタイルがとても気に入っています。私のオリジナルキャラクターを描いていただけませんか？\n\n⚫彼女は茶色の髪に青い瞳の女の子で、言葉ではうまく気持ちを伝えられないタイプです。波や泡が好きで、寂しげな歌を聴くのが好きです。\n→https://drive.google.com/drive/folders/1dfMPlctLGbxfe-YDrdvpQkZAhohBcR1Z\n\n⚫先生、衣装やデザインはご自由に選んでください。お読みいただきありがとうございます！\n⚫使用用途\n・壁紙などとしての個人利用\n・個人利用の範囲内で利益を生まない印刷物の作成\n・SNSへの掲載（作者名も明記します）", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@25_sunny2/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3722827, "client_id": 3634601, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5f8d69fd/uploads/origins/51ab9d07-1a1a-4f7d-a338-9e6dad6fb171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=757089e0c588434f8e128634b7984f1e", "srcset": "https://si.imgix.net/5f8d69fd/uploads/origins/51ab9d07-1a1a-4f7d-a338-9e6dad6fb171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=757089e0c588434f8e128634b7984f1e, https://si.imgix.net/5f8d69fd/uploads/origins/51ab9d07-1a1a-4f7d-a338-9e6dad6fb171?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=680b9421b3287adda798557d5f62b38d 2x, https://si.imgix.net/5f8d69fd/uploads/origins/51ab9d07-1a1a-4f7d-a338-9e6dad6fb171?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3feccb72198e95aa88ec0d0b01c2e8c6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5f8d69fd/uploads/origins/51ab9d07-1a1a-4f7d-a338-9e6dad6fb171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d87ea4ce2bcf8321c984ce92a4c70175", "srcset": "https://si.imgix.net/5f8d69fd/uploads/origins/51ab9d07-1a1a-4f7d-a338-9e6dad6fb171?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d87ea4ce2bcf8321c984ce92a4c70175, https://si.imgix.net/5f8d69fd/uploads/origins/51ab9d07-1a1a-4f7d-a338-9e6d