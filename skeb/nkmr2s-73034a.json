せします（作中・表紙・オリジナルいずれも可）\n・表情はおまかせします\n・バストアップ、全身等はおまかせします。\n・上杉風太郎は構図的に腕や身体の1部になるかと思いますが全ておまかせします……でも何かしら風太郎と分かるものがあると嬉しいですね。\n・セリフ等はおまかせします。\n\nその他:\n色々書きましたけど中村様のウェディング四葉が見たくてリクエストしました。\n作画コスト高いのは承知しているのでカーテン巻いてウェディングドレス！でも良いです。\nよろしくお願いします。\n\nhttps://www.s-claire.jp/blog/9002/", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nkmr2s/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/00ab760c/uploads/origins/d75cf423-772b-4495-9fa1-603caa2f7fee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c8aca29c6370a8516413fcf182ec0493", "srcset": "https://si.imgix.net/00ab760c/uploads/origins/d75cf423-772b-4495-9fa1-603caa2f7fee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c8aca29c6370a8516413fcf182ec0493, https://si.imgix.net/00ab760c/uploads/origins/d75cf423-772b-4495-9fa1-603caa2f7fee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=74010935f36a4250093d71706e22ea92 2x, https://si.imgix.net/00ab760c/uploads/origins/d75cf423-772b-4495-9fa1-603caa2f7fee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6a6a6500fecfcd41ceaa33ea4c8bf19e 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 576512, "nc": 48}, {"path": "/@nkmr2s/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 576512, "client_id": 1668919, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c932ba3f/uploads/origins/87aa7915-64ab-4216-8c21-cbe459911e2a?bg=%23fff&auto=f