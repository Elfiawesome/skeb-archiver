status/1574008326966243328\n\n・先生の過去作品\nhttps://skeb.jp/@Houdukixx/works/20\n\n太ももが多めに見えると嬉しいです。\nデザインが複雑ですので、服装や武器等の細部は簡略化や省略して頂いても構いません。\n全身及び武器全体が画面に収まっていなくてもOKです。\n\nもしよければご検討よろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Houdukixx/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 35890, "client_id": 462930, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8eb12543/uploads/origins/9adf71f9-7846-4f03-88b8-5c707f4dcf43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59f6b16d39db88363538e8bd7352a1a6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8eb12543/uploads/origins/9adf71f9-7846-4f03-88b8-5c707f4dcf43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f6de438270032208b407148f8147a369", "src_set": ""}, "body": "はじめまして。\n募集再開していたのでリクエストします。\n\n東方の影狼ちゃんがイチャラブエッチするR18絵をお願いします。\n\n発情期を迎えた影狼ちゃんが恋人の家にお泊りし\n布団の上でイチャラブエッチをしています。\n体位としては男性主観の正常位でお願いします。\n\n汗だくで激しくエッチする影狼ちゃんは\nとても気持ち良さそうな表情で感じている状態で\n恋人にこのまま中出しするよう促しており\n中出しされるのをドキドキと期待しています。\nその後、中出しされて絶頂させられますが\n既成事実ができて影狼ちゃんは嬉しいようです。\n\n他の方が依頼したサグメ様とのエッチ絵のような\n擬音や喘ぎ声ありで金額内で可能な範囲で\n挿入前から行為中、中出しや事後等の差分をお願いします。\n\n大きな胸と結合部が見えていれば服装は全裸でも半脱ぎでもＯＫです。\n\nまた、描くのに抵抗が無ければ陰毛を描いてください。\n\n以上、ご検討ください。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Houdukixx/works/21", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/aa85f683/uploads/origins/f89872b3-217f-45a4-9044-481b94ff825f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ec7ca732123a393339418ae449d45fc9", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 35890, "client_id"