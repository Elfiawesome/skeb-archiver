&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0ab8278e12a2ecfdb3e350d640ff14c7 3x"}, "body": "イカ先生、こんにちは。今回は友人の代わりに依頼を申し込ませていただきました🥰💕\n彼女は先生に描いていただくネロ・アンジェロのカラーイラストをとても楽しみにしています🥺具体的に希望するシーンは、発情期かつ泌乳期にある牛のアンジェロが、乳が出にくくて困っているところを、搾乳係の初代ダンテが助けに来て、手で搾乳してあげるというものです。 可能であれば、乳が噴き出すシーンや「砲機」の使用も描いていただけると嬉しいです。普段は反応が薄く、ぼんやりしているアンジェロちゃんを、ひどくいじめるような姿にしたいです🥵💕💦\nもし先生がこの依頼を引き受けてくださるなら、引き受けた後は一旦保留にして、後で描いていただいても構いません。再婚の日が近づいているので、この依頼が先生のオリジナル作品の制作に影響を与えないようにしたいのです🥺（実は私は「再婚の日」企画の企画者の一人なのですが、友人が先生を招待してくれたことに本当に驚き、嬉しくてたまりませんああああ😭😭😭😭💕💕💕今年の615イベントが本当に楽しみです）", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@halt_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 492583, "client_id": 655113, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/587537cf/uploads/origins/f432b969-d8d9-4c84-ac99-ca206ad9652e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42873e5faf52d61c98c123d2b3117396", "srcset": "https://si.imgix.net/587537cf/uploads/origins/f432b969-d8d9-4c84-ac99-ca206ad9652e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42873e5faf52d61c98c123d2b3117396, https://si.imgix.net/587537cf/uploads/origins/f432b969-d8d9-4c84-ac99-ca206ad9652e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91f231bf30e31c675205f9c76e6e616d 2x, https://si.imgix.net/587537cf/uploads/origins/f432b969-d8d9-4c84-ac99-ca206ad9652e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2227e7c633ddb10fe3ccc321740b5d45 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/587537cf/uploads/origins/f432b969-d8d9-4c84-ac99-ca206ad9652e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2df7efb8f7ed7bce5f731a42bfe8b535", "srcset": "https://si.imgix.net/587537cf/uploads/origins/f432b969-d8d9-4c84-ac99-ca206ad9652e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2df7efb8f7ed7bce5f731a42bfe8b535, https://si.imgix.net/587537cf/uploads/origins/f432b969-d8d9-4c84-ac99-ca206ad9652e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07e91424cc9d4e0b1b5028f6ae1a1deb 2x, https://si.imgix.net/587537cf/uploads/origins/f432b969-d8d9-4c84-ac99-ca206ad9652e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cf65d122261edcb177b6ca195b6d6c29 3x"}, "body": "こんにちは！あなたのDMCのアート、本当に大好きです！私のオリジナルキャラクター、オデットとバージルの絵を描いていただけませんか？二人は恋人同士なんです！DMC3とDMC5のデザインで迷っているので、どちらにするかはあなたにお任せします！\n\nDMC3: http://wondernyan.notion.site/Odette-and-Vergil-DMC3-07bd4b8686b94abc8349cfb8dbb41eb9\n\nDMC5: https://wondernyan.notion.site/Odette-and-Vergil-DMC5-480802894fc64e009a5175fc19a963ce\n\nオデットは天使と人間のハーフ！淑やかで優雅な印象のデビルハンターですが、戦うことが大好きで、競争心も旺盛です！自慢したり、楽しさのあまり相手をからかったり挑発したりするのも好きです。ヴェルギルが真面目になりすぎているときはよくからかいますが、彼を深く愛しています！ ヴェルギルは普段は少し冷淡なところがありますが、オデットに対しては心を開いています。彼女と一緒にいると、普段より弱さを見せたり、心を開いたりする傾向があります 🥰💕 二人は若く、行く当てもなかった頃に知り合ったため、お互いに深く愛し合っています！\n\nポーズについては、ロマンチックなもの、甘いもの、あるいは親密なものが理想です。詳細はあなたにお任せします！！ 本当にありがとうございます！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@halt_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 492583, "client_id": 3858211, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/18e3c52b/uploads/origins/a8840177-f739-4b1a-a5b2-7e00075c7459?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=825f0ee3c12a86da144f9ef2216f0667", "srcset": "https://si.imgix.net/18e3c52b/uploads/origins/a8840177-f739-4b1a-a5b2-7e00075c7459?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=825f0ee3c12a86da144f9ef2216f0667, https://si.imgix.net/18e3c52b/uploads/origins/a8840177-f739-4b1a-a5b2-7e00075c7459?bg=%23