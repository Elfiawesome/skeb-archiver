fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0ce8a1818477ad98c4576fa3ce25c60f 3x"}, "body": "ねねこ様こんにちは＊ YouTubeにて配信活動をしているてんぴと申します。\n\n もうずっと前からねねこ様のイラストのファンです！何年も、いつかねねこ様にイラストをお願いしたいと思っていました。 \n\nこの度skeb再開とのことで、ドキドキしながらメッセージを打たせていただいております。   \n\n\n私のOCキャラを描いていただきたいです＊  星、月、天使、リボンのモチーフが大好きです。淡い水色〜淡いピンクのグラデーションがテーマカラーです！  \n\n キャラの見た目や性格などはリンクの画像にまとめさせて頂いております。  \n\nポーズやお洋服はお任せいたします。  使用用途は配信サムネイルや配信中の立ち絵など、配信に関するものに使用させていただきたいです。   \n\nどうか、ご縁がありますように…⭐︎\n\nhttps://drive.google.com/file/d/1Q7AZ5Z3fiReFfODd9yrfBa38jggdjsIu", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ilis_0226/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3099233, "client_id": 3425661, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1fea2598/uploads/origins/51fbfa29-1c79-4596-afa1-2f72b3c7fb8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38c140fe871cc8f65c01b497455d8ef9", "srcset": "https://si.imgix.net/1fea2598/uploads/origins/51fbfa29-1c79-4596-afa1-2f72b3c7fb8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=38c140fe871cc8f65c01b497455d8ef9, https://si.imgix.net/1fea2598/uploads/origins/51fbfa29-1c79-4596-afa1-2f72b3c7fb8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fa25bab05847b03c0559f5bbe02733a0 2x, https://si.imgix.net/1fea2598/uploads/origins/51fbfa29-1c79-4596-afa1-2f72b3c7fb8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92e91d9d21556b1d369e67d4cf10f5ba 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1fea2598/uploads/origins/51fbfa29-1c79-4596-afa1-2f72b3c7fb8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ecb2edc9078ebfa1fd5547b379e254d5", "srcset": "https://si.imgix.net/1fea2598/uploads/origins/51fbfa29-1c