0-2369-427b-83f2-c5ba2311be32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=02c69442453c4c93f749fc790dc6f05a 2x, https://si.imgix.net/c1fdf4fa/uploads/origins/c795bf20-2369-427b-83f2-c5ba2311be32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ac56f802b2d84060e6d08f4064c45555 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c1fdf4fa/uploads/origins/c795bf20-2369-427b-83f2-c5ba2311be32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30a3a46e579092b826debb07446d80a9", "srcset": "https://si.imgix.net/c1fdf4fa/uploads/origins/c795bf20-2369-427b-83f2-c5ba2311be32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=30a3a46e579092b826debb07446d80a9, https://si.imgix.net/c1fdf4fa/uploads/origins/c795bf20-2369-427b-83f2-c5ba2311be32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=081598c583b96c039f4bdee62a9c4760 2x, https://si.imgix.net/c1fdf4fa/uploads/origins/c795bf20-2369-427b-83f2-c5ba2311be32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9ecd03a71cb5db23bba13340dd99d0c8 3x"}, "body": "藍沢ちひろ先生　初めまして。リクエスト失礼します。\n\n2022年1月にFANBOXへ投函された「お隣のお姉さんと目が合った」の続き的な感じのイラストをお願いする事は出来ますか。\n\n構図としては、目が合った後に、胸を隠しながら正面を向き、優しい表情で注意（おねショタ感）をする感じでお願いします。\nまた、もしよろしければ差分として、全てを見せてあげる感じのイラストもあれば嬉しいです。\n\n先生が描かれるお姉さんキャラが好みもありますが、体のラインや構図など印象に残っていたので送らせて頂きました。\nよろしくお願いいたします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aizawa_ccc/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b53ef730/uploads/origins/35211985-0eb6-4dcd-a10f-d60de507783c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37163ca64723412b4e8ce07e02ee8df2", "s