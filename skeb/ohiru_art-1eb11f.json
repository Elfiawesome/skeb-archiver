able_same_genre": true}, {"path": "/@ohiru_art/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3741378, "client_id": 3106612, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/685f9a15/uploads/origins/b717d85b-78d6-4ab1-a9a5-989c2c28dd44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d6839e84dc73a623c4305f531edffeb", "srcset": "https://si.imgix.net/685f9a15/uploads/origins/b717d85b-78d6-4ab1-a9a5-989c2c28dd44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9d6839e84dc73a623c4305f531edffeb, https://si.imgix.net/685f9a15/uploads/origins/b717d85b-78d6-4ab1-a9a5-989c2c28dd44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0197a64c61994f2c8d53ab4062e976c 2x, https://si.imgix.net/685f9a15/uploads/origins/b717d85b-78d6-4ab1-a9a5-989c2c28dd44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86c67ca2d946a843f8cb44581ba26e52 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/685f9a15/uploads/origins/b717d85b-78d6-4ab1-a9a5-989c2c28dd44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ca2b9a5f2dcce5e7f4c91ecbe55128a", "srcset": "https://si.imgix.net/685f9a15/uploads/origins/b717d85b-78d6-4ab1-a9a5-989c2c28dd44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1ca2b9a5f2dcce5e7f4c91ecbe55128a, https://si.imgix.net/685f9a15/uploads/origins/b717d85b-78d6-4ab1-a9a5-989c2c28dd44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa98e4f377fd88c127171c799a1e08c0 2x, https://si.imgix.net/685f9a15/uploads/origins/b717d85b-78d6-4ab1-a9a5-989c2c28dd44?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=439de2e6f70fc2f1ef29831f531438b6 3x"}, "body": "このキャラクターで好きなことをしてください。あなたの絵はとても素晴らしい