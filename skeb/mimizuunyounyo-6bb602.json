6ee-42a4-4a61-adaf-3097cb647cb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6eb68dcf99372d05b5209428abd6b151 2x, https://si.imgix.net/08279793/uploads/origins/3ae606ee-42a4-4a61-adaf-3097cb647cb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6c86d8d032077819de7a42f8d55fbcca 3x"}, "body": "リクエスト失礼します。\n\nキャラ：アイドルマスターシンデレラガールズの八神マキノちゃん（巨乳）\n\n服装：フロントファスナーのついたキャットスーツ\n　　　又は[シークレットナイト]八神マキノ＋（https://imas.gamedbs.jp/cg/idol/detail/89?h=imcgss-c738）\n\nシチュ\n・隠密活動中で警備員に見つからないよう柱の陰に隠れていたが、唇がついた浮遊する球体モンスター複数体が襲い、両腕上げで拘束されファスナーを開けられて露わになったおっぱいを激しく舐られる（あえて警備員に知らせずに舐っているシチュ）\n警備員たちが見回っているため振り払うこともできず、バレないように必死に喘ぎ声を我慢している", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mimizuunyounyo/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 127, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/84aa5a2b/uploads/origins/caf61606-db49-42c1-8aa5-c2b5fba563c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6554d23accaf789028464400628abbfc", "srcset": "https://si.imgix.net/84aa5a2b/uploads/origins/caf61606-db49-42c1-8aa5-c2b5fba563c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6554d23accaf789028464400628abbfc, https://si.imgix.net/84aa5a2b/uploads/origins/caf61606-db49-42c1-8aa5-c2b5fba563c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21ca3175842b4f81d9256e2e182bfdf6 2x, https://si.imgix.net/84aa5a2b/uploads/origins/caf61606-db49-42c1-8aa5-c2b5fba563c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a1f6c7eb8e3da6e8a587e8cb831f9d6a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/84aa5a2b/uploads/origins/caf61606-db49-42c1-8aa5-c2b5fba563c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7512300459075046b19da4936191193", "srcset": "https://si.imgix.net/84aa5a2b/uploads/origins/caf61606-db49-42c1-8aa5-c2b5fba563c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7512300459075046b19da4936191193, https://si.imgix.net/84aa5a2b/uploads/origins/caf61606-db49-42c1-8aa5-c2b5fba563c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5c9fc6f37c5b0c3d94b0eadcf294590d 2x, https://si.imgix.net/84aa5a2b/uploads/origins/caf61606-db49-42c1-8aa5-c2b5fba563c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f83f7272b374a9fe9b4db64693c75b58 3x"}, "body": "下記エロシチュエーションを、\nモノクロ・多少ラフな感じで、その分カット数多めでお願いします。\n\nグラブルのソリッズとクムユがお互い裸。\nクムユはフードは被っている状態。\nサウナのような場所に閉じ込められて汗だく。\n\n向き合った状態で座って助けを待っている。\nソリッズは子供だからと我慢するが、ドラフの体つきに目が行く。\nおっぱいを見られて恥ずかしがるクムユ。\n\nクムユは視線に我慢できずに後ろを向いて出口を探す。\nその動きがお尻をフリフリして誘っているように見えてしまい葛藤。\n\nメインはクムユのエロでお願いします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mimizuunyounyo/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 127, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b4df944b/uploads/origins/a116bc0b-ef50-4243-9764-da65d15c8213?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5560c0716d2386fc5aae53a2e980b40f", "srcset": "https://si.imgix.net/b4df944b/uploads/origins/a116bc0b-ef50-4243-9764-da65d15c8213?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5560c0716d2386fc5aae53a2e980b40f, https://si.imgix.net/b4df944b/uploads/origins/a116bc0b-ef50-4243-9764-da65d15c8213?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4771b5ff74e0af5e69a72eba2db19592 2x, https://si.imgix.net/b4df944b/uploads/origins/a116bc0b-ef50-4243-9764-da65d15c8213?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=