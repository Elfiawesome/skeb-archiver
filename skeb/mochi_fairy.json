ly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@mochi_fairy/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3759092, "client_id": 40597, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/44b8817c/uploads/origins/ecf24b19-9a2d-4890-820f-35d83256ab7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa65f7bf4f84226d0af98fa87467900e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/44b8817c/uploads/origins/ecf24b19-9a2d-4890-820f-35d83256ab7e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c31b6e0fd2ed2f34e8367d59472d4a17", "src_set": ""}, "body": "はじめまして、うちの子をお願いしたいのですが、ご検討いただけますでしょうか。  \n\n■容姿・コスチューム \n資料URLをご参照ください。 \n肉付きはむっちりめ、胸は特に大きめでお願いします。 \n衣装はむっちりぱつぱつ感を強調し、細かい部分は描きやすいようにアレンジ・省略していただいて構いません。  \n\n■シチュエーション \n小生意気な表情、挑発的でセクシーなポーズでお願いします。\n胸やお腹、太ももがよく見える構図だと嬉しいです。  \n\n納品形式はPSD、宛名は別レイヤーでお願いします。\n\nhttps://drive.google.com/drive/folders/10JCMZdXfluuwRP_jN3AtA9YzguuNYuVe?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mochi_fairy/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3759092, "client_id": 2470779, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac4b15f5/uploads/origins/128ebc25-88b6-4fee-a4b8-7a1ed0d61659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdab1bfb6e5bb6044a7a45b2f298b95e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac4b15f5/uploads/origins/128ebc25-88b6-4fee-a4b8-7a1ed0d61659?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67298b9ee81256aec44073bef491bab3", "src_set": ""}, "body": "もちまこさんこんにちは！skeb開設ありがとうございます☺️♪機会があれば是非ご依頼したいなと思っていたので嬉しいです！早速ですがご依頼内容です。\n【内容】\nわたしの一次創作「DiVA」より積木姉妹をお願いしたいです。\n玲那（妹）が麗（姉）に対して「そういう感情」を抱いて絡みつくような、執着している、そんなイメージのイラストをお願いしたいです。　\n玲那は麗に対して愛情と親愛、恋慕、独占欲を包み隠さず麗に向けています。\n一方麗は戸惑い、若干の嫌悪、後悔、実妹だから強く否定できないなどの反応を見せています。\n\n構図などはすべてもちまこさんにお任せします🙇‍♀️\n外見や衣装に迷ったら立ち絵①を参考にしていただければと思います。\n【用途】\n個人観賞（SNSで見せびらかす場合があります）\nタブレットやスマホのホーム画面にして楽しむなど\n\nキャラクターのざっくりとしたプロフィールなどは添付したGoogleドライブの中に入れてありますのでぜひ機会があればお願い致します🙇‍♀️\n\nhttps://drive.google.com/drive/folders/1-4uDwV-1jQr4htlYs9faLuR04MePoe8a", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mochi_fairy/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3759092, "client_id": 3649382, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d42e8481/uploads/origins/9afe781a-3a82-4ebd-8003-1f784c67a87d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c48e1f5e777250f936d30fbaecb62e3f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d42e8481/uploads/origins/9afe781a-3a82-4ebd-8003-1f784c67a87d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=53a3db134364dc9b7bdd97c68a75ed98", "src_set": ""}, "body": "もちもち様\n\n初めまして、シライと申します。リクエストをお願いします。\n\nキャラ①（受け）\nシライ\nhttps://drive.google.com/file/d/1jQDk88Nb4wft5zF1e5xYutBSg4NV27Y3/view?usp=drive_link\n\nキャラ②（攻め）\nエルテシア\nhttps://drive.google.com/drive/folders/13l3oOr3zQcEyE6KTCCOXUzJ37wFns8IF?usp=drive_link\n\n内容\n発情したエルテシア（色がピンクと白の方）はシライをくっついているが、シライからはちょっと苦手が感じ\n\n要望\nレズまたは百合な感じ、\nキャラの大半から全身まで映る\n\n構図と背景などはお任せします。\n\n宜しくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mochi_fairy/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3759092, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a3d33b5b/uploads/origins/6887dce6-c134-4bb3-8336-c1f76e4cd232?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bc5abf8c05f3e38aad172232b8ea334", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a3d33b5b/uploads/origins/6887dce6-c134-4bb3-8336-c1f76e4cd232?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6822dce8668ea6ff805bffef8269197c", "src_set": ""}, "body": "開設お疲れ様です。リクエストします\nセレンｘセラで百合やレズをテーマにしたイラストをお願いします。\nＸに上げられてた二人のイラストと同じくらい濃密で危ない雰囲気のシーンか絡みを希望です。\n「そういう仲」と分かるものだと嬉しいです。構図はおまかせします\nよろしくお願いします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1262659, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "しおん☺︎", "screen_name": "shion_k15", "avatar_url": "https://pbs.twimg.com/profile_images/1648687723388231680/Xo2RKlwJ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3219126403/1682067393/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 145}, {"id": 1981534, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "クリティカラーアキワ", "screen_name": "akw_000", "avatar_url": "https://pbs.twimg.com/profile_images/1950211888283078659/-APVKUa6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1248615989928792066/1754802989/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 144}, {"id": 2658420, "creator": true, "nsfw_acceptable