342-9b2d-70b3fca43ce0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae97e358d48fc68632c0143257605df2", "srcset": "https://si.imgix.net/b50681ca/uploads/origins/db6be06b-a49f-4342-9b2d-70b3fca43ce0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae97e358d48fc68632c0143257605df2, https://si.imgix.net/b50681ca/uploads/origins/db6be06b-a49f-4342-9b2d-70b3fca43ce0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=02d466ec467f2e81cb5074081ff4ac46 2x, https://si.imgix.net/b50681ca/uploads/origins/db6be06b-a49f-4342-9b2d-70b3fca43ce0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d78fd1c9d6ac30025d3ec907ae9d5a7f 3x"}, "body": "ミモンさん、ポタトさんの2名と\n私のキャラのナーブ、ブラッドベッセルが登場する作品を希望します。\n\n●キャラ解説\nナーブ(以降N)\nニューロンモチーフのキャラ。\nピリピリと電気が走る。\n\n②ブラッドベッセル(以降B)\n毛細血管モチーフ。\n全体的にわさわさしている。\n\nいずれも奇妙な姿ですが\n描きにくい所はアレンジOKです。\n各部位の寸法なども自由に調節可です。\n\n●テーマ「変な悪夢を見て困惑するミモンさん」\n\n●話の流れ\n①夜寝る前にテレビまたは本で「からだのしくみ」特集を見ているミモンさん。\n血管やニューロンの図を見て感想を話した後に寝る。\n\n②夢の中で、RPGの戦士みたいな格好になる。そこにNとBがやってきて身構える。\n\n戦闘画面に行くかと思いきや\nNは「問題 神経細胞の主なエネルギー源は何と何？」\nBは「問題2 ゴースト血管とは何か？」\nと勉強みたいな質問をする。\n\n③予想外の展開に、答えがわからないことからパニックに。\n\nそこで魔法使いの格好をしたポタトさんが助けに来て、鮮やかに答えを言い相手を退治。\nしかし肝心の答えが聞き取れず、気になって問いただそうとするがポタトさんはドロンと去る。\nモヤモヤして「答えは何なの」と叫びながら目を覚ます。\n\n④翌朝、少しふきげんそうなミモンさん。\nポタトさんに「神経細胞の栄養って何よ？ゴースト血管って結局何なの？」とつい聞き不思議な顔をされる。\n\n●備考\n「」内の台詞例はあくまで参考です。またそれ以外でもこの子ならこう言うのではと考えていただければと思います。\n夢の中の衣装デザインやどこの部分を重点的に描くかの判断もお任せします。\n\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1fVmoheb_OJqg5vGjHwZwzqqw_gfnSxr3?usp=drive_link", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@maruimono08/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2671940, "client_id": 2785785, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d4a6b7ad/uploads/origins/28361f83-d1a5-4c46-a