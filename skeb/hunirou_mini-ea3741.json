\nキャラ設定資料リンク\n➡️ https://drive.google.com/drive/folders/1Cl0JMdtRY5RqNl2daBwcuczO3_Io3GiN", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hunirou_mini/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3415844, "client_id": 2622678, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8cde2b5/uploads/origins/9f0e3aa0-f222-4f66-a3a3-ca36540296d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e54e290ab2f089e231e6e1cf0de78576", "srcset": "https://si.imgix.net/a8cde2b5/uploads/origins/9f0e3aa0-f222-4f66-a3a3-ca36540296d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e54e290ab2f089e231e6e1cf0de78576, https://si.imgix.net/a8cde2b5/uploads/origins/9f0e3aa0-f222-4f66-a3a3-ca36540296d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed246468b45a2a9b1bf2e932fdd11dc6 2x, https://si.imgix.net/a8cde2b5/uploads/origins/9f0e3aa0-f222-4f66-a3a3-ca36540296d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4fbd83e8fedc0721dff4306a50cbd3ae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a8cde2b5/uploads/origins/9f0e3aa0-f222-4f66-a3a3-ca36540296d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e44557582ab69fb92d4646243364b928", "srcset": "https://si.imgix.net/a8cde2b5/uploads/origins/9f0e3aa0-f222-4f66-a3a3-ca36540296d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e44557582ab69fb92d4646243364b928, https://si.imgix.net/a8cde2b5/uploads/origins/9f0e3aa0-f222-4f66-a3a3-ca36540296d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=21e0089b66927cd5de3a3eb3ca26b05f 2x, https://si.imgix.net/a8cde2b5/uploads/origins/9f0e3aa0-f222-4f66-a3a3-ca36540296d3?bg=%23fff&aut