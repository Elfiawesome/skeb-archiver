3fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f5f1a0787ea0988d8d0f97495c2d5c12, https://si.imgix.net/0a37755b/uploads/origins/8a7666a5-5caf-4df7-a6d6-d6d1d359bfa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f2d3921885a176726bb82731b6ab3fbe 2x, https://si.imgix.net/0a37755b/uploads/origins/8a7666a5-5caf-4df7-a6d6-d6d1d359bfa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9c7434fc298ff9890f9798c1f11e4eb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0a37755b/uploads/origins/8a7666a5-5caf-4df7-a6d6-d6d1d359bfa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=950e1399586d66af2bd8fb14bb30789c", "srcset": "https://si.imgix.net/0a37755b/uploads/origins/8a7666a5-5caf-4df7-a6d6-d6d1d359bfa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=950e1399586d66af2bd8fb14bb30789c, https://si.imgix.net/0a37755b/uploads/origins/8a7666a5-5caf-4df7-a6d6-d6d1d359bfa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0918d2ece4eeeeddb026136c46fae15c 2x, https://si.imgix.net/0a37755b/uploads/origins/8a7666a5-5caf-4df7-a6d6-d6d1d359bfa7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6b0f75d48255427cc2734f55995640b1 3x"}, "body": "ウチの子のアマーリア【https://twitter.com/draw_swindler/status/1387921085908221955?t=CLSao-HjpKegTBOsWttn0A&s=19】とピレリさんちのピレリちゃんがお互いに向き合い、お互いに羞恥で頬を染めつつもドヤ顔でマウントを取ろうとしているイラストと、その後2人がギャラリーの男たちに犯されてアヘ顔肉便器にされてるイラストの2枚を即落ち二コマのような感じでお願いします！\n\nアマーリアの服装は\nハートのニプレス（青色）\n白い長手袋\n白いソックス（ふとももの半分くらいまでの長さ）\nピレリちゃんの服装は\n帽子（立ち絵で被ってるやつ）\nハートのニプレス（赤色）\nソックスorタイツ（生足でも可）と手袋（これらはピレリさんの好みでOKです）\n\nアマーリアのマウント台詞は\n「御覧なさい！このたわわに実った2つの果実と肉付きの良いふとももを！\n貴族に相応しい魅力を備えた自慢の身体ですわ〜！」\nピレリちゃんのマウント台詞はピレリちゃんが自分の身体の自信を持ってる部分について語る感じでお願いします。\n\nシチュエーションイメージとしては\n【突然謎の男たちに拐われたアマーリアとピレリちゃんの2人は室内でギャラリーの男たちに囲まれながら2人がお互いに自分の身体の自慢でマウントを取り合い、勝った方は解放されるが負けた方はギャラリーの男たちの肉便器にされる（というのは男たちの嘘で勝った方ももちろん肉便器にされる）】といった感じです。\nご検討頂けますと幸いです。\n\nhttps://twitter.com/draw_swindler/status/1387921085908221955?t=CLSao-HjpKegTBOsWttn0A&s=19", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pirelli_HEPA/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4345c3e0/uploads/origins/39baa38b-d91a-427c-b268-d634a23a240e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=58859766322483d6f573f63e05082459", "srcset": "https://si.imgix.net/4345c3e0/uploads/origins/39baa38b-d91a-427c-b268-d634a23a240e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=58859766322483d6f573f63e05082459, https://si.imgix.net/4345c3e0/uploads/origins/39baa38b-d91a-427c-b268-d634a23a240e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=66f12033e1beede952e1b031bae22d20 2x, https://si.imgix.net/4345c3e0/uploads/origins/39baa38b-d91a-427c-b268-d634a23a240e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1bd65ebac1b8c926d3318cabcd8576c 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 588742, "nc": 51}, {"path": "/@pirelli_HEPA/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 588742, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42b6a415/uploads/origins/c60d3fe5-ba31-4dee-b127-2e5a7513342b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b15f239faaa140255e7e7af7775