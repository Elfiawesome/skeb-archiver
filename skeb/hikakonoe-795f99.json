のパターンと背景ありで分離可\n　→ 上左右が見切れていないこと（最終的な構図では見切れてＯＫです）\n・psd形式\n\n＜その他情報＞\n・モデルは以前、Skeb二次創作公認プログラムに参加しており、\n　現在は作品受領の代替手段を準備中とのことです\n\nもし、ご対応いただけましたら幸甚に存じます\n\nhttps://twitter.com/ShunsuiRei_SBI/status/1451797416194162695", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hikakonoe/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2051312, "client_id": 2354012, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/08dcf27d/uploads/origins/533309f3-3d13-4293-a79b-9e37de0349d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db643d93a86d0ae6fe60b036118145e2", "srcset": "https://si.imgix.net/08dcf27d/uploads/origins/533309f3-3d13-4293-a79b-9e37de0349d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db643d93a86d0ae6fe60b036118145e2, https://si.imgix.net/08dcf27d/uploads/origins/533309f3-3d13-4293-a79b-9e37de0349d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b11b3cfbf2d4c7a73528513c903bd764 2x, https://si.imgix.net/08dcf27d/uploads/origins/533309f3-3d13-4293-a79b-9e37de0349d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f9d1c91c3081b941e266cc308b39b7cd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/08dcf27d/uploads/origins/533309f3-3d13-4293-a79b-9e37de0349d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff6b2360ded89d210b0632881fa8a417", "srcset": "https://si.imgix.net/08dcf27d/uploads/origins/533309f3-3d13-4293-a79b-9e37de0349d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff6b2360ded89d210b0632881fa8a417, https://si.imgix.net/08dcf27d/uploads/origins/533309f3-3d13-4293-a79b-9e37de0349d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cafd189f