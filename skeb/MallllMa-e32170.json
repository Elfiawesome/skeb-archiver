53ce/uploads/origins/38894aa3-ce43-4b9b-bf2f-99497a4ccdf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbce9bbce8aae14f7d671519405b34f7, https://si.imgix.net/7eb653ce/uploads/origins/38894aa3-ce43-4b9b-bf2f-99497a4ccdf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9d1800fefcfad9add737788f1fcaad20 2x, https://si.imgix.net/7eb653ce/uploads/origins/38894aa3-ce43-4b9b-bf2f-99497a4ccdf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=91718b32963032af4e3c1e5a3c0df7af 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7eb653ce/uploads/origins/38894aa3-ce43-4b9b-bf2f-99497a4ccdf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c533ab9f1cacb08f147e4b2a52af4a79", "srcset": "https://si.imgix.net/7eb653ce/uploads/origins/38894aa3-ce43-4b9b-bf2f-99497a4ccdf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c533ab9f1cacb08f147e4b2a52af4a79, https://si.imgix.net/7eb653ce/uploads/origins/38894aa3-ce43-4b9b-bf2f-99497a4ccdf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=39c87498f8a8f19be8e8acd707bfc760 2x, https://si.imgix.net/7eb653ce/uploads/origins/38894aa3-ce43-4b9b-bf2f-99497a4ccdf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ee9ad097a2e37bcf323b607eb4e4893d 3x"}, "body": "いつも素敵なイラスト拝見させて頂いております。\n\n高校生の女子校のプリンスをテーマに、こちらの資料右側の子を描いて頂けないでしょうか。(自作です)\n\n女子校のプリンスは2人いて、この子は梅を意味する花言葉を持っています。\n\n睡蓮を座すプリンス(左側の子)と一緒に居り、密かに執着心を持っていますがそれを隠しています。\n\n柔らかい微笑みの裏にはいつでも冷たいナイフのような心があります。\n\nmnaさんのイメージする色、描き方、表現でこの女子校のプリンスを描いて頂けないでしょうか。\n\nどうぞよろしくお願いします。\n\nhttps://drive.google.com/file/d/1a1xwLcI_vb2Vy_VNahNQM_zWpocOduWF/view?usp=drivesdk", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MallllMa/works/15", "private_thumbnail_image