.net/65a24cb0/uploads/origins/1beb14ed-e006-4913-be31-b892867e91b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a7f66ac9e6e380b21a5b2814e3cf2aeb 3x"}, "body": "初めまして。\nいつも素敵なイラストを見させていただいております。\n内容がとても好みでしたので依頼させていただきました。\n\nふたなり結月ゆかりに犯される琴葉葵を描いていただきたいです。\n\n■キャラクター\n琴葉葵、結月ゆかり\n\n■シチュエーション\n身体は完全に堕ちてるけどゆかりさんに乱暴にされるのが好きでメスガキのように挑発する葵ちゃん。\n\n■要望\n・葵ちゃんの目がハートになっている\n・葵ちゃんの身体に調教痕の落書きがされている\n\n以上の内容でお願いいたします。\n指定していない部分はお任せいたします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@D_SoLoOse/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2837015, "client_id": 3236983, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3fc6c432/uploads/origins/b0be6fb6-f15a-432c-8ef2-cf78157b0bd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=007acfe267c66f8416788791e12b8382", "srcset": "https://si.imgix.net/3fc6c432/uploads/origins/b0be6fb6-f15a-432c-8ef2-cf78157b0bd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=007acfe267c66f8416788791e12b8382, https://si.imgix.net/3fc6c432/uploads/origins/b0be6fb6-f15a-432c-8ef2-cf78157b0bd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6506ce14332f0139a763b4254695c71f 2x, https://si.imgix.net/3fc6c432/uploads/origins/b0be6fb6-f15a-432c-8ef2-cf78157b0bd8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61b9709d743a67780ae7deaf6aa7e8e3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3fc6c432/uploads/origins/b0be6fb6-f15a-432c-8ef2-cf78157b0bd8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d1f6edc5ef65115810fbcccea03486b5", "srcset": "https://si.imgix.net/3fc6c432/uploads/origins/b0be6fb6-f15a-432c-8ef2-cf78157b0bd8?bg=%23fff&auto=format%2Ccompress&fm=web