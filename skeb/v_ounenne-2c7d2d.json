x.com/shinigami_shiu）\nポーズや構図はお任せします。\n完成品のPSDデータには背景が透過された人物のみのレイヤーもお願いします。\n\nご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1X0F_fVs6vm2zKWTcb37VoeYGTqHFf5rV?usp=sharing\n\nhttps://drive.google.com/drive/folders/1X0F_fVs6vm2zKWTcb37VoeYGTqHFf5rV?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@v_ounenne/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2437537, "client_id": 160493, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a2df910/uploads/origins/3d104ab9-7bca-489c-bf86-f39472d5c9c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6e3ea8230422fe4313f493140a053db", "srcset": "https://si.imgix.net/8a2df910/uploads/origins/3d104ab9-7bca-489c-bf86-f39472d5c9c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6e3ea8230422fe4313f493140a053db, https://si.imgix.net/8a2df910/uploads/origins/3d104ab9-7bca-489c-bf86-f39472d5c9c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85f8d75fcd173e590bad2d82e2b73fdc 2x, https://si.imgix.net/8a2df910/uploads/origins/3d104ab9-7bca-489c-bf86-f39472d5c9c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f6e7a2d43bfb6b6eba8853f59d8c7f71 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8a2df910/uploads/origins/3d104ab9-7bca-489c-bf86-f39472d5c9c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4814718ad0d416add707340db250d83", "srcset": "https://si.imgix.net/8a2df910/uploads/origins/3d104ab9-7bca-489c-bf86-f39472d5c9c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4814718ad0d416add707340db250d83, https://si.imgix.net/8a2df910/uploads/origins/3d104ab9-7bca-489c-bf86-f39472d5c9c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d6b88b91906a7c8f47d3bffa41efd0d3 2x, https://si.imgix.net/8a2df910/uploads/origins/3d104ab9-7bca-489c-bf86-f39472d5c9c3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=af1a2f06231366615e3ffcae613c6d98 3x"}, "body": "ねんねさんこんにちは！ななむーです！\n新規リクエスト再開したとの知らせを受け、馳せ参じました！\nこの度はぜひ自分のオリジナルキャラクターのななむーちゃんを描いてほしいです！\nどんな形のイラストでもよいです！\nあえて希望を言うならななむーちゃんにねんねさんが良いと思う服を着せてあげてほしい…！\n\n使用用途としては鑑賞用、また各種SNSのアイコンやプロフィール画像などに使わせて頂ければと…。\n\nねんねさんのイラストは柔らかでたおやかな雰囲気を醸し出していてとても魅力的で好きです。\nねんねさんの描くななむーちゃんはどんな感じになるのかとても気になります！\n都合つくようでしたら是非…！よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1su4mHciHfSKutZSJRozSDkfUu2aOyPm4?usp=share_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@v_ounenne/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2437537, "client_id": 1942692, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57b5241a/uploads/origins/5aca3ffa-6547-470e-b82d-12216aa5f2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa753f885060f8a162cbe9933338826e", "srcset": "https://si.imgix.net/57b5241a/uploads/origins/5aca3ffa-6547-470e-b82d-12216aa5f2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa753f885060f8a162cbe9933338826e, https://si.imgix.net/57b5241a/uploads/origins/5aca3ffa-6547-470e-b82d-12216aa5f2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3d7e98188900bd516fe4e2034f2d828 2x, https://si.imgix.net/57b5241a/uploads/origins/5aca3ffa-6547-470e-b82d-12216aa5f2a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bad09d501807b7c8e32c4669a828abb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57b5241a/uploads/origins/5aca3ffa-6547-470e-b82d-12216aa5f2a5?bg=%23fff&auto=