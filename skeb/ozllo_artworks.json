srcset": "https://si.imgix.net/4470f40b/uploads/origins/002699eb-60a4-4ed9-8db3-49f2263a1be3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a0e95e0655924ced65a30ae1d8fa50d, https://si.imgix.net/4470f40b/uploads/origins/002699eb-60a4-4ed9-8db3-49f2263a1be3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=615f050ec7a3ddcf10a33e8f4b9e208f 2x, https://si.imgix.net/4470f40b/uploads/origins/002699eb-60a4-4ed9-8db3-49f2263a1be3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=85031aa5d45ec0702d3312bb36d748cd 3x"}, "body": "こんにちは。前回の依頼がとても良かったので、今回もお願いすることにしました。\n\nDIAというOCのアートを頼みたいと思っています。DIAは「クールなお姉さん」っぽいのんびり女の子。常時は生意気だけど、いざって時に頼もしいプロになれる。彼女は意識的、行動前に徹底的な計画を立てるのが好きだ。怠惰な自然によると大体火器で戦って、非常しかないで変身能力を使う。趣味は探偵小説とフィルム・ノワールだ。彼女は甘いペストリーとブラックコーヒーが好きだ。ふっくらとした大きな胸と柔らかそうな体。\n\nDIAが拳銃を持ってポーズを取る姿を見たいです。このアートが大好きで、複数のポーズがある類似の作品をリクエストしたいと思います。\nhttps://x.com/ozllo_artworks/status/2014730370999321015\n\nあなたの絵が大好きなので、どうぞお好きなように彼女を描いてください。先生にとってかっこいいシーンであればうれしいです。\n\n金額が不足している場合は、お問い合わせください。ご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1LUJ26pW96iTvWvY3kWxSPn5rqCq_vNWi", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 28218, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "しろし", "screen_name": "shirofox", "avatar_url": "https://pbs.twimg.com/profile_images/847823948679004162/ROiPKdsf.jpg", "header_url": "https://pbs.twimg.com/profile_banners/40228805/1767326513/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 50, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 160}, {"id": 525454, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name