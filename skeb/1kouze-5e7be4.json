0-9613-d8e48b8150a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=022a34a3ce5d229a2183f47477283b0a 3x"}, "body": "初めまして。\nゆきとと申します。\nOCの漫画を描いて頂きたくご連絡をさせて頂きました。\n\n○依頼内容\nOCが日本家屋の縁側で、主の遺品である煙管を初めてふかすシーンが見たいです。\n\n○使用用途について\n保存して眺める用です。\n\n以下、OCの説明となります。\n\n○設定、資料\n刀のように真っ直ぐ芯の通った青年。今はなき主に忠誠を誓っている。主のように、自分の命を賭けてでも成し遂げたいと思える何かを探している。\n性格：努力家、マイペース、誇り高い\n身長：150cm程度\n特技：武芸全般、速読\n容姿：15才くらいに見えるがれっきとした青年。アッシュグレーのショートに青紫色の瞳。目力が強い。左耳に耳飾りをしている。変なものに好かれやすいので武芸を磨いた。\n好きなもの:本、鍛練、和装、主がくれたもの、主の遺品(煙管、和服、簪etc.)\nイメージカラー：赤\n\n参考画像の子は藤の花の耳飾りをしています\n\nhttps://drive.google.com/drive/folders/10eA3JJVO1-oOj04JyrjnlJhLD-e1OLjV", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@1kouze/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c2026fde/uploads/origins/911099b9-5d25-41c3-889f-6078d6ea5278?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4700ee7feff0bbbb52c2de5e4d5d1481", "srcset": "https://si.imgix.net/c2026fde/uploads/origins/911099b9-5d25-41c3-889f-6078d6ea5278?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4700ee7feff0bbbb52c2de5e4d5d1481, https://si.imgix.net/c2026fde/uploads/origins/911099b9-5d25-41c3-889f-6078d6ea5278?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5063d59ab50458eacc8fea2236b6e988 2x, https://si.imgix.net/c2026fde/uploads/origins/911099b9-5d25-41c3-889f-6078d6ea5278?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d90e459d2a17a9bf204aba3ab5c7faa5 3x"}, "private": true, "genre": "comic", "tipped": false, "creator_id": 3410071, "client_id": 2616112, "nc": 144}, {"path": "/@1kouze/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3410071, "client_id": 681099, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b2723d91/uploads/origins/40e0175e-392a-4a7f-85f9-d45b57da7ca2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0828ddc06eab0e8632321a3bcc7fa028", "srcset": "https://si.imgix.net/b2723d91/uploads/origins/40e0175e-392a-4a7f-85f9-d45b57da7ca2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0828ddc06eab0e8632321a3bcc7fa028, https://si.imgix.net/b2723d91/uploads/origins/40e0175e-392a-4a7f-85f9-d45b57da7ca2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=590258728930e5e3a07c94a33ec9b3ae 2x, https://si.imgix.net/b2723d91/uploads/origins/40e0175e-392a-4a7f-85f9-d45b57da7ca2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=992d2b6882951884e8d9f494d64d4210 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b2723d91/uploads/origins/40e0175e-392a-4a7f-85f9-d45b57da7ca2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b82bfc7a60084ec614ec73f8a097a22e", "srcset": "https://si.imgix.net/b2723d91/uploads/origins/40e0175e-392a-4a7f-85f9-d45b57da7ca2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b82bfc7a60084ec614ec73f8a097a22e, https://si.imgix.net/b2723d91/uploads/origins/40e0175e-392a-4a7f-85f9-d45b57da7ca2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b9be17d7e94e41d16cd79a6ad54b0163 2x, https://si.imgix.net/b2723d91/uploads/origins/40e0175e-392a-4a7f-85f9-d45b57da7ca2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6f766d003b511f15f960dda1a77c98b5 3x"}, "body": "セイさん、こんにちは！セイさんのハイキューの漫画が本当に好きです！もしよろしければ、私のオリジナルキャラクターペアの漫画をリクエストしてもよろしいでしょうか？\n\n俶（ハジメ）： 180cm。3高。熱血漢で単純バカ。大声で傲慢だが、役者としての腕は確か。アドリブが上手い。大型犬のように振る舞い、身体能力が非常に高い。非常に頑固で負けず嫌い。野球をこよなく愛する。昔はストイックで不良と恐れられていた。大阪出身で関西弁を話す。左利きで、眉毛がやや太く、牙があることにご注目ください。\n\n空（ソラ）： 162cm。2高。内気で自分に自信がない。心配性でストレスがたまりやすいが、細かいことによく気がつく頼もしい性格。セリフを覚えるのが上手い。押しに弱いように見えるが、かなり皮肉屋でもある。病弱で喘息持ちのため、保護された環境で育ってきた。そのため、新しいことにチャレンジする意欲は旺盛。本やライトノベルを読むのが好き。\n\n2人は先輩後輩の関係で、演劇部に所属している！はじめは部長でスター＆エース、空は副部長で裏方に徹するが、たまに演技もする。空は俶の演技を見て演劇部に入部したが、俶の変わり者ぶりを見て失望した。そんな肇に辟易しながらも、密かに憧れを抱き、肇の演技を見るのが大好き。一方、俶は空のことが大好きで、いつも空に褒めてもらいたがっている。\n\nストーリー、設定、セリフはお任せします！2人のやり取りや動きをどう解釈するか見てみたいです。演劇部の設定や2人の過去を漫画に取り入れることも歓迎します！JPテキストでもOKです！\n\nすべての参考資料、作品、コミック、その他の依頼サンプルは下のリンクにあります。リンクとは別に、英語での情報もあるので、よかったら参考にしてください！\nhttps://toyhou.se/5622359.hajime-ozaki\nhttps://toyhou.se/5622368.sora-furutani\n\nご検討のほど、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1kq9oMLSxAOQcv0hRhFc_cUX04HikGXxK?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@1kouze/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5e8517bb/uploads/origins/6845437a-4b4a-429e-a3e4-c7d07bc95db0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c002ba80922218464b10e837017ff1c0", "srcset": "https://si.imgix.net/5e8517bb/uploads/origins/6845437a-4b4a-429e-a3e4-c7d07bc95db0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c002ba80922218464b10e837017ff1c0, https://si.imgix.net/5e8517bb/uploads/origins/6845437a-4b4a-429e-a3e4-c7d07bc95db0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=aed563c90d5d38523f784d0bd798b5bf 2x,