リクエスト失礼します。\n\n私のOC達を描いて頂きたいです。\n詳しい資料はURLにありますのでそちら見てください。\n大学生と幽霊のカップリングです。\n\nシチュエーションなどはおまかせでお願いしたいです。サンプルにあるセリフなどそのまま使っていただいても大丈夫です。\n\n不備などありましたらすみません。\nもしご縁がありましたらよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1DAUD7sEqUpQIBjM-YQq2IHTSm7J9sfIa", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@1kouze/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 3410071, "client_id": 2794995, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f6e7891/uploads/origins/b2ca4be9-7735-4fe0-9613-d8e48b8150a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0e3a95ac60875651c414bf0eaddc209", "srcset": "https://si.imgix.net/3f6e7891/uploads/origins/b2ca4be9-7735-4fe0-9613-d8e48b8150a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0e3a95ac60875651c414bf0eaddc209, https://si.imgix.net/3f6e7891/uploads/origins/b2ca4be9-7735-4fe0-9613-d8e48b8150a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5c92e8e7c4b19c0be2ce7120fe16b2d 2x, https://si.imgix.net/3f6e7891/uploads/origins/b2ca4be9-7735-4fe0-9613-d8e48b8150a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bfeb4859fe13341be1a759a244dd1905 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f6e7891/uploads/origins/b2ca4be9-7735-4fe0-9613-d8e48b8150a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=074fff104d69d278b2054924f623fc8f", "srcset": "https://si.imgix.net/3f6e7891/uploads/origins/b2ca4be9-7735-4fe0-9613-d8e48b8150a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=074fff104d69d278b2054924f623fc8f, https://si.imgix.net/3f6e7891/uploads/origins/b2ca4be9-7735-4fe0-9613-d8e48b8150a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop