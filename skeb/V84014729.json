fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64b6dd6d6d5e0df574a2f7661ae37b33", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1e4d8e4d/uploads/origins/1c495d07-e0f9-45f7-8e8f-cd44bb062570?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7bba66b3f33052032cf764f9a337285f", "src_set": ""}, "body": "はじめまして！\nこの2人のオリジナルキャラクターのイラストを描いていただけませんか？\n\nお城やドラゴンなどが出てくるヨーロッパの中世ファンタジーの世界です。OCはモンスターを狩る二人組の冒険者です。\nルフィーナは昆虫学者で、手から炎と雷の魔法を放つ魔道士。性格は高慢で愛想がなく、プライドが高いため、自信過剰でトラブルに巻き込まれることが多い。趣味は魔法のアーティファクトや呪文書を集めること。\nロハナはストイックで責任感が強く、面倒見がよく、ルフィーナを守る勇敢な騎士。剣で戦う。\n\nアクションシーンを描いてください。\n例えば例えば、ドラゴンやファンタジーのモンスターからルフィーナを助けるロハナ、崩れかけた城からルフィーナを運び出すロハナなど、ファンタジー・アドベンチャーの雰囲気があればどんな構図でも構いません。コミカルでもシリアスでも構いません。\n\n使用用途：SNS、OC活動、個人的な閲覧のみを目的とした画像の印刷の可能性。\nいずれにせよ、このリクエストを読んでくれてありがとう。\n\nhttps://drive.google.com/drive/folders/1rj2oV_oAy5QUnQwTa3a31umlOiZBbTEu?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@V84014729/works/131", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2968964, "client_id": 1250821, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8b05ce6/uploads/origins/a94b3cca-4bc1-438b-8bf3-8e691fd6bbbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a31f1cdb9c5af1bc0df1e8e11fd7e33", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a8b05ce6/uploads/origins/a94b3cca-4bc1-438b-8bf3-8e691fd6bbbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1eb69daeb218e33a83d2cf85e24b3dc5", "src_set": ""}, "body": "また相談にのってください！\n\n今回も\n創作活動で他デザイナー様に作成してもらったオリキャラの\nイメージを広げるため二次創作を御願いしたいです。\n\n未来世界で活躍するトラッパー系キャラです。\n性格は、基本的におっとりしています。\n超能力者でもあり、\nロボット等に宿った魂を感じることができます。\n\n・キャラデザイラスト\nhttps://x.com/oniyatsuhashi/status/1902295807535333413\n\n------------\n使用範囲は\n自前の紹介サイトや、\nＸでの掲載となります。（Grok利用はOFFしてます）\n※トリミング使用も想定しています。\n\n御面倒かけますが\nよろしく御検討ください！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@V84014729/works/130", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2968964, "client_id": 2801467, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4fec3793/uploads/origins/e21ff297-7d4a-4ed7-8981-b93528ea1274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08ccc959a9e446ba8492213a94e3a481", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4fec3793/uploads/origins/e21ff297-7d4a-4ed7-8981-b93528ea1274?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f67e0ddca73b0b39a5ce5bcaea53c49a", "src_set": ""}, "body": "こんにちは！もう一人お願いしたいキャラクターがいるんだ。ヴィヴィという魔女です。身長135cm。顔の2つのほくろと髪の黒いハイライトを覚えておいてください。傘を杖として魔法を使ったり、槍として使ったりします。\nhttps://drive.google.com/drive/folders/1GvYNYH232OWZHDaTOQd1R6XEfheHEd-K\n\nヴィヴィが波止場か桟橋の端に座って、足を水に浸してリラックスしているシーンが欲しい。そうしている間、彼女は魔法の練習もしている。その他はお任せします。ご検討ありがとうございました！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@V84014729/works/129", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2968964, "client_id": 11129, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8669b2c1/uploads/origins/6198f070-2cbb-48ff-83db-5a9ef17279f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40216e09c1ff4dbaa404a77aa7e12321", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8669b2c1/uploads/origins/6198f070-2cbb-48ff-83db-5a9ef17279f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=cr