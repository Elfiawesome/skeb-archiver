200&h=200&s=72eb94be19cf51abc6c8d95b19b175e1", "srcset": "https://si.imgix.net/71028a6e/uploads/origins/8a301105-792e-4f47-9157-d9703fbe7ee5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=72eb94be19cf51abc6c8d95b19b175e1, https://si.imgix.net/71028a6e/uploads/origins/8a301105-792e-4f47-9157-d9703fbe7ee5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a51239fdcc13d69d11f33c90b893fb36 2x, https://si.imgix.net/71028a6e/uploads/origins/8a301105-792e-4f47-9157-d9703fbe7ee5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bfaad47be4dc9fbfb8468a43bdcb7157 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/71028a6e/uploads/origins/8a301105-792e-4f47-9157-d9703fbe7ee5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16604ed9789332d08d276777a328cb23", "srcset": "https://si.imgix.net/71028a6e/uploads/origins/8a301105-792e-4f47-9157-d9703fbe7ee5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=16604ed9789332d08d276777a328cb23, https://si.imgix.net/71028a6e/uploads/origins/8a301105-792e-4f47-9157-d9703fbe7ee5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4e61cf2483526bda3081340a7a102f05 2x, https://si.imgix.net/71028a6e/uploads/origins/8a301105-792e-4f47-9157-d9703fbe7ee5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d50d940db86ed0464f179baf5e5e4dc7 3x"}, "body": "自分の持ち主であるマスターの見抜き用オナペットになっていたら魔法カード｢巨乳化｣と罠カード｢強制絶頂装置｣を使われ、その効果で超乳化アへ顔アクメをキメる遊戯王OCGの《RAI-MEI》と《閃刀姫ｰレイ》のコンビをリクエストします。\n\nキャラの造形は\n・全員頭身高めのむちむち、もともと爆乳位のサイズはあるが膨乳で更に大きくなる。\n・膨乳後はへそを超え下腹部がギリギリ隠れない程度の超乳寄りまでサイズアップする(大きい分には可能な限り盛って下さい)\n・服装はカードと同じ物(レイの方は制服と戦闘服のどちらかお好みの物をお選び下さい)で、膨乳後は大きめかつ勃起したパフィーニップルな乳首と乳輪が布地越しにくっきり浮き出た状態になる。\n・性格のイメージはそれぞれお好きなようにお願いします。\n\n二人の横並びしている姿を頭から股間までのバストアップで写し、以下のようなストーリーで台詞付きの差分を用意して欲しいです。\n\nそれぞれの性格に合わせた態度で全員が今からオナペットになることを宣言してオナニーを催促してくる。\n↓\n淫語混じりの嘘喘ぎや扇情的な表情など、いかにも余裕のある態度でこちらを挑発してくる。\n↓\n目の前で｢巨乳化｣と｢強制絶頂装置｣を発動され訳も分からぬまま間抜けな叫び声を上げて絶頂し、微かに残った意識で止めさせようとする。\n↓\n快楽に負け更に汚い淫語を満載したアへオホ声で絶叫し、思い切り白目を剥いたアへ顔を晒しながらイキっぱなしになる。淫語をこれでもかと織り込んだ媚びるような喘ぎ声で射精を催促してくる。\n↓\n射精後。絶頂が止まらず理性が完全に崩壊し、アへ顔のまま虚ろな様子でオホ声を上げながら痙攣し続ける。\n\nとにかく下品で無様なワードで画面を埋め尽くして欲しいです。\n\nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1RxErfHKIlZ2Wtir4kvfPIw3cxECBO84j", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hyphen_hinge/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3063754, "client_id": 470134, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/09d91bc0/uploads/origins/7b30435b-919d-4297-8ff8-ae0c12f005f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=960138971e11fa5b8dae4d80bf68fc8a", "srcset": "https://si.imgix.net/09d91bc0/uploads/origins/7b30435b-919d-4297-8ff8-ae0c12f005f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=960138971e11fa5b8dae4d80bf68fc8a, https://si.imgix.net/09d91bc0/uploads/origins/7b30435b-919d-4297-8ff8-ae0c12f005f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=765d6bcdfba3ba66a03f38120212a217 2x, https://si.imgix.net/09d91bc0/uploads/origins/7b30435b-919d-4297-8ff8-ae0c12f005f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7bfe695f23aa232194c68acfbdf587f3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/09d91bc0/uploads/origins/7b30435b-919d-4297-8ff8-ae0c12f005f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=517051725c2c5fd450ade8d15d243152", "srcset": "https://si.imgix.net/09d91bc0/uploads/origins/7b30435b-919d-4297-8ff8-ae0c12f005f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=20