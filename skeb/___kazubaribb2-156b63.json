: null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57e0a1df/uploads/origins/b8ff9852-fc2b-44b2-a20d-c1d4045f1b67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51d8f9ff046ff0a8131909bb18577531", "srcset": "https://si.imgix.net/57e0a1df/uploads/origins/b8ff9852-fc2b-44b2-a20d-c1d4045f1b67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51d8f9ff046ff0a8131909bb18577531, https://si.imgix.net/57e0a1df/uploads/origins/b8ff9852-fc2b-44b2-a20d-c1d4045f1b67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6cdb3f2744bd0fadf3ed079f15b35839 2x, https://si.imgix.net/57e0a1df/uploads/origins/b8ff9852-fc2b-44b2-a20d-c1d4045f1b67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8ea6dff0be05ca2a6aa87010aef97b4b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57e0a1df/uploads/origins/b8ff9852-fc2b-44b2-a20d-c1d4045f1b67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74897c8e8c43e8bdf99bc387d9311045", "srcset": "https://si.imgix.net/57e0a1df/uploads/origins/b8ff9852-fc2b-44b2-a20d-c1d4045f1b67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74897c8e8c43e8bdf99bc387d9311045, https://si.imgix.net/57e0a1df/uploads/origins/b8ff9852-fc2b-44b2-a20d-c1d4045f1b67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3bea65fd92181655e3dc6162bb508bc2 2x, https://si.imgix.net/57e0a1df/uploads/origins/b8ff9852-fc2b-44b2-a20d-c1d4045f1b67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c5366ce323c0e9be8c4e34f9938a97c8 3x"}, "body": "こんにちは！お邪魔して申し訳ありません！この依頼についてですが、もしよろしければ、私のオリジナルキャラクター（OC）たちのやり取りを描いていただけないでしょうか。二人の時代設定はともに20世紀初頭で、ストーリーに関する内容はすべて【すべての物語の完全なあらすじ】に記載されています\n\n↓以下に、彼らの簡単な性格紹介とリクエストを記載します。\n\n（ボトム）コンスタンティン：24歳、金髪・赤瞳、身長182cm、背が高く痩せており、体つきはほっそりとしていて、振る舞いは優雅です。コンスタンティンは貴族で、家族は非常に裕福であり、両親や兄から溺愛されています。コンスタンティンは聡明で優秀ですが、貴族らしい気性があり、高慢で自尊心が強い一方、人当たりは穏やかですが、どこか距離感を感じさせる人物です。大学を早期卒業した後、文学の分野で活動を始め、執筆やジャーナリズムの分野で重要な地位を占めている。その聡明さゆえに、時折警察から事件の捜査協力を依頼されることもある。彼はヴィラカスを高く評価しており、その評価は後に二人が共通の秘密を持つようになったことで、愛情へと変わっていった。\n\n（トップ）ヴィラカス：21歳、186cm、茶色の軽くウェーブのかかった髪、緑の瞳、標準的な体格、穏やかで礼儀正しい。ヴィラカスは比較的裕福な平民の出身で、コンスタンティンの助手である。コンスタンティンを崇拝していたため、彼の新聞社に応募し、助手として採用された。コンスタンティンの身の回りの世話をし、とても従順で、まるで忠犬のような存在であり、コンスタンティンに強く依存している。\n\n描いてみたい衣装は、お好きなものを自由に選んでください！（西ファンタジー設定がお好きなら、画像28の衣装を選んでいただいても構いません！もちろん、それ以外の衣装もすべて選択可能です！）\n\n金額が合わない場合は、再度依頼を送っていただければ大変助かります！もしお手数に感じられる場合は、そのままキャンセルしていただいても構いません。もし今回の依頼を引き受けていただけたら、本当に感謝いたします！\n\nhttps://drive.google.com/drive/folders/1mP_-_aYjvuPUdyoPB12Sek3bUxpMOry1?usp=share_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@___kazubaribb2/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/db1dae1a/uploads/origins/2cd6217f-78f6-4725-96c1-671439c47a55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1d206eeaad6815a64f5ca6a54368423", "srcset": "https://si.imgix.net/db1dae1a/uploads/origins/2cd6217f-78f6-4725-96c1-671439c47a55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c1d206eeaad6815a64f5ca6a54368423, https://si.imgix.net/db1dae1a/uploads/origins/2cd6217f-78f6-4725-96c1-671439c47a55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c78e9f60452514ff7f777a80d82bdd1 2x, https://si.imgix.net/db1dae1a/uploads/origins/2cd6217f-78f6-4725-96c1-671439c47a55?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=mid