%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f8131a51bb05834c8a23bd130d1ca556 3x"}, "body": "お疲れ様です。\nスケブを再開されると伺いまして依頼をお願いに上がりました。\n内容は以下の通りです。\n\n「リメイク版アルクェイド（私服）がセル第二形態に吸収されて体内に収まる」\n\nアルクの背後からセルが忍び寄り、前回のマザーの様に呑み込まれて尾を通り体内に収められて苦痛の表情になっている。大まかな流れは前回のマザーとほぼ同様です。\n\nhttps://twitter.com/maliusfamily/status/1598827374942257152\n此方の１枚目の画を参考にご利用ください。\n\nhttps://twitter.com/maliusfamily/status/1595191334091956224\n此方の４枚目の画を参考にご利用ください。\n\nhttps://twitter.com/maliusfamily/status/1558728594616360960\n此方の２枚目の画を参考にご利用ください。\n\nhttps://twitter.com/maliusfamily/status/1474489839324372992\n此方の２枚目の画を参考にご利用ください。\n\n参考資料は幾つかのをいずれかで構いません。\n\n是非ともご検討お願いします。\n\nhttps://twitter.com/maliusfamily/status/1424884434612854786", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@vore_jinsei/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1825034, "client_id": 392024, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd2a0e69/uploads/origins/4c8e030e-1ef0-4cf9-b106-f25a6161aad5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e12d83487cbf34c5217c41ffda284cc5", "srcset": "https://si.imgix.net/bd2a0e69/uploads/origins/4c8e030e-1ef0-4cf9-b106-f25a6161aad5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e12d83487cbf34c5217c41ffda284cc5, https://si.imgix.net/bd2a0e69/uploads/origins/4c8e030e-1ef0-4cf9-b106-f25a6161aad5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=85ee863b03f257611f075781cf8e8671 2x, https://si.imgix.net/bd2a0e69/uploads/origins/4c8e030e-1ef0-4cf9-b106-f25a6161aad5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec35ae4be2fff1011da20de8a44baf42 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bd2a0e69/uploads/origins/4c8e030e-1ef0-4cf9-b106-f25a6161aad5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec1a30b46e37a68f760d07be09c5498e", "srcset": "https://si.imgix.net/bd2a0e69/uploads/origins/4c8e030e-1ef0-4cf9-b106-f25a6161aad5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ec1a30b46e37a68f760d07be09c5498e, https://si.imgix.net/bd2a0e69/uploads/origins/4c8e030e-1ef0-4cf9-b106-f25a6161aad5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e6cd5ebd7dc2b1e8c0447af500e498c0 2x, https://si.imgix.net/bd2a0e69/uploads/origins/4c8e030e-1ef0-4cf9-b106-f25a6161aad5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a1aec0c6759f1c5808cf38163bc45828 3x"}, "body": "初めまして。\nセルの餌に惹かれてご依頼させていただきます。\n\nキャラ：人造人間21号、セル第1形態\n\nシチュ：21号をセルが丸呑みする。\n構図はセルの餌にあった、手を尻尾で拘束されお尻を突き上げているシーンで、\n突き上げられたお尻をセルが舐めまわし尻穴を責める。\n抵抗が弱ったところを尻尾で丸呑み。\n\n宜しければ御一考よろしくお願いいたします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@vore_jinsei/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1825034, "client_id": 34806, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/17ac2b04/uploads/origins/5925b4a3-fe1d-4f4b-b4c9-45583b10ac8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1bdb4ecdc879e23d9b21a2a0e004161", "srcset": "https://si.imgix.net/17ac2b04/uploads/origins/5925b4a3-fe1d-4f4b-b4c9-45583b10ac8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1bdb4ecdc879e23d9b21a2a0e004161, https://si.imgix.net/17ac2b04/uploads/origins/5925b4a3-fe1d-4f4b-b4c9-45583b10ac8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21d00f1a5c2ac687cf2a60a01d201aae 2x, https://si.imgix.net/17ac2b04/uploads/origins/5925b4a3-fe1d-4f4b-b4c9-45583b10ac8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=849f84bda859a9f91ca311e753dc6217 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/17ac2b04/uploads/origins/5925b4a3-fe1d-4f4b-b4c9-45583b10ac8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44ea6552f89b674f5bd6ea0db958fe7e", "srcset": "https://si.imgix.net/17ac2b04/uploads/origins/5925b4a3-fe1d-4f4b-b4c9-45583b10ac8a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=44ea6552f89b674f5bd6ea0db958fe7e, https://si.imgix.net/17ac2b04/uploads/origins/5925b4a3-fe1d-4f4b-b4c9-45583b10ac8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f2068e0eb5d18c5990543b37b196b27 2x, https://si.imgix.net/17ac2b04/uploads/origins/5925b4a3-fe1d-4f4b-b4c9-45583b10ac8a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=633e20c4e5676e730fb9ebe017dd0cb6 3x"}, "body": "ツイッターなどでお世話になっております。\nバイルです。\n今回初めて依頼させていただきます。\n\n私のオリジナルキャラクターのセル吸収絵を依頼させていただきたいです。\nセル第2形態にゲスな笑いを浮かべられつつ、じっくり味わわれてごっくんと最後まで飲み込まれてしまうと嬉しいです。\nまたセルがオリジナルキャラを飲み込んだ後に余韻をたっぷり味わいつつ、かぁ……っ！と声を漏らして味わってほしいです（可能ならば完全体になってほしいです。\n\n■オリジナルキャラの参考URL\nhttps://www.pixiv.net/artworks/49182960\n\nご検討お願いいたします。\n\nhttps://www.pixiv.net/artworks/49182960", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@vore_jinsei/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1825034, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aaa250ef/uploads/origins/1fff6120-a591-42b6-ae8d-e81218854b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb70b37c1de6ee9d27a0d50bb365e97a", "srcset": "https://si.imgix.net/aaa250ef/uploads/origins/1fff6120-a591-42b6-ae8d-e81218854b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb70b37c1de6ee9d27a0d50bb365e97a, https://si.imgix.net/aaa250ef/uploads/origins/1fff6120-a591-42b6-ae8d-e81218854b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3341447d057e505c6bd81e258a032a8c 2x, https://si.imgix.net/aaa250ef/uploads/origins/1fff6120-a591-42b6-ae8d-e81218854b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a023addc20514b7a91cdda3d3f24c603 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aaa250ef/uploads/origins/1fff6120-a591-42b6-ae8d-e81218854b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f23d1020b821d29bc41ee7f0e148b779", "srcset": "https://si.imgix.net/aaa250ef/uploads/origins/1fff6120-a591-42b6-ae8d-e81218854b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f23d1020b821d29bc41ee7f0e148b779, https://si.imgix.net/aaa250ef/uploads/origins/1fff6120-a591-42b6-ae8d-e81218854b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f212a7f632426a2cffb3f18db0a6f5aa 2x, https://si.imgix.net/aaa250ef/uploads/origins/1fff6120-a591-42b6-ae8d-e81218854b1e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9567074a748d8775ef2c284c61cb8249 3x"}, "body": "どうも初めまして、よろしければ\nリクエストをお願い致します！\n内容は乃木若葉は勇者であるの郡千景（巨乳で裸に黒ニーソだけの姿）がセル第二形態の尻尾に頭から丸呑みされるのを、上里ひなたは巫女であるの花本美佳（巨乳で裸に黒の靴下だけの姿）の目の前で展開されるのをお願い致します！\n\n郡千景（乃木若葉は勇者である）\nhttps://yuyuyui.jp/character/character12.html\nhttps://www.pixiv.net/artworks/87268086#manga\n\n花本美佳（上里ひなたは巫女である）\nhttps://yuyuyui.jp/character/character30.html\nhttps://www.pixiv.net/artworks/103044876\n\n可能なら以下の様な展開でお願い致します、\n・郡千景と花本美佳の前に現れたセルが尻尾を広げ美佳を呑み込もうとし千景が咄嗟に美佳を庇うも頭部を尻尾の先端部分に呑まれる。\n\n・セルの尻尾にそのまま上半身まで呑まれるも足をじたばたさせて必死に抵抗する千景、「郡様ぁ！？」と声を上げ尻尾越しに千景に抱きつき呑まれないようにする美佳\n\n・二人の抵抗を嘲笑う様に尻尾の締め付けを強めて千景の体の輪郭や顔の形が浮き出る程圧縮しながら千景の全身を一気に尻尾の中に収めるセル\n\n・セルに自分が代わりに吸収されるから千景を解放してと懇願する美佳、\n美佳の願いを一蹴し千景を体内に取り込みそのまま吸収するセル、千景の力と遺伝子で見た目はそのままながらパワーアップするセル\n・喜びながら尻尾を再び広げながら美佳に向けて「私の体内で合わせてやろう！」\nで幕を閉じる。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@vore_jinsei/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1825034, "client_id": 34899, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a6dbfdd9/uploads/origins/38693463-7f7c-403c-a483-e5c88ce671f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ab37a3d48887e0623da843d28eb20f8", "srcset": "https://si.imgix.net/a6dbfdd9/uploads/origins/38693463-7f7c-403c-a483-e5c88ce671f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ab37a3d48887e0623da843d28eb20f8, https://si.imgix.net/a6dbfdd9/uploads/origins/38693463-7f7c-403c-a483-e5c88ce671f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=64e7d70af987390d04372b6763bd5846 2x, https://si.imgix.net/a6dbfdd9/uploads/origins/38693463-7f7c-403c-a483-e5c88ce671f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1cc497944ce874fad52bf59ead51745b 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a6dbfdd9/uploads/origins/38693463-7f7c-403c-a483-e5c88ce671f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1240b8b583c2d4049319d70971133ecd", "srcset": "https://si.imgix.net/a6dbfdd9/uploads/origins/38693463-7f7c-403c-a483-e5c88ce671f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1240b8b583c2d4049319d70971133ecd, https://si.imgix.net/a6dbfdd9/uploads/origins/38693463-7f7c-403c-a483-e5c88ce671f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e8d6a578d36eb4591389d2c91c54c1c1 2x, https://si.imgix.net/a6dbfdd9/uploads/origins/38693463-7f7c-403c-a483-e5c88ce671f5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=214ac1c2df86260353d8c79857c9dd4d 3x"}, "body": "セーラームーンVのセーラーセルがセミパーフェクトセル（第2形態セル）に頭からテールボーンされるところを見たい。\n\nセーラーセル： https://www.dropbox.com/sh/mvxm27g06ry83nh/AABQAyFZXsv7BLZ3ExmDrxEGa?dl=0", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@vore_jinsei/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1825034, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9fcbe8d8/uploads/origins/fc69e666-75ea-432f-a392-d6e3dc02f5fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08b8c13b54ae81970b1448d25b9856d6", "srcset": "https://si.imgix.net/9fcbe8d8/uploads/origins/fc69e666-75ea-432f-a392-d6e3dc02f5fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=08b8c13b54ae81970b1448d25b9856d6, https://si.imgix.net/9fcbe8d8/uploads/origins/fc69e666-75ea-432f-a392-d6e3dc02f5fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f71ebd976423c5e569eec6f4b7c3ead6 2x, https://si.imgix.net/9fcbe8d8/uploads/origins/fc69e666-75ea-432f-a392-d6e3dc02f5fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f739e6df3fc201cc51c181e8a80eb12 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9fcbe8d8/uploads/origins/fc69e666-75ea-432f-a392-d6e3dc02f5fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=415caa2af6ab267690338a30216b565a", "srcset": "https://si.imgix.net/9fcbe8d8/uploads/origins/fc69e666-75ea-432f-a392-d6e3dc02f5fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=415caa2af6ab267690338a30216b565a, https://si.imgix.net/9fcbe8d8/uploads/origins/fc69e666-75ea-432f-a392-d6e3dc02f5fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cca579bcbf7cd7a7c26faaf0327cef5b 2x, https://si.imgix.net/9fcbe8d8/uploads/origins/fc69e666-75ea-432f-a392-d6e3dc02f5fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=06609e30671bddb0a9bcb5ee0d7cb8a4 3x"}, "body": "お疲れ様です。スケブ再開楽しみにしてました。\nちょっと変わった趣向なのですが資料URLにあるセル化したオリキャラが吸収して、気持ちよくなっているところを描いていただきたいです。\n\n丸呑みされる方の描写はなくて大丈夫で（一応設定としては吸収してるのは女性）\n吸収する過程で気持ちよくなり、自分のふたなりや胸をいじりながらお腹に吸収するところで射精、母乳をだしながら絶頂してほしいです。\n\nセリフの有無はおまかせします\nもし導入される場合は「のみこむのきもちいいっ」「シコシコ、とまらなっ……」「（おなかのなかに）くるくる、いぐぅ！」という感じの口調のセリフ使っていただければ自由です\n\n金額次第ですが最後にお腹を少しボテッとさせて、そこを手でさすっているところがあるとよいです。\n\n背中の資料はないので想像で描いてもらうことになります。\n完全体ですが、しっぽは第二形態だと嬉しいです（難しければ完全体のでもかまいません）細かいデザインなどは変更してかまいません。\nまた頭の耳についてる038タグははずしてください。\n\nヤスミネさんのセル漫画や他のオリジナル丸呑み漫画でもしっぽが盛り上がって背中からお腹に吸収するところの描写が素敵だと思ってお願いしてみました。\n\nにっちな依頼ではありますが、ご検討お願いします。ここまで読んでいただきありがとうございました。\n\nhttps://drive.google.com/drive/folders/1wApsxvCa14SdGmT4-iXYjuQJSGMx7JnS?usp=share_link", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@vore_jinsei/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1825034, "client_id": 35196, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8407bb6d/uploads/origins/d58ac77d-13dd-480f-9c20-095dfcd31218?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57d6c346a227712c448f085956e8071c", "srcset": "https://si.imgix.net/8407bb6d/uploads/origins/d58ac77d-13dd-480f-9c20-095dfcd31218?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57d6c346a227712c448f085956e8071c, https://si.imgix.net/8407bb6d/uploads/origins/d58ac77d-13dd-480f-9c20-095dfcd31218?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bccdecdc7a60cafe4ee1ecc7cd620cb3 2x, https://si.imgix.net/8407bb6d/uploads/origins/d58ac77d-13dd-480f-9c20-095dfcd31218?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&