】\n\n淺桜　兎織(あさくら　とおり) 24歳　男性\n・ふわふわの白髪、黒いリボンで髪を結んでいる\n・緩めの関西弁で喋る\n・尽くす側、夜霧には優しい、その他はどうでもいい\n・愛が重いことは夜霧にバレたくない\n「僕は浅桜兎織、よろしゅう頼むわ」\n\n藤崎　夜霧(ふじざき　よぎり) 24歳　男性\n・紺色のぱっつん髪、毛先らへんが紫のグラデーションになっている\n・標準語で喋る\n・尽くされる側、鈍感、おとなしい\n・人見知りだが兎織には心を開いている。\n・バブチャンです\n「えっと、僕は藤崎夜霧です…よろしくおねがいします…！」\n\n2人は恋人同士です！\n\n・お手数おかけして大変申し訳ないのですが、髪型や顔は立ち絵ではない資料を参考に描いてくださると嬉しいです\n・ポーズ、構図はお任せでお願いします🙇\n・完全な丸投げになり申し訳ないのですが、衣装も特に決まっていないので資料の中からお任せでお願いしたいです。\n\nご縁がありましたらよろしくお願いします🙇‍♀️\n\nhttps://drive.google.com/drive/folders/1551y8cSVEXDJyvsDRsRp8d7_8ghzptep", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shioske_b/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3947043, "client_id": 3435806, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d3537423/uploads/origins/076840bf-ee42-4bf2-a171-d93f7fed2bdd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1069c149149658ff9b6a5a446c6565d", "srcset": "https://si.imgix.net/d3537423/uploads/origins/076840bf-ee42-4bf2-a171-d93f7fed2bdd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1069c149149658ff9b6a5a446c6565d, https://si.imgix.net/d3537423/uploads/origins/076840bf-ee42-4bf2-a171-d93f7fed2bdd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a4b1366aab9d7afc3d9da134e4ba129 2x, https://si.imgix.net/d3537423/uploads/origins/076840bf-ee42-4bf2-a171-d93f7fed2bdd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a23c0c40c0c3979d6373542ea815527a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d3537423/uploads/origins/076840bf-ee42-4bf2-a171-d93f7fed2bdd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e7b2b183ec8750f2f0af96e16ca9120", "srcset": "https://si.imgix.net/d3537423/uploads/origins/076840bf-ee42-4bf2-a171-d