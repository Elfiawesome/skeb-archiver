・ケガをしてても暗くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@PINO_ekakimasse/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3561419, "client_id": 3744424, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95d3f344/uploads/origins/e1862f0a-83f8-4551-816a-cd44f5e7f662?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1f4648249d5ff90b0acde79dad1d530", "srcset": "https://si.imgix.net/95d3f344/uploads/origins/e1862f0a-83f8-4551-816a-cd44f5e7f662?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c1f4648249d5ff90b0acde79dad1d530, https://si.imgix.net/95d3f344/uploads/origins/e1862f0a-83f8-4551-816a-cd44f5e7f662?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=882b04faf8c48fad2c97b9fa0c7eb28f 2x, https://si.imgix.net/95d3f344/uploads/origins/e1862f0a-83f8-4551-816a-cd44f5e7f662?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=473fe1289728329be8ba506d53f79424 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95d3f344/uploads/origins/e1862f0a-83f8-4551-816a-cd44f5e7f662?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=250a5ff259cdab2779dbc1b78a6a5ffe", "srcset": "https://si.imgix.net/95d3f344/uploads/origins/e1862f0a-83f8-4551-816a-cd44f5e7f662?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=250a5ff259cdab2779dbc1b78a6a5ffe, https://si.imgix.net/95d3f344/uploads/origins/e1862f0a-83f8-4551-816a-cd44f5e7f662?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e40a1a5e697e8f9dc7e935573c110a58 2x, https://si.imgix