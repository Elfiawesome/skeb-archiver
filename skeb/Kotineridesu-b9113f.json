場合はレイヤーのどこかに記入いただけると幸いです）\n\nご検討くださいますと幸いです。\nもし難しい場合は遠慮なくキャンセルして頂ければと思います。\nhttps://twitter.com/HaruyukiSeto\n\nhttps://twitter.com/HaruyukiSeto/status/1755923879581917403", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 44453, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "山川", "screen_name": "ymkw", "avatar_url": "https://cdn.bsky.app/img/avatar/plain/did:plc:4rr5fj44rohgsra3sm4w2fak/bafkreib6d6yazcbkz6hi37ydogcfautd7xkhrreaiendn7atkom5xwmnci", "header_url": "https://cdn.bsky.app/img/banner/plain/did:plc:4rr5fj44rohgsra3sm4w2fak/bafkreib6d6yazcbkz6hi37ydogcfautd7xkhrreaiendn7atkom5xwmnci", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 129}, {"id": 663892, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "コバヤシ⁉️", "screen_name": "iaia_58", "avatar_url": "https://pbs.twimg.com/profile_images/1879864942024916993/qF118kpe.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1668309895777763328/1759167662/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 45, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}], "banned": false, "nc": 128}, {"id": 862095, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "デボン", "screen_name": "Sawaaaara", "avatar_url": "https://pbs.twimg.com/profile_images/1726771324708941824/Lg6KgBvS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1007579176419799040/1770333690/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_ma