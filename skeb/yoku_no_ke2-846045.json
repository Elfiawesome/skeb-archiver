3-9cdb-350c42aa15fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a07b3440c218dc2b8858470728e05217, https://si.imgix.net/e2e1c06d/uploads/origins/feedddf4-c18c-4623-9cdb-350c42aa15fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d5bc5eb5a4eb171255239695a50f2bc9 2x, https://si.imgix.net/e2e1c06d/uploads/origins/feedddf4-c18c-4623-9cdb-350c42aa15fd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5a9efcdd9bdc47144513ca25359e2925 3x"}, "body": "初めまして。\nリクエストします。\n\n■キャラクター\n東方Projectの今泉影狼\n\n長い爪は普通の長さでＯＫです。\n尻尾の描写もお願いします。\n\n■シチュエーション\n発情期を迎えてフェロモンムンムンな影狼が\n恋人の家にお泊りして布団(ベッド)の上でイチャラブエッチします\n体位は男性主観の正常位や騎乗位などの\nお互い見つめ合えるものでお願いします。\n\n発情期のため全身からフェロモンを漂わせる影狼は\n恋人の射精が近いことを察して、危険日であることを伝えますが\n恋人は興奮してこのまま中に出したいようで\n中はダメと言いつつも迫る中出しにドキドキ期待しています。\n中出し絶頂後、これで番い(つがい)になれたと嬉しそうです。\n\nといった内容を、擬音や喘ぎ声ありで、\n以下のような差分形式で入れられるなら台詞もお願いします。\n\n①挿入前\n　発情期でこれから交尾するんだとドキドキ\n②挿入中\n　挿入されて感じてます。\n③ピストン中\n　中はダメと言いつつもゾクゾク期待中\n④中出し絶頂\n⑤中出し後の余韻中(挿入状態のまま)\n　中出しされてトロ顔となった影狼は\n　これで番いになれたねと嬉しそうです。\n\n服は胸と結合部が見えていれば全裸でも半脱ぎでもＯＫで\n半脱ぎの場合は二次創作でよく見かけるオフショルダーでお願いします。\n\n描くのに抵抗がなければ陰毛描写をお願いします。\n\n以上、ご検討ください。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yoku_no_ke2/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 724271, "client_id": 441913, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97aae064/uploads/origins/cfd215a1-c6cd-4418-9271-a6d67cdf5a9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=754a320538440ace57e1cd01e88d7f56", "srcset": "https://si.imgix.net/97aae064/uploads/origins/cfd215a1-c6cd-4418-9271-a6d67cdf5a9b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=754a320538440ace57e1cd01e88d7f56, https://si.imgix.net/97aae064/uploads/origins/cfd215a1-c6cd-4418-9271-a6d67cdf5a9b?bg=%23fff&auto=forma