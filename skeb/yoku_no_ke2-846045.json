core": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc46e80a/uploads/origins/db135a5c-b592-4100-9cce-b85f717a0807?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0813f7242ae274331b8cd3ff7cdd3e42", "srcset": "https://si.imgix.net/bc46e80a/uploads/origins/db135a5c-b592-4100-9cce-b85f717a0807?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0813f7242ae274331b8cd3ff7cdd3e42, https://si.imgix.net/bc46e80a/uploads/origins/db135a5c-b592-4100-9cce-b85f717a0807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=953e35ef7735955e17ad7cc8b73815f0 2x, https://si.imgix.net/bc46e80a/uploads/origins/db135a5c-b592-4100-9cce-b85f717a0807?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dedad8f40d34885cd58762568bfbafa3 3x"}, "body": "募集を開始したようなので、初めて依頼させて頂きます。\n\nキャラ：さとり、レミリア（手及び台詞のみ）\n内容\nフランの彼氏を寝取った事を知られ、里の中を全裸にされてレミリアに連れ回されるさとり。\n\nさとりの状態としては以下の中から好きなのをお任せします。\n・手首を前面で手錠かロープで縛られて、それに繋がったリードやロープで引っ張られている。\n・片手を掴まれて引っ張られ、空いている方の手で胸かアソコのどちらかを隠してる。\n・腕は後ろで拘束（いわゆる緊縛）で、首にリード付き首輪を付けられて引っ張られている。\n\nレミリアに関しては表示しなくても台詞と引っ張っている手だけで十分です。\n台詞を入れれるのであれば、さとりはレミリアに寝取りの事を謝罪して連れ回しをやめて欲しいと懇願するもレミリアは聞き入れず。\n寧ろレミリアは本当ならもっと無茶苦茶な目に遭わせてやりたい、こんなのまだ優しい方だと告げる。\n\nこんな感じでお願い致します。", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 20103, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ナカムラナヲ。", "screen_name": "Tutihumaz77", "avatar_url": "https://pbs.twimg.com/profile_images/1823365687722827776/R-ZR8aQa.jpg", "header_url": "https://pbs.twimg.com/profile_banners/888597383906340865/1688828990/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 10, "skills": [{"g