_urls": {"src": "https://si.imgix.net/3c6b54b5/uploads/origins/465e23af-5550-4b36-9800-1b9527b7772b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1829d59ac715b74c2b90e9de4aa3b8e6", "src_set": ""}, "body": "お世話になっております、ほのです。\n今回はアイコン用イラストの依頼をさせて頂きたいです。\n\n✧︎コテ詳細\n参考画像より失礼致します。\n好きなブランドのお洋服を使用しているのですが、シンプルすぎるかなと思うので、てんぴさんが良ければアレンジをお願い致します🙇🏻‍♀️\nまた、ハーフツインの髪飾りが水色のリボンだとお洋服と合わないかなと思うので、おまかせさせて頂きたいです。\n\n✧︎構図\nてんぴさんが描きやすい構図でお願いしたいです！ピンクをモチーフに、きらきらで可愛い感じに(周りに小さいお花を散りばめるなど)お願いしたいです⭐️\n\nてんぴさんの書くふわふわな🐹がとても好きなので、今回依頼をすることが出来てとても嬉しいです✨楽しみにしております！\n\nhttps://drive.google.com/file/d/142gOey1EocNHcrk7-bqJVEzULgJbcHe4/view?usp=drivesdk", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 811780, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "九藤ルフ(ばぁや)@skebのみ受付中", "screen_name": "1a1aCthulhu", "avatar_url": "https://pbs.twimg.com/profile_images/1694544208701591552/8UIm0G3U.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1053918121684217856/1680319769/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 32}, {"id": 1224774, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "みうら/たきむら", "screen_name": "MCMGMA", "avatar_url": "https://pbs.twimg.com/profile_images/1885571243589722113/7AOuBxoA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3096520963/1734879011/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "skills": [{"genre": "art"}], "nc": 17}, {"id": 2133550, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "妙子", "screen_name": "teataeko", "avatar_url":