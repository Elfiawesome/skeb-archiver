大好きなので、自分のオリジナルキャラクター（OC）のイラストをもっと描いていただきたいと思っています。もしよろしければ、あなたが描きやすいサイズで、床から起き上がろうとしているポーズのイラストを描いていただけないでしょうか？ 寝転がっている状態でも、片膝をついてお腹が太ももにかかり、体を起こそうと必死にもがいている姿でも構いません（あなたのTwitterで見たこのプロンプトがすごく気に入りました）。服装については、体にぴったりで小さめのTシャツと、ウエスト周りでずり落ちそうなショートパンツを着せていただけると嬉しいです。 ただ、その体重と巨大な体格、運動不足、そして起き上がろうとする苦労に重点を置いて描いていただきたいのです。本当にありがとうございます！\n\nhttps://x.com/rahcama/status/1736989824744329466", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wolfwolfwolwolf/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/6178350b/uploads/origins/2304f734-9391-4865-9318-3e0d2401da73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee0c124fa26612343560d3ea7b6e933d", "srcset": "https://si.imgix.net/6178350b/uploads/origins/2304f734-9391-4865-9318-3e0d2401da73?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ee0c124fa26612343560d3ea7b6e933d, https://si.imgix.net/6178350b/uploads/origins/2304f734-9391-4865-9318-3e0d2401da73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b55ac4c16ce2f7ef562d27652ad5d5cf 2x, https://si.imgix.net/6178350b/uploads/origins/2304f734-9391-4865-9318-3e0d2401da73?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b6753c6f4f170f52d8c79b61a42a1387 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 4065890, "client_id": 797301, "nc": 0}, {"path": "/@wolfwolfwolwolf/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4065890, "client_id": 1851727, "vtt_u