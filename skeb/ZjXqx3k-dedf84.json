照ください)\n　　(細かいですが…首の方は結び目1つ、三角巾の端が2つ、肘の方は結び目1つ、三角巾の端が1つ、という違いがあります)\n　‐右腕が画面に入るような構図でお願いします\n・ほっぺたに絆創膏１枚\n・ケガをしてても暗くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ZjXqx3k/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3495189, "client_id": 2240410, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a1fb6f3d/uploads/origins/eeefd2a7-dec3-4cb4-97d8-461e00f7a597?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9dcdd6565f6d0755a9c6b3a8423fffbb", "srcset": "https://si.imgix.net/a1fb6f3d/uploads/origins/eeefd2a7-dec3-4cb4-97d8-461e00f7a597?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9dcdd6565f6d0755a9c6b3a8423fffbb, https://si.imgix.net/a1fb6f3d/uploads/origins/eeefd2a7-dec3-4cb4-97d8-461e00f7a597?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b75fd09294cbb93f0cb6261ff2d519c8 2x, https://si.imgix.net/a1fb6f3d/uploads/origins/eeefd2a7-dec3-4cb4-97d8-461e00f7a597?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44e8c9489a6cea36a02647b4a2909c57 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a1fb6f3d/uploads/origins/eeefd2a7-dec3-4cb4-97d8-461e00f7a597?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a08ceda1c1c979eedc19fd651f056d9f", "srcset": "https://si.imgix.net/a1fb6f3d/uploads/origins/eeefd2a7-dec3-4cb4-97d8-461e00f7a597?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a08ceda1c1c979eedc19fd651f056d9f, https://si.imgix.net/a1fb6f3d/uploads/origins/eeefd2a7-dec3-4cb4-97d8-461e00f7a597?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&c