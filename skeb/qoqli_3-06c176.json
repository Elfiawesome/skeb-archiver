r=2&fit=crop&crop=top&w=200&h=200&blur=200&s=651ecc1730fcc966a88929f75361d13d 2x, https://si.imgix.net/1e7529eb/uploads/origins/26b9c6e6-19f3-4c1a-8979-6da6c578f2ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4598c493d95d129e37bf20b1462a8dc3 3x"}, "body": "こくり様、こんばんは。\nリクエスト失礼いたします。\nこくり様のキラキラした可愛いイラストがとても大好きです。\n\n可能であれば私のオリジナルキャラクターを描いていただきたいです。\n\n【容姿】\nURL先にて\n\n構図、表情等はこくり様のお好きなように描いていただけますと幸いです。\n服装を変えていただいても構いません。\n\n【性格など】\nこの子は性格が悪いです。とても我儘で自己中心的、「私は可愛いから何をしても許される」という考えを持っており、可愛いからでは到底許されないような、人として終わっている言動をよくします。\nまた、自分の都合が悪くなったら嘘泣きをして被害者ぶることがあります。\n\n【使用用途】\nアイコン・ヘッダー、スマホの待ち受け等に使用します。\n\n【その他、要望】\n・キャラクターのみの透過画像があると嬉しいです。\n・宛名のオンオフができると嬉しいです。\n\nご検討の程よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1tu_ttKDun0HBi-pc-sNBKnjwrvhh6Fiw", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@ky_040f/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3711233, "client_id": 3955985, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/74ab8e18/uploads/origins/cec4cbad-2b1d-4e0b-8c01-0ecaf997d594?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcb0087d9f08781b7623ad0473256221", "srcset": "https://si.imgix.net/74ab8e18/uploads/origins/cec4cbad-2b1d-4e0b-8c01-0ecaf997d594?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcb0087d9f08781b7623ad0473256221, https://si.imgix.net/74ab8e18/uploads/origins/cec4cbad-2b1d-4e0b-8c01-0ecaf997d594?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0dafcf7c0f6c8c804c94de82587650f9 2x, https://si.imgix.net/74ab8e18/uploads/origins/cec4cbad-2b1d-4e0b-8c01-0ecaf997d594?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c74b257f98eba334f4843b487bc7848 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls":