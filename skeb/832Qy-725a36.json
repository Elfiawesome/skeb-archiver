されています。   \n\nこのリンクには2人のオリジナルキャラクターが掲載されており、どちらもスポーツウェアを着用しています。紫色の髪とピーチピンクの瞳のキャラクターを描いていただきたいです。  https://drive.google.com/drive/folders/1BLrJUYVZWnwbFw1YJAmdOH8_xVC_BBid  \n\nなお、こちらのリンクは紫髪のオリジナルキャラクターが他の世界でどのように見えるかを示したものです。この世界では、彼女は古い邸宅に住み、古代のカルト教団で最も寵愛される娘として暮らしています。  https://drive.google.com/drive/folders/1viaU4vt0os1nXeQnWYplS6B6MhMkOrSZ\n\nさらに2つの新しい衣装（2種類の制服セット）を追加しました。気に入っていただけたら、ぜひこちらもご検討ください！\nhttps://drive.google.com/drive/folders/1SJettFr36iCWXCZ2dZV2N1agOZ0T29y1", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@832Qy/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3981833, "client_id": 3977215, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b91a701a/uploads/origins/80f0cd08-b095-4d8a-b766-37841d17dc35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d88ea67d9ca51c271a5de39e626c2c2", "srcset": "https://si.imgix.net/b91a701a/uploads/origins/80f0cd08-b095-4d8a-b766-37841d17dc35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d88ea67d9ca51c271a5de39e626c2c2, https://si.imgix.net/b91a701a/uploads/origins/80f0cd08-b095-4d8a-b766-37841d17dc35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53424f588afb68b5e5f130e423974e7e 2x, https://si.imgix.net/b91a701a/uploads/origins/80f0cd08-b095-4d8a-b766-37841d17dc35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4b71a236bb8017c4ab8a73154b29d8c0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b91a701a/uploads/origins/80f0cd08-b095-4d8a-b766-37841d17dc35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1a5aac4ceeba95d4178fd1b61d62cda1", "srcset": "https://si.imgix.net/b91a701a/uploads/origins/80f0cd08-b095-4d8a-b766-37841d17dc35?bg=%23fff&auto=format%2Ccompress&f