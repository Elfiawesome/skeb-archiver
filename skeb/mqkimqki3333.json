d1d-720f495e6f4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77ded42c9b3ecc72a694f3771ad57103", "srcset": "https://si.imgix.net/be0a5487/uploads/origins/46d825b6-31d0-4737-9d1d-720f495e6f4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77ded42c9b3ecc72a694f3771ad57103, https://si.imgix.net/be0a5487/uploads/origins/46d825b6-31d0-4737-9d1d-720f495e6f4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e8e16fbb0d5f1ba9f06fc739440f7d6 2x, https://si.imgix.net/be0a5487/uploads/origins/46d825b6-31d0-4737-9d1d-720f495e6f4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=623026eec6a049d282f9381cdf4bf492 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/be0a5487/uploads/origins/46d825b6-31d0-4737-9d1d-720f495e6f4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61c2a102c98e396bf66039d8b46c1695", "srcset": "https://si.imgix.net/be0a5487/uploads/origins/46d825b6-31d0-4737-9d1d-720f495e6f4d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=61c2a102c98e396bf66039d8b46c1695, https://si.imgix.net/be0a5487/uploads/origins/46d825b6-31d0-4737-9d1d-720f495e6f4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=30d60830712c87ebfd387eec45c55ad6 2x, https://si.imgix.net/be0a5487/uploads/origins/46d825b6-31d0-4737-9d1d-720f495e6f4d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8c1408cb4526d026524ef22bff7bf09b 3x"}, "body": "お世話になっております。くろつちです。\n\n私が同人誌で描いている『サキュバスシティ』に暮らすモブサキュバスのデザインを【3人】、依頼したく思います。\n\n基本的にデザインは鯉のぼり様の手癖、性癖を自由に込めていただいて構いません。モブサキュバス、と描きましたが、モブ顔やメカクレである必要もありません。「他の方のデザインを取り入れた方が楽しいよね」という意図でリクエストさせていただいています。\n\nデザインしていただく上での要望・注意事項は以下の通りです。\n\n・三面図や表情、ポーズ差分などは必要ありません。服装があまり隠れないポーズであれば問題ありません。\n\n・モブサキュバス、としましたが、モブ顔、メカクレにする必要はなく、髪型や服装などのデザインを必ずしも統一する必要はありません。\n\n・装飾類は華美になりすぎないように。つける場合もワンポイント程度が望ましいです。\n\n・衣服は踊り子風などのファンタジーによりのものでも、セーラー服風などの現代的なものでも問題ありません。露出度は高いとありがたいですが、乳首や局部が(通常時は)露出しないものでお願いします。水龍敬ランドまでの範囲内が望ましいです。\n\n・陰毛、脇毛はいずれも無しでお願いします。\n\n・全員ふたなりですが、skebの形式上、ちんぽのデザインは必ずしも必要ありません。魔法的なもので普段はちんぽを消し、女性と変わりない状態で振る舞うため、股間の膨らみや玉などは不要です。\n\n・デザインが気に入った場合は当該キャラクターのイラストや同人を描いたり、再びこのキャラクターのイラストリクエストをさせていただく場合がございます。\n\n\nデザインの参考に、漫画家、窓口基様がpixivなどに掲載されていた、「無自覚サキュバス化TS」内に登場するモブサキュバスのような、一般常識では外に着て歩くのに適さないものなどが好みです。\n\n\n●資料URL\n■サキュバスシティが舞台の自作同人誌のサンプル\nhttps://x.com/rezanoffffffu/status/1742866095420383568\n\n■窓口基様「無自覚サキュバス化TS」\nhttps://www.pixiv.net/user/15033/series/186658", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mqkimqki3333/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3087612, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd95b0a4/uploads/origins/bdd4abcc-78a1-4d5a-a792-63e3922d6d6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b41766b452db7c10a0b184832dae912", "srcset": "https://si.imgix.net/bd95b0a4/uploads/origins/bdd4abcc-78a1-4d5a-a792-63e3922d6d6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b41766b452db7c10a0b184832dae912, https://si.imgix.net/bd95b0a4/uploads/origins/bdd4abcc-78a1-4d5a-a792-63e3922d6d6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=34f50d3e851ff65fa29d9e4cbd87b1a2 2x, https://si.imgix.net/bd95b0a4/uploads/origins/bdd4abcc-78a1-4d5a-a792-63e3922d6d6a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=33b64e3c69b68ed289c992a8091ee23d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bd95b0a4/uploads/origins/bdd4abcc-78a1-4d5a-a792-63e3922d6d6a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=afb46fa53673f21649a65d6c86a80