ホラーゲームなどが好きでたまに配信でやりますが、基本は雑談や歌枠をメインで活動しております。\n歌ってみたに力をいれていてオリジナルソングもあります。\n\n\n・使用用途\n収益化済みチャンネルにて配信や動画、サムネイル等での使用。\nアイコン又はヘッダー、SNSでの投稿等での使用。\n\nもし可能でしたらキャラクターのみの背景透過のmov(またはGIF)も納品していただけると嬉しいです。\n金額がそぐわない場合、お手数をお掛けしますが再送させて頂きます。\nご検討よろしくお願い致します！\n歌水 ねと\n\nhttps://drive.google.com/drive/u/0/folders/1YlCG4WbMtmijiFR5G4FR56KT691ng3-R", "nc": 16, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": false}, {"path": "/@uoturisio37/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": true, "creator_id": 3562787, "client_id": 477026, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2d6c14a0/uploads/outputs/2a3319cf-197a-4f97-9c0d-b64d352b5846?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=43f54425c66500be3664716fc1ece4c7", "srcset": "https://si.imgix.net/2d6c14a0/uploads/outputs/2a3319cf-197a-4f97-9c0d-b64d352b5846?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=43f54425c66500be3664716fc1ece4c7, https://si.imgix.net/2d6c14a0/uploads/outputs/2a3319cf-197a-4f97-9c0d-b64d352b5846?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=76c23285f7c8d174e3c6972fc1fe7bb2 2x, https://si.imgix.net/2d6c14a0/uploads/outputs/2a3319cf-197a-4f97-9c0d-b64d352b5846?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=213697e5d0b13d2000c861a7a4595a85 3x"}, "duration": 4, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d6c14a0/uploads/outputs/2a3319cf-197a-4f97-9c0d-b64d352b5846?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=71cd43602bedb491d3c102e0a601379b", "srcset": "https://si.imgix.net/2d6c14a0/uploads/outputs/2a3319cf-197a-4f97-9c0d-b64d352b5846?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=71cd43602bedb491d3c102e0a601379b, https://si.imgix.net/2d6c14a0/uploads/outputs/2a3319cf-197a-4f97-9c0d-b64d352b5846?bg=%23fff&fm=webp&auto=compress