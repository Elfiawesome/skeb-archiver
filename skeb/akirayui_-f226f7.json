cda-f7f0-4f91-bf28-8d48bac79a43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db855fdfa31b7a092e8ce85078da350c 2x, https://si.imgix.net/5c78195c/uploads/origins/62676cda-f7f0-4f91-bf28-8d48bac79a43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4dfa9aa607d880c402db17041e526c7b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5c78195c/uploads/origins/62676cda-f7f0-4f91-bf28-8d48bac79a43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b7c7abb1a2d5d829e92e0e22b379bf2", "srcset": "https://si.imgix.net/5c78195c/uploads/origins/62676cda-f7f0-4f91-bf28-8d48bac79a43?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b7c7abb1a2d5d829e92e0e22b379bf2, https://si.imgix.net/5c78195c/uploads/origins/62676cda-f7f0-4f91-bf28-8d48bac79a43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d35186b6ccbff41dcf448704de3e1a64 2x, https://si.imgix.net/5c78195c/uploads/origins/62676cda-f7f0-4f91-bf28-8d48bac79a43?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6537c597e276aabebb9521807464d0ef 3x"}, "body": "由依あきら様\n前回の納品ありがとうございます。\nまたお願いしてもいいですか？\n\nキャラクターは「もんむす・くえすと!ぱらどっくすRPG」の65537ページ，本名はコーネリアです。\n人間形態のコーネリアに参考図の天使の装束を着せでお願いします。\n\n立ち絵2枚を依頼したい。\n表情の差分は先生に任せします。\n\n\n▼一枚目\n・コーネリアの本来の髪色\n・メガネを外し\n・アクセサリ・服装・光輪・耳・翼・瞳・武器・髪型のデザインは参考図の天使です。\n\n▼二枚目は一枚目の差分です\n・コーネリアの元の髪型・髪色・目・眼鏡\n・一枚目の武器はなく、魔導書を持ち\n\n主観視点ですが設定の追加付与（デザインの変更など）でも大丈夫です。\n\nポーズや構図や細部はお任せします。\n\n資料URL参照：https://catbox.moe/c/9scqlg\n\n宜しければお願い致します。\n\n\nそして、もう一つ依頼があります。\n前回の依頼の宛名付きイラストが見てみたいです。\n\nご検討いただければと思います。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akirayui_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 12558, "vtt_url": null