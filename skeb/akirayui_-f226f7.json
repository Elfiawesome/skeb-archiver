冷笑を浮かべる表情で描いていただきたいです。\n＊憑依したゼルダ姫の肉体や精神の影響を受けたことで、ベランの邪悪さより上品さや気品の要素が勝っているイメージの表情で描いていただきたいです。\n\nゼルダ姫の姿はスマブラSP(神々のトライフォース)のデザインでお願いします。\n\nまた、衣装は前回描いていただいたベランの衣装そのままで、頭部の被り物は今回も描かなくて大丈夫です。\n\n要望が多くてすいませんが、ご一考お願いします。\n\nhttps://drive.google.com/drive/folders/10Eglmh2TwX6rPKTACutuKprG9Sh06cJO", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@akirayui_/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 12558, "client_id": 101592, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1509e9c5/uploads/origins/a33decf0-8569-4582-bec1-b291625dc649?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=193e48dcb19c2349bae81a336a41d8af", "srcset": "https://si.imgix.net/1509e9c5/uploads/origins/a33decf0-8569-4582-bec1-b291625dc649?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=193e48dcb19c2349bae81a336a41d8af, https://si.imgix.net/1509e9c5/uploads/origins/a33decf0-8569-4582-bec1-b291625dc649?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24fd9b11cb7182c238b584278247edbc 2x, https://si.imgix.net/1509e9c5/uploads/origins/a33decf0-8569-4582-bec1-b291625dc649?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38e872fddfbc3a5a0840ce8f71139fe2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1509e9c5/uploads/origins/a33decf0-8569-4582-bec1-b291625dc649?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56549b631312e8fa069ae65247e9f350", "srcset": "https://si.imgix.net/1509e9c5/uploads/origins/a33decf0-8569-4582-bec1-b291625dc649?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56549b631312e8fa069ae65247e9f350, https://si.imgix.net/1509e9c5/uploads/origins/a33decf0-8569-4582-bec1-b291625dc649?bg=%23fff&auto=format%2