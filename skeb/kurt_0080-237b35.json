%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=52aeb7febc12b03b008bb6385244e310 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 361447, "client_id": 850258, "nc": 49}, {"path": "/@kurt_0080/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 361447, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6391b43a/uploads/origins/f44d887c-99e6-4675-85f1-5deb6c311ebb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e7b611a8839afdf1d1426202e419cb7", "srcset": "https://si.imgix.net/6391b43a/uploads/origins/f44d887c-99e6-4675-85f1-5deb6c311ebb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e7b611a8839afdf1d1426202e419cb7, https://si.imgix.net/6391b43a/uploads/origins/f44d887c-99e6-4675-85f1-5deb6c311ebb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6412c6506eedaf77bdd6e7dce05569a2 2x, https://si.imgix.net/6391b43a/uploads/origins/f44d887c-99e6-4675-85f1-5deb6c311ebb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3ed9e6461cb2e5360fd8c2c72e019996 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6391b43a/uploads/origins/f44d887c-99e6-4675-85f1-5deb6c311ebb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e24122c40c5d141985a4b8afaf807de", "srcset": "https://si.imgix.net/6391b43a/uploads/origins/f44d887c-99e6-4675-85f1-5deb6c311ebb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e24122c40c5d141985a4b8afaf807de, https://si.imgix.net/6391b43a/uploads/origins/f44d887c-99e6-4675-85f1-5deb6c311ebb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=425f09bdac5b7da66f95ff33c7fb0124 2x, https://si.imgix.net/6391b43a/uploads/origins/f44d887c-99e6-4675-85f1-5deb6c311ebb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5cc206651016c7bb86f0e595f261d9f8 3x"}, "body": "ポコニキ様のヴィルシーナイラストがとても魅力的でしたので、もしよろしければリクエストさせていただきます。\n※内容・金額的に不可であればキャンセルいただいて構いません。\n\nキャラクターはマチカネフクキタル・エイシンフラッシュ・キセキの3人\n\n衣装は3名とも水着。フクちゃんは資料1～4枚目形状の水着で、柄をライラックの花(資料5)に変更をお願いします。\nフラッシュさんは資料6〜8(不可であれば資料9～11)、キセキさんは資料12の水着(※色を勝負服風に)を着せてください。\nまた、可能であれば3名の耳飾りは夏をイメージしたものに変更をお願いいたします。\n\n立ち位置は、左がフクちゃん、センターがフラッシュさん、右がキセキさんです。3名とも頭から膝までの描写を希望します。\n\n体型は、ヴ三姉妹の様にムチムチ。胸は可能であれば3名とも盛ってください。なお、腹筋等筋肉描写は苦手なので無しでお願いいたします。\n\nポーズは、フクちゃんとキセキさんはフラッシュさんに体をくっつける。足は可能であれば三名とも足の間から尻肉が見えるようお願いいたします(資料13枚目風)。手や体の角度等細かい点はポコニキ様にお任せいたします(フクちゃんとキセキさんは元気・フラッシュさん爽やかな雰囲気)。\n\nアングルは正面。\n\n表情は、フクちゃんとキセキさんは元気な笑顔。フラッシュさんはほほ笑む。\n\n背景は夏をイメージた海水浴場(または夏空)。不可であれば背景無しでお願いします。\n\n※もしよろしければですが、下記差分を希望いたします。\nフラッシュさんのバストサイズを14枚目サイズまで大きくしてください。\nその際、フクちゃんキセキさんの表情は目線をフラッシュさんの胸に向けた驚き顔に変更、心の中で「DKPI…!?」という台詞付き。フラッシュさんの表情は恥ずかしそうに。\n\n以上、何卒よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Iy9NX7_WeTJLlGOJZLXxJRwVzusKg6rg", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kurt_0080/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 361447, "client_id": 639858, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ae595642/uploads/origins/947d997f-25ee-40d4-9050-14f4fc5b8aed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d472175481d7025abce98dcf64eec64", "srcset": "https://si.imgix.net/ae595642/uploads/origins/947d997f-25ee-40d4-9050-14f4fc5b8aed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0d472175481d7025abce98dcf64eec64, https://si.imgix.net/ae595642/uploads/origins/947d997f-25ee-40d4-9050-14f4fc5b8aed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=232836b39c051574f960666321610eb4 2x, ht