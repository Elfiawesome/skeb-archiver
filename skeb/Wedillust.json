。\n\n・背景：森（鵺の本体は描かなくて大丈夫ですが、鵺の存在を示すように黒い羽が漂っている描写があると嬉しいです）\n・ポーズ：おまかせ\n・その他：髪型は先生の絵柄に合わせて少しアレンジしていただいて大丈夫です。肢体は怪物化・異体化しても自由です。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 492611, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "piku", "screen_name": "_pikurusu00", "avatar_url": "https://pbs.twimg.com/profile_images/1289922398536347657/CTWA-aqy.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3244365848/1596376523/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 2, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 161}, {"id": 582386, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ねことりな", "screen_name": "necon1", "avatar_url": "https://pbs.twimg.com/profile_images/1839449925383507968/RWxEjcpL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1248620704146141189/1722882925/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 160}, {"id": 1288272, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "moto", "screen_name": "ityohii_", "avatar_url": "https://pbs.twimg.com/profile_images/1644665960635445248/HlKxgQkw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1304089475677523969/1694215159/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}]