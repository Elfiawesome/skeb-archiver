かあるとみんなが心配してくれる恵まれた子です。逆にみんなに何かあると「人手が不足するのは困る」と冷たくいいつつ、最優先で対応します。なんだかんだ今いるあびのメンバーを大切にしています。\n・元々はホールの仕事をしていましたが、今は経理などの裏方業務を担当しています。\n・閻魔に一目惚れしており、自陣の前で公開告白をしたのですが保留にされております。もっといい男になってからまた来いと言われています。\n・キャラクターシート：https://iachara.com/view/11553943 （事前秘匿の記載あり）\n・見た目：https://x.com/misssumith/status/1984915055994089636?s=46&t=Xj4ttAVlI3Gd0z6Xp-HBaQ\n\n何卒よろしくお願いします！", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@io_trpg_06/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3362892, "client_id": 3708726, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/440f3fbd/uploads/origins/52b36f2c-7a97-4ae8-a032-63f304c40883?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73eaf15dc02681f5c38c8871315341b5", "srcset": "https://si.imgix.net/440f3fbd/uploads/origins/52b36f2c-7a97-4ae8-a032-63f304c40883?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73eaf15dc02681f5c38c8871315341b5, https://si.imgix.net/440f3fbd/uploads/origins/52b36f2c-7a97-4ae8-a032-63f304c40883?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6fefe4fa33d8abb85d2de0caa1a84792 2x, https://si.imgix.net/440f3fbd/uploads/origins/52b36f2c-7a97-4ae8-a032-63f304c40883?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=091c45abf38e321333b64a673536ba7d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/440f3fbd/uploads/origins/52b36f2c-7a97-4ae8-a032-63f304c40883?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90a6d078a61e69e1bc7e5876ee6d7b3a", "srcset": "https://si.imgix.net/440f3fbd/uploads/origins/52b36f2c-7a97-4ae8-a032-63f304c40883?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90a6d078a61e69e1bc7e5876ee6d7b3a, https://si.imgix.net/440f3fbd/