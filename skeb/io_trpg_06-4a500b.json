url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e114d75d/uploads/origins/642ebe66-70bb-49bb-b913-57cf69d94686?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd5fd866d7d9a6c2bfa47b8bdab014ae", "srcset": "https://si.imgix.net/e114d75d/uploads/origins/642ebe66-70bb-49bb-b913-57cf69d94686?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd5fd866d7d9a6c2bfa47b8bdab014ae, https://si.imgix.net/e114d75d/uploads/origins/642ebe66-70bb-49bb-b913-57cf69d94686?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5db73cceaf06ea8a1f18097c36c407c6 2x, https://si.imgix.net/e114d75d/uploads/origins/642ebe66-70bb-49bb-b913-57cf69d94686?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=43d4c0d324111dba5174ccc5a57e67b7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e114d75d/uploads/origins/642ebe66-70bb-49bb-b913-57cf69d94686?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=735da77d28f17ebf7d9e81b846ff110f", "srcset": "https://si.imgix.net/e114d75d/uploads/origins/642ebe66-70bb-49bb-b913-57cf69d94686?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=735da77d28f17ebf7d9e81b846ff110f, https://si.imgix.net/e114d75d/uploads/origins/642ebe66-70bb-49bb-b913-57cf69d94686?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ed52862951d40a9a1657dc24d668a644 2x, https://si.imgix.net/e114d75d/uploads/origins/642ebe66-70bb-49bb-b913-57cf69d94686?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b742bbb38145092a7c3d9e8ff0ab3403 3x"}, "body": "砂糖 白さま\n\n初めまして、ヰ緒(いお)と申します。\nSNSにて砂糖白さまの家紋ロゴデザインを拝見し、ぜひご依頼したいと思いリクエストを送らせていただきました。よろしければTRPGキャラクターの家紋ロゴを描いていただけましたら幸いです。\n\n下記に依頼内容をまとめさせていただきました。\n\n\n-+＊+-\n\n\n▌依頼内容\nCoCシナリオ「私立花ヶ丘高校秘密倶楽部」の探索者の家紋。\n下記内容(画像資料含む)に概要以上のネタバレは含まれていません。\n\n\n▌モチーフ、希望について\n✦ 月がモチーフ（月の種類は問いません！）\n｜探索者自身は「芒に月」がモチーフですが、家柄自体はことわざの「月に叢雲」がモチーフです（「芒」は探索者の名前にかけているため)。\n✦ 雲が月の一部を隠す構図だと大変嬉しいです。\n｜\"霞\"は自陣にいらっしゃるので、できればそれ以外だと助かります…！\n✦ 形の希望はありません。お任せいたします！\n\n\n▌家柄について\n✦ 叢雲家 - HO8 芒に月\n探索者の父方の家系。\n近代に金融業を基盤として急成長した資産家一族であり、現在は病院や葬儀社/火葬場、福祉施設等に出資をしている。\n家風は徹底的な利益主義で功利主義。たとえ家族であろうとも、人やモノの有用性をなによりも重視する。そのため発展の裏には非合法な取引や自他で血塗られた歴史も存在する。\n生と死、利益と選別が象徴的な家柄。\n\n\n▌資料リンク\nなんらかの助力になればと思い、探索者の資料も添付させていただきます。必要でしたらご活用ください。\nhttps://drive.google.com/drive/folders/1Hiz9Nb2LCqU_Pf8YfIdpwe-S0O6iVwUf?usp=drive_link\n\n\n▌使用用途\n・個人鑑賞、自陣内での共有\n・完全個人用に印刷/グッズ製作\n・他依頼の際の資料として掲載\n・アイコン / ヘッダー / キャラクター駒 / 立ち絵etcに使用\n：使用時に色変更・変形・カット等の加工\n\n上記での使用を考えております。\n商用目的の販売等は一切行いません。\n\n-　+　＊　+　-\n\nご多忙かと思われますので、こちらはご縁がございましたらで構いません。よろしければご検討いただけますと幸甚です。\nこれからも佐藤白さまの活動を心より応援しております。\n\n以上、何卒よろしくお願いいたします。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 936308, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ツキシロ　ゴマお", "screen_name": "Ej20Impgbd", "avatar_url": "https://pbs.twimg.com/profile_images/1658301308510810112/Jn1UfJuz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3766064719/1740903304/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 1}, {"id": 1974005, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "紅月（べにづき）", "screen_name": "beniduki_p", "avatar_url": "https://pbs.twimg.com/profile_images/2103858765527384064/a7wppqN-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1166021731/1701506305/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable