gle.com/file/d/1zGd9HclBaOjldBt48IgCXUKRi8lVPE_K/view?usp=drivesdk\n\nポーズはお任せします。\n\n見切れず耳は付いたまま（アクセサリーは脱着可能なので私服の場合は変更していただいて構いません）腰～腿あたりまで描いて頂きたいです。\n\n頂いたイラストはツイートや配信、サムネイルとして利用させて頂きたいと考えております。\n背景をつけて頂ける場合は透過ver.も頂けるととっても助かります。\n\nよろしくお願い致します！\n\nhttps://drive.google.com/file/d/1kVq7rFCwYtBGBVj3POP1cy5VSu8-5QT9/view?usp=drivesdk", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@meiwari/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fa9c9304/uploads/origins/26ceebb1-2d40-4bc8-9199-15b8e17d749c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=696a290ef4f0d85899a118276a2fba99", "srcset": "https://si.imgix.net/fa9c9304/uploads/origins/26ceebb1-2d40-4bc8-9199-15b8e17d749c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=696a290ef4f0d85899a118276a2fba99, https://si.imgix.net/fa9c9304/uploads/origins/26ceebb1-2d40-4bc8-9199-15b8e17d749c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9886a6c22600455b46ccd4db726d3dd3 2x, https://si.imgix.net/fa9c9304/uploads/origins/26ceebb1-2d40-4bc8-9199-15b8e17d749c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=550eb0a38afb34df9553ba3f696538d7 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2491059, "client_id": 2555657, "nc": 1}, {"path": "/@meiwari/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2491059, "client_id": 1802753, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.n