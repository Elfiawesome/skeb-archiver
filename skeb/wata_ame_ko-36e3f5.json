ress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3482abff5a92cd5666a525e366b482ae", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2023783655576137728%2F32fvqr8g.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3482abff5a92cd5666a525e366b482ae, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2023783655576137728%2F32fvqr8g.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f84f29ceeefaf1421be88d0a38ff64f3 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2023783655576137728%2F32fvqr8g.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c2737ffe18ec6ae89edb133003ce08f 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/472c40af-0866-4eb8-814c-e4968049908f?response-content-disposition=inline&Expires=1782458631&Signature=bRapb10-1KU3L9LOUaInlbe6GyX8ZdkqtyzSbcWbHhXtHSZSaUzq4V1n-t8THrG~~rMjG0TOBGxkLCNux~QnT6O1GtiTjaol4MY9Up~D5ab20hBltv~kVDxuwefFyEkyL6DqoHf2NeWN64fP4b6N40EvYeoipWS5-5oOxMAq4GXPRKrkkVumn14pTL~~hn3MyLHQP1pmsVpDo8NqEPki6niE-c03A6NBwCJc9dKBVpY4Yy8GFN45K0tp2HadvHQ30qOPNWBzjCGLIx1EGrso5OMztzRTDNx5Ybdy7iE4nPOT27daAEaXG3leUEbr2L3buNPBMJCtos6SyIExOWWrMg__&Key-Pair-Id=K1GS3H53SEO647", "duration": 217, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2023783655576137728%2F32fvqr8g.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9715ffc8b7ca11a101b208d0531bde6", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2023783655576137728%2F32fvqr8g.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f9715ffc8b7ca11a101b208d0531bde6, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2023783655576137728%2F32fvqr8g.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f9f01013da951f322a2c15d852f19b3f 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2023783655576137728%2F32fvqr8g.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f6884e1fe526bfaddc06865ba78b59dc 3x"}, "body": "拝啓、ザラメ組へ。\n\n　こんあめ！　お元気ですか？　あめ子は元気だよ。お手紙では、初めましてだね。今ね、コロナ禍でお仕事がなかったり、逆に凄く忙しかったり、自粛疲れでしょんぼりしちゃってるひとが居るから、励ましたいな～って思って、お手紙書いてるんだ。\n\n　お仕事がなくなっちゃったひとへ。やまない雨はないから、公共・民間の支援とかも上手に使って、しぶとく生きていこうな。早まるんじゃねぇぞ！　特に日本の人間の皆さんは、お仕事がないと絶望する傾向があるらしいけど、命さえあれば、また働いたり楽しいことしたり出来るから！　いつかかかるデッカい虹を、あめ子と笑って見ような！　\n\n　今、凄く忙しいひとへ。コロナ禍で忙しいってことは、医療系か、インフラ系だよね。そういう人間の皆さんに、心ない言葉を浴びせるひとも居るって、あめ子きいたことある。でも、あめ子は分かってるよ。君が居なけりゃ、世界が回らないことを。今でも十分頑張ってるから、頑張りすぎないでね。応援してるよ。\n\n　自粛疲れで、しょんぼりしちゃってるひとへ。今までの趣味に、興味がなくなってきてはいないかな？　何もする気力がなくなって、楽しかったことが楽しくないと思えてきたら、危険サイン。眠れなくなるのは、心と身体が悲鳴を上げてる状態だから、眠れない日が続くようなら、心のお医者さんに相談してね。日本の人間の皆さんは、心のお医者さんに行くのを恥ずかしいと思うひともいるようだけど、インフルエンザになったらお医者さんにかかるでしょ？　それと一緒だから、何も恥じる必要はないんだよ。\n\n　あめ子はね、最近いいことがあったんだ。\n　(良いニュースを語ってください)\n\n　君は、何かいいことあった？　あめ子はいつも、ザラメ組に楽しく推して欲しいから、無理はしないでね。ギフトは、自分が美味しいご飯を食べてから！　でもお星様は五千兆個欲しいから、そこんとこよろしくな！\n\n　楽しい配信でみんなにお返ししていくから、常連さんも久しぶりのひとも初めましてのひとも、ぜひ遊びに来てね。初めましてのひとには、ザラメ組がわたあめを出してくれるよ！　いつでも待ってるから、あめ子の配信を観て元気出してね。\n\n　それじゃ、お身体には、くれぐれも気を付けて。生きてコロナ禍を乗り切ろうな！\n\n2021年○月○日(実際の日付)　わたあめ子より\n(語尾などの改変は歓迎です)", "nc": 17, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@wata_ame_ko/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 62962, "client_id": 136926, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/faaf5534/requests/131387_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53cd56262a6aedabdce655a416d998df", "srcset": "https://si.imgix.net/faaf5534/requests/131387_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53cd56262a6aedabdce655a416d998df, https://s