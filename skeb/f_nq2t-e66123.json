たします。\n\n[使用用途]\nTwitterやYoutube等でサムネイルなどのSNS運用、グッズ等で使用させていただきたいです。\nその為、許可をいただける場合、承認をしていただければと思います。\nまた、キャラクターと背景とサインで分けていただけないでしょうか。\n\n[容姿]\n服装・容姿はX固定(@GiGi_Nereto)を確認お願い致します。\n\n[構図]\nギギねれとが魅力的に映る表情、衣装、ポーズ全てお任せいたします！\nポーズはお任せ致します。アイコンやサムネ映えする構図だととても嬉しいです！\n\n[サイズ]\n特に指定はございません。\n\n[備考]\nもし可能でしたら表情差分も作成して頂けますと幸いです。\n\n\n以上です。\n宜しくお願い致します。\n\nhttps://www.youtube.com/@giginereto\n\nhttps://drive.google.com/drive/folders/1HnZ29h5WJu5LH2wku9Rvf5K3ACnhd8wY?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@f_nq2t/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3646788, "client_id": 3314231, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/29df372f/uploads/origins/4693fd1e-03b5-412b-b53e-47be4d48c2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45893d2171e272166d04eeeaf3aad75f", "srcset": "https://si.imgix.net/29df372f/uploads/origins/4693fd1e-03b5-412b-b53e-47be4d48c2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45893d2171e272166d04eeeaf3aad75f, https://si.imgix.net/29df372f/uploads/origins/4693fd1e-03b5-412b-b53e-47be4d48c2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9e43a6e5488620a4fa8ed935b23059a 2x, https://si.imgix.net/29df372f/uploads/origins/4693fd1e-03b5-412b-b53e-47be4d48c2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87568423578661a1be4477282636f20e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/29df372f/uploads/origins/4693fd1e-03b5-412b-b53e-47be4d48c2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d2ff3f2df87dedee8d00bd8d202425c6", "srcset": "https://si.imgix.net/29df372f/uploads/origins/4693fd1e-03b5-412b-b53e-47be4d48c2b7?bg=%23fff&auto=format%2Ccompress&fm=webp&