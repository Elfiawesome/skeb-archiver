, https://si.imgix.net/baa06fb3/uploads/origins/1b84266a-a82c-4c17-89f1-a1d65a7fbe88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4376f66436516e90e90e8d6a66fcb23e 2x, https://si.imgix.net/baa06fb3/uploads/origins/1b84266a-a82c-4c17-89f1-a1d65a7fbe88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d13736c9c0187a96c3c59380d6b4372 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/baa06fb3/uploads/origins/1b84266a-a82c-4c17-89f1-a1d65a7fbe88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31b57fe5fae5bddb046516330040b6ac", "srcset": "https://si.imgix.net/baa06fb3/uploads/origins/1b84266a-a82c-4c17-89f1-a1d65a7fbe88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=31b57fe5fae5bddb046516330040b6ac, https://si.imgix.net/baa06fb3/uploads/origins/1b84266a-a82c-4c17-89f1-a1d65a7fbe88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=771f079d0c3fafc57b28ff1527ac0f4c 2x, https://si.imgix.net/baa06fb3/uploads/origins/1b84266a-a82c-4c17-89f1-a1d65a7fbe88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bba7ea5a102603a8381317826ff92c0d 3x"}, "body": "人生ではじめての依頼させていただきますはじめてなので不備や失礼があったらすみません\nちゃよ茶さんのイラストとキャラデザがめっちゃすきなので依頼させていただきました\n今回はうちの子のシロノちゃんの新衣装デザインの三面図などの設定資料をお願いしたいです\n\n昔描いた三面図\nhttps://x.com/sirohisame/status/1023373707056635904?s=46&t=LHIRVs4vVorvZVAVyAN9GQ\n\n・新衣装の三面図(形が複雑なアクセなどは別視点の詳細な資料・使った色もまとめてもらえるとありがたいです)\n・上着は白いロングコートでカッコいいデザインで裏地・差し色は青系多めで他の色はおまかせします(裏地はチェック柄)\n・氷モチーフのアクセサリーや小物\n・靴は服とあうデザイン\n・上着脱いだバージョンは黒多めで下乳とお腹が出ているエッチでかわいいデザイン\n・髪飾りは耳についてるのは少し強化して髪縛ってるのは新しいデザインにしてください\n\n・新衣装のミニシロノちゃん(2頭身)(Xのアイコンかヘッダーに使用させていただきたいと思ってます)\n・新衣装のシロノちゃんの一枚絵(構図はおまかせします・上着ありかなしはおまかせ)\n\n描いていただいたイラストはSNSでうちの子の宣伝に使用させていただきます\n\nキャラと背景別にお願いします\n\nもしちゃよ茶先生のサインがあるならほしいです\n\n結構な無茶振りで作業量が多くて申し訳ないので金額は多めにしてますが、それでも金額と作業量が見合わないと思ったら一枚絵なしかそれともラフな感じにしてください\n急いでないのでゆっくりで大丈夫です\n難しい依頼なら遠慮なく断ってください\nご検討よろしくお願いします", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 734432, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "Birne(ビルネ)", "screen_name": "birne_illust", "avatar_url": "https://pbs.twimg.com/profile_images/2055487165698899968/0BxuRm2c.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1263895635989639169/1778548010/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 1233667, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "和匠", "screen_name": "minekazuna", "avatar_url": "https://pbs.twimg.com/profile_images/1607274279128944642/27o06ABU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1289452454489124864/1658274059/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 17}, {"id": 2348583, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "junya🐙👯‍♀️", "screen_name": "junyag", "avatar_url": "https://pbs.twimg.com/profile_images/830816851592482816/_cFIwaxF.jpg", "header_url": "https://pbs.twimg.com/profile_banners/124762120/1766929764/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc