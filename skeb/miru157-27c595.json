ubeでのサムネイル、配信内での画面配置、歌ってみた動画など\n\n  【その他】  \n\n個人で依頼する形になりますが、私は所属する団体があり、個人勢Vtuberではありません。\n\nご検討のほどよろしくお願いします。\n\nhttps://drive.google.com/file/d/1JdGZdbsXWa3YzfzQ2yvHHHKOUOqOh49x/view?usp=drivesdk\n\nhttps://drive.google.com/file/d/1JdGZdbsXWa3YzfzQ2yvHHHKOUOqOh49x/view?usp=drivesdk", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 9832, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "しけた🔞", "screen_name": "siketapa12ur1", "avatar_url": "https://pbs.twimg.com/profile_images/1435576323078955019/EVjCDnAj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/726957003935883265/1631103042/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 1704529, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "猗魅神 乃漓", "screen_name": "ma_minokami", "avatar_url": "https://pbs.twimg.com/profile_images/1314924238353002496/bmqZJhNS.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 1903247, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ぬめりちゃん", "screen_name": "nu_me_ri", "avatar_url": "https://pbs.twimg.com/profile_images/1441307452645933057/q8BcnnCX.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1441307128950497290/1632500124/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all