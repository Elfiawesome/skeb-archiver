6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0f115bb84e7d1dd83cddb8d29d2ad7ff 3x"}, "body": "こんにちは茶駄乾さん。\n自作キャラクターの明るい茶髪の褐色肌美少女の\n水着イラストをお願いします。\n\n●キャラクター\n明るい赤茶色の長髪に、童顔で活発な顔つき。\n赤い瞳。 明るめの褐色肌。16歳くらい。\n身長155cm程度で細身のIカップ程度の胸。\n先日に茶駄乾さんが描かれていた\nhttps://www.pixiv.net/artworks/118162735\nと同じか、さらに大きい位に。\n\n勝気で自信満々な性格 。\n\n●水着\n白色レース柄の水着セット。\n水着トップスは白い肩紐なしのデザインで\n資料URLのブラジャー参考に、\n胸の谷間を完全に開けて、細い紐でちょっと繋いだ感じに。\nhttp://t-walker.jp/illust/product/tw_c/014/c01457_pzen_1.jpg\n\n下には上と同系統デザインの白ビキニボトム。\n頭には白いキャスケット帽子。\n詳細な各デザインはお任せ。\n\n●ポーズ\n片手で頭の帽子を押さえつつ\n堂々と胸を張って立っているポーズ。\n両目は開いて口は閉じ、\n「ふふん♪」と笑ってるような、自慢げな笑顔。\n\n溢れそうな、大きな胸が見栄えするように！\nイラストの最重要ポイントです！\n\nキャラクターの頭から太ももまでをイラスト枠内に入れて描いて下さい。\n背景は特になくてOK。エフェクト程度で。\nイラストサイズは大きく、PNG形式でも納品頂けると助かります。\n\n不明点はお任せ！\n\nhttp://t-walker.jp/illust/product/tw_c/014/f_c01457_pdt_1.jpg", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 67784, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Morikawa@skeb800yen~", "screen_name": "morikawa0208", "avatar_url": "https://pbs.twimg.com/profile_images/1963143143584567296/3f8lWEro.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1261229671/1466741716/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 14, "skills": [{"genre": "art"}], "nc": 129}, {"id": 103457, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "こなぎ伊砂", "screen_name": "konagi_isa", "avatar_url": "https://pbs.twimg.com/profile_images/1209763827375427585/czK7vB4h.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1923365844/1588174903/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": n