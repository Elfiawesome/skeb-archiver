et/01bf56e1/uploads/origins/2323128c-34b0-47b1-b16d-d64f610432cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52ac8a65943a89ad710d939fc03f0def", "srcset": "https://si.imgix.net/01bf56e1/uploads/origins/2323128c-34b0-47b1-b16d-d64f610432cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=52ac8a65943a89ad710d939fc03f0def, https://si.imgix.net/01bf56e1/uploads/origins/2323128c-34b0-47b1-b16d-d64f610432cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=52031720bf2faf098fd257adb3771f47 2x, https://si.imgix.net/01bf56e1/uploads/origins/2323128c-34b0-47b1-b16d-d64f610432cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6356c874a3569367c609c5c7abb195c6 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/01bf56e1/uploads/origins/2323128c-34b0-47b1-b16d-d64f610432cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d981eed3fd50fa09b4ccc1214596f577", "srcset": "https://si.imgix.net/01bf56e1/uploads/origins/2323128c-34b0-47b1-b16d-d64f610432cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d981eed3fd50fa09b4ccc1214596f577, https://si.imgix.net/01bf56e1/uploads/origins/2323128c-34b0-47b1-b16d-d64f610432cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d4cde44a34f0e95bea8c4c1989e34435 2x, https://si.imgix.net/01bf56e1/uploads/origins/2323128c-34b0-47b1-b16d-d64f610432cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=060e36db1527af8686768357902f2261 3x"}, "body": "初めまして。\nふたなりボイロ達のイラストがとてもエッチで素晴らしく、もっと様々なイラストを見たいと思い依頼します。\n\nキャラクター\n『月読アイ』『結月ゆかり』\n\nシチュエーション\nふたなりゆかりんとアイちゃん先輩のおちんぽ比べ\n\n20cm程の巨根で調子に乗ってるゆかりんが30cm超えの長さも太さも玉の大きさも圧倒的な巨根のアイちゃん先輩にわからされるシチュ\n\n2人が向かい合っておちんぽ比べをしている。\n身長差があるのに、ゆかりんの亀頭よりアイちゃん先輩の亀頭の方が高い位置にあるみたいな感じだと嬉しいです。\n射精量対決でもアイちゃん先輩が大量射精で圧倒してほしいです。\n\nその他細かい構図や差分などはお任せします。\n\nそれではどうかよろしくお願いします。", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@siran_onna/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3943779, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5d66be61/uploads/origins/5c368261-8ffb-4843-9765-317f7becfcb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a3c4906a9e8666db84ecd174858343e", "srcset": "https://si.imgix.net/5d66be61/uploads/origins/5c368261-8ffb-4843-9765-317f7becfcb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a3c4906a9e8666db84ecd174858343e, https://si.imgix.net/5d66be61/uploads/origins/5c368261-8ffb-4843-9765-317f7becfcb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=67e5bf14b28729049f610e90962929f1 2x, https://si.imgix.net/5d66be61/uploads/origins/5c368261-8ffb-4843-9765-317f7becfcb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e4c9a889b1ee67677a1e4c7e72166249 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5d66be61/uploads/origins/5c368261-8ffb-4843-9765-317f7becfcb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e623ac6d229307a2b1d4cb5022d9173d", "srcset": "https://si.imgix.net/5d66be61/uploads/origins/5c368261-8ffb-4843-9765-317f7becfcb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e623ac6d229307a2b1d4cb5022d9173d, https://si.imgix.net/5d66be61/uploads/origins/5c368261-8ffb-4843-9765-317f7becfcb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=be6ab2ef8ae8021f348bb0258ff98f63 2x, https://si.imgix.net/5d66be61/uploads/origins/5c368261-8ffb-4843-9765-317f7becfcb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=98172fa7106fe200e059959111166932 3x"}, "body": "匿名でのリクエスト失礼します\n\n【キャラクター】\n東北きりたん\nタンゲコトエ\n\n【概要】\n●設定\n①タンゲコトエ→ふたなり（大きめ）/玉あり/陰毛\n②東北きりたん→噛み跡＆爪跡（顔以外）\n\n●シチュエーション\nキスハメ（いちゃラブ路線でお願いします）\n\nご検討いただけますと幸いです", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@siran_onna/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3943779, "client_id": 415622, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/930891f6/uploads/origins/ec4eef06-097e-4ed7-9e5d-49fc9ba31cf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77f65c9eb2b39baf51a2d0425e837dfc", "srcset": "https://si.imgix.net/930891f6/uploads/origins/ec4eef06-097e-4ed7-9e5d-49fc9ba31cf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77f65c9eb2b39baf51a2d0425e837dfc, https://si.imgix.net/930891f6/uploads/origins/ec4eef06-097e-4ed7-9e5d-49fc9ba31cf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ad5c51f644e7d8eaea5bce7be6b5b22 2x, https://si.imgix.net/930891f6/uploads/origins/ec4eef06-097e-4ed7-9e5d-49fc9ba31cf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f60ba9467c0e60297a19fc0900188daa 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/930891f6/uploads/origins/ec4eef06-097e-4ed7-9e5d-49fc9ba31cf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba181cc67e30e9cd4fb5cc8f020a8761", "srcset": "https://si.imgix.net/930891f6/uploads/origins/ec4eef06-097e-4ed7-9e5d-49fc9ba31cf2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ba181cc67e30e9cd4fb5cc8f020a8761, https://si.imgix.net/930891f6/uploads/origins/ec4eef06-097e-4ed7-9e5d-49fc9ba31cf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6a3938e93787680df05a42fe3f7c841a 2x, https://si.imgix.net/930891f6/uploads/origins/ec4eef06-097e-4ed7-9e5d-49fc9ba31cf2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=788945f3bde40af07add6fbacf73f83e 3x"}, "body": "こんにちは。ミナトマキです。\nイラストが気になって、うちの子を描いてもらいたく、お声をかけさせていただきました。\n今回描いていただく子の資料\n（うちの子の名前は湊川澪さん）\nhttps://x.com/Kokuya_MINATO/status/1707021275422662920?s=20\n\nメイン：玉付きふたなりの澪ちゃん（胸はすごく大きく描いても問題ありません）\n\n竿の形状は、色白肌で皮が完全に剥けていて、長さは爆根クラス（胸まで届く長さ）、太さは根元より先の方が太い　亀頭も少し大きめでお願いします。\n\n玉の形状は、つやがあって、ハリのある巨玉\nあと、竿や玉に毛、また陰毛が生えてない状態でお願いします。\n\nシチュエーションは、大きすぎて先っぽしか入らないオナホで、遊んでいる所でお願いします。可能でありましたら、いっぱい出しちゃった差分もあるとありがたいです。\n\nよろしくお願いいたします。", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@siran_onna/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3943779, "client_id": 333632, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cae12418/uploads/origins/ac3ce27e-38b9-448f-a72a-5ff73e949cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec203388171c172516d835f962b0c2db", "srcset": "https://si.imgix.net/cae12418/uploads/origins/ac3ce27e-38b9-448f-a72a-5ff73e949cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ec203388171c172516d835f962b0c2db, https://si.imgix.net/cae12418/uploads/origins/ac3ce27e-38b9-448f-a72a-5ff73e949cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4f3b9010f80aa4657f3af689e29f3438 2x, https://si.imgix.net/cae12418/uploads/origins/ac3ce27e-38b9-448f-a72a-5ff73e949cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f615815c2e78ec991b1e9e5a20ddd3c 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cae12418/uploads/origins/ac3ce27e-38b9-448f-a72a-5ff73e949cc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=2