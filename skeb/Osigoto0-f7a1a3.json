ルメ資料にあるように描きやすいように省略化しても大丈夫です。\n\n使用用途としては個人間での共有、鑑賞目的としてのグッズ制作、SNSのアイコンやヘッダーとしての使用を目的としております。 可能であればPSDでの差分があると助かります。  ぜひ検討をお願いします。\n\nhttps://drive.google.com/drive/folders/1P3DEqpuTKT2QeFR7ho9Yl_DWcbfzUVEH", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Osigoto0/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4d8880dc/uploads/origins/3f057f04-d560-4840-88da-6826d583d753?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0edf90f8ac72169615e371281804af82", "srcset": "https://si.imgix.net/4d8880dc/uploads/origins/3f057f04-d560-4840-88da-6826d583d753?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0edf90f8ac72169615e371281804af82, https://si.imgix.net/4d8880dc/uploads/origins/3f057f04-d560-4840-88da-6826d583d753?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bdc43cfcf45dda6ce117f4d6649fe18f 2x, https://si.imgix.net/4d8880dc/uploads/origins/3f057f04-d560-4840-88da-6826d583d753?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f3cf644fc1ccadd5c3d0e56c13ae4909 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3345081, "client_id": 2732701, "nc": 128}, {"path": "/@Osigoto0/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3345081, "client_id": 3524955, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1bee680f/uploads/origins/2f1a74e2-ee31-4893-a861-9b82498b3d77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top