リオの探索者（キャラクター）である男性キャラ2名を描いていただきたいです。\n\n 構図についてはお任せとさせていただきたいです。 匿名お茶様が楽しく、描きやすいように描いてくださったら幸いです！\n\n \n【使用用途】 \n・相方への共有 \n・主にSNSでのアイコン、ヘッダー等 \n・非商用範囲内での個人利用  \n\n\n金額が不足しておりましたら、お手数ですが再送要請をいただけますと幸いです。 お忙しいところ恐縮ではございますが、ご縁がありましたら何とぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1adR2X6eMG5xSZxW5-ZTyPj44atcbjp9g", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Osigoto0/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3345081, "client_id": 3102924, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c147427e/uploads/origins/1f6ec2f6-1a44-4b2a-9cfa-7c4f9c09171b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ceb3833985c0b9de7cb72fe548fcce95", "srcset": "https://si.imgix.net/c147427e/uploads/origins/1f6ec2f6-1a44-4b2a-9cfa-7c4f9c09171b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ceb3833985c0b9de7cb72fe548fcce95, https://si.imgix.net/c147427e/uploads/origins/1f6ec2f6-1a44-4b2a-9cfa-7c4f9c09171b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c36f3f22b094e5a1bba1f6047ab3a77 2x, https://si.imgix.net/c147427e/uploads/origins/1f6ec2f6-1a44-4b2a-9cfa-7c4f9c09171b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b57183da88b699e3ef7321556dc6dd4d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c147427e/uploads/origins/1f6ec2f6-1a44-4b2a-9cfa-7c4f9c09171b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ca7117ae263eca81a891cf66fbab0d9", "srcset": "https://si.imgix.net/c147427e/uploads/origins/1f6ec2f6-1a44-4b2a-9cfa-7c4f9c09171b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ca7117ae263eca81a891cf66fbab0d9, https://si.imgix.net/c147427e/uploads/origins/1f6ec2f6-1a44-4b2a-9cfa-7c