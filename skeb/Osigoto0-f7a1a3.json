count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Osigoto0/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3345081, "client_id": 3102924, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c147427e/uploads/origins/1f6ec2f6-1a44-4b2a-9cfa-7c4f9c09171b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ceb3833985c0b9de7cb72fe548fcce95", "srcset": "https://si.imgix.net/c147427e/uploads/origins/1f6ec2f6-1a44-4b2a-9cfa-7c4f9c09171b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ceb3833985c0b9de7cb72fe548fcce95, https://si.imgix.net/c147427e/uploads/origins/1f6ec2f6-1a44-4b2a-9cfa-7c4f9c09171b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c36f3f22b094e5a1bba1f6047ab3a77 2x, https://si.imgix.net/c147427e/uploads/origins/1f6ec2f6-1a44-4b2a-9cfa-7c4f9c09171b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b57183da88b699e3ef7321556dc6dd4d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c147427e/uploads/origins/1f6ec2f6-1a44-4b2a-9cfa-7c4f9c09171b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ca7117ae263eca81a891cf66fbab0d9", "srcset": "https://si.imgix.net/c147427e/uploads/origins/1f6ec2f6-1a44-4b2a-9cfa-7c4f9c09171b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ca7117ae263eca81a891cf66fbab0d9, https://si.imgix.net/c147427e/uploads/origins/1f6ec2f6-1a44-4b2a-9cfa-7c4f9c09171b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=20f0437d8db837a9928f5819dea61505 2x, https://si.imgix.net/c147427e/uploads/origins/1f6ec2f6-1a44-4b2a-9cfa-7c4f9c09171b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=423be890a16d2a3d6408dc0efa3f448e 3x"}, "body": "匿名お茶様、お世話になっております。\nXの方でフォローさせて頂いております、いみのすけです。\n以前よりツイートされていらっしゃった自陣FAのご依頼が開始されたら、是非お願いしたいと思っておりましたので依頼分を書かせて頂いております✨\n\n依頼内容はCOC「プルガトリウムの夜」の自陣FAイラストになります。\nskeb募集ツイートでされていたような、自陣2人の可愛らしいFAをお願いしたく思います。\n(該当ツイートのサンプル1枚目)\n\n下記に探索者たちのプロフィール詳細と参考画像を記載させていただきます。\n\n\n▼キャラクターデザインの参考資料URL\nhttps://drive.google.com/drive/folders/13mkyBxptMk5UZHivZfaZU8doHFybEHOq?usp=drive_link\n\n▼HO1(自探)\n名前：鮫島 煙司(さめじま えんじ)\n職業：警視庁捜査一課 班長\n年齢：30代後半\n性別：男\n身長：185㎝\nイメージ絵文字：🦈\n▼外見的特徴\n年齢よりもやや老け顔の男性。目の下と口持ちにシワ有。顎鬚と口元にも髭有。\n・眉、目の形：サングラス、ツリ眉、タレ目よりな伏目(平行)、瞳の色はグレー\n・体格：高STRな為筋肉質ではあるが、腰は細目(細マッチョ)\n▼性格\n喫煙者。飄々、ヘラヘラとした態度と軽薄な言動が特徴で、若い女性相手には距離感のおかしい発言やスキンシップも多い。\n周囲からは「セクハラ親父」と呆れられることもしばしば。\nしかし捜査能力は高く、現場勘にも優れているため、なんだかんだ信頼はされているタイプ。\n面倒見も悪くなく、後輩のことは放っておけない。軽口を叩きながらも危険な場面では必ず前に出る。\n\n\n▼HO2(相方様)\n名前：稚丹 頌子(いなあか しょうこ)\n職業：警視庁捜査一課 新人刑事\n年齢：20代前半\n性別：女\n身長：153㎝\nイメージ絵文字：💭\n▼外見的特徴\n美女(APP16)、年齢よりも少し子供っぽい印象のある女性。左右に個性的なヘアピンをしており、足元まであるロングヘア。\n・眉、目の形：タレ目、ツリ眉、白色のまつ毛、瞳の色は青\n・体格：小柄でありスリム、大き目な胸\n▼性格\n感情が表情に出やすく、よく言えば素直であり、悪く言えば図々しい女の子。\n周りに初手威嚇を振りまく一匹狼であり、なんでも自分一人で解決しようとする。\nが、メンタル面はそこまで強くなく、怖いものは怖いし、泣くときは泣く。\n\n▼二人の関係性\n「年の差犬猿バディ」で、普段から「ガキ」「おじさん」とヤイヤイ言い合っている仲ではありますが、シナリオ本編やその後の継続を経て、現在は互いがかけがえのない存在へと変化していっている最中です。(そう遠くないうちに恋仲にはなるかと…)\nなんだかんだ捜査中も背中を預けあえる仲ではあり、くだらない話をしてはバカ笑いしているような場面もみられます。\nそんな2人を表情豊か且つ自陣の雰囲気表現が素敵な匿名お茶様のイラストで見られると とても嬉しく思います🌸😌\n\n▼普段の会話例\n「あたし、可愛いでしょッ？♡」「はいはい、可愛いよ(本心)」\n「お前はそんなんだから、いつまで経ってもガキなんだよ！」「おじさんのクセに生意気！」\n\n\n金額が足りない場合はお手数ですが再送リクエストのほどをお願い致します。\n以上となります、どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/13mkyBxptMk5UZHivZfaZU8doHFybEHOq?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Osigoto0/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3345081, "client_id": 2973087, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1cd7ccdc/uploads/origins/61eed388-e272-48df-bb45-148c7c187043?bg=%23fff&auto=format%2Ccompress&f