56\u3044\u307e\u3057\u305f\u3089\u7533\u3057\u8a33\u3054\u3056\u3044\u307e\u305b\u3093\u3002\n\n\u4e0b\u8a18\u8cc7\u6599\u30ea\u30f3\u30af\u5148\u3067\u306f\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u6982\u8981\u3084\u7279\u5fb4\u3092\u8a18\u8f09\u3057\u3066\u304a\u308a\u307e\u3059\u3002\u753b\u50cf\u7b49\u3082\u8cbc\u3063\u3066\u3042\u308a\u307e\u3059\u306e\u3067\u3054\u78ba\u8a8d\u9802\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u3059\u3002\n\u307e\u305f\u3001\u202c\u5206\u304b\u3089\u306a\u3044\u90e8\u5206\u3084\u7d30\u90e8\u306f\u7c21\u7565\u5316\u3057\u3066\u9802\u3044\u3066\u5927\u4e08\u592b\u3067\u3059\ud83d\udc4c\ud83c\udffb\u00b4-\n\n\u69cb\u56f3\u306b\u3064\u3044\u3066\u306f\u5973\u30b3\u30c6\u304c\u76f8\u624b\u306b\u304f\u3063\u3064\u304f\u30a4\u30e1\u30fc\u30b8\u3067\u304a\u9858\u3044\u3057\u305f\u3044\u3068\u601d\u3046\u306e\u3067\u3059\u304c\u3001\u30ea\u30f3\u30af\u5185\u306b\u53c2\u8003\u69cb\u56f3(\u5168\u3066\u7b49\u8eab\u69cb\u56f3\u3067\u3059\u304c\u96f0\u56f2\u6c17\u304c\u63b4\u3081\u308b\u304b\u3068\u601d\u308f\u308c\u307e\u3059\u3002\u53c2\u8003\u306b\u306a\u3089\u306a\u304b\u3063\u305f\u3089\u7533\u3057\u8a33\u306a\u3044\u3067\u3059\ud83d\udca6)\u3082\u8a18\u8f09\u3057\u3066\u304a\u308a\u307e\u3059\u306e\u3067\u3054\u78ba\u8a8d\u9802\u3051\u307e\u3059\u3068\u5e78\u3044\u3067\u3059\u3002\n\n\n\u4f7f\u7528\u7528\u9014\u306f\n\u3007 X\u3067\u306e\u30a2\u30a4\u30b3\u30f3\u3078\u306e\u4f7f\u7528\n\u3007 X\u30a2\u30ab\u30a6\u30f3\u30c8(\u5b8c\u5168\u975e\u516c\u958b/\u6c38\u4e45\u9375)\u3067\u306e\u6295\u7a3f\n\u3092\u4e88\u5b9a\u3057\u3066\u304a\u308a\u307e\u3059\u3002\n\n\u3082\u3057\u53ef\u80fd\u3067\u3042\u308c\u3070\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u307f\u306e\u900f\u904e\u30c7\u30fc\u30bf\u3082\u9802\u3051\u307e\u3057\u305f\u3089\u5e78\u3044\u3067\u3059(\u1421\u1d17 \u032b \u1d17\u1421)\n\n\u9577\u3005\u3068\u5931\u793c\u3044\u305f\u3057\u307e\u3057\u305f(>_< ;)\u4f55\u304b\u4e0d\u5099\u7b49\u3054\u3056\u3044\u307e\u3057\u3