04-b0ab-978c41627bd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f8d9e6f2d309408972c840dbbb44687", "srcset": "https://si.imgix.net/32539bfc/uploads/origins/4c17bc08-ab7e-4d04-b0ab-978c41627bd3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f8d9e6f2d309408972c840dbbb44687, https://si.imgix.net/32539bfc/uploads/origins/4c17bc08-ab7e-4d04-b0ab-978c41627bd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fff891df6bddb5bfc9c599fed9595b68 2x, https://si.imgix.net/32539bfc/uploads/origins/4c17bc08-ab7e-4d04-b0ab-978c41627bd3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a556fb092efd4689a0df56aecf80ebc6 3x"}, "body": "こんばんは\n以前は大変かわいい氷沼悠理さんをありがとうございました\n再度彼女をお願い致します\nhttp://www.getchu.com/sp/soft.phtml?id=1190\nhttps://drive.google.com/drive/folders/1IwML5k39fvT-axqqDQd9sn5Ym7GOIG2q\n元お嬢様で常時敬語、読書が趣味のおっとりとした子です\n華奢で胸は僅かに膨みがある程度(AAカップ)\n\n\n・服装等\n制服+膝下丈の黒ハイソックス\n\n\n・シチュ等\n片手で髪を軽く抑えながらやや屈み込み(私を)笑顔で優しく見下ろしている姿(私の主観視点のイメージ)\nスカートの中が見えない程度のローアングルで\n細いふとももとその隙間の空間が堪能できると助かります\n\n\n何卒ご検討下さい。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MeRuRuu2008/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3765007, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/590c8914/uploads/origins/282a9ee8-fa9b-4680-858c-7958e9dc94cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9806309cab9610afd5f3c86b1d09a5ae", "srcset": "https://si.imgix.net/590c8914/uploads/origins/282a9ee8-fa9b-4680-858c-7958e9dc94cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9806309cab9610afd5f3c86b1d09a5ae, https://si.imgix.net/590c8914/uploads/origins/282a9ee8-fa9b-4680-858c-7958e9dc94cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61aa8059af4eac383997ce2624dc7e2e 2x, https://si.imgix.net/590c8914/uploads/origins/282a9ee8-fa9b-4680-858c-7958e9dc94cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=47b11a4cb185e8990f010fa3c53a8bdf 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/590c8914/uploads/origins/282a9ee8-fa9b-4680-858c-7958e9dc94cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a48b10105aba4e51e623cc56197368d4", "srcset": "https://si.imgix.net/590c8914/uploads/origins/282a9ee8-fa9b-4680-858c-7958e9dc94cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a48b10105aba4e51e623cc56197368d4, https://si.imgix.net/590c8914/uploads/origins/282a9ee8-fa9b-4680-858c-7958e9dc94cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=449e8f86a393f5b21fab1493e68df103 2x, https://si.imgix.net/590c8914/uploads/origins/282a9ee8-fa9b-4680-858c-7958e9dc94cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=08974c8ee97362d96212d3e318f041b1 3x"}, "body": "はじめまして、匿名でのリクエスト失礼いたします。\n新着で作品をお見掛けし、柔らかな空気が感じられる画風に惹かれリクエストさせていただきたく思いました。\n\nおそらくご存じない作品かと思いますので恐縮ですが、よろしければ「そわそわDrawing」という漫画のキャラ「千暁萌葱」のイラストをお願いしたいです。\n作品およびキャラについては下記URLより各巻の無料立ち読みやwikiの記事をご参照いただければと思います。\n\nシチュエーションや構図等につきましてはお任せいたします。\n服装は制服だと嬉しいですが、描きやすいシチュエーション等があればそれに合わせて変更していただいても構いません。\n漫画では肌色多めのシーンも多いキャラなのですが、イラストはあまりそれに囚われず全年齢向けの内容で自由に描いていただければと思います。\n\nジャンル外かつ曖昧なリクエストで申し訳ありませんが、ご検討いただければ幸いです。よろしくお願いいたします。\n\n無料立ち読み　https://www.cmoa.jp/title/86648\n作品解説記事　https://w.atwiki.jp/aniwotawiki/pages/56067.html", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MeRuRuu2008/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3765007, "client_id": 720685, "vtt_url": null, "thumbnail_image_urls": {"src": "https:/