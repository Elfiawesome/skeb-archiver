=200&s=82968587de59bc91c3262e8f8edbb64a, https://si.imgix.net/1e7d4623/uploads/origins/e1499b43-320b-47fe-b8da-b1c8439815e8?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7d30c10d186f45f9c77252ffbb95f6e9 2x, https://si.imgix.net/1e7d4623/uploads/origins/e1499b43-320b-47fe-b8da-b1c8439815e8?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=18364b06295c2ffabea077452cc1a1a8 3x"}, "body": "こんにちは！\nお会いできて非常に嬉しいです！\nあなたの作品がとても気に入っていますので、私のオリジナルキャラクター（OC）のイラストを描いていただけないでしょうか？\n \nOCの設定は以下の通りです：\n・性別不明（ノンバイナリー）\n・フラットな胸\n・スリムな少年体型\n・服装案が複数ありますので、あなたの好きなデザインで創作していただいても構いません！\n \n使用用途：\n個人での鑑賞、アイコン、壁紙等\n \n希望条件：\n・ファイル形式：PSDファイル\n・背景がある場合、キャラクターのみの透過背景ファイルも併せてお願いできますか？\n \nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/13x9ayMSsWPVwsxB884nsif152k20optB\n\nhttps://drive.google.com/drive/folders/13x9ayMSsWPVwsxB884nsif152k20optB", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@24zinineyou/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3159122, "client_id": 3354959, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/953e8e15/uploads/origins/d64974d3-614f-4773-ae1a-934848857e69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3535f3214089a777a5e2c03f2ad97b91", "srcset": "https://si.imgix.net/953e8e15/uploads/origins/d64974d3-614f-4773-ae1a-934848857e69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3535f3214089a777a5e2c03f2ad97b91, https://si.imgix.net/953e8e15/uploads/origins/d64974d3-614f-4773-ae1a-934848857e69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe559eaa011d75ff1513b924582cb17d 2x, https://si.imgix.net/953e8e15/uploads/origins/d64974d3-614f-4773-ae1a-934848857e69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7b1c03d0f2afac695bc83ac931cb6d72 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/953e8e15/uploads/origins/d64974d3-614f-4773-ae1a-934848857e69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=901a804df3f7b7aa21f0c1b71854c84d", "srcset": "https://si.imgix.net/953e8e15/uploads/origins/d64974d3-614f-4773-ae1a-934848857e69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=901a804df3f7b7aa21f0c1b71854c84d, https://si.imgix.net/953e8e15/uploads/origins/d64974d3-614f-4773-ae1a-934848857e69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=82b7d33a73ac4fe7eac72a4f9d577e34 2x, https://si.imgix.net/953e8e15/uploads/origins/d64974d3-614f-4773-ae1a-934848857e69?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c15ffbb71c1aad0a89ce803f7c93b776 3x"}, "body": "初めまして。新着にて雨野みるは様のイラストをお見掛けしご依頼に参りました。雨野みるは様が描くかわいく暖かみのあるイラストが大好きです！この度はよろしくお願い致します。\n\nまた、金額や資料不足等があればお手数ですが再送していただければと思います。\n\n今回ご依頼したい内容は以下のOC(TRPG探索者)のイラストになります。\n\n\nーーーーーーーーーーーーーーーーーーーー\n\n\n▼①名前：アキラ・L・オーバーション\n\n▼特徴：左右の目の下と左耳にホクロ、棘をイメージしたツインテール、ピアスは左耳に2つのみ(目の色と同じ藍色)\n\n▼性格：自信家であり傲慢、王様気質、お人好し、積極的、ツン(デレ)\n（②に対して）意地悪をしたい、可愛がりたい\n\n▼備考：女性。24歳ドイツ人。三白眼、身長は166cm(ヒール込み)、立ち絵にいるペンギンは①のペットです。\n\n▼備考2：作り笑顔が下手。「笑って」など言われると上手く笑えない(自然に出た時の笑い方は眉が下がり柔らかめ)\n\n▼②名前：カツコレ・エシマ\n\n▼特徴：左目の目尻から頬にかけて傷、ガタイが良い（身長186cm、体重80kg）\n\n▼性格：武士気質、実直、負けず嫌い、好戦的、自信家（傲慢）、やや天然、寡黙\n（①に対して）忠誠心が高い、犬、年下気質\n\n▼備考：男性。21歳日本人。\n\n【2人の関係】\n主従関係であり、恋人同士。肉体的な力差もあまりなく対等でリバ。\n①が②を振り回すことが多い。\n\n・①→②への印象\n∟自分のもの、自慢の刀、男性としての魅力も感じている、困らせたい(振り回したい)\n\n・②→①への印象\n∟ 自分の皇帝、誇りと人間らしさを与えてくれた人、希望、かっこいい姿を見せたい相手、最初で最後の恋の相手\n\n【希望】\n\n・構図、服装、などは全てお任せ致します！\n\n・可能でしたら構図のうち1つはクリスマスを楽しむ2人を描いて頂けますと嬉しいです。\n\n\nーーーーーーーーーーーーーーーーーーーー\n\n\n【用途】\n個人鑑賞、壁紙やロック画面への使用、個人利用の範囲でSNSアイコン使用、印刷物(ステッカーなど)また、オンラインセッションでの使用などに利用させて頂く可能性がございます。\n\nご縁がありましたらよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1zprFVVVHcOUn8SB3uxZzlgVOQt_c