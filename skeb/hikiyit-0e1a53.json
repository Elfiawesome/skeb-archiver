(*^ω^*)\n設定：年齢17歳、身長159cm、キャラクターは読書好きで憂鬱な性格のおとなしい女の子です。\n画像設定はhttps://drive.google.com/drive/folders/1Bzj3-0pODk5IzFcUVnSWFGCiTZUeuBXk。\n使い方：個人的に見る", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hikiyit/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1556995, "client_id": 2054262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/29291093/uploads/origins/883fe732-57eb-401a-8759-24d946b1c0be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1be8e20c0528a4ab1eed45d93f5f607", "srcset": "https://si.imgix.net/29291093/uploads/origins/883fe732-57eb-401a-8759-24d946b1c0be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a1be8e20c0528a4ab1eed45d93f5f607, https://si.imgix.net/29291093/uploads/origins/883fe732-57eb-401a-8759-24d946b1c0be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b78c32835caad54cab06499d699005d8 2x, https://si.imgix.net/29291093/uploads/origins/883fe732-57eb-401a-8759-24d946b1c0be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=88b3a53faea9f69271364bd8f72928ed 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/29291093/uploads/origins/883fe732-57eb-401a-8759-24d946b1c0be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c62e3f140ca7633e46f11f2260cc982", "srcset": "https://si.imgix.net/29291093/uploads/origins/883fe732-57eb-401a-8759-24d946b1c0be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c62e3f140ca7633e46f11f2260cc982, https://si.imgix.net/29291093/uploads/origins/883fe732-57eb-401a-8759-24d946b1c0be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=64fb7af1dba4bd6942849ff554be5d5f 2x, https://si.imgix.net/29291093/uploads/ori