n単色とおっしゃっていたのですが、何色で描いていただいても大丈夫です！\nもし一部に色が入るのであれば、つつじの黒青金の目の色がとても大好きなでそこに拘っているので、もし色を入れていただけるなら目だと嬉しいです。\nですが絶対ではないので、なくても大丈夫です！\n\nskebの依頼が人生初ですので不備があれば申し訳ございません。\nご検討よろしくおねがいいたします。\n\nhttps://drive.google.com/drive/folders/1-jP6tiWiAfmxj1CGyKb_iUTkB2ZrL4xk", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@gohan_0909/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3978808, "client_id": 3318910, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/69d366c4/uploads/origins/1fee0316-8036-4753-bdd2-6d489e354f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bd2967b07f999ae6d68080d9ea8a03c", "srcset": "https://si.imgix.net/69d366c4/uploads/origins/1fee0316-8036-4753-bdd2-6d489e354f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bd2967b07f999ae6d68080d9ea8a03c, https://si.imgix.net/69d366c4/uploads/origins/1fee0316-8036-4753-bdd2-6d489e354f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=846891d4d540090b875e0717c1fba35f 2x, https://si.imgix.net/69d366c4/uploads/origins/1fee0316-8036-4753-bdd2-6d489e354f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61c2f7d62b1fdfb848ec359c0dd0896d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/69d366c4/uploads/origins/1fee0316-8036-4753-bdd2-6d489e354f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0c852c86d48d7fa25a71b59ddcacc85", "srcset": "https://si.imgix.net/69d366c4/uploads/origins/1fee0316-8036-4753-bdd2-6d489e354f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0c852c86d48d7fa25a71b59ddcacc85, https://si.imgix.net/69d366c4/uploads/origins/1fee0316-8036-4753-bdd2-6d489e354f8c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit