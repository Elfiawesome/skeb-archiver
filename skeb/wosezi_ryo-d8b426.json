年に私が実際に見た夢に出てきた、「ホオズキ」と「ネズミ」の2人組です。\nもし良ければ、下記URLから夢日記本文を読んでいただけたらと思います。\n夢日記本文：https://woseziryo.main.jp/honez/dream.html\nキャラクター：https://woseziryo.main.jp/honez/chara.html\n外見資料など：https://drive.google.com/drive/folders/1XS-qscxUk39S6NTtg-TGmpJY6SpaSQGc?usp=drive_link\n\n一人称・二人称が必要な場合は、\nホオズキ：おれ・君(きみ)　\nネズミ：俺・お前　\nを使用してください。\n\n○キャラクターの関係性など\n・バイト仲間、気の合う友人(親友)\n・秘密を抱える人+秘密を受容する人\n・普通じゃない人+普通の人\n\n○使用用途\n・個人鑑賞\n・Haniwa様のお名前をクレジットした上での、納品作品をイメージした創作\n　(文章をイメージしたイラスト・動画などの制作を想定しています。)\n\n作品の制作にあたり不都合がありましたら、リクエストはキャンセルしていただいて構いません。\nもしご縁がありましたら、どうぞよろしくお願いいたします。", "nc": 129, "word_count": 479, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@Sabahayate/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1533243, "client_id": 1441297, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/be0641ce/uploads/origins/ebe339f0-9492-494d-8c37-9a109b035369?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c537cec2b5d6543f2f17a3e8f48e85a", "srcset": "https://si.imgix.net/be0641ce/uploads/origins/ebe339f0-9492-494d-8c37-9a109b035369?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8c537cec2b5d6543f2f17a3e8f48e85a, https://si.imgix.net/be0641ce/uploads/origins/ebe339f0-9492-494d-8c37-9a109b035369?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3dbfd159b299dc9f0146323a7ffa5a50 2x, https://si.imgix.net/be0641ce/uploads/origins/ebe339f0-9492-494d-8c37-9a109b035369?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8430fc9cde7d15c31201375c92ca56da 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/be0641ce/uploads/origins/ebe339f0-9492-494d-8c37-9a109b035369?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d63ed0f592f312bb5d0f80e001c01d1a", "srcset": "https://si.imgix.net/be0641