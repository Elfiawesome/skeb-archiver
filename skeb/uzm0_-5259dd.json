描いていただけたら、とにかく嬉しく思います。\nまた、エラーのポップアップやカーソル、\nイラストウィンドウなどインターネットの\nモチーフが好きでバグが起きているような\nデザインにしていただけると嬉しいです。\n\nイラストはSNSのアイコンや、xでの活動、自身のホームページなど、自身のシンボルマークとしてリスナーさん方に見ていただけるような場面で使わせていただこうと考えております。\n\nデータは人物透過のレイヤー分けしていただいたpsdで頂戴したいですが、難しければ何でも構いません。\n\nもし難しければ蹴っていただいて構いませんし、料金含む不備不足等ございましたら再度修正して送り直させていただきます。\n何卒、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1k7AitCcdQyYpBTy8hReKbGMQRcaDkFzI", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@uzm0_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2682903, "client_id": 3363729, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ec42fd3/uploads/origins/49494b98-7996-4178-9553-64c0a421af9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d11de6d52ecaed7a541f302e62a976f6", "srcset": "https://si.imgix.net/6ec42fd3/uploads/origins/49494b98-7996-4178-9553-64c0a421af9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d11de6d52ecaed7a541f302e62a976f6, https://si.imgix.net/6ec42fd3/uploads/origins/49494b98-7996-4178-9553-64c0a421af9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=78d55fcf10417bb4f5a09636c2ff946b 2x, https://si.imgix.net/6ec42fd3/uploads/origins/49494b98-7996-4178-9553-64c0a421af9d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=184fa47b4873a18a366fd9c6e077c4bb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ec42fd3/uploads/origins/49494b98-7996-4178-9553-64c0a421af9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e36b43f0c273ed98f77dec1b4762b2a1", "srcset": "https://si.imgix.net/6ec42fd3/uploads/origins/49494b98-7996-4178-9553-64c0a421af9d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e36b43f0c273ed98f77dec1b4762b2