1歳、186cm、茶色の少しカールした髪、緑の目、標準的な体格、穏やかで礼儀正しい。ヴィラカスは裕福な家庭の平民で、コンスタンティンの助手である。コンスタンティンを尊敬しているため、相手の通信社に応募しに来て、アシスタントに選ばれた。コンスタンチンの日常生活や生活の世話をし、非常に従順で、忠犬のような性格に見え、コンスタンチンをとても頼りにしている。\n\nどのようなコスチュームで描くかは自由です！(西洋ファンタジーの設定が好きなら、写真28のコスチュームを選んでもいい！もちろん、他のコスチュームもあります！)\n\n金額に満たない場合は、再度リクエストを送っていただけると助かります！ご面倒であれば、キャンセルしていただいても構いません。この度はご依頼をお受けいただき、誠にありがとうございました！\n\nhttps://drive.google.com/drive/folders/1mP_-_aYjvuPUdyoPB12Sek3bUxpMOry1?usp=share_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fuyu_no12/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3761348, "client_id": 2462364, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d4e7e188/uploads/origins/abf4cee4-a82f-481b-a975-8d1af36b4216?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8e46063685670316dbc03d903a50ef4", "srcset": "https://si.imgix.net/d4e7e188/uploads/origins/abf4cee4-a82f-481b-a975-8d1af36b4216?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8e46063685670316dbc03d903a50ef4, https://si.imgix.net/d4e7e188/uploads/origins/abf4cee4-a82f-481b-a975-8d1af36b4216?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cc92c576a14d690d5bfc9b0975a2da0d 2x, https://si.imgix.net/d4e7e188/uploads/origins/abf4cee4-a82f-481b-a975-8d1af36b4216?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3d496e3ffd21f79cb3591761982a7763 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d4e7e188/uploads/origins/abf4cee4-a82f-481b-a975-8d1af36b4216?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47fa6db2045b8c59bd89cf06bb93fafc", "srcset": "https://si.imgix.net/d4e7e188/uploads/origins/abf4cee4-a82f-481b-a975-8d1af36b4216?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h