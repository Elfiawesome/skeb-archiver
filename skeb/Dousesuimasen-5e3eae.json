2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c187504d99b3d20deac912cdc47e957a", "srcset": "https://si.imgix.net/7297a22a/uploads/origins/e9e8a6ad-6921-476c-b324-7dfc4a636c34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c187504d99b3d20deac912cdc47e957a, https://si.imgix.net/7297a22a/uploads/origins/e9e8a6ad-6921-476c-b324-7dfc4a636c34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=583ab8ece7a546bff79d2b205fa26dac 2x, https://si.imgix.net/7297a22a/uploads/origins/e9e8a6ad-6921-476c-b324-7dfc4a636c34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c2c3a4fae2dae06cc8e215c7889a8929 3x"}, "body": "ペルソナ4の里中千枝と天城雪子の私服姿のイラスト(雪子がブーツを脱ぐ)をお願いします\n2人の服装は私服・冬(下記URL参照)でお願いします\n設定は「里中千枝と天城雪子 、久慈川りせの3人が堂島家に遊びに来て、玄関でブーツを脱ぐ」でお願いします\n※久慈川りせは既に到着していて玄関でブーツを脱ぎ終えて、家の奥に入っているという設定。\n\n里中千枝の私服・冬\nhttps://megatenwiki.com/wiki/File:P4D_Chie_Satonaka_Winter_Clothes_Render.png\n\n天城雪子の私服・冬\nhttps://megatenwiki.com/wiki/File:P4D_Yukiko_Amagi_Winter_Clothes_Render.png\n\n千枝は既に両足のブーツを脱ぎ終えて、ブーツを脱いだ状態で玄関にいる\n雪子は片足のブーツを脱いでいる状態。もう片方の足はブーツを履いている\n玄関には千枝の緑のブーツ、りせの茶色のロングブーツが真っ直ぐ立って置かれている\n※りせの茶色のブーツは資料URL参照\n\n以上よろしくお願いします\n\nhttps://megatenwiki.com/wiki/File:P4D_Rise_Kujikawa_Winter_Clothes_Render.png", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Dousesuimasen/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 794613, "client_id": 881706, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bee7daed/uploads/origins/00a6d998-8731-4864-bac5-5ded0139c65e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2b362eb80c0159cc2006cdd101b3641", "srcset": "https://si.imgix.net/bee7daed/uploads/origins/00a6d998-8731-4864-bac5-5ded0139c65e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a2b362eb80c0159cc2006cdd101b3641, https://si.imgix.net/bee7daed/uploads/origins/00a6d998-8731-4864-bac5-5ded0139c65e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=42f3b599a68303306b5c142042aef83c 2x, https://si.imgix.net/bee7daed/uploads/origins/00a6d998-8731-4864-bac5-5ded0139c65e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c27e5da04b034d82d6b38608c68398b6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bee7daed/uploads/origins/00a6d998-8731-4864-bac5-5ded0139c65e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8224c20e32436cb73db2e273becea78", "srcset": "https://si.imgix.net/bee7daed/uploads/origins/00a6d998-8731-4864-bac5-5ded0139c65e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8224c20e32436cb73db2e273becea78, https://si.imgix.net/bee7daed/uploads/origins/00a6d998-8731-4864-bac5-5ded0139c65e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a50aa2fc77740659bd44ef7098d04c65 2x, https://si.imgix.net/bee7daed/uploads/origins/00a6d998-8731-4864-bac5-5ded0139c65e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=48ce63da23655b8cb5e33cc229ff2a07 3x"}, "body": "■概要\n「地獄先生ぬ～べ～」の眠鬼のイラストをお願いします。\n参考までに以下にシチュエーション例を書いていますが、他のシチュエーションでもOKです。描いてみたい内容に合わせて変更してください。\n\n参考資料\nhttps://www.notion.so/2174869f05da80c49695cfce49e5b9c4?source=copy_link\n\n■シチュエーション例\n候補1. 慣れないお菓子作りをして、不格好ながらも完成したお菓子を照れながら渡してくるシチュエーション\n候補2. モブキャラから告白され、ストレートな好意に慣れていない眠鬼は、赤面しつつ驚き戸惑っているシチュエーション\n候補3.  事故から守ってくれたお礼に、まことから誘われたヒーローごっこに、よくわからないまま眠鬼が付き合うシチュエーション\n\n※解釈違いなど一切気にしませんので、自由にアレンジいただいてOKです\n※差分は同じ構図、ポーズでOKです\n※手先足先は見切れてもOKです\n※服装などはお任せします\n\n■その他\npsd(差分は別レイヤー、支障のない範囲で未統合)希望です\nCLIP STUDIOで確認可能です\n\n■規約以外の用途\n個人ホームページへの掲載", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Douse