\n公表していないが先祖返りで、一般的な吸血鬼に比べて魔法の才能に乏しかったり身体的特徴(尻尾)がある事がコンプレックス。\n\n衣装や雰囲気、シチュエーションはᴿᴼᴹᴬ先生にお任せします。  描いて頂いたイラストは自分用に最小ロットにてグッズに使用する場合があります。販売など、商業利用はしません。\n   https://drive.google.com/drive/u/0/mobile/folders/1-J8L_bxJswG-xHZyVxbeLsr9zOO5GG1H?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ro0o003/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "video", "tipped": false, "creator_id": 2886601, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/93f5b441/uploads/outputs/a1e65297-f2ed-4b36-9535-2a6ab132cc32?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=4beb12f059080e3fbccdeb8a27987196", "srcset": "https://si.imgix.net/93f5b441/uploads/outputs/a1e65297-f2ed-4b36-9535-2a6ab132cc32?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=4beb12f059080e3fbccdeb8a27987196, https://si.imgix.net/93f5b441/uploads/outputs/a1e65297-f2ed-4b36-9535-2a6ab132cc32?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=05e5c9321f40098051a100f3bf6c7980 2x, https://si.imgix.net/93f5b441/uploads/outputs/a1e65297-f2ed-4b36-9535-2a6ab132cc32?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8d5a33817b9e3599ab28a826ad48fe4 3x"}, "duration": 4, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/93f5b441/uploads/outputs/a1e65297-f2ed-4b36-9535-2a6ab132cc32?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=05c4ade54c7a6e5bf3c87b2b73e2d6cc", "srcset": "https://si.imgix.net/93f5b441/uploads/outputs/a1e65297-f2ed-4b36-9535-2a6ab132cc32?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=05c4ade54c7a6e5bf3c87b2b73e2d6cc, https://si.imgix.net/93f5b441/uploads/outputs/a1e65297-f2ed-4b36-9535-2a6ab132cc32?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4b45911f81898f7b887afa4aa9357f49 2x, https://si.imgix.net/93f