男子はアトラちゃんをマットの上に仰向けに寝かせ、添い寝するような感じで「いつもごめんね」「好きだよ、アトラさん」と胸を触ったりする、といったシチュエーションを希望致します。\n\n寝顔はギャグ調ではなく目を閉じて、冷や汗や涙は無しで。イタズラ内容などはお任せ致します。\n\n以上、毎回恥ずかしいリクエストですが、ご検討いただければ嬉しいです！", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@waldteufel9/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 238241, "client_id": 1309040, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b0111e4d/uploads/origins/db3887ee-221a-4d24-a027-a9f8d7d59d80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=357e273324b13a86faaf5d17887c9652", "srcset": "https://si.imgix.net/b0111e4d/uploads/origins/db3887ee-221a-4d24-a027-a9f8d7d59d80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=357e273324b13a86faaf5d17887c9652, https://si.imgix.net/b0111e4d/uploads/origins/db3887ee-221a-4d24-a027-a9f8d7d59d80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=764a6a762aa2fd02854d34ded670fa7a 2x, https://si.imgix.net/b0111e4d/uploads/origins/db3887ee-221a-4d24-a027-a9f8d7d59d80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b369042a0f311477cfa667011746d5c0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b0111e4d/uploads/origins/db3887ee-221a-4d24-a027-a9f8d7d59d80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56fa8d4052f999b76005d94e1458eaee", "srcset": "https://si.imgix.net/b0111e4d/uploads/origins/db3887ee-221a-4d24-a027-a9f8d7d59d80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56fa8d4052f999b76005d94e1458eaee, https://si.imgix.net/b0111e4d/uploads/origins/db3887ee-221a-4d24-a027-a9f8d7d59d80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=357732a614ce93342fb7ed8c881b7d89 2x, https://si.imgix.net/b0111e4d/uploads/origins/db3887ee-221a-4d24-a027-a9f8d7d59d80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=56f72cab991e22a9e69fbf83a8762208 3x"}, "body": "お世話になります！またリクエストお願い致します！\n\n前回の続きでアトラちゃんのイラストを希望します！\n\n\nアトラちゃんを気絶させた男子（名前わかんない…）、ベッドの縁に座り、隣にアトラちゃんを座らせています。アトラちゃんはぐったりと気絶しており、男子に頭を預けるようにもたれている感じで。男子はアトラちゃんの可愛さに顔を赤くし、「アトラさん、かわいい…」と呟く、というシチュエーションでお願いしたいです。\n\nアトラちゃんはスクール水着姿で、寝顔はギャグ調ではなく目を閉じて、冷や汗や涙は無しで。\n構図は正面からがありがたいです。\n\n過去絵の通りふとももは太めに描いていただければ嬉しいです！\n\n毎回変なリクエストですみません。アトラちゃんが好みでついリクエストしてしまいます(笑)\n\nご検討いただければ幸いです！", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@waldteufel9/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 238241, "client_id": 30233, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7712d460/uploads/origins/608bdcb4-82c5-424b-a7b2-97e65a2d9683?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bd81fe5ae738b01127c38447729a35c", "srcset": "https://si.imgix.net/7712d460/uploads/origins/608bdcb4-82c5-424b-a7b2-97e65a2d9683?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5bd81fe5ae738b01127c38447729a35c, https://si.imgix.net/7712d460/uploads/origins/608bdcb4-82c5-424b-a7b2-97e65a2d9683?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f912b77e5ebd779f0c99c120123accf9 2x, https://si.imgix.net/7712d460/uploads/origins/608bdcb4-82c5-424b-a7b2-97e65a2d9683?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d099a95c150dbc5cf56f3d8ff668852 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7712d460/uploads/origins/608bdcb4-82c5-424b-a7b2-97e65a2d9683?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=caeae03b93f539d37f94a55e70950e8b", "srcset": "https://si.imgix.net/7