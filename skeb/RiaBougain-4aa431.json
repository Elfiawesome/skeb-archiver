-9e17-9c21f56179d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed878c514aa2706d1c5cb4c48a93cbc4", "srcset": "https://si.imgix.net/39670cbe/uploads/origins/cdd56166-74ab-4e19-9e17-9c21f56179d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ed878c514aa2706d1c5cb4c48a93cbc4, https://si.imgix.net/39670cbe/uploads/origins/cdd56166-74ab-4e19-9e17-9c21f56179d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8e133b8b3bbbcb6feb10aba8b59e2b1a 2x, https://si.imgix.net/39670cbe/uploads/origins/cdd56166-74ab-4e19-9e17-9c21f56179d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1d34a87f4cf3c23d52366e80fd09d029 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/39670cbe/uploads/origins/cdd56166-74ab-4e19-9e17-9c21f56179d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2c7216b6904ae312f663c43194e331a", "srcset": "https://si.imgix.net/39670cbe/uploads/origins/cdd56166-74ab-4e19-9e17-9c21f56179d3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2c7216b6904ae312f663c43194e331a, https://si.imgix.net/39670cbe/uploads/origins/cdd56166-74ab-4e19-9e17-9c21f56179d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a722a1e762d1f09f79478e89ecd786bd 2x, https://si.imgix.net/39670cbe/uploads/origins/cdd56166-74ab-4e19-9e17-9c21f56179d3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ed652f51c019ea4103646da78c118b70 3x"}, "body": "初めまして。Hinoe様の描く「宅のアウラ」シリーズがとても大好きです！\nもし可能であればFFXIVのうちの子と相方さんのキャラのイラストをお願いいたします。\nポーズや構図などはお任せします！ラブラブな雰囲気が出ていると嬉しいです。\n\n～装備詳細～\n\n・アウラ♀(自キャラ)\n頭装備　アンドロイド旧式髪飾り:医(染色：スノウホワイト)\n足装備　エンジェルサイブーツ(染色：パールホワイト)\nその他の部位　レプリカ・ハイアラガン・ヒーラー装備(染色：パールホワイト)\n\n・アウラ♂(相方さん)\n頭装備　ダリウムディフェンダーヘアピン(染色：スートブラック)\nその他の部位　レプリカ・ハイアラガン・ディフェンダー装備(染色：スートブラック)\n\n～使用用途～