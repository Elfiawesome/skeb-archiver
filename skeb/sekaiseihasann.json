&fit=crop&crop=top&w=200&h=200&s=e6513dec340ef7cf375b92cfc4d8116e", "src_set": ""}, "duration": 28, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/55c11c8b/uploads/outputs/6309d6aa-d99d-42a1-882d-a94919f117ac?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=8e13e17900817fa614ae8a8a6a2fb7d1", "src_set": ""}, "body": "頻繁なリクエスト、大変失礼します。\n\nよければ「深翠みるめ」さんの配信前での待機画面や、配信中離席した時に流すのムービーの依頼をお願いいたします。\n\n\n[イメージ]\n┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈\n・深翠みるめさんのぬいぐるみが、やる気のないヘッポコなダンスを踊っている。\n※私の中では「桔梗ぬい」と言うぬいぐるみのイメージです。\n\n・～ちょっとまっててね～  と言ったメッセージが画面を流れている。\n\n・動画の始まりと終わりでループしている。", "nc": 1, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}, {"path": "/@sekaiseihasann/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 22365, "client_id": 45726, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f7a6469/uploads/origins/a71cbc33-f0aa-4369-8bc5-301b151d8ebc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69da4060a7b68928513db714a1d5f3c7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f7a6469/uploads/origins/a71cbc33-f0aa-4369-8bc5-301b151d8ebc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=76cb49958ef21627e02215b62e26bdc5", "src_set": ""}, "body": "(重複してしまいますが)リクエスト失礼いたします....。\n \n深翠みるめ さん、エランティス・ピノさんの両名が、みるめさんの潜水艦の中でホラーゲームをしているイラストお願い致します...！！\n\n下記は私が抱いているイメージになります！\n難しい場合は、飛ばして頂いて構いません！\n┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈┈\nみるめさんは、顔面蒼白で涙ながらにプレイしていいます。\n\nピノさんは、怖がっている みるめ さんを見て面白おかしそうにしています。\n\nまた、2人がプレイしている所から少し離れたテーブルに、ゲームへの招待状が書きかけで1枚置いてあります。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sekaiseihasann/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 22365, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/81dbb4dc/uploads/origins/109e36b0-340a-47cb-ae4e-6209b8ef9090?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ad09620a1f0c74cdf88c6d4247ef12e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/81dbb4dc/uploads/origins/109e36b0-340a-47cb-ae4e-6209b8ef9090?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59befbe91a489eadbb05725886e44356", "src_set": ""}, "body": "久しぶりに怪異症候群の小暮紳一描いてくれませんか？", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sekaiseihasann/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 22365, "client_id": 45726, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a5c01d5/uploads/origins/82ee8569-afdd-4da6-a8a0-eba20de1fe6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f55798f955bedee75cb130894b0b72b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a5c01d5/uploads/origins/82ee8569-afdd-4da6-a8a0-eba20de1fe6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=afb928cff98026ad7278a65debdfc53f", "src_set": ""}, "body": "重ね重ねのリクエスト失礼いたします。\nTRPGの立ち絵の作成を希望いたします。\n\n使用しているルールブックなどを下記に記載いたしますので、\nよければお描き頂けますと幸いです…。\n\n不可能な点等があれば、無視して頂いて構いません。\n\n-------------------------------\n【依頼事項】\n・TRPG用の立ち絵。\n・表情差分\n他NPCやPCとの関りが重要なルルブのため、喜怒哀楽や照れ顔等が表現できれば嬉しいです。\nまたキャラロストがあり得るルルブですので、他に絶望した顔や泣き顔等があれば幸いです。\n\n・衣装差分\n上着の着脱が出来れば幸いです。\n-------------------------------\n【使用しているルールブック】\n・ダブルクロス\n(レネゲイドウイルスと言う未知のウイルス影響で超人となった探索者が、日常を守るために異常の力を駆使して戦うTRPG)\n\n【キャラクター】\n[名前]\nアサギ\n[性別]\n女性\n[年齢]\n16\n[一人称]\n私\n[二人称]\nあなた\n[口調]\n・元気で人生楽しそうな感じ\n・中性的な喋り方\n[性格]\n・場当たり的で楽観的で寛容的。\n・子供っぽく、好奇心旺盛。\n・外界から閉ざされた施設で育ってきたので、日常の常識が乏しい。\n[外見イメージ]\n下記URLを参照頂ければ幸いです。\nhttps://twitter.com/risebell019/status/1664973739002298370?s=20\n\n※外見的なイメージを版権キャラクターで例えますと「朝霧アサギ」が非常に近しいです。\n\n-----------------------------------------------------\n以下はTRPGの専門的な知識がいるため、最悪省いてもらって構いません\n\n[設定]\nモルフェウスと言われる、物質変換能力者。\n周りの物質を変換させて、武器や防具を作ったり強化したり出来る。\n(鋼の錬金術師の錬成が、一番イメージに近いです。)\n\n・彼女は着ている上着を二丁拳銃に変換して戦っています。\n　銃のイメージは、「リベレーター」と呼ばれる銃です。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sekaiseihasann/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 22365, "client_id": 45726, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c34aec6e/uploads/origins/8223eeba-5073-4f4b-bde7-c5654298d7fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2dc36e44c708b43bf54024e712b353ea", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c34aec6e/uploads/origins/8223eeba-5073-4f4b-bde7-c5654298d7fa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12cf950aaf63bc4c2690346ffd51a428", "src_set": ""}, "body": "都度都度リクエスト失礼いたします。\n納涼の季節には早いですが...\n\nハロウィン衣装の水底みなみさんが深夜レイくんに対して、おどろおどろしいポーズで怖い顔をしながら怪談を話している様をお願いします。\n\n深夜レイくんは真剣に聞いてる風に見えますが、実は怪談の内容は右から左に聞き流されていて、みなみさんの衣装を見て(この血糊本物だったら勿体ないな...)って想像をしています。\n\n ※飽くまで情景の想像ですので、お好きに改変されても問題ありません。\n\n───────────────\n\n難しい様であれば、朗読配信で怖い顔をしながら楽しそうに怪談を語る水底みなみさんをお願い致します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sekaiseihasann/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 22365, "client_id": 45726, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a564882/uploads/origins/20407553-1800-4515-90be-f2e646296f81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=60a93efba20ee557c0f2d3d0ebd9d9cb", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a564882/uploads/origins/20407553-1800-4515-90be-f2e646296f81?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=25cdf8ec78e36e796159ea84f0545d17", "src_set": ""}, "body": "又々リクエスト失礼いたします。\n\n水底みなみさんがいつもの配信背景をバックにして、「リングフィットアドベンチャー！」って言いながらバブルリングを作って腕を構えている様をお願いします。\n\n(あくまで雰囲気のイメージですので、セリフは無しで構いません)\n\n\n難しい様であれば、いつもの配信背景をバックにしてドヤ顔を決めている様をお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sekaiseihasann/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 22365, "client_id": 44286, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/40749896/uploads/origins/019ef180-176d-4eee-bed0-342458955f31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39cd6218878d9f9888698280c49af980", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/40749896/uploads/origins/019ef180-176d-4eee-bed0-342458955f31?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=116f4b7145092ae19019ae242ff9a47e", "src_set": ""}, "body": "夏への扉！！\nという感じの水底みなみのイラストをください！\n\n夏が待ち遠しいです。\n四季で言うなら1番好きな季節が夏です。\nそんな理想郷の夏へ、水底みなみさんが案内してくれるような一枚をお願いします。\nまだもう少しだけ遠い夏へ", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sekaiseihasann/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 22365, "client_id": 44481, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/07cc7c8b/uploads/origins/e1274c04-228a-4b72-8489-01f83ddd9422?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b146b88fef68931a96