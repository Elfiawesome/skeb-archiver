rue, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b496ea65/uploads/origins/c7f8f6e8-6e2d-4d99-922a-84a5abcd8727?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a585313b6375015598816e11fd91a007", "src_set": ""}, "body": "ブルアカから清澄アキラの緊縛イラストをお願いします。キャラ詳細は下記をご確認ください。\nキャラ詳細\nhttps://bluearchive.wikiru.jp/?アキラ\n\nシチュエーション\n美術品を盗みにいったが捕まってしまい、拘束されて尋問にかけられている\n詳細\nアキラは全裸、厳重に縄で縛られて三角木馬に乗せられています。また首輪と木馬が繋がれていて逃げられない状態です(首輪のイメージは資料になります)\nキャラ詳細にある仮面無しで顔が見えているようお願いします。尋問のやり方はお任せします。ハードめな内容だと嬉しいです。\n\nhttps://www.pixiv.net/artworks/92237385", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@maru23586736/works/102", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8a856861/uploads/origins/4faf8ada-3285-433c-837b-534777576b61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a104b6a3faeeb67a578c16838fece442", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 763828, "client_id": 2369576, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@maru23586736/works/101", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 763828, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/730f16fe/uploads/origins/51f0b728-833b-44d5-8777-9663b4f99fa7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=45f8456aa76b9403aa9ccb6296afa433", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/730f16fe/uploads/origins/51f0b728-833b-44d5-8777-9663b4f99fa