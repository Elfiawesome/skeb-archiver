h=200&blur=200&s=0ee8312ada66c4020ee29b744930bc46", "srcset": "https://si.imgix.net/0a1674db/uploads/origins/649fdd69-63b2-4fed-97f3-5a7e13132b2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ee8312ada66c4020ee29b744930bc46, https://si.imgix.net/0a1674db/uploads/origins/649fdd69-63b2-4fed-97f3-5a7e13132b2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bcb9ffa67bf1f1d356a7de7d8769b18b 2x, https://si.imgix.net/0a1674db/uploads/origins/649fdd69-63b2-4fed-97f3-5a7e13132b2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8eb0cdb60ced3153a559a6dab04102b3 3x"}, "body": "初めまして！\n\n友人のキャラクターをぜひ描いていただきたく、\nリクエストを送らせていただきました！\n\n【キャラクターについて】\nとっても可愛くて、明るくて元気いっぱいの、ちょっとおちゃめなギャルです。\n\n【ポーズ】\nお任せいたします。\n\n可能であれば、資料内の「2.0.png」と記載されている衣装を着せていただけますと幸いです。\n\n【使用用途】\nTwitterやYouTubeのサムネイルに使用したいため、レイヤー分けされたPSDファイルまたは透明背景のバリアント画像をお願いいたします。\n\n【資料】\nhttps://drive.google.com/drive/folders/1nBO5cAsBdzBYVXRptl4TqEoF7FNQIE6U?usp=sharing\n\nhttps://drive.google.com/drive/folders/1nBO5cAsBdzBYVXRptl4TqEoF7FNQIE6U?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@85natuki/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3671556, "client_id": 2113028, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0534a56d/uploads/origins/9be61f24-e81a-4df5-9f99-d72508edcfba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8e47e285e641c7913617e034c890cf8", "srcset": "https://si.imgix.net/0534a56d/uploads/origins/9be61f24-e81a-4df5-9f99-d72508edcfba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8e47e285e641c7913617e034c890cf8, https://si.imgix.net/0534a56d/uploads/origins/9be61f24-e81a-4df5-9f99-d72508edcfba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=24982a6