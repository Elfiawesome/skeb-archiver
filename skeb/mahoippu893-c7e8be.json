uploads/origins/c9b98d9a-5aea-491e-9bfe-19417cc74a57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a771fea10cd4f4ff016c511cf063429e, https://si.imgix.net/7ab9627c/uploads/origins/c9b98d9a-5aea-491e-9bfe-19417cc74a57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b7f2e66979bfc7a5d002f61720fdfe02 2x, https://si.imgix.net/7ab9627c/uploads/origins/c9b98d9a-5aea-491e-9bfe-19417cc74a57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9baeb33ccf15664601cb31b4f3a1d7ea 3x"}, "body": "こんにちは、汐-様。\n作品を拝見し、とても感銘を受け、ご連絡させていただきました。\n\n今回は、宿六 三味のイラストをお願いしたいと思っております。\n\n小さなケーキやキャンドル、ささやかな贈り物、またはエビフライのぬいぐるみなど、無理のない範囲で取り入れていただけたら嬉しいです。\n\n表情は、明るく楽しそうな雰囲気だと理想です。\n\n構図・ポーズ・表情の細かなニュアンスなどは、すべて汐様の感性にお任せします。ご自由に解釈して描いていただいて構いません。\n\nこのイラストはSNSで使用予定です。\n\n可能であれば、背景透過のバージョンもいただけるとありがたいです。\n\n参考資料：\nhttps://x.com/3miyado6/status/1688584313737269248\n\nどうぞよろしくお願いいたします。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mahoippu893/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1893320, "client_id": 2973566, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d123ab53/uploads/origins/9f2ada4e-4256-4ea1-be1f-085714cf26cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adecd663183ca5a42e06ed8f01e1ff12", "srcset": "https://si.imgix.net/d123ab53/uploads/origins/9f2ada4e-4256-4ea1-be1f-085714cf26cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=adecd663183ca5a42e06ed8f01e1ff12, https://si.imgix.net/d123ab53/uploads/origins/9f2ada4e-4256-4ea1-be1f-085714cf26cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=13c0b91ac1d77baf227abd25f6b1de2d 2x, https://si.imgix.net/d123ab53/uploads/origins/9f2ada4e-4256-4ea1-be1f-085714cf26cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d83d2fdcbf8275ffc740e9128302a243 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d123ab53/uploads/origins/9f2ada4e-4256-4ea1-be1f-085714cf26cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf6e3efe67ed6e0168361f454de433a6", "srcset": "https://si.imgix.net/d123ab53/uploads/origins/9f2ada4e-4256-4ea1-be1f-085714cf26cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf6e3efe67ed6e0168361f454de433a6, https://si.imgix.net/d123ab53/uploads/origins/9f2ada4e-4256-4ea1-be1f-085714cf26cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2d82d7be7cea3b742cc5ad80d4e1c92b 2x, https://si.imgix.net/d123ab53/uploads/origins/9f2ada4e-4256-4ea1-be1f-085714cf26cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9c77808a714c62eba308bf6d23cc6b40 3x"}, "body": "汐 様\n\nはじめまして、個人Vtuberをやっております霜月凪と申します。 \n\n過去実績拝見し、素敵なイラストだったので\n私のイラストを描いていただきたくリクエストさせていただきました。\n\n〇衣装・構図について\n衣装の細かい部分はおまかせで資料全て参考程度になるのですが、こんな感じの衣装（https://drive.google.com/file/d/1IetC5CDbnX9hZqfcjci0dXw8nlPlntw0/view?usp=drive_link）を着せた私を描いていただければと思います。\n\nまた、リボンですがこんな感じ（https://drive.google.com/file/d/1Y8ahRP2NcLK-zYpBrwI3Zp_g2G95GcFD/view?usp=drive_link）でお願いできますと幸いです。\n\n最後に頭にこんな感じの帽子（https://drive.google.com/file/d/1CTVuccUp7H2tn4bvINZT6AebVHTUFblc/view?usp=sharing）を被せていただけますと幸いです。\n\n構図に関してはおまかせでお願いできればと思います。\n\n○その他\n収益化目的以外の配信活動で使用する予定になります。\n\n元々の衣装に髪飾りがあるのですが外したり、アレンジいただいて大丈夫です。\n\n人物と背景とのレイヤーがそれぞれ分かれたPSDデータもしくはそれぞれ別ファイルでPNGで頂けたら幸いです。\n\n 配信のサムネイルに使う可能性があるので頭が見切れないように描いていただけますと幸いです。\n\n新衣装等作成する際に配色等参考にさせていただく可能性があります。\n\nわたしのモデルは以下リンクをご参照いただけますと幸いです。  \n\nhttps://lit.link/shimotsukinagi \n\n以上、ご都合がよろしければどうぞよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mahoippu893/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1893320, "client_id": 3143432, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3612f81d/uploads/origins/92e04c78-7111-4da8-bb6f-f162b499c5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=382c5c4bafb93ae2ed40faa71d0db677", "srcset": "https://si.imgix.net/3612f81d/uploads/origins/92e04c78-7111-4da8-bb6f-f162b499c5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=382c5c4bafb93ae2ed40faa71d0db677, https://si.imgix.net/3612f81d/uploads/origins/92e04c78-7111-4da8-bb6f-f162b499c5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3a91ef4f3025ed4dfe596cd0a2414fb1 2x, https://si.imgix.net/3612f81d/uploads/origins/92e04c78-7111-4da8-bb6f-f162b499c5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ed51a924ca34d38c0622cee579031c7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3612f81d/uploads/origins/92e04c78-7111-4da8-bb6f-f162b499c5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e21bb732770cde780c1775faf62c61f", "srcset": "https://si.imgix.net/3612f81d/uploads/origins/92e04c78-7111-4da8-bb6f-f162b499c5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e21bb732770cde780c1775faf62c61f, https://si.imgix.net/3612f81d/uploads/origins/92e04c78-7111-4da8-bb6f-f162b499c5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=653d2a1ad3235cd2e3cb39f0beecfe30 2x, https://si.imgix.net/3612f81d/uploads/origins/92e04c78-7111-4da8-bb6f-f162b499c5d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dfcb6683b91730b7fee00a469af79c22 3x"}, "body": "汐様こんばんは！みゅーと申します。\nYouTubeでVTuberとして活動しております。\n\nTwitterでかわいらしいイラストを拝見させていただき、絵柄がとっても好みだったので\nもし良ければ描いていただければと思い連絡させて頂きました。\n\n\n当方、みゅー・あうろーらのイラストを依頼させていただければと思います。\n\n\n衣装や構図、ポーズに関してはお任せします。当方の衣装でもよいですし何かしらのコスプレでも構いません。座っていても寝ていてもどのような角度でもかまいません。ゲームのキャラ風でも何かのボカロ曲モチーフでもOKです。セクシーなものでも問題ありません！\n汐様の趣味やフェチ、性癖などを全開で盛り込んでいただければと思います。\n（前髪は片目隠れでお願いします。表情豊かだとうれしいです。）\n\n\n\n人物の透過PNGかPSDを合わせて頂ければ嬉しいです。\n\n\n用途はXでの投稿や収益化したライブ配信や動画、アイコンやヘッダー使用、ネットプリント、グッズ、ファンボックスなどのVTuberとしての活動で使用させていただければと思っております。\n\n立ち絵などの資料は下記URLから確認していただければと思います。\n\n\n\nスケブでの依頼は慣れていないので至らない点があると思いますが、よろしくお願いします。\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nhttps://lit.link/mewaurora\n\nhttps://lit.link/mewaurora", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mahoippu893/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1893320, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/84b5f995/uploads/origins/c348e189-ea4e-43f4-8465-91f3a3060777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8a55d61d95a64b47fe6acd15f8bb1ef", "srcset": "https://si.imgix.net/84b5f995/uploads/origins/c348e189-ea4e-43f4-8465-91f3a3060777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8a55d61d95a64b47fe6acd15f8bb1ef, https://si.imgix.net/84b5f995/uploads/origins/c348e189-ea4e-43f4-8465-91f3a3060777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f473dcf7dff186fc98c1cbc7c1e7b8d1 2x, https://si.imgix.net/84b5f995/uploads/origins/c348e189-ea4e-43f4-8465-91f3a3060777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=58bb36a7cd705a92623a3f194ea83134 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/84b5f995/uploads/origins/c348e189-ea4e-43f4-8465-91f3a3060777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4fea46a04a7ed7499d2f028ad27d8a74", "srcset": "https://si.imgix.net