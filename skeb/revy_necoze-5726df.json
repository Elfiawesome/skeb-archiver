23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3afc319f4e04492ae675314a6af8fd59 3x"}, "body": "わらべ先生、はじめまして。EN Vtuberのセナ・アルと申します。\n先生の作品をいくつか聴かせていただきましたが、もしBGMの制作をお願いできればとても嬉しいです！ \n\n可能であれば、この曲を私の「おしゃべり配信」で使いたいと思っています。具体的なリクエストはありませんが、何かかわいい曲で、私のVTuberモデルに合わせてBGMなどはすべて先生にお任せしたいです。\n\nご検討いただき、誠にありがとうございます。\n\nhttps://drive.google.com/drive/folders/19WLpi8F5cIRmfPAiICZkqD8r4a7d8XuX?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@revy_necoze/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": true, "creator_id": 3755357, "client_id": 4093914, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1752708307377381376%2FVQDV0vL3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ffc9e93d58d5574fd19d8afd8c5c9ff", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1752708307377381376%2FVQDV0vL3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ffc9e93d58d5574fd19d8afd8c5c9ff, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1752708307377381376%2FVQDV0vL3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d35d0a0dc80e92aea361e82d9248d395 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1752708307377381376%2FVQDV0vL3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c7ba590f07a1d28f7a0e3b10dec6158 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/c1891c9e-8f0e-4770-9962-02244d0afd31?response-content-disposition=inline&Expires=1790854875&Signature=CFbO2UL5xi-bY1zOx46cQnFO6kUQYOFC2PLSDnLOnhoIYlnz8wfJm0yXHP5RfVlV4tIxE2zUHcY5emMa0Q2NBOFsG4otqy2-qT5p349SM~4hj3lD4g~HzL5gLgiOY8BgqqlkTAnTzeBlq9tINN8sLbZnVWHIe8ZpaEeJsS4Iel-ffZN8wel4axE3X2ECFmvE-RoEH5AqA6fgdS-HGkXIjarkUsP-nPQVQYLfKi2LbX4yJetAtetZu0I7WXy4knyCl8rbjGBlMZNjQZUwQyRAPqHFl781q7MWDwtSPJfAbV5gB6XvVY5xb39VPPIr18Iw-T0UC6H-06izvjkM1okDkQ__&Key-Pair-Id=K1GS3H53SEO647", "duration": 72, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1752708307377381376%2FVQDV0vL3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83e4e38503253312b7570133681f2a2e", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1752708307377381376%2FVQDV0vL3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83e4e38503253312b7570133681f2a2e, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1752708307377381376%2FVQDV0vL3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ed6c060f25830f5e7ffc35e4bd1724b 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1752708307377381376%2FVQDV0vL3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3afc319f4e04492ae675314a6af8fd59 3x"}, "body": "わらべ様\n\nこんにちは。いつも曲を聴いて楽しませていただいております。\n今回は大好きなクリエイターであるわらべ様に、大学の卒業制作発表会で使用する音源の制作をお願いしたくリクエストいたしました。\nリクエストが初めてのため、失礼がありましたら申し訳ございません。\n\n🤍使用用途\n大学の卒業制作発表会(ファッションショー)のBGM\n入場から退場にかけて使用(尺は1分程度を想定)\n\n🤍楽曲のイメージ・要望\n 「形式上は和服だが、和服という枠組みをどこまで壊し、どこまで残して自分のものにするか」をテーマに制作した、黒を基調とした重厚感のある衣装です。\n楽曲の雰囲気として、和の要素を取り入れつつ、わらべさんならではの可愛らしさや危うさ、そして衣装の重厚感に合わせた、重たさのあるサウンドを希望します。イメージとしては「くつうれんあい」の雰囲気が近いです。(ちなみに一番好きな曲は「えいえんじゃなくてゴ×ンネ」です。参考になるか分かりませんが…)\nまた、ショーのポージングのタイミングを合わせるため、後半部分にサビのような盛り上がりがあると大変助かります。\n\nこれらはあくまで要望なので、細かい部分はおまかせいたします！デザイン画を見て、それを受けた印象で制作していただければ幸いです。\n\n🤍補足資料\n衣装のデザイン画と詳細なコンセプトをまとめたURLです。イメージの参考にしていただければ幸いです。\nhttps://drive.google.com/drive/folders/116HJi3r-SBR6L2I_n3haoZVRi7C9NXEq\n\n‎🤍権利・二次利用について\n卒業制作発表会での利用にあたり、大学側からは「制作者様の許可・対価の支払い・クレジット表記」が確認できれば問題ない旨の指定を受けております。\nまた、発表会は録画され、後日大学の公式YouTubeチャンネル等で公開される予定です。あらかじめご了承いただけますと幸いです。\n\nお忙しいところ恐縮ですが、ご縁がありましたらぜひよろしくお願いいたします！", "nc": 16, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@revy_necoze/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": false, "creator_id": 3755357, "client_id": 4094012, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1752708307377381376%2FVQDV0vL3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ffc9e93d58d5574fd19d8afd8c5c9ff", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1752708307377381376%2FVQDV0vL3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ffc9e93d58d5574fd19d8afd8c5c9ff, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1752708307377381376%2FVQDV0vL3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d35d0a0dc80e92aea361e82d9248d395 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1752708307377381376%2FVQDV0vL3.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c7ba590f07a1d28f7a0e3b10dec6158 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/29b0ec8b-53cb-458e-a84d-5a83ccd03368?response-content-disposition=inline&Expires=1790854875&Signature=CCwhnT-KwX7iGNcr2Y6RrmRay7NdMjSJsPTMJh1p-MrWS1Vm4vUQstRLuRnYhqvtjWET9YxJmRm3Rug9vxoQ2jv2WIvXlrH7yBxxacwhukQBNPp81yh5bt-2VxdFj~1vZDFQnCZEXPFL-hiVEdlP-R9s5dVu9djWkZVGQP4WqJ49HXymo6OHBxu-t6eB6HUU-tq7bzURJ9gAGOa2TNOWGX5IGRDJTSNN5HX1Ymr6hT2qHmsilHFeFdRjCDfmYMFNk9yZkLw8pHIMm6wFK-g3VMVq-En2c3XD6NEDAg9peK0SBbYPD96ZVsjis1OtWGJ8fZ7MnBLQInBGVbFDUsOvCg__&Key-Pair-Id=K1GS3H53SEO647", "duration": 137, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpb