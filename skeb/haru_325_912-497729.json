あきゃらと戦闘差分を貼っておきます。いあきゃらはネタバレがありますので、見ても見なくても大丈夫です。\n\n何卒、よろしくお願いいたします！\n\nHO3→ https://iachara.com/char/view/4512831\nHO4→ https://iachara.com/char/view/4517191\n戦闘差分→ https://twitter.com/haru_325_912/status/1583963835060273152?s=46&t=MRsQ2mkD23SXgTMYpuNySw", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hayashi_fuki/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 1230164, "client_id": 1232378, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/dbe61b22-6c40-46f0-a297-30a1ad3d86d2?response-content-disposition=inline&Expires=1774613243&Signature=hzGi4kf1mY5ecQNtF~KQfWEJBb4BDbdWBWWmv6XzMWTOuL31b9niuKewsV6oB0p103rJP9fQgAPJlmX90-5XjyhxTdZW~PffIUyMZbi6bBvB-0175It~SYYT2EPF23le727HedMcfOcLc-L9AQ2zTZSw3dOUFpAj8x0uxvqqL7oT99tzvOOB34bf2kgRjaYemng0OdJvflNZe~q~vYSl4gk4ukc68mcqS0abyp~nyALflOxIzo1X1jXi09wuOkwKeGH5t6sdrh3TdI39yk0kLN6C5Rokb0jwr1UkTfZGvROlDkHbtIiPm4WgmYl-e9IJQ8GPJKnqOM5zKeKZ-6TCLQ__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377446595004755973%2FiizD-ZiS.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20ab369dba5e016a41c11cea9cc6b372", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377446595004755973%2FiizD-ZiS.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20ab369dba5e016a41c11cea9cc6b372, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377446595004755973%2FiizD-ZiS.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6405c25dc4ee7d3fc5f318721acdceb3 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1377446595004755973%2FiizD-ZiS.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1b7a2fdc7fd2e080d1a9860e7669c82e 3x"}, "preview_url":