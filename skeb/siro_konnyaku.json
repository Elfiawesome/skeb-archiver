received_works": [{"path": "/@siro_konnyaku/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3448357, "client_id": 3645356, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6879c9ba/uploads/origins/a5ba5a4c-5b41-457d-94eb-2dc8e471b518?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4c43b9d41d471b1fc17821f28a531ee", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6879c9ba/uploads/origins/a5ba5a4c-5b41-457d-94eb-2dc8e471b518?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14f63c617f76033442fee78f150abeea", "src_set": ""}, "body": "こんにちは、アピールありがとうございます！\n\nたくさんの感想ありがとうございます…！\nとても嬉しいですし活動のモチベーションも上がります( ᵕ ᵕ̩̩ )\n\n作品を拝見させて頂きとても可愛かったので是非リクエストさせて頂きます(⋆ᴗ͈ˬᴗ͈)”\n\n内容はご提案いただいたもので大丈夫です🍒◎\n以下、詳細のご提示をさせて頂きます。\n\n୨୧┈┈┈┈┈┈┈┈┈┈┈┈┈୨୧\n\n【キャラクター詳細】\n・髪型→ハーフツイン\n・口→ωの形、向かって右側にのみ八重歯\n・目→猫目、まつげ多め\n・モチーフ→音符の飾りやアクセサリー、ジャスミンの花、猫のポシェットとレッグウォーマー\n・資料URLも添付させて頂きますのでご確認いただけますと幸いです。\n\n【衣装】\n・デフォルト、オリジナルどちらでもおまかせいたします！\n\n【構図、表情、イメージ】\n・キャラクター自体の雰囲気のイメージはゆめかわぎゃる、POP系になります。\n・しろにゃく様のギャル系のイラストが可愛かったので、あざとい系・メ@スガキ系・ギャル系あたりでイメージしております！\n\n【用途】\n・XなどのSNSへの投稿\n・配信（未収益）動画での使用\n\n→以下、可能であれば希望\n・メンバーへの壁紙返礼、配布\n・グッズ化\n\n【その他希望】\n・pngの場合、可能であれば背景/人物/小物などそれぞれの透過データを、psdの場合レイヤー分けにていただけると嬉しいです。\n・頭周りや手のポーズが見切れないように描いて頂きたいです。\n・余裕がある場合のみで構いませんので、表情差分があると嬉しいです。\n\n୨୧┈┈┈┈┈┈┈┈┈┈┈┈┈୨୧\n\n長々と申し訳ございません！何卒ご検討の程、よろしくお願い申し上げます。\n\nhttps://drive.google.com/drive/folders/1GXDGO5tr0MUjqDmqFSF_2KAEbxfamoEW", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@siro_konnyaku/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3448357, "client_id": 3592644, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d925ec4f/uploads/origins/e226609d-146e-416d-a599-d2d91b32ef85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=85a073bd1cca4d4972dee31785cb626e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d925ec4f/uploads/origins/e226609d-146e-416d-a599-d2d91b32ef85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2508fe2071d123e34beb2040b2288a50", "src_set": ""}, "body": "しろにゃく様\n\nこの度は素敵なアピールをいただき、誠にありがとうございます…！\nゆりかの配信もご覧にくださりありがとございます！\n\nぜひ、お写真をお願いさせていただければと思っております！\n\n⬛︎使用用途 \nSNS宣伝、サムネ、将来的に商用可能性あり。 \n\n ⬛︎構図\n背景、構図、ポーズ、髪型などは全部しろにゃく様にお任せします。\nサムネ使用のため、耳、髪、手が切らないていただけますと助かります。\n表情はお任せしますが、表情差分があれば幸いです。（資料にない表情でも可能です。）\n服装もお任せします。（元の服装、パジャマ姿、メイド服、アイドル衣装、バニーガールなど、なんでも可能です！）\n\n ⬛︎納品 \n可能であればpsdファイなど背景透過の納品だと助かります。\n\nもし金額に不備がございました再送も可能です。\nご縁がございましたら、ぜひお願い致します！\n\nhttps://drive.google.com/drive/folders/1Ram93AVaeFgK6C06UJVSX0QFJdHkqA3a", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 40061, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "囚", "screen_name": "syuuuuuuuuuu", "avatar_url": "https://pbs.twimg.com/profile_images/1604363532514258944/QK527PjQ.png", "header_url": "https://pbs.twimg.com/profile_banners/123813404/1604297768/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 33}, {"id": 916070, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "やすたろう🍀", "screen_name": "yasutaro", "avatar_url": "https://pbs.twimg.com/profile_images/1876598619547320320/vw-KTnnN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/425099508/1707904960/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_ac