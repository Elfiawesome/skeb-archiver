イル\n･SNSでの宣伝活動\n\n今後グッズ化、ファンクラブでの配布にて使用させて頂きたいとも考えております。\nもし不可でしたら、リクエストの再送させて頂きますので、よろしくお願いいたします。\n\nもし可能であれば、イラストは左右･上(頭)が切れないものも頂きたいです。\n\nまた、出来ればレイヤー分けされたもの、背景透過も頂きたいです。\n\nご検討よろしくお願い致します…！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nolc_00/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 27899, "client_id": 2436391, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/72757552/uploads/origins/e91de073-5490-447c-88bc-613313ac370e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d92631861a647fa6b53835f4ce1c1e61", "srcset": "https://si.imgix.net/72757552/uploads/origins/e91de073-5490-447c-88bc-613313ac370e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d92631861a647fa6b53835f4ce1c1e61, https://si.imgix.net/72757552/uploads/origins/e91de073-5490-447c-88bc-613313ac370e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=75d52f480100575f02e3ea80ba94f186 2x, https://si.imgix.net/72757552/uploads/origins/e91de073-5490-447c-88bc-613313ac370e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c88331e52d1d3414c07f5920de78efd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/72757552/uploads/origins/e91de073-5490-447c-88bc-613313ac370e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c974b48670d4620667ddff6e50dbd357", "srcset": "https://si.imgix.net/72757552/uploads/origins/e91de073-5490-447c-88bc-613313ac370e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c974b48670d4620667ddff6e50dbd357, https://si.imgix.net/72757552/uploads/origins/e91de073-5490-447c-88bc-613313ac370e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c7db32cef53b5c85ca1480f2fd789ce3 2x