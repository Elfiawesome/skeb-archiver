b7\u9759\u3002\n\u30b7\u30f3\u30d7\u30eb\u3067\u3086\u3063\u305f\u308a\u3068\u3057\u305f\u3001\u8272\u5408\u3044\u3082\u843d\u3061\u7740\u304d\u306e\u3042\u308b\u670d\u88c5\u3092\u597d\u3080\u3002\u30d1\u30f3\u30c4\u3082\u30b9\u30ab\u30fc\u30c8\u3082TPO\u306b\u5408\u308f\u305b\u3066\u534a\u3005\u304f\u3089\u3044\u3067\u7740\u308b\u3002\n\u30aa\u30d5\u3067\u3082\u30e1\u30a4\u30af\u306f\u3057\u305f\u308a\u3057\u306a\u304b\u3063\u305f\u308a\u3060\u304c\u5f97\u610f\u3002\u4ed5\u4e8b\u306e\u6642\u4ee5\u5916\u306f\u3001\u5de6\u85ac\u6307\u306b\u7d50\u5a5a\u6307\u8f2a\u3092\u3064\u3051\u3066\u3044\u308b\u3002\n\u30a2\u30af\u30bb\u30b5\u30ea\u30fc\u306f\u307b\u3068\u3093\u3069\u3064\u3051\u306a\u3044\u304c\u3001\u30ab\u30c1\u30e5\u30fc\u30b7\u30e3\u304c\u597d\u304d\u3002\n1\u6b73\u5e74\u4e0b\u306e\u65b0\u805e\u8a18\u8005\u306e\u592b\uff08\u5f8c\u8ff0\u30fb\u68ee\u5c0f\u96ea\u306e\u5f8c\u8f29\u3067\u81eaPC\uff09\u3068\u5c0f\u5b66\u751f\u306e\u9577\u5973\u3001\u4fdd\u80b2\u5712\u5150\u306e\u9577\u7537\u3068\u306e\u56db\u4eba\u66ae\u3089\u3057\u3002\n\u9060\u65b9\u306e\u5b9f\u5bb6\u306b\u306f\u5143\u8b66\u5bdf\u5b98\u306e\u7236\u3068\u3001\u9ad8\u6821\u306e\u7406\u79d1\u6559\u5e2b\u306e\u6bcd\u304c\u66ae\u3089\u3057\u3066\u3044\u308b\u3002\u3072\u3068\u308a\u3063\u5b50\u3002\n\u89aa\u985e\u3082\u8b66\u5bdf\u95a2\u4fc2\u8005\u304c\u591a\u304f\u3001\u521d\u604b\u306e\u76f8\u624b\u306f\u9060\u7e01\u306e\u89aa\u621a\u306e\u7537\u6027\u5211\u4e8b\uff08\u3088\u305d\u306e\u304a\u5b50\u69d8\uff09\n\u4e21\u89aa\u5171\u306b\u591a\u5fd9\u3060\u3063\u305f\u9803\u3001\u89aa\u985e\u306e\u5bb6\u306b\u4f4f\u3093\u3067\u3044\u305f\u6642\u671f\u304c\u3042\u308b\u3002\n\u4e2d\u5b66\u751f\u306e\u9803\u306b\u5947\u5999\u306a\u4e8b\u8c61\u306b\u5dfb\u304d\u8fbc\u307e\u308c\u305f\u3068\u3053\u308d\u3092\u52a9\u3051\u3089\u308c\u305f\u969b\n\u521d\u3081\u3066\u306e\u5931\u604b\u3092\u81ea\u899a\u3057\u305f\u304c\u3001\u5bb6\u65cf\u3068\u3057\u3066\u4fe1\u983c\u3057\u7d9a\u3051\u3066\u3044\u308b\u5f7c\u3092\u9670\u306a\u304c\u3089\u652f\u3048\u3089\u308c\u308b\u3088\u3046\u306b\u3068\u9451\u8b58\u5b98\u306b\u306a\u3063\u305f\u3002\n\u592b\u3068\u306f\u304a\u4e92\u3044\u521d\u604b\u3067\u306f\u306a\u3044\u304c\u904b\u547d\u3060\u3068\u306f\u601d\u3063\u3066\u304a\u308a\u3001\u3068\u3066\u3082\u5927\u5207\u306b\u3057\u5408\u3063\u3066\u3044\u308b\u4ef2\u306e\u3044\u3044\u592b\u59bb\u3002\n\u8da3\u5473\u306f\u6211\u304c\u5b50\u3068\u904a\u3076\u3001\u30cd\u30c3\u30c8\u30b5\u30fc\u30d5\u30a3\u30f3\u3001\u52d5\u753b\u30fb\u6620\u753b\u9451\u8cde\u3001\u8aad\u66f8\u3002\n\u4e09\u4eba\u306e\u4e2d\u3067\u4e00\u756a\uff1a\u5e73\u5747\u7684\u30fb\u4f53\u304c\u5f37\u304f\u306a\u3044\u30fb\u30d5\u30ec\u30f3\u30c9\u30ea\u30fc\u30fb\u4eba\u9593\u95a2\u4fc2\u304c\u5b89\u5b9a\u3057\u3066\u3044\u308b\u30fb\u6a5f\u68b0\u306b\u5f37\u3044\u30fb\u6559\u990a\u304c\u3042\u308b\u30fb\u5931\u604b\u306e\u8f9b\u3055\u3092\u77e5\u3063\u3066\u3044\u308b\u3002\n\u7279\u5fb4\u7684\u306a\u6280\u80fd\uff1a\u5199\u771f\u8853\u3001\u533b\u5b66\u3001\u30aa\u30ab\u30eb\u30c8\u3001\u30b3\u30f3\u30d4\u30e5\u30fc\u30bf\u30fc\u3001\u4eba\u985e\u5b66\u3001\u6cd5\u5f8b\u3001\u85ac\u5b66\n\n\n\u25bc\u56e3\u5b50\u8b83\u98fe\uff08\u3060\u3093\u3054 \u3055\u3093\u3057\u3087\u304f\uff09\n\u5211\u4e8b\u30027/1\u751f\u307e\u308c\u3002185cm/78kg\u306e\u7b4b\u8089\u8cea\u306a\u4f53\u683c\u3002\n\u5207\u308c\u9577\u306e\u30b8\u30c8\u76ee\u6c17\u5473\uff08\u826f\u304f\u8a00\u3048\u3070\u3044\u3064\u3082\u7b11\u3063\u3066\u3044\u308b\u3088\u3046\u306b\u898b\u3048\u308b\uff09\u3001\u4f5c\u308a\u7269\u306e\u3088\u3046\u306b\u7f8e\u3057\u3044\u77b3\u3092\u3057\u3066\u3044\u308b\uff08\u8a2d\u5b9a\uff09\u3002\n\u30a4\u30e1\u30fc\u30b8\u30ab\u30e9\u30fc\u306f\u6728\u69ff\u8272\uff08\u6843\u8272\uff09\u3002\n\u5834\u3092\u660e\u308b\u304f\u3059\u308b\u306e\u304c\u597d\u304d\u3067\u3001\u535a\u611b\u7684\u304b\u3064\u7d20\u76f4\u306a\u6027\u683c\u3002\n\u3054\u3064\u3081\u306e\u4f53\u683c\u3067\u3082\u304a\u304b\u3057\u304f\u306a\u3044\u7a0b\u5ea6\u306e\u30d5\u30a7\u30df\u30cb\u30f3\u306a\u670d\u88c5\u3092\u597d\u3080\u3002\u80a9\u5e45\u3092\u8aa4\u9b54\u5316\u305b\u3066\u3001\u3064\u3044\u3067\u306b\u8db3\u3055\u3070\u304d\u3092\u8aa4\u9b54\u5316\u305b\u308b\u3086\u3063\u305f\u308a\u3057\u305f\u30ed\u30f3\u30b0\u30b9\u30ab\u30fc\u30c8\u304c\u591a\u3081\u3002\n\u30aa\u30f3\u30aa\u30d5\u3067\u7a0b\u5ea6\u306f\u9055\u3048\u3069\u3001\u30e1\u30a4\u30af\u3082\u3044\u3064\u3082\u6b20\u304b\u3055\u306a\u3044\u3002\u670d\u306e\u4e0b\u306b\u307b\u307c\u3044\u3064\u3082\u30da\u30f3\u30c0\u30f3\u30c8\u3092\u3064\u3051\u3066\u3044\u308b\u3002\n\u524d\u9aea\u3092\u30d8\u30a2\u30b4\u30e0\u3068\u30ea\u30dc\u30f3\u4ed8\u304d\u30d8\u30a2\u30d4\u30f3\u3067\u4e0a\u3052\u308b\u306e\u304c\u30c8\u30ec\u30fc\u30c9\u30de\u30fc\u30af\u3002\u30a2\u30af\u30bb\u30b5\u30ea\u30fc\u3084\u30cd\u30a4\u30eb\u3082\u5272\u3068\u597d\u304d\u3002\n\u5927\u304d\u306a\u4eba\u5f62\u3068\u3072\u3068\u308a\uff1f\u66ae\u3089\u3057\u3002\u9000\u5b98\u5f8c\u306f\u98df\u5802\u3092\u958b\u304d\u305f\u3044\u3068\u307b\u3093\u306e\u308a\u601d\u3063\u3066\u3044\u308b\u3002\n\u8fd1\u304f\u306b\u6709\u540d\u670d\u98fe\u30c7\u30b6\u30a4\u30ca\u30fc\u306e\u5f1f\uff08\u9577\u7537\uff09\n\u9060\u65b9\u306e\u5b9f\u5bb6\uff08\u548c\u83d3\u5b50\u5c4b\uff09\u306b\u548c\u83d3\u5b50\u8077\u4eba\u306e\u7236\u3001\u5c02\u696d\u4e3b\u5a66\u306e\u6bcd\u3001\u548c\u83d3\u5b50\u8077\u4eba\u5f8c\u7d99\u306e\u5f1f\uff08\u6b21\u7537\uff09\u3068\u305d\u306e\u5ac1\u306b\u3042\u305f\u308b\u7fa9\u59b9\u304c\u4f4f\u3093\u3067\u3044\u308b\u3002\n\u5927\u5b66\u751f\u306b\u306a\u308a\u5730\u65b9\u304b\u3089\u4e0a\u4eac\u3059\u308b\u307e\u3067\u3001\u7537\u6027\u3068\u3057\u3066\u80b2\u3066\u3089\u308c\u3066\u3044\u305f\u3002\u6c34\u6cf3\u306e\u3042\u308b\u590f\u5b63\u306f\u5c71\u5965\u306e\u89aa\u621a\u5b85\u306b\u9810\u3051\u3089\u308c\u308b\u7a0b\u306e\u5fb9\u5e95\u3076\u308a\u3002\n\u4e21\u6027\u611b\u8005\u3067\u4eba\u3092\u611b\u3059\u308b\u3053\u3068\u306f\u591a\u304b\u308c\u3069\u3001\u6700\u8fd1\u9045\u3081\u306e\u521d\u604b\u306a\u308b\u3082\u306e\u3092\u81ea\u899a\u3057\u305f\u3002\u76f8\u624b\u306f\u540c\u50da\u306e\u5f1f\u3067\u3001\u73fe\u5728\u306e\u4e3b\u6cbb\u533b\uff08\u3088\u305d\u306e\u304a\u5b50\u69d8\uff09\n\u76f8\u624b\u306e\u3053\u3068\u306f\u63fa\u308b\u304c\u306a\u3044\u904b\u547d\u3067\u306f\u306a\u3044\u304b\u3082\u3057\u308c\u306a\u3044\u304c\u3001\u96e2\u308c\u304c\u305f\u3044\u3068\u601d\u3063\u3066\u3044\u308b\u3002\n\u8da3\u5473\u306f\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3001\u6599\u7406\u3001\u98df\u3079\u6b69\u304d\u3001\u30b7\u30e7\u30c3\u30d4\u30f3\u30b0\u3001\u6587\u901a\u3001\u88c1\u7e2b\u3002\n\u4e09\u4eba\u306e\u4e2d\u3067\u4e00\u756a\uff1a\u5065\u5eb7\u7684\u30fb\u529b\u6301\u3061\u30fb\u7537\u5973\u554f\u308f\u305a\u30e2\u30c6\u308b\u30fb\u656c\u8a9e\u3092\u5916\u3055\u306a\u3044\u30fb\u5bb6\u5ead\u74b0\u5883\u306b\u6075\u307e\u308c\u306a\u304b\u3063\u305f\u3002\n\u7279\u5fb4\u7684\u306a\u6280\u80fd\uff1a\u30de\u30fc\u30b7\u30e3\u30eb\u30a2\u30fc\u30c4\u3001\u30ad\u30c3\u30af\u3001\u7d44\u307f\u4ed8\u304d\u3001\u82b8\u8853\uff08\u6599\u7406\uff09\u3001\u88fd\u4f5c\uff08\u88c1\u7e2b\uff09\n\n\n\u25bc\u68ee\u5c0f\u96ea\uff08\u3082\u308a \u3057\u3087\u3046\u305b\u3064\uff09\n\u4e8b\u4ef6\u62c5\u5f53\u306e\u65b0\u805e\u8a18\u8005\u300211/22\uff08\u4e8c\u5341\u56db\u7bc0\u6c17\u306e\u5c0f\u96ea\uff09\u751f\u307e\u308c\u3002165cm/50kg\uff08\u73fe42kg\uff09\u306e\u7d30\u8eab\u4f53\u578b\u3002\n\u3064\u308a\u76ee\u6c17\u5473\u3067\u77b3\u5b54\u3092\u56f2\u3046\u3088\u3046\u306a\u6e26\u304c\u3042\u308b\u3002\n\u30a4\u30e1\u30fc\u30b8\u30ab\u30e9\u30fc\u306f\u9ec4\u7dd1\uff5e\u7dd1\u3002\n\u4ed6\u8005\u306b\u53d6\u308a\u5165\u308d\u3046\u3068\u3001\u8868\u5411\u304d\u306f\u660e\u308b\u304f\u4eba\u61d0\u3053\u304f\u632f\u821e\u3046\u304c\u3001\u5b9f\u969b\u306f\u60c5\u7dd2\u4e0d\u5b89\u5b9a\u306a\u5bc2\u3057\u304c\u308a\u5c4b\u3067\u89aa\u3057\u304f\u306a\u308b\u7a0b\u51b7\u305f\u304f\u306a\u308a\u304c\u3061\u3002\n\u5316\u7ca7\u3063\u3051\u304c\u307b\u3068\u3093\u3069\u7121\u304f\u3001\u9732\u51fa\u306e\u5c11\u306a\u3044\u30d1\u30f3\u30c4\u30b9\u30bf\u30a4\u30eb\u3092\u597d\u3080\u304c\u3001\u30c7\u30fc\u30c8\u306e\u6642\u306f\u6c17\u5408\u3092\u5165\u308c\u3066\u30b9\u30ab\u30fc\u30c8\u3082\u307e\u308c\u306b\u7a7f\u304f\u3002\n\u76ee\u306e\u4e0b\u306e\u30af\u30de\u3092\u96a0\u305d\u3046\u3068\u3082\u3057\u306a\u3044\u3002\u53f3\u85ac\u6307\u306b\u6307\u8f2a\u3092\u3064\u3051\u3066\u3044\u308b\u304c\u30a2\u30af\u30bb\u30b5\u30ea\u30fc\u3082\u597d\u307e\u306a\u3044\u3002\n\u30bf\u30fc\u30ad\u30c3\u30b7\u30e5\u30a2\u30f3\u30b4\u30e9\u2640\u306e\u30c8\u30eb\u30b3\uff08\u63a8\u5b9a1\uff5e2\u6b73\uff09\u3068\u66ae\u3089\u3057\u3066\u3044\u308b\u3002\u7247\u60f3\u3044\uff1f\u306e\u76f8\u624b\u3092\u3057\u3070\u3057\u3070\u62db\u3044\u3066\u6cca\u307e\u3063\u3066\u3082\u3089\u3046\u3053\u3068\u3082\u3042\u308b\u3002\n\u305d\u3053\u305d\u3053\u8fd1\u304f\u306b\u9678\u4e0a\u81ea\u885b\u5b98\u306e\u5144\u4e00\u5bb6\uff08\u7fa9\u59c9\u3068\u7525\uff09\u3068\u5143\u81ea\u885b\u968a\u97f3\u697d\u968a\u54e1\u306e\u7236\u6bcd\u306e\u4e8c\u4e16\u5e2f\u4f4f\u5b85\u304c\u3042\u308b\u3002\u5143\u306f\u8ee2\u52e4\u65cf\u80b2\u3061\u3002\n\u5144\u59b9\u63c3\u3063\u3066\u732b\u306b\u76ee\u304c\u306a\u304f\u3001\u767d\u3044\u306c\u3044\u3050\u308b\u307f\u3092\u5927\u4e8b\u306b\u3057\u3066\u3044\u308b\u3002\u30ca\u30a4\u30d5\u306f\u5144\u304b\u3089\u3001\u5144\u4ee3\u308f\u308a\u306b\u3068\u8cb0\u3063\u305f\u3082\u306e\u3092\u5927\u5207\u306b\u6301\u3061\u6b69\u3044\u3066\u3044\u308b\u3002\n\u672c\u5f53\u306f\u81ea\u5206\u3082\u81ea\u885b\u5b98\u304b\u8b66\u5bdf\u5b98\u306b\u306a\u308a\u305f\u304b\u3063\u305f\u304c\u3001\u5bb6\u65cf\u306e\u53cd\u5bfe\u3092\u53d7\u3051\u65ad\u5ff5\u3002\u5144\u3068\u8a95\u751f\u65e5\u304c\u8fd1\u304f\u3001\u81ea\u5206\u306e\u8a95\u751f\u65e5\u306b\u795d\u3063\u3066\u3082\u3089\u3048\u306a\u3044\u306a\u3069\u3084\u3084\u4e0d\u9047\u3002\n\u5909\u306a\u4eba\u3084\u65e2\u5a5a\u8005\u306b\u597d\u304b\u308c\u3084\u3059\u304f\u3001\u7570\u6027\u306b\u3068\u3063\u3066\u306f\u81ea\u5206\u306e\u8089\u4f53\u306b\u3057\u304b\u4fa1\u5024\u304c\u7121\u3044\u3068\u672a\u3060\u306b\u601d\u3063\u3066\u3044\u308b\u3002\n\u4ed5\u4e8b\u3067\u5354\u529b\u3059\u308b\u3053\u3068\u306e\u591a\u3044\u7537\u6027\u5211\u4e8b\u306b\u7121\u81ea\u899a\u3067\u4e00\u76ee\u60da\u308c\u3057\u3066\u3044\u305f\u304c\u3001\u66d6\u6627\u306a\u95a2\u4fc2\u3092\u7d9a\u3051\u3066\u3044\u308b\u3002\uff08\u8b83\u98fe\u306e\u604b\u306e\u76f8\u624b\u306e\u5144\uff09\uff08\u3088\u305d\u306e\u304a\u5b50\u69d8\uff09\n\u76f8\u624b\u306e\u3053\u3068\u306f\u3053\u308c\u4ee5\u4e0a\u597d\u304d\u306b\u306a\u3063\u3066\u306f\u3044\u3051\u306a\u3044\u3068\u601d\u3044\u3064\u3064\u3082\u3001\u65e2\u306b\u6eba\u308c\u3066\u3044\u308b\u3053\u3068\u3092\u81ea\u899a\u3057\u3066\u3044\u308b\u3002\u4e2d\u3005\u7d20\u76f4\u306b\u306a\u308c\u305a\u306b\u3044\u308b\u3002\n\u8da3\u5473\u306f\u732b\u3001\u30df\u30ea\u30bf\u30ea\u30fc\u7528\u54c1\u8490\u96c6\u3001\u30ca\u30a4\u30d5\u683c\u95d8\u8853\u3001\u6599\u7406\u3001\u8a9e\u5b66\u52c9\u5f37\u3002\n\u4e09\u4eba\u306e\u4e2d\u3067\u4e00\u756a\uff1a\u4e0d\u904b\uff08\u7279\u306b\u7537\u904b\u304c\u306a\u3044\uff09\u30fb\u60c5\u7dd2\u4e0d\u5b89\u5b9a\u30fb\u5730\u982d\u304c\u3044\u3044\u30fb\u8a00\u8449\u9063\u3044\u304c\u7dba\u9e97\u3060\u304c\u53e3\u304c\u60aa\u3044\u30fb\u8ca1\u529b\u306f\u3042\u308b\u304c\u53b3\u683c\u306a\u5bb6\u5ead\u3067\u80b2\u3063\u305f\u3002\n\u7279\u5fb4\u7684\u306a\u6280\u80fd\uff1a\u4e2d\u578b\u30ca\u30a4\u30d5\u3001\u65e5\u672c\u5200\uff08\u7525\u304c\u5263\u9053\u3092\u3084\u3063\u3066\u3044\u308b\u305f\u3081\u77e5\u8b58\u9762\uff09\u3001\u7cbe\u795e\u5206\u6790\u3001\u307b\u304b\u306e\u8a00\u8a9e\uff08\u82f1\u8a9e\uff09\n\n\u25c6\u95a2\u4fc2\u6027\n\u3056\u3063\u304f\u308a\u305d\u308c\u305e\u308c\u306e\u4eba\u751f\u306b\u5c11\u306a\u304b\u3089\u305a\u5f71\u97ff\u3092\u53ca\u307c\u3057\u54