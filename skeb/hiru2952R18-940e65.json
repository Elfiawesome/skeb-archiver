-a1c6-76a0f749cf33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0aca67674ce889ebcbc1e206f35478a8, https://si.imgix.net/82a847ff/uploads/origins/40597c2f-a239-45e2-a1c6-76a0f749cf33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ca327d6a89852fbe4f4fb5a56d98a7a 2x, https://si.imgix.net/82a847ff/uploads/origins/40597c2f-a239-45e2-a1c6-76a0f749cf33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=61617dc096c6dc8261aea3f557a0c792 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/82a847ff/uploads/origins/40597c2f-a239-45e2-a1c6-76a0f749cf33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2a45d3e6475220c896495a38e0aed1a", "srcset": "https://si.imgix.net/82a847ff/uploads/origins/40597c2f-a239-45e2-a1c6-76a0f749cf33?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a2a45d3e6475220c896495a38e0aed1a, https://si.imgix.net/82a847ff/uploads/origins/40597c2f-a239-45e2-a1c6-76a0f749cf33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b1ea8d148a3ac0d601230486098fe6e8 2x, https://si.imgix.net/82a847ff/uploads/origins/40597c2f-a239-45e2-a1c6-76a0f749cf33?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ccf398c69155befd61adb142d363a788 3x"}, "body": "リクエスト失礼します。\n\nアサルトリリィラストバレットから今叶星(水着)をお願いします。\n\nベースとしては八宮めぐるちゃんの激しいバック攻めと乳吸いのイラストがとても気にっているのでそのイラストと同じ感じでお願いしたいです。\n\n水着は上にズラされ胸出しで同じように吸われてるで(少し変えてもらえるなら胸を揉まれながら吸われてる感じでお願いします)下はパンツをぬがされ気味で挿入されてる感じでお願いします。\n\n表情はめぐるちゃんと同じ感じで嫌がってるんだけど感じてしまってる表情。\n\n体や胸の大きさなどはめぐるちゃんと同じくらいでお願いします。\n\nこんな感じですがよろしければお願いします。\n\n資料・https://assaultlily.bushimo.jp/wordpress/wp-content/themes/assaultlily/image/halfanniversary/prologue2/card04.jpg\n\nhttps://assaultlily.bushimo.jp/character/kanaho/\n\nhttps://img.altema.jp/assaultlily/isyou/stand/77.jpg", "nc": 1