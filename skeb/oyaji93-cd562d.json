ji93/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 155948, "client_id": 1762246, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/72c940c1/uploads/origins/9eb9a032-9158-4ec0-bd86-6d17599559bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56b0ee7d33293942b8570a8a7bcb0439", "srcset": "https://si.imgix.net/72c940c1/uploads/origins/9eb9a032-9158-4ec0-bd86-6d17599559bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=56b0ee7d33293942b8570a8a7bcb0439, https://si.imgix.net/72c940c1/uploads/origins/9eb9a032-9158-4ec0-bd86-6d17599559bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4622b68e6ba0a03b30b532066656e5ac 2x, https://si.imgix.net/72c940c1/uploads/origins/9eb9a032-9158-4ec0-bd86-6d17599559bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92336e1772fc144fd5bc24a6f838a50d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/72c940c1/uploads/origins/9eb9a032-9158-4ec0-bd86-6d17599559bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5357abce13c7e29eaa30105218bc5945", "srcset": "https://si.imgix.net/72c940c1/uploads/origins/9eb9a032-9158-4ec0-bd86-6d17599559bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5357abce13c7e29eaa30105218bc5945, https://si.imgix.net/72c940c1/uploads/origins/9eb9a032-9158-4ec0-bd86-6d17599559bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=677cc62e6dae801f9d6c6c1e3ebf46bb 2x, https://si.imgix.net/72c940c1/uploads/origins/9eb9a032-9158-4ec0-bd86-6d17599559bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d1e66acbfe46a39964f6d0867bde1fed 3x"}, "body": "こんにちは。\n\nファイアーエムブレムフェイトのかげろうを描いていただけませんか？黒地に赤と白の花柄の着物で、帯は黄色でお願いしたいです。着物の上部が開いていて、胸の谷間が見えるようにしてください。背景とポーズは、日本のお祭りでベンチに座っている影絵で、その後ろで花火が上がっています。彼女は扇子を手にしている。お祭りを楽しんでいる影郎は、優しく微笑みながら見る人を見つめている。可能であれば以上です。お時間をいただき、ありがとうございました。\n\nかげろう: https://fireemblem.fandom.com/wiki/Kagero/Gallery", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@oyaji93/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 155948, "client_id": 1041003, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/70e9294d/uploads/origins/9b11c40c-caa8-430f-8a05-004550c71b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b87304b26d6a20a60169f80c5ad29aa2", "srcset": "https://si.imgix.net/70e9294d/uploads/origins/9b11c40c-caa8-430f-8a05-004550c71b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b87304b26d6a20a60169f80c5ad29aa2, https://si.imgix.net/70e9294d/uploads/origins/9b11c40c-caa8-430f-8a05-004550c71b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fb86cb3d8075e59a0906a0b97dc52bd5 2x, https://si.imgix.net/70e9294d/uploads/origins/9b11c40c-caa8-430f-8a05-004550c71b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e895632bca95d5e19119c9d64dac2224 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/70e9294d/uploads/origins/9b11c40c-caa8-430f-8a05-004550c71b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=174f1d6f8e99e8234fb038ce67a95b03", "srcset": "https://si.imgix.net/70e9294d/uploads/origins/9b11c40c-caa8-430f-8a05-004550c71b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=174f1d6f8e99e8234fb038ce67a95b03, https://si.imgix.net/70e9294d/uploads/origins/9b11c40c-caa8-430f-8a05-004550c71b7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9adf5c23ea0ff30be96164cf