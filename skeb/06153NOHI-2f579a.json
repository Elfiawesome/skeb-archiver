変えられてしまいました。呪いによってこの世界に閉じ込められており、故郷に帰るための解呪を求めています。\n\nお好きなように描いてください。\nご協力ありがとうございます。\n\nhttps://drive.google.com/drive/folders/1cRbGk1VlTCy_D-R_8m8tipJHQWh-p77q?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@06153NOHI/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3354898, "client_id": 3743736, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f50ef839/uploads/origins/79afcda3-de87-44a3-b237-9fc82f9a4b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b040b65df60912e39e86ddee52e77456", "srcset": "https://si.imgix.net/f50ef839/uploads/origins/79afcda3-de87-44a3-b237-9fc82f9a4b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b040b65df60912e39e86ddee52e77456, https://si.imgix.net/f50ef839/uploads/origins/79afcda3-de87-44a3-b237-9fc82f9a4b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c841ae362a5f717eb514f4a10a48b660 2x, https://si.imgix.net/f50ef839/uploads/origins/79afcda3-de87-44a3-b237-9fc82f9a4b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5b714157332f0cb128e777d524126eea 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f50ef839/uploads/origins/79afcda3-de87-44a3-b237-9fc82f9a4b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5660c59d3e2fc62cbe5a0593865089d", "srcset": "https://si.imgix.net/f50ef839/uploads/origins/79afcda3-de87-44a3-b237-9fc82f9a4b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e5660c59d3e2fc62cbe5a0593865089d, https://si.imgix.net/f50ef839/uploads/origins/79afcda3-de87-44a3-b237-9fc82f9a4b0c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=71a15da00ab8dee4d9b99b5d1431c69b 2x, https://si.