mgix.net/19fadd79/uploads/origins/60846710-2e75-40c1-bd98-6ac23b5b310f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bdc778753db01741de29ab90e87e2b29 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/19fadd79/uploads/origins/60846710-2e75-40c1-bd98-6ac23b5b310f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2443b38f69f0bde309e5988ac7df3432", "srcset": "https://si.imgix.net/19fadd79/uploads/origins/60846710-2e75-40c1-bd98-6ac23b5b310f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2443b38f69f0bde309e5988ac7df3432, https://si.imgix.net/19fadd79/uploads/origins/60846710-2e75-40c1-bd98-6ac23b5b310f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ceefacc4c95cebc1d66ea6ba7d2b2b9b 2x, https://si.imgix.net/19fadd79/uploads/origins/60846710-2e75-40c1-bd98-6ac23b5b310f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=936f82d606164bbfc864b79adc78d447 3x"}, "body": "お世話になっております。\n以下仕様です（顔はこれでもかって言うくらいかわいく）\n・制服女子（リボンは色を水色に変更しておおきく。ブレザーは今までに無いような独創的でかわいいデザインを希望します。ブレザー・ブラウスははだけて、おっぱいが出ている。体育座り、向きは正面、パンティ を履いているが、おまんこが全開に見えるように左手でずらす）下着の色はピンク色。\n・おっぱいは中の上（お椀型）\n・丸眼鏡（はっきりわかるように、下方向に少しずれるとなお可）\n・右手で女子高生ピース顔の横でピース）小悪魔みたいな不敵な笑み。\n・台詞「お兄ちゃん、私のおっぱいとおまんこ見てちんこ勃ってるの？このへ・ん・た・い♡。悔しかったら、わたしの膣にちんこ入れてみせなさいよ」（手書きで）\n ・髪の毛の色（茶髪）\n・髪型（ツインテールで出来れば結び目に黄色リボンのアクセントが欲しいです）\n・スカートは青色でチェック柄で短め\n・靴はローファー\n・サイズは横「1920*縦1080ピクセル」でお願いします。納品ファイル形式は、psd、jpgでお願いします。\n・上下左右見切りが無いようにお願いします。\nご検討の程、よろしくお願いいたします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TamakRui/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 11560, "client_id": 507423, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9d9dfc9/uploads/origins/74b3c4e7-e421-439c-93c1-98d1f5cb2763?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44ab4b14ad8ffe5ea1b5e455d79b17bb", "srcset": "https://si.imgix.net/e9d9dfc9/uploads/origins/74b3c4e7-e421-439c-93c1-98d1f5cb2763?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=44ab4b14ad8ffe5ea1b5e455d79b17bb, https://si.imgix.net/e9d9dfc9/uploads/origins/74b3c4e7-e421-439c-93c1-98d1f5cb2763?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=657a642310e9c170348aca98906d6784 2x, https://si.imgix.net/e9d9dfc9/uploads/origins/74b3c4e7-e421-439c-93c1-98d1f5cb2763?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8697a5ad803a2d9191289b39aca3ab49 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e9d9dfc9/uploads/origins/74b3c4e7-e421-439c-93c1-98d1f5cb2763?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=116ba9d02786becc0203e92e8da9bf1a", "srcset": "https://si.imgix.net/e9d9dfc9/uploads/origins/74b3c4e7-e421-439c-93c1-98d1f5cb2763?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=116ba9d02786becc0203e92e8da9bf1a, https://si.imgix.net/e9d9dfc9/uploads/origins/74b3c4e7-e421-439c-93c1-98d1f5cb2763?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7025e826ad7c4042999879ffe1a49b75 2x, https://si.imgix.net/e9d9dfc9/uploads/origins/74b3c4e7-e421-439c-93c1-98d1f5cb2763?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f96b6195f7b98b3bddc154b3c02357da 3x"}, "body": "水瀬るい様\n\n犬耳、尻尾の巫女の女の子が種子島(鉄砲)で射撃姿勢を取っている、もしくは射撃している絵を描いていただけないでしょうか。\n\n詳細\n犬種　柴犬、秋田犬、北海道犬、甲斐犬、紀州犬、四国犬の中からお願いします。\n髪、瞳の色　上記で選んだ犬種を基準にお願いします。(髪型と長さは任せます)\n射撃姿勢　立ち射ち、膝射ち、座り射ち、寝射ちの中からお願いします。指を引き金にかけて、今にも射撃をしそうな状況、あるいは射撃している状況をお願いします。\n種子島　一般的な大きさである小筒のほか、大型である中筒、士筒のどれを使っていても構いません。\n巫女装束　巫女装束は丈が短かったり肩に切れ込みがある創作特有のものではなく、正規の物をお願いします。また、損傷していても構いません。\n表情　恐怖で怯えている以外でしたら好きに描写して構いません。(例　落ち着いた感じで淡々としている、不敵な笑みを浮かべている、穏やかに微笑んでいる、戦闘狂染みている、自我を失っている等)\n胸部　貧から爆までの範囲でお任せします。\nその他　早合「http://www.xn--u9j370humdba539qcybpym.jp/part1/archives/35」、「https://www.meihaku.jp/arquebus-basic/matchlock-launchmethod/」を首から下げている。(または袈裟懸けで下げている)\n負傷描写等　一切なくても構いませんし、軽傷または重傷でありながらも堪えている、ないしはものともしないような描写でも構いません。また、土や泥の汚れについても任せます。\n巫女装束が損傷していても構いませんが、下着等が露出することがないようにお願いします。\n場所等　特に指定はしません。また、周囲に死体等が転がっていても問題ありません。\n\nセリフ等差分\n内容等に合うものを委任します。\n\n水瀬るい様の発想に頼るところが大きいですが、何卒よろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TamakRui/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/73c40ddf/uploads/origins/19671d5d-94ed-4257-afa7-b588c32fbfaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=65b14778a4c50d0c8ce3dd9a812520ad", "srcset": "https://si.imgix.net/73c40ddf/uploads/origins/19671d5d-94ed-4257-afa7-b588c32fbfaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=65b14778a4c50d0c8ce3dd9a812520ad, https://si.imgix.net/73c40ddf/uploads/origins/19671d5d-94ed-4257-afa7-b588c32fbfaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=549d95e0d399cfca53bea7bb9831b731 2x, https://si.imgix.net/73c40ddf/uploads/origins/19671d5d-94ed-4257-afa7-b588c32fbfaf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c46b67e03711e11a679f802f6abda55d 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 11560, "nc": 161}, {"path": "/@TamakRui/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 11560, "client_id": 759196, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a7cf3f73/uploads/origins/7ab1e197-14b7-4122-8c7b-60ead831b865?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4a399d644944d16cffc2a4c513f2c5a", "srcset": "https://si.imgix.net/a7cf3f73/uploads/origins/7ab1e197-14b7-4122-8c7b-60ead831b865?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4a399d644944d16cffc2a4c513f2c5a, https://si.imgix.net/a7cf3f73/uploads/origins/7ab1e197-14b7-4122-8c7b-60ead831b865?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f48781ac9e7479b0ce255b3fb781b4a7 2x, https://si.imgix.net/a7cf3f73/uploads/origins/7ab1e197-14b7-4122-8c7b-60ead831b865?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5cb44182b31b8496075e045a1193e134 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a7cf3f73/uploads/origins/7ab1e197-14b7-4122-8c7b-60ead831b865?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d02bbb0f1c6ae96ba26f9f9a707c2a2a", "srcset": "https://si.imgix.net/a7cf3f73/uploads/origins/7ab1e197-14b7-4122-8c7b-60ead831b865?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d02bbb0f1c6ae96ba26f9f9a707c2a2a, https://si.imgix.net/a7cf3f73/uploads/origins/7ab1e197-14b7-4122-8c7b-60ead831b865?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=df3a8bb2dc60feeee0714267b77ac30c 2x, https://si.imgix.net/a7cf3f73/uploads/origins/7ab1e197-14b7-4122-8c7b-60ead831b865?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=44c069606146ebb5fabcf309aface4a7 3x"}, "body": "水瀬るい　様\n\nはじめまして。\n新着作品のイラストに惹き付けられまして、リクエストに参りました。\n明るい絵柄と彩色がとても好きです。\n\nhttps://twitter.com/hatake_p0515/status/1568580183292280833\nhttps://twitter.com/hatake_p0515/status/1568580540143652865\n\n描いていただきたいのは、添付URLにございます、ウチの子である千世です。\n元々はドールの子ですが、この子を水瀬るい様のアートテイストで1人の女の子のイラストとして描き下ろしていただきたいです。（当たり前ですが、球体関節は無視してください。）\n\n衣装は写真のままの迷彩ワンピースでお願いします。（少々アレンジが入っても大丈夫です。）\n後頭部に巨大リボンがあるので、そちらも忘れずに描画いただきたいです。\n\nキャラクターのポーズ等に関してはお任せ致します。\n\nいわゆるロリ婆に属するキャラクターで、身長は140cmくらいしかありません。（小学校3、4年生の女児並だと思います。）\n性格は厳格な面もありますが、基本的に人懐っこくて世話好きの田舎のおばあちゃんって雰囲気が強い子です。\n\n他のイラストレーター様にリクエストで描き下ろしていただいたこともありましたので、そちらも参考資料として添付致します。もしよろしければそちらも参照なさってください。\nhttps://skeb.jp/@mameiriko/works/25\n\nご検討、よろしくお願いいたします_(._.)_", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TamakRui/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 11560, "client_id": 859605, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a4b567c4/uploads/origins/09882cd0-b035-4625-98b7-5233a3144bc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3abaeee10c01e2b528b606f24f0fdac", "srcset": "https://si.imgix.net/a4b567c4/uploads/origins/09882cd0-b035-4625-98b7-5233a3144bc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3abaeee10c01e2b528b606f24f0fdac, https://si.imgix.net/a4b567c4/uploads/origins/09882cd0-b035-4625-98b7-5233a3144bc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=db3b613d3a2c915e2044ce60e5151fcc 2x, https://si.imgix.net/a4b567c4/uploads/origins/09882cd0-b035-4625-98b7-5233a3144bc6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4ce4183fa35632a80b0afb01b217ddb9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a4b567c4/uploads/origins/09882cd0-b035-4625-98b7-5233a3144bc6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7ca5c504aad1a5a9a08270e559b128e", "srcset": "https://si.imgix.net/a4b567c4/uploads/