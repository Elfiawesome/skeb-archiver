 latest art with the Pepes on the boyfriend and girlfriend's head and I'd like to buy her one as a gift. Could you draw my friend EvelynnDE in the same style with a Pepe on her head?\n\nhttps://imgur.com/a/gtnh68d", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@chiitsune_/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2222911, "client_id": 1548546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fc43182f/uploads/origins/a27a8698-dcd8-4b47-9fa2-f43243d16118?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d88a10ea961fb998407851a3b571897a", "srcset": "https://si.imgix.net/fc43182f/uploads/origins/a27a8698-dcd8-4b47-9fa2-f43243d16118?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d88a10ea961fb998407851a3b571897a, https://si.imgix.net/fc43182f/uploads/origins/a27a8698-dcd8-4b47-9fa2-f43243d16118?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6e38a8538d5c808b9512f13d7c3f22c 2x, https://si.imgix.net/fc43182f/uploads/origins/a27a8698-dcd8-4b47-9fa2-f43243d16118?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f59e5825462dfac4a40865400f8c71c6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fc43182f/uploads/origins/a27a8698-dcd8-4b47-9fa2-f43243d16118?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0cf6517d760e0cf7cf68ec5f170925de", "srcset": "https://si.imgix.net/fc43182f/uploads/origins/a27a8698-dcd8-4b47-9fa2-f43243d16118?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0cf6517d760e0cf7cf68ec5f170925de, https://si.imgix.net/fc43182f/uploads/origins/a27a8698-dcd8-4b47-9fa2-f43243d16118?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b47c6ed7bd