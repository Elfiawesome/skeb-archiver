RIVATE&s=f98d8e25d27907243fe7fced2268fdfd 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1979471, "client_id": 3851375, "nc": 17}, {"path": "/@Urinosuke_TRPG2/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 1979471, "client_id": 2984957, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/509f4e3b/uploads/origins/fd60929e-ee3a-4908-af8c-435503871ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6d445116e9f0d915007eee31088d624", "srcset": "https://si.imgix.net/509f4e3b/uploads/origins/fd60929e-ee3a-4908-af8c-435503871ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b6d445116e9f0d915007eee31088d624, https://si.imgix.net/509f4e3b/uploads/origins/fd60929e-ee3a-4908-af8c-435503871ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cf9b6d0957481ee0d818718ce13bcc1e 2x, https://si.imgix.net/509f4e3b/uploads/origins/fd60929e-ee3a-4908-af8c-435503871ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be0350c9fe0e464396a3719d387c1680 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/509f4e3b/uploads/origins/fd60929e-ee3a-4908-af8c-435503871ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62ad291b0c4d3097d672bd67c6089e7b", "srcset": "https://si.imgix.net/509f4e3b/uploads/origins/fd60929e-ee3a-4908-af8c-435503871ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62ad291b0c4d3097d672bd67c6089e7b, https://si.imgix.net/509f4e3b/uploads/origins/fd60929e-ee3a-4908-af8c-435503871ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fe3c2e71f3050e22ba8b9bdae1eadd48 2x, https://si.imgix.net/509f4e3b/uploads/origins/fd60929e-ee3a-4908-af8c-435503871ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d86fa82c57e0ea972ea4531308b07ea9 3x"}, "body": "※快刀乱魔のネタバレ可能性あり\n\nお疲れ様です！アカウントは違うのですが、あんましです。\n快刀乱魔を回していただいた際のうりのすけさんの言葉選びが好きだったので、テキストでの依頼を失礼します！以下の\"どちらか1つ\"を書いていただけると嬉しいです！\n\n・雲之峰彩単体のSS\n強いて言えば、「ついてない話」など、雲之峰が困っていたり焦っていたりするところが見たいです（愉快なため）。もちろん、雲之峰が幸せな話でも嬉しいです。本編の前でも後でもかまいません。\n・快刀乱魔自陣のSS（明るい話）\nこちらはもう明るい話のみでお願いします！！自陣に、もう辛いことは起きないでほしい（快刀乱魔2を除く）。ギャグでもほのぼのでも嬉しいですが、雲之峰以外の誰かがしんどい思いをする話は避けていただきたいです！雲之峰はしんどくなってても別に大丈夫です。\n\n以下、各キャラクターに対する私の認識です。\n・雲之峰彩\nみんなに嫌われたいと思っていたが、本編を通じてまあ…わざわざ嫌われなくてもいいのかな…と思うようになってきたため、2では態度軟化予定。軟化する前は、優し気な敬語でめちゃくちゃ皮肉を言う変人。パペットで自分の言ったことを復唱する。腹話術は別に上手くない。印日ハーフ。\n・大桃小百さん\nかっこいい…。物静かだが、決めるときはバシッと決めてくれるリーダー。鶴の一声という慣用句の体現者。大食いでかわいい。かなり真面目というか、己の信条に反するならば自分自身すらも許さないという高潔さがあると思います。本編後、雲之峰に懐かれている。\n・多々海翔くん\n面白い。たまたま正義の側に生まれたのでド正義になっているが、悪側に生まれたらド悪になっていたはず。己の意思が強い頑固者。真面目で先輩を立てるがかなりの頑固者。夢に向かって一直線すぎる頑固者。まあ、夢のこと以外なら割と柔軟なのかなとも思います。雲之峰にはからかわれたりドン引きされたり。\n・風田川騎兎さん\nかっこいい…。飄々としていてなんでもできる人。皮肉屋な一面もあるが、色んな人に好かれている。画面見ないまま片手でタイピングできそう。なろう系に出てくるとしたら、初登場時はだらしないが実力者のおじさんポジだと思う。雲之峰とはギスったり仲良くしたり。\n\nテキストの依頼は初めて行うので、何か不手際がありましたら申し訳ありません。もしご都合合えばよろしくお願いします！", "nc": 129, "word_count": 11052, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@Urinosuke_TRPG2/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 1979471, "client_id": 2440698, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b29938ff/uploads/origins/7054ec2a-bcef-4258-b5a3-d33468bee232?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4afa029caf262c2b76597c56d4bbef15", "srcset": "https://si.imgix.net/b29938ff/uploads/origins/7054ec2a-bcef-4258-b5a3-d33468bee232?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4afa029caf262c2b76597c56d4bbef15, https://si.imgix.net/b29938ff/uploads/origins/7054ec2a-bcef-4258-b5a3-d33468bee232?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2d0d