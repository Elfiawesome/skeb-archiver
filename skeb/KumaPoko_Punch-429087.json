o=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0fcbde09d4a0012c8738e469d919f5b0 3x"}, "body": "くまぽこぱんち様\n\n初めまして、\nいつもキュートで愛らしい絵柄や、セクシーなシーンまで幅広い作品に癒されております。\n\n早速内容で恐縮なのですが、\n\n作品・キャラクター\n「リトルバスターズ!EX」より、「二木佳奈多」\n（参考ピクシブ大百科：https://dic.pixiv.net/a/%E4%BA%8C%E6%9C%A8%E4%BD%B3%E5%A5%88%E5%A4%9A）\n\nシチュエーション\nドレスの佳奈多と逃避行して、そのままのベッドで愛し合うシーンになります。\n（参考衣装：https://tsundora.com/347508）\n\n詳細\n・服装等\n基本的にショールや手袋はしたままで、ドレスの胸を降ろしはだけていて、\n下は下半身が出るように上げている状態。\n\n・行為等\n男子の1人称視点で基本映らない形で、佳奈多は正常位の体勢で片手で性器を開いている様子。\n可能な範囲で事後の顔や胸、中出し等の精液差分をお願いしたいです。\n\n・表情等\n基本的には涙目に笑顔で喜んでいる様子。\n相手が映らないキスしている顔もあるとありがたいです。\n\n以上となります。\n長々としていて恐縮です。\nもしご縁がありました際はよろしくお願いいたします。\n\nこれからもくまぽこぱんち先生を応援しております。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@KumaPoko_Punch/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1523445, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a5d49b2/uploads/origins/fd57d6fa-05c4-4064-b251-5add8352d44b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cf48c1a3ccdab26c3452294c0b9aa82", "srcset": "https://si.imgix.net/8a5d49b2/uploads/origins/fd57d6fa-05c4-4064-b251-5add8352d44b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8cf48c1a3ccdab26c3452294c0b9aa82, https://si.imgix.net/8a5d49b2/uploads/origins/fd57d6fa-05c4-4064-b251-5add8352d44b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=83b84fd67345b6bb4d62e14aa5cf7e9a 2x, https://si.imgix.net/8a5d49b2/uploads/origins/fd57d6fa-05c4-4064-b251-5add8352d44b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5c14cf4317a9fb2098175abd4b05990f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8a5d49b2/uploads/origins/fd57d6fa-05c4-4064-b251-5add8352d44b?bg=%23fff&auto=format%2Ccompress&fm=w