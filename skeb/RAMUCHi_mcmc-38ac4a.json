//si.imgix.net/d623d21b/uploads/origins/ad819bd7-6f93-433c-8e15-c848a6915bd7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aed687b3e20183040d11d4ae0eaa10ba 3x"}, "body": "初めまして、マゾ向けの同人声優として活動しております、紗倉かのんと申します。\nskebでRAMUCHi様のイラストを拝見して自分もお願いしたくご連絡させていただきました。\n水着の女の子のおっぱいの肉感がすごく素敵でした！\n\n使用用途\n音声作品、SNSでの宣伝活動\n\nサイズ\n3：4の大きさでお願いいたします。(横長)\n人物と背景がレイヤー分けできるデータでいただけるとありがたいです。\nまた人物のみの透過素材もいただけるとありがたいです\n\n構図\nベッドの脇に座り、足を組んでいる。(足先まで見えるとありがたいです。)\n露出度が高いワンピースを着ている(胸はおおきめで、えっちに露出させ乳首まで見えている)\n片手でワンピースをめくっている。\nワンピースの中はえっちな下着をはいている。\n下着には使用済みコンドームが括り付けられている。\n女の子は悪そうな笑顔でくすっと笑っている。\n女の子は茶髪の髪色で背中あたりまで髪がある。(後ろに流していただいて大丈夫です。)\n\n以上になります。\n描きにくい部分は、RAMUCHi様の描きやすいように書いていただいて構いませんのでよろしくお願いいたします。\nワンピースで書きにくいようでしたらえっちなベビードールのようなものでも大丈夫です。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@RAMUCHi_mcmc/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2786327, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2e2b5736/uploads/origins/832e4698-1924-463f-9f85-79f57dbcdb62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b9dfeb44f16376039e5ab0b9bfa4afd", "srcset": "https://si.imgix.net/2e2b5736/uploads/origins/832e4698-1924-463f-9f85-79f57dbcdb62?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b9dfeb44f16376039e5ab0b9bfa4afd, https://si.imgix.net/2e2b5736/uploads/origins/832e4698-1924-463f-9f85-79f57dbcdb62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=91612ff7ba308d72ddc408458429ec7d 2x, https://si.imgix.net/2e2b5736/uploads/origins/832e4698-1924-463f-9f85-79f57dbcdb62?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=21da8edc2b933c7fba6e26b5c025bafe 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2e2b5736/uploads/origins/832e46