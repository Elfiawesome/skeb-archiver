＆ピンク→黒＆ピンクに変更。元の衣装をぴっちりタイトにして光沢のあるボンデージ風衣装です\n黒のサイハイブーツ(ヒール付き)＆指先から二の腕まで覆う黒のロング手袋\nブーツと手袋には元の衣装のデザインが取り込まれていると嬉しいです(腕部分の宝玉？みたいのがついてるなど)\n腰回りは金色のベルト？はそのままでスカートはシースルーで前掛けなしで股間部分のレオタードが見えるように。股間部分はスリットが入っている(脱がずに挿入できるようにレオタードの股間部にマンすじのような切れ目がある。秘所は書かなくて大丈夫です)\n黒く先端がハート形になっている尻尾あり\n表情は妖艶な笑み\n全身立ち絵でお願いします。ポーズの詳細はお任せします\n全体的に淫魔らしく誘惑しているような感じでお願いします\n以上になります。お忙しいことと思いますがご検討よろしくお願いします", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@acfa_fragment/works/85", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5366bedb/uploads/origins/ae9d1059-16a7-4bc1-981b-3bd81f10ebe4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=da8a3c894febbc8c639332979b4b6017", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2847665, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@acfa_fragment/works/84", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0e367c7a/uploads/origins/e63ad299-114d-486a-aa7e-925f98442c36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bed467dc6f4120d35e031960bfcfbbee", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2847665, "client_id": 913401, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@acfa_fragment/works/83", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": tr