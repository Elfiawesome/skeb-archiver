t=crop&crop=top&w=200&h=200&blur=200&s=a67ce3b3a99464f6ca95a60763373e32, https://si.imgix.net/d12000a5/uploads/origins/9e1f27e7-e6bd-4464-9846-2ba8cb456188?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d62fed952039531a18939d4e89859c9f 2x, https://si.imgix.net/d12000a5/uploads/origins/9e1f27e7-e6bd-4464-9846-2ba8cb456188?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3f64385919d3d25fd4d517861b6a0d82 3x"}, "body": "ほしのむこう様、初めまして。メッセージ失礼します。\nこの度描いてほしいイラストがあり、依頼させていただきました。\n内容は以下になります。\n\n作品名：アサルトリリィ\n人物名：初鹿野瑤さん\n背景：おまかせ\n詳細：瑤さんが保育園の先生になったら、というシチュエーションのイラストをお願いします。\n年齢はそのまま。私服の上に薄桃色のエプロンを羽織り、片手にクマのパペットを装着しています。私服は公式で着たものでも、ほしのむこう様が考えたものを着せても構いません。\n目線はこちら（閲覧者）を向いていて、表情は笑顔です。\n\n以上になります。ここまでお読みくださりありがとうございます。\n指示が多くなってしまい申し訳ありませんが、もし受けていただけるなら幸甚の至りです。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hosino__mukou/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2768346, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/106a53f7/uploads/origins/18bba297-c076-4db6-8719-5b15be4a29ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73ab10d8d30cbe1b1c5480fc5ff1c38a", "srcset": "https://si.imgix.net/106a53f7/uploads/origins/18bba297-c076-4db6-8719-5b15be4a29ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=73ab10d8d30cbe1b1c5480fc5ff1c38a, https://si.imgix.net/106a53f7/uploads/origins/18bba297-c076-4db6-8719-5b15be4a29ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=711e224febe43eb6df2d16729756fdef 2x, https://si.imgix.net/106a53f7/uploads/origins/18bba297-c076-4db6-8719-5b15be4a29ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f95d71fced1d992b9257b02d19fe639 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/106a53f7/uploads/origins/18bba297-c076-4db6-8719-5b15be4a29ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffa1367a258abc491ebd4c2f4a1914a9", "srcset": "https://si.imgix.net/106a53f7/uploads/origins/18bba297-c076-4db6-8719-5b15be4a29ff?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffa1367a258abc491ebd4c2f4a1914a9, https://si.imgix.net/106a53f7/uploads/origins/18bba297-c076-4db6-8719-5b15be4a29ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=00aa79073c5fe95e0eee74fa83e8c530 2x, https://si.imgix.net/106a53f7/uploads/origins/18bba297-c076-4db6-8719-5b15be4a29ff?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ed77a4e54e3292ab7094272cfb41f330 3x"}, "body": "以前描かれてた　あらりり　ゆゆいちの入れ替わりが良かったので\n今回はその逆の　あらゆゆ　いちりりの入れ替わりを頼みたいです\n\n\n入れ替わった四人はそれぞれの身体の方のレギオンのところへいて\n\n\n一柳隊サイドは　夢結（亜羅椰）が本気半分からかい半分で、梨璃へと　今晩姉妹で本質的な語らいをしないかと持ち掛ける\n表情は亜羅椰的ないつもの妖艶？な感じで　ガチで口説きに言ってる感じ？です\nそれで梨璃（壱）は赤面してプンプン怒る\n夢結も梨璃もおかしいのでみんなは当然驚く\n\n\nアールヴへイムサイドは　亜羅椰（夢結）がいつもみたいな問題発言などをしない、そしていつもより落ち着いているし\n壱（梨璃）もいつものツンケンしてる様子は全くなく、亜羅椰（お姉さま）LOVEって感じが漏れ出していてべた甘で\nそれに対する亜羅椰（夢結）もいつもの感じでなく、シルトを愛でる姉のような空気感なので他のメンバーは唖然とする\n\n\nみたいなのお願いします！！細かいとこは自由にしてください！！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hosino__mukou/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/43e871d0/uploads/origins/1df88237-fdb9-4cc5-89f5-3de73757481e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=c04158b26baaa8afa142f82a69ec5466", "srcset": "https://si.imgix.net/43e871d0/uploads/origins/1df88237-fdb9-4cc5-89f5-3de73757481e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsiz