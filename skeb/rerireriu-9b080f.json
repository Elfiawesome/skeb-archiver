式は透過PNGかPSDを頂ければ嬉しいです。\n\n\n用途はXでの投稿や収益化したライブ配信や動画、アイコンやヘッダー使用、ネットプリント、グッズ、ファンボックスなどのVTuberとしての活動で使用させていただければと思っております。\n\n立ち絵などの資料は下記URLから確認していただければと思います。\n\n\n\nスケブでの依頼は慣れていないので至らない点があると思いますが、よろしくお願いします。\n\n\n\n\n\nhttps://lit.link/mewaurora\n\nhttps://lit.link/mewaurora", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@rerireriu/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2968990, "client_id": 2802663, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1c147d4e/uploads/origins/1a082c0b-cb1d-428f-9b61-121c8c739fde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e98fc6bd09f44b6dc3ed6455287f24f6", "srcset": "https://si.imgix.net/1c147d4e/uploads/origins/1a082c0b-cb1d-428f-9b61-121c8c739fde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e98fc6bd09f44b6dc3ed6455287f24f6, https://si.imgix.net/1c147d4e/uploads/origins/1a082c0b-cb1d-428f-9b61-121c8c739fde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=baa453cd667feda0fd694a8244d8d275 2x, https://si.imgix.net/1c147d4e/uploads/origins/1a082c0b-cb1d-428f-9b61-121c8c739fde?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=67ba11e068794761f149d87fccb066f0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1c147d4e/uploads/origins/1a082c0b-cb1d-428f-9b61-121c8c739fde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02b04311e94eff3686b65bcd5c389977", "srcset": "https://si.imgix.net/1c147d4e/uploads/origins/1a082c0b-cb1d-428f-9b61-121c8c739fde?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=02b04311e94eff3686b65bcd5c389977, https://si.imgix.net/1c147d4e/uploads/origins/1a082c0b-cb1d-428f-9b61-121c8c739fde?bg=%23fff&auto=format%2Ccompress&fm=webp