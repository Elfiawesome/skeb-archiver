こともあり、先生の作品で元気付けてあげたいと思っています。\n\nポーズ、髪型、服装、シチュエーションなどの全てのアレンジはおまかせいたします。\n通常衣裳以外でも、先生のイメージした衣装や姿にアレンジしていただいて構いません。\n（通常衣裳が結構複雑なので断れることが多いので）\nサムネやXポスト等に使用していただく事が多いので、可能であれば縦型で見切れがないとうれしいです。\n\n使用用途はファンアートとしてのプレゼントですが、\n彼女の収益化された配信やSNS、グッズ販売などでも使用してもらいたいと考えています。\nキャラクターのみのPSDデータ、もしくは透過PNGデータ等も併せて頂けますと幸いです。\n\nご検討よろしくお願いいたします。\n\nhttp://lit.link/torimunemomo", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@future0_00/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2674515, "client_id": 3820918, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2cf37578/uploads/origins/f543874c-f6a1-4dee-9950-1daa4935f69e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12c7329a240235e40d4a1029a559bbb7", "srcset": "https://si.imgix.net/2cf37578/uploads/origins/f543874c-f6a1-4dee-9950-1daa4935f69e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12c7329a240235e40d4a1029a559bbb7, https://si.imgix.net/2cf37578/uploads/origins/f543874c-f6a1-4dee-9950-1daa4935f69e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7354deeacb05e9246294a32e31076593 2x, https://si.imgix.net/2cf37578/uploads/origins/f543874c-f6a1-4dee-9950-1daa4935f69e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2e2fd2b926fbc5f3cf3b6efb08a9246 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2cf37578/uploads/origins/f543874c-f6a1-4dee-9950-1daa4935f69e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6863300959f8b60062edaf89cba0212", "srcset": "https://si.imgix.net/2cf37578/uploads/origins/f543874c-f6a1-4dee-9950-1daa4935f69e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6863300959f8b60062edaf89cba0212, https://si.imgix.net/2cf37578/upl