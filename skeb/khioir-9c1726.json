ix.net/cb83849f/uploads/origins/6e83ccf5-726c-4fbd-9ffe-ab2da9f5fba2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7a268f59a88dd635adb8023053283e21, https://si.imgix.net/cb83849f/uploads/origins/6e83ccf5-726c-4fbd-9ffe-ab2da9f5fba2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e93c651ee53de8f21bedb2bdb5f60f9b 2x, https://si.imgix.net/cb83849f/uploads/origins/6e83ccf5-726c-4fbd-9ffe-ab2da9f5fba2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b81701c38367f4196ce45af0e6ce47a2 3x"}, "body": "またまたこんにちは！vi5804さんのウェブ小説「奇跡の探求にほかならない」の「ステラ」をまた描いていただきたいと思います！\nhttps://drive.google.com/drive/folders/1nxSurpHU4p-OVKi3cSfU3iVzfjC2GaLG?usp=sharing\n今回描いていただきたいのは、物語の中でステラがモンスターに捕らえられ、洞窟の壁に縫い付けられているシーンです。モンスターはステラをマインドコントロールし、モンスターを自分の死んだ母親だと思い込ませています。ステラはそれに応え、得意の呪文、死体や破壊された物体を爆発させる呪文を唱え、怪物を殺すために自爆する。\nhttps://suptg.thisisnotatrueending.com/qstarchive/2019/3267884/thumbs/1550719045239.png\n\n彼女が呪文を唱える瞬間を捉えたら素晴らしいだろう。このようなものは美しい（https://files.catbox.moe/zci9kn.jpg）でしょうが、具体的な内容はいつものようにお任せします。ありがとうございました！\n\nモンスターはこんな感じです：\nhttps://drive.google.com/drive/folders/1X9wBjcC4sNnWBX3DXbxBMhfL0gInjOCi?usp=sharing", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@khioir/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1268037, "client_id": 2752312, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f6828e0/uploads/origins/3f2659ea-9ceb-4e91-a7d5-d18ef2401c42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=464c46b5c6d476ece0ce16af98cf726c", "srcset": "https://si.imgix.net/1f6828e0/uploads/origins/3f2659ea-9ceb-4e91-a7d5-d18ef2401c42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=464c46b5c6d476ece0ce16af98cf726c, https://si.imgix.net/1f6828e0/uploads/origins/3f2659ea-9ceb-4e91-a7d5-d18ef2401c42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8241dd7f497d73cf2a304a560985b59a 2x, https://si.imgix.net/1f6828e0/uploads/origins/3f2659ea-9ceb-4e91-a7d5-d18ef2401c42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=be0913d4010b1b19c7e09c4a7a941fc0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1f6828e0/uploads/origins/3f2659ea-9ceb-4e91-a7d5-d18ef2401c42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3028fd69ab119be9eb62b845b36d9ea0", "srcset": "https://si.imgix.net/1f6828e0/uploads/origins/3f2659ea-9ceb-4e91-a7d5-d18ef2401c42?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3028fd69ab119be9eb62b845b36d9ea0, https://si.imgix.net/1f6828e0/uploads/origins/3f2659ea-9ceb-4e91-a7d5-d18ef2401c42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ce7b9530f4868f8190b3557880a357ea 2x, https://si.imgix.net/1f6828e0/uploads/origins/3f2659ea-9ceb-4e91-a7d5-d18ef2401c42?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=883489b78838b898df5fcadb45ff5789 3x"}, "body": "またまたこんにちは！前回のステラの絵がとても気に入ったので、ぜひまたお願いしたいです！\nhttps://drive.google.com/drive/folders/16sis2_ORSGBp0HdMYGIzxlnsYenGP8_W?usp=sharing\n今度は、(2021-03-08 14.50.14)のような昆虫の甲羅と鳥の羽が融合したステラを見てみたいです。ステラは、(https://skeb.jp/@khioir/works/12)の余波で目を覆っていた包帯を解いている。左目があった場所には、暗くて空洞の空洞が見える(https://files.catbox.moe/cduqqs.png)。その空洞の中に不気味なエルドリッチの花があって、見る者を見つめ返しているように見えるようにしたい。また、ステラには疲れ果てて嫌そうな顔をしていてほしい。できるだけ不気味な絵にしてください。具体的なことはお任せしますので、よろしければお願いします。ありがとうございました！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@khioir/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1268037, "client_id": 2752312, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/730c553a/uploads/origins/d6b7afd2-88a5-476b-81d0-3009881acfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9d983e5b204a6c60b1a6ce83bf5a258", "srcset": "https://si.imgix.net/730c553a/uploads/origins/d6b7afd2-88a5-476b-81d0-3009881acfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9d983e5b204a6c60b1a6ce83bf5a258, https://si.imgix.net/730c553a/uploads/origins/d6b7afd2-88a5-476b-81d0-3009881acfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bab298dd6bb9dd584bec523ead404178 2x, https://si.imgix.net/730c553a/uploads/origins/d6b7afd2-88a5-476b-81d0-3009881acfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e1cb75001ba33021dc9940e5609ffd4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/730c553a/uploads/origins/d6b7afd2-88a5-476b-81d0-3009881acfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81a45718896642306e5a360b2f4e6cf7", "srcset": "https://si.imgix.net/730c553a/uploads/origins/d6b7afd2-88a5-476b-81d0-3009881acfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=81a45718896642306e5a360b2f4e6cf7, https://si.imgix.net/730c553a/uploads/origins/d6b7afd2-88a5-476b-81d0-3009881acfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bb756267b0d76e8aabbeddaf20ba7c9e 2x, https://si.imgix.net/730c553a/uploads/origins/d6b7afd2-88a5-476b-81d0-3009881acfcc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7fa236f59ee2d0d9c00a2fe782d2d41d 3x"}, "body": "こんにちは！Web小説 \"Nothing Short of a Miracle Quest \"の \"Stella \"の絵をお願いします。\nhttps://drive.google.com/drive/folders/1byUjpQY3gqKZX5NLqXt6JHxDZ_yt6qhI?usp=sharing\nステラは異星人の神と契約し、自分の右目を犠牲にして、友人の死を救うために、自分の体と右目から、形、大きさ、色の異なる様々な花を鮮やかに咲かせる。彼女の頬にある黒いもの（『ステラチチン』や『バッドテア』に登場する）は、カラスの羽や溶けた石とともに彼女の皮膚と融合した昆虫のキチンである。\nステラには血を花に見立てるところがあるので、それも含めて描いてもらえると嬉しいです！ありがとうございました！\n\n(例)\nhttps://drive.google.com/drive/folders/1K8uqmj7jNxIGABtCKN6mGoEbLVoxdJqu?usp=sharing\n推奨金額で足りない場合は価格調整をお願いします！\n\nよろしければウェブ小説の原文もどうぞ。\n\n\"選択の余地はほとんどなかった。あなたが欠片を見つめると、親切にも欠片はジェスチャーを返す。\n\nあなたに花が咲く。様々な形、大きさ、色の鮮やかな花が次々と咲き乱れる。あなたの肌は溶けて固まり、きらめいたりくすんだりする。欠片の目には、あらゆるものが屈折し、溶け合う。反射するのは冷たい石とシャカシャカと動く甲羅。あなたは世界と一体となり、手を取り合う。縁に触れると知覚は拡大し、視界はまばゆく濁った炎に滲む。そのとき、あなたは右目の視力を失う。\n\n最初は気づかなかった。見える人は、「黒が見える」のではなく、「何も見えない」ことを知らない。知覚の欠如である。その代わり、新しい視野の端に、何かが広がっているのが見える。メタリックな花がしだれ、あなたの皮膚に芽生えた羽毛と溶け合っているのだ。\"", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@khioir/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/519067da/uploads/origins/f979f3c4-6804-48ce-b077-f951e0b182f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5bd8eea67a5b3c4808cdd3687e57f4e5", "srcset": "https://si.imgix.net/519067da/uploads/origins/f979f3c4-6804-48ce-b077-f951e0b182f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=5bd8eea67a5b3c4808cdd3687e57f4e5, https://si.imgix.net/519067da/uploads/origins/f979f3c4-6804-48ce-b077-f951e0b182f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e70e1351f8e225722bf1dd04bb9383c1 2x, https://si.imgix.net/519067da/uploads/origins/f979f3c4-6804-48ce-b077-f951e0b182f0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7325da03d6c657e7eda601c236a753b2 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1268037, "client_id": 24719