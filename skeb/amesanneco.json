1238d88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a3fbb9235cfd0f4de3a2204e1ae67323 2x, https://si.imgix.net/61232c23/uploads/origins/8196f034-f0a2-4baa-abb3-f1b681238d88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dcf467b7393b56d18d00ddf35de85d46 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61232c23/uploads/origins/8196f034-f0a2-4baa-abb3-f1b681238d88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f54f1c85b3e78a3021773df6ad3a1a9", "srcset": "https://si.imgix.net/61232c23/uploads/origins/8196f034-f0a2-4baa-abb3-f1b681238d88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f54f1c85b3e78a3021773df6ad3a1a9, https://si.imgix.net/61232c23/uploads/origins/8196f034-f0a2-4baa-abb3-f1b681238d88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ed9a9c16fa7d89e898fc125d358d7bc5 2x, https://si.imgix.net/61232c23/uploads/origins/8196f034-f0a2-4baa-abb3-f1b681238d88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=53556ee2451b3a30cd78c9f2d6a93fb6 3x"}, "body": "【衣装】\n公式の香取型衣装または後述の怪我の具合によって陸奥改と香取型のハイブリッド衣装等でも大丈夫です。\n修理改装（後の改二）期間中に教導艦任務を受けたという設定で考えています。\n\n【構図】\n第三砲塔の主砲火薬庫爆発事故を受けて怪我してる状態で、候補生（描写なし）との出会いのシーンを描いて頂けないでしょうか。\n史実では沈没に至った事故がここでは沈没は免れて修理期間となっているので怪我の加減の描写についてはお任せしたいです。\n\n【セリフ】\n陸「戦艦陸奥、本日よりキミの教導艦として着任するわ。ちょっと修理中の部分もあるけど、よろしくね」\n\n過去二回の依頼でも、とても気に入る納品にしてくださったので、必要な部分はアレンジして頂けると嬉しいです。\nまた描いて頂けるのをとても楽しみにしています。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@amesanneco/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2690715, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/445ea78d/uploads/origins/93460423-f91b-4c06-bd07-13272fe476d4?bg=%23fff&auto