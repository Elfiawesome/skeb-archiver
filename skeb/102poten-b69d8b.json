した。\n良ければ今度は、うちの子の竜人の姿を手掛けて頂けませんか？\n\nお願いしたい子は、エリクシルという名前の白い竜人のお姉さんになります。\n身長は195cmくらいになる大柄めな子で、大人のお姉さん系の性格の子です。\n以前手掛けて頂いた白いドラゴンが竜人になった姿で、純粋なパワーはドラゴン形態に比べればずっと控えめになりますが、それでも魔法全般を司る力に秀でています。\n\n今回も、構図やポーズ、シチュエーションはお任せで、この子の姿を自由に手掛けて頂けますととても嬉しく思います。\n\nぜひともご検討をよろしくお願いいたします。\n\n立ち絵\nhttps://x.com/kuitirakasi/status/1489948727586717696\n\nデカい竜お姉さん\nhttps://x.com/shiki_2p/status/1742818492515311964\n\n三面図\n\nhttps://x.com/kuitirakasi/status/1607377880086118400", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@102poten/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2928294, "client_id": 584710, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/702284b5/uploads/origins/c4b41b25-5194-4e1b-bd24-e1d0495092aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26b096909df24b00cdde01bbf3627803", "srcset": "https://si.imgix.net/702284b5/uploads/origins/c4b41b25-5194-4e1b-bd24-e1d0495092aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26b096909df24b00cdde01bbf3627803, https://si.imgix.net/702284b5/uploads/origins/c4b41b25-5194-4e1b-bd24-e1d0495092aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f5769554b661ff94ff2253793e54b51c 2x, https://si.imgix.net/702284b5/uploads/origins/c4b41b25-5194-4e1b-bd24-e1d0495092aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ec4ed800adb0ff79455fa717c0b585ea 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/702284b5/uploads/origins/c4b41b25-5194-4e1b-bd24-e1d0495092aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ea1f0f7e0920a38b1fcb0d6edd5d7820", "srcset": "https://si.imgix.net/702284b5/uploads/origins/c4b41b25-5194-4e1b-bd24-e1d0495092aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cr