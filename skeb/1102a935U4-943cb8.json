-430b-a0ec-8d64594130e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88f80001d2aed3d6cf2a95103943da58", "srcset": "https://si.imgix.net/1ae47963/uploads/origins/05fff1df-e515-430b-a0ec-8d64594130e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88f80001d2aed3d6cf2a95103943da58, https://si.imgix.net/1ae47963/uploads/origins/05fff1df-e515-430b-a0ec-8d64594130e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eb98428f34f164e16e93c460e60f8746 2x, https://si.imgix.net/1ae47963/uploads/origins/05fff1df-e515-430b-a0ec-8d64594130e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3100b0187f69542844c659b90a2977ce 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1ae47963/uploads/origins/05fff1df-e515-430b-a0ec-8d64594130e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=097cc00b4c60ead2ace815e222695e94", "srcset": "https://si.imgix.net/1ae47963/uploads/origins/05fff1df-e515-430b-a0ec-8d64594130e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=097cc00b4c60ead2ace815e222695e94, https://si.imgix.net/1ae47963/uploads/origins/05fff1df-e515-430b-a0ec-8d64594130e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0e056af381f3cf7bf5b137f757008c43 2x, https://si.imgix.net/1ae47963/uploads/origins/05fff1df-e515-430b-a0ec-8d64594130e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a993a767a2e87a2987f61891b54b0c82 3x"}, "body": "はじめまして。\n表情豊かなキャラクターと色数を抑えた彩色のイラストがとても好みです。\n\n濁茶さんの「あるいは地下鉄の私」をUTAUのこちぇでカバーしたいので、動画用のイラストを描いていただけませんでしょうか。\n\n■依頼内容\n・こちぇと「カエルの王様」を描いてください。\n紲星あかりや小春六花のイラストを見て立ち絵っぽいものを依頼しようと思い立ったのですが、「タイトスカートあかりちゃん」の躍動感が素晴らしくて、何が正解か分からなくなりました。。。もう完全におまかせします。\n・背景の有無はおまかせしますが、背景アリ（単色塗りつぶしも含む）の場合は別レイヤに分離してください（こちらで背景を使う／使わないを判断したいので）。\n・動画用なので、横長の構図で描