ただきたく。\n\n【コス】\n長袖ユニフォーム+バレーブルマ(サイドにライン入り)+黒の膝サポーター装着。\n\n二見さんは、ユニフォームの裾をブルマの中に入れてる状態で。\n\nユニフォーム・ブルマ・膝サポーターは下記URLを参考になれば。\nhttps://skeb.jp/@minato_az/works/16\n\nユニフォームの高校名及び、ユニフォームとブルマのゼッケン番号はお任せします。\n\n【ポーズ】\n下記URLのイラストのようなポーズで、靴まで全身絵で描いていただけるとありがたいです。\n\n二見さんの表情は柔らかめの笑顔で。\nhttps://www.pixiv.net/artworks/64803016", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kunounaoki2520/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1981868, "client_id": 169260, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b1f0a2b/uploads/origins/6daf572c-4f76-4cdf-b821-3ccd9be888d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a7ed57bb62181ce42e468f81fa2f08f", "srcset": "https://si.imgix.net/6b1f0a2b/uploads/origins/6daf572c-4f76-4cdf-b821-3ccd9be888d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7a7ed57bb62181ce42e468f81fa2f08f, https://si.imgix.net/6b1f0a2b/uploads/origins/6daf572c-4f76-4cdf-b821-3ccd9be888d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c770660f00646ef1f45a6cb7257abcb7 2x, https://si.imgix.net/6b1f0a2b/uploads/origins/6daf572c-4f76-4cdf-b821-3ccd9be888d1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad87a3962a64dae5838f38f892066a08 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b1f0a2b/uploads/origins/6daf572c-4f76-4cdf-b821-3ccd9be888d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8c7abb9613d0d72b8c8866c793348d7", "srcset": "https://si.imgix.net/6b1f0a2b/uploads/origins/6daf572c-4f76-4cdf-b821-3ccd9be888d1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8c7abb9613d0d72b8c8866c793348d7, https://si.imgix.net/6b1f0a2b/uploads/origins/6daf572c-4f76-4cdf-b821-3ccd9b