uto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1ef4168af5debd4f340ee806b2ff9afb 2x, https://si.imgix.net/0c45c2eb/uploads/origins/13d136c2-35e9-4c52-bf9b-cb696c0575cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bf863bb25d244798a50fdcd56586ca5e 3x"}, "body": "KARASU先生こんにちは\n\n内容\nワイン作りの体験があり、マリーちゃんがスリッパを履いたままブドウ踏みをしているイラストを描いて頂きたいのですがよろしいでしょうか？\n(足をあまり汚したくないのでビニール製のスリッパを履いてます)\n\nキャラクター\nブルーアーカイブ\n伊落マリー\n\n服装\n白いワンピース\n足元ですが学校や病院にある緑色の来客用スリッパを履いている状態でお願いします\n(また全身が写っている状態でお願いしたいです)\n\nポーズ\n前回のマリーちゃん同様足裏を見せていて、スリッパの足裏にブドウがこびりついてる感じでお願いします\n\n背景\n草原など\n\n以上になりますが、スリッパを履いている女の子が好きで、今回も描いてもらえると嬉しいです", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kotoringo2525/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2892388, "client_id": 3867260, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dbaad42f/uploads/origins/b37f8bd2-af4f-4775-bf5d-c89e8da00481?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=567c82d05b354e6f2254fb471dbd315a", "srcset": "https://si.imgix.net/dbaad42f/uploads/origins/b37f8bd2-af4f-4775-bf5d-c89e8da00481?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=567c82d05b354e6f2254fb471dbd315a, https://si.imgix.net/dbaad42f/uploads/origins/b37f8bd2-af4f-4775-bf5d-c89e8da00481?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=66c8f90f0dcbf3783b7ea825409456f9 2x, https://si.imgix.net/dbaad42f/uploads/origins/b37f8bd2-af4f-4775-bf5d-c89e8da00481?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=efa257d719af716a239a79b56a3de090 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dbaad42f/uploads/origins/b37f8bd2-af4f-4775-bf5d-c89e8da00481?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b096ab13fa249c8e8c29dd2270fc07d", "srcset": "https://si.imgix.net/dbaad42f/uploads/origins/b37f8bd2-af4f-4775-bf5d-c89e8da00481?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b096ab13fa249c8e8c29dd2270fc07d, https://si.imgix.net/dbaad42f/uploads/origins/b37f8bd2-af4f-4775-bf5d-c89e8da00481?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7c4d8144fab6058344cdeec0f001c738 2x, https://si.imgix.net/dbaad42f/uploads/origins/b37f8bd2-af4f-4775-bf5d-c89e8da00481?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3f4d2160da26ad21676978c0309ec7c4 3x"}, "body": "初めまして、個人VTuberとして活動中の咲坂つむぎと申します。\nこの度はアピールありがとうございます。\nデザインや歌ってみたを褒めていただいたり、暖かい言葉をありがとうございます！\nSNSでKARASU様のイラストを拝見して、とても可愛らしくぜひ私も描いていただきたいと思いリクエストを送らせていただきます！\n\n〇使用用途\n・YouTube(収益化済み)での配信・動画サムネイル 、コミュニティ投稿 \n・Xでのポスト (通常投稿やおはV素材等を組み合わせてのポスト、宣伝等)\n※コラボ配信でも使用させていただく可能性がございます。 \n※サムネイルや配信素材を制作されるクリエイター様の制作サンプル・モデル素材として使用させていただく場合があります。(イラスト自体を再配布・販売する用途ではありません。)\n\n〇イラスト内容\nVTuber「咲坂つむぎ」のイラストを描いていただきたいです。\n天真爛漫でとても元気な性格です。\n黙っているとどこか儚さがあります。\n\n〇参考資料\n・普段歌枠やゲーム配信をメインに活動しております。\n・髪の毛はベージュ〜毛先にかけてさくらピンクのグラデーションになっております。\n・目の中にさくら模様やさくらの花びらがございます。\n・スカートはバルーンスカートになっております。\n資料URL\nhttps://drive.google.com/drive/folders/19E9mtEYcPKHlRFCxJKed6f5_h-G6wwZX\n\n〇希望納品形式\nサムネイルに使用したいためキャラクターのみ使用できるようにpsdデータで頂戴できますと嬉しいです。\n(キャラクターのみ透過されたpngデータでも問題ございません。)\n\n〇その他要望など\nYouTubeのサムネイルへ使用するため、お顔がよく見える構図だと嬉しいです。\n頭の先(帽子がある場合は帽子の先)や髪の毛などは、先端まで切れないように作画いただけますと大変嬉しいです。\n\n内容に不備不足がございましたら、再送リクエストしていただけますと幸いです。\n何卒ご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/19E9mtEYcPKHlRFCxJKed6f5_h-G6wwZX", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kotoringo2525/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2892388, "vtt_url": null, "thumbnail_image_urls": {"src": "htt