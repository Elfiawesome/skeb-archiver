学校や病院にある業務用のビニールタイプのスリッパになります)\n\n背景\n古民家の室内\n背景は細部まで描き込んでなくても、ブルーシートに踏まれたうどんの生地とこれから踏む様の丸まったうどんの生地が置いてあれば大丈夫です\n\nまたうどんの生地は袋などに入ってない、直接踏んでいる状態でお願いしたいです\n\n以上になりますが、スリッパを履いている女の子が好きで描いてもらえると嬉しいです", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kotoringo2525/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2892388, "client_id": 225811, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/31b1c1e7/uploads/origins/b2d86fcf-ae95-4888-816f-ad5401bbaa2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b6bb6a89aa015f29fd9e7965c0303d1", "srcset": "https://si.imgix.net/31b1c1e7/uploads/origins/b2d86fcf-ae95-4888-816f-ad5401bbaa2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b6bb6a89aa015f29fd9e7965c0303d1, https://si.imgix.net/31b1c1e7/uploads/origins/b2d86fcf-ae95-4888-816f-ad5401bbaa2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=28941784012b3fe9edfed6bff76ac27d 2x, https://si.imgix.net/31b1c1e7/uploads/origins/b2d86fcf-ae95-4888-816f-ad5401bbaa2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd073b112336d06c8c79bedaf8480787 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/31b1c1e7/uploads/origins/b2d86fcf-ae95-4888-816f-ad5401bbaa2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59e69738a12838643ceeb62b378323f4", "srcset": "https://si.imgix.net/31b1c1e7/uploads/origins/b2d86fcf-ae95-4888-816f-ad5401bbaa2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59e69738a12838643ceeb62b378323f4, https://si.imgix.net/31b1c1e7/uploads/origins/b2d86fcf-ae95-4888-816f-ad5401bbaa2c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c8467b9a855ddc9cc3f97fa8c8