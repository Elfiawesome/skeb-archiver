o=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fee68c7dc8848efe107bdb24e65926f7 2x, https://si.imgix.net/a5f97e6e/uploads/origins/7f3a53b2-11a6-47b0-8ba8-1f6331fdd921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce44c2583bde3120bcc416ba385b2e00 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a5f97e6e/uploads/origins/7f3a53b2-11a6-47b0-8ba8-1f6331fdd921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=063c347f4cd0bb1e6beaf54f965dd801", "srcset": "https://si.imgix.net/a5f97e6e/uploads/origins/7f3a53b2-11a6-47b0-8ba8-1f6331fdd921?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=063c347f4cd0bb1e6beaf54f965dd801, https://si.imgix.net/a5f97e6e/uploads/origins/7f3a53b2-11a6-47b0-8ba8-1f6331fdd921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=80421e9109bd368b6ea32e96d6dd38fd 2x, https://si.imgix.net/a5f97e6e/uploads/origins/7f3a53b2-11a6-47b0-8ba8-1f6331fdd921?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=01c391ef5a653f3492756d0d791c6e43 3x"}, "body": "始めまして！リャク様の描かれる作品はとても生き生きとしていて素敵ですね！是非私のオリジナルキャラクターの男性カップルを描いていただけないかと思いリクエストさせていただきました。LOVE要素はあってもなくても大丈夫です！\n\n世界観　中世ヨーロッパ風ファンタジー\n\nキャラクター\n・名前　リカルド（攻）\n・32歳くらい\n・男\n・茶髪・くせ毛・少し褐色の肌、緑の眼・隻眼\n・189Cmくらいで筋肉質\n・某国の将軍。貴族父と奴隷の母の間に生まれる。体格を生かした格闘や剣術が得意。性格は誰にでも優しくおおらかで天然人たらし、恋愛事にはちょっと鈍い。お酒好き\n\n・名前　ノクス（受）\n・32歳くらい\n・男・金髪・碧眼・切れ長の目\n・178ｃｍくらい\n・あまり筋肉はない\n・某国の軍師。貴族の次男。頭が切れ、士官学校を首席で卒業。性格は計算高く野心家で口も悪い。プライドが高く素直になれないツンデレ。リカルドに対して激重感情を持っている。お酒には弱く酔うと素直になる。\n\n\n二人は士官学校からの同級生でライバルであり、親友であり、恋人同士という関係です。\n基本的にはノクス(受）の方が激重感情を持っていて、プライドの高さからなかなか素直になれなくて冷たくあたってしまいますが、そんなところもリカルド(攻）は可愛いなと思っていて、二人は付き合って10年くらいの熟年カップルです。\n\nポーズやシチュエーションはリャク様がこの二人から思いつくイメージで自由に描いていただきたいです。\nhttps://skeb.jp/@ryaku_i/works/3ような感じで漫画形式ですと嬉しいです。\n\n下記にキャラクターのメモと参考画像をＵPしておりますが、リャク様のほうで衣装や髪形など自由にアレンジしていただいて大丈夫です！\n\n是非リャク様に私うちの子を描いていただけるととっても嬉しいので、ご検討のほど、何卒宜しくお願い致します。\n\nhttps://www.dropbox.com/sh/uv9wnsidzr6twz0/AAA5vC37fdrbz0gN8fwBXv1oa?dl=0", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ryaku_i/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 502032, "client_id": 1179131, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e1dcfd38/uploads/origins/a92b632f-43e3-4521-a6b2-e21b76e5b76f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1971559de69b029d1bd02fef1f345609", "srcset": "https://si.imgix.net/e1dcfd38/uploads/origins/a92b632f-43e3-4521-a6b2-e21b76e5b76f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1971559de69b029d1bd02fef1f345609, https://si.imgix.net/e1dcfd38/uploads/origins/a92b632f-43e3-4521-a6b2-e21b76e5b76f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dcd7ac3050b8f5c0dcc81a378ce050f6 2x, https://si.imgix.net/e1dcfd38/uploads/origins/a92b632f-43e3-4521-a6b2-e21b76e5b76f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=76bbe2de9656226fa2612ef1b43f2565 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e1dcfd38/uploads/origins/a92b632f-43e3-4521-a6b2-e21b76e5b76f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9cec89853aa3274845a35c20fda225d", "srcset": "https://si.imgix.net/e1dcfd38/uploads/origins/a92b632f-43e3-4521-a6b2-e21b76e5b76f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d9cec89853aa3274845a35c20fda225d, https://si.imgix.net/e1dcfd38/uploads/origins/a92b632f-43e3-4521-a6b2-e21b76e5b76f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fbae22ad2fe56894c63e16b46ec06e21 2x, https://si.imgix.net/e1dcfd38/uploads/origins/a92b632f-43e3-4521-a6b2-e21b76e5b76f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7d522c1955be16dc8593bd267b81fcf8 3x"}, "body": "お久しぶりです！先生はお元気でしょうか？また、以前の作品では本当にありがとうございました！私の3人のOCのrkgkページ（コンビページ）を描いていただけませんか？\n\n先生には現代パロでビーチで遊んでいるところを描いてほしいです。\n (ネイサンのメガネとソレルの白髪は描かなくていいです。ブレントは、外見に違いはありません）。\n以下のシーンを描いてください：\n\n1.ソレルとブレントが水鉄砲合戦やバレーボールで激しく戦っている。ネイサンはライフガードとして遠巻きに見ていて、あえて近づかない、\n2.ソレルがネイサンを砂に埋めて、頭だけ出している、\n3.ソレルとブレントが口論している間、ネイサンは喧嘩を仲裁するために二人の間に立とうとするが、彼は背が低く、二人は彼を無視しているようだ。\n\n二人の服装やその他は自由に決めてください！\n\n可能であれば、別のレイヤーにサインを入れたpsdファイルを提供してください。\n私の依頼を読んでくれてありがとう！もしお気に召さないようでしたら、遠慮なく直接キャンセルしてください。\n\nhttps://drive.google.com/drive/folders/1vq4ZYk0RRzHfAml3AwNNtoJfQZqVeEr7?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ryaku_i/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 502032, "client_id": 1066282, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/73023e54/uploads/origins/9c47af33-db06-4c9f-b795-14f51accc9f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=553212728cab0e4341e1e4f163e09ccf", "srcset": "https://si.imgix.net/73023e54/uploads/origins/9c47af33-db06-4c9f-b795-14f51accc9f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=553212728cab0e4341e1e4f163e09ccf, https://si.imgix.net/73023e54/uploads/origins/9c47af33-db06-4c9f-b795-14f51accc9f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e58dece24642511c612745d15dba1555 2x, https://si.imgix.net/73023e54/uploads/origins/9c47af33-db06-4c9f-b795-14f51accc9f6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=895290ce58eb40f02fad0482bd7e2178 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/73023e54/uploads/origins/9c47af33-db06-4c9f-b795-14f51accc