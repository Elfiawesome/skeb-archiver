&s=7e793a8d69a940d7cda89887f5102465 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5426dd01/uploads/origins/c21219df-c760-4c34-af0c-3294da7388b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ceb84ab255632892fdcae396c2fc059", "srcset": "https://si.imgix.net/5426dd01/uploads/origins/c21219df-c760-4c34-af0c-3294da7388b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ceb84ab255632892fdcae396c2fc059, https://si.imgix.net/5426dd01/uploads/origins/c21219df-c760-4c34-af0c-3294da7388b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=34bc7d3c5d3f7a34939db092881d32b1 2x, https://si.imgix.net/5426dd01/uploads/origins/c21219df-c760-4c34-af0c-3294da7388b3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7ffe1893d03c3bdcb9546ebb1e85c7c7 3x"}, "body": "またこんにちは！\n\n私のために描いてくれたイラスト、本当に大好きです！衣装もポーズもとってもかわいいです！\n\nそこで、もう1枚描いていただけないかと思いまして。前回登場した赤毛の男の子、エンバーと、彼の彼氏であるコリを一緒に描いてほしいんです。エンバーはとても元気いっぱいな子で、コリはどちらかというと恥ずかしがり屋です。\n\n前回と同じようなセーラー服のスタイルで、シャツは青、スカーフは赤という組み合わせで、二人を描いていただけませんか？ポーズについては、エンバーが後ろからコリを抱きしめていて、コリが彼に微笑みかけているようなイメージを思いつきましたが、もし他のアイデアがあれば、そちらでも構いませんよ :)\n\n改めて、本当にありがとうございます！\n\nhttps://drive.google.com/drive/folders/1ZIu0eEdC1eSJ-BJ9bDVl4TRkW4F9myeX", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ymil_2306/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3924792, "client_id": 3991061, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d3b0891e/uploads/origins/b3db544c-4d29-4abd-8229-f8accb4404c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c539f2df877da0e7df7a7ebc5891fce0", "srcset": "https://si.imgix.net/d3b0891e/uploads/origins/b3db544c-4d29-4abd-8229-f8accb4404c5?bg=%23fff&auto=format%