e92-4b0a-a125-c773a2f87a99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=012186436a8e76bd35d17b5ad3cf7dd5", "srcset": "https://si.imgix.net/93a61008/uploads/origins/586f8718-9e92-4b0a-a125-c773a2f87a99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=012186436a8e76bd35d17b5ad3cf7dd5, https://si.imgix.net/93a61008/uploads/origins/586f8718-9e92-4b0a-a125-c773a2f87a99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=95e68305e593a4b9dba17129b3fe9836 2x, https://si.imgix.net/93a61008/uploads/origins/586f8718-9e92-4b0a-a125-c773a2f87a99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=131deb3ad7800f46a70df0fa9cc6ff52 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/93a61008/uploads/origins/586f8718-9e92-4b0a-a125-c773a2f87a99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5705801491f61428d04d9dfcb9047e5a", "srcset": "https://si.imgix.net/93a61008/uploads/origins/586f8718-9e92-4b0a-a125-c773a2f87a99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5705801491f61428d04d9dfcb9047e5a, https://si.imgix.net/93a61008/uploads/origins/586f8718-9e92-4b0a-a125-c773a2f87a99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c01641aec1209332395ff6bf6f905eea 2x, https://si.imgix.net/93a61008/uploads/origins/586f8718-9e92-4b0a-a125-c773a2f87a99?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=03777802899ab2f9452e9d4b892fd317 3x"}, "body": "アピールありがとうございます。\nキャラクター(うちの子)に興味をもっていただきありがとうございます。\n\nアピール元と同様の女の子のイラストをお願いできればと思います。\nこちらは参考画像ですが、セーラー服のデザイン・表情・ポーズ・構図は自由です。\nhttps://drive.google.com/drive/folders/1RIJ2bUUoPHZDhYmSZ5NlFco0yYrqRyDg?usp=sharing\n\n以下、リクエスト内容です。\n頬の絆創膏と右腕のギプス＋三角巾が維持されていれば、あとは自由となります。\n\n■女の子(名前は真紀(まき)ちゃん)\n・艶やかな黒髪の前髪ぱっつん、少し内巻きのショートボブ、横髪・後ろ髪は口のラインく