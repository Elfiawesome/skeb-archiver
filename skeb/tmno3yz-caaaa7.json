er": "image", "creator_acceptable_same_genre": false}, {"path": "/@Be6240/works/29", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2392326, "client_id": 1453623, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d5065cc8/uploads/origins/7246f372-70d3-4a3c-b0ff-5d19ed3dd0a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aeb6c9b38f2abdf6b244fbb90279777a", "srcset": "https://si.imgix.net/d5065cc8/uploads/origins/7246f372-70d3-4a3c-b0ff-5d19ed3dd0a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aeb6c9b38f2abdf6b244fbb90279777a, https://si.imgix.net/d5065cc8/uploads/origins/7246f372-70d3-4a3c-b0ff-5d19ed3dd0a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=89e37bb1e0e0a78f12590e4237ae7a9b 2x, https://si.imgix.net/d5065cc8/uploads/origins/7246f372-70d3-4a3c-b0ff-5d19ed3dd0a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa3771012a195f22c3acf65ed5e2b7ad 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5065cc8/uploads/origins/7246f372-70d3-4a3c-b0ff-5d19ed3dd0a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14ce7c9de762d7f04493fb367f3c3815", "srcset": "https://si.imgix.net/d5065cc8/uploads/origins/7246f372-70d3-4a3c-b0ff-5d19ed3dd0a6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14ce7c9de762d7f04493fb367f3c3815, https://si.imgix.net/d5065cc8/uploads/origins/7246f372-70d3-4a3c-b0ff-5d19ed3dd0a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f364c45190c98315d84eb1a3a9a5948 2x, https://si.imgix.net/d5065cc8/uploads/origins/7246f372-70d3-4a3c-b0ff-5d19ed3dd0a6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=57cbb4df48291ab9dca793d348860afa 3x"}, "body": "いつもお世話になっております！和津（とものいず）です。\n創作のキャラクターデザインをお願いしたく、リクエストさせていただきます。\n\nお願いしたいのは、自創作MagMelにいる「エリィ」というキャラの人型時と魔物時のデザインです。\n\nいただいたイラストは自分で描くときの参考資料にしたいと思っています。\n難しいようでしたらどちらか一方のデザインだけでも大丈夫です！\nご検討いただけましたら幸いです。どうぞよろしくお願いいたします。\n\n\n以下、設定です。\n\n＊　＊　＊　＊\n\n■人間形態時\n・身長：155cm\n・人間でいうと28歳程度の女性\n・赤髪、青目\n\n■魔物形態時\n・身長：2m↑\n・種族はガーゴイル\n\n－－－\n\n○性格/職\n豪胆で仕事をテキパキこなすお姉さんです。\nもともと戦闘強のため、根は血気盛んでもあります。\n普段は人間形態で魔王城を清掃・管理していて、戦時には指揮官/兵士として前線に立ちます。職業としてはメイド兼騎士みたいな感じです。\n\n○武器\n持たせるならハルバードや斧など。デザインはお任せします。\n（武器ではないですが、普段は箒やはたきのが持ってる時間は長いです。）\n\n○髪型\n髪の長さや髪型は特に指定はありません。\n他の色が混じるのも問題ありません。\n\n○服装\n肌の露出はほぼない（顔くらい）です。\nクラシックメイド＋鎧・甲冑などのイメージですが、こちらもお任せします。\n\n○魔物\n戦闘時、前線に出る時に変化します。\n「ガーゴイル」の解釈についてはお任せします。\n人型時の特徴は全く残っていなくても、残った状態でも大丈夫です。\n\n○他\n他、不明点や未記載事項についてはお任せします。NGは特にありません。\nまた、彼女以外のキャラ・世界観の情報が必要であればお手数ですが添付URL先にてご確認くださいませ。\n\n＊　＊　＊　＊\n\nhttps://www.whytonois.xyz/story/MagMel/Mset", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 153332, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "くじょー", "screen_name": "QZM0903", "avatar_url": "https://pbs.twimg.com/profile_images/1921549684226887680/3H6r18OM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/256898768/1752684114/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 80, "skills": [{"genre": "art"}, {"genre": "video"}, {"genre": "correction"}], "nc": 33}, {"id": 1663092, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "さあもん", "screen_name": "salmonkomaku", "avatar_url": "https://pbs.twimg.com/profile_images/1995408638618562560/DwiQQVwK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/968106916227371008/1703862287/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null