→激重、相手が死んだら追うタイプ\n\n✧使用用途\n\n・鑑賞\n・壁紙などの個人的な使用\n・相方とのイラスト共有\n\nこれからも陰ながら応援しております。\nお忙しいところ恐縮ですが、お受けしていただけたら幸いです。\n以上、何卒よろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1Mt6_uUcRUAL6x-UVUcZm2ayIxr8gUlSB", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 1692463, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ぬ🌟🌟🌟🌟🌟🌟", "screen_name": "nu_taku_", "avatar_url": "https://pbs.twimg.com/profile_images/2058935310202122240/TTvMOuPA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1311856510754938880/1773827502/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 2353910, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "定規❤️‍🔥", "screen_name": "vat0uq", "avatar_url": "https://pbs.twimg.com/profile_images/2045920863724396544/mO6_Hwyd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1362461502540709889/1693425254/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 176}, {"id": 2941993, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "うごむい", "screen_name": "u56164459", "avatar_url": "https://pbs.twimg.com/profile_images/1712894182602457088/8UA5qrat.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "none", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}],