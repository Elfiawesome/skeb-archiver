=0e87239287a0075fbd2e4cbc15abc1de 2x, https://si.imgix.net/761364b0/uploads/origins/55b76699-a37e-46cc-8e30-0de203c70d04?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=697db16d88e1134358d47ae70a8705aa 3x"}, "body": "初めまして、こんにちは。\n配信サイトTwitchにてゲーム配信をしております、桃月こなと申します。\nハッピードコドコおおみちゃん様のイラストをXで拝見し、絵柄や色づかいがとっても素敵だったのでフォローさせていただきました。\nぜひわたしもイラストをリクエストさせていただきたいです。\n\n▶️使用用途\n・配信画面上での使用（収益化済）\n・アイコン使用やX等のSNSへの投稿\n\n▶️\n参考資料にあるわたしのオリジナルキャラクターを描いていただきたいです。\n服装、髪型、ポーズはおまかせしたいです。\nできれば頭や装飾品に見切れがないように描いていただけますとうれしいです。\nデータは背景と人物を分けた透過差分をいただけますと幸いです。\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1FhmpAIJHtJGYB6LXUpcT_GtbrKIOOBLO?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ohmi_TRPG/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2358691, "client_id": 3831765, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/684eb52a/uploads/origins/883a98bb-1b2b-487c-ba39-a61b417f93a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15a7714bba7907bb3e1e17a13e70c589", "srcset": "https://si.imgix.net/684eb52a/uploads/origins/883a98bb-1b2b-487c-ba39-a61b417f93a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=15a7714bba7907bb3e1e17a13e70c589, https://si.imgix.net/684eb52a/uploads/origins/883a98bb-1b2b-487c-ba39-a61b417f93a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6c5fa008708348a406b04b86cc9133b 2x, https://si.imgix.net/684eb52a/uploads/origins/883a98bb-1b2b-487c-ba39-a61b417f93a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39ddd427d8a01b8908568cbdf31b07a9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/684eb52a/uploads/origins/883a98bb-1b2b-487c-ba39-a61b417f93a3?bg=%23fff&auto=format%2Ccompr