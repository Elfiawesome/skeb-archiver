d06-8a29-6072409435db?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0925e3cc27137a5c8848a1dffbc186c3", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 250090, "client_id": 3083466, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sikiso_soso/works/377", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 250090, "client_id": 1046947, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a7a546bf/uploads/origins/7a6bd249-4707-4c8c-9687-b0b4c2dbb1b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c04ee8a6e97a1b880bdd0e7c4bc15b54", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a7a546bf/uploads/origins/7a6bd249-4707-4c8c-9687-b0b4c2dbb1b3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8808056179decdde3fe5d7f4c3618b87", "src_set": ""}, "body": "こんにちは、しきそさん！ずっとあなたの絵が大好きです！\n\nできれば、本当に微サン光風味のものを描いていただけますでしょうか？\nうちのヒカセン、ミニオンと場所の参考資料を添付します。\n\n基本設定はヒカセンは自分の気持ちにとても鈍い、その宴会までサンクレッドとの関係はちょっと曖昧ですがまだ同僚です。\nそしてコミックの時点は蒼天、彼が無事かどうかな？まだはっきりしない時期です。\nヒカセンは九つの雲で日記を書いているけど集中できず、ずっと机の上であるマメット・サンクレッドを見つめて、本体の彼は一体どこかなっと考えた。\nマメットは座っていようが立っていようが、凄くかわいければいい。\nそして自身の恋愛感情がまだわからないなので、彼の無事を祈る彼女は自分の気持ちに戸惑っている。\n当然のことながら、彼女はまだ彼が野生で生き延びようとしていることを知らない。\n\nお忙しいことと存じますが、ご検討のほどよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/1raer9Q5vTvDEUI1a4ODc_1aADcFiUQSR?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sikiso_soso/works/376", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 250090, "client_id": 1979118, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a1c0d40/uploads/origins/9260ba53-b278-4af4-a7d0-128ef999852c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=759d806f92348d7737b1d6bb68cc2e10", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2a1c0d40/uploads/origins/9260ba53-b278-4af4-a7d0-128ef999852c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a11cfceb841bd177f56e35a788582aa", "src_set": ""}, "body": "こんにちは！\nゲーム「アリーナ・オブ・バロール」のトリオを描いてください！\nキャラクターは刀鋒寶貝、莫拉、圖倫で、参考ファイルにあるそれぞれの水着を着ています！\n\nよろしくお願いします！\nキャラクター\n刀鋒寶貝: https://imgur.com/a/MYDGubp\n莫拉: https://imgur.com/a/U1DWRv1\n圖倫 : https://imgur.com/a/YgvRJeP\n刀鋒寶貝用ビキニ：https://imgur.com/a/black-bikini-TjbJNqZ\n莫拉と圖倫の水着：https://imgur.com/a/kCSrcEj\n\nこの構図とポーズで描いてください: https://cdn.donmai.us/original/fa/42/__gojou_satoru_getou_suguru_and_ieiri_shoko_jujutsu_kaisen_drawn_by_gab_nigntjj449__fa4228a43c813d8d29981c6873f22580.jpg\n\nご配慮ありがとうございました！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sikiso_soso/works/375", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 250090, "client_id": 1627681, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65c2c3d5/uploads/origins/d0bf33d3-ac1b-4f14-8374-5075600440f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3154c9b0a9ef0aca20b96f00bf75875c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/65c2c3d5/uploads/origins/d0bf33d3-ac1b-4f14-8374-5075600440f9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fb5d8c92857bc03fd8bceea708d02706", "src_set": ""}, "body": "こんにちは！\n彼らが再会する前のこのシナリオの前日譚が欲しい。\nhttps://drive.google.com/drive/folders/1U9tCI3baTIrxRksjq58dWLDmRL3-Wi8A\n\n二人は現世では面識がない。\n慌ただしい中、すれ違い、タイミングをずらして同じ場所にいた。しかし、お互いを意識する機会はなかった。\nしかし、互いの気配を感じながらも、相手がその場を離れてから振り返って確認していた。\nテーマはこうだ：間違った時間に間違った場所にいること。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sikiso_soso/works/374", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/393574a2/uploads/origins/caf0d0b1-c0a2-4253-9c7d-7e3c351fbf02?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9ec98e54867c48f0a490309aec909a4b", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 250090, "client_id": 3083466, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sikiso_soso/works/373", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 250090, "client_id": 1985882, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/edae9fa1/uploads/origins/18ed79c4-75e7-43b2-887f-7b80088e8611?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cd7f514340a1471e145e58fe4b800233", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/edae9fa1/uploads/origins/18ed79c4-75e7-43b2-887f-7b80088e8611?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=134265dc454db6338055b490a6e3c377", "src_set": ""}, "body": "こんにちは！ずっとあなたにお願いしたかったのですが、今まで恥ずかしくてできませんでした！先生の作品を拝見すると、いつもその美しさに見惚れてしまいます...。私の憧れのペアも描いていただけたらと思いました。👉👈\n\n私のキャラクター \"アステール \"と \"グズマ \"の結婚式のシーンをお願いします。風景はたくさん参考にしたのですが、いいポーズが思いつかなかったので、どんなのがいいか頑張って書いてみます...。結婚式の前、「アスター」はみんなの前で結婚することにとても緊張していて、「グズマ」はそれを馬鹿にしているのですが、とにかく彼女を落ち着かせることに成功します。からかってはいるけれど、穏やかな雰囲気になるように......。部屋の隅の窓際に二人がいるのがいいんじゃないかと...。\n\nリクエストを受け入れていただけると嬉しいです！ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1QwsdKPdjMCD1n-MT_X9xXj_8SzbvGfso?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sikiso_soso/works/372", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/15c3cd36/uploads/origins/9ad9b0bc-d62e-434b-b898-d1366ed7c3f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9365990fcb8cffe632f493d2c991b8aa", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 250090, "client_id": 1571177, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sikiso_soso/works/371", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 250090, "client_id": 2015095, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b74d68cd/uploads/origins/244d09dc-02e0-40af-bae8-e425b3394959?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6022c7e63a79abd603f0bea4449f3c45", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b74d68cd/uploads/origins/244d09dc-02e0-40af-bae8-e425b3394959?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4209c2d2ddf2dbd45747ed19cc2287fd", "src_set": ""}, "body": "Hello! I absolutely adore your pieces you did for me last time, I would love another! Could I request my ship, Akechi and Reina, dancing under the moonlight with a pose like this?\nhttps://m.media-amazon.com/images/I/51J1T+W0k4L._AC_UY1000_.jpg\n\nI'd love for it to be super romantic. I love the backgrounds featured here:\n\nhttps://skeb.jp/@sikiso_soso/works/351\nhttps://skeb.jp/@sikiso_soso/works/243\n\nCould I get one similar? Here are their outfits:\nAkechi (Prince Crow): https://drive.google.com/drive/folders/1X9P5yfjO4pVnHcdr1apVIrkDxfqaqgm8\nReina (Reaper): https://drive.google.com/drive/folders/1dC3boakgJzyGaEx8622E51bu36qyaSG5\n\nPlease can you keep their masks on.\n\nPlease can you make sure Reina's hair is red like her sprite here:\nhttps://drive.google.com/file/d/11e3BxoRvxpQDkNjSmrmSMUqC04S3D5oe/view?usp=drive_link\n\nThis is their height!\nhttps://drive.google.com/file/d/1keQ5yblrzORucYlBlcEH35lMgEfLBEbv/view?usp=sharing\n\nThank you so much!\n\nhttps://drive.google.com/drive/folders/1JptXHRzBQtnS1UVapED7g6S96FItgCV0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sikiso_soso/works/370", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 250090, "client_id": 1627681, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bfd2a23c/uploads/origins/63d42807-58ed-4b34-a9e4-f41263407100?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=892610c968b340ccf2fd7f55e0344ea2", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bfd2a23c/uploads/origins/63d42807-58ed-4b34-a9e4-f41263407100?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0cf2fe75d662c50235b337154fc51b7c", "src_set": ""}, "body": "こんにちは！\n以前お願いした仕事がとても気に入ったので、今回もお願いしたいと思います！\n今回は幼児2人の子守と見守りをお願いします。\nhttps://drive.google.com/drive/folders/1NRrHUukIDiLdhx68FgZDIVQr-nCKQtRe?usp=drive_link\n子供が嫌いではないので、散らかし放題でも根気強く丁寧に接してくれます。\nコハルが迎えに来るまでの間、2人が一緒に過ごすという健全なシチュエーションを自由に演出してください。\nありがとうございました！\nhttps://drive.google.com/drive/folders/1ih3U78bhF0x