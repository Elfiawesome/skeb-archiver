させて頂ければと思います。 詩麿様から見てご対応が難しいものがあればご無理はなさらない様にお願い申し上げます。 私もskebを通してリクエストする事が初めてでして、何か失礼があれば申し訳ありません。 \n詩麿様のイラスト、それから普段のポストから垣間見えるお人柄も含めて好きです。 \nこれからも陰ながら応援しております。 \n\n季節の変わり目ですので、お身体ご自愛下さいませ。\n\nhttps://drive.google.com/drive/folders/1pGY8e_wXbLronBw_JrqrM7uw38x4tcIu", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 362226, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "なっこ", "screen_name": "7nt_5ta", "avatar_url": "https://pbs.twimg.com/profile_images/1166745391913549825/3ebZqFiW.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4913262739/1541163051/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 16}, {"id": 1365065, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "𝙧𝙤𝙤𝙩", "screen_name": "r__ts104", "avatar_url": "https://pbs.twimg.com/profile_images/2039687549380411392/VZX6FlXc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1355870375049981961/1776273082/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 32}, {"id": 1557754, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ヴィ・ヴァレンタイン❤️‍🔥🍫", "screen_name": "vi214va", "avatar_url": "https://pbs.twimg.com/profile_images/2019400148019998726/eLq1yG3r.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1424023776295940106/1682092355/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requeste