&fm=webp&fit=crop&crop=top&w=200&h=200&s=3900ecf609d7c25b1197bcee5aed4363, https://si.imgix.net/95604300/uploads/origins/53f1ed07-d52c-4f0e-a96f-ba9d07c76f24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a01bc470d10843168e408193cde8838c 2x, https://si.imgix.net/95604300/uploads/origins/53f1ed07-d52c-4f0e-a96f-ba9d07c76f24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7f80b83178cf1d21458bf7315919ec2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/95604300/uploads/origins/53f1ed07-d52c-4f0e-a96f-ba9d07c76f24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=979f0df40a172db1df6ba1ce4360cefb", "srcset": "https://si.imgix.net/95604300/uploads/origins/53f1ed07-d52c-4f0e-a96f-ba9d07c76f24?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=979f0df40a172db1df6ba1ce4360cefb, https://si.imgix.net/95604300/uploads/origins/53f1ed07-d52c-4f0e-a96f-ba9d07c76f24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=616b230a34d8a8dc50248411e4df997e 2x, https://si.imgix.net/95604300/uploads/origins/53f1ed07-d52c-4f0e-a96f-ba9d07c76f24?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aeb331a75f122a40ed1dcb5f9b0ef1ab 3x"}, "body": "【注】ほんのり特殊性癖\n\n※似たようなキャラ属性のイヌ科おじさまのファンアートをお描きになられていたので、動物種族の変更が必要であれば題材変更で再送要求かけてください。\n※報酬交渉も遠慮なく。\n\nあなたの描くおじさまのおなかがとても素敵だったのでリクエストを送らせていただきました。フェチ特有の構図が描きにくいかもしれませんが、気軽にチャレンジしてもらえると嬉しいです。\n\nずっしりもっちりとしたデカ腹には、ギガンティックな夢と希望が詰まっていてほしいので、でっっっっかいケモおじいちゃんのイラスト、可能であれば＋コミックをお願いできないでしょうか？\n\nおしゃれな喫茶店で、帽子に丸眼鏡、ネクタイに、まんまる腹を抑えてパツパツになったベストというフォーマルな衣装に、眉毛おひげもさもさしょんぼり糸目のまっしろふわふわ狼の老マスターが客に珈琲を提供しているカラーイラスト。\n\nマスターのサイズ感としては、小指だけで一般客の背丈と同じぐらいデカい、とんでもない巨体の持ち主。\nひとしずくに満たない量の珈琲が入ったちっちゃなカップを指先で器用につまんで、\nカウンターの上に設置されたチビ客人用の小さなテーブルに近づけてくる様子。\n客と同じくカウンターの上で、デカ腹とご尊顔をローアングルから見上げるような構図。\n\nあわせて数ページのショートコミック（ラフな塗りなし線画で充分）をお願いしたいです。\n喫茶店としての閉店後、他の客を追い出しての、完全予約個人制ふれあい営業な感じの一幕。\n床の上で待機していると、バックヤードで服を脱いで靴下＋ブリーフになったマスターがずしんずしんやって来て、そばでしゃがんでもらって、自分の上に覆いかぶさるようにうつ伏せになってもらって。\nおへその空間のなかで、おなかのぬくもりという庇護を感じながら眠りにつきたいです。しゃがむ前にスキンシップとして足裏で軽くふみふみしてもらえると非常に助かります。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@0_7us/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3415374, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a6a6f28a/uploads/origins/1b81eb33-31c2-4ab2-8e01-62a8e2ea30bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d1fedd0cf33d7a4615f137b81cc817d", "srcset": "https://si.imgix.net/a6a6f28a/uploads/origins/1b81eb33-31c2-4ab2-8e01-62a8e2ea30bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d1fedd0cf33d7a4615f137b81cc817d, https://si.imgix.net/a6a6f28a/uploads/origins/1b81eb33-31c2-4ab2-8e01-62a8e2ea30bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dc4c3c75e5242383ff221b4b2c1b0c51 2x, https://si.imgix.net/a6a6f28a/uploads/origins/1b81eb33-31c2-4ab2-8e01-62a8e2ea30bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=044ebdf0ae138c912006520ed5710282 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a6a6f28a/uploads/origins/1b81eb33-31c2-4ab2-8e01-62a8e2ea30bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37deda123d039cb200754bc2939f3bf8", "srcset": "https://si.imgix.net/a6a6f28a/uploads/origins/1b81eb33-31c2-4ab2-8e01-62a8e2ea30bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37deda123d039cb200754bc2939f3bf8, https://si.imgix.net/a6a6f28a/uploads/origins/1b81eb33-31c2-4ab2-8e01-62a8e2ea30bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cc041d8264d5dbfe