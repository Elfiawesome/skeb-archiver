走様～」\n\n--------------------------------------------------------------------\n以上の内容でお願いします。\n\n甘く優しくお茶目なお姉さんを宜しくお願いします。", "nc": 0, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@amatuki_VRChat/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 135450, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/d773ec3a-559e-4863-a351-b0b2f2168735?response-content-disposition=inline&Expires=1794741552&Signature=jz9WSQ8Q1YU2MQ2s70mWSmEpbNYbp7NbDCzgEPK9~wP7aAZ6VR5iD3enSWFx1~QY5m4A8aftWbY1JuVMeQUSNCxWl0Hj1kMvdo~Hv8~pi-KSDPBPF5B~5vlHc7q~lBa8ArviiQu3zl~jA0oR5y37~TO9jh31dkFvfV15Eu4rSP15Be0jpFQd9oN8~X9V98H~TXm~m3hX7hjAodUn1sOmicA3yan8YGaoc2aVDITzDH-rT79CaDYAgyCiFB-dmNOwIUUNb-Rl0tmNdMXzBcGk9QULczVZ-LGjJMC7BsWVwwIYjWNA-XojYQEeg3jJI-E~PdE2kUfF5npIoJtlbccnoA__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2074825898210332672%2Fil3VT3D7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfad09fd2a605a09d4510958a499dd9f", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2074825898210332672%2Fil3VT3D7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfad09fd2a605a09d4510958a499dd9f, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2074825898210332672%2Fil3VT3D7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3b765488aa2243734cdac907ed4f80b 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2074825898210332672%2Fil3VT3D7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78d7277af5d015cbbadfd7508e7f47d1 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/a9a58820-bbdf-4193-a5e8-54fb4fb59514?response-content-disposition=inline&Expires=1794741552&Signature=aotv6EDfqFzIanCfx6