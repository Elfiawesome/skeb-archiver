になったね」\n「さっきの疲れ顔、ひどかったよ？」\n「じゃあまたね、かわいい反応ご馳走様～」\n\n--------------------------------------------------------------------\n以上の内容でお願いします。\n\n甘く優しくお茶目なお姉さんを宜しくお願いします。", "nc": 128, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@amatuki_VRChat/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 135450, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/d773ec3a-559e-4863-a351-b0b2f2168735?response-content-disposition=inline&Expires=1787328978&Signature=ip5qSfUOQpZnWJ2RsqlZuzTboLQayF-mxxbkPLKR2eK3S1Bo1QqmFSupmzCn6aD~OK~BELtWrSnp9pcSbSsuioVwogLUQH9C-sv4mgNrPgRmcwBklREru~y8AYRm~nbKh~aqppZAhT5WQWoxAtrxigAjc2W2GCvN6aNZSoLZ~UmWtqwE~Qcuc6-39FGhUbeD0W5gissPsAoekhtIpGZsXD0KrxOO-68y01c1ph3Rtq6lG6-IRYFT0WBu-Cojob8e0BpSaRSFyT3KnnvuPTUFSDCQownSKbpCvE3mUJDNJ9ZbQEYYI2tnHirtojA6GOdOEazK0wrsmwqTTh3Be5L4FA__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2074825898210332672%2Fil3VT3D7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfad09fd2a605a09d4510958a499dd9f", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2074825898210332672%2Fil3VT3D7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfad09fd2a605a09d4510958a499dd9f, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2074825898210332672%2Fil3VT3D7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3b765488aa2243734cdac907ed4f80b 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2074825898210332672%2Fil3VT3D7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78d7277af5d015cbbadfd7508e7f47d1 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/a9a58820-bbdf-4193-a5e8-54fb4fb59514?response-content-disposition=inline&Ex