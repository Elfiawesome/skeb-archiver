様～」\n\n--------------------------------------------------------------------\n以上の内容でお願いします。\n\n甘く優しくお茶目なお姉さんを宜しくお願いします。", "nc": 1, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@amatuki_VRChat/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 135450, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/d773ec3a-559e-4863-a351-b0b2f2168735?response-content-disposition=inline&Expires=1794357423&Signature=c0DVWjkNYK84n40zUK1YuD6CpTctymLJDzxUwjvYCtFdF~-C~AjnCh7yzZ0amR0Bxkpp4dsy5ADvQw59zw3c3jFvdGDLIGOjn0~XkpgQIEmEs0ChJx0JMeCgKycB2xm7uhiAMWJWZjCGNP6ICfHwYA3zh-5u7UZEyd-qObkpggcZ5mK7pGhUNvOg-dKT6~B~OAxDZuYTZ1vOP047D8hW6qw1y4NdUHmBLCaV5FlnnXfdoZKmEhXLfgHshQK~AHHz8HMwghvyi~41hZA9-i5fMYpWVoCKUVayw1L4-zkTwPLuzRrlxJZIJnN~uhocKw5E87wvgF8oti4f7BgUhSI~oQ__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2074825898210332672%2Fil3VT3D7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfad09fd2a605a09d4510958a499dd9f", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2074825898210332672%2Fil3VT3D7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfad09fd2a605a09d4510958a499dd9f, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2074825898210332672%2Fil3VT3D7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3b765488aa2243734cdac907ed4f80b 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2074825898210332672%2Fil3VT3D7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78d7277af5d015cbbadfd7508e7f47d1 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/a9a58820-bbdf-4193-a5e8-54fb4fb59514?response-content-disposition=inline&Expires=1794357423&Signature=S2G5VwXyzGpnMoE2GA8