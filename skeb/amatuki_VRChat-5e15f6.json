～」\n\n--------------------------------------------------------------------\n以上の内容でお願いします。\n\n甘く優しくお茶目なお姉さんを宜しくお願いします。", "nc": 0, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@amatuki_VRChat/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "voice", "tipped": false, "creator_id": 135450, "vtt_url": "https://fcdn.skeb.jp/uploads/outputs/d773ec3a-559e-4863-a351-b0b2f2168735?response-content-disposition=inline&Expires=1794558210&Signature=QDDPVuA-X~mzegHSDN91RieqRge1eKpQPqOiAss6vfWslzrD50lNfm8JG-miURpd6Ed2Zgw~E~sy721XQAOaAUBX3bRcgM-HuAmfwg0LbhCK0rFWhS1p6~3Dc5kgrN014YKzNr2CxoIlQHBveo~1cWCLpMJk~4rYXULzpb1eCUgnR9~wm8HNlKoOyt4881AN3F012c-QrNy8BjYpY2J-kYWuTxzyV9-PjGI9ZyXA0lIhZj0nOaXMuaFG0kCICsT8je~3g~co2l-JLrC4FlydSsZMOyBBvGUETqIfugg-42MgUgmBffevmHl7t~U2gccDIwQkRXsoUiGVOk47djl8gw__&Key-Pair-Id=K1GS3H53SEO647", "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2074825898210332672%2Fil3VT3D7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfad09fd2a605a09d4510958a499dd9f", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2074825898210332672%2Fil3VT3D7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfad09fd2a605a09d4510958a499dd9f, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2074825898210332672%2Fil3VT3D7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3b765488aa2243734cdac907ed4f80b 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F2074825898210332672%2Fil3VT3D7.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=78d7277af5d015cbbadfd7508e7f47d1 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/a9a58820-bbdf-4193-a5e8-54fb4fb59514?response-content-disposition=inline&Expires=1794558210&Signature=aGR-gCyZL7tiDuBMtXeb