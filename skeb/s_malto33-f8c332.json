=200&blur=200&s=a7c1d1c1cd75e18fbe90952ea6f884bb, https://si.imgix.net/b6110ac1/uploads/origins/46f99954-3180-4675-a3d6-74a470d4a132?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=067dbc6e61d2a5d34168b9384ee6ba8a 2x, https://si.imgix.net/b6110ac1/uploads/origins/46f99954-3180-4675-a3d6-74a470d4a132?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a194db6e605f0819ab783900072e5e0d 3x"}, "body": "またお会いできて嬉しいです！\n\n私のドラゴンを描いてくださった絵、本当に可愛らしかったです！もしよろしければ、別のポーズでも描いていただけないでしょうか？前回は猫のようにくつろいでいる姿をお願いしましたが、今回もそのような雰囲気のポーズにしたいと思っています。そこで、今回は猫が伸びをするようなポーズで描いていただけないでしょうか？ 前足と頭は地面に近づけて、後ろ足はまっすぐ伸ばし、しっぽは空中で少しカールしている感じにしてください。伸びをする時は、翼も広げている様子にしてほしいです。表情については、少し疲れたような感じ、あるいは小さなあくびをしているような表情で描いていただけると嬉しいです。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/19Z3FvGr9E5qJPCgrUYGZHGVkg_j6s37_?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@s_malto33/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3883280, "client_id": 2294134, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/13b849b3/uploads/origins/3a963c7f-4d39-4c9d-9191-bcf03eb48e87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1149df3dfb7b56a0c19f2cd64299a5d9", "srcset": "https://si.imgix.net/13b849b3/uploads/origins/3a963c7f-4d39-4c9d-9191-bcf03eb48e87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1149df3dfb7b56a0c19f2cd64299a5d9, https://si.imgix.net/13b849b3/uploads/origins/3a963c7f-4d39-4c9d-9191-bcf03eb48e87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c6175b2a928e15493774c6053c0501cb 2x, https://si.imgix.net/13b849b3/uploads/origins/3a963c7f-4d39-4c9d-9191-bcf03eb48e87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82b18c2b6911539b5b25d8795192c93d 3x"}, "duration": null,