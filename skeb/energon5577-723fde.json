任せします。\n\n表情は、キリッとしたもの(口は笑っていてほしいです)と、こちらを挑発するような笑顔(こちらも、出来る範囲で構いません)と、二通り描いていただきたいです。ポーズはそのままで良いです。\n\nお忙しいところ恐縮ですが、ご検討いただきますようよろしくお願い申し上げます。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1201106, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "黒澤カルラ", "screen_name": "karurakurosawa", "avatar_url": "https://pbs.twimg.com/profile_images/1667350244982673409/hEf6tlRK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1104300257549025280/1787892422/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 33}, {"id": 1822600, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "うらーー🔞", "screen_name": "gift_bit", "avatar_url": "https://pbs.twimg.com/profile_images/1611738598277287939/9hRUe5op.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1214091891265826821/1694948838/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 177}, {"id": 2045621, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "凹一@C108新刊委託中", "screen_name": "ohichi16", "avatar_url": "https://pbs.twimg.com/profile_images/1890570342831435776/eHe4k1tG.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1341052962630582281/1739582014/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "comp