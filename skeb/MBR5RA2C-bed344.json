き缶みたいに踏み潰されぺちゃんこになってしまった戦車があると嬉しいです。\n古くてマイナーなキャラなうえ、かなり特殊なシチュで本当にすみません…\n雪風さまのご迷惑で無ければで、\nお時間がございます時、\nお気が向きましたら、\n他の方のリク優先で構いませんので、どうか宜しくお願い致します。\n長文乱文になってしまい説明が\n下手すぎで本当にごめんなさい。", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MBR5RA2C/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 473384, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51195d2d/uploads/origins/98a29923-04d7-4ab5-9c84-99a142ba3efe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=681791e29067f005fefadd8aad65d608", "srcset": "https://si.imgix.net/51195d2d/uploads/origins/98a29923-04d7-4ab5-9c84-99a142ba3efe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=681791e29067f005fefadd8aad65d608, https://si.imgix.net/51195d2d/uploads/origins/98a29923-04d7-4ab5-9c84-99a142ba3efe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=712ff4e44b9481028878adab16c6646c 2x, https://si.imgix.net/51195d2d/uploads/origins/98a29923-04d7-4ab5-9c84-99a142ba3efe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2cff6a36e5ea9ee0d6c66cf352e65622 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51195d2d/uploads/origins/98a29923-04d7-4ab5-9c84-99a142ba3efe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e1b10ee6aac44e3b51fb0925d4f94d9", "srcset": "https://si.imgix.net/51195d2d/uploads/origins/98a29923-04d7-4ab5-9c84-99a142ba3efe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7e1b10ee6aac44e3b51fb0925d4f94d9, https://si.imgix.net/51195d2d/uploads/origins/98a29923-04d7-4ab5-9c84-99a142ba3efe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d771df53da57453a274252f2b5f4a139 2x, https://si.imgix.net/51195d2d/up