": "https://si.imgix.net/f13be60e/uploads/origins/5c647808-6df6-48fd-8930-c4170384e5e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8a4f2c1338ad07da71a21295f0626a62, https://si.imgix.net/f13be60e/uploads/origins/5c647808-6df6-48fd-8930-c4170384e5e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8669bc479383373c1337e4c45f894b19 2x, https://si.imgix.net/f13be60e/uploads/origins/5c647808-6df6-48fd-8930-c4170384e5e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=eab7598471ae90c9bb32cfbbc37a94f8 3x"}, "body": "また会ったね、\n\nあなたの画風がとても好きです！！！！私のキャラクター、あかねの絵をお願いします。彼女は「地雷系」の女の子です。地雷系のコスチュームは添付のリンクに4種類載せました。ぜひチェックして、一番好きなのを選んでください。\n\n好きなように描いてください。羽と角は彼女の特徴なので、忘れずに描いてください。\n\n本当にありがとうございました！楽しんで描いてくださいね。\n\nhttps://imgur.com/a/RnxNHL3", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@matsumikoru/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1224944, "client_id": 1369057, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b67f1212/uploads/origins/2608e27b-40f1-4e6b-87de-2e75db85a7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ed0f74b3e057f98bb4d89aeed10002c", "srcset": "https://si.imgix.net/b67f1212/uploads/origins/2608e27b-40f1-4e6b-87de-2e75db85a7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4ed0f74b3e057f98bb4d89aeed10002c, https://si.imgix.net/b67f1212/uploads/origins/2608e27b-40f1-4e6b-87de-2e75db85a7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=951b7ddec3488e6f34fa7ce05b95f6d5 2x, https://si.imgix.net/b67f1212/uploads/origins/2608e27b-40f1-4e6b-87de-2e75db85a7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f38b84e06f8b5e2a9e6c5abbdc55b400 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b67f1212/uploads/origins/2608e27b-40f1-4e6b-87de-2e75db85a7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a91435035348b011e777e5f11e79b057", "srcset": "https://si.imgix.net/b67f1212/uploads/origins/2608e27b-40f1-4e6b-87de-2e75db85a7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a91435035348b011e777e5f11e79b057, https://si.imgix.net/b67f1212/uploads/origins/2608e27b-40f1-4e6b-87de-2e75db85a7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ca827a6b07699d03416c9b0ba5c77c6c 2x, https://si.imgix.net/b67f1212/uploads/origins/2608e27b-40f1-4e6b-87de-2e75db85a7dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fa1ea18d177be9f327c6740b6df56600 3x"}, "body": "松みこるさん。\n初めまして、個人Vtuberしている愛野いりすといいます。\nイラストを見てとっても素敵だったので今回リクエストさせてもらいました！\n\nリクエストですが私、愛野いりすを描いてほしいです！\n\n黒を基調としたバニーガール衣装を描いていただきたいと思っています。\n脚は黒色のストッキングにしてください。\nちょっとセクシーな感じに描いてほしいと思っています。\nキャラデザに関しては以下URLの三面図を参考にしてください。\nhttps://twitter.com/aino_iris/status/1548664193263763457\n\n頂いたイラストは、アイコン・動画内使用・SNS投稿利用・動画サムネイルなどに使用させていただきたいと考えております。\n背景と人物、レイヤー分けをされたデータ(PSD等)を頂きたいです。\n\nご検討のほど宜しくお願い致します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@matsumikoru/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1224944, "client_id": 748743, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/54545333/uploads/origins/d44c5e61-4080-44f9-8e67-9268d5fd56b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e794411a6ba860a53fa78e30a70c2e8c", "srcset": "https://si.imgix.net/54545333/uploads/origins/d44c5e61-4080-44f9-8e67-9268d5fd56b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e794411a6ba860a53fa78e30a70c2e8c, https://si.imgix.net/54545333/uploads/origins/d44c5e61-4080-44f9-8e67-9268d5fd56b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=945af12877bf0f700c03dd30e57a024c 2x, https://si.imgix.net/54545333/uploads/origins/d44c5e61-4080-44f9-8e67-9268d5fd56b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f472d57e13f7004350ca5b5215c83fe0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/54545333/uploads/origins/d44c5e61-4080-44f9-8e67-9268d5fd56b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1dc38712e8564c27421da22c0acf97bc", "srcset": "https://si.imgix.net/54545333/uploads/origins/d44c5e61-4080-44f9-8e67-9268d5fd56b5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1dc38712e8564c27421da22c0acf97bc, https://si.imgix.net/54545333/uploads/origins/d44c5e61-4080-44f9-8e67-9268d5fd56b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0ff1fc87c92e52604b6934cc43a6fd83 2x, https://si.imgix.net/54545333/uploads/origins/d44c5e61-4080-44f9-8e67-9268d5fd56b5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7760af3920fee1a4256c62d87a381b3f 3x"}, "body": "本文\n松みこるさま\n\nはじめまして、藍藤唯と申します。\n幼く見えつつも色気のある大変可愛いキャラクターのイラストに惹かれてご依頼させていただきたく思いました。以前からTwitterを主に拝見していたのですが、毎度構図も素敵で、服装に妥協が無い感じが凄く好きです。\n\nお願いしたいのは、当方がTRPGで使用しているキャラクターです。\n当方もツインテールが大好きでして、この子をお願いしたいのですが、ファイルを拝見いただければ分かる通り、結構優しく表情豊かな子です。\nしかし身内で「この子こんなナリして、人狼では平気で嘘つけるタイプだよね」という話になり、普段の可愛さとは全然違うギャップのある、スンッとした可愛さが魅力の表情の絵が欲しくなってしまいました。\n代理ちゃんのような表情が理想です。\n代理ちゃんがめちゃくちゃ可愛くて依頼してしまったとも言います……。\n中でもバニーガールが凄く好きです。\n\n以上の経緯から、\n狼耳がついていて、爪が鋭く長い、この子をお願いできませんでしょうか……。\n表情は代理ちゃんやフータオちゃんのような、力を抜いた感じの流し目が最高です(できれば)。\n服装は松みこるさまのフェミニンな服装が凄く好きなので、桃色や白、黒あたりの色をベースに可愛い服を着せていただければと。露出などのバランスはお任せします。\nこんな可愛いのに人狼かよ、みたいな雰囲気をお願いできればいいなと思っております。\n\n資料URLは、お願いしたいキャラクターの見た目を纏めたフォルダーです。\n宜しければ、ご依頼させていただければ幸いです。\n\nhttps://drive.google.com/drive/folders/1rbCZmKd-hrVHyaSBOgstDF7mz1xNee10?usp=sharing", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@matsumikoru/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1224944, "client_id": 2002147, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ece392c6/uploads/origins/9af1a7ca-5b24-4e86-974a-dbe20ab4f63a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afd2c2f270845d18c804f7c553893a1a", "srcset": "https://si.imgix.net/ece392c6/uploads/origins/9af1a7ca-5b24-4e86-974a-dbe20ab4f63a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=afd2c2f270845d18c804f7c553893a1a, https://si.imgix.net/ece392c6/uploads/origins/9af1a7ca-5b24-4e86-974a-dbe20ab4f63a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d9bea6efdc1304807530ec7b55d3c79c 2x, https://si.imgix.net/ece392c6/uploads/origins/9af1a7ca-5b24-4e86-974a-dbe20ab4f63a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c6d9efafb633cb30472b698f6de80c6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ece392c6/uploads/origins/9af1a7ca-5b24-4e86-974a-dbe20ab4f63a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58b3725d158f81d46983335ead099d8f", "srcset": "https://si.imgix.net/ece392c6/uploads/origins/9af1a7ca-5b24-4e86-974a-dbe20ab4f63a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=58b3725d158f81d46983335ead099d8f, https://si.imgix.net/ece392c6/uploads/origins/9af1a7ca-5b24-4e86-974a-dbe20ab4f63a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dc0b449d764b794a2a05bf560a1f39e4 2x, https://si.imgix.net/ece392c6/uploads/origins/9af1a7ca-5b24-4e86-974a-dbe20ab4f63a?bg=%23f