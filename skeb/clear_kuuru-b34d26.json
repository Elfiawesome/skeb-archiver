いです！\n\n内容ですが\nまずは着衣状態の響ちゃんの胸に聴診器を当てて\n心音を聴く。\n\nその後、服を脱いで直接肌に聴診器を当てて\n心音を聴き、聴診器の冷たさでビクッっと跳ね\n恥ずかしさで徐々に早くなる心音。\n\n最後に響ちゃんに聴診器を付けさせて\n響ちゃんが自身のドキドキして早くなってる\n心音を聴く。\n\nといったイラストをお願いします！\n全体的に響ちゃんの心音描写は多め\n可能であれば吹き出し等で響ちゃんの心臓の描写を入れていただければありがたいです！\n\nご検討の程をよろしくお願いします！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@clear_kuuru/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 48467, "client_id": 8832, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc334b5b/uploads/origins/ab921ca1-2e62-4a8f-8fcd-7c2515c6316a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f6e548c3a53888649f854325bf99616", "srcset": "https://si.imgix.net/bc334b5b/uploads/origins/ab921ca1-2e62-4a8f-8fcd-7c2515c6316a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f6e548c3a53888649f854325bf99616, https://si.imgix.net/bc334b5b/uploads/origins/ab921ca1-2e62-4a8f-8fcd-7c2515c6316a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=36f0f950479d145704bd70df69c68e9d 2x, https://si.imgix.net/bc334b5b/uploads/origins/ab921ca1-2e62-4a8f-8fcd-7c2515c6316a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2ee7a35be9f1d9232ae3c2b597f0645 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc334b5b/uploads/origins/ab921ca1-2e62-4a8f-8fcd-7c2515c6316a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=100245d08ad070247f70136fe42f5a71", "srcset": "https://si.imgix.net/bc334b5b/uploads/origins/ab921ca1-2e62-4a8f-8fcd-7c2515c6316a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=100245d08ad070247f70136fe42f5a71, https://si.imgix.net/bc334b5b/uploads/origins/ab921ca1-2e62-4a8f-8fcd-7c2515c6316a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=055155fc8111817d4e216349af492b39 2x, https://si.imgix.net/bc334b5b/uploads/origins/ab921ca1-2e62-4a8f-8fcd-7c2515c6316a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e9e55199b97789934b8c597de1b9de05 3x"}, "body": "はじめましてよろしくお願いいたします！\n\nキャラクター：響ちゃん（艦これ）\n衣装：スクール水着\n背景シチュエーション：廃墟の中のプールに入っている響ちゃん。時間帯は、夏の昼間で廃墟の窓から青空が見える感じでお願い致します。\n\n何卒よろしくお願いいたします！", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@clear_kuuru/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 48467, "client_id": 569892, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a67943e9/uploads/origins/93041394-374e-4b5c-9c4e-beab2a835eab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02253610967f404df0bc2098d97134b3", "srcset": "https://si.imgix.net/a67943e9/uploads/origins/93041394-374e-4b5c-9c4e-beab2a835eab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=02253610967f404df0bc2098d97134b3, https://si.imgix.net/a67943e9/uploads/origins/93041394-374e-4b5c-9c4e-beab2a835eab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8f7231b2b33ea2d1cf62c734a635ed9b 2x, https://si.imgix.net/a67943e9/uploads/origins/93041394-374e-4b5c-9c4e-beab2a835eab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9aeaa86f5975df62bdcf581c59f902c7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a67943e9/uploads/origins/93041394-374e-4b5c-9c4e-beab2a835eab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3d3072205a4880c6f702ef6599906e3", "srcset": "https://si.imgix.net/a67943e9/uploads/origins/93041394-374e-4b5c-9c4e-beab2a835eab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3d3072205a4880c6f702ef6599906e3, https://si.imgix.net/a67943e9/uploads/origins/93041394-374e-4b5c-9c4e-beab2a835eab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3b251eb7259ffe60f5d015a0282d7da1 2x, https://si.imgix.net/a67943e9/uploads/origins/93041394-374e-4b5c-9c4e-beab2a835eab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b5e6755d43e81017f4cc80012ecde08b 3x"}, "body": "お疲れ様です！今回もよろしくお願いします！\n\n夏になったら響とドライブしたいなって思いまして、思いますよね？\nそれできれいなところで降りて、ふたりでコンビニで買ったアイスを食べながら夜景を前にぼんやりするんです。\n\n\n背景:ヴェルニー公園\nオレンジの街灯、広がる夜の海、奥にぼんやりとシルエットだけ見える軍艦。\n\n時間:2330。\n\n服装:膝下までのロングスカート、膝らへんからスリットで動きやすく。\nトップスはすこしだぼついたロングのカットソーを腕まくりして肘まで、シースルーで街灯に照らされてすこし大人っぽく。\n帽子は私服だから第6のはつけないけど、第6のがやっぱり好きだからって無意識に第6のに似たキャップを被ってると思うんです、無意識に。\n\nアイス:パルムみたいなの。\n\nキャラクタ:響でも別府でも。\n\n画像サイズ:横長フルHD、パソコン壁紙用。\n\n\nたぶん横須賀駅前のコンビニでアイス買って、そのままヴェルニー公園行くと思うんですけど、響はヴェルニー公園の猫ちゃんたちに好かれてるので欄干から夜景見ててもすぐ猫ちゃんたちよってきて結局ベンチで二人で猫たちと戯れるんですよね。私にはわかります！\n\nよろしくお願いいたします！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@clear_kuuru/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 48467, "client_id": 569892, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/21346a5a/uploads/origins/0f30b6af-1b7f-4604-96d7-983a33499cf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cd1896e4918bf717714ede4a8bc3867", "srcset": "https://si.imgix.net/21346a5a/uploads/origins/0f30b6af-1b7f-4604-96d7-983a33499cf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6cd1896e4918bf717714ede4a8bc3867, https://si.imgix.net/21346a5a/uploads/origins/0f30b6af-1b7f-4604-96d7-983a33499cf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ec3ca68c823644bcc5b0a33f97bda61 2x, https://si.imgix.net/21346a5a/uploads/origins/0f30b6af-1b7f-4604-96d7-983a33499cf5?bg=%23fff&auto=fo