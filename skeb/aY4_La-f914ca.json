しば熱意を失うことがありますが、研究室を渡り歩くのが好きで、交友関係が広いため、ステーションではスター的な存在です。 非常に現代的なテクノロジーや電子音楽、ビデオゲームが好きですが、昔の映画にはあまり興味がなく、映画を観ている途中でよく寝てしまいます。  \n\n\n要素  青：音楽に関連するもの（CDプレーヤー、ディスク、レコードなど）。一等星、テトリス、宇宙航行、カセットテープ未来派。  \nhttps://drive.google.com/drive/folders/1a3sn40yrgeqjt0k_4JPWJUkekQDYYWi5", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1366068, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "お、", "screen_name": "ooo_0926", "avatar_url": "https://pbs.twimg.com/profile_images/1976456505617678337/k4n0GrRE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1393369213792751620/1768864254/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 160}, {"id": 1563560, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "HojA", "screen_name": "hoja1214", "avatar_url": "https://pbs.twimg.com/profile_images/1481283643821916160/8iA7LhJg.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1337758177358618626/1649920296/1500x500", "appeal_receivable": false, "popular_creator_rank": 11, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 6, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 176}, {"id": 1627193, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "▽", "screen_name": "NkgmGS", "avatar_url": "https://pbs.twimg.com/profile_images/1486303124654821380/wvnHP52G.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1423931224561569796/1632742518/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_r