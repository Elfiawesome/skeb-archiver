core": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ffb2a0b1/uploads/origins/800b831d-98a7-4529-bb7d-58717752930f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08560d29b5049ec0f3c09024636884f4", "srcset": "https://si.imgix.net/ffb2a0b1/uploads/origins/800b831d-98a7-4529-bb7d-58717752930f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08560d29b5049ec0f3c09024636884f4, https://si.imgix.net/ffb2a0b1/uploads/origins/800b831d-98a7-4529-bb7d-58717752930f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=930cff1fdcfe8592e035eb0a4e1bfbad 2x, https://si.imgix.net/ffb2a0b1/uploads/origins/800b831d-98a7-4529-bb7d-58717752930f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1e7da6bf5e674ea7a9c21034d456e0c6 3x"}, "body": "はじめまして、YouTubeで配信活動をしている茅野みらい。と言います！ \n夜雨様の素敵なイラストを拝見し、ぜひOCを描いていただきたいと思いご連絡させていただきました。\n詳細まとめさせていただきますので、お時間があります時にご覧いただけますと幸いです。\n\n使用用途\n・収益化済みチャンネルでのサムネイル等\nX(Twitter)などのSNSでの使用\n商用利用込み希望(グッズ化の可能性あり)\n\n詳細 \n髪や頭部が見切れていないと助かります。 \nキャラクターはインターネットで活動する地下アイドルの女の子です。\n新衣装の地雷衣装を描いていただきたいです\n\n・構図はお任せとさせていただきたいです。 \n・YouTubeにて使用を考えておりますので１６；９の画面サイズですとありがたいです！！ \n・もし背景ありのデータを作成いただけるようであれば、背景と人物を分けた透過データもいただけますと幸いです。\n  よろしくお願いいたします。\n\n資料不足や金額不足がありましたら構わず再送よろしくお願いします🙇‍♀️\n\nhttps://drive.google.com/drive/folders/1jBPpZOFIhz2_3JE9ZHUbJX5XIPiI8yEc?usp=drive_link\nhttps://lit.link/1191\nhttps://x.com/desidesi1237", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yauuu/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3005360, "client_id": 2393124, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d24c341b/uploads/origins/62d88b98-bfe6-43ab-a2d9-2f620a91610d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=242a130c1229c4f52c61fa7e785de616",