bp&fit=crop&crop=top&w=200&h=200&s=ff7095be65e745efbb92ee1b08b1f95b, https://si.imgix.net/f3f5d19f/uploads/origins/d3ed128e-9e42-4bf6-a7ab-006f44d46c79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e182f8af089599d4c7e64c060eb5271c 2x, https://si.imgix.net/f3f5d19f/uploads/origins/d3ed128e-9e42-4bf6-a7ab-006f44d46c79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3cb32c47cb6c6da33f8c1e597bab02ef 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f3f5d19f/uploads/origins/d3ed128e-9e42-4bf6-a7ab-006f44d46c79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8fa708027bd322aba3035da1939b50e", "srcset": "https://si.imgix.net/f3f5d19f/uploads/origins/d3ed128e-9e42-4bf6-a7ab-006f44d46c79?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8fa708027bd322aba3035da1939b50e, https://si.imgix.net/f3f5d19f/uploads/origins/d3ed128e-9e42-4bf6-a7ab-006f44d46c79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a1bc3d72f500e1ec600cf9112ea81268 2x, https://si.imgix.net/f3f5d19f/uploads/origins/d3ed128e-9e42-4bf6-a7ab-006f44d46c79?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c33f70d167a0dbc9fce008ca257d3b99 3x"}, "body": "お疲れ様です。リクエストさせていただきます\n\n●作品\nフラワーナイトガール\n（二次創作ガイドラインはこちら→https://imgur.com/YLzjyCX）\n\n●キャラ\nイソギク\nhttps://flowerknightgirl.game-info.wiki/d/%a5%a4%a5%bd%a5%ae%a5%af\nhttps://i.imgur.com/yIUYKDC\n\n●要望内容\n上記のキャラで「スライム娘による泡洗体レズえっち」をお願いします\n\nスライム娘の具体例は、こちらのゲームのSS（https://i.imgur.com/DPAcf1A.png）に映った、体が泡でできた白い淫魔\n本リクエストにおいては人間に友好的な種族という設定でお願いします\n\n具体的なシチュ希望としては、体を洗う為に銭湯などの風呂椅子に腰かけたイソギクにスライム娘がまとわりついているもの。スライム娘は可能なら２体、厳しければ１体で大丈夫です\nイソギクの体に手を回して隅々洗いつつも、胸を揉みしだきながら乳首やスペンス乳腺尾部を愛撫して胸全体を満遍なくかつ強烈に気持ちよくし、\n股間は手マン（棒の挿入は無しでお願いします！！）で容赦なく快感を叩きつけている様にお願いします\n\nキャラの様子として、スライム娘は前述の通り友好的で、この洗体とレズえっちも、親切心や好意100％でやってるような、体を洗う役目を果たせて嬉しそう・気持ちよくできてニコニコと楽しそうな様子で、\nイソギクは入浴中なので完全全裸に、髪留めを外して髪を下した状態。スライム娘の愛撫の手を制止しようとするも流体なので物理的に阻止できず、好意でやってるのがわかるので言葉での強い拒絶もできず、困り果てた様子でされるがままに気持ちよくさせられている様にお願いします\n\n●補足事項\nSNS上でのシェアの際、機械学習防止ノイズを加えます。御了承下さい\n\nイソギクは見ての通りのロリ爆乳体型です。顔つきや体、手足は幼‎めに、胸に関しては遠慮なく大きくお願いします\nその他、以下の身体的特徴に留意して作画して下さい\n・泣きボクロ（特に忘れられがちです！！！！）\n・アホ毛\n\nそして可能であれば、スライム娘達の胸はそのイソギクより更にデカくお願いします\n\n以上です\n内容的に必要であれば「金額理由の再送」機能の使用も視野に入れて下さい\nご検討頂けると幸いです", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_raku__ukrk/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0b216060/uploads/origins/488d5ebe-1148-48f2-bd86-8429286b0483?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f88d3706ceea581832465c6154f625c7", "srcset": "https://si.imgix.net/0b216060/uploads/origins/488d5ebe-1148-48f2-bd86-8429286b0483?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f88d3706ceea581832465c6154f625c7, https://si.imgix.net/0b216060/uploads/origins/488d5ebe-1148-48f2-bd86-8429286b0483?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eafc29a6839da24ef035ee1d4a7ec237 2x, https://si.imgix.net/0b216060/uploads/origins/488d5ebe-1148-48f2-bd86-8429286b0483?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=89f5920bcd4748bcab59f3e63e788e24 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1966609, "client_id": 5512, "nc": 176}, {"path": "/@_raku__ukrk/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creat