彼女が上位で、彼女にわからせられるようなイメージ)\n\n私自身が「温泉がスライム娘、透明度が高い」というのが好きなのと、小さくて大きな誘ってくるような娘が好きでして…\nそれらをへきらけさん自身のイメージで、へきらけさんの透明感あふれる作風でぜひとも執筆していただきたいと思います。\n\nもしよろしければ、受けていただけると幸いです。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_raku__ukrk/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1966609, "client_id": 849513, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7a6c9284/uploads/origins/6ada555a-11db-4c82-b33b-aa5983365830?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88b54fcfdb3002f3bf50ffeb8774b2f7", "srcset": "https://si.imgix.net/7a6c9284/uploads/origins/6ada555a-11db-4c82-b33b-aa5983365830?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88b54fcfdb3002f3bf50ffeb8774b2f7, https://si.imgix.net/7a6c9284/uploads/origins/6ada555a-11db-4c82-b33b-aa5983365830?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0290b432d9b87261309040a1d2f24f76 2x, https://si.imgix.net/7a6c9284/uploads/origins/6ada555a-11db-4c82-b33b-aa5983365830?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc0efc676cfea4551f2393fa4da5c5bf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7a6c9284/uploads/origins/6ada555a-11db-4c82-b33b-aa5983365830?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a9ca4846c63f64c2550571f57bc9999", "srcset": "https://si.imgix.net/7a6c9284/uploads/origins/6ada555a-11db-4c82-b33b-aa5983365830?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2a9ca4846c63f64c2550571f57bc9999, https://si.imgix.net/7a6c9284/uploads/origins/6ada555a-11db-4c82-b33b-aa5983365830?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=14c09b762ce3c99571219f2afb8559f4 2x, https://si.imgix.