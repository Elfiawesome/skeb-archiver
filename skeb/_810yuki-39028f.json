ワオ」の絵をお願いします！彼女はオレンジが大好きで、羽がないおバカでキュートな妖精です。彼女のデザインで重要なのは、瞳の中に小さなオレンジがあることです。\n\nマスコットのメオ（みかん）と一緒に描いていただけると嬉しいです！\n\n作品は私のSNS(@waomeoVT)にアップする予定なので、出来れば背景とサインの有無でファイルを分けて頂けると嬉しいです。ありがとうございました！\n\nこれが彼女の参考資料です：\nhttps://drive.google.com/drive/folders/1zdwaz_vjNSJ7BGHO7wJLcrCDOYmyeqFY?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_810yuki/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3269627, "client_id": 2304176, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a54f1d7f/uploads/origins/beb8e7c4-3370-4a71-86d0-5e6c364f40aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=409b72d0bc9f02686a41a41964ce1c7d", "srcset": "https://si.imgix.net/a54f1d7f/uploads/origins/beb8e7c4-3370-4a71-86d0-5e6c364f40aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=409b72d0bc9f02686a41a41964ce1c7d, https://si.imgix.net/a54f1d7f/uploads/origins/beb8e7c4-3370-4a71-86d0-5e6c364f40aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=71091ebf4241e753045bd3ad8471b5f9 2x, https://si.imgix.net/a54f1d7f/uploads/origins/beb8e7c4-3370-4a71-86d0-5e6c364f40aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b2104a9f7ba1b3d1d05f09f985559594 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a54f1d7f/uploads/origins/beb8e7c4-3370-4a71-86d0-5e6c364f40aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3139eeeb08704fd5f2b5cdc8fc07e22c", "srcset": "https://si.imgix.net/a54f1d7f/uploads/origins/beb8e7c4-3370-4a71-86d0-5e6c364f40aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3139eeeb08704fd5f2b5cdc8fc07e22c, https://si.imgix.net/a54f1d7f/uploads/origins/beb8e7c4-3370-4a71-86d0-5e6c364f40aa?bg=%23fff&auto