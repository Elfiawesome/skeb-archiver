%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd705f1442dce8933070cfdd682e1a45 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/374d0463/uploads/origins/5359d71a-4193-4d72-bd2f-c221212555fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c55c7965535dfc8b7f9239b946d1d36", "srcset": "https://si.imgix.net/374d0463/uploads/origins/5359d71a-4193-4d72-bd2f-c221212555fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c55c7965535dfc8b7f9239b946d1d36, https://si.imgix.net/374d0463/uploads/origins/5359d71a-4193-4d72-bd2f-c221212555fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=232104f7881fe99ea14b8ced11b3bbbb 2x, https://si.imgix.net/374d0463/uploads/origins/5359d71a-4193-4d72-bd2f-c221212555fb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5196866d440db0b8befee334f1adc17f 3x"}, "body": "私のリクエストは、セリーナが一人で泥の中に入って、後ろから泥の中に沈んで、泥だらけでぬるぬるした自分の裸体を鑑賞し、内側からも外側からも泥と一体化していくのを感じながら、自分自身と戯れるという、また楽しい時間を過ごす漫画が欲しい。楽しんでいるうちに雨が降り始め、泥だらけの彼女の頭はゆっくりと体から滑り落ちたが、気にすることはなかった。首のない泥まみれの身体は泥のスポットの近くにある岩に向かい、彼女のアソコをこすりつけ始める。彼女の首のない身体は、彼女がクンニして非常に大きな呻き声をあげるまで、アソコを岩にこすりつけ続ける。彼女の首のない身体はその快感に疲れ果てて倒れ、さらに雨が降り、彼女の泥だらけの身体は洗い流され、泥のスポットに戻っていく。そして、泥のスポットを新しい住処として、自分が最もセクシーな泥の怪物であることを主張する。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@FfmwJ07ubauGCSb/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f751f847/uploads/origins/1835e2ca-4c7a-4dba-8252-4902aed4e688?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=39164fc303c44989c97ecf9a013a5cac", "srcset": "https://si.imgix.net/f751f847/uploads/origins/1835e2ca-4c7a-4dba-8252-4902aed4e688?bg=%23fff&auto=format%2Ccompress&f