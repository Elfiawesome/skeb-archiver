れば、私の推しキャラのユリウス・ラインベルグのイラストをお願いしてもよろしいでしょうかᙏ💕？\n\nユリウスは貴族出身の天才的な氷の魔道士で、ナルシシズムに近いほど傲慢だ。とはいえ、彼は強いノブレス・オブリージュの意識を持っており、それを認めるくらいなら死んだほうがましだとさえ思っている。とてつもなくプライドが高く、典型的な貴族の風格を漂わせている🌹❄️\n\n傲慢な笑みを浮かべながら、彼の圧倒的な美しさ、無理のない優雅さ、そして紛れもないカリスマ性を表現してください🩵✨。\n\n目を閉じたり、ウインクしたりしないでください🙏。\n\nhttps://skeb.jp/@nemuo_zZ/works/6。\n\n私のリクエストにご配慮いただき、ありがとうございます。あなたの華麗なスタイルで、私の好きなキャラクターを見てみたいです᥹🙏🩵。\n\nhttps://drive.google.com/drive/folders/1AeWUFrG8Xjc3BiFAc4unzAUZIE-Jtj6o", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nemuo_zZ/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 794672, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/36c50aa7/uploads/origins/e8b30fae-bcd1-488b-8a61-d957f994a89c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64b581ea313f53709e6e33b6315d8648", "srcset": "https://si.imgix.net/36c50aa7/uploads/origins/e8b30fae-bcd1-488b-8a61-d957f994a89c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64b581ea313f53709e6e33b6315d8648, https://si.imgix.net/36c50aa7/uploads/origins/e8b30fae-bcd1-488b-8a61-d957f994a89c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1d6f88f1af33008cea879c4f0fcfab7 2x, https://si.imgix.net/36c50aa7/uploads/origins/e8b30fae-bcd1-488b-8a61-d957f994a89c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bcd19b4df6fc9d490636cfd38bb93d59 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/36c50aa7/uploads/origins/e8b30fae-bcd1-488b-8a61-d957f994a89c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b59c3042dedcbc5b94e0e759faf1ea86", "srcset": "https://si.imgix.net/36c50aa7/uploads/origins/e8b30fae-bcd1-488b-8a61-d957f994a89c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b59c30