le": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@tiny_d1/works/72", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2250344, "client_id": 2986043, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/27668b85/uploads/origins/64110a4b-ea34-4a7f-b299-b3b0fedcaa49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbc66a5d1f8ec46658f06cb15d165505", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/27668b85/uploads/origins/64110a4b-ea34-4a7f-b299-b3b0fedcaa49?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=219fe3be673a02667e5b706b58a7ddbc", "src_set": ""}, "body": "あなたの絵がずっと好きだったので、何かお願いできればと思っています。\n\n軌跡のノエルとジュナが水着を着てビーチで水鉄砲で遊んでいる絵が見たいんだ。  \n\nできれば、背中（背中、お尻、太もも）が見えるように、どちらか（または両方）がこちらに背を向けて立っていてほしいです。  ポーズの参考になりそうなものを添付しましたが、厳密に従う必要はありません。\n\n好きな水着を着せてください。\n\nリクエストに応えていただき、ありがとうございました。\n\nポーズ参考：\nhttps://drive.google.com/file/d/1CwVqce2sW8E77iyB1k3mc2qKr2uVk65F/view?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tiny_d1/works/71", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2250344, "client_id": 680176, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a0ada1c2/uploads/origins/86e6c9cd-4543-4595-a915-5dd298a6b1af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8bebe57602cd5c9c8efe18178ed75fc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a0ada1c2/uploads/origins/86e6c9cd-4543-4595-a915-5dd298a6b1af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffb86d82f5875b2a43eac64939c7b5d9", "src_set": ""}, "body": "こんにちは！\n\n人物：英雄伝説 界の軌跡 フィー・クラウゼル ( https://imgur.com/a/hMjK6vG )\n             英雄伝説 界の軌跡 リィン・シュバルツァー ( https://imgur.com/a/oIHpL3x )\n衣装：水着 ( https://imgur.com/a/CHGSXk6 )\n\nシチュエーション\n海辺で日焼け止めを黙々と塗ってくれるリィンと今更リィンが塗ってくれる事に照れるフィー\n\n読んで頂きありがとうございます！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tiny_d1/works/70", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2250344, "client_id": 2885142, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/91e52676/uploads/origins/be061e25-a598-4c5f-8159-f3b0d5680085?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1db5b14ba4c3775a1b055fef3aca6a51", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/91e52676/uploads/origins/be061e25-a598-4c5f-8159-f3b0d5680085?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a9b22e790698c2347546cce110826a83", "src_set": ""}, "body": "たいにぃ様　再びこんにちは。\n今までのイラスト大好きで、本当にありがとうございました!!\nまたご依頼させて頂きたいです。\n\n相変わらずグランブルーファンタジーのゼタです。\n今回は水着スキン真夏の穿光てす。\n\nポーズ、構図、背景など、詳細はすべてお任せします。\n連続しての依頼で恐縮ですが、宜しければお願い致します。\n\nhttps://img.gamewith.jp/img/7e2ad84b54dc88fc1fc47edb448c2201.jpg?fbclid=IwY2xjawLd6l9leHRuA2FlbQIxMABicmlkETF4eGpGc0Q4RkZqN2Y1SkJUAR7PNJWRP2pp17Swq5IBw_lSX1yNyFkGpc_wUVEDHHWXdpU-i_S9xuv9aBTVgw_aem_kP0_cZvOrJ9a9cvWGzY0TA", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tiny_d1/works/69", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2250344, "client_id": 3681245, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db39655f/uploads/origins/80b35099-f26b-4f65-b413-575852872a98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7b5550409f029f868c4b4425f5f66e0a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db39655f/uploads/origins/80b35099-f26b-4f65-b413-575852872a98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01e9b247affe3cc1914962b84ae71eaf", "src_set": ""}, "body": "はじめまして！\nXでイラストを見てリクエストを送らせていただきました！\n\nキャラクターはグランブルーファンタジーのビカラ\n\n構図は横長、その他詳細はお任せします。\n\nよろしければお願い致します。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tiny_d1/works/68", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2250344, "client_id": 1250738, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/572bb63b/uploads/origins/0c0b0404-0c5c-40f8-b55b-746fd78680a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92262128502c2d5a421c5629a9b3d302", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/572bb63b/uploads/origins/0c0b0404-0c5c-40f8-b55b-746fd78680a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2b6b91a99f0414892ebb7714ae9c0378", "src_set": ""}, "body": "こんにちは、たいにいさん！  今回もたくさんの作品をありがとうございました！  まだまだ探りたいシナリオがたくさんあります！\n\n今回は、VII組のサラと他の女の子たち（アリサ、ラウラ、ミリウム、エマ、フィー）とのキャンプアウトのシーンをお願いしたいと思います。  サラは生徒たちを怖がらせようと、スリリングな怪談話をしている。  話に夢中になる生徒もいるだろうが、全員が完全に注意を払うわけではないことは想像できる！  全体的には、女の子たちが一緒に楽しい時間を過ごしているキャンプの場面を見てみたい。  イベントの時間帯は学生時代であってほしいが、彼女たちはアカデミー服を着ている必要はなく、同じ服を何度も着るよりも、その方が楽しく、面白く描けるのであれば、もっとカジュアルな服装でも構わない。\n\nご配慮ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1GpTKGpsIPSs-QV2mSfJiGjW7klovclRT?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tiny_d1/works/67", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2250344, "client_id": 3523423, "vtt_url": null, "thumbnail_image_urls": {"src": "https://