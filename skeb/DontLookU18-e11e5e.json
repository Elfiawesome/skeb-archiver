omic", "tipped": false, "creator_id": 3165111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e4d8cb0f/uploads/origins/fb0e61a7-2232-4049-9c50-795856644e88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae005827104e93a227c9eb315fc9b675", "srcset": "https://si.imgix.net/e4d8cb0f/uploads/origins/fb0e61a7-2232-4049-9c50-795856644e88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ae005827104e93a227c9eb315fc9b675, https://si.imgix.net/e4d8cb0f/uploads/origins/fb0e61a7-2232-4049-9c50-795856644e88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=da9ecadfd860ee692274f672eca37802 2x, https://si.imgix.net/e4d8cb0f/uploads/origins/fb0e61a7-2232-4049-9c50-795856644e88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=efe0770271ae37962a07b1fd76fc7b1a 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e4d8cb0f/uploads/origins/fb0e61a7-2232-4049-9c50-795856644e88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8434df01ab8212a9dbaccc4e43992726", "srcset": "https://si.imgix.net/e4d8cb0f/uploads/origins/fb0e61a7-2232-4049-9c50-795856644e88?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8434df01ab8212a9dbaccc4e43992726, https://si.imgix.net/e4d8cb0f/uploads/origins/fb0e61a7-2232-4049-9c50-795856644e88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0fb2f6a29ab943d1b5a258922b882542 2x, https://si.imgix.net/e4d8cb0f/uploads/origins/fb0e61a7-2232-4049-9c50-795856644e88?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8180aa2cfb3c304b54be08d2d0d6e695 3x"}, "body": "水着（リリティカルサマー）の雨嘉亜羅椰の入れ替わり漫画をお願いします\n\n\n二人の水着と髪型は中身の方のを着ていて、事情を知らない人が見たら水着と髪型交換してる感じになっている\n腕輪とかの細かい装飾は無しで大丈夫です\n例えば雨嘉（亜羅椰）のハートサングラスとか猫耳サーチャーとかみたいな印象的なものは描いて欲しいです\n\n\n\n\n\nまず、雨嘉（亜羅椰）がURLの亜羅椰みたいな表情で秤目を使って女の子達を見ていて、それを亜羅椰（雨嘉）に見つかる\n\n\nレアスキルをこんなことに使ってたのを当然怒られるが雨嘉（亜羅椰）の興味は目の前の自分に移っていて普通出来ない体験だから自分を喰ってみたいと思う\n\n\n体の方の影響を少なからず受けるって設定なので拒否する亜羅椰（雨嘉）が嫌がってないのを見抜かれてるのでそこを指摘される\n雨嘉（亜羅椰）は雨嘉らしい感覚や湧いてくる感情を体験して、この水着も最初は恥ずかしく感じて大変だったので相手もそうだろうと思った感じです\n実際亜羅椰（雨嘉）は気づけば女の子を目で追ってしまってたし、喰っちまいたい感情を頑張って抑えていたしで大変だった\n\n\n雨嘉というかわいい女の子が自分を誘惑してくるのに亜羅椰の体が我慢できないのでそこからえっちへ\n\n\n最初は雨嘉（亜羅椰）が攻める感じですが、亜羅椰の体の欲求をずっと我慢してたので、限界を迎えた亜羅椰（雨嘉）も途中から積極的になる感じです\nやっぱり亜羅椰は巧いので、気持ちよくて蕩けさせられ理性が弱まったから仕方ないかなと思います\n\n細かい流れやセリフ、行為やオチとかもご自由になさってください\n\n\n\nコミック初めてで依頼内容の加減がまだ分からないですが、大丈夫そうでしたらよろしくお願い致します。\n\nhttps://x.com/assaultlily_lb/status/1814140718187004156", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@DontLookU18/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3165111, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/56d70886/uploads/origins/f09f70c8-4043-4304-941f-c0a265aa588a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=536a4d2a75350565795a408c2eeced3b", "srcset": "https://si.imgix.net/56d70886/uploads/origins/f09f70c8-4043-4304-941f-c0a265aa588a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=536a4d2a75350565795a408c2eeced3b, https://si.imgix.net/56d70886/uploads/origins/f09f70c8-4043-4304-941f-c0a265aa588a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e21747e8508289695c0b65095e4fbd04 2x, https://si.imgix.net/56d70886/uploads/origins/f09f70c8-4043-4304-941f-c0a265aa588a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fbaa0473e3e1411b924c1f8f488b3fdb 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/56d70886/uploads/origins/f09f70c8-4043-4304-941f-c0a265aa588a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82762d1af449d7daf190b