ix.net/1860f14e/uploads/origins/3cde5533-1d56-40d1-83c7-20fd2862c160?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=077482053d65e6c11581f190d879e531", "srcset": "https://si.imgix.net/1860f14e/uploads/origins/3cde5533-1d56-40d1-83c7-20fd2862c160?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=077482053d65e6c11581f190d879e531, https://si.imgix.net/1860f14e/uploads/origins/3cde5533-1d56-40d1-83c7-20fd2862c160?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=baa851f56c57acbca286cafb24a0eb85 2x, https://si.imgix.net/1860f14e/uploads/origins/3cde5533-1d56-40d1-83c7-20fd2862c160?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b54f612320d50e5359b7b7b027961a2d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1860f14e/uploads/origins/3cde5533-1d56-40d1-83c7-20fd2862c160?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f23e3b212f980989b2ad6e183844ae4a", "srcset": "https://si.imgix.net/1860f14e/uploads/origins/3cde5533-1d56-40d1-83c7-20fd2862c160?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f23e3b212f980989b2ad6e183844ae4a, https://si.imgix.net/1860f14e/uploads/origins/3cde5533-1d56-40d1-83c7-20fd2862c160?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=315e31b29a661e59bf080df4671c282d 2x, https://si.imgix.net/1860f14e/uploads/origins/3cde5533-1d56-40d1-83c7-20fd2862c160?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=27a4bd6e5f9417201156dcdb30676c9f 3x"}, "body": "Karo様、はじめまして！イラストを楽しく拝見させて頂きました。素敵な絵柄と創作物の世界観に惹かれて、可能ならば自キャラを依頼したいと思っております。\n\n【依頼内容】\nキャラ参照は下記のURLをご覧ください。中華風ファンタジー世界に「秋」をテーマにした地域に住んでいる「三賢」と呼ばれた３人です。3人の中からお好きな2人コンビを描いても大丈夫です！\n\n【🐓1】WANG YIN\n∎ 赤髪の子。美術館の様な宮殿に住んでいる若き王様。身長は188㎝で最年少。細かいことは気にせず、愉快な性格の持ち主。ド派手なもの、お酒、碁と詩が大好きな騒がしいお祭り男。他の2人が大好きでグイグイ押してくるくせに、押されたら意外と弱くてすぐ恥ずかしくなる。\n\n【🦚2】SONG ZE\n∎ 清らかで純粋な詩人。身長は172㎝で最年長。お姉さんタイプでちょっとボケてるところもあります。鳥族の人ですので、孔雀の尾羽が生えています。注意点は太い眉毛と、巻物のスクロールに書かれている文字から咲いている様々な花。[3]とは長いお付き合いで、彼を通じて[1]と知り合った。彼らをとても大切に思っています。\n\n【🐤3】SPARROW\n∎ 茶髪の子。盗賊集団の頭。身長は170cm。強情で自信溢れているカリスマ性があって、暴君でありながら意外と賢明的で、詩とギャンブルが大好きな男です。注意点は右の眉毛にある傷跡。保護者役で[1]&[2]を可愛がるのが好きです。\n\n【設定】\n∎ 3人を出会ったのは戦前時代に。国の混乱によってそれぞれの道を分かち、結局(2)は行方不明になった。内乱に落ちた王国を統一するために(1)と(3)は手を組んで、(3)は世間の目に「悪役」を演じ、(1)に処刑されています。でもそうなる前の3人はお互いにとってはかけがえのない存在、最後までずっと大切に思っていました。\n\n【テーマ】\n・キャラの関係性が表す様に、「季節の終わり」をテーマにした一枚をお願い致します。\n・その他は何でも構いませんので、お気軽に描いてください。\n\n依頼内容に何か難しい点か問題点があれば、お気になさらずこの依頼をキャンセルしてください。ご検討のほど、何卒よろしくお願いします。\n\nhttps://sta.sh/22dxfn4omajr", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@karokuroka/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d9d5255b/uploads/origins/4650e25f-da87-40de-aff6-e1c8df3efd85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e478c2ffabc1e3e904b8062d1c707b5d", "srcset": "https://si.imgix.net/d9d5255b/uploads/origins/4650e25f-da87-40de-aff6-e1c8df3efd85?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e478c2ffabc1e3e904b8062d1c707b5d, https://si.imgix.net/d9d5255b/uploads/origins/4650e25f-da87-40de-aff6-e1c8df3efd85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f82b1d3eaffbd8e7d60c7a259150ec4f 2x, https://si.imgix.net/d9d5255b/uploads/origins/4650e25f-da87-40de-aff6-e1c8df3efd85?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=293ec9b64fd681d9af19ad7197