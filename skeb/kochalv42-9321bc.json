、目の色は水色にする必要があります。\n\n\n\nこれは主にTwitterで自慢するためのものです\n\nお忙しい中、ありがとうございました。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kochalv42/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 288242, "client_id": 1480804, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bd668862/uploads/origins/2b3e1500-9aad-4952-b280-ab0d327088a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3323c886a3da5dc6ca3218a7c6a4d29f", "srcset": "https://si.imgix.net/bd668862/uploads/origins/2b3e1500-9aad-4952-b280-ab0d327088a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3323c886a3da5dc6ca3218a7c6a4d29f, https://si.imgix.net/bd668862/uploads/origins/2b3e1500-9aad-4952-b280-ab0d327088a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5bd21b35aebe6cec6787b7b3e5435b4 2x, https://si.imgix.net/bd668862/uploads/origins/2b3e1500-9aad-4952-b280-ab0d327088a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5fab7441db28f13356ac3127d31d486f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bd668862/uploads/origins/2b3e1500-9aad-4952-b280-ab0d327088a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cfc93f0f33399e42e92e28d3cd2187fb", "srcset": "https://si.imgix.net/bd668862/uploads/origins/2b3e1500-9aad-4952-b280-ab0d327088a0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cfc93f0f33399e42e92e28d3cd2187fb, https://si.imgix.net/bd668862/uploads/origins/2b3e1500-9aad-4952-b280-ab0d327088a0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5e37d719529197c5dfce15433444b775 2x, https://si.imgix.net/bd668862/uploads/origins/2b3e1500-9aad-4952-b280-ab0d327088a0?bg=%23fff&auto=format%2Ccompress&f