rop=top&w=200&h=200&blur=200&s=ae194b0defc056d4519c5fb50b9438a3", "srcset": "https://si.imgix.net/247f0df6/uploads/origins/ae4161c2-3908-4578-8c8c-4d5ede3807da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae194b0defc056d4519c5fb50b9438a3, https://si.imgix.net/247f0df6/uploads/origins/ae4161c2-3908-4578-8c8c-4d5ede3807da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=137f0b059d9015bb2ed7c4587e64d249 2x, https://si.imgix.net/247f0df6/uploads/origins/ae4161c2-3908-4578-8c8c-4d5ede3807da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f4454462bce34fd0d23587b9c4c8e97f 3x"}, "body": "お世話になります。\n今回は、制服姿の家奈ちゃんが痴漢にあってしまう様子をお願いしたいです。\n部活が遅くなり、ひとり満員電車で帰る家奈ちゃん。窓際に押しつけられた状態で、むちむちボディを弄られてしまうのを考えております。\n制服の上から胸を軽く、この時点ではまだ事故くらいのつもりの家奈ちゃん\n→大胆に揉みしだき股間もスカート越しに押し込まれ、顔を真っ赤にしながらも怯えている\n→上下をまくり上げられ、地味な下着(可能ならキツキツのグレーのスポブラショーツをお願いしたいです！)を剥き出されおびえながら泣いてしまう。ショーツにはシミが…\n→下着越しにさらに攻められ、お漏らしアクメ。顔を真っ赤にしたレイプ目で放心状態。\n\n上記の御検討、よろしくお願いいたします！", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@minabetetumi/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 16837, "client_id": 2279283, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ef18d69c/uploads/origins/9babf595-5e6a-40d7-87ed-d900679dfd92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2447c87fa98fe51a547b76b48dddccad", "srcset": "https://si.imgix.net/ef18d69c/uploads/origins/9babf595-5e6a-40d7-87ed-d900679dfd92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2447c87fa98fe51a547b76b48dddccad, https://si.imgix.net/ef18d69c/uploads/origins/9babf595-5e6a-40d7-87ed-d900679dfd92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bc89b9f4234a5a5b2611f62c1f97c7f7 2x, https://si.imgix.net/ef18d69c/uploads/origins/9babf595-5e6a-40d7-87ed-d900679dfd92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8bc32046cc458c56203d06bf3127f6e3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ef18d69c/uploads/origins/9babf595-5e6a-40d7-87ed-d900679dfd92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07a30eb4ec19c67574f0d035271db626", "srcset": "https://si.imgix.net/ef18d69c/uploads/origins/9babf595-5e6a-40d7-87ed-d900679dfd92?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=07a30eb4ec19c67574f0d035271db626, https://si.imgix.net/ef18d69c/uploads/origins/9babf595-5e6a-40d7-87ed-d900679dfd92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=be56fdc86b12a11eef30d99435d878bd 2x, https://si.imgix.net/ef18d69c/uploads/origins/9babf595-5e6a-40d7-87ed-d900679dfd92?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d97593c9a1dff15a4d2ead9aeca06930 3x"}, "body": "お世話になります。南部さんのスク水触手貫通と有坂さんのスク水ボテを拝見しまして、リクエストさせていただきます。\n\n南部さんと有坂さんが69のような状態で触手に拘束されて、お互い尻穴から口まで貫通してきた触手に前も貫かれてしまうのをお願いしたいです。\nお互いの体を密着する状態ではなく、南部さんが仰向けになって、有坂さんが膝立ちで股間を見せるような状態です。南部さんは全く身動きできないくらいガチガチに、有坂さんは手を後ろ手で、一緒に髪を持ち上げるように拘束されている状態をお願いしたいです。おっぱいはどちらもギチギチに、有坂さんは重力に従う巨乳をソフトクリームのようならせん状に、南部さんは控えめっぱいを根元から絞り出すような状態をいただけると嬉しいです。\n二人とも格好はスク水で、ご丁寧に触手が胸元や股間の布をずらしているのをお願いします。\n\nそれぞれ挿入前(有坂さんはくっころ、南部さんはおびえ)\n→アナル挿入で顔を歪める\n→口まで貫通ボテ腹で目を見開きパニック状態\n→口から出てきた触手が相手の前に挿入し子宮まで犯されパンパンでスク水が裂けてしまう、涙を流し発狂\n→一気に引き抜かれぽっかり2穴からの精液とおしっこで互いを汚してしまいレイプ目で壊れた笑い(お腹はすこしだけ凹むがまだまだ凹み切らない)。口からも精液が溢れる。\nという流れをお願いできますでしょうか。そして2人それぞれ頭側からの構図をいただけると嬉しいです。\nいつも以上に細かく作業量の多いリクエストで申し訳ありませんが、ご検討よろしくお願いいたします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@minabetetumi/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 16837, "client_id": 989786, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d9ca1a42/uploads/origins/7f893617-02f8-467b-b6ce-ae58701fbbda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a07b339701d83e8424a4428c27ff8cfb", "srcset": "https://si.imgix.net/d9ca1a42/uploads/origins/7f893617-02f8-467b-b6ce-ae58701fbbda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a07b339701d83e8424a4428c27ff8cfb, https://si.imgix.net/d9ca1a42/uploads/origins/7f893617-02f8-467b-b6ce-ae58701fbbda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77109cdf91fc5de02e03e42630c383b1 2x, https://si.imgix.net/d9ca1a42/uploads/origins/7f893617-02f8-467b-b6ce-ae58701fbbda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d95268cb583cf09ab60074cef7acf922 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d9ca1a42/uploads/origins/7f893617-02f8-467b-b6ce-ae58701fbbda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37811a7f56e6100b3c22fe873e5fe96d", "srcset": "https://si.imgix.net/d9ca1a42/uploads/origins/7f893617-02f8-467b-b6ce-ae58701fbbda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37811a7f56e6100b3c22fe873e5fe96d, https://si.imgix.net/d9ca1a42/uploads/origins/7f893617-02f8-467b-b6ce-ae58701fbbda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=65c9c975204c1256474b98d449ebf634 2x, https://si.imgix.net/d9ca1a42/uploads/origins/7f893617-02f8-467b-b6ce-ae58701fbbda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d6ff386559ca9afa82ba6540eef2bdab 3x"}, "body": "お世話になります。立て続けで、またコミケ前に恐縮ですが、手数料キャンペーン中ということでまたリクエストさせていただきます。\n先日の有坂さんの続きの内容をお願いしたいと思います。臨月になり、すっかりお腹が大きくなってしまった有坂さん。出産の様子まで教材として記録されてしまう様子をお願いできますでしょうか。可能なら、胸と乳輪も普段より少しだけ大きく、色も濃い目(黒ではない)にしていただき、母乳がにじんでいる様子をお願いしたいです。\n今回は体育教師がサポートと称して背面座位orフルネルソンのような体位で抱きかかえている状態を考えております。\n\nまた時系列差分をお願いしたく、\n1.抱きかかえられ、お腹が苦しく息を荒くしている有坂さん。教師はお腹と胸を撫でまわしている。\n2.破水。陣痛もあり、痛みで顔をゆがめる。子宮口が開いて奥に頭が見える。\n3.なかなか生まれてこず、教師がサポートと称してアナルファックを開始。胸も絞られ、嫌なのに頬を染めてしまう有坂さん。\n4.アナルに大量中出しされ、イッた刺激でなんとか出産。アクメ顔と尿失禁を晒してしまう。\n\n前回以上に変態シチュを恐縮ですが、ご検討お願いいたします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@minabetetumi/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 16837, "client_id": 989786, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fffb9e41/uploads/origins/16010d3e-2087-4ed1-820b-5a07b37b32bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=369317ebcb63d186a75772b86ba90ffb", "srcset": "https://si.imgix.net/fffb9e41/uploads/origins/16010d3e-2087-4ed1-820b-5a07b37b32bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=369317ebcb63d186a75772b86ba90ffb, https://si.imgix.net/fffb9e41/uploads/origins/16010d3e-2087-4ed1-820b-5a07b37b32bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eee2328aee1ec1a11496a47dab41e33f 2x, https://si.imgix.net/fffb9e41/uploads/origins/16010d3e-2087-4ed1-820b-5a07b37b32bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e23997ca3302a1dc2549087131836765 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fffb9e41/uploads/origins/16010d3e-2087-4ed1-820b-5a07b37b32bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f5b62378c103681e652de6825f003c1", "srcset": "https://si.imgix.net/fffb9e41/uploads/origins/16010d3e-2087-4ed1-820b-5a07b37b32bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f5b62378c103681e652de6825f003c1, https://si.imgix.net/fffb9e41/uploads/origins/16010d3e-2087-4ed1-820b-5a07b37b32bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=eb15b7b2263064f21832f1192f31c89e 2x, https://si.imgix.net/fffb9e41/uploads/origins/16010d3e-2087-4ed1-820b-5a07b37b32bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f1aa55d8a88d2d31d4184ea735c2d2c4 3x"}, "body": "こちらでは初めましてになります。\n先生のキャラの有坂さんが、保健体育の教材にされてしまう様子をお願いできますでしょうか。\n体操着＋ブルマで、分娩台に手足を固定して座らされる。体操着の裾は口に咥えた状態で、ブラはずり降ろされ巨乳が窮屈そうにしている。ブルマはパンツごと、股間ががギリ見えるくらいにずり降ろされている。\nクスコでまんを思い切り拡げられ、内視鏡を入れて子宮を観察される。\n\n可能なら以下の時系列をお願いしたいのですが、\n１．内視鏡でモニターに子宮口を映される。真っ赤な顔で画面を見つめる。\n２．内視鏡を子宮の中に突っ込まれる。奥には卵管口が見え、目を閉じて口端からよだれがこぼれる。\n３．男子生徒から集めた精液を内視鏡越しに子宮～卵管内に流し込まれる。お腹が少しだけ膨れ、泣き叫ぶ。\n４．そのまま子宮口に小型プラグをはめ込まれ、プラグの隙間から精液がこぼれる様子を映される。泣き疲れてのレイプ目、ここで受精描写もお願いできますでしょうか。\n\nまたも長々と変態シチュを申し訳ありませんが、上記のご検討、よろしくお願いいたします。\n\nhttps://www.pixiv.net/artworks/88055444", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@minabetetumi/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 16837, "client_id": 319441, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/60455208/uploads/origins/dacea400-9c6c-42dc-9331-f867a5f682bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3142227a4500abc09a468cb427951b30", "srcset": "https://si.imgix.net/60455208/uploads/origins/dacea400-9c6c-42dc-9331-f867a5f682bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3142227a4500abc09a468cb427951b30, https://si.imgix.net/60455208/uploads/origins/dacea400-9c6c-42dc-9331-f867a5f682bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e5defc07c67be0277a43c024f81f40e 2x, https://si.imgix.net/60455208/uploads/origins/dacea400-9c6c-42dc-9331-f867a5f682bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86875068b6f7b0b3e94931cd45199b77 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/60455208/uploads/origins/dacea400-9c6c-42dc-9331-f867a5f682bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5044ba0b9659029e3ee8ce782673a83e", "srcset": "https://si.imgix.net/60455208/uploads/origins/dacea400-9c6c-42dc-9331-f867a5f682bc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5044ba0b9659029e3ee8ce782673a83e, https://si.imgix.net/60455208/uploads/origins/dacea400-9c6c-42dc-9331-f867a5f682bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a39a7d0a662d2407ada4931c57447acd 2x, https://si.imgix.net/60455208/uploads/origins/dacea400-9c6c-42dc-9331-f867a5f682bc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=61d51a4e4c3318bbedbced0b2f50b863 3x"}, "body": "リクエスト失礼します\n今回は前回（https://skeb.jp/@minabetetumi/works/7）の続きとしての依頼をお願いしたいと思います\n\n\n〇キャラ：\n・ミリ姫大戦のダグラス・ケイ\n\n〇服装指定：\n・前回と同じです（お腹のボディペイントもそのままでお願いします）\n・パンティは無しでOKです\n\n〇シチュ：\n・ケイが片足を持ち上げられた状態で側位セックスしています（四十八手で言うと松葉崩しが近い感じです）\n・視点は横からの視点がメイン。別コマで、デニムスカートの中を覗くハメ撮りっぽい視点もサブとしてお願いします\n・竿役の描写は透明人間、またはおちんぽ以外最小限でお願いします\n・強姦か和姦かはお任せ致します。どちらもイケます\n\n〇差分：\n恐縮ですが、今回は差分もお願い致します\n\n・差分適用前…お腹は通常。胸も乳首が勃ってチューブトップを押し上げていますが、母乳は出てません\n↓\n・差分適用後…お腹はボテ腹に（うっすら血管が浮かんでいるとベストです）。乳首からは母乳が噴き出てチューブトップに染みを作っています\n\n\n以上、お手数をお掛けしますが、差し支えなければご検討願います\n宜しくお願いします", "nc": 187, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@minabetetumi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 16837, "client_id": 319441, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f99a2693/requests/235686_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=572c3f9801c2f23d9d749f123977d179", "srcset": "https://si.imgix.net/f99a2693/requests/235686_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=572c3f9801c2f23d9d749f123977d179, https://si.imgix.net/f99a2693/requests/235686_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aead1cd6e01485af424656a2d6bae877 2x, https://si.imgix.net/f99a2693/requests/235686_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2dd1245454686f0396570aee90ed320 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f99a2693/requests/235686_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efcb3f2bd8379c8948e56af1914984bd", "srcset": "https://si.imgix.net/f99a2693/requests/235686_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efcb3f2bd8379c8948e56af1914984bd, https://si.imgix.net/f99a2693/requests/235686_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8b9ddc058cb769f1edf52280fba6a243 2x, https://si.imgix.net/f99a2693/requests/235686_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3a56e332da65b08715aaa99dc0c4899d 3x"}, "body": "リクエスト失礼します\n\n\n〇キャラ：\n・ミリ姫大戦のダグラス・ケイ\n\n〇粗筋：\nアイドル活動の一環として写真撮影の仕事を請けたケイ。\nだが、渡された衣装は普段の服より露出が多かった！\n……という事で、自撮り写メで感想を聞いてみる事にしたのだった。\n「この格好はちょっとどうかと思うのだが……どうだろうか？」\n\n〇シチュ：\n・ケイがスマホで口を隠しながら自撮りしています（鏡に向かって撮っていますが、鏡のエフェクトは不要です）\n・視点は鏡視点です\n・困惑と恥じらいの表情\n\n〇服装指定：\n・上着＝白い上着（前が全開になっている）\n・上半身下着＝ピンクのチューブトップ\n・お腹＝「71」のボディペイント\n・下半身＝デニムのミニスカート\n・脚＝網タイツに改造されたカモフラネット（メッシュは粗めで、草木は生やさない方向でお願いします）\n以上、服装をあげてみましたが、\n※【へそ出しファッション】であればいくらでも改変してOKです！※（正直、ファッションには自信が無いので……）\n\n\nもし差し支えなければ宜しくお願いします", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@minabetetumi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 16837, "client_id": 319441, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d6efb6a4/requests/122233