た新衣裳やこれまでの通常衣裳、先生のイメージした衣装やコスプレ的な姿でも構いません。\nサムネやXポスト等に使用していただく事が多いので、可能であれば縦型で見切れがないとうれしいです。\n\n使用用途はファンアートとしてのプレゼントですが、\n彼女の収益化された配信やSNS、グッズ販売などでも使用してもらいたいと考えています。\nキャラクターのみのPSDデータ、もしくは透過PNGデータ等も併せて頂けますと幸いです。\n\nご検討よろしくお願いいたします。\n\nhttp://lit.link/torimunemomo", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ayayami13/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2882388, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6b4d530/uploads/origins/d95538f0-f234-4861-a1ec-a21495204164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3f8e1a0fd9ae4396cb4b179d29c6cba", "srcset": "https://si.imgix.net/c6b4d530/uploads/origins/d95538f0-f234-4861-a1ec-a21495204164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f3f8e1a0fd9ae4396cb4b179d29c6cba, https://si.imgix.net/c6b4d530/uploads/origins/d95538f0-f234-4861-a1ec-a21495204164?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=daecdcab828590b24db2367336f36e9d 2x, https://si.imgix.net/c6b4d530/uploads/origins/d95538f0-f234-4861-a1ec-a21495204164?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e96b99177a1601549cc8b26a99f2364e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6b4d530/uploads/origins/d95538f0-f234-4861-a1ec-a21495204164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a34cf76d9a1e2125e94e61f65f7ac927", "srcset": "https://si.imgix.net/c6b4d530/uploads/origins/d95538f0-f234-4861-a1ec-a21495204164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a34cf76d9a1e2125e94e61f65f7ac927, https://si.imgix.net/c6b4d530/uploads/origins/d95538f0-f234-4861-a1ec-a21495204164?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=