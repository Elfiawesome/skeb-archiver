d-4ac9-a0da-a03bfc92ff5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f94ad70c7cf6626b13296b7f882cc8bd 2x, https://si.imgix.net/9f6386cd/uploads/origins/6efb55e3-54ed-4ac9-a0da-a03bfc92ff5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7cb649a5666a43c92efa5de602540458 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f6386cd/uploads/origins/6efb55e3-54ed-4ac9-a0da-a03bfc92ff5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2205dbf7e590550cfade40252c8a1da0", "srcset": "https://si.imgix.net/9f6386cd/uploads/origins/6efb55e3-54ed-4ac9-a0da-a03bfc92ff5c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2205dbf7e590550cfade40252c8a1da0, https://si.imgix.net/9f6386cd/uploads/origins/6efb55e3-54ed-4ac9-a0da-a03bfc92ff5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cc64b573e7aa5f2c93f4a226ff1e987a 2x, https://si.imgix.net/9f6386cd/uploads/origins/6efb55e3-54ed-4ac9-a0da-a03bfc92ff5c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=923efe39ea32d8b409f881b794db83b7 3x"}, "body": "お世話になっております。今回はいつもの少女でなくかんな様のラッコくんなんですがお願いできますでしょうか。二次創作なのは言うまでもありませんが頭の中で色々と設定をふくらませており、ゲームや映画でよくある善玉寄りのトレジャーハンターのようなものと認識しています。\n\nhttps://karapaia.com/archives/52127446.html\nhttps://www.nauticexpo.com/ja/seizomoto-senpaku/kiwado-48532.html\n\n・深海にて、ビンテージ風潜水服やのこぎりなど普段よりややいかつい装備のラッコくんが沈没船からロングヘアの女性をかたどった船首像を切り出し浮上し始めたのを見上げほわーってなってる様子\n・無機質で真っ白な外殻のあちこちにヒビや欠けが出て中身が露出している\n(全身か半身か、およびそのダメージ度合いもおまかせ)\n・顔にもいわゆるマスク割れの要領でいずれか片側の顔、少なくとも目元周辺に素顔がみえて驚きとともにちょっと涙が浮かんでる表情で\n(覚悟のススメで中盤以降みられるような…妥当な画像がなくすみません)\n\n女性がかならずしも善良とは限らないし悲劇のヒロインである必要もなくはたまた赤ん坊がうまれた瞬間とも違うと思うんですが、生きてないのも同然な虚無からいきなりなじみのある場所に放り出されたときも泣くのかなみたいなのを意識して描画いただけたら。\n\nhttps://www.oceandictionary.jp/scapes1/scape_by_randam/randam7/select753.html\nhttps://share.google/SpBdr6KYpgCD3jtjI\n\nhttps://x.com/acqua_fresca/status/1977751620495544810/photo/1\n\n・像はこれらの画像を参考にしていただき、外観や装飾をうみうしモチーフ\n・生身部分は紫がかった暗い青に黒と黄のさし色に\n・可能なら胸もビール本表紙のおねえーさんくらいやや盛り気味で…\n\nラッコくんが下、女性が上部にいる俯瞰描写であれば海底の環境などはあまりこだわらなくても平気です。なんなら船は先端のほかはほぼ省いてもらってOKで。\n\nイメージ曲こちらになります。\nhttps://youtu.be/t6C4ZL6GR6Q?si=iLQ21H-tdnB9aCSi\n\nおそらくいままででいちばんややこしい依頼だと思いますが、ご検討いただけましたら幸いです。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@acqua_fresca/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 927, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c7900faf/uploads/origins/a196a459-c781-4f8d-9396-db6df7fdb654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41521490220f141d1e38c82fd2a30a9b", "srcset": "https://si.imgix.net/c7900faf/uploads/origins/a196a459-c781-4f8d-9396-db6df7fdb654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=41521490220f141d1e38c82fd2a30a9b, https://si.imgix.net/c7900faf/uploads/origins/a196a459-c781-4f8d-9396-db6df7fdb654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=45a7154f0ed20d3a9c7509b203830842 2x, https://si.imgix.net/c7900faf/uploads/origins/a196a459-c781-4f8d-9396-db6df7fdb654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=438040383bc963269522c609122e9951 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c7900faf/uploads/origins/a196a459-c781-4f8d-9396-db6df7fdb654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca6ad71750d3de57c18df3f43bfa76bd", "srcset": "https://si.imgix.net/c7900faf/uploads/origins/a196a459-c781-4f8d-9396-db6df7fdb654?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ca6ad71750d3de57c18df3f43bfa76bd, https://si.imgix.net/c7900faf/uploads/origins/a196a459-c781-4f8d-9396-db6df7fdb654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6b278e5b45e862968b072fe3422d6f04 2x, https://si.imgix.net/c7900faf/uploads/origins/a196a459-c781-4f8d-9396-db6df7fdb654?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9064dc67bcfe9ec56997585879cc5f58 3x"}, "body": "お世話になっております。今回はいつもの少女単品になりますがお願いできますでしょうか。一連のイラストに時系列があるとしていちばんはじめにあたる感じです。\n\n月と星の明かりしかない夜、金属質な冷たさを感じる林の中を歩く少女\n住んでいた村が焼かれる…まではいかずともなんらかの不幸がおきたうえ最中に親友が村の宝(仮面)を盗み出す裏切り行為を目撃、心中おだやかでない中追跡の旅にでるていで\nいつもよりやや幼く不安げな表情、左の片目わずかに涙がにじんでいても良き\n任意ですが髪の毛も一～二本にまとめたおさげ状だとうれしいです\n\nhttps://x.com/acqua_fresca/status/1906580046250135843\n\nロケーションは違いますが構図や色合いかなり良いので水垂れ～背景を林、通路を屋外の道に変換するかたちでベースにしていただくのもいいかも…。\n\n今回のイメージ曲\nhttps://youtu.be/VBsMYe5yssk?si=h3LpzuZQVqkYIM9j\n\nご検討よろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@acqua_fresca/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 927, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/caa4e969/uploads/origins/93d3f485-eb6e-4a1d-90b9-f137103a3332?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94f94212ebecf4af6d426c1918aecc20", "srcset": "https://si.imgix.net/caa4e969/uploads/origins/93d3f485-eb6e-4a1d-90b9-f137103a3332?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94f94212ebecf4af6d426c1918aecc20, https://si.imgix.net/caa4e969/uploads/origins/93d3f485-eb6e-4a1d-90b9-f137103a3332?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d435e5c0d69abd8350f5568dea35ac73 2x, https://si.imgix.net/caa4e969/uploads/origins/93d3f485-eb6e-4a1d-90b9-f137103a3332?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=24750a3a74befd3a56db9a5febbc35b3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thum