れません。\n\n\n【使用用途】\n\n･個人鑑賞/鍵垢などでのアイコン使用 ･完全個人用にグッズ等の制作/印刷（非商用利用）\n\n\n・描写してほしいキャラクター【https://drive.google.com/drive/folders/1QBCdAbITu49ePEwkToNzu4dbnfbDlffJ?usp=sharing】\n衣装など細かい部分が多いため細部簡略・アレンジOKです。\n\n・CoCシナリオ【わたしのためにおどるあなた】HO4 パ・ドゥ\n24歳の中性的な男性/美しいものが好き/墓守兼庭師。特技はフラワーアレンジメント、押し花/女装家ではなく美しい装いを好む/黒い虚ろな瞳/髪の毛先は赤のグラデーション\n仄暗い世界観で生きているキャラクターです。\n\n・細かい部分は全てお任せいたします。お好きなように描いていただければ幸いです。\n\n\n金額などに問題がありましたら再送要請をお願い致します。 どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1QBCdAbITu49ePEwkToNzu4dbnfbDlffJ?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sakanau_ouo/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3895631, "client_id": 3211553, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4bd23483/uploads/origins/fd7a6a71-611f-4d0c-995d-5d7e988ae4d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2322d03755fa4651223b100e061dbb5d", "srcset": "https://si.imgix.net/4bd23483/uploads/origins/fd7a6a71-611f-4d0c-995d-5d7e988ae4d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2322d03755fa4651223b100e061dbb5d, https://si.imgix.net/4bd23483/uploads/origins/fd7a6a71-611f-4d0c-995d-5d7e988ae4d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ced0bbd693be9bb9f1ff090f8b1b794 2x, https://si.imgix.net/4bd23483/uploads/origins/fd7a6a71-611f-4d0c-995d-5d7e988ae4d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed83310270739a10995ae832872b5b07 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4bd23483/uploads/origins/fd7a6a71-611f-4d0c-995d-5d7e988ae4d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e2497ddfadf04701c42744ebb80e81b", "srcset": "https://si.imgix.net/4bd23483/uploads/origins/fd7a6a71-611f-4d0c-995d-5d7e988ae4d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e2497ddfadf04701c42744ebb80e81b, https://si.imgix.net/4bd23483/uploads/origins/fd7a6a71-611f-4d0c-995d-5d7e988ae4d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e600227b9027271a92fcefc193044a95 2x, https://si.imgix.net/4bd23483/uploads/origins/fd7a6a71-611f-4d0c-995d-5d7e988ae4d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a8879f68ed8f9a454e1a76e2b51c94ad 3x"}, "body": "omさん、こんにちは。\n先生の絵柄がとても好きで、ぜひ私のOCの全身絵イラストを描いていただけないでしょうか。\n\n衣装や構図は全て先生にお任せします。\nもし先生のセンスで、新しい衣装をデザインしていただけると、とても嬉しいです。\n\n［キャラクター設定］\n中華街の茶餐廳でアルバイトをするJK猫です。\nhttps://drive.google.com/drive/folders/1YhZyW6ek2FhpgAO-s1H7qfEazZ8DxuYq\n\n先生がお描きになる紙絵の独特なにじみ感や色彩がとても好きです。\nつきましては、スキャンデータに加えて、もし可能でしたらこちらのツイート（https://x.com/sakanau_ouo/status/2044633136739594541?s=61）の画像1のように、\n絵を撮影されたお写真版もご一緒にいただけますと、大変嬉しいです。\n\n金額が不足する場合は再送してください。\nどうぞよろしくお願いいたします！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sakanau_ouo/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3895631, "client_id": 2988473, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b63f8bc5/uploads/origins/daabb694-7307-482e-9959-5fd139aacb7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8769755f303f4d7f7b5b745ebfe97c34", "srcset": "https://si.imgix.net/b63f8bc5/uploads/origins/daabb694-7307-482e-9959-5fd139aacb7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8769755f303f4d7f7b5b745ebfe97c34, https://si.imgix.net/b63f8bc5/uploads/origins/daabb694-7307-482e-9959-5fd139aacb7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=813003705dc50d69fd8ac9b32aaa6098 2x, https://si.imgix.net/b63f8bc5/uploads/origins/daabb694-7307-482e-9959-5fd139aacb7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=de5e2fac501107c3709414741da6ab2b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b63f8bc5/uploads/origins/daabb694-7307-482e-9959-5fd139aacb7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45bb15f2cc4039c511ace4f2ff7522c1", "srcset": "https://si.imgix.net/b63f8bc5/uploads/origins/daabb694-7307-482e-9959-5fd139aacb7c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45bb15f2cc4039c511ace4f2ff7522c1, https://si.imgix.net/b63f8bc5/uploads/origins/daabb694-7307-482e-9959-5fd139aacb7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e27a472b5cc77b9cb7095039b40cdf52 2x, https://si.imgix.net/b63f8bc5/uploads/origins/daabb694-7307-482e-9959-5fd139aacb7c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=56ca8fcffed085cd17aad5d37dde1f6f 3x"}, "body": "あなたの絵、すごく素敵ですね！ぜひ私のために何か描いてほしいです。\n\n私のキャラクターは：\n\n- 20歳\n- 黒髪で、長さはミディアムからロング\n- 身長は5フィート1インチ（154cm）\n\n少し対人恐怖症気味で、すぐに落ち込んで友達に愚痴をこぼしがちですが、知らない人と話すのは苦手です。礼儀正しく見せるために、必要のないものを店で購入してしまい、後で自分を責めてしまうようなタイプです。\n\nそれ以外は自由にお任せします。服が違っても、剣を持っていなくても構いません。\n\nhttps://drive.google.com/drive/folders/1XZnSOtbM5-30bT2TMY7v4NCvxAdV8bl6?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sakanau_ouo/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3895631, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1fff9641/uploads/origins/976fe836-c3bd-458c-b3da-a1cbaa52ef80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=455515b626d3e07e5f26e008ce148659", "srcset": "https://si.imgix.net/1fff9641/uploads/origins/976fe836-c3bd-458c-b3da-a1cbaa52ef80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&cro