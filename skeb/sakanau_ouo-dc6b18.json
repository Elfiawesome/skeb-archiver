p&crop=top&w=200&h=200&s=91cfa37ee3bb1c2d78ec1e9c96530e34, https://si.imgix.net/a1cde5d5/uploads/origins/1b6c5fd9-c884-4d24-a247-37a2aa8d893e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77b7791fcb7b362d3ef4c2b96d84312d 2x, https://si.imgix.net/a1cde5d5/uploads/origins/1b6c5fd9-c884-4d24-a247-37a2aa8d893e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=abb9bc50c5c4ebf48034738aaa67d641 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a1cde5d5/uploads/origins/1b6c5fd9-c884-4d24-a247-37a2aa8d893e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cbac65e5586e14d3b8e9d224985db07", "srcset": "https://si.imgix.net/a1cde5d5/uploads/origins/1b6c5fd9-c884-4d24-a247-37a2aa8d893e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4cbac65e5586e14d3b8e9d224985db07, https://si.imgix.net/a1cde5d5/uploads/origins/1b6c5fd9-c884-4d24-a247-37a2aa8d893e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=549cf3f51da50fe9389fec109159f40e 2x, https://si.imgix.net/a1cde5d5/uploads/origins/1b6c5fd9-c884-4d24-a247-37a2aa8d893e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5e1701949045d284bd3556b872e6f3ac 3x"}, "body": "はじめまして、先生の作品は超素晴らしいです！\n\n先生の線の表現や、細かい小物の描写、そしてキャラクター同士の絡みがとても好きです！\n\nもしよろしければ、警察署の中で少し休憩しているAとEを描いていただけないでしょうか。ロッカーや棚にもたれかかりながら、茶杯を手にお茶を飲みつつ、和やかに会話している様子を描いていただけませんか。\n\n後輩であるEは、Aが語る話にとても夢中になって聞き入っていると思います。Eはより朗らかに笑っていて、Aはより落ち着いた穏やかな雰囲気だと嬉しいです。Aは身長がやや高めですが、顔立ちは若く見えるタイプで、見た目の年齢はEとそれほど離れていないような印象です。\n\nもし可能でしたら、下記の作品のような雰囲気で描いていただけましたらとても嬉しいです！\nhttps://skeb.jp/@sakanau_ouo/works/2\n\n非常に詳細なキャラクター参考画像をご用意できず申し訳ありません。服装などのデザインにつきましては、1920年代らしい普段着風の装いでご自由にデザインしていただければ幸いです。\nまた、キャラクターの外見につきましても、先生のご解釈やお好みに合わせて多少アレンジしていただいて大丈夫です！\n\n可能であれば、別レイヤーにサインを入れたpsdファイルをご提供ください。また、先生が下書きや未使用のrkgkなどを作品に残しておいてくださると、アイデアの変遷を見ることができるのでありがたいです！\n\nご依頼をお読みいただき、ご検討くださり誠にありがとうございます！お気に召さない場合は、遠慮なく直接キャンセルしてください。\n\nhttps://drive.google.com/drive/folders/19TtD-K_r-hO7H-87_vF6RQDpAMSJkcaG?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakanau_ouo/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3895631, "client_id": 1656598, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0b673232/uploads/origins/9fe40683-b935-4b42-b183-b92acc7031ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f38adb0b07ef69c9f05fe067045449da", "srcset": "https://si.imgix.net/0b673232/uploads/origins/9fe40683-b935-4b42-b183-b92acc7031ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f38adb0b07ef69c9f05fe067045449da, https://si.imgix.net/0b673232/uploads/origins/9fe40683-b935-4b42-b183-b92acc7031ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4ee254568bff56c171924b79a6d54c8 2x, https://si.imgix.net/0b673232/uploads/origins/9fe40683-b935-4b42-b183-b92acc7031ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=52fa462c0520db9f7a4605ebaa05ea45 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0b673232/uploads/origins/9fe40683-b935-4b42-b183-b92acc7031ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ac12f46666fe072c6bd50c864823bbe", "srcset": "https://si.imgix.net/0b673232/uploads/origins/9fe40683-b935-4b42-b183-b92acc7031ba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ac12f46666fe072c6bd50c864823bbe, https://si.imgix.net/0b673232/uploads/origins/9fe40683-b935-4b42-b183-b92acc7031ba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=afb8173abe9444c3e704a262562e02a7 2x, https://