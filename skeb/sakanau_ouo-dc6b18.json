00&blur=200&s=bbc8c8a11a3152338cb4036ab56c5912, https://si.imgix.net/5cc09abb/uploads/origins/543a2f77-699c-4d28-a342-a40fb4e32b4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bb78c57cfdb5624368695d08045a621e 2x, https://si.imgix.net/5cc09abb/uploads/origins/543a2f77-699c-4d28-a342-a40fb4e32b4b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6985d5ee5956fe120086f55ac1057242 3x"}, "body": "初めまして！以前からイラストを拝見しておりまして、Skebをされていると知り衝動的にリクエストを送らせて頂きました！\n\n以下キャラクター資料になります。\nダウナーでぼんやりと大人しい子です。幸薄めな雰囲気であれば、基本的にNGはございません。\n貴方様の描かれる絵が大好きですので、思うがままに描いていただければ幸いです。\n\nリクエストするのは初めてですので、なにか至らない点がありましたら申し訳ございません。 \n\nキャラクター自身は私のOCになりますが、衣装がある版権元のデザインになりますので、\nお描き頂く際は“基本設定資料“の1番右の衣装でお願いいたします。\n（こちらは当方が施したデザインですので、版権上問題はございません）\nよろしければご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1sBSXHq-slOVPUrIP1fisqBswd9GzuBkd", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakanau_ouo/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3895631, "client_id": 2613704, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a004fb37/uploads/origins/f4d615b2-e6eb-4f36-a1e8-fbb7c1383240?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47e5fee22369e40a34ba17b28cfe2b7d", "srcset": "https://si.imgix.net/a004fb37/uploads/origins/f4d615b2-e6eb-4f36-a1e8-fbb7c1383240?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=47e5fee22369e40a34ba17b28cfe2b7d, https://si.imgix.net/a004fb37/uploads/origins/f4d615b2-e6eb-4f36-a1e8-fbb7c1383240?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=318217e674dd82915c3194bfdf025fc1 2x, https://si.imgix.net/a004fb37/uploads/origins/f4d615b2-e6eb-4f36-a1e8-fbb7c1383240?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a368345f7b8aeffaf9e45f34e56ad7d1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a004fb37/uploads/origins/f4d615b2-e6eb-4f36-a1e8-fbb7c1383240?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5ef997b528e8e95c3be8c9de719b443", "srcset": "https://si.imgix.net/a004fb37/uploads/origins/f4d615b2-e6eb-4f36-a1e8-fbb7c1383240?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a5ef997b528e8e95c3be8c9de719b443, https://si.imgix.net/a004fb37/uploads/origins/f4d615b2-e6eb-4f36-a1e8-fbb7c1383240?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=343d412ee431843eb3655172883c5f95 2x, https://si.imgix.net/a004fb37/uploads/origins/f4d615b2-e6eb-4f36-a1e8-fbb7c1383240?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e7e9455967dccac03a0621934eb7064c 3x"}, "body": "om様\n\nはじめまして、新着でイラストを拝見させていただき素敵なイラストだったのでリクエストを送らせていただきました。\nこの度は私のTRPGキャラクター（OC）を簡易ドローイングで描いていただきたいです。依頼文にネタバレは含まれません。\n\n\n【使用用途】\n\n･個人鑑賞/鍵垢などでのアイコン使用 ･完全個人用にグッズ等の制作/印刷（非商用利用）\n\n\n・描写してほしいキャラクター【https://drive.google.com/drive/folders/1QBCdAbITu49ePEwkToNzu4dbnfbDlffJ?usp=sharing】\n衣装など細かい部分が多いため細部簡略・アレンジOKです。\n\n・CoCシナリオ【わたしのためにおどるあなた】HO4 パ・ドゥ\n24歳の中性的な男性/美しいものが好き/墓守兼庭師。特技はフラワーアレンジメント、押し花/女装家ではなく美しい装いを好む/黒い虚ろな瞳/髪の毛先は赤のグラデーション\n仄暗い世界観で生きているキャラクターです。\n\n・細かい部分は全てお任せいたします。お好きなように描いていただければ幸いです。\n\n\n金額などに問題がありましたら再送要請をお願い致します。 どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1QBCdAbITu49ePEwkToNzu4dbnfbDlffJ?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakanau_ouo/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3895631, "client_id": 3211553, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4bd23483/uploads/origins/fd7a6a71-611f-4d0c-995d-5d7e988ae4d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2322d03755fa4651223b100e061dbb5d", "srcset": "https://si.imgix.net/4bd23483/uploads/origins/fd7a6a71-611f-4d0c-995d-5d7e988ae4d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2322d03755fa4651223b100e061dbb5d, https://si.imgix.net/4bd23483/uploads/origins/fd7a6a71-611f-4d0c-995d-5d7e988ae4d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9ced0bbd693be9bb9f1ff090f8b1b794 2x, https://si.imgix.net/4bd23483/uploads/origins/fd7a6a71-611f-4d0c-995d-5d7e988ae4d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ed83310270739a10995ae832872b5b07 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4bd23483/uploads/origins/fd7a6a71-611f-4d0c-995d-5d7e988ae4d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e2497ddfadf04701c42744ebb80e81b", "srcset": "https://si.imgix.net/4bd23483/uploads/origins/fd7a6a71-611f-4d0c-995d-5d7e988ae4d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e2497ddfadf04701c42744ebb80e81b, https://si.imgix.net/4bd23483/uploads/origins/fd7a6a71-611f-4d0c-995d-5d7e988ae4d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e600227b9027271a92fcefc193044a95 2x, https://si.imgix.net/4bd23483/uploads/origins/fd7a6a71-611f-4d0c-995d-5d7e988ae4d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a8879f68ed8f9a454e1a76e2b51c94ad 3x"}, "body": "omさん、こんにちは。\n先生の絵柄がとても好きで、ぜひ私のOCの全身絵イラストを描いていただけないでしょうか。\n\n衣装や構図は全て先生にお任せします。\nもし先生のセンスで、新しい衣装をデザインしていただけると、とても嬉しいです。\n\n［キャラクター設定］\n中華街の茶餐廳でアルバイトをするJK猫です。\nhttps://drive.google.com/drive/folders/1YhZyW6ek2FhpgAO-s1H7qfEazZ8DxuYq\n\n先生がお描きになる紙絵の独特なにじみ感や色彩がとても好きです。\nつきましては、スキャンデータに加えて、もし可能でしたらこちらのツイート（https://x.com/sakanau_ouo/status/2044633136739594541?s=61）の画像1のように、\n絵を撮影されたお写真版もご一緒にいただけますと