176%2FZTNgvOEs.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ea026742b0420e1b6d153189d9f0dfd", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1810849985212338176%2FZTNgvOEs.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0ea026742b0420e1b6d153189d9f0dfd, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1810849985212338176%2FZTNgvOEs.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bd5dff83a4edc27a8e0a0fcfafa318e0 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1810849985212338176%2FZTNgvOEs.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=72176720fdd2acbe3a18c68fc66afe0a 3x"}, "body": "募集されてるとのことなのでリクエストさせてください！\n\nにふさんの骨格のしっかりとした楽曲が大好きです〜〜！\n\n自分はワルツがすごく好きなのですが、\nラヴェルのラヴァルスや高雅で感傷的なワルツのような、\n少しシリアスで少し優雅な雰囲気のピアノ曲をにふさんのスタイルでお願いできたらと思います。\n\nもしくは全然別のスタイルで、\nカプースチンなどジャズスタイルを取り入れたジャンルも大好きなので、\nワルツがあまり気乗りしなかった場合はそのようなスタイルをお願いしたいです。\n\n今回採用されなかった方は別の機会でリクエストさせてもらうかもしれません。\n\n曲長やテンポ：お任せします。にふさんの得意なスタイルでおねがいします。\n楽譜や実演の考慮：ピアノ曲でお願いしたい以外は、聴くだけなので考慮しなくて構いません。\n\nよろしくお願いします！", "nc": 145, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@nixets/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": true, "creator_id": 810020, "client_id": 464447, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1810849985212338176%2FZTNgvOEs.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6da3c4d23d39a3176099884fe83640a9", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1810849985212338176%2FZTNgvOEs.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6da3c4d23d39a3176099884fe83640a9, h