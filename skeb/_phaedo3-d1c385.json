手薬指に歯形\n苦いコーヒー派。\n\n___\n\n❚その他\n関係：同居人。距離感的には恋人に近いし黒髪の人物からプロポーズじみたことは日々言われている。\n訳あって同居することになり、最近は割と双方距離感がバグっています。\n__\n\n❚使用用途\n個人鑑賞/相方への共有/個人のグッズ用等\n\n衣装は立ち絵準拠でもアレンジでもお任せいたします。\n詳細な構図やポーズは𝔧𝔬𝔱𝔞様にお任せしたいと考えております。  \n金額が不足している場合お手数ですが再送していただけますと幸いです。\nご検討の程よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/11Lrax8Y0DaeInFcUtOwIpRQ3g7GBShwd?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1137565, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "七月", "screen_name": "uuuusatama", "avatar_url": "https://pbs.twimg.com/profile_images/1750456735268298752/jzpUpkv-.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1382566100936781825/1706250438/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 1758516, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "kotono🕊12/13(日)コミティア158【か19b】", "screen_name": "kotono_n0_", "avatar_url": "https://pbs.twimg.com/profile_images/1677723384627752965/rpNzSo05.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1176929076977618944/1690287385/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 50, "skills": [{"genre": "art"}], "banned": false, "nc": 145}, {"id": 1835971, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "壺西", "screen_name": "981Id", "avatar_url": "https://pbs.twimg.com/profile_images/1996178206077136896/M-e2_GCI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1429717866354405383/1764563563/1500x500", "a