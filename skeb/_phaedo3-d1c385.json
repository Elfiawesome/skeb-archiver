親をアルキエルに殺され、一人残った弟を守らねばと生きてきたが、アルキエルがその弟に成り代わっていて絶望。\n悪魔祓いをするものの跳ね返され、逆にアルキエルの眷属の半悪魔になってしまうという散々な人生。\n早くアルキエルを殺し家族の仇討ちをしたいが、悪魔の生活のイロハが何も分からず彼の傍に居ざるを得ない。\n\n//\n服装やポーズ、シチュエーション等の指定はありません。細かな装飾なども省いても、好きにデザインしていただいても構いません！\n𝔧𝔬𝔱𝔞さんのイラストと世界観が大好きなので、どうか好きなように描いて頂けたらと思います。\n\n使用用途としては個人的な鑑賞に使用したいと考えています。\n何か失礼がありましたら申し訳ありません、もし難しいようでしたら再送して頂けると嬉しいです。\nご検討の程、何卒宜しくお願いします…！\n\nhttps://drive.google.com/drive/folders/1A23ReJtszwmrYLrkaOUnGuQFseNETH25?usp=drive_link\n\nhttps://drive.google.com/drive/folders/1A23ReJtszwmrYLrkaOUnGuQFseNETH25?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@_phaedo3/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4121331, "client_id": 3001251, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e727b5de/uploads/origins/672fa1ba-c596-4b2f-ae11-d74e733d9502?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c07517c2b45e6d5b500e3f16a5e3451", "srcset": "https://si.imgix.net/e727b5de/uploads/origins/672fa1ba-c596-4b2f-ae11-d74e733d9502?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2c07517c2b45e6d5b500e3f16a5e3451, https://si.imgix.net/e727b5de/uploads/origins/672fa1ba-c596-4b2f-ae11-d74e733d9502?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=51f3eb1add2bd97405637163d0ba3fbf 2x, https://si.imgix.net/e727b5de/uploads/origins/672fa1ba-c596-4b2f-ae11-d74e733d9502?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6208e8b20516bb1f6fa5f6e2f6500832 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e727b5de/uploads/origins/672fa1ba-c596-4b2f-ae11-d74e733d9502?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfba658901750db67e8abc2d8ec6a95d", "srcset": "https://si.imgix.net/e727b5de/uploads/origins/