com/drive/folders/1SEy3seGSqTPMKjKnOimo5BNfbIE92X9v?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nb_nb_odn/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2785874, "client_id": 2456546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5ae223df/uploads/origins/d2493eb3-e98d-40c5-9a19-fc7215d94f32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=762e5a628c3ba0d50fc4ae563b8a264f", "srcset": "https://si.imgix.net/5ae223df/uploads/origins/d2493eb3-e98d-40c5-9a19-fc7215d94f32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=762e5a628c3ba0d50fc4ae563b8a264f, https://si.imgix.net/5ae223df/uploads/origins/d2493eb3-e98d-40c5-9a19-fc7215d94f32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=813752f089821ddc15a1a4e09d475eda 2x, https://si.imgix.net/5ae223df/uploads/origins/d2493eb3-e98d-40c5-9a19-fc7215d94f32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c3f96076ef19e9f11bc777b2659c9c24 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5ae223df/uploads/origins/d2493eb3-e98d-40c5-9a19-fc7215d94f32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9141e32029e6fae6c9d3b3bb47085033", "srcset": "https://si.imgix.net/5ae223df/uploads/origins/d2493eb3-e98d-40c5-9a19-fc7215d94f32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9141e32029e6fae6c9d3b3bb47085033, https://si.imgix.net/5ae223df/uploads/origins/d2493eb3-e98d-40c5-9a19-fc7215d94f32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=659a04af85263e62de7a65570a15937b 2x, https://si.imgix.net/5ae223df/uploads/origins/d2493eb3-e98d-40c5-9a19-fc7215d94f32?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=240ff38cd9f944cefccad52293c50a1a 3x"}, "body": "ごますぎ👌様、こんにちは！\n貴方の作品がとても好きです！TRPG用の二人キャラクターのイラストを描いていただきたいと思い、依頼させていただきます。\n一人はシナリオのNPCです(シナリオ作者様には許諾済みです)。\n\n父娘の二人です。\n赤い髪：娘、158、16-20代、グラマラスな体型\n黒髪：父、175、20代（外見）、性別が判別できないほど繊細な体型\n✨ご注意ください、娘は垂れ目で、父親はつり目です。\n\n🌟キャラクターの詳細、衣装、性格、ストーリーについては以下URLの通りです。\n\n【付き合い方】 \n✨簡単に言えば：\n思春期。父への反発心と依存心がせめぎ合う。少女\n&\n娘の父への反発を完全に無視し、楽しそうに娘に近づきます(*^▽^*)。若い父\n\n✨詳細には：\n·娘はaky、表面上非常に明るいように見えるが、父親の前では運命に対する不甘な頑固な涙を流し、真実の感情を見せます。\n·一方、父は軽やかで（まるで人外のように）楽しそうな笑顔を浮かべながら、娘を愛し、二人が必然的に結びつく運命を見つめています。\n\n💕好きなように書いていただいて大丈夫です。\n\n金額が足りない場合リクエスト再送しても大丈夫。ご検討いただければ幸いです。\nよろしくお願いします！！\n\nhttps://drive.google.com/drive/folders/1ynAgqCSEnBiWGDUCYJGMOsPxIOvW_ETE", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nb_nb_odn/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2785874, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a1f161bd/uploads/origins/4e0f9050-86a9-4914-bcec-c422a9192bf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f213c964f4cd1f8ee527866c971900d", "srcset": "https://si.imgix.net/a1f161bd/uploads/origins/4e0f9050-86a9-4914-bcec-c422a9192bf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f213c964f4cd1f8ee527866c971900d, https://si.imgix.net/a1f161bd/uploads/origins/4e0f9050-86a9-4914-bcec-c422a9192bf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2edd6d2ed4789b105bb0346aa17a72f2 2x, https://si.imgix.net/a1f161bd/uploads/origins/4e0f9050-86a9-4914-bcec-c422a9192bf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=809f08d383b218bf0a3bb443e3e39133 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a1f161bd/uploads/origins/4e0f9050-86a9-4914-bcec-c422a9192bf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3b4e600903851bc03b0ea92ef9bb132", "srcset": "https://si.imgix.net/a1f161bd/uploads/origins/4e0f9050-86a9-4914-bcec-c422a9192bf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3b4e600903851bc03b0ea92ef9bb132, https://si.imgix.net/a1f161bd/uploads/origins/4e0f9050-86a9-4914-bcec-c422a9192bf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a0f45561403ce6cf517eba29ad82e493 2x, https://si.imgix.net/a1f161bd/uploads/origins/4e0f9050-86a9-4914-bcec-c422a9192bf9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a3735fa047dda9449d797c8981f00431 3x"}, "body": "はじめまして。\n検索機能にてごますぎ様の色使いや構図の素敵なイラストを拝見し、この度リクエストを送らせていただきます。\n\n\n【リクエスト内容】\n探索者3人の「死人舞踏会/雨乃こそあど様」イメージイラスト\n原曲▶︎https://youtu.be/qReK0AWtRAc?si=C4vsAs5AqjWME70f\n\n3人のキャラがそれぞれ骸骨(作画コスト的に厳しければマネキン等でも大丈夫です)とダンスをしているイラストを希望します。\n全体的に狂気的で不気味な雰囲気をイメージしています。\n\n\nキャラ①▶︎椿紅 結(つばき ゆい)\n男性/19歳/172cm\n明るく幼い印象の青年。\n華奢なヒョロガリ。真っ赤な髪と真っ黒な瞳が不気味だが、顔立ちそのものは可愛らしい方。\nダンスはエスコートされる側。相手(？)に身を委ねて楽しそうに踊っている。\n\nキャラ②▶︎矢白木 つくも(やしろぎ-)\n男性/27歳/178cm\n何考えてるか分からない男。掴みどころがなく飄々としているが、わりと脳筋。\n細身でしなやか。日本舞踊の家系。\nダンスはエスコートする側。手を取って優雅に踊っている。\n\nキャラ③▶︎緇 痲墨(くろぎぬ ますみ)\n男性/29歳/180cm\n見た目通り寡黙で感情、表情に乏しい。\nがっしりとした体格。\nダンスはエスコートする側。あまり大きな動きはせず、淡々と踊っている。\n\nキャラの衣装は資料内にある「本編」と書いてあるものか、「正装」と書いてあるものを採用してくださると嬉しいです。細かい装飾は改変、簡略化ご自由にしていただいて大丈夫です。\n\n\n人数も多く、内容も限定的なリクエストのため、何かあればお気軽に再送してください。\n何卒よろしくお願い致します。\n\nhttps://www.dropbox.com/scl/fo/046t0j676uctvvau2dx2t/AAWsA0clU5WQ96f3DaSE9Ew?rlkey=i7zx015c9lfx1xoh9ui7ysj67&st=ye25yjaf&dl=0", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nb_nb_odn/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a95f846d/uploads/origins/ed14c641-1eab-41a4-a0f3-047402404f44?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign