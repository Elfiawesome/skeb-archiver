hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8bfa2988/uploads/origins/f0e9bf41-8ebf-45f6-bea0-29094579d6b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=200f3672150d3976e603990abef1fed1", "srcset": "https://si.imgix.net/8bfa2988/uploads/origins/f0e9bf41-8ebf-45f6-bea0-29094579d6b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=200f3672150d3976e603990abef1fed1, https://si.imgix.net/8bfa2988/uploads/origins/f0e9bf41-8ebf-45f6-bea0-29094579d6b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ffd89ce9658b495370e18348e4813aeb 2x, https://si.imgix.net/8bfa2988/uploads/origins/f0e9bf41-8ebf-45f6-bea0-29094579d6b0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4d3bbb7dbf8389fa51e7f30633138087 3x"}, "body": "こんばんわ、東原さん\n前回はとってもかわいいイラストありがとうございました。\n\n今回、Vtuberの立ち絵の同絵師様（○○家といわれるやつです）の後輩、【飴色あめう】ちゃんとの２ショットイラストを描いていただきたくご依頼させていただきました。\n昔からの思い入れのある一番の推し絵師である東原絵師様の絵柄の後輩ちゃんも見てみたい！と思いまして。\n\nご多忙かとは思いますが、２ピンということもあり手間もかかるとは思いますが、もしご都合よろしければご依頼受けていただけると大変嬉しく思います。\n尚、ご本人には了承の上依頼させていただいております。\n-----以下本文-----\n\n・コンセプト\nあめうちゃんがキャスケット帽を購入、お揃いだね！と自撮りで密着して２ショット、という情景です\n自撮り棒かスマホ直接持ちかはお任せします\n\n・構図\nレイちゃんとあめうちゃんとのほっぺが触れ合うくらい密着して（not抱き合う）カメラ（スマホ）を見ています\nスマホを上方向に掲げ、写真を撮る、姿ではなく、とった写真という構図を想像しています。（俯瞰気味のアングル）\n\n・サイズ指定\n\n\n\n【レイ・キャスケット視点】\n衣装は普段のものを着用。目の星マークは今回はなし。\nスマホを持っているのはレイちゃん。\nウィンクして空いた手で顔の前にピースサイン。\nあめうちゃんとの関係性は目の中に入れても痛くないというくらいの可愛がっている後輩。\n\n参考URL：https://twitter.com/LeiCasket_VT/status/1440305088598208520\n\n【飴色あめう視点】\n☆必須事項:\n・黒のキャスケット帽子着用(デザインはキャスケット帽なら何でも可)\n・前髪の黄色と青の飾り必須着用(帽子に隠れて見えないなどはOK)\n\n☆その他\n・服装はurlを参考にしてください。分からない部分は改変可能です。\n・飴色あめうはレイ先輩の後輩で、デビュー前から親切にしていただいているので、とても信頼し、懐いています。\n\n参考url:\n\nhttps://twitter.com/ameuameiro/status/1431601099891347457?s=21", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@astl/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 7988, "client_id": 1254417, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2ce7b0cb/uploads/origins/880f98bd-0a50-49d5-8677-3fc2900b4fca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=860c68a601613e685b56f5f5202056cd", "srcset": "https://si.imgix.net/2ce7b0cb/uploads/origins/880f98bd-0a50-49d5-8677-3fc2900b4fca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=860c68a601613e685b56f5f5202056cd, https://si.imgix.net/2ce7b0cb/uploads/origins/880f98bd-0a50-49d5-8677-3fc2900b4fca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=38207bf4bf3514de3d1b45588f53e2a6 2x, https://si.imgix.net/2ce7b0cb/uploads/origins/880f98bd-0a50-49d5-8677-3fc2900b4fca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2f5e34fe15a30842a017ddc24c4009e4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2ce7b0cb/uploads/origins/880f98bd-0a50-49d5-8677-3fc2900b4fca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=357344a3c36392b3affeff3dbbf205c5", "srcset": "https://si.imgix.net/2ce7b0cb/uploads/origins/880f98bd-0a50-49d5-8677-3fc2900b4fca?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=357344a3c36392b3affeff3dbbf205c5, https://si.imgix.net/2ce7b0cb/uploads/origins/880f98bd-0a50-49d5-8677-3fc2900b4fca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=87c608c78e3bc56287ae61204a737dd5 2x, https://si.imgix.net/2ce7b0cb/uploads/origins/880f98bd-0a50-49d5-8677-3fc2900b4fca?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=819fdb08d9a9cc66a20a124147e4a83a 3x"}, "body": "初めまして、Vtuberをしていますレイ・キャスケットと申します。\nこういった者であり、\nhttps://twitter.com/LeiCasket_VT\nこういった者でもありました。\nhttp://t-walker.jp/eb/status/?chrid=c01357\nhttp://t-walker.jp/illust/product/tw_c/013/c01357_pzen_2.jpg\n\nトミーウォーカーさんの方でなかなかリクエスト受理や窓開けに遭遇することもなかったですが当時から最推し絵師様でした。\nこの名前・キャラクターにて活動するのであれば絶対東原さんのイラストを使っての活動をしたいと思いご依頼させていただきました。\n\n用途はyoutubeにてAPEXというFPSゲームの配信をする際のサムネイルとして使用の予定です。\n\n衣装は上記Twitter参照でSDにデフォルメされた全身絵\n背中に銃を背負って両手を前に出して逃げ惑う雰囲気のイラストをお願いします。\n両手を前に出して逃げ惑うような感じでお願いしたいです。\n\n背景は特になくSDキャラクターを透過pngとして使用したいと考えています。\n\nぜひこちらの依頼ご検討いただけると嬉しいです、よろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@astl/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 7988, "client_id": 146911, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a2881ef0/requests/105194_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6600afa0a064a9f176d1bb3bee87b2f1", "srcset": "https://si.imgix.net/a2881ef0/requests/105194_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6600afa0a064a9f176d1bb3bee87b2f1, https://si.imgix.net/a2881ef0/requests/105194_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b76c529026bf901b81f5e9b897d1e7c1 2x, https://si.imgix.net/a2881ef0/requests/105194_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=682d8fa9500006ee5847201d7e125d84 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a2881ef0/requests/105194_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e4a13c21ffbc5baadd9864d94286647", "srcset": "https://si.imgix.net/a2881ef0/requests/105194_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4e4a13c21ffbc5baadd9864d94286647, https://si.imgix.net/a2881ef0/requests/105194_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ed742cb24aad09d7acb15823b926be24 2x, https://si.imgix.net/a2881ef0/requests/105194_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=113f1ca3e127723be4acaa3f07e52f95 3x"}, "body": "サイキックハーツ、第六猟兵の、親子設定のうちの子のイラストをお願い致します\n世界を跨いだイラストはコミッションで頼む方が適切かと思い立ちました\n\n百合ヶ丘（街風）・リィザ\nhttp://cdn.tw4.jp/i/tw4/basic/2778/842238_d27789_bu.png\n街風・杏花\nhttps://tw6.jp/gallery/?id=16645\n\n◆時代について\n年齢としてはリィザが40代（にしては見た目は若い、フィクションによくいる「やたら若々しく強キャラ感のある親世代キャラ」くらいのイメージで）\n杏花は参照画像のイメージで中３\nくらいの時代設定の母娘でお願いします\n\n◆シチュ\n親元を離れている杏花が珍しく里帰りして、食卓に突っ伏して男の子の愚痴\nダイニングに立ったエプロン姿のリィザが、家事（皿洗いとか）をしつつ、昔の自分の恋愛を思い出して「あらあらまぁまぁ」と微笑しているところ\n\n……みたいなイメージではあるんですが、正直、仲の良さそうで幸せそうな母娘がasti絵師様の絵柄で見たい、というのが一番です\n「！？」ってなるくらい思い切り変えて頂いても結構です\n\n◆キャラ\n・リィザ\n年の割に若々しくスタイルの良い金髪美人\n体型や髪型などは学生時代とあまり変わっていない\n美術教師\n今は私服にエプロンで家事をしているところ\n\n・杏花\n胸が大きいトランジスタグラマー\n髪型はサイドテール\n服装はお任せ。参照のメイド服よりは自然な私服ぽい感じで\n羽根はどちらでも大丈夫です、髪の花は付けて下さい（カサブランカのイメージ）\n\n\n◆\n資料URLは一番大人の時のイラストを貼り付けておきました\n\nhttp://cdn.tw4.jp/i/tw4/origin/2778/851748_d27789_model_sheet_f.jpg", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 2672, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "槙千あとり", "screen_name": "makisenatori", "avatar_url": "https://pbs.twimg.com/profile_images/1791821149191774208/Nlth8A5l.jpg", "header_url": "https://pbs.twimg.com/profile_banners/77425544/1719626895/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "complete_expiration_days": 75, "skills": [{"genre": "art"}, {"genre": "video"}, {"genre": "correction"}], "banned": false, "nc": 176}, {"id": 3161, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "kit", "screen_name": "kit_create", "avatar_url": "https://pbs.twimg.com/profile_images/1850468866293702658/aLkSsN_Z.jpg", "header_url": "https://pbs.twimg.com/pr