5cc", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e32df7c7/uploads/origins/fd36e6ef-6ce9-4641-b1c8-602548d098f6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2032a00e8d232b5759b0171aae1b24f", "src_set": ""}, "body": "いつも素敵なイラストをありがとうございます。前回ティオ×ダダでリクエストさせていただいた者です。是非とも今回もリクエストさせてください。\n\n【登場キャラクター】\n・ウルトラレディ・ティオ\n・ダダ星人\n\n【シチュエーション】\n眠らされたティオはその身体を揉まれたり舐められたり、何度も犯され、ようやく目を覚ますも時すでに遅く、刻み込まれた快楽によって思うように力が出せず、抵抗できないままダダ星人に中に出された挙句敗北してしまう。\n\n【希望構図】\n・台の上に仰向けになったティオを夢中で犯すダダ星人\n・片手でティオの胸を揉みながら、ティオの柔らかい太ももにもう片方の手を添え撫でる\n(その際胸をダダ星人が舐めていたのか、唾液で濡れているようお願いします)\n・何度も犯さたせいかティオのカラータイマーは赤色の点滅を繰り返している。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sabaphase/works/44", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b14a88d0/uploads/origins/959927e4-e2c3-42f1-8b4d-3b4dbc92aafa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=08446c1d9d08166daa67a4f349c947e0", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1227256, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sabaphase/works/43", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fb08810a/uploads/origins/42dc793e-a018-4b8e-acc9-34b2881e109c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=719b4c4e25eeb9a81da5aa48e6d69c15", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1227256, "client_id": 3218478, "vtt_url": "", "thumbnail