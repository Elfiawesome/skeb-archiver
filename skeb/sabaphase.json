p=top&w=200&h=200&blur=200&s=ea87ff539a0b7213947f20e5169c0f1f", "src_set": ""}, "body": "ザラブ星人の続きで、協力者の地球人のキモオタに特殊な首輪と手錠で監禁されてバックで犯されてるイラスト\n\n挿入⇒ピストン⇒絶頂⇒時が経ち妊娠の差分などあれば嬉しいです", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sabaphase/works/33", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1227256, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/636dcd86/uploads/origins/d4fbc82c-629d-42ce-b092-b7157ea0f157?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d80605bde4574b497b03c2fffc82948", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/636dcd86/uploads/origins/d4fbc82c-629d-42ce-b092-b7157ea0f157?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57b1f85ad3753fbe8ced45658fd86756", "src_set": ""}, "body": "再開を心待ちにしておりました！\n今回も銀髪初代マンをお願いしたいです！\n相手はジェロニモン！\n今回も虚ろ目＆手書きの喘ぎをお願いしたいです。\nまた、先生のイラストは表情が素晴らしいので、どのカットも表情主体でお願いしたいです。\n\n＜大まかなイメージ＞\n①飛ぼうとした所、毒羽が胸に刺さって驚いている\n②胸を押さえながら悶え苦しんでいる\n③毒で瀕死の状態になっている所を犯される(精液まみれ)\n\nカット割りはお任せいたします！\nご検討よろしくお願いします！", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sabaphase/works/32", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a3d64919/uploads/origins/dfeb0290-2769-4488-b492-c1de07c9f511?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bb4d336d73d596bbeed60cd6a7c45b11", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1227256, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sabaphase/works/31", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1227256, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3529a030/uploads/origins/6a6c649e-bbb6-4c83-a015-6bf4669be251?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=070c56dbbeae1f42fb5d9c1bfa68d3a8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3529a030/uploads/origins/6a6c649e-bbb6-4c83-a015-6bf4669be251?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=332b12973261c24e08a0a81aa09b0340", "src_set": ""}, "body": "引き続き、銀髪初代マンをお願いしたいです。\n今回は本編では効かなかったザラブ星人の催眠が、地球人の協力で効いてしまって感度を上げられてイくのが止まらなくなっているイラストをお願いしたいです！\n今回もハイライト無しの虚ろ目ですが、色は紫でお願いします。\n\n＜大まかなイメージ＞\n【右上】\n催眠をかけられてぼうっとしてる顔のアップ\n【左上から右下にかけて】\n乱暴に犯されているが、感度を上げられているせいでイくのが止まらない、全身精液まみれな様子の全身像\n強制フェラの痕跡として顔や髪に精液が大量にかけられているが、赤く点滅しているカラータイマーはまだ綺麗、陰部には大量に中だしされている\n【左下】\nアへ顔までいかないけれどもイキ狂ってしまいそうなバストアップ\n赤く点滅しているカラータイマーや周辺も精液で汚されている\n\n可能であれば\n簡易的な手書き調の喘ぎ声や♡マークがあると嬉しいです！\n\n構図等は先生が描きやすいように全然変えて頂いて構いません。上の内容が先生にとって描きやすいようにが１番です。\n\nご検討よろしくお願いします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sabaphase/works/30", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1227256, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/45a20560/uploads/origins/b2c89299-f633-4fe9-8531-8b4e516c981d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2566c4a0a73fa6849844c396f89dd089", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/45a20560/uploads/origins/b2c89299-f633-4fe9-8531-8b4e516c981d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f8b75ca1fcd1dfe47e03445afb282ae", "src_set": ""}, "body": "先生のhttps://www.pixiv.net/artworks/111649320のジャック娘が可愛かったので、それの初代版(体のカラーは初代マン、髪の毛を下ろした感じ)の娘がハイライト無しの虚ろ目でカラータイマーが赤の状態でゼットンに犯されているイラストをお願いしたいです。\n\n＜大まかなイメージ＞\n【右側】\n首を閉められて犯されている顔のアップと中だしされている断面図\n【左側】\n光線を跳ね返されて、カラータイマーを破壊されてヒビが入って倒れている全身像\n顔や髪、特に破壊されたカラータイマーには多めに精液がかけられており、陰部からは大量の精液が逆流している\n\n可能であれば\n【下】\nゼットンに種づけプレスされている姿\nをお願いしたいです。\n\n構図等は先生が描きやすいように変えて頂いていいです。\n\nよろしくお願いします。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sabaphase/works/29", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1d94a193/uploads/origins/d09aaed0-f320-4059-8ab5-4141c02386f5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e2260b467f7c20c8b33b46f6b3213dfa", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1227256, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sabaphase/works/28", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1d3304cd/uploads/origins/2d8c8dbb-ceb7-4359-b1f5-8565fefb62af?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cf292ed313d8b637b34b3432be75c34e", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1227256, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 49, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@sabaphase/works/27", "private_thumbnail_i