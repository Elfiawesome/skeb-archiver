f&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4ee38c81a5e29e52d706417e1d11bfbe 2x, https://si.imgix.net/6119efc0/uploads/origins/25d9f3b0-6690-4e80-8ca4-c6aa8b84a0cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a587ef3b62863d8b241c50e30af31b5d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6119efc0/uploads/origins/25d9f3b0-6690-4e80-8ca4-c6aa8b84a0cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c3429b3678998b4b2a0de8bac1affc4", "srcset": "https://si.imgix.net/6119efc0/uploads/origins/25d9f3b0-6690-4e80-8ca4-c6aa8b84a0cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2c3429b3678998b4b2a0de8bac1affc4, https://si.imgix.net/6119efc0/uploads/origins/25d9f3b0-6690-4e80-8ca4-c6aa8b84a0cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3d14dc1c8a8990c5b3881a52cf0accec 2x, https://si.imgix.net/6119efc0/uploads/origins/25d9f3b0-6690-4e80-8ca4-c6aa8b84a0cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=061f588b3f3859febd8090e7ecffc63c 3x"}, "body": "はじめまして。ビートルさま。\nもし宜しければ私の愛するキャラクターを描いては頂けないでしょうか。\n今回が新規の依頼になります。\n\n依頼内容ですが\n\n【作品名及びキャラクター】\n『まいてつ』の『ハチロク』\n\n【服装】\nミストトレインガールズまいてつコラボでの衣装\n[ニシキ！？のケモ耳レイルロオド]ハチロクをベースとした\n同コラボ衣装の[ニシキをも描いていくトキメキの筆]右田日々姫の衣装のようなスカートのサイドスリットが無い版で\n\n【構図等】\n・武器の金色のハンドベル的な物を片手に持ち前述の右田日々姫のようなポーズでの全身立ち絵。\n・表情はハチロクの資料元同様に口を閉じて微笑んでいるイメージで。\n\n以上となります\nもし宜しければご検討宜しくお願い致します。\n\n以下資料\nハチロク\nhttps://misttraingirls.wikiru.jp/?%EF%BC%BB%E3%83%8B%E3%82%B7%E3%82%AD%EF%BC%81%EF%BC%9F%E3%81%AE%E3%82%B1%E3%83%A2%E8%80%B3%E3%83%AC%E3%82%A4%E3%83%AB%E3%83%AD%E3%82%AA%E3%83%89%EF%BC%BD%E3%83%8F%E3%83%81%E3%83%AD%E3%82%AF\n\n日々姫\nhttps://misttraingirls.wikiru.jp/?%EF%BC%BB%E3%83%8B%E3%82%B7%E3%82%AD%E3%82%92%E3%82%82%E6%8F%8F%E3%81%84%E3%81%A6%E3%81%84%E3%81%8F%E3%83%88%E3%82%AD%E3%83%A1%E3%82%AD%E3%81%AE%E7%AD%86%EF%BC%BD%E5%8F%B3%E7%94%B0%E6%97%A5%E3%80%85%E5%A7%AB", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BeetleGrid/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 110339, "client_id": 751755, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/98c68d98/uploads/origins/39a2a048-461d-473e-8843-e74cbd054199?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d73e0615c6c8c69ab39e7324465c8581", "srcset": "https://si.imgix.net/98c68d98/uploads/origins/39a2a048-461d-473e-8843-e74cbd054199?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d73e0615c6c8c69ab39e7324465c8581, https://si.imgix.net/98c68d98/uploads/origins/39a2a048-461d-473e-8843-e74cbd054199?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4a7ebe959ad8315b12a4d5ccf134c13 2x, https://si.imgix.net/98c68d98/uploads/origins/39a2a048-461d-473e-8843-e74cbd054199?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5a3a9d778f8b9ca207cc1052f0bd5b9d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/98c68d98/uploads/origins/39a2a048-461d-473e-8843-e74cbd054199?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b53c1d8216985c307c77a3644961006a", "srcset": "https://si.imgix.net/98c68d98/uploads/origins/39a2a048-461d-473e-8843-e74cbd054199?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b53c1d8216985c307c77a3644961006a, https://si.imgix.net/98c68d98/uploads/origins/39a2a048-461d-473e-8843-e74cbd054199?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e6090b4f927e3ac1ae73053984fd7792 2x, https://si.imgix.net/98c68d98/uploads/origins/39a2a048-461d-473e-8843-e74cbd054199?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=40c829f1cce8881eb54dab9d9f18e3c9 3x"}, "body": "ビートル先生はじめまして、牛の王子様でち＠８６ｋと申します。\n先生が描かれたハナモモちゃんのイラストを見ていつかはリクエストしたいと思っておりました。\nよろしければで結構ですので御一考いただけましたら幸いです。\n\n【作品】フラワーナイトガール\n【キャラクター】ハツユキソウ（花騎士）\n【衣装】精華の王女（進化前）\n全体：https://i.imgur.com/LI5pYfN.png\nアップ：https://i.imgur.com/x4mEfbE.png\n\n【シチュエーション】\n先生の絵柄でハツユキソウを描いてください、お願いいたします。\n団長さんとらぶらぶ冬デートをしているイメージのイラストですと嬉しいです。\n（可能でしたららぶらぶ笑顔とふふんといった感じのドヤ顔表情差分をいただけますと非常に嬉しいです）\n※団長さんの描写は不要です\n\n今回も明るく楽しく元気に、時に不幸になりつつも周囲に朗らかな笑いを振りまくほどにコケティッシュで、それでいて黙っていたら美少女な彼女を描いていただけたらと思います。\n（先生のイメージでのイラストで構いません）\n\n以上が私の要望ですが、わかりにくい点や難しい点等ございましたら先生のやりやすいようにアレンジしていただいて構いません。\nよろしくお願いいたします。\n\nhttps://xn--eckq7fg8cygsa1a1je.xn--wiki-4i9hs14f.com/index.php?%E3%83%8F%E3%83%84%E3%83%A6%E3%82%AD%E3%82%BD%E3%82%A6%28%E7%B2%BE%E8%8F%AF%E3%81%AE%E7%8E%8B%E5%A5%B3%29", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@BeetleGrid/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 110339, "client_id": 124856, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6811e761/uploads/origins/67d580f1-282d-401d-b985-f72a26f90b35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2778baa37f4427be039df4a97535b1c", "srcset": "https://si.imgix.net/6811e761/uploads/origins/67d580f1-282d-401d-b985-f72a26f90b35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c2778baa37f4427be039df4a97535b1c, https://si.imgix.net/6811e761/uploads/origins/67d580f1-282d-401d-b985-f72a26f90b35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b4bdda1986be727fb1136b2ac965f18 2x, https://si.imgix.net/6811e761/uploads/origins/67d580f1-282d-401d-b985-f72a26f90b35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3b1bf827ff9881874836df1e9cf4d54a 3x"}, "duration": null, "nsfw": false, "hardcore": f