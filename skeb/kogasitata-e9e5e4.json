たまに密かに甘やかしてしまう。アシュリーの保護者のような存在である。\n\nよろしくお願いします！\n\nhttps://drive.google.com/drive/u/0/folders/1q2-m2CkTn_8i3-mTwUoJWmswS_NemKzK", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 993483, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "木犀", "screen_name": "mokusei0516", "avatar_url": "https://pbs.twimg.com/profile_images/1717418282679242752/kNfpaaa7.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1334448316436762624/1696083071/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "video"}, {"genre": "correction"}], "nc": 48}, {"id": 1561950, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "宴", "screen_name": "34mi3", "avatar_url": "https://pbs.twimg.com/profile_images/2012387312798490624/EQpo95Bs.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1184855416854872064/1772940732/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "comic"}], "nc": 49}, {"id": 2406649, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "小盛", "screen_name": "Kmr_okb", "avatar_url": "https://pbs.twimg.com/profile_images/1582265678597599232/YtelyI0H.jpg", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "nc": 1}, {"id": 2813240, "creator": true, "nsfw_acceptable": false,