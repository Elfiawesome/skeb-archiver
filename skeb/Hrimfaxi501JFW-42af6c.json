た掛布団まで濡れているようにお願いします。 また、おねしょのシミは見切れないようにしてください。\n服装は制服で、ミニスカートがはだけてパンツが丸見えで、パンツを含め衣類がおねしょでぐっしょり濡れてしまっているようにお願いします。\n\nその他の仔細は作者様の裁量にお任せします。ご検討いただければ幸いです。\nなにとぞよろしくお願い申し上げます。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Hrimfaxi501JFW/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1046181, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5a9918c5/uploads/origins/abb8cc21-470c-41ce-9669-9822cda035c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=871776def06df3f7c5fa0b166604c42f", "srcset": "https://si.imgix.net/5a9918c5/uploads/origins/abb8cc21-470c-41ce-9669-9822cda035c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=871776def06df3f7c5fa0b166604c42f, https://si.imgix.net/5a9918c5/uploads/origins/abb8cc21-470c-41ce-9669-9822cda035c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c4d10d8ade9b080dac3bf8dd9b5d22d7 2x, https://si.imgix.net/5a9918c5/uploads/origins/abb8cc21-470c-41ce-9669-9822cda035c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9ff1f749ed95e65c38ab5074bb3a07f8 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5a9918c5/uploads/origins/abb8cc21-470c-41ce-9669-9822cda035c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8bf656b9ec9330f3e4711577d4a6883e", "srcset": "https://si.imgix.net/5a9918c5/uploads/origins/abb8cc21-470c-41ce-9669-9822cda035c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8bf656b9ec9330f3e4711577d4a6883e, https://si.imgix.net/5a9918c5/uploads/origins/abb8cc21-470c-41ce-9669-9822cda035c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2f923c52354fabdf8b8ddf2d46421f85 2x, https://si.imgix.net/5a9918c5/