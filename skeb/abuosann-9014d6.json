当にいい感じです！\n\nまた紅葉の絵をリクエストしたいです。東方Projectの犬走紅葉がパイズリをしているR18の絵です。紅葉は前の紅葉のリクエストで着ている服を着てほしいです。\n\n相手目線で描いてほしい。できれば射精バージョンもあるとありがたい！あとはお任せします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@abuosann/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 3621094, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57655a4e/uploads/origins/4ec78e09-1a87-4c7c-a5bc-575c6092b6e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7906fc635dd93669484b65e1c72856b", "srcset": "https://si.imgix.net/57655a4e/uploads/origins/4ec78e09-1a87-4c7c-a5bc-575c6092b6e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7906fc635dd93669484b65e1c72856b, https://si.imgix.net/57655a4e/uploads/origins/4ec78e09-1a87-4c7c-a5bc-575c6092b6e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=400eb1719b604de66b6de3decae6e972 2x, https://si.imgix.net/57655a4e/uploads/origins/4ec78e09-1a87-4c7c-a5bc-575c6092b6e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7f1f2565e2388e5494657cc5b0a88bfe 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57655a4e/uploads/origins/4ec78e09-1a87-4c7c-a5bc-575c6092b6e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=172a513030053a26dd63341d2f9a6ccc", "srcset": "https://si.imgix.net/57655a4e/uploads/origins/4ec78e09-1a87-4c7c-a5bc-575c6092b6e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=172a513030053a26dd63341d2f9a6ccc, https://si.imgix.net/57655a4e/uploads/origins/4ec78e09-1a87-4c7c-a5bc-575c6092b6e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8ef1387029cf7b397b4d3892a0427767 2x, https://si.imgix.net/57655a4e/uploads/origins/4ec78e09-1a87-4c7c-a5bc-575c6092b6e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b7b3d0da34d59d92a9dfdfbbf8426cb0 3x"}, "body": "こんばんはあぶおさん\n昨日のヘカ純の百合漫画がとても良かったので、20/24ページのあとの話を好きなシチュで描いてもらいたく、依頼させて頂きました！！\n\n自分は失神や気絶というシチュが好きで、\n純狐「ヘカーティア？落ちちゃったの？」\nって言いながらディルドを奥にぐりぐりして失神したヘカーティアの反応を少し楽しんだあと、資料動画の最後みたいにクリをこねこねしてる所をお願いしたいです。\n\nご検討お願いします。\n\nhttps://x.com/moonlightmask4/status/1901921530038394912?t=5O5FbIXmBLky9pfU0r_jGQ&s=19", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@abuosann/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3621094, "client_id": 1365017, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eeae08df/uploads/origins/7c00e06c-910a-46f8-a5cb-3eb9290d62e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64841757bc8337b82b2b6e68b0890125", "srcset": "https://si.imgix.net/eeae08df/uploads/origins/7c00e06c-910a-46f8-a5cb-3eb9290d62e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=64841757bc8337b82b2b6e68b0890125, https://si.imgix.net/eeae08df/uploads/origins/7c00e06c-910a-46f8-a5cb-3eb9290d62e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=791a73d21d136d6f223a469c7dcbda3d 2x, https://si.imgix.net/eeae08df/uploads/origins/7c00e06c-910a-46f8-a5cb-3eb9290d62e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c4806c06c6bd886b494eaa1fd5df104f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eeae08df/uploads/origins/7c00e06c-910a-46f8-a5cb-3eb9290d62e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5ad3c095c4793f4d1cc3d2053cd80a6", "srcset": "https://si.imgix.net/eeae08df/uploads/origins/7c00e06c-910a-46f8-a5cb-3eb9290d62e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5ad3c095c4793f4d1cc3d2053cd80a6, https://si.imgix.net/eeae08df/uploads/origins/7c00e06c-910a-46f8-a5cb-3eb9290d62e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a367e7da57e17eb239878b618b4c448b 2x, https://si.imgix.net/eeae08df/uploads/origins/7c00e06c-910a-46f8-a5cb-3eb9290d62e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=641350974bd6fde2ea0150c5bbef63d9 3x"}, "body": "こんにちは！\n\n東方Projectの絵をお願いしたいです。あなたのモコウの絵を見たのですが、とてもかっこいいと思います！\n\nあなたの最初の作品（https://skeb.jp/@abuosann/works/1）のようなスタイルで犬走紅葉の絵を描いてほしいです。紅葉は片手に車のキーを持っていて、後ろに三菱ランサーエボリューションXが乗っています。絵のどこかに「奇跡の時」という文字を入れたい。\n\nポーズに関しては、紅葉には自信に満ちた表情をしてほしいのですが、特に指示はありません。あなたが一番似合うと思うように描いてください！\n\nできれば16：9のアスペクト比で描いていただきたいです。よろしくお願いします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@abuosann/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3621094, "client_id": 2069976, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c0c80c76/uploads/origins/92eea05e-8613-4763-a51c-d692b8229656?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40cd8d2870ed5900730bf59caea859b4", "srcset": "https://si.imgix.net/c0c80c76/uploads/origins/92eea05e-8613-4763-a51c-d692b8229656?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40cd8d2870ed5900730bf59caea859b4, https://si.imgix.net/c0c80c76/uploads/origins/92eea05e-8613-4763-a51c-d692b8229656?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=42219a28cc0bcf51ffda5e097fb97c46 2x, https://si.imgix.net/c0c80c76/uploads/origins/92eea05e-8613-4763-a51c-d692b8229656?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4df79130b3dd5d4384c81fd9dd9d89aa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.i