5c91/uploads/origins/ead1f0c2-463f-4e18-89f8-578a622173c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d46778c87fb35791e40580e9a6070236 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66805c91/uploads/origins/ead1f0c2-463f-4e18-89f8-578a622173c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a913004ad0370491451689558226ff4f", "srcset": "https://si.imgix.net/66805c91/uploads/origins/ead1f0c2-463f-4e18-89f8-578a622173c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a913004ad0370491451689558226ff4f, https://si.imgix.net/66805c91/uploads/origins/ead1f0c2-463f-4e18-89f8-578a622173c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3863a6d63c8c04031cf383d96dced95b 2x, https://si.imgix.net/66805c91/uploads/origins/ead1f0c2-463f-4e18-89f8-578a622173c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d2890bec28cd090d866ec97498aa76cd 3x"}, "body": "戸渡あづま様\n\n平素よりお世話になっております。沢田汐です。\n\nこの度、戸渡あづまさんにセッションKPを務めていただいた新CoC「プルガトリウムの夜」の自陣である「もりしおの夜」が4月で卓通過1周年を迎えることとなりました。\n探索者である二人の刑事として、人間としてのお互いへのリスペクトや葛藤、様々な部分を見せていただくきっかけが多く出来たのも、そもそもプルガトリウムの夜本編がなければ見れなかったものであり、通過直後は様々な感情を抱きましたが現在ではPL･PC共にそれもひとつの思い出となっています。\n探索者たちは現在、本編での出来事は勿論、お互いのバックボーンに関することなども話し合い、お互いに人生の良きパートナー/刑事の相棒関係として相手のことを信頼し、代わりのない大切な存在として同居もしております。\n\n今回は1周年の記念としてKPを務めてくださった戸渡あづまさんにふたりのイラストをお願いしたくリクエストをお送りいたします。\n\n資料⇒  https://drive.google.com/drive/folders/1IbzmvDxgfs4bcSKLyEMDOpakwQxSbIQc?usp=drive_link\n\n構図などはお任せいたします！\n---\n・事件の調査中、長い時間を共にしたバディとしてお互いに資料を確認する真剣な姿が見れる仕事中のふたり\n・仕事とは違って絢爛で神聖なイメージのウェディング衣装に身を包んで幸せそうに微笑み合うふたり\n---\n上記2点のシチュエーションから、描きやすい方を選んでいただければと思います！\nまた、後者の場合衣装のデザインはお任せいたします。\nどちらのシチュエーションをお選びいただいても「お互いにつけているネクタイピン」が見える構図だと非常に嬉しいです！\n\nまた、制作いただいたイラストは、PLである「沢田汐」「幽枯モルグリリー」両名のXアカウントからSNSにアップしたいと考えております。\nSNSアップ用の透かし付き画像をご用意いただける場合は、そちらで投稿させていただきたいと思っております。\n\nお忙しい中とは存じますが、この機会に是非、ふたりの旅路に花を添えていただけると嬉しいです。\nどうかお身体をご自愛しお過ごしください。\n\n沢田汐\n\nhttps://drive.google.com/drive/folders/1IbzmvDxgfs4bcSKLyEMDOpakwQxSbIQc?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 14699, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "かくさとう", "screen_name": "kakusatou_3333", "avatar_url": "https://pbs.twimg.com/profile_images/2040233001037299712/JP7sASTd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1271579725/1762697001/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 145}, {"id": 2124897, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "固定", "screen_name": "sm7676_", "avatar_url": "https://www.gravatar.com/avatar/?d=identicon", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 128}, {"id": 2947464, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "じゃんご@illustrator", "screen_name": "jangogogo_8888", "avatar_url": "https://pbs.twimg.com/profile_images/1861387810315575296/p05gAylL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1661738529318379522/1710423819/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 144}, {"id": 3058374, "creator": true, "nsfw_acceptable": f