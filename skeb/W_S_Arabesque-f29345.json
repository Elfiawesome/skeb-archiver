true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@W_S_Arabesque/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3561781, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6eafe03f/uploads/origins/ef992ba2-5ea5-4d51-9ba8-8a2e0b133bbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3432f208caeb2c5dc63a8983012d4578", "srcset": "https://si.imgix.net/6eafe03f/uploads/origins/ef992ba2-5ea5-4d51-9ba8-8a2e0b133bbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3432f208caeb2c5dc63a8983012d4578, https://si.imgix.net/6eafe03f/uploads/origins/ef992ba2-5ea5-4d51-9ba8-8a2e0b133bbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99be17458f7c87dd224fb67e7aed43ad 2x, https://si.imgix.net/6eafe03f/uploads/origins/ef992ba2-5ea5-4d51-9ba8-8a2e0b133bbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=136f49783d978add8459295b9b7e0262 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6eafe03f/uploads/origins/ef992ba2-5ea5-4d51-9ba8-8a2e0b133bbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ba93338d7cfdb905b9e2f93a0367764", "srcset": "https://si.imgix.net/6eafe03f/uploads/origins/ef992ba2-5ea5-4d51-9ba8-8a2e0b133bbd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4ba93338d7cfdb905b9e2f93a0367764, https://si.imgix.net/6eafe03f/uploads/origins/ef992ba2-5ea5-4d51-9ba8-8a2e0b133bbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a4fa27aca835f5bc236ee0b5b4ea22fb 2x, https://si.imgix.net/6eafe03f/uploads/origins/ef992ba2-5ea5-4d51-9ba8-8a2e0b133bbd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9324a30de45b22d4911dd403606335b4 3x"}, "body": "初めまして。チサキ様のイラストをいつも素敵だなと見させておりました。今回skebを開かれたとことで依頼を送りさせて頂きました。1513-blasphemousのKPCの全身立ち絵を依頼したいとおもい詳細を書かせていただきます。\n探索者予定のエドワード・ノワールについて\nhttps://iachara.com/view/10002537\n\n立ち絵依頼したいKPCの詳細について\nアイリーン・ローウェン。\n女性。身長160〜180cm内が理想。33歳\nステータスは任せるのですが日本猫侍はAPPとSIZ高めだと喜びます。\n見た目の初期デザインについては画像を添付させていただきます。\n具体的な見た目について画像のイラストよりよりややタレ目、目も気持ち細め。髪の色合いにつきましてはもう少し明るめでお願いしたいです。\n服装につきましてはノースリーブでロングスカート。\n表情差分につきましては通常と怒った顔と笑顔の3つがあると嬉しいです。\n\n誕生日9/8。\n誕生花\n・ゼフィランサス\t「汚れなき愛」「便りがある」「期待」\n・ホウセンカ\t「私に触れないで」「短気」「心を開く」\n・アブチロン\t「尊敬」「良い便り」\n幼少期、社交界にて将来の約束をされた相手エドワード・ノワールを遠目に見る。親に言われた相手と少し怖かったが一目惚れになった。かっこよかった。\n恥ずかしくもいつかしっかり会って話せる時彼に似合う女性になれるよう。努力を重ねる。\n大学卒業後は公務員として働いている。\nエドワードに一方的に婚約を解消されて悲しかったがなにか意味があったのかと調べ彼が大切な友人を亡くし一人で歩き続けようとしていることを知る。\nSSS.S事件後一人で休暇していたエドワードに会いに行き一方的に婚約破棄されたこと自身の気持ちをしっかり伝えようとガチ説教をしてしまった。\n本人に想いを告げた結果照れくさそうに付き合うとこからはじめてもいいか？ときかれ思わずヘタレ！！！っと罵ってしまった。\nが彼自身が人に寄り添うのを怖がっているのも理解したので少しずつ寄り添っていきたいと思っている。\n\n普段は大人しく、淑女。相手に合わせて優しく対応する。エドワードのことはエドワード様と呼んでいる。がエドワードがアイリーンを怒らせることを言うとエドワード。と呼び捨てでガチ説教をする。\n好奇心も強くエドワードが好きなことに関心を強く持ち彼に甘々。\n彼の心の内を理解した上で彼が前を向けるよう愛と優しさで満たしていきたい。と考えている。\n一人称は私。他人称は様付け。\n\nhttps://drive.google.com/file/d/1GIE5iSx-MU86uS31jLcR5HdXsKpwnPDZ/view?usp=drivesdk", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@W_S_Arabesque/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3561781, "client_id": 2996508, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/15640ccb/uploads/origins/66bf07fb-5397-4c8d-85d6-7e631430084c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5072b3143f3091490c53257b8d24608c", "srcset": "https://si.imgix.net/15640ccb/uploads/origins/66bf07fb-5397-4c8d-85d6-7e631430084c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5072b3143f3091490c53257b8d24608c, https://si.imgix.net/15640ccb/uploads/origins/66bf07fb-5397-4c8d-85d6-7e631430084c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6752767d1a3f1bf72762bd431b77345b 2x, https://si.imgix.net/15640ccb/uploads/origins/66bf07fb-5397-4c8d-85d6-7e631430084c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c33eeeb628199b50dbe80c3443e1d8aa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/15640ccb/uploads/origins/66bf07fb-5397-4c8d-85d6-7e631430084c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bbb0a0944432dd6ca57cd99bcb5bc04", "srcset": "https://si.imgix.net/15640ccb/uploads/origins/66bf07fb-5397-4c8d-85d6-7e631430084c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6bbb0a0944432dd6ca57cd99bcb5bc04, https://si.imgix.net/15640ccb/uploads/origins/66bf07fb-5397-4c8d-85d6-7e631430084c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f8bd7813cd8b0391eb132ad81522bf7f 2x, https://si.imgix.net/15640ccb/uploads/origins/66bf07fb-5397-4c8d-85d6-7e631430084c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=23da2df4a1e792bb5a260126bd20a43e 3x"}, "body": "チサキ様\n\n快刀乱魔ではお世話になりました、ちーもです！\nチサキさんがskebを開けたと聞いて飛んできました！\nチサキさんの描かれるらんま自陣が見たくてリクエストを送らせていただきました！\n以下、依頼内容です。\n\n---------------\n\n・使用用途：自陣への共有、個人的な鑑賞、アイコンやヘッダーへの使用(チサキさんのお名前を記載して使用します)\n\n・ポーズ、構図：4人が一緒にいるところが見たいです！みんなでご飯を食べていたり、街へ出歩いたり…そういう楽しそうなシーンが見たいです！香月の顔布は取っていいです！\n\n・服装：制服でなくても構いません！！私服も好きに創造して描いてくださいませ！！\n\n---------------\n\n苦手な要素等ございましたら遠慮なくキャンセルして下さい。 \n金額や資料等不足していたり不明瞭な点がありましたら、再送申請をお願いいただければと思います。 何卒ご検討いただけますと幸いです。\n\nhttps://drive.google.com/drive/folders/1NrQOtTpqaPGti616dTS-4nXvdEcRMRTr?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 8334, "creator": true, "nsfw_acceptable": true, 