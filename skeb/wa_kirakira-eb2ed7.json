f33f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0723fbf0d96592a1b01bac7893202a8e 2x, https://si.imgix.net/131439c4/uploads/origins/8203dd6b-19f5-4605-8ee7-c82c180f33f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0c47c7af51e9488479900a611ad47eb6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/131439c4/uploads/origins/8203dd6b-19f5-4605-8ee7-c82c180f33f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e7bafba5ad61e006032be85f4864693", "srcset": "https://si.imgix.net/131439c4/uploads/origins/8203dd6b-19f5-4605-8ee7-c82c180f33f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e7bafba5ad61e006032be85f4864693, https://si.imgix.net/131439c4/uploads/origins/8203dd6b-19f5-4605-8ee7-c82c180f33f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b2826d3e86d82941f3a01d9daee02fc1 2x, https://si.imgix.net/131439c4/uploads/origins/8203dd6b-19f5-4605-8ee7-c82c180f33f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4b30c8b69136799a3bc09c6037125967 3x"}, "body": "清々しくも茶色く濁る秋の日に初めまして\nskebリクエストしようとXでたまたま拝見し、リクエストを送らせて頂きました\n\n【注意事項】\n今回、中年男性オリキャラであるエリック・カルーソなんですが、数年前にシェアワールド創作で出した都合上、\nオリキャラ自体にクリエイティブ・コモンズ3.0というライセンスが付与されています。\n主にクレジット表記(一次創作作品タイトル・原案者/作者名・元作品URL)により、\n二次創作・三次創作が可能となる一方で性質上がフリー素材に近い扱いになるため、\n本リクエストはライセンス適用の有無はそちらにお任せします。\n\n※尚、キャラデザ担当の南雲氏からは作成時からライセンス不適用の場合について事前許諾頂いております。\nライセンスの詳しい説明: http://scp-jp.wikidot.com/licensing-guide\n\n【使用用途】\nゲーム制作企画書、X(本垢)の作品紹介、アイコン、Discordサーバーで共有、\n動画投稿プラットフォームでもしかしたらサムネイルに使うこともあるかと思います。\n使用用途以外で使用する場合についてはその時はその時で\n\n【キャラクター】\nエリック・カルーソ (一人称は俺、二人称は役職呼びまたは呼び捨て)\n推定170～172cmの中年男性で元エージェント(様々なトラブルの末による左遷で)現研究員。\nJapanとEnglishの2ヶ国語話せる上に教員免許も保有している。\n性格は優しいように見えて、ストレートか変化球で嫌な部分を急所に当てることが多いが致命傷は避ける。\n(他者が精神的に疲弊した状態なら飼い生かし、明確な敵であれば鎮圧するスタンス)\n怯えない、糧に狂気、見えぬ先・・・。\n\n【リクエスト内容】\n額が倍になってるのは欲張りで2～3枚希望。\nカラーでもモノクロでもどちらでも、もし数枚描く場合は1枚だけコミック風な図のイラストができたら嬉しいです。\n雰囲気に関しては「鬱系ホラー」一択で、キョソ信さんの「戦争後遺症」に近いです。\nご検討よろしくお願いします。\n\n【その他参考資料】\nオリキャラが登場するショートアニメ\nhttps://youtu.be/2Kl2mnSIuco\n\nhttps://www.pixiv.net/artworks/95246779", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 144240, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "たば（準備中）", "screen_name": "3wa_tbt", "avatar_url": "https://pbs.twimg.com/profile_images/2055927045717417984/Eo0WIltd.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1082230098844016645/1778558183/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 1148337, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "明 星", "screen_name": "myojo_8989", "avatar_url": "https://pbs.twimg.com/profile_images/2058587008675860480/KtEfLebL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1144966544260120576/1760523049/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 3078494, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "えいとぽんど", "screen_name": "eito12", "avatar_url": "https://pbs.twimg.com/profile_images/1614566801647767555/u05aTJFe.jpg", "header_url": "https://pbs.twimg.com/profile_banners/520385145/1662003348/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": nu