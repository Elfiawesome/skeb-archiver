d06f4eb76c7ff54f0b4b, https://si.imgix.net/362a9764/uploads/origins/25a11e93-7bc6-4165-8b8d-a34c8836fc51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4a412ebad7e03932475a78184f3d16d3 2x, https://si.imgix.net/362a9764/uploads/origins/25a11e93-7bc6-4165-8b8d-a34c8836fc51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d2b5881fc5cd93a12256696e8f44f36b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/362a9764/uploads/origins/25a11e93-7bc6-4165-8b8d-a34c8836fc51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cdda0128568ebf5884f31c13bb3cf8e3", "srcset": "https://si.imgix.net/362a9764/uploads/origins/25a11e93-7bc6-4165-8b8d-a34c8836fc51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cdda0128568ebf5884f31c13bb3cf8e3, https://si.imgix.net/362a9764/uploads/origins/25a11e93-7bc6-4165-8b8d-a34c8836fc51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b519f92a7edce4a254ec2f1ddd5bcfa9 2x, https://si.imgix.net/362a9764/uploads/origins/25a11e93-7bc6-4165-8b8d-a34c8836fc51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7190c7a01414467fba62b0c1c936708c 3x"}, "body": "こなた様　初めまして\n新着欄でお見かけして\nリクエストさせていただきます！！\n\n\nリクエストはうちの子であるオリキャラの柄葉五鈴(つかは いすず)ちゃんの作品をお願いしたく\n\n構図などは全てお任せしたく\n\n格好もデフォルトでもこなた様が着せたい服装でも、オリジナルの私服でもなんでもかまいません！\n可能なら全身描写いただけると感無量です！\n\nそしてできれば五鈴ちゃんの別個体である通称『悪鈴ちゃん』というキャラもおりできれば2人作品にしていただければ最高です！\n\n\n五鈴ちゃんはとても元気で明るい子で\n悪鈴ちゃんはわかりやすくいうとツンデレに近いと思います！\n申し訳ないですが資料を見て何かインスピレーションを受けたものを描いていただくというアバウトなもので申し訳ありません。\n\nあと、ちなみにうちにはペットもいますので余裕あれば描写いただければ幸いです。\n\n注意点になりますが\n五鈴ちゃんの、肌の色は資料内に褐色ぽいのもありますが、通常の肌色でお願いします。\n悪鈴ちゃんはそのままで構いません！\n\n五鈴ちゃん資料\n\nhttps://www.dropbox.com/sh/ry67ocwtc20fgy8/AACve8MF2Y9B5RILo_RFvaeKa?dl=0\n\n悪鈴ちゃん資料\n\nhttps://www.dropbox.com/sh/4oifk7qyv2ix3cx/AADyWShtMDVeBGPqPTQ9xTsra?dl=0", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@konata_W1225/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2340888, "client_id": 1000598, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3300db8a/uploads/origins/88af0371-8352-4e4d-b806-3eb68464e468?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71cd168cdf68d30c3855f21b9173f251", "srcset": "https://si.imgix.net/3300db8a/uploads/origins/88af0371-8352-4e4d-b806-3eb68464e468?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71cd168cdf68d30c3855f21b9173f251, https://si.imgix.net/3300db8a/uploads/origins/88af0371-8352-4e4d-b806-3eb68464e468?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5a887b87780da2bbc1afcf7977cb644 2x, https://si.imgix.net/3300db8a/uploads/origins/88af0371-8352-4e4d-b806-3eb68464e468?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f1a0377c30fd42a268e265b535131b0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3300db8a/uploads/origins/88af0371-8352-4e4d-b806-3eb68464e468?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9911d70b73b387ad65c714fbe0ee5f2", "srcset": "https://si.imgix.net/3300db8a/uploads/origins/88af0371-8352-4e4d-b806-3eb68464e468?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c9911d70b73b387ad65c714fbe0ee5f2, https://si.imgix.net/3300db8a/uploads/origins/88af0371-8352-4e4d-b806-3eb68464e468?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bafe1db2d06c7eb4e07c5217e3449a1b 2x, https://si.imgix.net/3300db8a/uploads/origins/88af0371-8352-4e4d-b806-3eb68464e468?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2517f4db313ad12b0662a83f6b85c03b 3x"}, "body": "初めまして。普段描かれているジャンルとは異なってしまうのですが、絵柄にとても惹かれたのでリクエストさせていただきます。\n\n【キャラ】\nオンゲキより藍原椿ちゃんをお願いいたします。\n\n【構図】\n藍原椿ちゃんがチコリータのぬいぐるみを抱き抱えているような構図を考えております。詳しいポーズ等の指定は特にございませんので一任いたします。\n\n【衣装】\nシュータードレスでお願いいたします。手に持ってる武器は無しで大丈夫です。オンゲキの公式サイトにて衣装チェンジで確認できるのでお手数ですがそちらでお願いいたします。\n\n【その他】\nツンデレ設定のキャラなので満面の笑みよりかは少し照れてるような感じだと助かります！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@konata_W1225/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2340888, "client_id": 795457, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8cef5984/uploads/origins/f03fad5b-dda5-4559-959f-ccc5565e40cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=750f60c55b1ed1e4df8fbac6d69e4b59", "srcset": "https://si.imgix.net/8cef5984/uploads/origins/f03fad5b-dda5-4559-959f-ccc5565e40cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=750f60c55b1ed1e4df8fbac6d69e4b59, https://si.imgix.net/8cef5984/uploads/origins/f03fad5b-dda5-4559-959f-ccc5565e40cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c1047c1bc99a09502dea85c0e8135e46 2x, https://si.imgix.net/8cef5984/uploads/origins/f03fad5b-dda5-4559-959f-ccc5565e40cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=69a4991f5070dabf2d270be3df29bb51 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8cef5984/uploads/origins/f03fad5b-dda5-4559-959f-ccc5565e40cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=183c7529d40e9b302c4bb0c45ef33271", "srcset": "https://si.imgix.net/8cef5984/uploads/origins/f03fad5b-dda5-4559-959f-ccc5565e40cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=183c7529d40e9b302c4bb0c45ef33271, https://si.imgix.net/8cef5984/uploads/origins