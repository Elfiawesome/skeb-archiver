6/", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hajime_220617/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2252725, "client_id": 309904, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b76d08b3/uploads/origins/43f12149-e7ca-4981-8228-3e01f98b64cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12b99b0be88294ed77d146de77f06b33", "srcset": "https://si.imgix.net/b76d08b3/uploads/origins/43f12149-e7ca-4981-8228-3e01f98b64cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=12b99b0be88294ed77d146de77f06b33, https://si.imgix.net/b76d08b3/uploads/origins/43f12149-e7ca-4981-8228-3e01f98b64cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f13d9cb4c6b6c5befea208a982e8019c 2x, https://si.imgix.net/b76d08b3/uploads/origins/43f12149-e7ca-4981-8228-3e01f98b64cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad3167c9ffa82508f184213375b24e07 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b76d08b3/uploads/origins/43f12149-e7ca-4981-8228-3e01f98b64cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=371ea84cde824fa0b1bb622a44997066", "srcset": "https://si.imgix.net/b76d08b3/uploads/origins/43f12149-e7ca-4981-8228-3e01f98b64cf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=371ea84cde824fa0b1bb622a44997066, https://si.imgix.net/b76d08b3/uploads/origins/43f12149-e7ca-4981-8228-3e01f98b64cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b1040234fc3c51c9702bce2a5fa360b2 2x, https://si.imgix.net/b76d08b3/uploads/origins/43f12149-e7ca-4981-8228-3e01f98b64cf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7a5170a76ab98105bc354457011b1e1d 3x"}, "body": "前回はリクエストお応え頂きありがとうございました。\nまたマニアックな内容になりますが、もしよろしければお願いしたく思います。\n\n【詳細】\n・キャラクターは麦野沈利と御坂美琴。\n・それぞれ後述の参考画像の宇宙服を着用。今回はヘルメットも装着済み。\n\n・麦野さんは赤色の方の宇宙服を着用。不服そうな表情をしている。\n・御坂さんは緑色の方の宇宙服を着用。からかうような表情をしている。\n・ヘルメットは参考画像のようにそれぞれ赤色・青緑色だと嬉しいです。\n\n【参考画像】\nhttps://www.pixiv.net/artworks/97227856\nhttps://www.pixiv.net/artworks/97363285\nhttps://www.pixiv.net/artworks/97259250\nhttps://www.pixiv.net/artworks/97200546", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@hajime_220617/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2252725, "client_id": 309904, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/25af8481/uploads/origins/73561420-b16d-4af7-84fb-4f79517ecb45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a445f54f589c6ecb40aed4254bed66f0", "srcset": "https://si.imgix.net/25af8481/uploads/origins/73561420-b16d-4af7-84fb-4f79517ecb45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a445f54f589c6ecb40aed4254bed66f0, https://si.imgix.net/25af8481/uploads/origins/73561420-b16d-4af7-84fb-4f79517ecb45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76500933e8af2563311ee809ec7fb6a8 2x, https://si.imgix.net/25af8481/uploads/origins/73561420-b16d-4af7-84fb-4f79517ecb45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=82987d44c0f503f55c525c0bc3194499 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/25af8481/uploads/origins/73561420-b16d-4af7-84fb-4f79517ecb45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b1310a9fe68127a6dec351ee833435e", "srcset": "https://si.imgix.net/25af8481/uploads/origins/73561420-b16d-4af7-84fb-4f79517ecb45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3b1310a9fe68127a6dec351ee833435e, https://si.imgix.net/25af8481/uploads/origins/73561420-b16d-4af7-84fb-4f79517ecb45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3d7aae0d5d69b62863b267b47fbd3d07 2x, https://si.imgix.net/25af8481/uploads/origins/73561420-b16d-4af7-84fb-4f79517ecb45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5374424eba636ab622fff47bd7f895a6 3x"}, "body": "はじめまして。リクエスト失礼いたします。\nとても可愛らしいイラストに惹かれまして、ぜひリクエストをお願いしたく思います。\n\n人数やシチュエーションがどこまでＯＫかわからなかったので、ありのままの希望を記載いたします。もし内容が細かすぎる、作風に合わないなどありましたら申し訳ございません。\n\n【希望①】\n今回お願いしたい内容を記載いたします。\n\n・キャラクターは食蜂操祈、御坂美琴の２人。\n\n・２人ともケロンスーツという宇宙服を着た姿。ヘルメットは被らず手に持っているか、脇に抱えている。\n\n・２人で並んで立っていて、食蜂さんはノリノリな表情、御坂さんはムスッとしつつ恥ずかしがっている表情。\n\n\n【希望②】\n希望はしますが、もし厳しければ無くても良いという内容を記載いたします。\n\n・一度海に潜り地上に出てきた後の場面という設定。２人の体が水で濡れており、背景に海が広がっている。\n\n・以下のイラストのように、お互いの宇宙服にホースが繋がれている。今回の場合は食蜂さん→御坂さんの流れで空気が送られるように繋がれている。\n\nhttps://skeb.jp/@torute810/works/11\nhttps://skeb.jp/@shirofox/works/25", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 630849, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "かな", "screen_name": "maple926", "avatar_url": "https://pbs.twimg.com/profile_images/1997566308112805888/gbQySXem.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1637726965/1735637292/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 48}, {"id": 673833, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ゆりペッコ", "screen_name": "yuripekko", "avatar_url": "https://pbs.twimg.com/profile_images/1505902249243209728/zRYnPmlN.png", "header_url": "https