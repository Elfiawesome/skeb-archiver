acc75a/uploads/origins/a048680d-82c6-4a11-9577-3f6a9dcad7a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8b96cc15894ff71c19c0b88da75b1967 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/10acc75a/uploads/origins/a048680d-82c6-4a11-9577-3f6a9dcad7a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d531a11919ed900e4c421f03d5607920", "srcset": "https://si.imgix.net/10acc75a/uploads/origins/a048680d-82c6-4a11-9577-3f6a9dcad7a2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d531a11919ed900e4c421f03d5607920, https://si.imgix.net/10acc75a/uploads/origins/a048680d-82c6-4a11-9577-3f6a9dcad7a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=923b66cc682b81c476a3fa16b5886008 2x, https://si.imgix.net/10acc75a/uploads/origins/a048680d-82c6-4a11-9577-3f6a9dcad7a2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=32ac749f5401fc688c345cefa2bbcd85 3x"}, "body": "お疲れ様です。\nすき肉様に今後の動画シリーズ用サムネイルを描いて頂きたくリクエストを送信致しました。\n動画シリーズの内容としてはプレシャスボール統一でのポケモンSVでの対戦動画となります。\n\n主に普段から動画に出ている2名(以下、白衣と青服として書きます)を添えた汎用サムネイル用画像を描いて頂きたいです。\n場所はどこでも構いませんが、動画内での主役となるポケモンを配置できるような場所がどこかに生じる形での構図でお願いします。\n基本的にほぼ全てお任せしますが、何か持たせるのであれば白衣が左利き、青服が右利きとなっていますので、これらだけ気を遣って頂ければ幸いです。\n\n白衣と青服の両名がしっかりと写っていれば、詳細な構図はお任せします。\n画像サイズは横16:縦9の比率で横1280px、縦720px以上であれば詳細は不問です。\n依頼内容の性質上、動画での採用は確定しております。SNSのアイコン等で使用する場合もあります、ご了承下さい。\n基本的に動画サムネイルとして特に理由ない限り継続して使う予定なので、ある程度視認性が高く、飽きのこないデザインでお願いします。\n\n要望がかなり多くなってしまいましたが、よろしくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@skinyC9/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2028703, "client_id": 3029894, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f2a9236b/uploads/origins/31689bc5-d83e-41d2-8c7a-5eeb772a7777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b749a6a40f0e1ec522f352d7c4da4e0", "srcset": "https://si.imgix.net/f2a9236b/uploads/origins/31689bc5-d83e-41d2-8c7a-5eeb772a7777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b749a6a40f0e1ec522f352d7c4da4e0, https://si.imgix.net/f2a9236b/uploads/origins/31689bc5-d83e-41d2-8c7a-5eeb772a7777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8292e66d3ae72ee96233c6aaabbdf923 2x, https://si.imgix.net/f2a9236b/uploads/origins/31689bc5-d83e-41d2-8c7a-5eeb772a7777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5bb1085e53b722024f03322d3b9f2787 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f2a9236b/uploads/origins/31689bc5-d83e-41d2-8c7a-5eeb772a7777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9dee337fd147f49ebe723cc760e8f153", "srcset": "https://si.imgix.net/f2a9236b/uploads/origins/31689bc5-d83e-41d2-8c7a-5eeb772a7777?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9dee337fd147f49ebe723cc760e8f153, https://si.imgix.net/f2a9236b/uploads/origins/31689bc5-d83e-41d2-8c7a-5eeb772a7777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cfef18878a3e64c8dadbb4005b1cda0a 2x, https://si.imgix.net/f2a9236b/uploads/origins/31689bc5-d83e-41d2-8c7a-5eeb772a7777?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=393a702d36b0ba326aae8549bcbc8ae2 3x"}, "body": "お疲れ様です。\nこの度はエモクロアTRPGのPC「望月来架」(もちづきらいか)の全身立ち絵を描いていただく為にリクエストを送ります。TRPGやそれに関連した創作活動で使う予定です。「制服の黒いセーラー服」と「私服の白いセーラーワンピース」の2パターンをお願いしたいです。URLは参考画像に繋がっています。画像は合計3枚です。\n\n容姿の特徴\n・身長158cm、体重49kg\n・鮮やかな青色の瞳\n・ウエストの少し上くらいの長さのやや淡い金髪\n・三つ編みが後頭部にぐるっと巻いてあるハーフアップサイドテール(来架から見て右側でくくっている)\n・前髪以外の毛先は緩い縦ロール\n\n共通\n・長袖\n・ブレスレットや髪につけるヘアピンなどのアクセサリー、持ち物は無し\n・靴は瞳と同じ色の靴紐なしスニーカー。もし似合わなければ茶色のローファーにしてください。\n・両目を開けてご機嫌良く微笑んでる表情。顔全体と後頭部の三つ編みが見える構図。URLの画像の2枚目を参考にしてください。\n\n制服の黒いセーラー服差分\nURLの1枚目を参考にしてください\n・黄色いリボン結びのスカーフ\n・来架から見て左側のセーラー服の襟にアメピンを合計3本挟んでいる。上から太陽、星、月(三日月)があしらわれている。\n・スカートは膝丈\n・三分丈の白ソックス\n\n私服の白いセーラーワンピース差分\nURLの3枚目を参考にしてください\n・肩のフリルは無し\n・リボンは青1色で、柄や紋章は無し\n・ウエスト部分はベルトのみ\n・スカート丈は膝上3cm\n・黒タイツ\n\n似合わない組み合わせがある場合やデザインの簡略化、不明点などはお任せします。\nよろしくお願いします。\n\nhttps://emoklore.charasheet.jp/view/465280", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@skinyC9/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2028703, "client_id": 190546, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7c37c8f6/uploads/origins/08719069-ca0f-4224-96fc-9013ed4819dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94453c7983b7c09076d88fbe01f97d46", "srcset": "https://si.imgix.net/7c37c8f6/uploads/origins/08719069-ca0f-4224-96fc-9013ed4819dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94453c7983b7c09076d88fbe01f97d46, https://si.imgix.net/7c37c8f6/uploads/origins/08719069-ca0f-4224-96fc-9013ed4819dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=efb71e7e079b654cc79b2c2df4f5b955 2x, https://si.imgix.net/7c37c8f6/uploads/origins/08719069-ca0f-4224-96fc-9013ed4819dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb0e4c170ada44ad8a9b5dee7dc35e02 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c37c8f6/uploads/origins/08719069-ca0f-4224-96fc-9013ed4819dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5368cf6af11cfce4b2849a6577f4a47e", "srcset": "https://si.imgix.net/7c37c8f6/uploads/origins/08719069-ca0f-4224-96fc-9013ed4819dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=to