コが勃起して露出し射精している むっちり太もも\n審神者→細マッチョでシックスパック割れの腹筋\n表情：\n後藤→絶頂して、軽く雄叫びを上げるようなアヘトロ顔\n服装：\n後藤→全裸に戦闘服の上着のみ羽織り、前がはだけて胸や腹筋は丸見え 白の巻き褌着用 褌は軽くずれて、股間が丸見え\n審神者→全裸\n体位：騎乗位 審神者の身体の上で、後藤君が軽く突き上げられている感じ\n擬音・セリフ：おまかせします。無くてもOK\n\n指定が細かく申し訳ございません。ぜひよろしくお願いいたします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@OyeComoVa08/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3382369, "client_id": 82435, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc56b72e/uploads/origins/4705024d-866a-4869-a805-a0132b8ae2f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=719511f46cdb2cb17ab0c5c93b1c37c0", "srcset": "https://si.imgix.net/cc56b72e/uploads/origins/4705024d-866a-4869-a805-a0132b8ae2f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=719511f46cdb2cb17ab0c5c93b1c37c0, https://si.imgix.net/cc56b72e/uploads/origins/4705024d-866a-4869-a805-a0132b8ae2f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=23dfe5811f1085784250b5be1f1412a6 2x, https://si.imgix.net/cc56b72e/uploads/origins/4705024d-866a-4869-a805-a0132b8ae2f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2b23d9a37bed9a7e7ede2a8c131af345 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc56b72e/uploads/origins/4705024d-866a-4869-a805-a0132b8ae2f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42001192ed153a01f8a94ffbb3719ee8", "srcset": "https://si.imgix.net/cc56b72e/uploads/origins/4705024d-866a-4869-a805-a0132b8ae2f4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42001192ed153a01f8a94ffbb3719ee8, https://si.imgix.net/cc56b72e/uploads/origins/4705024d-866a-4869-a805-a0132b8ae2f4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=20