02bb30/uploads/origins/7e2e39b2-9e31-4a2b-8176-622ac19203e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e9c8459902bf8adfc29f1b4043e3f99", "srcset": "https://si.imgix.net/e302bb30/uploads/origins/7e2e39b2-9e31-4a2b-8176-622ac19203e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8e9c8459902bf8adfc29f1b4043e3f99, https://si.imgix.net/e302bb30/uploads/origins/7e2e39b2-9e31-4a2b-8176-622ac19203e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0401e66e83df7e123394cfc9614cccb4 2x, https://si.imgix.net/e302bb30/uploads/origins/7e2e39b2-9e31-4a2b-8176-622ac19203e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a3183f74771c23ee77b90aad85cc6862 3x"}, "body": "初めまして🦇\n\nアピールありがとうございました。\nうちの子をそれぞれ気に入ってくださり、嬉しいです！\n\n今回はメロの方でお願いしてもよろしいでしょうか？\nシチュエーションは、お酒🍷を飲んでふにゃふにゃに酔っている様子でお願いしたいです。\n\n表情のイメージ↓\n(⑅╸▵╺⑅)ㆀ\n\nまた、服装はデフォルト衣装orパジャマドレスor動物の着ぐるみパジャマのいずれかでお願いできればと思います。\n描きやすいと思うものでOKです🦇\nhttps://x.com/rule_rosePSO2/status/1979598137833693620\n\n何卒よろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@riki_inushima/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3760766, "client_id": 3728909, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/17845cf7/uploads/origins/bf04fa0f-41d9-4473-bc8a-2821d60278aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96ba871555fb0837f99e41482250e9df", "srcset": "https://si.imgix.net/17845cf7/uploads/origins/bf04fa0f-41d9-4473-bc8a-2821d60278aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96ba871555fb0837f99e41482250e9df, https://si.imgix.net/17845cf7/uploads/origins/bf04fa0f-41d9-4473-bc8a-2821d60278aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a508dbe25574773f107ef2e18aed9961 2x, https://si.imgix.net/17845cf7/uploads/origins/bf04fa0f-41d9-4473-bc8a-2821d60278aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=36871d79c1e8500004da835a94521227 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/17845cf7/uploads/origins/bf04fa0f-41d9-4473-bc8a-2821d60278aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98f919eb9b4afcbf8453c6140a81b272", "srcset": "https://si.imgix.net/17845cf7/uploads/origins/bf04fa0f-41d9-4473-bc8a-2821d60278aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98f919eb9b4afcbf8453c6140a81b272, https://si.imgix.net/17845cf7/uploads/origins/bf04fa0f-41d9-4473-bc8a-2821d60278aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=700111a072f5f7f89cbfaa6594aba829 2x, https://si.imgix.net/17845cf7/uploads/origins/bf04fa0f-41d9-4473-bc8a-2821d60278aa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d3ec23123057273bb8ca0a935c325be7 3x"}, "body": "リキ様アピールありがとうございます。\n描いていただきたい子が何人かいるのでリクエストを送らせていただきます。\nお気に召した子を一人描いていただければと思います。\nポーズや構図はお任せ致します。\n●名前\n番条紫悠(ばんじょうしゆう)\n●プロフィール\n気難しそうな感じの紫メッシュの男の子。\n文武両道でなんでもそつなくこなす優等生だが大分シスコンなのでみんなから残念がられている。\n●参考画像\nhttps://drive.google.com/drive/folders/1haByvKhuHoXVGfF7RKMVTLdAM5dyX2Dz\n\n●名前\n石動剣(いするぎまやか)\n●プロフィール\nまじめな雰囲気の黒髪の女の子。\n学校では生徒会長を務めており、真面目で成績優秀かつスポーツ万能なので先生からの信頼も厚い。\n問題児が多い学校に通っているので毎日忙しくしている。\n●参考画像\nhttps://drive.google.com/drive/folders/16V-IlpeCL6IfM7NEKBGmRSr2ApetKVfN", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@riki_inushima/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3760766, "client_id": 1135603, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/83c365b8/uploads/origins/fc4b355d-066a-4292-805f-02d5cbea7e59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5be6af2e28c8f8a43ea058e8a63ff8f2", "srcset": "https://si.imgix.net/83c365b8/uploads/origins/fc4b355d-066a-4292-805f-02d5cbea7e59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5be6af2e28c8f8a43ea058e8a63ff8f2, https://si.imgix.net/83c365b8/uploads/origins/fc4b355d-066a-4292-805f-02d5cbea7e59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6560820e4b9b5f5d7615c843afe15dda 2x, https://si.imgix.net/83c365b8/uploads/origins/fc4b355d-066a-4292-805f-02d5cbea7e59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=da197eff3456c30c306562887fb30f3e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/83c365b8/uploads/origins/fc4b355d-066a-4292-805f-02d5cbea7e59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f93906d1ecbfb650331518a74afa328", "srcset": "https://si.imgix.net/83c365b8/uploads/origins/fc4b355d-066a-4292-805f-02d5cbea7e59?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3f93906d1ecbfb650331518a74afa328, https://si.imgix.net/83c365b8/uploads/origins/fc4b355d-066a-4292-805f-02d5cbea7e59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=05b54bd1b2bcd7c2796092329091e84f 2x, https://si.imgix.net/83c365b8/uploads/origins/fc4b355d-066a-4292-805f-02d5cbea7e59?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9853512b380ed82d06afb242bf82c9ec 3x"}, "body": "はじめまして。天川みるくと申します。\nアピールありがとうございます！\nぜひちの子を描いていただきたく、リクエストさせていただきます。\n\nメイド服Ver.の衣装を描いていただきたいです。\n構図などはお任せいたしますが、明るく楽しい雰囲気ですとうれしいです。\n\nYoutubeのサムネイル、各種SNS、\n可能であれば、グッズ化への商用利用のご許可をお願いします。\n頭の先が見切れないよう描いていただけますとありがたいです。\n\nキャラクターイメージ\n・ふんわり、ほわほわ、赤フレーム眼鏡\n・髪は赤・瞳は緑になります。サイドの髪が長いのが特徴です。\n\nキャラのみの透過で使用できるよう、PSDのデータか、透過のPNGファイルをいただけると助かります。\nど