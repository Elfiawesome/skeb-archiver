一組であり、その片割れ。彼らの予言が政治にすら影響する世界観であることから、人々を導く役割を持つ事実上世界のトップ。豊かな長髪が特徴的。中性的な美形。本来の性格は甘えたでマイペースだが、人々の前では厳かに振る舞うよう努めている。\n\n構図等はお任せします。髪型や衣装、装飾は描きやすいよう省略、改変してください。 考え中さんの、シンプルな背景に人物や服が鮮やかに舞うような構図や色使いをされているイラストが好きなので、黒背景あるいは夜空を背景に、人物が映えるようなイラストだと嬉しいです。\nご縁があればよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1lLdLI_u8J7nUtQHl81EfyzAXmA7GEeiU", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 155577, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "冬津キイト", "screen_name": "fuyutukito", "avatar_url": "https://pbs.twimg.com/profile_images/1230171359075950593/kryC4VCJ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2419820966/1573701877/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 144}, {"id": 2671903, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "vivi", "screen_name": "islekade", "avatar_url": "https://pbs.twimg.com/profile_images/1713866424245260288/awrzFKX0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1557680852683071488/1758631079/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 2820022, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "春風桜華🌸", "screen_name": "Ouka_tea", "avatar_url": "https://pbs.twimg.com/profile_images/2113442588586123264/HnAbixSo.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1447693759534141440/1778203856/1500x500", "appeal_receivable": true, "