いです。構図やキャラクターデザインは自由にしていただいて構いません。\nマゼンタ系の色合いが好みです。服装はゴシック系の落ち着いたものが好きです。スタイルや露出は特に気にしたりする事はありません。\nエンブレムに収める為に見切れた部分は特にありませんので、自由に描いていただければと思っています。\n\nSNS系のアイコンやバナーに利用したいと思っています。\n可能であれば納品はPSDファイル、人物と背景のレイヤーを分離したものでお願いします。\n\n他の方に同様の依頼や、この依頼で制作していただいた作品を参考として、他の方にまた別の依頼をする可能性があります。この点御承諾いただけましたら、是非お願いします。\n参考に、以前同じようにエンブレムをモチーフに描いていただいたイラストをまとめています。元のエンブレムの画像もあります。\nhttps://drive.google.com/file/d/1ehhqT-duG2hxw9315erCivpvyiTm5CMu/view?usp=sharing\nhttps://drive.google.com/file/d/1dZErzTv0DKc6SPaYmZ-1rY0OclyUD9CO/view?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@monmonjaano/works/71", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3445335, "client_id": 16265, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/565608e8/uploads/origins/998b5ae1-653b-4089-a6bb-c9d4682e9cf4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=107885b2107ad1cdcdfe226a57ce4bc7", "srcset": "https://si.imgix.net/565608e8/uploads/origins/998b5ae1-653b-4089-a6bb-c9d4682e9cf4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=107885b2107ad1cdcdfe226a57ce4bc7, https://si.imgix.net/565608e8/uploads/origins/998b5ae1-653b-4089-a6bb-c9d4682e9cf4?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&s=faacf2d23793758500ebef1f92a9fc2d 2x, https://si.imgix.net/565608e8/uploads/origins/998b5ae1-653b-4089-a6bb-c9d4682e9cf4?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&s=c7309bad2f207a53afb96378a3895f93 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/565608e8/uploads/origins/998b5ae1-653b-4089-a6bb-c9d4682e9cf4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&blur=200&s=b032c170b9da3cb3174b13d45b55b816", "srcset": "https://si.imgix.net/565608e8/uploads/origins/998b5ae1-653b-4089-a6bb-c9d4682e9cf4?bg=%23fff&fm=webp&a