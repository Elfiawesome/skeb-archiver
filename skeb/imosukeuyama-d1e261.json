o=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b8111c69f0742b01a777456c05d131c 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1676255216147267584%2FDX3HPhQj.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf2edccd65bcba02d63675c3fd6c3014 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1676255216147267584%2FDX3HPhQj.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57ea1dbb9925a0e82d8f5b4fb773a913", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1676255216147267584%2FDX3HPhQj.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=57ea1dbb9925a0e82d8f5b4fb773a913, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1676255216147267584%2FDX3HPhQj.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8777f0ecae01e6ca5bfc58b517696359 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1676255216147267584%2FDX3HPhQj.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c742dbdad4566f069e49ca2baabca510 3x"}, "body": "はじめまして。ドルウェブ寝取らせものがとてもエロく、\n同じような寝取らせのリクエストですが、書いて頂ければと思い依頼させて頂きました。\nご検討頂けますと幸いです。\n\nヒロイン 結城晴(アイドルマスターシンデレラガールズ)\n竿役 おじさん(ロリコン、小太り、気弱、童貞)\nジャンル　非Pドル　寝取らせもの\n全体の雰囲気　背徳的な雰囲気\n文体の指定　セリフに♡、濁点多めで、喘ぎ声もできるだけ汚い感じだとシコれます。\n\nシチュ\n寝取られ趣味のPがU149のファンのおじさんに晴の撮影をイメージビデオと称して依頼。\n晴に頼み込んで出演してくれることに。後日おじさんからROMを貰って再生する。\n\nビデオの様子\n晴は羞恥から憎まれ口を叩きつつも撮影をしている。\n衣装はほぼ裸のマイクロビキニ。\n\n秘部の際をいやらしく触るオイルマッサージ。\n疑似フェラ、オナニーしている風に見せる様子。\n騎乗位して喘いでいるような構図の映像など、\n過激なイメージビデオになっていた。\n\n最後に特典映像が含まれていた。\n\nオイルマッサージで実際に乳首やおまんこを触られイかされてる晴。\n事務所から依頼されていたと聞いて身を委ね、愛撫される。\nイメージビデオで撮影されていた様子はエッチをしているのを上手く修正した映像だった。\n\n晴とおじさんが二人で風呂に入りつつペッティングをしている様子。\nディープキスをしつつ、互いの局部を弄りイカせあう。\n羞恥心で照れていた晴も次第に気分が高まる。\n映像に映らないけどフェラをさせて口内射精している様子。\n\n小さいおまんこに挿入する様をビデオで撮り実況する。\n映さないようにおじさんにお願いするも気持ちよさから抵抗できない晴。\n軽い身体をオナホのように扱われ何度も絶頂させられたところに中出し。\n\n部屋や屋外で1日中交尾を繰り返した映像。\n子供を産んでほしいとおじさんにせがまれ、産む宣言をする晴。\nすっかりおじさんとのエッチにハマってしまっていた。\n\n映像が終わったところでPに晴から電話がかかる。映像を見たか確認させられる。\n電話の先では、おじさんとアイドル衣装を着た晴が楽しそうにエッチしていた。\n\n\n製作上難しい箇所ございましたら、書きやすいようにアレンジ頂いて構いません。\n業の深いリクエストで恐れ入りますが何卒宜しくお願い致します。", "nc": 185, "word_count": 24224, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@imosukeuyama/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1160538, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6fd61dbe/uploads/origins/fcd59396-2098-45ac-b2e4-aa9a8f7618ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a6f17451d83959db7b07fce99694837", "srcset": "https://si.imgix.net/6fd61dbe/uploads/origins/fcd59396-2098-45ac-b2e4-aa9a8f7618ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a6f17451d83959db7b07fce99694837, https://si.imgix.net/6fd61dbe/uploads/origins/fcd59396-2098-45ac-b2e4-aa9a8f7618ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c622cd8b09ec9190d1c3eadb795a7f35 2x, https://si.imgix.net/6fd61dbe/uploads/origins/fcd59396-2098-45ac-b2e4-aa9a8f7618ab?bg=%2