ic": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@MAKIIKAUYA/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3603563, "client_id": 784488, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6de5c69f/uploads/origins/0c0bf3d8-6ff0-4013-b172-715af8b80631?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e0e3b22dde74f71aab73de749b21fbe", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6de5c69f/uploads/origins/0c0bf3d8-6ff0-4013-b172-715af8b80631?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0ba84f2e715c12dd2f55a7ed94be472", "src_set": ""}, "body": "いつもイラスト拝見しております。\n\nホロライブの、兎田ぺこらの母親(通称ぺこらママ)が寝小便を垂れているイラストをお願いしたいです。\n\nベッドで寝小便を垂れたぺこらママが、それに気付き掛布団をはだけさせ上体だけ起こして、寝小便に気づき恥ずかしがっているイラストをお願いします。 \n表情は赤面涙目で、焦っている様子。 \n服装は、特に寝間着などはでなく配信で登場している衣装。\nお尻周り、腰回り、ソックスの太腿あたりまでも寝小便でぐしょ濡れにしてください。\n 姿勢は上体を起こし、大股開きで、スカートの前がはだけて捲れ上がり寝小便でぐしょ濡れのパンツが丸見え。また、胸元がはだけておっぱいも丸出しでお願いします。\n寝小便のシミのサイズは特大サイズで、太腿裏から腰回りにかけてまでの濡らしているのがわかる大きさで布団と衣類を濡らしている。薄黄色の歪な楕円形のシミでお願いします。\nまた、彼女は寝小便の常習犯という設定で、布団には薄らと別の日の寝小便のシミが残っている、寝小便常習犯の布団という感じでお願いします。これらの寝小便のシミは見切れないようお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MAKIIKAUYA/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3603563, "client_id": 48947, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9a989870/uploads/origins/f2d6af3e-47ee-4e63-9079-3a890add45d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61fa1551fd62bfdd4068c6ef52a3fa80", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9a989870/uploads/origins/f2d6af3e-47ee-4e63-9079-3a890add45d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2f715278319dd88551491216ad407220", "src_set": ""}, "body": "いつもイラスト楽しみに拝見させていただいております。\nまきいかずや先生の描くプリキュアボテ腹シリーズが大好きで\n特に「プリキュアボテ腹シリーズその2のボテ腹なぎさ」の絵は、表情、スタイル、構図のすべてがパーフェクト！今まで見たプリキュアエロの中でもダントツで一番のエロさです！\n本当にエロい絵をありがとうございます。\n\n今回リクエストをお願いしたいのは、そのボテ腹なぎさと対になるような「ボテ腹ほのか」のイラストを描いて頂きたいです。\n\n内容としては、ボテ腹なぎさ絵と背中合わせもしくは向かい合わせになるような構図で、胸はなぎさと同様に巨乳化でお願いできますでしょうか。\n乳首の色はボテ腹なぎさよりも少し薄い程度。\n陰毛については髪の毛と同色、こちらはレイヤーを分けてON/OFF可能にして頂けるとありがたいです(ありなしどちらも好きなので)\n\nもし余裕があればですが、ピンク乳首バージョンも別レイヤーに入れていただけると嬉しいです\n\n以上、よろしくお願いします。\n\nhttps://www.pixiv.net/artworks/98237045", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 10598, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "《道糞》", "screen_name": "michi_kuso", "avatar_url": "https://pbs.twimg.com/profile_images/1206775367651868673/Fgw13oBS.png", "header_url": "https://pbs.twimg.com/profile_banners/845111990590713856/1678978146/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 176}, {"id": 39674, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "はも", "screen_name": "hamo_tosaka", "avatar_url": "https://pbs.twimg.com/profile_images/964436373712158720/xgdwh7b1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/79740978/1537513575/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 48}, {"id": 91124, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "🐯", "screen_nam