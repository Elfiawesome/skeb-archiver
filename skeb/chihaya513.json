ible": false, "total_appeals_count": 0, "received_works": [{"path": "/@chihaya513/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 63147, "client_id": 1094212, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cc973792/uploads/origins/488950bd-1101-439d-af64-13a7d836fce5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d23f820c189dee6e27389ef216f3c153", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cc973792/uploads/origins/488950bd-1101-439d-af64-13a7d836fce5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf9c0b4f615e68214da4462ac398ade4", "src_set": ""}, "body": "お久しぶりです。早速ですが絵の依頼の話をさせていただきます\n\n東方Projectの因幡てゐと封獣ぬえが扇風機の前でたくし上げて涼んでる絵をお願いしたいです\n\n設定としては幻想郷で初めて扇風機を開発した人間の元に噂を聞きつけたてゐとぬえが服をたくし上げて涼みに来た暑い真夏といった感じで\n\nてゐはだらしない表情で涼み、ぬえは恥じらいはありつつも未知の物にワクワクしてる表情で\n暑い設定なので穿いてない差分も欲しいです、可能なら色んな場所に公開してほしいです\n\n２人は大変かもしれませんがご検討宜しくお願い致しますわ", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chihaya513/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 63147, "client_id": 2128759, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/917abf3c/uploads/origins/0f07e3a0-c722-425f-a85b-5a7fde4b47e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3118eb863b906910e3f13e61f496fd35", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/917abf3c/uploads/origins/0f07e3a0-c722-425f-a85b-5a7fde4b47e8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cfd6ce0244c743d411a412ef69ab7fca", "src_set": ""}, "body": "こんにちは！\nナズーリンをオナホールとして使い続けてほしい！\n全てお任せします！\nありがとうございました！", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chihaya513/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 63147, "client_id": 2128759, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c9b4c56d/uploads/origins/792f62bf-e67b-4600-9de6-6b195c4f3c9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3a8fa5066268f3d456f358216302b34", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c9b4c56d/uploads/origins/792f62bf-e67b-4600-9de6-6b195c4f3c9e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4c3d894f298ceab5316ec414638e1a91", "src_set": ""}, "body": "こんにちは！\nナズーリンが騙されて超エロいマッサージを受けるというシチュエーションを見てみたい！\nすべてお任せします！\nありがとうございました！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chihaya513/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 63147, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8c622e48/uploads/origins/5d5adf25-fdde-4fc6-8c31-f9c38cee2040?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bd96d07de042266de1b0996f281a66f3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8c622e48/uploads/origins/5d5adf25-fdde-4fc6-8c31-f9c38cee2040?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d0743c4fd50fc5eef265342ec799c053", "src_set": ""}, "body": "こんにちは！ いつも素敵なナズーリンのイラストをありがとうございます！ 今回は、こんなテーマでお願いしたいと思います： ナズーリンのどこが一番好きですか？ ナズーリンの好きなところを強調して描いてほしいです！ 全てお任せします！ ありがとうございました！\n\nHello! Thank you very much for your always wonderful Nazrin illustrations! For my request, I would like to ask you to draw this following theme!: What part of Nazrin do you love the most? I would like to see you draw and accentuate the parts of Nazrin that you love! I'll leave everything up to you! Thank you very much!", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chihaya513/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 63147, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9176a1c1/uploads/origins/88289174-4aee-43f9-87c3-338c8b9aeaae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6625353fba6874c6c186520605f2a2d7", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9176a1c1/uploads/origins/88289174-4aee-43f9-87c3-338c8b9aeaae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bedaa5bdda9b4927f31c570c967cea6b", "src_set": ""}, "body": "嫌がるナズーリンに体格差のある種付けプレスをお願いします\n一方的に愛を語りながらレイプする感じがいいです\n\nhttps://skeb.jp/@wamotula2/works/11", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chihaya513/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 63147, "client_id": 2128759, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f7cee09/uploads/origins/f6d0f995-6798-45f2-a30c-9cfa09fabcd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ccf215f3d8368f1370b5ba2a6d31aea8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f7cee09/uploads/origins/f6d0f995-6798-45f2-a30c-9cfa09fabcd7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b7d1c11d4436b5ac364e6f91c96c5c8", "src_set": ""}, "body": "こんにちは！\n次のリクエストですが、またナズーリンを描いてください！\n壁に刺さったナズーリンが見たいですᐢᴗᐢ\n例\nhttps://skeb.jp/@dacqazzzzzzz/works/50\n全てお任せします！\nありがとうございました", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chihaya513/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 63147, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c15b5208/uploads/origins/b24c6e63-486c-4864-91d2-18a36b5dfda4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2230f28bbe6dbb3494cee3bc833c6a6a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c15b5208/uploads/origins/b24c6e63-486c-4864-91d2-18a36b5dfda4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4b744110ec970bef3721f5b03355fce0", "src_set": ""}, "body": "Hello! Thank you very much for your wonderful Nazrin illustrations! They're all super cute and amazing! For my next request, please draw Nazrin again! It's only a suggestion, but please draw Nazrin enjoying something tasty, like a set meal of yakiniku or tempura! Thank you very much!!  \n\nこんにちは！ 素晴らしいナズーリンのイラストをありがとうございました！ どれも超可愛くて素晴らしいです！ 次回のリクエストは、またナズーリンを描いてください！ あくまで提案なのですが、焼肉定食や天ぷら定食など、美味しいものを食べているナズーリンを描いてください！ ありがとうございました", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chihaya513/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 63147, "client_id": 1094212, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e87bd98a/uploads/origins/30ba6d02-1e2b-4699-80a6-9868b37e1efe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77fd2ba8dd8f70f766a73030e256ac7c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e87bd98a/uploads/origins/30ba6d02-1e2b-4699-80a6-9868b37e1efe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=63d57d24477d0f7aa0b54aa4a6454ece", "src_set": ""}, "body": "はじめまして、主にシブなどで認知しております。特殊性癖やナズ以外の依頼でもよろしいのでしょうか？可能な前提で絵の依頼の話をしていきます\n\n東方Projectの因幡てゐが膣からお年玉という玉を排出してくれるギャグエロ寄りな絵をお願いしたいです\n\n流れとしては①いいものをくれるというてゐの呼び出しに応じると足を開いて下着が見えてるてゐがいます\n②来たことを確認し下着を脱ぐ③力みだして何かを出そうとする④穴から玉が出てくる\n⑤息を切らせながら「お年玉だよ☆ことしもよろしくね」とドヤってくるてゐ…で願いします\n余裕があれば⑥イラっとしたのでお年玉を穴に押し返され淡い声で焦るてゐ\n⑦敏感になっていたので少しイクか漏らしてしまう…というおまけも\n\n難しいならば②③④⑤だけでも。可能ならば線修正を希望したいです。\nいきなり特殊な依頼とは思いますが難しければキャンセルしてくださいませ。\nよろしくお願いいたしますわ", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chihaya513/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 63147, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a2b1d9a2/uploads/origins/817ad285-73c3-4e68-80eb-6a2c74e567f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86bf37ad61be76b7ea77b48e750a78a1", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a2b1d9a2/uploads/origins/817ad285-73c3-4e68-80eb-6a2c74e567f8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=47ebd942e25690aac82522b79e9f4e86", "src_set": ""}, "body": "Hello! Please draw Nazrin wearing clothing that is really cute! I'll leave everything up to you! Thank you very much!\n\nこんにちは！ナズーリンは、本当にかわいくて、短くて、露出の多い服を着ているのを描いてください！全てお任せします！ありがとうございました！", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chihaya513/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 63147, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/32ad5a71/uploads/origins/11eafac5-32d3-4f03-917e-a2c9fdfb73ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14f447cb24c89c0712f978d6c51fbc82", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/32ad5a71/uploads/origins/11eafac5-32d3-4f03-917e-a2c9fdfb73ea?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=351e0f25db8d1abcb6dd2683f43b44f8", "src_set": ""}, "body": "Hello!\nFor my request, please draw a cute and cheerful Nazrin making a double peace sign!\nThank you very much!\n\nこんにちは！\nリクエストなんですが、ダブルピースサインをする元気でかわいいナズーリンを描いてください！\nありがとうございました！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chihaya513/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 63147, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/20183448/uploads/origins/880928ed-7ccb-442f-a405-d93dbfde3edc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8add62cd24f67734d86efefec0c22873", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/20183448/uploads/origins/880928ed-7ccb-442f-a405-d93dbfde3edc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=751f2ccc5893b1332300b954452719b8", "src_set": ""}, "body": "以前ナズーリンFFを依頼した者です。\nまたナズーリンの子宮脱を描いていただきたいのですが、今度はナズーリンの意識がある状態でゆっくりと引きずり出して頂きたいです。\n引き出し切った後は、(戻して欲しいと懇願するナズーリンをよそに)子宮口を無理矢理限界まで拡張する感じで。\n以上、よろしくお願いします。", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chihaya513/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 63147, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/924e2c64/uploads/origins/474e7e3a-1dc1-4533-a732-4349a17b656e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36caec0d232a7921e92072f352af0756", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/924e2c64/uploads/origins/474e7e3a-1dc1-4533-a732-4349a17b656e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=189b618ac0786f6ade79f4c77ef72fda", "src_set": ""}, "body": "こんにちは。\nリクエストなのですが、「シンセサイザー」をテーマにした衣装と背景でナズーリンを描いていただけませんか？\nよろしくお願いします。\nhttps://www.google.com/search?q=synthwave+aesthetic\n\nHello!\nFor my request, can you please draw Nazrin in a \"synthwave\" themed outfit and background?\nThank you!\nhttps://www.google.com/search?q=synthwave+aesthetic", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chihaya513/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 63147, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5bbd46a3/uploads/origins/6bfc8a8c-3c94-4780-b0ca-4aa0e9c68e61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d9a4ff791f17ebbfcfa62ef3cf3bfee", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5bbd46a3/uploads/origins/6bfc8a8c-3c94-4780-b0ca-4aa0e9c68e61?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f5bcd9a0fd38dcc699ea66f7d389e9dc", "src_set": ""}, "body": "Hello!\nI want to see Nazrin giving an energetic cheer!\n\nリクエストなんですが、チアリーダーのナズーリンが超元気でジャンプしている応援が見たいです", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chihaya513/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 63147, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c79400d9/uploads/origins/ca160d43-e736-4b75-a2b2-44fb039e70c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e52b0ace3f7720768f104bbf55730bb6", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c79400d9/uploads/origins/ca160d43-e736-4b75-a2b2-44fb039e70c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7da45d6c42c4070614f6d31ffc497bd1", "src_set": ""}, "body": "Hello 千葉耶-san,\nThank you for all your wonderful Nazrin illustrations and goods you've released! They're all very wonderful, and I appreciate seeing each one!\nFor my request, can you draw Nazrin in this kind of cool outfit?\nThe outfit doesn't need to match, but the overall design is nice!\n\nhttps://twitter.com/eto_sister/status/1516037660414193664\nhttps://twitter.com/mashilemo/status/1489475559717761025\n\nこんにちは、千葉耶さん。\nいつも素敵なナズリンのイラストやグッズを発売していただきありがとうございます どれもこれもとても素敵で、見ていて楽しいです\nリクエストなのですが、こんなカッコイイ服を着たナズリンを描いていただけないでしょうか？\n衣装は合わなくてもいいので、全体的なデザインは素敵です\n\nhttps://twitter.com/eto_sister/status/1516037660414193664\nhttps://twitter.com/mashilemo/status/1489475559717761025", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chihaya513/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/19e7d1a6/requests/115020_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dd122486a09a2c1ef5b510dc1cb6d57b", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 63147, "client_id": 39617, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@chihaya513/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 63147, "client_id": 147120, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3892c3f1/requests/114627_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3a34c68a58c3c0e50c68770141580d0d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3892c3f1/requests/114627_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5907c2a0c9000be728198009b65b35e5", "src_set": ""}, "body": "Skebを開始されたということで、下記の内容でリクエストをお願い致します。　\n※内容ハードのためお気に召さない場合はキャンセルして頂いてもかまいません\n\nキャラ:ナズーリン\n構図:全裸のナズーリン(ボテ腹妊娠状態)との、中出し+挿入ありのイチャラブエッチイラスト。(体位は正常位希望ですが、難しい場合は他でも構いません)\n\nその他お任せします。よろしくお願い致します。", "nc": 51, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chihaya513/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 63147, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f4a910ff/requests/114247_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d2fa15b02d1cfa901326e9f7b9833c95", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f4a910ff/requests/114247_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=24d23cad30eae889a357ac1faca409c9", "src_set": ""}, "body": "(要望が一部抜けていたため身勝手ながら再送させていただきます(余裕があれば〜以降に少し追加しています))\n以前拝見した同人サンプルの、ナズーリンがフィストファックされて子宮を引きずり出されるシーンがとても刺さりました。\nそこで似たものになりますが、以下のようにナズーリンが責められる絵を差分形式でお願いします。(責め手は一応寅丸さんを想定しています)\n\n・ナズがパンツを脱がされ、かつ脚を開かされたまま拘束されて動けない状態\n〜以下を差分形式で〜\n・ナズを愛撫し性器を濡らす/膣の前に手を構える\n・ナズの膣内に一気に手・腕を挿れる\n(・容赦なく膣内を掻き回す)\n・子宮に指を挿入する\n・子宮を掴んでゆっくりと引き抜く\n・子宮が完全に外に出る\n(・子宮を更に弄くり回す(子宮口を無理やり拡げる、奥から卵巣を…など、子宮の弄り方はお任せします))\n\n以上になります。流血は基本無しでお願いします。\n余裕があれば()内のシチュ差分や台詞・擬音、膣内子宮内の断面図など入れてもらえると助かります。(割りに合わない、シチュが合わない等感じましたらキャンセルしてもらって大丈夫です)\n要求が多く大変かと思いますが、ご一考の程、宜しくお願いします。", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@chihaya513/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 63147, "client_id": 35501, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/414c0775/requests/111680_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d05779bdfab144b4e91ba53800942b98", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/414c0775/requests/111680_2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f49c3dcf6a3bfcef4a50f60f7ad785de", "src_set": ""}, "body": "Skeb始めたみたいなので依頼させていただきます！\nキャラはナズーリンで、\n・裸\n・テープくぱぁで大きく拡げ、愛液が滴っている\n・陰核に細めのリボンを結び飾っている(所謂クリリボン、先端が少し見えるくらいのサイズで)\n・死ぬほど恥ずかしそうにしながら「女の子にここまでさせて何もしないのかい？」と挑発\n・見上げるような、飾られた性器がよく見えるような視点\nです！描いていただけると嬉しいです\n(また、余裕があれば、溢れ精液+目がハートの差分もお願いしたいです)", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 42236, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "足乃ちまど＠大九州宇佐【６】", "screen_name": "ashinochimado", "avatar_url": "https://pbs.twimg.com/profile_images/1864491114264449025/Z6LfNsZj.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3228036938/1731554718/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "skills": [{"genre": "art"}, {"genre": "voice"}, {"genre": "correction"}], "nc": 32}, {"id": 47326, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "手負い@skeb募集中", "screen_name": "TEOI2", "avatar_url": "https://pbs.twimg.com/profile_images/852949573127491584/Z8h_o_P6.jpg", "header_url": "https://pbs.twimg.com/profile_banners/12502