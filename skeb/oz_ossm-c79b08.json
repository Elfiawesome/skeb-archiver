2-4965-b945-f5b14a484e21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9846da3f71a91ed09f86a885c1e6ec5e", "srcset": "https://si.imgix.net/2acb885a/uploads/origins/bd00fa86-cb52-4965-b945-f5b14a484e21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9846da3f71a91ed09f86a885c1e6ec5e, https://si.imgix.net/2acb885a/uploads/origins/bd00fa86-cb52-4965-b945-f5b14a484e21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4d7892d761f19de69b981e2d72b59b7 2x, https://si.imgix.net/2acb885a/uploads/origins/bd00fa86-cb52-4965-b945-f5b14a484e21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7c15cdbecb3546910081a243300af1ad 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2acb885a/uploads/origins/bd00fa86-cb52-4965-b945-f5b14a484e21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35432aecec3d8350319a54c26a343049", "srcset": "https://si.imgix.net/2acb885a/uploads/origins/bd00fa86-cb52-4965-b945-f5b14a484e21?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=35432aecec3d8350319a54c26a343049, https://si.imgix.net/2acb885a/uploads/origins/bd00fa86-cb52-4965-b945-f5b14a484e21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6d06fdcdf064205abbc08364e1cc263b 2x, https://si.imgix.net/2acb885a/uploads/origins/bd00fa86-cb52-4965-b945-f5b14a484e21?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=99690fa0d68f0c483e985272a8c65dc6 3x"}, "body": "こんにちは！あなたの作品がとても好きで、オリジナルキャラクター二人のrkgk packご依頼したく、ご連絡いたしました。\nもし金額が不足しておりましたら、再送していただけますと幸いです。\n\n■キャラクター設定\n学生時代：\n明るく行動力がありながら、心臓病で体の弱い金髪の女の子 X 礼儀正しく優等生を演じている男の子。\n大人になってから：\n海外で治療を終え帰国した、情熱的な獣医の女性 X 重度のうつを抱えながらバンド活動をしているギタリストの男性。\n\n女の子は流行や新しいものが好きで、動物が大好きです。\n男の子はロックCD集めが趣味で、ギターとピアノを弾きます。\n動物塑造はゴールデンレトリバーとボーダーコリーです。\n\n■関係性\n17歳までは幼なじみとして一緒に育ちました。女の子はよく男の子を遊びに誘い、\n男の子は「面倒だな」と言いながらも、一度も断りません。\n学生時代、女の子は彼を「唯一無二の大切な親友であり家族」のように思っており、男の子も家族のように彼女を支え、守っていました。彼女に恋心を抱いていたかもしれません。\n\n17歳以降、女の子は海外治療のため突然姿を消します。\n同時期に男の子の家庭も崩壊し、彼は一人で生活するようになり、うつ病と身体症状を抱えるようになります。\n数年後、帰国した頃には、男の子はロックバンドのギタリストになっていました。\n最初は彼女を避けますが、やがて彼女を「生きる支え」のように思うようになります。女の子もまた、彼を救おうとしております。\n男の子は強い不安感を抱えており、少し重力系な一面があります。\n\n具体的な内容はご自由にご調整ください。お読みいただき、ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1kL64tQfkaKjahpLUWj7h2nxBCXBa6GuH?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@oz_ossm/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3766867, "client_id": 2771644, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a0ecd7bf/uploads/origins/d40467be-4d8f-4e13-8751-e0e2dd5fcfd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eac18ce4432099a1ec82d2f0c7626674", "srcset": "https://si.imgix.net/a0ecd7bf/uploads/origins/d40467be-4d8f-4e13-8751-e0e2dd5fcfd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eac18ce4432099a1ec82d2f0c7626674, https://si.imgix.net/a0ecd7bf/uploads/origins/d40467be-4d8f-4e13-8751-e0e2dd5fcfd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca6a0228aa08a525a15173dbd1a7430f 2x, https://si.imgix.net/a0ecd7bf/uploads/origins/d40467be-4d8f-4e13-8751-e0e2dd5fcfd6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c83d99271fefe6052c178fca0751fe6d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a0ecd7bf/uploads/origins/d40467be-4d8f-4e13-8751-e0e2dd5fcfd6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8298a095e9d78eabad0325d761ac92e9", "srcset": "https://si.imgix.net/a0ecd7bf/uploads/origins/d40467be-4d8f-4e13-8751-e0e2dd5fcfd6?bg=%23fff&auto=for