ca04f416?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=37c5b614930ad3b170860617e729a15a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/53a24b2c/uploads/origins/09bcc190-abfe-472e-8885-ee48ca04f416?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9d8e08975045a5d2b682c8c5934433e", "src_set": ""}, "body": "sooyu先生、こんにちは。\n\nアピールありがとうございました。改めて自己紹介します 。香港のVtuberユイシーショー．コイ（御使守Koi ）と申します。僕のデザインを気に入ってくださってありがとうございました。先生の絵はいい雰囲気だと思ったので、先生に依頼してみようと思います。\n\n僕は１７歳の少年、身長１７０センチ、魔導書を使っている魔法使いです。褒められることが好きです。たまに生意気な時があるか、必死に大切な物を守ります。\n※魔法を使う時、服の上に魔法の回路が現れるが、実際描くかどうか好きにしてください 。\n\nURLの中に人物の詳しい設定があります。色々服の変化もあります。オリジナル以外、他の姿になっても大丈夫です。服のパターンのPNGもありますから、もし助かったら、ご自由に使ってください。\n\n特にポーズや構図は指定しませんから、sooyu先生の感覚の通りご自由に描いてください。良ければ、背景透行になっていただけると嬉しいです。\n\nこの絵はSNS（YouTube、Twitter）や配信でのサムネイルや動画の素材などに使おうと思います。\n\nお忙しいところ恐縮ですが、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1qqu4oUrVnvKhj5b3DzkIGrDxfPx-xoOR?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sooyumochi/works/47", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2897232, "client_id": 3208405, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6fce3a36/uploads/origins/f7272e7e-ada4-4992-9d05-4ed3eb1803f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1689e03ba1d46aa231bc73254f4f208", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6fce3a36/uploads/origins/f7272e7e-ada4-4992-9d05-4ed3eb1803f0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64e25a8297cf716ad53a4e1f007731e9", "src_set": ""}, "body": "sooyu様\n\nアピールありがとうございます！\n雰囲気のある素敵なタッチで光の使い方がとても素敵だと思ったので、是非うちの子をお願いしたいです！\nよろしくお願いいたします…！\n\n●リクエスト