で、ぜひあなたの解釈も見てみたいと思います。\n\nご依頼をご検討いただき、ありがとうございます。\n敬具\nP.P.A.\n\nhttps://moselle.moe/sheep-reference-sheet.JPG", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mekeyamada/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4021326, "client_id": 3241541, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/70a6c500/uploads/origins/59620d54-559d-4de8-a187-13b89b50cb7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20e88764215c971ec935c20ca6cce1dd", "srcset": "https://si.imgix.net/70a6c500/uploads/origins/59620d54-559d-4de8-a187-13b89b50cb7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20e88764215c971ec935c20ca6cce1dd, https://si.imgix.net/70a6c500/uploads/origins/59620d54-559d-4de8-a187-13b89b50cb7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e6815b1770fcc18e4a78abe90fc2c683 2x, https://si.imgix.net/70a6c500/uploads/origins/59620d54-559d-4de8-a187-13b89b50cb7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0d0af6c14d0dc4610974a5567237d89 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/70a6c500/uploads/origins/59620d54-559d-4de8-a187-13b89b50cb7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62ca186a644a45a3807e21571915c34e", "srcset": "https://si.imgix.net/70a6c500/uploads/origins/59620d54-559d-4de8-a187-13b89b50cb7f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=62ca186a644a45a3807e21571915c34e, https://si.imgix.net/70a6c500/uploads/origins/59620d54-559d-4de8-a187-13b89b50cb7f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9e204712b3ccc9176110308d0b54c494 2x, https://si.imgix.net/70a6c500/uploads/origins/59620d54-559d-4de8-a187-13b89b5