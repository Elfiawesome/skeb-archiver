ins/795a23e0-5bc4-415a-9848-f5ca2412795e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=92e8911a9c6fa782b3d595de4e996003, https://si.imgix.net/b8d5659d/uploads/origins/795a23e0-5bc4-415a-9848-f5ca2412795e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ed38b65b3087c92765384aac923959f1 2x, https://si.imgix.net/b8d5659d/uploads/origins/795a23e0-5bc4-415a-9848-f5ca2412795e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39da2d9fda0f26ae085abe67d1d63175 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8d5659d/uploads/origins/795a23e0-5bc4-415a-9848-f5ca2412795e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=edb77739e16f824376f48d02c884235c", "srcset": "https://si.imgix.net/b8d5659d/uploads/origins/795a23e0-5bc4-415a-9848-f5ca2412795e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=edb77739e16f824376f48d02c884235c, https://si.imgix.net/b8d5659d/uploads/origins/795a23e0-5bc4-415a-9848-f5ca2412795e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3cb8ceb067f7e29b72984f20822588c9 2x, https://si.imgix.net/b8d5659d/uploads/origins/795a23e0-5bc4-415a-9848-f5ca2412795e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a7bf73bcda1f038eea482c9ab6757fcf 3x"}, "body": "こんにちは、skebがオープンして嬉しいです！あなたの毛皮の描き方がとても好きなので、ここに依頼の希望を書きます。\n私のOCが浴室か露天風呂で、何か（浴槽の縁か小さな椅子）に座って後ろを振り返り、誰かが背中を洗ってくれるのを待っているところを描いてほしい。\nユキヒョウはいつも孤独なので、誰か（たぶん親友）が一緒にお風呂に入って、突然ユキヒョウの背中を洗うのを手伝いたいと言ったとき、ヒョウはとても喜びます。\nこの絵には2つのバージョンがある、\n1、ユキヒョウの尻尾はお尻の真ん中を隠すように垂れている。彼の表情は幸せで、少し感動している。\n2、ユキヒョウの尻尾が波打ち、お尻が見えている。\n濡れた」毛皮の感触が描ければいいのですが、難しければこのアドバイスは無視してかまいません。\n最後になりましたが、最近寒いので、暖かそうな絵にしてください＞＜。\n背景はあなた次第です。\n最後までお読みいただき、ありがとうございました。\n\n参考：https://drive.google.com/drive/folders/1WsLE83CDyf_JIfaEZmlGmfkPsyxJG3v3?usp=sharing\n\nhttps: