n文章拙いところもあるかと思いますが、ニュアンスで感じて足りないところはくろろ様の自由に補って頂ければと存じます。\n\n私もYouTubeで動画投稿を始めようと思っていて、1月のイベントに参加した記録を動画として納めようと思っています。そこで胸上くらいの解説員みたいな絵をくろろ様に描いて頂ければと考えております。\n(資料ファイルに動画のイメージ載せました…伝わることを祈ります…)\n\n髪型だけ決めてる女の子で、髪色はケミカルに変わる感じで決めてません。参考画像は信号反応をモチーフにしてるのでグラデーションになってますが、一色でも大丈夫です。目は黒ですが、ハイライトが好きな色に変わるという感じです。緑というこだわりはないです。服は白衣を着ていればなんでもOKです。\n\nご検討の程よろしくお願いいたします。\n良い年末年始をお過ごし下さいませ。\n\nhttps://drive.google.com/drive/folders/1-N-Qe1cCWUgSccLNWkCGbKVtu8gehb8f", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sou_live2d/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3364283, "client_id": 3327402, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/973ed96c/uploads/origins/5ab79f71-d92d-4e88-81dc-a7b839fd9c15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97c767f3f961c8ca1e531cdc8f4ff173", "srcset": "https://si.imgix.net/973ed96c/uploads/origins/5ab79f71-d92d-4e88-81dc-a7b839fd9c15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=97c767f3f961c8ca1e531cdc8f4ff173, https://si.imgix.net/973ed96c/uploads/origins/5ab79f71-d92d-4e88-81dc-a7b839fd9c15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5becaaac83fbd42b368904e37a79259c 2x, https://si.imgix.net/973ed96c/uploads/origins/5ab79f71-d92d-4e88-81dc-a7b839fd9c15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fd8837c6c022bd1c7d11d0ea5194cce8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/973ed96c/uploads/origins/5ab79f71-d92d-4e88-81dc-a7b839fd9c15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd65e4a0b4e7a32c0e528e8d229b38ac", "srcset": "https://si.imgix.net/973ed96c/uploads/origins/5ab79f71-d92d-4e88-81dc-a7b839fd9c15?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop