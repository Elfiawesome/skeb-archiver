d9-872cf88b4aed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8f0d7f0d03a5c77cc1d0c38076361a9, https://si.imgix.net/ab5085c6/uploads/origins/548a6e3c-d7b7-415b-91d9-872cf88b4aed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6a55c584bcbe7769612675d052f0abd0 2x, https://si.imgix.net/ab5085c6/uploads/origins/548a6e3c-d7b7-415b-91d9-872cf88b4aed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e10ec26a4ded8507b5ee0fe72f51f095 3x"}, "body": "はじめまして。陰ながらですが、彦田さんの素敵なイラストや漫画をいつも拝見しております。\n数年前に彦田さんの作品を拝見して以来、アンニュイな雰囲気のイラストがドンピシャで性癖に刺さり、ずっとファンです(T＿T)\nSkeb開設を心待ちにしていたので本当に嬉しいです。ありがとうございます…！\n\n一次創作キャラクター2人のイラストをお願いしたくリクエストを送らせていただきました。\nもしご都合や内容的に難しい場合は遠慮なくキャンセルしていただけますと幸いです。その際は内容を変更して再送させていただきます。\n\n【使用目的】\nアイコン（ヘッダー）および個人用グッズへの使用\n\n【キャラクター】\n・矢橋さん\nhttps://drive.google.com/file/d/1d1tclRmo4pv0S5qjSwFWYfKYZMduvdD0/view?usp=drivesdk\nメルヘンなアイドルソングを手がける作曲家。薄幸そうな雰囲気で、百合アニメと中華料理が好きです。\n\n・西くん\nhttps://drive.google.com/file/d/1RUcvtrecqi_5iF53flvXVDD-QN58xBtT/view?usp=drivesdk\n口うるさいが面倒見のいい大学生。矢橋のことを1番理解していて、常に気にかけています。\n\n2人は幼なじみで親友、コンビのような関係です。\n\n【構図・イメージ】\nhttps://x.com/bokosaaamon/status/1882376426797875361?s=46\nこちらのようなツーショット風のイラストをお願いしたいです。\nポーズはお任せしますが、なるべく2人が近くにいる雰囲気だと嬉しいです！\n\n【衣装について】\n可能であれば、衣装は彦田さんにおまかせしたいです(T＿T)\n※矢橋は年中長袖の人物なので、長袖（またはアームカバー）で描いていただけますと助かります。\n\n【その他】\npsdファイルで背景とキャラクターを分けていただけると大変ありがたいです。\n\n不備等ございましたらお手数ですが再送お願いいたします。\nご縁がありましたら、何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1QOb3sgKz_wVKghi335gAlBwshORjsK2K", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bokosaaamon/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3638085, "client_id": 3660015, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e1638832/uploads/origins/500f4b28-6946-49af-b068-24e4450999dd?bg=%23fff&auto=format%2Ccompr