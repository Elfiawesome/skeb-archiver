a.com/games/witch100revival/sp/character/character_visco.html\nhttps://www.nisamerica.com/games/witch100revival/sp/character/character_metallica.html https://www.nisamerica.com/games/witch100revival/sp/character/character_lucchini.html", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Morotom0Shinaba/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1399343, "client_id": 1005792, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d058de8a/uploads/origins/ec507ee0-0243-40c4-86b5-f8201698876c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78d628a1f127334d88612b6d1017b491", "srcset": "https://si.imgix.net/d058de8a/uploads/origins/ec507ee0-0243-40c4-86b5-f8201698876c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78d628a1f127334d88612b6d1017b491, https://si.imgix.net/d058de8a/uploads/origins/ec507ee0-0243-40c4-86b5-f8201698876c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f827a5a9aa6ef6f2dcaf67f465413ae4 2x, https://si.imgix.net/d058de8a/uploads/origins/ec507ee0-0243-40c4-86b5-f8201698876c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a24017af8e2034def85c51f6e23f3aa 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d058de8a/uploads/origins/ec507ee0-0243-40c4-86b5-f8201698876c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3293398478969bf3a03709b756858ab", "srcset": "https://si.imgix.net/d058de8a/uploads/origins/ec507ee0-0243-40c4-86b5-f8201698876c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3293398478969bf3a03709b756858ab, https://si.imgix.net/d058de8a/uploads/origins/ec507ee0-0243-40c4-86b5-f8201698876c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&