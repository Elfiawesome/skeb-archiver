203f-4024-af1c-0d9334a99f15?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d54b2cf4306f4ad07009e15ff46a7334 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 112915, "client_id": 505646, "nc": 160}, {"path": "/@oyatu55k/works/118", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 112915, "client_id": 1088634, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/06a5a15c/uploads/origins/666dc585-874f-4eee-88df-0570b7fb62fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa050b1c7e764fd340d7a69c0ef2fe06", "srcset": "https://si.imgix.net/06a5a15c/uploads/origins/666dc585-874f-4eee-88df-0570b7fb62fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa050b1c7e764fd340d7a69c0ef2fe06, https://si.imgix.net/06a5a15c/uploads/origins/666dc585-874f-4eee-88df-0570b7fb62fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1f91315cef8c07c774d9991a51f1eb96 2x, https://si.imgix.net/06a5a15c/uploads/origins/666dc585-874f-4eee-88df-0570b7fb62fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fef48b6487388e10b072c51e6c637bd3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/06a5a15c/uploads/origins/666dc585-874f-4eee-88df-0570b7fb62fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f864380bd7059fa0d93fd844b9f09d9f", "srcset": "https://si.imgix.net/06a5a15c/uploads/origins/666dc585-874f-4eee-88df-0570b7fb62fc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f864380bd7059fa0d93fd844b9f09d9f, https://si.imgix.net/06a5a15c/uploads/origins/666dc585-874f-4eee-88df-0570b7fb62fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fe8aed9846aed161215deee33da996f1 2x, https://si.imgix.net/06a5a15c/uploads/origins/666dc585-874f-4eee-88df-0570b7fb62fc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=91d89a43823d5bec77ed248ecf6ae636 3x"}, "body": "こんにちは。三回目の依頼となります。一年一回の依頼、今年もよろしくお願いします。\n\n今回も描いて頂きたいのは[「召喚勇者とF系彼氏」の登場人物、ニーズホッグさんとバッカスです。\n描いて頂きたいシーンはF彼のラスト。ニーズホッグさんが復活するシーンです。\nバッカスはただただニーズホッグさんの名前を繰り返し抱きしめていました。\nこの場面を描いて頂きたいんです。\n\nイメージとしては「となりのトトロ」のラスト。おばあちゃんとメイちゃんのシーンです。\nおばあちゃんは駆け寄りメイちゃんを抱きしめます。\nおばあちゃんは喜びの笑顔と涙、メイちゃんは笑顔。\n丁度この場面がそのままバッカスとニーズホッグさんの場面と重なりました。\nこのイメージを二人に落とし込んでいただけると嬉しいです。\n\nバッカス\n服はダークローブorタンクトップとダークレガース。ラストの解放感からローブを脱いでもいいとも思い迷っているので、服装はおやつさんにお任せします。\n表情は笑顔で号泣。もう嬉し涙でぐちゃぐちゃにしてください。\nもう二度と離さない！といった感じでがっつり抱きしめてください。\n\nニーズホッグさん\n服はいつものローブ。\n表情はバッカスの号泣にちょっと困った顔をしつつ、やっぱり嬉しい。\n\n二人の表情がみたいので、胸から上のイラストにして頂けると嬉しいです。\nもし指が見えるならば指輪は絶対に忘れないでください。\n背景はお任せで。他細かい部分もお任せで。こうした方がいいと思えば遠慮せずに加えてください。\n過去二枚のイラストはどちらも素晴らしかったです。センスを信じます！\n\nトトロの上記のシーンと、二人のキスシーン（大好きな場面です！）を資料として添付しておきます。\n幸せいっぱいなイラストにしてください！\n宜しくお願いします。\n\nhttps://drive.google.com/drive/folders/1SsypLaYC3A7iQP2XkG4TmO9m1J0NTZvZ?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oyatu55k/works/117", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2043bc22/uploads/origins/49c3644a-3fc8-4349-935a-98b8c14e9141?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d32466018632be2d60a0b431a84c7a36", "srcset": "https://si.imgix.net/2043bc22/uploads/origins/49c3644a-3fc8-4349-935a-98b8c14e9141?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d32466018632be2d60a0b431a84c7a36, https://si.imgix.net/2043bc22/uploads/origins/49c3644a-3fc8-4349-935a-98b8c14e9141?bg=%23fff&auto=form