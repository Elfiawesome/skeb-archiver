e2e-9b20-3472ac92dcd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ba1f3868c64c59bd88c3ce3bfa1a9dfd 2x, https://si.imgix.net/96d41243/uploads/origins/6ae75817-b74d-4e2e-9b20-3472ac92dcd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=94922e7362ecfc0035c63f128612c315 3x"}, "body": "白滝沢さんとの絡みでお世話になっております。\nhttps://skeb.jp/@Srtkzwkn412/works/3\n\n本件では上記作品の7枚目を差し替え、以下から始める形でExtend版を頂きたく存じます。\n・「男の潮吹きって知ってる？」\n・「おしり弄ってる時にあの増えるヤツもう一匹挿れちゃった」\n（台詞は例示であり改変いただいて構いません。）\n\n人型モブの膨張音について、皮が張り詰めたり軋んだりする様な（本当に裂ける事は無いのですが、音だけ）痛ましい効果音で頂ければと存じます。\nそして、白滝沢さんより潮の吹き方について手解きを頂きながら、クライマックスには破裂寸前の姿にて大量の男潮を噴出すると共に、おしりからも大量の白滝を放出したいです。\n\n尚、白滝沢さんが手厚くエスコートされる背景に、あの増えるヤツを調子付いて追い注入してしまった為にマジで破裂する危機をモブから隠していた事がございますが、言及されるのが道中なのか事後なのかは構成によりお任せいたします。\n\n以上、ご検討をよろしくお願いいたします。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Srtkzwkn412/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 604663, "client_id": 339738, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8ac9543/uploads/origins/a52ed7fa-f85d-461b-a713-9bca28cef87d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=921a4e359f385092cfe2a6c46e330dd5", "srcset": "https://si.imgix.net/a8ac9543/uploads/origins/a52ed7fa-f85d-461b-a713-9bca28cef87d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=921a4e359f385092cfe2a6c46e330dd5, https://si.imgix.net/a8ac9543/uploads/origins/a52ed7fa-f85d-461b-a713-9bca28cef87d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ddd6c0dae803884a6ee4522f2a8d0a5b 2x, https://si.imgix.net/a8ac9543/uploads/origins/a52ed7fa-f85d-461b-a713-9bca28cef87d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0f2eed8291fc4c840a6ae00a94922468 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_