79/uploads/origins/924c1fb8-c159-44ae-9174-e1827b38d515?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eb340a9e090da333b042a3f990663d96, https://si.imgix.net/1f365979/uploads/origins/924c1fb8-c159-44ae-9174-e1827b38d515?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f717f255ad14d7e5d84a226f91cc45b3 2x, https://si.imgix.net/1f365979/uploads/origins/924c1fb8-c159-44ae-9174-e1827b38d515?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e7833216a121b21e15319fb170e22a25 3x"}, "body": "あすてりさんこんにちは！\nイラストを依頼したくメッセージを送らせて頂きました。\n\n今回あすてりさんにお願いしたいのは私がTRPGで使用している探索者のイラストです。\n『海雨汐 みゅら』か『八子 まほそ』のどちらかを描いて頂きたいです…！\n参考資料を添付しておきますので描きやすい方をお願い致します🙇\n\n【　https://drive.google.com/drive/folders/1N81saBj0eU2idKNrpZ5mPE5tsC66umDO?usp=sharing　】\n\n構図などは特に希望はありませんので、あすてりさんの赴くままに描いて頂ければと思います✨\nよろしくお願い致します🍀", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@znzn1027/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2738046, "client_id": 1318737, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc351d21/uploads/origins/43fe1af2-0e90-417f-b2b7-03757323c22b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db5482579af0b49de2bbba43b71d91c8", "srcset": "https://si.imgix.net/bc351d21/uploads/origins/43fe1af2-0e90-417f-b2b7-03757323c22b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=db5482579af0b49de2bbba43b71d91c8, https://si.imgix.net/bc351d21/uploads/origins/43fe1af2-0e90-417f-b2b7-03757323c22b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab61f3ce7fe305851f448fb6c40d1a4b 2x, https://si.imgix.net/bc351d21/uploads/origins/43fe1af2-0e90-417f-b2b7-03757323c22b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8979731f9e52a2bb09ac3a7a98338de7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc351d21/uploads/origins/43fe1af2-0e90-417f-b2b7-03757323c22b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3550bb9a316772303bbb7bab311c3fa5", "srcset": "https://si.imgix.net/bc351d21/uploads/origins/43fe1af2-0e90-417f-b2b7-03757323c22b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3550bb9a316772303bbb7bab311c3fa5, https://si.imgix.net/bc351d21/uploads/origins/43fe1af2-0e90-417f-b2b7-03757323c22b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fed2439b1f38c55462d2423f1e7a0cb9 2x, https://si.imgix.net/bc351d21/uploads/origins/43fe1af2-0e90-417f-b2b7-03757323c22b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d187a1bab96c919d39327112a7e953a4 3x"}, "body": "んゆさん、お世話になっております！あすてりです。\n以前はイラストを描いていただきましてありがとうございました…！今でもスマホのホーム画面に大切に飾っております。\n\n今回はデザイン込みの依頼で大変恐縮ですが、架空のオリジナルvtuber「嵐 頁（あらし よう）」及び「巻中 らくり（まきなか らくり）」のイラストを描いていただきたくご依頼をお送りいたしました。\nURLに設定を添付しておりますので、ご確認いただければ幸いです。\n\nまた、あくまでキャラデザの素案を作るような形で構いませんので、全身のデザインを詳細に！というよりはキャラのイメージ固めになるイラストにしていただければ嬉しいな～と思っております。\nイラストの構図等はおまかせいたしますので、自由に描いていただければと存じます。\n\n大変お手数をおかけいたしますが、何卒よろしくお願いいたします！引き続き応援しております。\n\nhttps://drive.google.com/drive/folders/1mJYjPiJWwkZpgtJx_d_K36ECzZarB6vZ?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unitaroukun/works/43", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2294635, "client_id": 1318737, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/76a5d51c/uploads/origins/ff8282c1-8cb3-4b49-9794-8ca07e8055f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f534671e47bba57318630ded35b5058", "srcset": "https://si.imgix.net/76a5d51c/uploads/origins/ff8282c1-8cb3-4b49-9794-8ca07e8055f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9f534671e47bba57318630ded35b5058, https://si.imgix.net/76a5d51c/uploads/origins/ff8282c1-8cb3-4b49-9794-8ca07e8055f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=430d219733122eeb92f55793435c79ba 2x, https://si.imgix.net/76a5d51c/uploads/origins/ff8282c1-8cb3-4b49-9794-8ca07e8055f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f7b5c0db6e5a932a5b1416c86ae7d17 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/76a5d51c/uploads/origins/ff8282c1-8cb3-4b49-9794-8ca07e8055f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2839cabd0d69d2c00460e091cfaea84f", "srcset": "https://si.imgix.net/76a5d51c/uploads/origins/ff8282c1-8cb3-4b49-9794-8ca07e8055f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2839cabd0d69d2c00460e091cfaea84f, https://si.imgix.net/76a5d51c/uploads/origins/ff8282c1-8cb3-4b49-9794-8ca07e8055f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=24916cc42e042876008e1df6dccd88d8 2x, https://si.imgix.net/76a5d51c/uploads/origins/ff8282c1-8cb3-4b49-9794-8ca07e8055f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=656dfee375a46e8c9eac685d3b5c5ec2 3x"}, "body": "うに太郎くんさん、いつもお世話になっております！あすてりです。\n毎年干し芋からお祝いしてくださって本当にありがとうございます…近いうちにskebを送るといいつつ半年経っておりまして恐縮です ﾃﾍ…\n\nさて、今回私のオリジナルキャラクターである架空のVtuber「最果 サイナ（さいはて さいな）」「宵越 モヨイ（よいごし もよい）」のイラストをお願いしたいと思っております。\n参考イラスト及び簡単な説明を資料ＵＲＬに添付しておりますので、昔の絵でお恥ずかしいですがご確認いただけますと幸いです。\n備考としまして、二人は同期の相方同士（ユニット名：2M(フタメータ)）で、よく一緒に配信活動を行っているような関係性ということを補足させていただきます。\n\nデザインがきっちり確立されている訳ではないので、細かな部分・よく分からない部分などはぜひ適宜アレンジを加えて描いていただければ嬉しいです。イラスト構図や色合い等に関してもお任せできればと思います！\nお忙しいところ恐れ入りますが、何卒よろしくお願い致します！これからも応援しております。\n\nhttps://drive.google.com/drive/folders/1KNYrmY