uration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1f3fc5e4/uploads/origins/a93c913e-add6-425e-ac36-833cefc6d655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e66788447ae8448187773162f18c961d", "srcset": "https://si.imgix.net/1f3fc5e4/uploads/origins/a93c913e-add6-425e-ac36-833cefc6d655?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e66788447ae8448187773162f18c961d, https://si.imgix.net/1f3fc5e4/uploads/origins/a93c913e-add6-425e-ac36-833cefc6d655?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2f4f4d57041c05bad82de3d7210d0253 2x, https://si.imgix.net/1f3fc5e4/uploads/origins/a93c913e-add6-425e-ac36-833cefc6d655?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3414cc1c7a53849bd074025825b2b327 3x"}, "body": "ちはち様　\nご縁があれば以下OCのリクエストをお願いしたくお送りします！\n頂いた作品は個人利用（壁紙、非商用印刷物（グッズ））と、Skeb依頼用参考資料にて使用します。\n\n【キャラクター詳細】\nエラー・レイニー　（女｜165cm｜18歳）\n素直、天真爛漫、愚直、気分屋で無分別、寂しがり屋。\n気まぐれで自由で少年の様な振る舞いが目立つ。人の裸、血を好み、動かなくなってしまった死体は嫌う。\n前世が軍人。現在は彫刻を得意とする美大生であり、趣味はアイススケート。\n特徴：オッドアイ、天使の様な見た目で悪魔のような性格、内側のうなじ箇所の髪は天使の羽の様なデザインですがちはちさんが描きやすいよう自由な形で落とし込んでいただいて大丈夫です。\n\n【補足】\n共有資料内では前世が軍人の為軍服がほとんどですが、ほかに似合いそうな服がありましたら自由に表現頂いて大丈夫です。\nしいてあげるなら白い服にアクセントで赤や青がある服を着ている印象です。（強い希望ではありません！）\n\nご検討の程、宜しくお願い致します。\n\nhttps://drive.google.com/drive/folders/1Pm_d84OC5SxNiFRXJeA7gihdmsgU2SIx?usp=drive_link", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pom_ai_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2645967, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0d1e6391/uploads/origins/06ae3ca4-5062-4218-91bc-62d886633cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00533e99ed53108c010bc050a446daf6", "srcset": "https://si.imgix.net/0d1e6391/uploads/origins/06ae3ca4-5062-4218-91bc-62d886633cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00533e99ed53108c010bc050a446daf6, https://si.imgix.net/0d1e6391/uploads/origins/06ae3ca4-5062-4218-91bc-62d886633cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c63311229065387fddd7d71caacc21d7 2x, https://si.imgix.net/0d1e6391/uploads/origins/06ae3ca4-5062-4218-91bc-62d886633cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=63e36ec05e6cd2635d5264eaf4d6df6d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0d1e6391/uploads/origins/06ae3ca4-5062-4218-91bc-62d886633cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b80e377cd717971fbf56b7df46e30cc2", "srcset": "https://si.imgix.net/0d1e6391/uploads/origins/06ae3ca4-5062-4218-91bc-62d886633cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b80e377cd717971fbf56b7df46e30cc2, https://si.imgix.net/0d1e6391/uploads/origins/06ae3ca4-5062-4218-91bc-62d886633cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dce3fd41a4596bb9ab05cf01111f839e 2x, https://si.imgix.net/0d1e6391/uploads/origins/06ae3ca4-5062-4218-91bc-62d886633cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=46e344a3f9cec22f1707edd7ee6de4db 3x"}, "body": "Hello, I really like your work and would like to ask you to design a new outfit for my original character if you can.\nThe character is a 21 year old male with a feminine look. Burgundy hair with a white highlight, fuchsia eyes and a mole in the corner of his left eye. Holds a medical class licence but works as a taxidermist in a private studio.\nPrefers to dress in monochrome colours and wears a lot of earrings and necklaces as accessories. His favourite food is sweets and alcohol.\nCheerful and light-hearted, he has the impression of being able to get along with anyone. When silent or alone, he may occasionally reveal a gloomy atmosphere. Mentions his student days and will muddle through.\nPlease free to draw, thank you very much!\n\nhttps://drive.google.com/drive/folders/1mnF2nxeS9GUIrwG7iqMa0apr6x_X_sX1?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@l_i_l_il/works/290", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1430221, "client_id": 2645967, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b28bdf6f/uploads/origins/4655ef82-9047-4f98-a7c4-1153bf9f2eb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd1062c5221e7ec24bb5d3a738470ba2", "srcset": "https://si.imgix.net/b28bdf6f/uploads/origins/4655ef82-9047-4f98-a7c4-1153bf9f2eb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd1062c5221e7ec24bb5d3a738470ba2, https://si.imgix.net/b28bdf6f/uploads/origins/4655ef82-9047-4f98-a7c4-1153bf9f2eb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d9c5f0516113ad6ee8b8f1e1d0302e54 2x, https://si.imgix.net/b28bdf6f/uploads/origins/4655ef82-9047-4f98-a7c4-1153bf9f2eb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c783c84a4ce85b2a1e4a7a0e59bfe80 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b28bdf6f/uploads/origins/4655ef82-9047-4f98-a7c4-1153bf9f2eb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3c5b2c49a4e32dd08821f4ec9bc8932", "srcset": "https://si.imgix.net/b28bdf6f/uploads/origins/4655ef82-9047-4f98-a7c4-1153bf9f2eb8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e3c5b2c49a4e32dd08821f4ec9bc8932, https://si.imgix.net/b28bdf6f/uploads/origins/4655ef82-9047-4f98-a7c4-1153bf9f2eb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6f9b74f08d9f9976f073837f6f2b3ed5 2x, https://si.imgix.net/b28bdf6f/uploads/origins/4655ef82-9047-4f98-a7c4-1153bf9f2eb8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=183a737819c62a37a3666fdfa8ed8dee 3x"}, "body": "わにさんこんにちは\n今回は私のocを描いて頂きたいです。\n\n【キャラクター】\n緋ノ司 日梅花\nお嬢様学校に通う1年生で個人主義\n身長155cmで基本的に笑顔\nイメカラは赤ピンク、モチーフは梅\n\n【要望】\nわにさんの描くダークな絵が好きなので\nダークで不気味な感じでお願いいたします\nまた普段は手を出してないのですが手を出して手を見せるような構図にして欲しいです。\n暗めで笑顔\n背景に茄子があると嬉しいです！\n黒 金 赤（赤ピンク）よりの絵だと有難いです。\n\nまた料金が可能でしたら\n寮の先輩と日梅花のSDも描いて欲しいです。\n\n4年桜桃（ちえり）\n学校一の奇人\n先輩として慕っている\nモチーフは桜\n\n3年 紫（ゆかり）\nこの寮の常識人\n見下してるが好き\nモチーフは紫陽花\n\n2年瞑（めい）\n普通そうに見えるがやばい人\nお友達で先輩\nモチーフは彼岸花\n\n日梅花ちみハーレム\n料金が見合ってない場合は再送してください。\n\nhttps://drive.google.com/drive/folders/1xkVPSO0QOco7UhP-cM-FFSBpBR1MJd89", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 763207, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "あさの", "screen_name": "asano4124", "avatar_url": "https://pbs.twimg.com/profile_images/1568978489864515584/NBzRWfbO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/130743526/1409939417/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 14, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "banned": false, "nc": 48}, {"id": 1949120, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "もぞもぞ", "screen_name": "aiueonigiri_04", "avatar_url": "https://pbs.twimg.com/profile_images/1910929410179403776/he-BDCCN.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1511197066730811394/1728230794/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester