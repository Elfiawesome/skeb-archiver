rcset": "https://si.imgix.net/182c0e44/uploads/origins/54b712ca-d294-4bed-9421-b02c2f543f34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=742c4bf47f29c5c72a063dcb2762eddc, https://si.imgix.net/182c0e44/uploads/origins/54b712ca-d294-4bed-9421-b02c2f543f34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7cf4102ce119b8e6c9a0e362d64b9dda 2x, https://si.imgix.net/182c0e44/uploads/origins/54b712ca-d294-4bed-9421-b02c2f543f34?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=50b46007519b94b6628cedb9bb50e153 3x"}, "body": "こんにちは！私のOCをデザインしてもらえますか？\n\n参考画像は大まかな目安なので、あなたの創造力をお願いします！\n-ウェーブのかかったリッチブラウンのロングヘア\n-日焼けした肌（地中海カラー）\n-ダークブラウンの目\n-ノースリーブのカットオフ・トップ\n-ヒップから垂れた、流れるようなロングスカート\n-スカートの上部に飾りベルトあり\n-主な服の色は赤、白、紫。\n-装飾的な服やジュエリーが好きで、さまざまなブレスレットやヘアピースを身につける。\n-服にはボーダー柄、ビーズ、ピンなどをつける。\n\nクリエイティビティが評価される！\n\nhttps://drive.google.com/drive/folders/1nPlf704Z5jqT_zosdu42ULx2JXvQBis8", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@OKINAGAWAKANA/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2757312, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/00d6ecc6/uploads/origins/c8456b99-5c1e-4261-8613-dcb68a009545?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa685144be4f11ee7ce09005b21c8413", "srcset": "https://si.imgix.net/00d6ecc6/uploads/origins/c8456b99-5c1e-4261-8613-dcb68a009545?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa685144be4f11ee7ce09005b21c8413, https://si.imgix.net/00d6ecc6/uploads/origins/c8456b99-5c1e-4261-8613-dcb68a009545?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e45c544f2bebff385221a8540e4a52ba 2x, https://si.imgix.net/00d6ecc6/uploads/origins/c8456b99-5c1e-4261-8613-dcb68a009545?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6077dc06d2665adc358949d015ee520d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/00d6ecc6/uploads/origins/c8456b99-5c1e-4261-8613-dcb68a009545?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4ce816810e501ca6414c513d0ba8d1c", "srcset": "https://si.imgix.net/00d6ecc6/uploads/origins/c8456b99-5c1e-4261-8613-dcb68a009545?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4ce816810e501ca6414c513d0ba8d1c, https://si.imgix.net/00d6ecc6/uploads/origins/c8456b99-5c1e-4261-8613-dcb68a009545?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b01aa01e01a65e446ea7d955da5428f7 2x, https://si.imgix.net/00d6ecc6/uploads/origins/c8456b99-5c1e-4261-8613-dcb68a009545?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e23355c0edaf3ce7ecdcc53640ea024c 3x"}, "body": "こんにちは！もしよろしければ、私のOCをデザインしていただけませんか？\n\n体型は、幅広のヒップと太めの強い太ももを持つアスリート系です\nサイズは82cm、64cm、90cm、バストはCカップです\n年齢は20代後半と思われます身長160cm\n肌の色は淡く、わずかにオリーブとピーチの色調を帯びている\n瞳の色は、鮮やかなヒッコリーブラウン\n髪の色はミディアムブラウンで、薄いグレーが数本入っている\n髪はセンターパートで、後ろでゆるく束ねています\n前髪には、長さの異なる複数の短い毛束が抜けています; 顎までの長さで、完全に自由になっているものもあれば、お団子からほぐれただけのものもあります\n参考リンクにメガネの例があります\nデザインは自由ですが、以下のような特徴を持つことが望ましいです：\n-ダークブロンズまたはブラウンカラー\n-丸みを帯びた長方形の形状\n-身長が小さく、目より少し大きい\n-レンズ上部と側面はフレーム、レンズ下部はワイヤー/オープン\n参考リンクに服のアイデアがあります\nhttps://drive.google.com/drive/folders/1JARFhbkjs6k2CfDXdkFSM8D41ntlozZd デザインは自由に工夫してください\n服装\n-黒の機能的な戦闘用アウター（例：長袖腰丈ジャケット、ニーハイレースアップブーツ、グレーまたは黒のベルト、ベルトと太ももにサイドバッグ、ベルトにハンドガンホルスター）\n-ビジネスウェアの下は、ニュートラルカラー（グレー、シルバー、ブラック、ブラウン）の無地（長ズボン、ボタンを留めない長袖シャツ）\n-ハイネックまたはモックネックの襟付きアンダーシャツ（中間色無地）\nその他の詳細\n-両耳に複数のピアス（3～5個）、シルバーのイヤリング（スタッドまたはドロップ）\n-左手第4指のプレーンなシルバーマリッジリング\n-眉毛が通常よりやや太い\n-お好みで、すべての衣服の縁にシルバーやグレーのディテールを入れることができます\n性格：普段は無感動なほど冷静で、皮肉屋である\nよく疲れている\nまた、冷たい怒りをあらわにすることもある\n人生の出来事から、不信感を抱き、人間嫌いで、冷淡な性格になった\nしかし、正義を重んじ、狂信的な忠誠心を持ち、少しでも挑発されれば、自分の信じるもののために暴力で戦うことを厭わない\n好きなように描いてください\n\nhttps://drive.google.com/drive/folders/1c5HDUO8a5oD2foupHQVDRuSvQP0AhPB3", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@OKINAGAWAKANA/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2757312, "client_id": 2513060, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa7e8ae2/uploads/origins/f3b96bc4-a811-4387-938e-7eb7714eac2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f56d4a0ad7248ed0239f9df2109c2a3a", "srcset": "https://si.imgix.net/fa7e8ae2/uploads/origins/f3b96bc4-a811-4387-938e-7eb7714eac2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f56d4a0ad7248ed0239f9df2109c2a3a, https://si.imgix.net/fa7e8ae2/uploads/origins/f3b96bc4-a811-4387-938e-7eb7714eac2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0cf4bd893c9056f78b95a0308fcc2de6 2x, https://si.imgix.net/fa7e8ae2/uploads/origins/f3b96bc4-a811-4387-938e-7eb7714eac2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=85d2031a363d5795b717efd37953230a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa7e8ae2/uploads/origins/f3b96bc4-a811-4387-938e-7eb7714eac2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=006b1680b73bd84e6bcc352ba4837e97", "srcset": "https://si.imgix.net/fa7e8ae2/uploads/origins/f3b96bc4-a811-4387-938e-7eb7714eac2d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=006b1680b73bd84e6bcc352ba4837e97, https://si.imgix.net/fa7e8ae2/uploads/origins/f3b96bc4-a811-4387-938e-7eb7714eac2d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fd8f88d80a02afbface38f8231d5e035 2x, https://si.imgix.net/fa7e8ae2/uploads/origins/f3b96bc4-a811-4387-938e-7eb