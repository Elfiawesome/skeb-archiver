bnail_image_urls": {"src": "https://si.imgix.net/7027f096/uploads/origins/ab66255b-40f6-4f7b-9ac9-c9fa72d1a907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36ceaf762c10ab481cdbfdc953a7c570", "srcset": "https://si.imgix.net/7027f096/uploads/origins/ab66255b-40f6-4f7b-9ac9-c9fa72d1a907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=36ceaf762c10ab481cdbfdc953a7c570, https://si.imgix.net/7027f096/uploads/origins/ab66255b-40f6-4f7b-9ac9-c9fa72d1a907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=107dce332dce4e5499fa513d777ce309 2x, https://si.imgix.net/7027f096/uploads/origins/ab66255b-40f6-4f7b-9ac9-c9fa72d1a907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=83ce82f287ef44bc06653b26a1e10a62 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7027f096/uploads/origins/ab66255b-40f6-4f7b-9ac9-c9fa72d1a907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4818607c51919376886fa88d320cffc6", "srcset": "https://si.imgix.net/7027f096/uploads/origins/ab66255b-40f6-4f7b-9ac9-c9fa72d1a907?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4818607c51919376886fa88d320cffc6, https://si.imgix.net/7027f096/uploads/origins/ab66255b-40f6-4f7b-9ac9-c9fa72d1a907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f0d68d2b2655d1a614a562e521d9606c 2x, https://si.imgix.net/7027f096/uploads/origins/ab66255b-40f6-4f7b-9ac9-c9fa72d1a907?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=45578d13c8054529f58d75a285c59d2a 3x"}, "body": "アピールお受けしました。折角ですので、ご依頼失礼します\n今回は知り合いのオリキャラの白い狐な女の子とうちのキャラの組み合わせで描いてもらいたいです\nただ、文中だと2ペアいるうちのどちらの事を指しているのかわからなかったので、両方同封しておきます\n作者側から諸々の許諾は得ておりますのでご心配なく\n参考資料を2ペア分ドライブに用意しておきました\n\n【描いてほしい内容・重要な共通要素】\n・提示したキャラの内容でお任せ、普段通りの衣装でも季節柄に合わせた内容でも合いそうなものであれば何でも好きなようにどうぞ。絵柄も一番合いそうだと思ったもので構いません\n・結婚しているので指輪付き(重要/男性側と相互/片方は見えて欲しい)\n・サイン等をする場合はレイヤー等オンオフ切り替えができると幸いです\n\n【ガラの悪い男と青白の混ざった子のペア】\n女性側の要点\n・身長は168cm\n・着痩せする方なので胸大きめ\n・普段はクールだけど、婚約者の前だとうぶな可愛らしい子\n・狐耳や尾の動きによる感情表現があると嬉しい\n・後者のペアの子とは幼馴染(ライバル意識は全くなし)\n\n男性側の要点\n・身長は192cm程度、アルビノ体色で筋肉質(後者ペアの男よりも)\n・肌が露出する部分がある場合、体中古傷だらけ\n・基本ぶっきらぼうでヤクザやマフィアのようなだいぶ悪い男\n・見た目のガラは悪いが婚約者や身内には優しげ\n・婚約者相手にキザったらしく騎士ぶった立ち振舞をしたりする事もある\n\n【無表情な男とクール寄りな子のペア】\n女性側の要点\n・身長は170cm\n・クール系のお姉さん、少しこちらの方が年上\n・普段はクールな性格だが婚約者の前ではやや恥じらいが出る\n・ストレートな好意には弱く、割と受けに回り気味\n・着痩せする方\n・前者のペアの子とはライバル関係(とこっちが一方的に思ってる)だったが今はすっかり腕前を競いに来るご近所さん件夫婦仲間\n\n男性側の要点\n・身長は189cm\n・筋肉の引き締まった細身、所謂細マッチョ(青年想定)\n・口数が少ない・足りてないタイプ(ゴブリンスレイヤーさんやFGOのカルナさんなどそっち系の言語圧縮族)\n・でも言うことは言うし割と素直\n・表情変化も激しくはないが青年相応の感性、比較的クール\n・特に好意の伝え方はストレートで受け攻めで言えばかなり攻め\n・トレーニングを怠らないストイックな性分\n\nよろしければご検討頂けると幸いです\nまた、完成品は他に依頼を行う時に参考資料として引用する事をご了承ください\n資料や情報が不足している場合、お手数ですが他依頼をご覧ください\n\nhttps://drive.google.com/drive/folders/1S54B7utHJiXePoxu3t1-4YxoVqjxk7SP?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@harapochi_art/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2733609, "client_id": 3173901, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e9853b47/uploads/origins/77f9c097-6a8d-4fd1-bc6d-1760f6e57272?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03e3da1e2c95928121d7c6dfc62d9c4e", "srcset": "https://si.imgix.net/e9853b47/uploads/origins/77f9c097-6a8d-4fd1-bc6d-1760f6e57272?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03e3da1e2c95928121d7c6dfc62d9c4e, https://si.imgix.net/e9853b47/uploads/origins/77f9c097-6a8d-4fd1-bc6d-1760f6e57272?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a4dbff31f1fcec54acfbef7bfb571bb2 2x, https://si.imgix.net/e9853b47/uploads/origins/77f9c097-6a8d-4fd1-bc6d-1760f6e57272?bg=%23fff&auto=format%2Ccompress&fm=webp&