n": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/249afaec/uploads/origins/eba6e869-c5a6-46da-bf37-19086433cef8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0cfd54e3502b34d182e05c99738ff4f9", "srcset": "https://si.imgix.net/249afaec/uploads/origins/eba6e869-c5a6-46da-bf37-19086433cef8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0cfd54e3502b34d182e05c99738ff4f9, https://si.imgix.net/249afaec/uploads/origins/eba6e869-c5a6-46da-bf37-19086433cef8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bfdcc3cd52cc6e64035c2e22e9fca101 2x, https://si.imgix.net/249afaec/uploads/origins/eba6e869-c5a6-46da-bf37-19086433cef8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3a4b0816df048a3d38147e66616b2d15 3x"}, "body": "こんにちは！以前、私のオリジナルキャラクター（OC）についてリクエストをいただいたので、今回、スケッチのリクエストをさせていただきたいと思います！\n\nネルヴェラは、死者の魂と交信し、それを操ることができるネクロマンサーです。彼女は医師の助手として働き、他に頼る人がいない村々の世話をしています。ネルヴェラは物静かな性格で、死と向き合う日々を送っているため、どこか疲れたような雰囲気を漂わせています。 \n\n絵の内容は、もしよろしければ精霊や死者に関連したものでも構いませんが、選択はあなたにお任せします。ご自身がベストだと思うように自由に描いてください。オリジナルの衣装や見た目でも構いません。いずれにせよ、どんな仕上がりになるか楽しみにしています！\n\nhttps://imgur.com/a/nelverra-ref-fOoNya7\n\nhttps://imgur.com/a/nelverra-ref-fOoNya7", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@harapochi_art/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2733609, "client_id": 3173901, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a9bc838/uploads/origins/109304a5-4f1b-4cac-bde1-cf9eb1009403?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=800714e52df16e6fe9ebe58373f46111", "srcset": "https://si.imgix.net/1a9bc838/uploads/origins/109304a5-4f1b-4cac-bde1-cf9eb1009403?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=2