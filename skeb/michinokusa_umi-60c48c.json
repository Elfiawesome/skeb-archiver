00&h=200&blur=200&s=dd62b8174040b923ea59d108878b78a1 3x"}, "body": "初めまして、Vtuber/Vsingerとして活動しているものです。\nXでお見掛けしたスイーツのイラストがおいしそうで素敵でしたので、今回私と食べ物を描いていただきたくメッセージをお送りしました。\n\n内容\nパフェとうさ耳メイドの私\n私はトッピングのようにパフェの上に乗っていてもいいですし、大きいスプーンで食べようとしていても良いです。\n\nキャラデザ、服装\n資料の画像を参照ください（※頭の左右に赤青メッシュがあります）\n\nパフェ\n資料ではブラウンが多いですが、パフェということがわかればフルーツを追加等していただいて構いません。\n\n使用用途\nグッズ化、収益化済みYouTube等各SNSでのプロモーション\n\n上記の都合上\n背景透過のものがあるとありがたいです。\n\nぜひご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1nsPhOii9JHC0klvuh5S_9DnJm_WBGkmF?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@michinokusa_umi/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4004581, "client_id": 757395, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a8d493c/uploads/origins/52b9dc5c-bc5e-4573-b291-44d6df6d49a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3568e5f061bbdf65cc7f8a014daf5ee1", "srcset": "https://si.imgix.net/2a8d493c/uploads/origins/52b9dc5c-bc5e-4573-b291-44d6df6d49a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3568e5f061bbdf65cc7f8a014daf5ee1, https://si.imgix.net/2a8d493c/uploads/origins/52b9dc5c-bc5e-4573-b291-44d6df6d49a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a52ecf4987c729f5b75cb0a8b8cd5601 2x, https://si.imgix.net/2a8d493c/uploads/origins/52b9dc5c-bc5e-4573-b291-44d6df6d49a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df84906beac7909d485762280a70dfc0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2a8d493c/uploads/origins/52b9dc5c-bc5e-4573-b291-44d6df6d49a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06dfde98c60fe132c08101206d0654fd", "srcset": "https://si.imgix.net/2a8d493c/uploads/origins/52b9dc5c-bc5e-4573-b291-44d6df6d49a7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06dfde98c60fe132c08101206d0654fd, https://si.imgix.net/2a8d493c/uploads/origins/52b9dc5c-bc5e-4573-b291-44d6df6d49a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=443495e6f215dfd7a6a6e613ff08f3d3 2x, https://si.imgix.net/2a8d493c/uploads/origins/52b9dc5c-bc5e-4573-b291-44d6df6d49a7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=076a655ef46a47de6eace58c35400f56 3x"}, "body": "初めまして、食べ物のイラストを探していたらたどり着きました。\nとてもお上手なスイーツの絵だったので一枚描いて頂きたくてリクエストいたします。\nモチーフが星空フリルさん（個人勢のVの方です）\nウミウシとピエロがモチーフの全体的に色合いが青い子なのですが甘い物は好きな様なのでクレープやタルトなどでサーカスの球はブルーベリー、ウミウシの触角はマンゴー、星空要素はチョコレートとスプレーチョコなどなどでキャラクターぽいスイーツを描いて貰えればメニューの指定はありません。\n使用用途としてSNS、YouTube、可能ならGTAなどのゲームに食べ物の画像をメニューとして持ち込めるのでGTA内での使用、再現出来そうなら実物を作る際の許可が欲しい。\n宛先の有無があれば助かります。\n\nhttps://drive.google.com/drive/folders/1vniMetde-Tc81RGARuYM7G-nDn5OjXeM?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@michinokusa_umi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4004581, "client_id": 4077905, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a97f6139/uploads/origins/7f211d37-9c8d-4710-9e6e-7c1ae1abca96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e1302e947b5df8ef7a5b408939bd4c7", "srcset": "https://si.imgix.net/a97f6139/uploads/origins/7f211d37-9c8d-4710-9e6e-7c1ae1abca96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3e1302e947b5df8ef7a5b408939bd4c7, https://si.imgix.net/a97f6139/uploads/origins/7f211d37-9c8d-4710-9e6e-7c1ae1abca96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2df784fed22475a158ce69f5abf25784 2x, https://si.imgix.net/a97f6139/uploads/origins/7f211d37-9c8d-4710-9e6e-7c1ae1abca96?bg=%23fff&auto=for