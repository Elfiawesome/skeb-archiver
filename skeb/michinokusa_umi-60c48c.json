ix.net/3c199c61/uploads/origins/4415f47f-ed74-46b5-ba05-77d842b02233?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3c495f0068e9a933fb4f2d5225f03dbd, https://si.imgix.net/3c199c61/uploads/origins/4415f47f-ed74-46b5-ba05-77d842b02233?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=868c77471806f271cdf79c5b6102c8a7 2x, https://si.imgix.net/3c199c61/uploads/origins/4415f47f-ed74-46b5-ba05-77d842b02233?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=65e45689b90f2f950b939b7e50c3e743 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3c199c61/uploads/origins/4415f47f-ed74-46b5-ba05-77d842b02233?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dbe3a991ccc2a26bfc938f4feb5fffa0", "srcset": "https://si.imgix.net/3c199c61/uploads/origins/4415f47f-ed74-46b5-ba05-77d842b02233?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dbe3a991ccc2a26bfc938f4feb5fffa0, https://si.imgix.net/3c199c61/uploads/origins/4415f47f-ed74-46b5-ba05-77d842b02233?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=00f128fcda7dbe9e8206b40df34bef5a 2x, https://si.imgix.net/3c199c61/uploads/origins/4415f47f-ed74-46b5-ba05-77d842b02233?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fa6ac4df81e19b48cbf15f7912fea8ac 3x"}, "body": "初めまして。新着クリエイターで見掛け、食べ物とマスコットのイラストが大変素敵で、開始をお待ちしていました。\nご確認ご検討お願い致します。\n\n■内容\n「食べ物」＋「犬と兎」（普段描かれている小さなマスコット）でお願いしたいです。\n犬と兎ですが、自作ゲーム（制作中）のキャラクターの、イメージ動物です。そのため、毛と目の色をそれぞれのカラーでお願いしたいです。①が犬、②が兎です。\n※BLですので、苦手でしたら設定は読み飛ばして外見のみ参考にして頂ければと思います。\n\n食べ物は、第１希望はグラタン（芋、肉、茄子入り）、第二希望がミートパイですが、他のものでも構いません。\nもし良かったら、キャラクター設定の「こまごま」の方に食の傾向がありますので参考にして下さい。\n尚、②のキャラクターが甘味を苦手としているのですが、パンケーキやアップルパイやドーナツのイラストがとっても好きでしたので、甘味でもokです。\n\n■利用用途\n個人鑑賞です。\n\n以上、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1H