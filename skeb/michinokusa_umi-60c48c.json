紫色の髪と淡いラベンダー色のインナーカラー\n・紫色の瞳にピンク系のハイライト\n・頭の白いリボンが特徴です\n\n詳しくは添付資料をご参照ください。\n\n■ 使用用途\n\n・SNSや配信活動での使用\n・商用利用（収益化された配信、グッズ制作等）\n\nご検討いただけましたら幸いです。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/file/d/1ypK4P56L7V_xqujMamoY50hJsu7WTsCO/view?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@michinokusa_umi/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4004581, "client_id": 972082, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1758de24/uploads/origins/2b9b3527-fe61-4f65-b9aa-a8c3053209fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ac98b48fb43200ff069e33fc253a994", "srcset": "https://si.imgix.net/1758de24/uploads/origins/2b9b3527-fe61-4f65-b9aa-a8c3053209fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6ac98b48fb43200ff069e33fc253a994, https://si.imgix.net/1758de24/uploads/origins/2b9b3527-fe61-4f65-b9aa-a8c3053209fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f8cdd6224134e2a4d147b32ce3613653 2x, https://si.imgix.net/1758de24/uploads/origins/2b9b3527-fe61-4f65-b9aa-a8c3053209fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89a8e23c078857fecc602a225b87faa2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1758de24/uploads/origins/2b9b3527-fe61-4f65-b9aa-a8c3053209fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4fd6d26e7a205f3e25fee851c6efaf19", "srcset": "https://si.imgix.net/1758de24/uploads/origins/2b9b3527-fe61-4f65-b9aa-a8c3053209fe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4fd6d26e7a205f3e25fee851c6efaf19, https://si.imgix.net/1758de24/uploads/origins/2b9b3527-fe61-4f65-b9aa-a8c3053209fe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&c