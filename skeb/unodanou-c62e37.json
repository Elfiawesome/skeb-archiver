。\n\nシャボルド\n年齢：30歳\n身長：191cm\n外見タフで長身、小麦色の肌、長い巻き毛の黒髪、金色の目、明らかな胸筋。\n\n彼の肖像画を描いてほしい。\n\n彼はファンタジーパロに属している。\nテーマは以下の通り：シダ、森、古代の民族様式。\nスタイル：落ち着いているが、圧縮されている。トップ・プレデター（例：パンサー）のよう。\n\nイラストは彼の設定に合わせて自由に描いてください。\n\nキャラクターの参考資料や詳細は下記Google DriveのURLをご参照ください。\n\nご検討のほど、よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1_N10_p2K4txye8zUNXa45alFrvTt07Lf", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@unodanou/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2898548, "client_id": 2659469, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c7739b81/uploads/origins/a6a8e658-2991-45e3-bcb5-68d1552d86e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94091680983d633fafd99502bdcfcce1", "srcset": "https://si.imgix.net/c7739b81/uploads/origins/a6a8e658-2991-45e3-bcb5-68d1552d86e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=94091680983d633fafd99502bdcfcce1, https://si.imgix.net/c7739b81/uploads/origins/a6a8e658-2991-45e3-bcb5-68d1552d86e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5af82418b0af34e932cbe86a296cbd8f 2x, https://si.imgix.net/c7739b81/uploads/origins/a6a8e658-2991-45e3-bcb5-68d1552d86e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aceff8213e5072ede7a9feab4b4475c1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c7739b81/uploads/origins/a6a8e658-2991-45e3-bcb5-68d1552d86e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65ecb23ada508465976daa40a465d12f", "srcset": "https://si.imgix.net/c7739b81/uploads/origins/a6a8e658-2991-45e3-bcb5-68d1552d86e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65ecb23ada508465976daa40a465d12f, https://si.imgix.net/c7739b81/uploads/origins/a6