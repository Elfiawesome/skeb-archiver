.com/zakuros/status/1776326311046431224\n刀の方はシンプルなデザインでお願いします\n\nサイズは高さ3500ピクセル以上でお願いします\n\nご検討のほど、よろしくお願いいたします m(_ _)m\n\nhttps://i.imgur.com/17Btb0r.jpeg", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@zakuros/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 7809, "client_id": 5650, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1527cb58/uploads/origins/fa100841-e46c-4245-910a-760806869021?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ae1db9402970792eb37cb5384f7221e", "srcset": "https://si.imgix.net/1527cb58/uploads/origins/fa100841-e46c-4245-910a-760806869021?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7ae1db9402970792eb37cb5384f7221e, https://si.imgix.net/1527cb58/uploads/origins/fa100841-e46c-4245-910a-760806869021?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9f11c47bea94919376202523f758d5e3 2x, https://si.imgix.net/1527cb58/uploads/origins/fa100841-e46c-4245-910a-760806869021?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d89b71549709c36a6931622497ddbc69 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1527cb58/uploads/origins/fa100841-e46c-4245-910a-760806869021?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=abfd68094bdbd3491dda5a288ce96868", "srcset": "https://si.imgix.net/1527cb58/uploads/origins/fa100841-e46c-4245-910a-760806869021?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=abfd68094bdbd3491dda5a288ce96868, https://si.imgix.net/1527cb58/uploads/origins/fa100841-e46c-4245-910a-760806869021?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7cdf064aca25e3dbd202f85d4b531d2a 2x, https://si.imgix.net/1527cb58/uploads/orig