た眉毛。 2- グラデーションの髪色。 3- 縦長の瞳孔。 4- 猫のような小さくて鋭い歯。服装：和洋折衷の衣装を自由にデザインしていただけると嬉しいです。白を基調としたデザインだととても嬉しいです！ https://drive.google.com/drive/folders/14XpefQ9zoGBxDe1U-flh7eYOH3MyR_zN https://drive.google.com/drive/folders/14XpefQ9zoGBxDe1U-flh7eYOH3MyR_zN", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@supe_riv/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5c062418/uploads/origins/3f714465-0a82-424e-872b-481705e2006f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2b54ffa862aaae1681d53cdea7693698", "srcset": "https://si.imgix.net/5c062418/uploads/origins/3f714465-0a82-424e-872b-481705e2006f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2b54ffa862aaae1681d53cdea7693698, https://si.imgix.net/5c062418/uploads/origins/3f714465-0a82-424e-872b-481705e2006f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=40b499ab720c6f022a5665c35e1b2a4a 2x, https://si.imgix.net/5c062418/uploads/origins/3f714465-0a82-424e-872b-481705e2006f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0fb250a5910c4f0a2f1ff09657996a68 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 4009752, "nc": 145}, {"path": "/@supe_riv/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/78a26e24/uploads/origins/f47f022d-90f7-4f8c-81b9-30759b3c36b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0b2c1ee77ecff52b03