マンサーであることを知ります。龍玄は裏切られたと思い、首元にナイフを突きつけながら、ボリンに向かって猛ダッシュします。\n\n表情・詳細\n龍は非常に怒った顔をしていて、ボリンの首のところに硬い炎のような光でできた刃を持っている。彼は包帯を巻いた左手を使っている。\n\nボリンは非常にショックを受けた表情をしているはずです。ボリンが自分を裏切ったために、龍玄がどれほど早く自分を殺そうとしたかにショックを受けています。首には、龍玄の短剣でひっかかれた傷跡があるはずです。\n\nhttps://imgur.com/a/ECq8BXy", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mirion_ray_/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 255654, "client_id": 1807381, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac13be39/uploads/origins/b161a423-9691-40a6-9e09-6f40a630daf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee217295a07a64b5df3d1c6e958a7b47", "srcset": "https://si.imgix.net/ac13be39/uploads/origins/b161a423-9691-40a6-9e09-6f40a630daf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ee217295a07a64b5df3d1c6e958a7b47, https://si.imgix.net/ac13be39/uploads/origins/b161a423-9691-40a6-9e09-6f40a630daf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f98cf9b22719e1d962ebefc4669647f3 2x, https://si.imgix.net/ac13be39/uploads/origins/b161a423-9691-40a6-9e09-6f40a630daf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=10cc56871cd43629810d94c370fab020 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac13be39/uploads/origins/b161a423-9691-40a6-9e09-6f40a630daf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4a0665487014584960863e9a7a97d71", "srcset": "https://si.imgix.net/ac13be39/uploads/origins/b161a423-9691-40a6-9e09-6f40a630daf5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a4a0665487014584960863e9a7a97d71, https://si.imgix.net/ac13be39/uploads/origins/b161a423-9691-40a6-9e09-6f40a630daf5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr