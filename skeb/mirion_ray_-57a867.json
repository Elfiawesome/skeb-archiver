14b7b18d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d137452a65c874c974e0786b41e2742d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d2cf8d34/uploads/origins/86d4b0bb-f1fb-4ded-a034-911b14b7b18d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3de97cd40f6fc6dc7d96f40b66d5ba1", "srcset": "https://si.imgix.net/d2cf8d34/uploads/origins/86d4b0bb-f1fb-4ded-a034-911b14b7b18d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3de97cd40f6fc6dc7d96f40b66d5ba1, https://si.imgix.net/d2cf8d34/uploads/origins/86d4b0bb-f1fb-4ded-a034-911b14b7b18d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b65c55bfd950403378fe52436830c780 2x, https://si.imgix.net/d2cf8d34/uploads/origins/86d4b0bb-f1fb-4ded-a034-911b14b7b18d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=609ebd573289355ba607b15bf9f70167 3x"}, "body": "こんにちは！あなたの絵がとても好きなので、ファンタジーの世界を舞台にしたオリジナルキャラクターの絵をお願いしたいです。彼は帝国の王で、多くの人に愛されています。ポーズや構図は自由に決めていただいて構いません。\n\n可能であれば、レイヤー（エフェクト、スケッチ、キャラクター、背景など）を分けたPSDファイルもお願いしたいです。ご迷惑をおかけしたら申し訳ありません。よろしくお願いいたします！\n\nキャラクターデザインはフォルダ内の画像A1をご参照ください。ストーリーは画像S1です。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1k_Y9-ukQVS72xsISp73-_s5LRUl9_s2X\n\npsdに線画や練習絵、没ラフ等があれば入れてくれると嬉しいです。\n\n使用用途：個人使用のみ（例：個人ウェブサイトでの表示／非商用印刷）\n\nhttps://drive.google.com/drive/folders/1k_Y9-ukQVS72xsISp73-_s5LRUl9_s2X", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mirion_ray_/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 255654, "client_id": 221236, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/31949830/uploads/origins/493c03b9-5a5d-4a54-afb8-c8f0a288d8c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4f3ec430c5124e54f6634a3773ca6cd", "srcset": "https://si.imgix.net/31949830/uploads/origins/493c03b9-5a5d-4a54-afb8-c8f0a288d8c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a4f3ec430c5124e54f6634a3773ca6cd, https://si.imgix.net/31949830/uploads/origins/493c03b9-5a5d-4a54-afb8-c8f0a288d8c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a189ddc4db5f4d1d06840da0656305e 2x, https://si.imgix.net/31949830/uploads/origins/493c03b9-5a5d-4a54-afb8-c8f0a288d8c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=113a91ba9b657b49dc215012a03f00be 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/31949830/uploads/origins/493c03b9-5a5d-4a54-afb8-c8f0a288d8c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39d37affb23326509d8306e6c43e0bd4", "srcset": "https://si.imgix.net/31949830/uploads/origins/493c03b9-5a5d-4a54-afb8-c8f0a288d8c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=39d37affb23326509d8306e6c43e0bd4, https://si.imgix.net/31949830/uploads/origins/493c03b9-5a5d-4a54-afb8-c8f0a288d8c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=45f416405feddb5354005669459d2a30 2x, https://si.imgix.net/31949830/uploads/origins/493c03b9-5a5d-4a54-afb8-c8f0a288d8c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=63b6110aa166b75b2882ab2970c40c75 3x"}, "body": "はじめまして、メイセン様。\n　いつもTwitterにてイラストを拝見しています！ 今回、イラストをお願いしたく思いリクエストを送らせていただきました。\n　 詳細は下記に記載させていただきます。\n　【リクエスト内容】\n　キャラクターイラストの依頼でVtuberの『海渡KAITO（カイト）』さんをお願いします。\n　【全体のイメージ】\n　カイトさんが武器を構えてビジュアル撮影をしているというイメージです。\n　カイトさんは、撮影者に視線を向けながらウインクをしていて「似合ってるかな？」と言っているような表情をしていること以外、細かなポージング・背景・ロケーションについてはお任せします。\n　【武器の資料】\n　 カイトさんが構える武器は、アクションドールシリーズ『アサルトリリィ』に登場する『CHARM』という武器の1種『アスピド・ズメイ』で、簡易ビットを展開した状態です。\n　詳しい資料についてはURL（https://drive.google.com/drive/folders/1bZ7wBBIy6sg7696iLpVJUcukxkf4TRWm）から確認をお願いします。\n　アスピド・ズメイとカイトさんのサイズ比やポージングについては資料を参考に、クリエイター様の判断にお任せします。\n　【イラストの範囲】\n　おおむね頭から膝下またはつま先あたりの範囲でメインのパーツが収まる形でお願いします。\n　クリエイター様には申し訳ないのですが、一部をトリミングする形で使用させていただく場合もあります。\n　【使用用途】\n　スマートフォンの壁紙やヘッダー、SNS、Youtube上でのサムネイルやその他動画内、納品後クリエイター様へのお礼ポストでの使用。 \n　【備考】\n　SNSや動画サイトでの掲載についてもご自由に扱っていただいて問題ありません。\n　 長々としたリクエストになってしまいましたがよろしくお願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mirion_ray_/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/325aae6f/uploads/origins/5c6709c7-84ba-4f89-a3a8-af4abcf0d786?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af50848b5c3e52a15f232ae8a8686de3", "srcset": "https://si.imgix.net/325aae6f/uploads/origins/5c6709c7-84ba-4f89-a3a8-af4abcf0d786?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af50848b5c3e52a15f232ae8a8686de3, https://si.imgix.net/325aae6f/uploads/origins/5c6709c7-84ba-4f89-a3a8-af4abcf0d786?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d46d7657f2402dd5a9566d0a85c03c4d 2x, https://si.imgix.net/325aae6f/uploads/origins/5c6709c7-84ba-4f89-a3a8-af4abcf0d786?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=52ee212211f3729751e1dc1f741cb518 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 255654, "client_id": 1426064, "nc": 145}, {"path": "/@mirion_ray_/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 255654, "client_id": 1807381, "