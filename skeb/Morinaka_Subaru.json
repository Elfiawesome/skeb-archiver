ら、納品を楽しみにお待ちしております。\n\nhttps://x.com/highbow_iri/status/1943822617103765593?s=46&t=gFjWoK1qfSYsE9we3voYqA\n\nhttps://x.com/highbow_iri/status/1943822617103765593?s=46&t=gFjWoK1qfSYsE9we3voYqA", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Morinaka_Subaru/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3716864, "client_id": 3560084, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac4ccac2/uploads/origins/165056bb-1e6e-4d77-b79b-6eb4a924a156?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dae2ac00713ce8ae13d52fd03eaeb855", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac4ccac2/uploads/origins/165056bb-1e6e-4d77-b79b-6eb4a924a156?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=21800ad1b7c3ce56d34d91054ff37c41", "src_set": ""}, "body": "ここすこさんの探索者なのですがこの子描いていただきたいです！！\n通常と戦闘シーン描いてもらえると私が喜びます！よろしくお願いします！！🙏💕\nへらへらした感じの子ですね！\n\nhttps://x.com/tetora_soara/status/1924738381331992610?t=H5vFbqMlMTlXpMGONek8FA&s=19", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Morinaka_Subaru/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3716864, "client_id": 3560084, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7715b5ea/uploads/origins/422c3a15-f754-40fa-89b2-925a28106664?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5e7c8a349dbf44ed4a2296624edfea53", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7715b5ea/uploads/origins/422c3a15-f754-40fa-89b2-925a28106664?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c0b95497f964b