o=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ef5bba6ef683ba548eb5995a32d4e344, https://si.imgix.net/26275268/uploads/origins/bd22ea4d-f1f9-4511-afc7-308b700f6f26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=03dd4e9ae377578d89ea59a785316bf7 2x, https://si.imgix.net/26275268/uploads/origins/bd22ea4d-f1f9-4511-afc7-308b700f6f26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e32b801ca77bb04d36eba68901c475fd 3x"}, "body": "あけましておめでとうございます。\n下記の内容に基づくイラストをお願いいたします。\n☞テーマ\n朝の砂浜の波打ち際に立ち、海に背を向けてこちら（陸地側）を向いている平安名すみれ(ラブライブ！スーパースター!!)\n\n☞詳細\n表情は「決意を込めた目でこちらを見つめる」\nスカートと髪は風になびいています。\nふくらはぎ部分までは海水に浸っています。\n暖かい照明でお願いします。\n\n☞服装\nhttps://www.lovelive-anime.jp/yuigaoka/member/img/c04b.png\nhttps://www.lovelive-anime.jp/yuigaoka/member/img/c04a.png\nニーソの一部は濡れて透けている。\n\nご検討の程よろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AOIirodori7/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1019867, "client_id": 3558017, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f9fe4b21/uploads/origins/889529ee-1540-4117-a3fd-88c99125808a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=211a9c0473a57b624b24503d8d8a3ebb", "srcset": "https://si.imgix.net/f9fe4b21/uploads/origins/889529ee-1540-4117-a3fd-88c99125808a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=211a9c0473a57b624b24503d8d8a3ebb, https://si.imgix.net/f9fe4b21/uploads/origins/889529ee-1540-4117-a3fd-88c99125808a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=22feaf16b4d2593ebd838b16df81123a 2x, https://si.imgix.net/f9fe4b21/uploads/origins/889529ee-1540-4117-a3fd-88c99125808a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=440cd18189b2144bae896aeb31baa0eb 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f9fe4b21/uploads/origins/889529ee-1540-4117-a3fd-88c99125808a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b9543095762e85c600746e6fea10814", "srcset": "https://si.imgix.net/f9fe4b21/uploads/origins/889529ee-1540-4117-a3fd-88c99125808a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0b9543095762e85c600746e6fea10814, https://si.imgix.net/f9fe4b21/uploads/origins/889529ee-1540-4117-a3fd-88c99125808a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cc629be9ff874cf92e1cdc7c8b2f72da 2x, https://si.imgix.net/f9fe4b21/uploads/origins/889529ee-1540-4117-a3fd-88c99125808a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=166b1ace535d0c7f82df7ff4d91b5d3e 3x"}, "body": "こんにちは、あおいえのさん！あなたの作品には魂がこもっているように見えるので、目を引きました。\n私のOC、エステルのクリスマスをテーマにしたイラストをお願いしたいです。彼女は半竜人で、地下の戦士として現代の大都市に住んでいます。\n普段は挑発的な悪役で、熱血で無鉄砲。ストリートで尊敬されるような強い個性を持つ。外向的で遊び好き。酒やタバコのような過剰なものを好む。\n\nとはいえ、今回の依頼では、もっとソフトな一面を見せてほしい。彼女は若い頃、何も祝ったことがなかったので、お祝いのイルミネーションや色に驚いたり、心を奪われたりするでしょう。外でクリスマスの帽子をかぶって、マフラーをしているとか。でも、具体的なシーンは考えていないから、クリエイティブな選択はあなたに任せるわ。ただ、彼女の個性が歪まないような優しいものがいいな。\n\nこの作品はPCの壁紙として使いたいので、背景も可愛く描いていただけるとありがたいです！\nありがとうございました\n\nhttps://drive.google.com/drive/folders/1oXnOaF0JK_fXlQyHWPLtZVbRRko7ZsDM?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AOIirodori7/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1019867, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e8b60c3/uploads/origins/d07ddedf-3a42-456b-9fe2-804c1eb057a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f165c32908e82e43effb544cd94dddf1", "srcset": "https://si.imgix.net/6e8b60c3/uploads/origins/d07ddedf-3a42-456b-9fe2-804c1eb057a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f165c32908e82e43effb544cd94dddf1, https://si.imgix.net/6e8b60c3/uploads/origins/d07ddedf-3a42-456b-9fe2-804c1eb057a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3330b3a6348417ffa3856ff4d4c45150 2x, https://si.imgix.net/6e8b60c3/uploads/origins/d07ddedf-3a42-456b-9fe2-804c1eb057a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a4b7f6d04559bb7f6ae369e672bf4d34 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e8b60c3/uploads/origins/d07ddedf-3a42-456b-9fe2-804c1eb057a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a55232e6924678b0a0787caa5d859c2", "srcset": "https://si.imgix.net/6e8b60c3/uploads/origins/d07ddedf-3a42-456b-9fe2-804c1eb057a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3a55232e6924678b0a0787caa5d859c2, https://si.imgix.net/6e8b60c3/uploads/origins/d07ddedf-3a42-456b-9fe2-804c1eb057a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7a47ba2ffcce5383c954343275935ec5 2x, https://si.imgix.net/6e8b60c3/uploads/origins/d07ddedf-3a42-456b-9fe2-804c1eb057a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7e804148d5610c844883753abd29cbf2 3x"}, "body": "いつもお世話になっております。\n『ラブライブ！虹ヶ咲学園スクールアイドル同好会』の優木せつ菜と宮下愛のイラストをお願いします。\n☞テーマ\n雨でずぶぬれになった二人は室内または屋外のベンチに座り、優木せつ菜は宮下愛の肩によりかかって寝る。\n\n☞詳細\n二人の全身を収める距離からの視点でお願いします。\n横長の構図でお願いします。\n優木せつ菜は宮下愛のカーディガンを肩にかけています。\nブラウスは濡れていて、肌の一部が少し透けている。\n\n☞服と参考資料\n宮下愛：163cm、冬制服(長袖白ブラウス+リボン)+指定のグレーハイソックス。\n室内の場合はローファーなし。\nハイソックスのストライプを(4-5本)お描きください(参考画像のように足裏にはストライプがありません)。\n\n優木せつ菜(中川菜々):154cm、冬制服(長袖白ブラウス+リボン+ブレザー)+指定の紺ハイソックス、宮下愛のカーディガン。\n室内の場合はローファーなし。\nリボンはリンク先の「リボン.jpg」のように描いてください。(宮下愛の と同じく、(キャラクターの)左下の帯の端に白と青のラインがあります)。\n髪型はフォルダー「優木せつ菜(中川菜々)」の「制服.png」と「制服c08.png」を参考にしてください。\n\nご検討の程よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1EecX7TCWDYY6dbFkUYKQbDXQo2Au4wxw?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AOIirodori7/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1019867, "client_id": 2724334, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b8fd7d47/uploads/origins/5fc13f5c-8c03-42a1-9445-7c404f12a4d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29e03d6312bc9a9d5a7a3342eb3a1b90", "srcset": "https://si.imgix.net/b8fd7d47/uploads/origins/5fc13f5c-8c03-42a1-9445-7c404f12a4d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=29e03d6312bc9a9d5a7a3342eb3a1b90, https://si.imgix.net/b8fd7d47/uploads/origins/5fc13f5c-8c03-42a1-9445-7c404f12a4d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a35afdc81ef33d6614c84d404bff5386 2x, https://si.imgix.net/b8fd7d47/uploads/origins/5fc13f5c-8c03-42a1-9445-7c404f12a4d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=708f7aacee530dd68b2fab03142790b9 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b8fd7d47/uploads/origins/5fc13f5c-8c03-42a1-9445-7c404f12a4d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d18f864244e7725e4ec5a59396f131f", "srcset": "https://si.imgix.net/b8fd7d47/uploads/origins/5fc13f5c-8c03-42a1-9445-7c404f12a4d6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3d18f864244e7725e4ec5a59396f131f, https://si.imgix.net/b8fd7d47/uploads/origins/5fc13f5c-8c03-42a1-9445-7c404f12a4d6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=59e23b0dd9e4972f28f983d778e380d2 2x, https://si.imgix.net/b8fd7d47/uploads/origins/5fc13f5c-8c03-42a1-9445-7c