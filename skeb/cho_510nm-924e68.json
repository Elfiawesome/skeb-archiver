らほら頑張れ」♂「もう出ない……から……ごめんなさい許してください」 と言ったようなセリフでお願いします \n\n女性側身長190cm ショタ側身長139cmです\n女性側おっぱいは以前別の方に依頼したイラストを資料として添付しておりますがそれよりデカくお願いします(頬崎様のイラストのデ、デカ女ちゃん意地悪しないで位の大きさでお願いします)\n\n服装に関してなのですが頬崎様の描かれてる地雷系もしくは資料添付の自キャラゲーム内スクショの服装でお願いします\nショタの方はおまかせ致します\n\n\n  頬崎様のイラストがとても魅力的だったので依頼させていただきました よろしくお願いします\n\nhttps://drive.google.com/drive/folders/1VLEUc-RV0lwe7JrdRukmOnhlHPI7Iti5", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 329200, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ちゃぼ", "screen_name": "StarChabo", "avatar_url": "https://pbs.twimg.com/profile_images/1911760745211043840/vYRGLF0z.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1064451046867529728/1744807250/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 176}, {"id": 462750, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "サツキ・ラビット", "screen_name": "Satuki_rabbit", "avatar_url": "https://pbs.twimg.com/profile_images/1728181678169047040/aPGiAnQu.jpg", "header_url": null, "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 33}, {"id": 1067476, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "さんかく@skeb募集中", "screen_name": "Sankakusukeb", "avatar_url": "https://pbs.twimg.com/profile_images/1920414411384041472/rWudVC4G.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1270353024221757446/1746698001/1500x500", "appeal_receivable": fals