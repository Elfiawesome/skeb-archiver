ったりする可能性もあります。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@riuart/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3758934, "client_id": 2231946, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a8e7a68f/uploads/origins/01d612a1-7aab-4a17-b11b-d68024528591?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e33efe0a1dd479278194130f774f1fd5", "srcset": "https://si.imgix.net/a8e7a68f/uploads/origins/01d612a1-7aab-4a17-b11b-d68024528591?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e33efe0a1dd479278194130f774f1fd5, https://si.imgix.net/a8e7a68f/uploads/origins/01d612a1-7aab-4a17-b11b-d68024528591?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c7747afd472ee3c0df77d3a7e7f29236 2x, https://si.imgix.net/a8e7a68f/uploads/origins/01d612a1-7aab-4a17-b11b-d68024528591?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9c23d68f22e1cb9aef155271ad40126d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a8e7a68f/uploads/origins/01d612a1-7aab-4a17-b11b-d68024528591?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9737d36a142d11b23ceb2fdc0ad37983", "srcset": "https://si.imgix.net/a8e7a68f/uploads/origins/01d612a1-7aab-4a17-b11b-d68024528591?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9737d36a142d11b23ceb2fdc0ad37983, https://si.imgix.net/a8e7a68f/uploads/origins/01d612a1-7aab-4a17-b11b-d68024528591?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=aa1fdf4a42e547d93c6ab27fd94935d8 2x, https://si.imgix.net/a8e7a68f/uploads/origins/01d612a1-7aab-4a17-b11b-d68024528591?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=73518cb8d30baa3354a46fc39c4f863b 3x"}, "body": "はじめまして、新着クリエイター一覧から過去作品に惹かれてきました\nもしよろしければリクエストを受けていただけないでしょうか\nサービス終了したネットゲームのマイキャラクターがモデルのうちの子になります\nお淑やかな性格でむっつりスケベ、胸は控えめのスレンダーな子で、お尻が性感帯です\n\n・希望する内容を箇条書きで\n「依頼衣装（ドレスまたは夏服）」というファイルの衣装を着せてあげてください\n（もしくは「その他衣装」から飛べるフォルダの中にお好みの衣装があれば、そちらを着せてあげてください）\n犬耳を着け、尻尾付プラグをお尻に挿入した状態（付け根のプラグが見えないような、尻尾だけお尻から伸びているような形状）\n恋人とのいちゃらぶセックス、または尻尾は無しでアナルセックス\n犬になりきりながらorお尻で気持ちよさそうにしているイメージ\nとろとろで気持ちよさそうな表情\n相手の描写は無くても構いません\n胸の大きさは控えめ（Bカップ程度～つるぺたまでお好みで）\n服装は着衣～半脱ぎくらいでお願いします\n顔が見える内容で、その他構図などは描きたいものでお任せします\n\nご検討をお願いいたします\n\nhttps://drive.google.com/drive/folders/1gXZVDfcsl66QZ8VxPLKFXERqQXKioNsJ", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@riuart/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/1788ef75/uploads/origins/036ab8c9-0c05-4077-987a-668de8d14189?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e6a8ef85c88e5794920deec1ae12aa5", "srcset": "https://si.imgix.net/1788ef75/uploads/origins/036ab8c9-0c05-4077-987a-668de8d14189?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3e6a8ef85c88e5794920deec1ae12aa5, https://si.imgix.net/1788ef75/uploads/origins/036ab8c9-0c05-4077-987a-668de8d14189?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d29fae0eb95096dd3ed6ccb6765ffa26 2x, https://si.imgix.net/1788ef75/uploads/origins/036ab8c9-0c05-4077-987a-668de8d14189?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=777f127a4727eecd49acc8e87784b817 3x"}, "private": true, "genre": "art", "tipped": fals