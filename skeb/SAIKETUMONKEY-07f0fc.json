eda-4536-a41c-5fae2ac33b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cb4ba891f57884c2ea44f5451ef9562", "srcset": "https://si.imgix.net/4b65cdee/uploads/origins/41fff588-aeda-4536-a41c-5fae2ac33b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3cb4ba891f57884c2ea44f5451ef9562, https://si.imgix.net/4b65cdee/uploads/origins/41fff588-aeda-4536-a41c-5fae2ac33b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e764c6ea6543dadaeb4be535c4ebe1a 2x, https://si.imgix.net/4b65cdee/uploads/origins/41fff588-aeda-4536-a41c-5fae2ac33b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f97a7631428811146f5bcbcdef312050 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b65cdee/uploads/origins/41fff588-aeda-4536-a41c-5fae2ac33b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ddfb499e90927ce998d4aa878ef9477", "srcset": "https://si.imgix.net/4b65cdee/uploads/origins/41fff588-aeda-4536-a41c-5fae2ac33b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7ddfb499e90927ce998d4aa878ef9477, https://si.imgix.net/4b65cdee/uploads/origins/41fff588-aeda-4536-a41c-5fae2ac33b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=43b76e9005d1e3bb28960093cc6c8172 2x, https://si.imgix.net/4b65cdee/uploads/origins/41fff588-aeda-4536-a41c-5fae2ac33b6c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a839704c729e702b939daa33429502bd 3x"}, "body": "こんにちは！いきるさんの描かれる素敵な作品を、いつも楽しく見ております。いきるさんの描かれるふにゃっとした柔らかさ、複雑に入り混じりながらもひとつひとつが痛ましいほど剥き出しの感情が大好きです♡\n\n今回依頼したいのは、私の創作キャラの漫画です。\nキャラや、依頼したい漫画の内容については下記の通りです。\n\n〈キャラ〉\n春麻白:14歳の少年です。12歳の時に母親が亡くなり、叔父である成田泊に引き取られました。ほとんどの時間を、成田泊と共に住むアパートの一室にて、1人で過ごしています。\n成田泊から日常的に虐待を受けており、怪我が絶えません。\n生活に苦しさを感じながら、成田泊と共によりよく暮らすことを願い、日々頑張っています。\n\n〈内容〉\n春麻白がアパートで1人思い悩んだ末、「うう…」と唸り、うずくまる様子を描いていただきたいです。(1ページ前後を想定しています。)\n「思い悩む」については、生活の中でふと身を浸す、抑うつや恥、不安などの感情が入り混じって葛藤している様子をお願いしたいです。\n具体的な言葉を持って何かに煩悶してもいいし、漠然とした希死念慮に取り憑かれていてもいいと思います。\n\nいきるさんの描かれる、入り乱れた感情の遷移がありありと伝わってくる表情や擬音、細かな仕草が大好きなので、それが見れたらうれしいな…と思っています！\n\n\n内容は描きやすいよう追加・変更・省略していただいて構いません。また、漫画が難しければ一枚絵でも構いません。\nキャラの傷痕や部屋の内装、衣服などは描きやすいよう変更・省略していただいて構いません。\n上記内容が難しければ、別のものでも大丈夫です。基本的に全ていきるさんにおまかせします！\n関係性の説明のため、下記URLに成田泊の資料も載せていますが、漫画内に出てこなくても大丈夫です。\n最後に、ご不明な点や金額不足などあれば再送要請お願いします。難しい場合はキャンセルなどしていただいて大丈夫です。\nご検討のほどよろしくお願い致します！\nhttps://drive.google.com/drive/folders/1-BYQTeOUTtbB1nHoswA36LrL-ON5_IuX", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@lol04null/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1027589, "client_id": 2054312, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4a74e864/uploads/origins/125860cf-5cc3-4145-a8e9-53f89b8b24a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a3859494972e5a0c9a7b6a98b411045", "srcset": "https://si.imgix.net/4a74e864/uploads/origins/125860cf-5cc3-4145-a8e9-53f89b8b24a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2a3859494972e5a0c9a7b6a98b411045, https://si.imgix.net/4a74e864/uploads/origins/125860cf-5cc3-4145-a8e9-53f89b8b24a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9a38b020ca4eb89e41a07091a1707873 2x, https://si.imgix.net/4a74e864/uploads/origins/125860cf-5cc3-4145-a8e9-53f89b8b24a5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=613d2f380dde5b4e9954e7de9c146e45 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4a74e864/uploads/origins/125860cf-5cc3-4145-a8e9-53f89b8b24a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60def04055a10b94d589838c3a3dcec9",