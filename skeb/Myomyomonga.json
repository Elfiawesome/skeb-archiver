いします。\n※尻尾9本もあるので描きづらい場合は1本にして頂いても大丈夫です\n\n【使用用途】\n・収益化済のChの動画や配信でのサムネイル（Youtubeなど）\n・その他SNSでの宣伝\n・ネットプリント\n・FANBOX\n・企業案件や個人でのグッズ販売\n\nファイルは人物、背景の透過pngまたはPSDファイルを頂きたいです。\nご検討の程どうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1AqwfGueakyh7Ai9jK77Dhq2z1T5Zi8Cv?usp=drive_link", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Myomyomonga/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3602227, "client_id": 3329822, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/19d884a1/uploads/origins/47b28654-bf6c-4908-a1f0-7633b0e41a2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1e70ef03acd42144a101f88b7e377ae0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/19d884a1/uploads/origins/47b28654-bf6c-4908-a1f0-7633b0e41a2f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=29189342983dba486234dfdc6c1cc0bc", "src_set": ""}, "body": "Hello !! I'm Sterna. nice to meet you~ Your art is very cute!!!\n\n> Could you draw me in a similar pose? : https://imgur.com/a/oVdVLxI\n> I will use it on my SNS! : https://x.com/SternaCelest\n\nThank you 💜\n\nhttps://drive.google.com/drive/folders/1qJWQKWcdy-7-mf4Xv4Tg14zQ17MFdKAP?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Myomyomonga/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3602227, "client_id": 3646889, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/59c400d6/uploads/origins/f252bc62-2ce4-445d-a6c6-5448d6416384?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7c479daaed7740a50451eb38541dff57", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_