い。\n\nキラは鏡の外に立って鏡の中を覗いています。  鏡の中にはもう一人、現実の私に似た女の子がいます。背景は、ベッドルームの洗面台の鏡でもいいし、バスルームの鏡でもいい。あるいは、ある種の魔法の領域にするのもいいでしょう！\n\nモデルはキラ・クローバーで、私の容姿の参考画像も追加しました。キラは緑の髪ですが、私は黒髪です。僕の服装は好きにしていいけど、キラの服装はそのままでお願いします。\n\nキラは宝石のような目をした魔法少女で、とてもキラキラしています！\n大学ではごく普通の人です。\n\nレイヤーは分けてください。商用利用OKな方のみお願いします。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/1ZotYPIDOV0-L562v5uCqV4C9ttvecfMD", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@9_bids/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3431100, "client_id": 3681719, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4aff28e9/uploads/origins/7e38b5b1-162f-4176-82fe-83365199efd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b797a791005558f103c8a43bfc2d908", "srcset": "https://si.imgix.net/4aff28e9/uploads/origins/7e38b5b1-162f-4176-82fe-83365199efd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b797a791005558f103c8a43bfc2d908, https://si.imgix.net/4aff28e9/uploads/origins/7e38b5b1-162f-4176-82fe-83365199efd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=664eab0b7ff59dd81252ab91d72d0556 2x, https://si.imgix.net/4aff28e9/uploads/origins/7e38b5b1-162f-4176-82fe-83365199efd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=87f1c0c34568739d10ca3de236d3d64a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4aff28e9/uploads/origins/7e38b5b1-162f-4176-82fe-83365199efd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd7bcf41099f1fd6d7dafe5908e087ea", "srcset": "https://si.imgix.net/4aff28e9/uploads/origins/7e38b5b1-162f-4176-82fe-83365199efd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd7bcf41099f1fd6d7dafe5908e087ea, https://si.imgix.net/4aff