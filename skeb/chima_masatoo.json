n\nモチーフは水引きと星です！両耳にピアスがあります。インダストリアルと耳たぶにピアス穴があります。\n（まさと様の創られる世界観に合わなければ、なくても大丈夫です！）\n\n資料です。  https://drive.google.com/drive/folders/1qSBERhk32pkC2xjMzQm1F_yUcEUurV8o", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 357555, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ひよこちゃんアヒルンバ！🐣(古鳥あひる)", "screen_name": "ahirumamire", "avatar_url": "https://pbs.twimg.com/profile_images/1820504193213603840/pRDzMseS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1448442895/1764314619/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 49}, {"id": 1133747, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "しらとりゆう / Shiratori U", "screen_name": "yy_108109", "avatar_url": "https://pbs.twimg.com/profile_images/1898643522145935360/FLmJ73ta.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2276960906/1751089373/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 48}, {"id": 2312072, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ふじまき🐯", "screen_name": "Fujimaki_2UxU", "avatar_url": "https://pbs.twimg.com/profile_images/1722995274736713728/x1oSvR2t.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1504733243744333825/1731674642/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiratio