ストがとっても可愛くて惚れました…\nリットリンクに記載されていた『ごちゃっと感が魅力 散らばるオシャレ』でお願いしたく存じます！\n\n▶キャラクターついて  \n資料のキャラクターをお願いいたします。 \n\n宵待灯李(よいまちとうり)\n【特徴】\n・提灯おばけの女の子\n・タレ目\n・目のハイライトがおばけの形\n・八重歯\n・顎の下のほくろ\n・ぱっつん前髪\n・相棒の提灯おばけを連れている\n\n▶構図\n衣装、構図全てお任せいたします！\nちま まさと様の作る世界観が大好きなので、好きに描いて頂けますと幸いでございます！\n\n\n▶使用用途  \n・配信のサムネイルや返礼品やSNS投稿に使用 \n・グッズ化、アイコンやヘッダーの使用\n背景やサインなどレイヤーを分けてPSDファイルで納品してただきたいです。\n\n金額が内容と合わない場合などは、お手数おかけしますが再送をお願いしたいと思います。 \nお忙しいところ大変恐縮ですがご検討のほどよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1-1Y4YJ8OgZRS_ycmeheFNX7xX2ED3cHS", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@chima_masatoo/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e21a8ca3/uploads/origins/f3cd4a3f-4652-45c7-b14d-56755e60ff50?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=af5f45ead256573bca8e5fe3f8d58806", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3160855, "client_id": 2963141, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 17, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@chima_masatoo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3160855, "client_id": 3728210, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4564e7b5/uploads/origins/180d189c-6d29-44e6-88e7-22970ef6a9e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d9d3e8e87b44407b44581a68258d69e5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4564e7b5/uploads/origins/180d189c-6d29-44e6-88e7-22970ef6a9e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blu