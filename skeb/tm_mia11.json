女キャラ：男キャラが最初から恋愛として大好き。ずっとラブコールを送っている。将来の夢は男キャラのお嫁さん。\n男キャラ：女キャラのことは妹のような、純粋無垢な存在として守らないとと思っていた。（告白もあくまで家族のようなものとしてだと思っていた）\n　　　　　最近本気で好きだと聞かされ困惑しているものの、女性としてちゃんと見てくれるらしい。\n\nキャラクターの見た目は資料URLをご参照くださればと思います。\n（自キャラに関しては表情差分も入れました。参考までに…！）\n\nよろしければご検討くださいますと幸いです。\nご縁がありましたら、どうぞよろしくお願いいたします…！\n\n\n彩葉\n\nhttps://drive.google.com/drive/folders/13hSpphtrnv6o0UeT1w3V0o-mUHeBFgCq?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tm_mia11/works/157", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e3a6f655/uploads/origins/548723d1-32a5-4724-8895-ce2ab028e49b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=579b9039d74f3cd8d0e3dc42eb9f181f", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1845245, "client_id": 3458396, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tm_mia11/works/156", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f75b5f26/uploads/origins/4a0a3780-842e-4a2f-9d38-f167e65e8b09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=31f45c27f73d6c617cd46871fd47f8a6", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1845245, "client_id": 1077760, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@tm_mia11/works/155", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f0bcd24f/uploads/orig