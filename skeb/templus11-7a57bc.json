200&blur=200&s=6be2e3ba2cf074421675caf61b1384e5", "srcset": "https://si.imgix.net/30e44cf2/uploads/origins/9a5b348b-7489-4794-85b3-e44b48e2914c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6be2e3ba2cf074421675caf61b1384e5, https://si.imgix.net/30e44cf2/uploads/origins/9a5b348b-7489-4794-85b3-e44b48e2914c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0bcae82ea29d91b85d6955c61b282e97 2x, https://si.imgix.net/30e44cf2/uploads/origins/9a5b348b-7489-4794-85b3-e44b48e2914c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b5011b8a300aa25ff38cb176eca58553 3x"}, "body": "こんにちは、私のキャラクター、ハニーを描いてもらえませんか？\nハートのネックレスと白いニーソックス以外は裸。片方の胸の下にペニスがある男の隣に立っている（https://satsukikatze.fanbox.cc/posts/1126798 のように）。欠けた歯を見せて明るく微笑み、ダブルピースサイン。男のペニスが彼女の胸を持ち上げる（https://www.pixiv.net/artworks/108176545）。もう片方の胸を後ろから手でつかむ。詳しく見せる必要はない。\nありがとうございました。\n\nhttps://drive.google.com/drive/u/2/folders/1YbNdV-ZB-OXMv773QCDiFOmUmQA1w3FQ", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@templus11/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 133004, "client_id": 2572098, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/35fa5f59/uploads/origins/f83820c9-5790-450d-85b6-210f99f0e232?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa5d836134bbd99ce3fb135903eba81e", "srcset": "https://si.imgix.net/35fa5f59/uploads/origins/f83820c9-5790-450d-85b6-210f99f0e232?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fa5d836134bbd99ce3fb135903eba81e, https://si.imgix.net/35fa5f59/uploads/origins/f83820c9-5790-450d-85b6-210f99f0e232?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c765b3cf36bb7467c5ce01489a2d64e9 2x, https://si.imgix.net/35fa5f59/uploads/origins/f83820c9-5790-450d-85b6-210f99f0e232?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3cc906b995a5bc8b7f5c18cd5151c64 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/35fa5f59/uploads/origins/f83820c9-5790-450d-85b6-210f99f0e232?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50cdcaa9e2c6ffe6dd9e7c29f08f6065", "srcset": "https://si.imgix.net/35fa5f59/uploads/origins/f83820c9-5790-450d-85b6-210f99f0e232?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=50cdcaa9e2c6ffe6dd9e7c29f08f6065, https://si.imgix.net/35fa5f59/uploads/origins/f83820c9-5790-450d-85b6-210f99f0e232?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8793aeeda33c96bc8a1c0f2b3c04ac79 2x, https://si.imgix.net/35fa5f59/uploads/origins/f83820c9-5790-450d-85b6-210f99f0e232?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5582c0f567a0d88ee23fae5d1a11d95e 3x"}, "body": "こんにちは！\n私のOC、アズラエルとアルトリウスのイラストが欲しいです。\n\nアズラエル（140cm）：https://drive.google.com/drive/folders/1iog2bS4xH8uAg0GVtjOvI8WT6gWvVHey?usp=sharing\nアルトリウス（183cm）：https://drive.google.com/drive/folders/129kUVbQKUKl6zeXSTgiLp2bxt-BghE3_?usp=sharing\nアルトリウス視点で描いています。\nアズラエルはJKの制服を着てほしいです。同じポーズで4バージョン欲しいです。\n1) 壁に背中をつけて、スカートを上げてピンクのマイクロビキニのパンティと子宮のタトゥーを見せている。彼女は少し赤面している。アルトリウスのパンツの股間には膨らみがある。\n2) アズラエルの子宮タトゥーにアルトリウスの勃起したペニスが押しつけられている。アズラエルはショックを受けているが、興奮しているように見える。\n3) アルトリウスはアズラエルと乱暴なセックスをしている。アズラエルは声を出さないようにしている。\n4) アズラエルのアソコから大量の精液が漏れ出し、彼女の体や顔を覆っているため、アルトリウスのペニスは弛緩している。アズラエルの目はハートになっている。\n\nありがとう！\n\nhttps://drive.google.com/drive/folders/1iog2bS4xH8uAg0GVtjOvI8WT6gWvVHey?usp=sharing", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@templus11/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 133004, "client_id": 70074, "vt