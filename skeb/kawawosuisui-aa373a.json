のイラストをリクエストしても宜しいでしょうか？\n\n今回お願いしたいキャラはアスモスというサキュバスの少年です。\n角の中は空洞でピンク色に発光しています。明るめの金髪に茶髪のインナーカラーの髪色です。\n元々名のある公爵家の1番末っ子ですが現在家出中で東洋の国に住む青年の家に居候している設定です。\n\n服装の省略、衣装チェンジやアレンジなどは全ておまかせ致します。ライギョさんのお好きなように描いてくださると嬉しいです！\n\nまた個人的に自分用にアクリルスタンドにしたいと考えております…販売等は致しません！\nもしお値段が見合わないとなりましたら再送依頼お願いします…！ご検討頂けたら幸いです。\n\nhttps://drive.google.com/drive/folders/168vOCO0W6efiOdYBeU6HJBvBxBH10MlT", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kawawosuisui/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 792698, "client_id": 2756899, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/27e450a9/uploads/origins/46178df9-929b-4b68-ad94-bdd84961eaaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e368fd549882d6712d9f529a748e402b", "srcset": "https://si.imgix.net/27e450a9/uploads/origins/46178df9-929b-4b68-ad94-bdd84961eaaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e368fd549882d6712d9f529a748e402b, https://si.imgix.net/27e450a9/uploads/origins/46178df9-929b-4b68-ad94-bdd84961eaaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=779d07073ba74ae8a8911ff846051358 2x, https://si.imgix.net/27e450a9/uploads/origins/46178df9-929b-4b68-ad94-bdd84961eaaa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1819925fcec44d79ede61e76ee4d7794 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/27e450a9/uploads/origins/46178df9-929b-4b68-ad94-bdd84961eaaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f1473097f1146e2bc90e22c716ba2a4", "srcset": "https://si.imgix.net/27e450a9/uploads/origins/46178df9-929b-4b68-ad94-bdd84961eaaa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f1473097f1146e2bc90e22c716ba2a4, https://si.img