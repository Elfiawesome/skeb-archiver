明るい笑顔は避けていただけると嬉しいですc:このイラストはVTuber活動に使用したいと考えています。商用利用可、可能であれば.psdデータもお願いします！金額は調整可能ですのでお気軽にお申し付けください。\n\nご検討いただき誠にありがとうございます。素晴らしい一週間のスタートをお祈りしております！https://drive.google.com/drive/folders/14kKWsR-yoNatXTJGWOxx3xgOrp87Kb_E?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Ff0Ov/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3896721, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/327097f7/uploads/origins/cb6d564a-82b0-467f-9ece-f4afbd98c50b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95a98a2ee616266e01246184d891e670", "srcset": "https://si.imgix.net/327097f7/uploads/origins/cb6d564a-82b0-467f-9ece-f4afbd98c50b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95a98a2ee616266e01246184d891e670, https://si.imgix.net/327097f7/uploads/origins/cb6d564a-82b0-467f-9ece-f4afbd98c50b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1cb3ab6c625c640fc8cd07aeca94db8 2x, https://si.imgix.net/327097f7/uploads/origins/cb6d564a-82b0-467f-9ece-f4afbd98c50b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b8b91f60abb2d3a31f61967c5528c769 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/327097f7/uploads/origins/cb6d564a-82b0-467f-9ece-f4afbd98c50b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b306434594bbcd381eac0c8324cf5f71", "srcset": "https://si.imgix.net/327097f7/uploads/origins/cb6d564a-82b0-467f-9ece-f4afbd98c50b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b306434594bbcd381eac0c8324cf5f71, https://si.imgix.net/327097f7/uploads/origins/cb6d564a-82b0-467f-9ece-f4afbd98c50b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e221a07e91d43