適切な参考資料がなかったので、現在持っている彼のアートやスケッチを全てGoogleドライブにリンクしました！ \n\n肌の色は濃いめ、体型は細身ではないので、ご了承ください！また、下唇のほくろを必ず描いてください。もし何らかの理由で脚が見える構図を描く場合は、ブーツではなくズボンを捲った鳥の脚を描いていただけると嬉しいです（必須ではありません！）。そしてマントも描いていただけるとありがたいです。\n\n性格は静かで好奇心旺盛、常に物思いにふけっています。星座や天文学関連のアイテム（Windows 98関連も可）に囲まれた設定を希望しますが、創作の自由はあります！作品はSNSと商用利用されます。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1ZKdxUHBjCHYCB4TBKvr1YDl3ixpP_DcH?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Ff0Ov/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3896721, "client_id": 3867083, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1db3bd68/uploads/origins/48af763a-e482-4707-a7bd-9a625e5549d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51109511acaea30965b4e4621d1b1b5b", "srcset": "https://si.imgix.net/1db3bd68/uploads/origins/48af763a-e482-4707-a7bd-9a625e5549d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=51109511acaea30965b4e4621d1b1b5b, https://si.imgix.net/1db3bd68/uploads/origins/48af763a-e482-4707-a7bd-9a625e5549d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b296e1cf4558e769abad6c047e6732a0 2x, https://si.imgix.net/1db3bd68/uploads/origins/48af763a-e482-4707-a7bd-9a625e5549d2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=71a8b483f38165a560ac3ddd75dbd562 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1db3bd68/uploads/origins/48af763a-e482-4707-a7bd-9a625e5549d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f95f6fcf41913c6badb2a5d4c53d3ff", "srcset": "https://si.imgix.net/1db3bd68/uploads/origins/48af763a-e482-4707-a7bd-9a625e5549d2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f95f6fcf41913c6badb2a5d4c53d3ff