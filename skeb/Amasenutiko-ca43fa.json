が見切れないように、また、バーチャルお姉ちゃん SANSYO の文字入れをキャラにかぶらない位置にお願いします。※「へ」は不要です。\n\nhttps://twitter.com/LiSansyo/status/1621211401665777664", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Amasenutiko/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 300906, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62ff1af5/uploads/origins/e6055664-e6b1-4e47-aed1-eed2d856fd17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd69d623dcda5a06fa866c328a472808", "srcset": "https://si.imgix.net/62ff1af5/uploads/origins/e6055664-e6b1-4e47-aed1-eed2d856fd17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dd69d623dcda5a06fa866c328a472808, https://si.imgix.net/62ff1af5/uploads/origins/e6055664-e6b1-4e47-aed1-eed2d856fd17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e797bd45714e3edcdc30b38b4ace6eab 2x, https://si.imgix.net/62ff1af5/uploads/origins/e6055664-e6b1-4e47-aed1-eed2d856fd17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4791630ecc21ba903aab59dc703e7494 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62ff1af5/uploads/origins/e6055664-e6b1-4e47-aed1-eed2d856fd17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=255d290e7f957055dd7f6ebf7fd526a6", "srcset": "https://si.imgix.net/62ff1af5/uploads/origins/e6055664-e6b1-4e47-aed1-eed2d856fd17?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=255d290e7f957055dd7f6ebf7fd526a6, https://si.imgix.net/62ff1af5/uploads/origins/e6055664-e6b1-4e47-aed1-eed2d856fd17?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5922738dedc58b9297d55843c4144df9 2x, https://si.imgix.net/62ff1af5/uploads/origins/e6055664-e6b1-4e47-aed1-eed2d856fd17?