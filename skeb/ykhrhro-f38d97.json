とう。\n\nhttps://drive.google.com/drive/folders/108gs1MjMFDjXL3YqpW-spCXI3msEsy7a", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 2620286, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "いかわさ🦑(チゲ味)", "screen_name": "Midori_annte23", "avatar_url": "https://pbs.twimg.com/profile_images/1772462509385269248/3WO5dS3i.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1288136668696809473/1711452276/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 110, "skills": [{"genre": "art"}], "banned": false, "nc": 32}, {"id": 2890366, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "らめる🫧", "screen_name": "lamer962", "avatar_url": "https://pbs.twimg.com/profile_images/1892064033236451329/K6pRBkaO.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1621890346937643014/1720355622/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 100, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 0}, {"id": 3215751, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ｹﾞﾎﾞ", "screen_name": "gebo_1111", "avatar_url": "https://pbs.twimg.com/profile_images/1821165598895960064/Y0r8e9sL.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1733521365603622912/1723479023/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "co