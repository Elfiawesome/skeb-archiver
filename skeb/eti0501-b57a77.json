。\n※イラストの元サイズは16:9でなくて大丈夫です。\n\n◆ビジュアル資料\nhttps://drive.google.com/drive/u/1/folders/14yo8ZdsCWyaHE7BcdppByqblXI6x_5UI\n\n◆ビジュアル補足\n瞳：瞳孔はお花の形、右目下に泣きぼくろ\n髪：インナーカラー紺\n　　シルエットは台形のふわっとした感じに毛先カール、顔横の髪が後のボブより長い\n体：胸は小さくならないように（盛っていただく分には問題ないです）\nモチーフ：桜、羽、星\n\n◆データ形式\n人物と背景がレイヤー分されたPSD\n又は人物のみ透過されたPNGなど差分形式でいただけると嬉しいです。\n\n◆アカウント\nhttps://x.com/so1a_chan\nhttps://www.youtube.com/@so1a-chan\n\nお忙しい中恐れ入りますがご検討いただけますと幸いです。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/u/1/folders/14yo8ZdsCWyaHE7BcdppByqblXI6x_5UI", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@eti0501/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3250472, "client_id": 3117373, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a7dd6652/uploads/origins/35af5ff7-6804-4ebd-aa7f-8189402cb7c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35726f9c3ed20ab8ce3c2a1f7c25308d", "srcset": "https://si.imgix.net/a7dd6652/uploads/origins/35af5ff7-6804-4ebd-aa7f-8189402cb7c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=35726f9c3ed20ab8ce3c2a1f7c25308d, https://si.imgix.net/a7dd6652/uploads/origins/35af5ff7-6804-4ebd-aa7f-8189402cb7c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c99f162482eb3c496c2698966ff55c4 2x, https://si.imgix.net/a7dd6652/uploads/origins/35af5ff7-6804-4ebd-aa7f-8189402cb7c1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5d84d082c5748ddf41f88861370a9c72 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a7dd6652/uploads/origins/35af5ff7-6804-4ebd-aa7f-8189402cb7c1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c70bee2dc8829fcde08f419c7d91045", "srcset": "https://si.imgix.net/a7dd6652/uploads/origins/35af5ff7-6804-4ebd-aa7f-8189402cb7