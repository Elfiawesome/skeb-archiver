/folders/1ddqcsSY6So_LKjfcvjYAFU1sNRmmzuS9\nジスーの参考文献\nhttps://drive.google.com/drive/folders/1gB9ZDUyr2mCQJg98hET4k7yq0CgFr_vt?usp=sharing\n\nSNSで使いたい！\n\n金額が高くない場合はアピールしてください！\nご配慮ありがとうございました！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kagamino_mochi/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 894083, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3dcc0acf/uploads/origins/3b10e682-2e04-484d-b3e7-fe716756d7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22bac75e16947d200c36733eff71a19a", "srcset": "https://si.imgix.net/3dcc0acf/uploads/origins/3b10e682-2e04-484d-b3e7-fe716756d7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=22bac75e16947d200c36733eff71a19a, https://si.imgix.net/3dcc0acf/uploads/origins/3b10e682-2e04-484d-b3e7-fe716756d7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=801ae0062c0ffe8a107991ff44ecbdfe 2x, https://si.imgix.net/3dcc0acf/uploads/origins/3b10e682-2e04-484d-b3e7-fe716756d7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f7182526ecb0cd6fe9facbf5869219ef 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3dcc0acf/uploads/origins/3b10e682-2e04-484d-b3e7-fe716756d7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91b440cce569ec7de9280527e483d1cf", "srcset": "https://si.imgix.net/3dcc0acf/uploads/origins/3b10e682-2e04-484d-b3e7-fe716756d7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=91b440cce569ec7de9280527e483d1cf, https://si.imgix.net/3dcc0acf/uploads/origins/3b10e682-2e04-484d-b3e7-fe716756d7a3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=169208fb564cd0b5274e4fefceb12412 2x, https://si.