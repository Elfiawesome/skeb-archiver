umbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 969077, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4b54c9a3/uploads/origins/843c63c5-8a89-4ef6-9d2e-ef79b9aed7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71e18c05b7d874a5ae20d3ab2ee4c8fb", "srcset": "https://si.imgix.net/4b54c9a3/uploads/origins/843c63c5-8a89-4ef6-9d2e-ef79b9aed7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=71e18c05b7d874a5ae20d3ab2ee4c8fb, https://si.imgix.net/4b54c9a3/uploads/origins/843c63c5-8a89-4ef6-9d2e-ef79b9aed7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=af285b3d85253f6e78c9ca4353d2cefa 2x, https://si.imgix.net/4b54c9a3/uploads/origins/843c63c5-8a89-4ef6-9d2e-ef79b9aed7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cd3ff3755adb392c0adc86d304a95c02 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b54c9a3/uploads/origins/843c63c5-8a89-4ef6-9d2e-ef79b9aed7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=917b1768d149968b516a0ada63125dde", "srcset": "https://si.imgix.net/4b54c9a3/uploads/origins/843c63c5-8a89-4ef6-9d2e-ef79b9aed7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=917b1768d149968b516a0ada63125dde, https://si.imgix.net/4b54c9a3/uploads/origins/843c63c5-8a89-4ef6-9d2e-ef79b9aed7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=08794ba1010dda9dc01af672cca67b44 2x, https://si.imgix.net/4b54c9a3/uploads/origins/843c63c5-8a89-4ef6-9d2e-ef79b9aed7f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a577e00dd11c4d54724f9f13d3ac3cbe 3x"}, "body": "桃園ラブ、大満足でした。\n早速次のリクエストに移りたい所存です。\nとはいっても金額も金額ですのであまり気負いなさらずお願いしとうございます。\n今回も①②③から1つセレクトしてくださいませ\n\n①https://i.imgur.com/WFWYHgb.jpg\nカード専用ギャル風コーデ\n公園、もしくはあまり使われないビルの階段などで脚をがばぁ…っと広げて座り、\n見上げてきたリーマン・もしくはショタ等を淫行に誘うようなビッチ風イメージです\nですので階段に開脚して陰部を見せつけるように座り、やや見下ろすようなアングルでお願いします。舌をペロっとしてても良いかもしれません\n陰部はエグ目の柄のパンツ、もしくは紐パンでハッキリと陰唇や内部が見えるようなものなどを希望します。おっぱいは見せつけていてもいいですし、着衣のまま乳首だけ浮いててもどちらでも可能です\n\n②https://i.imgur.com/QtFEiCC.jpg\n前回拾われなかった夏用私服の衣装です。ショタっこにせがまれて恥ずかしがりながらおっぱいを見せて、揉んだり吸い付かれたりしているシチュエーションです\n背景は何でも構いません\n\n③https://i.imgur.com/0lVNyBN.jpg\n同じく拾われなかったカードオリジナルの衣装です。②のセフレショタとのデート中、③の衣装をたくしあげるとすっぽんぽんでエロい文字の落書きなどが書かれている、というシチュエーションです\nコンドームなど口に咥えてニヤッとしててもいいかもしれません\n\n以上です。御検討をお願いします", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@himazinbtk11/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 969077, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/49f77895/uploads/origins/5c51e9d3-1628-4b5e-abdd-7888cdbe8681?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ada6286fb5aafdeeb0c5bc025621e4a4", "srcset": "https://si.imgix.net/49f77895/uploads/origins/5c51e9d3-1628-4b5e-abdd-7888cdbe8681?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ada6286fb5aafdeeb0c5bc025621e4a4, https://si.imgix.net/49f77895/uploads/origins/5c51e9d3-1628-4b5e-abdd-7888cdbe8681?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b1d885d9ca02d0b30d36141b5f3d6e40 2x, https://si.imgix.net/49f77895/uploads/origins/5c51e9d3-1628-4b5e-abdd-7888cdbe8681?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=380173e14d8def3cfeea87b768f88834 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/49f77895/uploads/origins/5c51e9d3-1628-4b5e-abdd-7888cdbe8681?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a5927938dcd9e401bcfa0d2a786a1f2", "srcset": "https://si.imgix.net/49f77895/uploads/origins/5c51e9d3-1628-4b5e-abdd-7888cdbe8681?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9a5927938dcd9e401bcfa0d2a786a1f2, https://si.imgix.net/49f77895/uploads/origins/5c51e9d3-1628-4b5e-abdd-7888cdbe8681?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2c24460065b2ea57d9c6dade36cd998e 2x, https://si.imgix.net/49f77895/uploads/origins/5c51e9d3-1628-4b5e-abdd-7888cdbe8681?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=39cb71425392f0bb1e7b3947dc0ecafe 3x"}, "body": "こんにちは！\n\nメローラ姫、肉感的でとてもよいですね。\nよろしければ1点お願いいたします！\n\nガルパンの西絹代がペニスバンドでマゾショタに暴行するシチュをお願いできますか？\n\n大体こんな感じです。\n\n・背景不要\n\n・西絹代は完全着衣（以下のコスで、ブーツ着用のまま）。\nhttps://girls-und-panzer.jp/XPLk3DYg/wp-content/uploads/2020/02/kinuyo.png\n\n・ショタは全裸で、暴行による生傷だらけ、激しく突かれて大量射精。\n\n・構図は資料URLをさらに暴力的にしたような感じが希望です。西絹代がショタの髪を鷲掴みにして力任せに引き、仰け反らせるような状態。\n\n・ブーツが見切れないように、全身を描いて下さると嬉しいです。\n\nhttps://hentaimov.net/wp-content/uploads/2019/08/2019-08-13fae_151004-480x307.jpg", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@himazinbtk11/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 969077, "client_id": 472733, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/67ac0955/uploads/origins/624fa3a2-dd24-4912-b4a6-417680724cfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7b089778721f3419e0e0f7141f70491", "srcset": "https://si.imgix.net/67ac0955/uploads/origins/624fa3a2-dd24-4912-b4a6-417680724cfe?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7b089778721f3419e0e0f7141f70491, https://si.imgix.net/67ac0955/uploads/origins/624fa3a2-dd24-4912-b4a6-417680724cfe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=69c63b30329878255f0092e60e104b8e 2x, https://si.imgix.net/67ac0955/uploads/origins/624fa3a2-dd24-4912-b4a6-417680724cfe