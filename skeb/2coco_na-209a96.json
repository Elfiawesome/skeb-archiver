t/4f5ff6ed/uploads/origins/92ac39ba-301a-4e95-b137-058dbad64ead?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d8875d1a013b575c7b6cdca8ed5ac6b9, https://si.imgix.net/4f5ff6ed/uploads/origins/92ac39ba-301a-4e95-b137-058dbad64ead?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7d688595ffb6df7c1f33035a1dac51d2 2x, https://si.imgix.net/4f5ff6ed/uploads/origins/92ac39ba-301a-4e95-b137-058dbad64ead?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9621cbe291e263519636889fb2138251 3x"}, "body": "こんにちは！私のキャラクターを描いていただけたら嬉しいです。\n\n彼女は悪魔の血を引いており、他人の感情を操る能力を持っています。その力のために、彼女はもはや自分の感情を表現することができなくなってしまいました。\n\nhttps://drive.google.com/drive/folders/1ScejEPsyz1dW8c1vpZkBBZs3GAKwOpGW?usp=sharing\n\nリクエストをお聞きいただき、ありがとうございます！", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2coco_na/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3927396, "client_id": 515379, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ee476bc6/uploads/origins/8bf67f8c-9d0c-4bf8-9b71-0f838ba758be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bb4a4233ee6cde1bf52689c2be4f0f6", "srcset": "https://si.imgix.net/ee476bc6/uploads/origins/8bf67f8c-9d0c-4bf8-9b71-0f838ba758be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2bb4a4233ee6cde1bf52689c2be4f0f6, https://si.imgix.net/ee476bc6/uploads/origins/8bf67f8c-9d0c-4bf8-9b71-0f838ba758be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=695435ca7924098929aa0a88ae09102d 2x, https://si.imgix.net/ee476bc6/uploads/origins/8bf67f8c-9d0c-4bf8-9b71-0f838ba758be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eb6feceea664deaa4b673aeaa5f71b60 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee476bc6/uploads/origins/8bf67f8c-9d0c-4bf8-9b71-0f838ba758be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c74173c9501feecccc551e50967c87e", "srcset": "https://si.imgix.net/ee476bc6/uploads/origins/8bf67f8c-9d0c-4bf8-9b71-0f838ba758be?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c74173c9501feecccc551e50967c87e, https://si.imgix.net/ee476bc6/uploads/origins/8bf67f8c-9d0c-4bf8-9b71-0f838ba758be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1f2a4bde75d53ee1a39bbb32733f178d 2x, https://si.imgix.net/ee476bc6/uploads/origins/8bf67f8c-9d0c-4bf8-9b71-0f838ba758be?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9053dc7eb812a700bd7c02dda305593e 3x"}, "body": "ココナッツさん、初めまして。\nココナッツさんのとてもかわいい納品を新着からたまたまお見掛けし、その絵柄にとても惹かれました！\n過去作も少し拝見しましたがお顔や髪の描き方、ポーズや服装の質感などとても好みだったので、ぜひうちの子もお願いしたいと思いリクエストを送信しました！\n\nうちの子であるノラちゃんは、10代半ばの少女です。\n狐をモチーフとしたけもみみと大きなしっぽのあるキャラクターで、八重歯がチャームポイントです。\n（人間耳も存在するキャラクターですが、そちらの描写についてはお任せします。ないものとしても大丈夫です。）\n眠たげでジトっとした青い目をしていて、トレードマークの青い眼鏡をおでこにかけています。\n性格はいつも眠そうでおっとりとしていますが、ノリはよく優しい笑顔の似合う子です。\n\nデフォルトの服装は青いパーカー+黒のハーフパンツですが、よろしければ透け感のあまりないタイツ・レギンス等着用とし、併せて衣装デザインしていただきたいです！\n露出の多いものよりはオーバーサイズで布面積の多いものだと嬉しいです。女の子っぽい服装であれば、かっこいい、かわいいなどの方向性はお好きなもので結構です。\n\n可能であればPSD形式での納品とし、ラフ等含めていただけるとありがたいです。\nポーズや構図等そのほかの事項に関しましてはお任せします。\nぜひ楽しんで描いてくだされば幸いです！\n\n資料が過去のSkebイラストのみとなることをご容赦ください。\n頂いたイラストは私の保有するSNS等のアカウントでアイコン・ヘッダーとして使用することがあります。\n要望の多いリクエストとなり大変恐縮ですが、ご検討のほどよろしくお願いします！\n\nhttps://skeb.jp/@sunajiro8", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@2coco_na/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3927396, "client_id": 2589127, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/851b4c42/uploads/origins/07e66cb4-cf1c-49b5-b173