くした男性の恋人（幼馴染）がいる。その恋人との関係では、受け側であり。\n個人用の壁紙として使用したいのですが、可能であればすべてお任せでお願いしたく思います。\n長文をここまで読んで頂き、ありがとうございました。\n何卒ご検討いただければと思います!\n\nhttps://drive.google.com/drive/folders/1ZTolazmdWUv63FndOr1XcBPxMvImTsif?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@21g_21g/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3767569, "client_id": 3249406, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aa5c4044/uploads/origins/7891e0a0-25aa-424d-ba75-b6c481a82b3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96654cbba42efcfb1bbf27db70f8a853", "srcset": "https://si.imgix.net/aa5c4044/uploads/origins/7891e0a0-25aa-424d-ba75-b6c481a82b3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96654cbba42efcfb1bbf27db70f8a853, https://si.imgix.net/aa5c4044/uploads/origins/7891e0a0-25aa-424d-ba75-b6c481a82b3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5509be3e1bb3917fe8eadd1bfab75bcc 2x, https://si.imgix.net/aa5c4044/uploads/origins/7891e0a0-25aa-424d-ba75-b6c481a82b3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=81de90ef7034c832fa990342ea385f61 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa5c4044/uploads/origins/7891e0a0-25aa-424d-ba75-b6c481a82b3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19687756cf3c90c1e845bfcddeafa481", "srcset": "https://si.imgix.net/aa5c4044/uploads/origins/7891e0a0-25aa-424d-ba75-b6c481a82b3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19687756cf3c90c1e845bfcddeafa481, https://si.imgix.net/aa5c4044/uploads/origins/7891e0a0-25aa-424d-ba75-b6c481a82b3e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=07ce3628bc21