。のんびりお待ちしております。\n\nご検討どうぞよろしくお願い致します。", "nc": 24, "word_count": 8896, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@Andparty_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 3301814, "client_id": 2888692, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c91ab53d/uploads/origins/a4fdee52-3f2b-45d2-a9b9-8d7da85d8d87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c16b19f2b3a67595163ddf3b2dffea30", "srcset": "https://si.imgix.net/c91ab53d/uploads/origins/a4fdee52-3f2b-45d2-a9b9-8d7da85d8d87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c16b19f2b3a67595163ddf3b2dffea30, https://si.imgix.net/c91ab53d/uploads/origins/a4fdee52-3f2b-45d2-a9b9-8d7da85d8d87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=61c93ecdb318996819b2300e69d840ca 2x, https://si.imgix.net/c91ab53d/uploads/origins/a4fdee52-3f2b-45d2-a9b9-8d7da85d8d87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05adf457af30d55c94eac0cc9ecfcf28 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c91ab53d/uploads/origins/a4fdee52-3f2b-45d2-a9b9-8d7da85d8d87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67cf99f62666c78d13db5d8aa3a3506e", "srcset": "https://si.imgix.net/c91ab53d/uploads/origins/a4fdee52-3f2b-45d2-a9b9-8d7da85d8d87?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=67cf99f62666c78d13db5d8aa3a3506e, https://si.imgix.net/c91ab53d/uploads/origins/a4fdee52-3f2b-45d2-a9b9-8d7da85d8d87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1f7c61c96d2064749a575c6ccfbd9380 2x, https://si.imgix.net/c91ab53d/uploads/origins/a4fdee52-3f2b-45d2-a9b9-8d7da85d8d87?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=t