als_count": 0, "received_works": [{"path": "/@toy094/works/19", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1009265, "client_id": 17413, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4f1ec29c/uploads/origins/404b8106-ccff-4dc5-b720-408f617f277a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aeda299f2d84039248ec9298cee18fe9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4f1ec29c/uploads/origins/404b8106-ccff-4dc5-b720-408f617f277a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=36b8f93cfeaa6bb6b37eefa213d1fb9d", "src_set": ""}, "body": "最初の作品で描いていただいた甲冑を纏った竜人の全身立ち姿絵をお願いしてもよろしいでしょうか？\nあの時の顔付きと雰囲気が凄く気に入っているので同じ様に描いてもらえると嬉しいです。\n\nキャラクター\nhttps://skeb.jp/@toy094/works/1\n(今回からナマズ髭の部分は描かなくて結構です)\n\nポーズ&コスチューム案\nhttps://www.elgrecominiatures.co.uk/products/european-knight-from-the-late-14th-c-75mm\n可能ならポーズ案の様な兜の面頬上げ下げ差分と顔も良く見たいので脱いで足元に置いたバージョンが(資料参考)が欲しいです！\n\nもし描きずらいポーズだったり甲冑のデザインが気に入らなかったらTTwoWar様の好きにアレンジしたり描き直してください。\n首、腕、腰、尻尾回りにチェインメイル多めだと嬉しいです。\nあとは全てお任せしますので楽しく描いてくだされば幸いです。\nそれではよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1lD8XXzaBpgjj1qWcy1RS6XIaslv9FXYA", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toy094/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1009265, "client_id": 2102447, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d51ea94d/uploads/origins/2a8a589f-e9d2-493f-94ab-40af31cc72e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=456e00b7f4c24856889d2578a44764ec", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d51ea94d/uploads/origins/2a8a589f-e9d2-493f-94ab-40af31cc72e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa357c93a08fd35068f817e8b811c0a7", "src_set": ""}, "body": "はじめまして！あなたの作品を拝見して、戦闘や騎士、クリーチャーなどの描写が気に入りました！私のオリジナルキャラクター、タブリスをぜひ描いていただきたいです！\n\nタブリスは4つのデフォルトフォームを持つ変幻自在の悪魔で、それぞれのフォームには目的があり、彼女の \"モンスターフォーム \"は最強で最大のフォームです！身長は2メートルから63メートルまで。タブリスにとって、大きくなればなるほど強くなるのだ！\n\nタッブリスが登場するシーンのアイデアとしては、矢や槍、剣などにまみれながら兵士たちと戦うというものがある！兵士の首を掴んで絞めたり、噛みちぎったりとか？攻城戦に参加して、その手で城壁の兵士を一掃するとか？戦闘シーンがあれば最高なんだけどね～。\n\nどんな形で描くかはあなた次第！\n\n怪獣タブリス：https://drive.google.com/drive/folders/1AdvTDkZQOgWrL4Sw-ZYO3ajKYrlTuUa7?usp=drive_link\n\nタブリス：https://drive.google.com/drive/folders/1HZsEG8InJB8vhHIehEQIuPEcXi2FNmxt?usp=sharing", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toy094/works/17", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/392bc4ab/uploads/origins/ef0c020e-271c-4857-ae73-fa7da8d36d96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=41991abb4e4495fe797965135a0031d8", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1009265, "client_id": 3408259, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@toy094/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1009265, "client_id": 498295, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5738d986/uploads/origins/481e4223-3eae-4577-b38e-532aa966776c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6b983f4d8a73b6aa8a6eeb6385f36a3f", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5738d986/uploads/origins/481e4223-3eae-4577-b38e-532aa966776c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ddff80819f6a562c3a8b4c59ea18df59", "src_set": ""}, "body": "前回はありがとうございました。\nまたよろしければお願いします。\n前回描いて頂いた続きの情景イメージで\nオリキャラ狼獣人のリュガロが石化したシリュウを救出しようと迷宮に潜り込んだが\n別のトラップに阻まれて迷宮内に捕らわれるように石化した姿で佇んでる雰囲気で\n詳細は自由にお任せでお願いします。\n\n・リュガロ参考画像\nhttps://drive.google.com/file/d/1FiGmonsltgfLreYDUyzKa-ub61HGXmEz/view", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toy094/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1009265, "client_id": 71536, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bf8d302b/uploads/origins/7a655eec-b439-4d07-8acd-f0d9221517b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8a368e0d8abf123ff2a552c9cf6797c7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bf8d302b/uploads/origins/7a655eec-b439-4d07-8acd-f0d9221517b0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=56960610dde76d8923252a8de368ec94", "src_set": ""}, "body": "こんにちは、TTwoWar様、\n\nあなたの中世の描写が大変気に入っています。もしよろしければ、私のドラゴンをフィーチャーしたアートを依頼してもよろしいでしょうか？\n\n彼は強力なネクロマンサーです。彼は白い「Elegant Outfit」を着ていますが、かなり血で汚れています。シーンに関していくつかの提案がありますが、他のことを描いていただいても構いません：\n\nドラゴンが戦場で生き残る；\nドラゴンがダンジョンを探検する；\nドラゴンが宮殿にいる。明らかに、その王国は彼に逆らうという誤った決定をしました。\n参考資料：\nhttps://drive.google.com/drive/folders/1c0IheGIWbUiR-08oiXfG-jXPZvv3tS6j?usp=drive_link\n\nドラゴンの翼を描くかどうかはお任せします。\n\nよろしくお願いします！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toy094/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f2f21de8/uploads/origins/a414ac4a-16bd-4998-9d26-e5c956bdd17d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=22c1fac04802192338a51b520a9d0e43", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1009265, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 145, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@toy094/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1009265, "client_id": 1231761, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d196152/uploads/origins/d3c7816d-f2a3-4b79-a325-60b28cf8c5fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3d71a092b055f082e509036883850bdc", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3d196152/uploads/origins/d3c7816d-f2a3-4b79-a325-60b28cf8c5fb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3c23b2af801e59d9e80f332e70af2a8", "src_set": ""}, "body": "こんにちは、はじめまして。オリジナルキャラクターを2人描いてほしい。名前は \"Tadgh \"と \"Pixson \"です。\n\nタッグ\nhttps://drive.google.com/file/d/1S2xQ4cyNCfyepSq30uTCDwET7Ed7aRKO/view?usp=drive_link\n\nTadghは45歳くらいの人間のドルイドです。植物の魔法を得意とし、味方を助けるポーションを作る。普段は明るい表情をしている。\n\nピクソン\nhttps://drive.google.com/drive/folders/1uxzr0MfcURJ3dt-ahioHE7spFQiN51QL?usp=drive_link\n\nピクソンはタッドの狼の仲間だが、タッドの魔法のおかげで人間のように二本足で立っているが、体は狼のまま。戦士であり、保護者であり、タッドの友人でもある。頭はオオカミのまま。普段は中立か厳しい表情をしている。\n\n参考画像は別のキャラクターのものですが、私のアイデアに限りなく似ています。違いはいくつかある。ピクソンは画像のような鎧を使っていない。また、彼は \"フレイルポール \"と呼ばれる別の武器を振り回している。これは長い木製のポールアームで、先端にフレイルが付いている。先端の鎖につながれた部分も木製だが、トゲがついている。\n\n武器：\nhttps://drive.google.com/drive/folders/1vI07Cu8i0bJmoKFA22t32M7Pabb2eylU?usp=sharing\n\nこれは必要ないが、ピクソンは自分の周りに霧を発生させるユニークな魔法の指輪も持っていた。敵から見えにくくなり、攻撃しにくくなるため、戦闘に役立った。もし可能であれば、何らかの些細な形でそれが含まれていれば、クールなディテールになるだろう。でも、その必要はない。\n\n好きなようにポーズを取ればいい。\n\nご配慮ありがとうございました。\n\nhttps://drive.google.com/file/d/1S2xQ4cyNCfyepSq30uTCDwET7Ed7aRKO/view?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toy094/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/cc77b4bc/uploads/origins/b4d76936-25d8-4258-aaf9-8e6041f34616?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e35132f053e5ccd89f0dd1125f6de633", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 1009265, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@toy094/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1009265, "client_id": 498295, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c27edce2/uploads/origins/61b36057-8978-4d48-b16e-feb3d0e375aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fd712e049cb28729fe81fba31ab290b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c27edce2/uploads/origins/61b36057-8978-4d48-b16e-feb3d0e375aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dba3aea94d445d780b3939b7bd420678", "src_set": ""}, "body": "はじめまして。\nよろしければオリキャラ竜人のシリュウがトラブルに見舞われた姿を描いて頂きたいです。\n\nシリュウが古代迷宮の探索中にトラップの発動に巻き込まれて\n石化の呪いが籠められた魔法針が身体に打ち込まれて\nそれに驚いて足掻くような様子のまま石と化して\n迷宮内に竜人の石像がひっそりと佇んでいるイメージで全体的にお任せします。\n\n・シリュウ参考画像\nhttps://drive.google.com/file/d/1MXNTZCpUL9XTLRG65uYCVmcUSXaOkgN1/view", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toy094/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1009265, "client_id": 17413, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8700096e/uploads/origins/d77bed6c-95ca-4bfb-b19d-ac4f2e07d1e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ffc73d48f8ed3364d5d8a00f32451b8a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8700096e/uploads/origins/d77bed6c-95ca-4bfb-b19d-ac4f2e07d1e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1275361ad3963cb36c2c1fcc26404a09", "src_set": ""}, "body": "毎回素敵な作品をありがとうございます。\n最初に描いて頂いた二人をまたお願いしてもよろしいでしょうか？\nhttps://skeb.jp/@toy094/works/1\n全てお任せしますのでTTwoWar様の好きなシーンやシチュエーションを盛り込んで自由に楽しくやりたい放題描いてくだされば幸いです。\nそれではよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1lD8XXzaBpgjj1qWcy1RS6XIaslv9FXYA", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toy094/works/9", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/39adf6db/uploads/origins/9f7dbf9b-aaf7-4dca-b726-72b8121f1eef?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=667776762b3a9c85123cf49cdcf93d7a", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 1009265, "client_id": 2256553, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 144, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@toy094/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1009265, "client_id": 187973, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/be1d65ba/uploads/origins/5e804e32-950d-47d9-b93a-229e8c224505?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57db089e1bdfa7b0299dddfe67629a81", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/be1d65ba/uploads/origins/5e804e32-950d-47d9-b93a-229e8c224505?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d524663a2f95218004cff9a2aad64977", "src_set": ""}, "body": "こんにちは！\n\nこの2人のオリジナルキャラクターのイラストを描いていただけませんか？\n\n悪魔城ドラキュラやブラッドボーンなどを彷彿とさせるような、ヴァンパイアやヴァンパイアハンターの設定で、中世のゴシックホラー風の衣装のデザインをお願いしたいです。\n(参考にした彼らの現在のモダンな衣装は無視してください。彼らの新しい衣装をデザインしてください。例：https://drive.google.com/file/d/1_TjpCDNRfuIqYSnsyzPs4NrCBCdHvF_9/view?usp=sharing\nただし、その具体例を使う必要はありません)。\n\nアロイス\n180センチ。金髪の男性。痩せ型。\n性格はおしゃべりでいたずら好き。普段の表情は満面の笑み。\n旅のヴァンパイア・ハンター。武器は伝統的な杭。\n\nゲイブ\n186cm。灰色の髪の男性。筋肉質。\n普段の表情は笑顔。不遜でカジュアルな性格だが、密かに非常に危険な人物でもある。\n吸血鬼である。\n\n敵同士です。ホラーをテーマに描いてください。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1Fbbu_xaIu2Om7r4oH4BxG5OzxqK-qHC7?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toy094/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1009265, "client_id": 2459698, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/613ce84f/uploads/origins/2e5332eb-cbec-4527-a8af-4094a34f0d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc449696fee767a09bc3dfd775829c97", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/613ce84f/uploads/origins/2e5332eb-cbec-4527-a8af-4094a34f0d09?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b716548628c02d188ad7fff0c11a1aea", "src_set": ""}, "body": "こんにちは、前回のリクエスト🙏を受け入れていただき、本当にありがとうございました！今回はこれが最後とお約束します。もし引き受けてくださるのであれば本当にありがたいですし、そうでない場合は遠慮なくキャンセルしてください(*°ω°*ฅ)\n私のもう一人のオリジナルキャラクターを描いて頂きたいのですが、黙示録の第二騎馬民族は戦争や専制政治を表し、赤い馬に乗り、巨大な剣を持ち、戦いに備えているようなイメージです。人間でも、鎧に身を包んだ狼男でも、どんなシーンでもOKです。ダーク、ゴア、ホラーの要素は強く歓迎しますが、必要ではありません。以下、キャラクター説明です。\n\"ジン \"です：茶髪のキャラクターは中年の男性賞金稼ぎで、見た目は35~45歳、身長は200cm、目は金色、肌の色は褐色、体型は筋肉質で、鼻に傷跡がある。彼は精神的に不安定で、アルコール依存症で、怒りの問題を抱えている。時々、狼男に変身する自分をコントロールできず、死傷者を出してしまう。\n\nhttps://drive.google.com/drive/folders/1rIHdPC657OqLJ9C7IJ1G0QU1eSqlrm34?usp=share_link", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toy094/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1009265, "client_id": 2459698, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/002850cf/uploads/origins/af63c877-2c62-4162-9c5b-ea68cd5fbeaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20aa97d33a0509da222fbe774536fec6", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/002850cf/uploads/origins/af63c877-2c62-4162-9c5b-ea68cd5fbeaf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=76599473564eaef5fed92b693bad1cf4", "src_set": ""}, "body": "こんにちは、またまたはじめまして！一度に複数のリクエストを送ってしまい申し訳ありません、もし引き受けてくださるならとても嬉しいです。\nもう一人のオリジナルキャラクターを描いて頂きたいのですが、黙示録の最初の馬女は、征服と勝利を象徴し、白馬に乗り、弓を持ち、勝利の王冠を被っています。他のアイテムを持っていたり、どんなコスチュームを着ていてもOKです。前回同様、詳細は全てお任せしますので、コンセプトの通り、好きなように描いてください！ダーク、ゴア、ホラー、不吉な要素は大歓迎ですが、必要ではありません。以下、キャラクターの説明です。\n\"ブルボン \"です：白いカールの髪のキャラクターは、若いヴァンパイアの少女で、機械工です。身長155cm、見た目は12~15歳、赤い目、薄い肌の色、かわいい小さな牙、右足は義足、明るいけど無鉄砲、おてんば娘と小悪魔が混ざったような女の子です。\n\nhttps://drive.google.com/drive/folders/191n8LnDMEKOQgJWDE_c4grfmL8Aoc8Nr?usp=share_link", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toy094/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1009265, "client_id": 2459698, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3e299f84/uploads/origins/d0d104f1-88e5-40cf-85c6-785171c23354?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d787a6ccd10483d36a99b729747c718", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3e299f84/uploads/origins/d0d104f1-88e5-40cf-85c6-785171c23354?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cb9ed3180f1c4b51815a6b3d1031fb8d", "src_set": ""}, "body": "こんにちは、改めまして（笑）よろしくお願いします！この度、私のオリジナルキャラクター「黙示録の第三騎馬隊」を描いて頂きたく、お願い致します。また、病気や飢餓を表すアイテムを持ち、中世の衣装を身に着けている姿も描いてください。前回同様、細部はお任せしますので、コンセプトに沿って、好きなように描いてください！海獣、昆虫、植物などのグロテスクな要素も歓迎しますが、必須ではありません。以下、キャラクターの説明です。\n\"キニーネ\"：紫色のポニーテールの髪のキャラクターは、女性からノンバイナリーで、魔法薬学教授です。175cm、25～30歳、紫色の瞳、淡い肌色、顎にほくろがあり、性別はなく、知的だが怠け者で、感情的には他人と関わらない。趣味はお茶を飲むこと、生き物を生体解剖や実験して標本にすること。\n\nhttps://drive.google.com/drive/folders/11zrMLYesINKLAuutDWxBiAj9YEHMM6Du?usp=share_link", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toy094/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1009265, "client_id": 2459698, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/db896d82/uploads/origins/db98f3a2-526d-4f57-bb56-ea72ea3337c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5de1318cab65787c29cf871e7bc2a34", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/db896d82/uploads/origins/db98f3a2-526d-4f57-bb56-ea72ea3337c9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6f2dbb54d737a773a5ce1d0d996deff5", "src_set": ""}, "body": "こんにちは、はじめまして。あなたの作品に出会い、特に中世やダークなテーマを含む作品、そしてこの美しい鎧がとても気に入りました！今回お願いしたいのは、私のオリジナルキャラクターで、大鎌を持った「死を象徴する黙示録の第四の騎手」を描いてほしいです。骸骨のモンスターでも、人間でも、鎧を着たり、どんなコスチュームでもかまいません。細部はお任せしますので、コンセプトの範囲内で好きなように描いてください！ダーク、ゴア、ホラー、不吉な要素は強く歓迎しますが、必要ではありません。量が足りない場合は、遠慮なく再送をお願いします＾＾。\n以下、キャラクターの説明と参考画像です。\n\"アンゴスチュラ \"です：黒髪のストレートヘアーのキャラクターで、アンデッドの司祭兼外科医です。身長190+cm、見た目は30~40歳、黒い瞳、アイボリーの肌色、皺がある。見た目は親しみやすく温厚そうだが、威圧的で道徳心が全くない。\n\nhttps://drive.google.com/drive/folders/1BUBgSXUcMOnn7SWFVjtUQyYM3WQDX6Ip?usp=sharing", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toy094/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1009265, "client_id": 17413, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fba4984e/uploads/origins/a18b86bf-87f0-49e3-a54c-f6bbcb75291d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7dcca9ffc21c9fa09503ebbf55dd2b09", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fba4984e/uploads/origins/a18b86bf-87f0-49e3-a54c-f6bbcb75291d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fcbf296b201e232867b93bc839432e86", "src_set": ""}, "body": "前回は物凄い作品をありがとうございました。\n立て続けになってしまいますが、また素敵な作品を拝見させて頂きたくお願いする次第です。\n今回は別のうちの子、山羊騎士のクロドバルド(設定等は資料参考)をお願いできますでしょうか？\n\n彼が駆け出しの兵士の頃、いま腰に佩く三振りの剣が一つ『黒の大剣』を封じた祭壇を偶然見つける。\nそれを己が物とする為に同じ隊の仲間の口を封じた時の光景を以前pixivで描かれていた「裏切り者の騎士」を彷彿とさせるブラッド&ダークな描写でお願いします。\n服装は設定よりも昔の姿という事でバイザー付きグレートヘルムに全身鎖帷子、その上にタバードという11〜13世紀っぽい鎧の組み合わせでお願いします。\n(TT様の好みで自由に変更してください)\n\n前回と同じくシチュや構図、ポーズ、背景など一切合切の判断、解釈は全てお任せしますのでキャラも描きやすい様に自由に変更して描いてください。\nまたTTwoWar様の好きを詰め込んで自由に楽しく描いていただければ嬉しいです。\n今回も兜を被った姿とバイザーを上げた両方の姿が見てみたいので兜有無しと面頬差分をpsdファイルで選択できる様にして頂ければ嬉しいです。\nそれではよろしくお願いします！\n\n設定\n山羊騎士クロドバルド\n熟年の山羊獣人でマーコールに似たねじ曲がったツノと首回りの立派な顎髭が特徴。\n人と獣人が共に暮らす雪深い北方の城郭都市の守備隊長、軍務における現場トップ。\n獣人としては稀な位持ちであり城郭都市の領主から騎士に封ぜられている。\n冬と共に食糧と奴隷、財と寝床を求め襲来してくる妖魔から城砦を守り抜くため前線で指揮を取る。\n\n三剣設定(作品に反映する必要はありません)\n黒の大剣　Laviini(ラヴィーニ 雪崩の意)\n柄と鞘が金と黒曜石に似た光沢を示す黒い金属で拵えられた大剣。\n厳しい地で生きる山羊一族に古くから崇められた山岳信仰で主神を司る剣とされる。\n手にした者は力と栄光を得るが引き換えに大地に破滅をもたらすとされ\n古くからこの地に住まう鹿の一族によって山にある隠された祭壇に封印されていた。\nいつ、どこで作られ誰が持ち込んだ物なのかなど全ての由来は不明。\n\nhttps://drive.google.com/drive/folders/1yTBFdfjebFruVNPAy1Dq15aSBM5IakOO", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toy094/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1009265, "client_id": 187493, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a336725/uploads/origins/abcc8759-2c92-4939-b57a-52fa8b2cad3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=13544070d13fa779fd6eefa66b11084e", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a336725/uploads/origins/abcc8759-2c92-4939-b57a-52fa8b2cad3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8522ffc8eb10ab4014a9722b48b99edf", "src_set": ""}, "body": "こんにちは、よろしくお願いします。\n\n私のオリジナルキャラクター、ローハンのイラストをお願いしたいのですが。\nローハンは黒豹をテーマとしたアラビアン・イングリッシュの騎士です。ローハンは中世をテーマにしたクトゥルフ神話TRPG（CoC）の舞台でモンスターと戦います。\n彼を装甲服のどれかを着て描いてください。もしあなたが望むなら、彼のデザインに合わせてヘルメットをデザインすることも問題ありませんが、それはオプションです。\n\n構図は先生の判断に委ねたいと思います。もし、構図の提案を希望されるのであれば、露伴がラブクラフト系の怪物や自分で考えたファンタジー系の怪物と戦ってくれるとうれしいです。\n\nいずれにせよ、このリクエストを読んでいただき、本当にありがとうございました。\n\nhttps://drive.google.com/drive/folders/1TGmCeVo2LfFQfd3EeD2QWQZ2N3GKlE40?usp=share_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@toy094/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1009265, "client_id": 17413, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/04ad96cf/uploads/origins/e4470fb5-5346-4189-9baa-50a11baf2d6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f87c765096e4f0060ebf9a820e428dc3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/04ad96cf/uploads/origins/e4470fb5-5346-4189-9baa-50a11baf2d6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=494400536c23d78aa772fbdb47566cfc", "src_set": ""}, "body": "初めまして！\n獣頭人身、いわゆる獣人や龍人の騎士を描いていただくことはできますでしょうか？\n可能であれば人間と獣人、妖魔と呼ばれる亜人種が共存するファンタジー世界に生きるうちの子(資料参考)の甲冑姿をTTwoWar様の絵柄と世界観でお願いします。\nシチュエーションや構図、ポーズ、背景など一切合切の判断、解釈は全てお任せしますので自由に書いてください。\nキャラクターデザインも描きやすい様に自由に変更してください\n武装や甲冑の種類、時代、デザインなども全てお任せします。\nTTwoWar様の好きを詰め込んで自由に楽しく描いていただければ嬉しいです。\n角のある兜、尻尾部分は似合う様にアレンジしていただければ有難いです。\nあと兜を被った姿と素顔の両方の姿が見てみたいので兜有無しと面頬差分をpsdファイルで選択できる様にして納品して頂ければ嬉しいです。\nそれではよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1lD8XXzaBpgjj1qWcy1RS6XIaslv9FXYA", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 40538, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "いとひろ/itohiro", "screen_name": "itohiro0305", "avatar_url": "https://pbs.twimg.com/profile_images/1737472530712035328/y2YQxPhS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1657438687/1703080708/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 17}, {"id": 57400, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "NioN", "screen_name": "N_ioNion", "avatar_url": "https://pbs.twimg.com/profile_images/2919426990/30cf5b5fe277003025e4259a4849b8ca.jpeg", "header_url": "https://pbs.twimg.com/profile_banners/982891914/1575029150/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"