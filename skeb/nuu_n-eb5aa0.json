200&s=d04e4588f7ebac790ff668f49ad62e56", "srcset": "https://si.imgix.net/1ea6e9c5/uploads/origins/5bf97d4e-9f95-47b8-9be8-1ea79560177c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d04e4588f7ebac790ff668f49ad62e56, https://si.imgix.net/1ea6e9c5/uploads/origins/5bf97d4e-9f95-47b8-9be8-1ea79560177c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=22d367eeb90b5d0fb8826e4b23b7d0f2 2x, https://si.imgix.net/1ea6e9c5/uploads/origins/5bf97d4e-9f95-47b8-9be8-1ea79560177c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=086ee71e94b79a60d8a2f7afa496582a 3x"}, "body": "はじめまして！\nくまのすけと申します。\n\nゐぬ先生が描かれる、やわらかな可愛らしいイラストがとっても好きなのでリクエストさせていただきます！\n\nオオカミっ子のoc、鎌吉玖夜ちゃんを描いていただきたいです！\n\n構図やポーズはご自由に、衣装ももしよろしければ自由に見繕っていただければと思います。\n\n何卒よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1-1wZ383pXXRFqQ02OFX-NLGPlQNypLMO", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nuu_n/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 733761, "client_id": 2279334, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/96815595/uploads/origins/302f76a1-6206-49e4-a78e-e39a6b16178e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9a02a3856c27d1dba73ef10631ab451", "srcset": "https://si.imgix.net/96815595/uploads/origins/302f76a1-6206-49e4-a78e-e39a6b16178e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f9a02a3856c27d1dba73ef10631ab451, https://si.imgix.net/96815595/uploads/origins/302f76a1-6206-49e4-a78e-e39a6b16178e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ca5cbfde61808a87be239b2e5a80fc28 2x, https://si.imgix.net/96815595/uploads/origins/302f76a1-6206-49e4-a78e-e39a6b16178e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fa85d8a60e522e5105513e149beade1b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96815595/uploads/origins/302f76a1-6206-49e4-a78e-e39a6b16178e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce4ed4b1651aa4c148041cb43b74372c", "srcset": "https://si.imgix.net/96815595/uploads/origins/302f76a1-6206-49e4-a78e-e39a6b16178e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ce4ed4b1651aa4c148041cb43b74372c, https://si.imgix.net/96815595/uploads/origins/302f76a1-6206-49e4-a78e-e39a6b16178e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=65dcda689dea9e063fda36dc3bcdcd75 2x, https://si.imgix.net/96815595/uploads/origins/302f76a1-6206-49e4-a78e-e39a6b16178e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a3d15b7b8de00f7a18fae6dfea12174e 3x"}, "body": "ゐぬさんこんにちは🐾まなむと申します🌷\n\nいつもTwitterでイラスト等拝見させていただいております🫶🏻\nゐぬさんのイラスト、絵柄はもちろんのこと色使いや空気感が柔らかくて優しくて、本当にだいすきで……！いつも素敵なイラストをありがとうございます🥰\n\n以前からいつかゐぬさんにうちの子を描いていただけたら、と思っていたのですが、先日こちら(https://x.com/nuu_n/status/1871864887930233185?s=46&t=H3BF3KlBx3wbGRDh0qNF_w)のツイートを見て雰囲気のかわいさ、髪型や衣装のかわいさにこころを射抜かれてしまい、うちの子も〜！と思いリクエストさせていただきました🎁💓\n\n今回はうちの子のイラストをお願いしたいのですが、髪型や衣装、小物、構図等全ておまかせでお願いしてもよろしいでしょうか……？ゐぬさんの作品がどれも本当にだいすきなので、ゐぬさんの感性、ゐぬさんのデザインで描いたうちの子がみたいです❣️\n\n【うちの子について】\nうさぎとイースターモチーフのオリジナルキャラクターです🐇🎀基本のデザインはリンクをご参照ください🔗 \n今回は元のモチーフは気にせず描いていただいて大丈夫です◎\n\n【使用用途】\n・個人鑑賞 \n・キャラクター紹介としてSNS等に掲載 \n・オリキャラの資料(ほかの方への依頼時など) \n・SNSアイコン\n\nよろしくお願いいたします🎶\n\nhttps://drive.google.com/drive/folders/1-BwcCbkdw1pktgeVgXQX0e5HJ1wyYBeg", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@nuu_n/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 733761, "client_id": 688705, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5443ba98/uplo