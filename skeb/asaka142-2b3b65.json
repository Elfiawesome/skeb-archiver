的ポスターとして大切に保管・使用させていただきますが、配信等で使用させていただく可能性もございます。\n・添付リンクに私のXプロフィール経由で艦隊情報を載せておきます。ご参考までに。\n\n初めての依頼で大変恐縮ですが、どうぞよろしくお願いいたします。\n\nhttps://x.com/yoakehakobune", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@asaka142/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/c23e5c09/uploads/origins/353635c3-7885-44fb-a87d-a041210fd698?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53fe4f9ffb2e73cc1f247d6c38ee928b", "srcset": "https://si.imgix.net/c23e5c09/uploads/origins/353635c3-7885-44fb-a87d-a041210fd698?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53fe4f9ffb2e73cc1f247d6c38ee928b, https://si.imgix.net/c23e5c09/uploads/origins/353635c3-7885-44fb-a87d-a041210fd698?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2c93759765dbe9e9a9aa1d4ace25728c 2x, https://si.imgix.net/c23e5c09/uploads/origins/353635c3-7885-44fb-a87d-a041210fd698?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=355db672abb61ca8149536d3e4d6fc77 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 802850, "client_id": 2808067, "nc": 16}, {"path": "/@asaka142/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 802850, "client_id": 2190412, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97b820cc/uploads/origins/fcd10858-111b-4bfe-ab0f-ad754ac0d23c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dfbe6264f25ac95f74a3d661a5cec907", "sr