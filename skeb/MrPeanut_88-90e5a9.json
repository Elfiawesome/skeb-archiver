to=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6c949ba2b78572523bc4320959968eae 3x"}, "body": "はじめて依頼をさせていただきます。\n\nバーチャルアイドルユニットSNOSの\n杜若ぽあん様を描いていただきたいです。\nhttps://twitter.com/snos_poan/status/1509523788618428417\n\n制服姿(夏用でも冬用でも)で、制服がはだけていて、何かに怒っているようなツンデレなぽあん様を描いてほしいです。\n夏用であれば詳細は先生にお任せします。\n\nもし可能であればTwitterに納品報告してくださる時に#ぽあぽあーと　を付けてくださるとぽあん様もとても喜ぶと思います。\n私もTwitterで見れるのはかなり嬉しいです。\nイラストの使用許可はぽあん様も可能にしていただきたく存じます。(ツイッターやYouTubeサムネのみ)\n\n先生のイラストを楽しみにお待ちしております。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MrPeanut_88/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 372707, "client_id": 23911, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/47698f53/uploads/origins/b2873653-fe9b-4e04-b4ae-7293033a89cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58d6a58b8533f783d9dd605bda492306", "srcset": "https://si.imgix.net/47698f53/uploads/origins/b2873653-fe9b-4e04-b4ae-7293033a89cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=58d6a58b8533f783d9dd605bda492306, https://si.imgix.net/47698f53/uploads/origins/b2873653-fe9b-4e04-b4ae-7293033a89cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5099494a2c3db8786a69d05aa8c99510 2x, https://si.imgix.net/47698f53/uploads/origins/b2873653-fe9b-4e04-b4ae-7293033a89cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8d8c95e8552778f0bd85013aee9a9976 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/47698f53/uploads/origins/b2873653-fe9b-4e04-b4ae-7293033a89cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78c0acb20112f99164012a6bef7d1244", "srcset": "https://si.imgix.net/47698f53/uploads/origins/b2873653-fe9b-4e04-b4ae-7293033a89cc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=78c0acb20112f99164012a6bef7d1244, https://si.imgix.net/47698f53/uploads/origins/b2873653-fe9b-4e04-b4ae-7293033a89cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=457634e6542f0441484a1b6ac220c5fc 2x, https://si.imgix.net/47698f53/uploads/origins/b2873653-fe9b-4e04-b4ae-7293033a89cc?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a3628c95cdce8bbcda8bff6e32f3cf3f 3x"}, "body": "リクエスト失礼します。\n\nキャラ：おいろけの術状態の巨乳浜口あやめちゃん（https://twitter.com/MrPeanut_88/status/1255081539139854337?s=20）\n\nシチュ\n・構図は正面から。\n・立ち腕上げ拘束され、えっちなヒトデが乳首に張り付き（片方の乳首は忍装の下に潜り込んで張り付き、もう片方は忍装が横にずれた状態で張り付き）内側の触手で乳首責めと乳吸いを激しくされて、めちゃくちゃに感じている。\n・コリコリや吸い付き音などの擬音\n・別コマで裏側の触手で乳首責めするヒトデ内部の描写があると嬉しいです。\n・股間の責めとアヘ顔は無しでお願いします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@MrPeanut_88/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 372707, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4ad761ab/uploads/origins/1757682b-d7b0-4db0-b16d-bd1239fa9324?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=008807c20ab5d9347663d7d82b2fa94b", "srcset": "https://si.imgix.net/4ad761ab/uploads/origins/1757682b-d7b0-4db0-b16d-bd1239fa9324?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=008807c20ab5d9347663d7d82b2fa94b, https://si.imgix.net/4ad761ab/uploads/origins/1757682b-d7b0-4db0-b16d-bd1239fa9324?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=482a6ed04873c5ed8f5e314e171f5ec4 2x, https://si.imgix.net/4ad761ab/uploads/origins/1757682b-d7b0-4db0-b16d-bd1239fa9324?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=352271b952490fb334cc0a8587970f5e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src":