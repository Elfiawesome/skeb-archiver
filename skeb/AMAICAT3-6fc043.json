かいですが…首の方は結び目1つ、三角巾の端が2つ、肘の方は結び目1つ、三角巾の端が1つ、という違いがあります)\n　‐右腕が画面に入るような構図でお願いします\n・ほっぺたに絆創膏１枚\n・ケガをしてても暗くならず、以下のような照れている表情\n　‐片目ウィンク、ペロっと舌を出している、いわゆるてへぺろな表情\n\n包帯に萌えるのと、それでも可愛く元気な姿に萌えるのが個人的なポイントです。\n\nhttps://www.youtube.com/watch?v=iLDkTBdxs4w", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@AMAICAT3/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/28286432/uploads/origins/c5277b58-0966-47ea-a0dc-6a5757480c18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37297e8b6ed640926c718d47b9f62fd0", "srcset": "https://si.imgix.net/28286432/uploads/origins/c5277b58-0966-47ea-a0dc-6a5757480c18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=37297e8b6ed640926c718d47b9f62fd0, https://si.imgix.net/28286432/uploads/origins/c5277b58-0966-47ea-a0dc-6a5757480c18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6e98de0a90db350f145127ae5fe4ab2d 2x, https://si.imgix.net/28286432/uploads/origins/c5277b58-0966-47ea-a0dc-6a5757480c18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=031f64dbf8cc3b304a06ebe0c68bf781 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3482808, "nc": 0}, {"path": "/@AMAICAT3/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3482808, "client_id": 3372529, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4bfb87f/uploads/origins/b81e83a0-0f47-4663-9dd5-9cb1682f2652?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=c