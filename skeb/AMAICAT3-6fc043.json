色と薄紫がうっすら入った白色のハイライトが立ち絵のように入っています♡\n目はタレ目気味で、睫毛は多め 眉毛と目は距離があり明るい性格なんだな とわかるような上がり具合です🎪🎼\n右目と口元に1つずつほくろを書いています♩また、ナチュラルメイクをしている子なので目の周りにうっすらピンクのアイメイクとほんのり朱色のチーク、唇にもピンク系のリップを塗っていますが、唇の方は今回は描写無しでアイメイクとチークのみうっすら描写していただけますとうれしいです♡\nまた、爪には長めのネイルチップ(資料と同じもの)をしていますが、こちらは簡略化(パーツや柄無しの無地)していただいても構いません🎶\n口は若干猫口気味です♡耳には特にピアスなどはしておりません‪‪ᴗ ̫ ᴗ♡\n色白で肩幅は狭めです✧*｡\n\n以上です𖤐*̩̩͙⸝⋆金額が不相応だったり資料不足等あれば再送していただいて大丈夫です🍓♡御検討よろしくお願いいたします⸝⸝U  ̫ U⸝⸝ฅ ☆\n\nhttps://drive.google.com/drive/folders/1-IJRd6cuvg_wUA3gUw9RY3-S4l51SiDR", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 1148490, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "Milk", "screen_name": "yurufuwa_milk7", "avatar_url": "https://pbs.twimg.com/profile_images/1632301016229244928/L4Fl4kB1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/132964805/1746353195/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 45, "skills": [{"genre": "art"}], "nc": 32}, {"id": 3060786, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "もるも。", "screen_name": "MORUMO_39", "avatar_url": "https://pbs.twimg.com/profile_images/2043851859069415429/i-Pa-vxI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1742604601185153024/1744378400/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "complete_expiration_days": 50, "skills": [{"genre": "art"}], "nc": 32}, {"id": 3574582, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ちゃこ🍵chaco", "screen_name": "c0cha0", "avatar_url": "https://pbs.twimg.com/profile_images/2014332904701132800/-a0SX53f.jpg", "header_url":