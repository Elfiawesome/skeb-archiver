トに書いてあること全部やってやるけど最初はキスからにしてくれと返し、一瞬虚を突かれるもすぐさま破顔した不知火に押し倒されとかそういうイメージで。不知火の身体が隠れて見えないのは嫌なので、司令は半透明のシルエットや省略で。\n不知火ばかりで恐縮ですがご検討のほどよろしくお願いいたします", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@duppattya/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 382853, "client_id": 461653, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/201764f1/uploads/origins/564cec5f-da75-479b-b31f-87623d0160c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb64ca2aa5a8faed1a5bffb7e2a4042c", "srcset": "https://si.imgix.net/201764f1/uploads/origins/564cec5f-da75-479b-b31f-87623d0160c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb64ca2aa5a8faed1a5bffb7e2a4042c, https://si.imgix.net/201764f1/uploads/origins/564cec5f-da75-479b-b31f-87623d0160c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5d6fbad31ede15d4ad83a933f27246a 2x, https://si.imgix.net/201764f1/uploads/origins/564cec5f-da75-479b-b31f-87623d0160c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=afc98239d3244f7c69d539801c54add2 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/201764f1/uploads/origins/564cec5f-da75-479b-b31f-87623d0160c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de7f1c7038e010e4400e793bfa079f50", "srcset": "https://si.imgix.net/201764f1/uploads/origins/564cec5f-da75-479b-b31f-87623d0160c6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=de7f1c7038e010e4400e793bfa079f50, https://si.imgix.net/201764f1/uploads/origins/564cec5f-da75-479b-b31f-87623d0160c6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cdc48a315abca8b11c08660328192335 2x, https://si.imgix.net/201764f1/uploads/origins/564