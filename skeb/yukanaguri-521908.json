9f64b74e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=12663f9e1078dba2bd610d62e584b496 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac9ce5f4/uploads/origins/a1b63a5c-12ba-4bae-842a-1049f64b74e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75472f26cbb27098beb26019dc180bf5", "srcset": "https://si.imgix.net/ac9ce5f4/uploads/origins/a1b63a5c-12ba-4bae-842a-1049f64b74e6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=75472f26cbb27098beb26019dc180bf5, https://si.imgix.net/ac9ce5f4/uploads/origins/a1b63a5c-12ba-4bae-842a-1049f64b74e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d283046d8d95c6932d8e77f1acb232b0 2x, https://si.imgix.net/ac9ce5f4/uploads/origins/a1b63a5c-12ba-4bae-842a-1049f64b74e6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3585b0829a0936b45d8f7d346213a3cf 3x"}, "body": "はじめまして。\n\n先生の光公イラストがとても好きで、リクエストさせて頂きたいです。\n\nよろしければ、うちの子描いて頂けますか？\n\n》シーグ：https://sta.sh/21rbjiyh9k6b\n服：https://sta.sh/0ewgdcg17g7\n（パジャマ姿でもいいです）\n病弱ですが、穏やかで優しい魔導士。マサルのことを幼い頃から愛して、両思いになったのにそれが信じられなくてすごく照れてしまう。\n\n》マサル：https://sta.sh/21o8yecaejam\n服：https://sta.sh/0z0o9gf5nvk\n（パジャマ姿でもいいです：https://sta.sh/020eihiyi9hb）\n気短でワイルドな侍。シーグの前はキャラ以外に優しくなって彼をよく甘えてくれる。シーグの照れ顔がとても好きで、時々彼を焦るためにいじめる面がある。\n\n》リクエスト内容\nこういうモノクロスタイル（https://twitter.com/yukanaguri/status/1550887483180994563）でスケッチページのようなものをお願いしてもいいでしょうか（例：https://sta.sh/01z8teog233g）？\n\nラブラブな二人でスキンシップするのが特に好きです。朝ごはんを一緒に食べたり、キャンプファイアの前で話しながら抱きしめたり、傍にいることが一番幸せである彼らなので、そういうほのぼのな日常を過ごしている二人をお願いしたいです。\n\nもし金額や内容などが合わないなら、キャンセルしても構いません！\n\nリクエスト受け取って下さったら、よろしくお願い致します。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@yukanaguri/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "c