ge", "creator_acceptable_same_genre": false}, {"path": "/@pupipapopeR/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2792295, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7b7a2250/uploads/origins/c1b62fb2-d52d-4dc1-b62d-c42615aed3a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f34c8b92e673eecb08330df7c00dcae", "srcset": "https://si.imgix.net/7b7a2250/uploads/origins/c1b62fb2-d52d-4dc1-b62d-c42615aed3a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6f34c8b92e673eecb08330df7c00dcae, https://si.imgix.net/7b7a2250/uploads/origins/c1b62fb2-d52d-4dc1-b62d-c42615aed3a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e964a8ac4ee00a5f27c359052599b7b2 2x, https://si.imgix.net/7b7a2250/uploads/origins/c1b62fb2-d52d-4dc1-b62d-c42615aed3a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7bceb81408bab48227a2b69b2e679216 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b7a2250/uploads/origins/c1b62fb2-d52d-4dc1-b62d-c42615aed3a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26d5195e260b1851acb2c6e57bcdf63d", "srcset": "https://si.imgix.net/7b7a2250/uploads/origins/c1b62fb2-d52d-4dc1-b62d-c42615aed3a8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26d5195e260b1851acb2c6e57bcdf63d, https://si.imgix.net/7b7a2250/uploads/origins/c1b62fb2-d52d-4dc1-b62d-c42615aed3a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c907678c33d0eee33014192c42eefa22 2x, https://si.imgix.net/7b7a2250/uploads/origins/c1b62fb2-d52d-4dc1-b62d-c42615aed3a8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1258e6c2920a1927d02d4d570ff5c4d8 3x"}, "body": "はじめまして\nトワツガイというソシャゲキャラのフラミンゴがレイプされているイラストをお願いします\n・フラミンゴは服を着たまま。ただしブラジャーのフロントホックが外されて胸が丸出し、左胸は上、右胸は下と、両胸別々に跳ね回ってる。乳首は必ず描き、乳管口も描写してください。乳首はあまり長くしないでください。胸の大きさは資料準拠で。\n・体位は正常位。中出ししながら精液を腟内にすり込むようにピストンを続けています。その正常位を中心に周りに「パイズリでぶっかけ」「イラマチオで口腔内射精」「両乳首を吸われている」「谷間に顔を埋められおっぱいを舐め回されている」「フラミンゴは激痛しか感じていない手マン」などの様子を描いていただきたいです。\n・正常位は「レズが！孕め！おっさんの子供を孕め！」「レズの腟内(なか)良すぎてザーメン止まんねえ！」「すりんこんでやるよ！」、パイズリは「でか乳はこうやってチンコ挟むためにあるんだよ！！」、乳首吸いには「うめえ！レズのおっぱいはうめえ！」、イラマチオは「おら、汚いチンポ綺麗にしてくれよ」、谷間舐めまわしは「涎テカテカで汚ねえw」、手マンは「ほら！ほら！気持ちいいって言えや！」などの男のセリフを。どのシチュエーションでもフラミンゴは苦痛、恐怖、絶望のみの拒絶や拒否の台詞、呻き声などを上げさせてください。同じ内容なら細かい台詞の修正や改変可です。\n・暴力性を強調するためピストンや中出しなどの擬音は大袈裟すぎるくらい強調し、またハートマークなど快感を連想させるものは使わないでください。\n・可能な限り乳首はどのシチュエーションも描いてください。\n以上です。よろしくお願いします。\n\nhttps://twitter.com/towatsugai/status/1595975569677623297\n\nhttps://towatsugai.wikiru.jp/?%E3%83%95%E3%83%A9%E3%83%9F%E3%83%B3%E3%82%B4", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@pupipapopeR/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2792295, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb916847/uploads/origins/646bae06-f84b-448e-a030-b0f32607a5cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fbd0e9f34dd8b7878a674d89ce63cae", "srcset": "https://si.imgix.net/eb916847/uploads/origins/646bae06-f84b-448e-a030-b0f32607a5cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3fbd0e9f34dd8b7878a674d89ce63cae, https://si.imgix.net/eb916847/uploads/origins/646bae06-f84b-448e-a030-b0f32607a5cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=93d1f4937a54604815855acd28519010 2x, https://si.imgix.net/eb916847/uploads/origins/646bae06-f84b-448e-a030-b0f32607a5cd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=44975f6987fd7ad6b5f3f2ac0285bdbe 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://s