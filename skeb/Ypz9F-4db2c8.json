す。また女の子の髪型のみ少しアレンジして頂けると嬉しいです。\nお手数お掛け致しますが不備がありましたら再送を送信してくださると大変助かります。 \n是非御検討して下さると幸いです。\n\nhttps://drive.google.com/drive/folders/11C8MLc5Q5zieWXHyjW7aQDhtkeMq0CQK", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ypz9F/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e4b72cd7/uploads/origins/20475791-e9dc-4fc7-8b9e-7703352bf467?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e95371879a11640b8ee0b378ba400534", "srcset": "https://si.imgix.net/e4b72cd7/uploads/origins/20475791-e9dc-4fc7-8b9e-7703352bf467?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e95371879a11640b8ee0b378ba400534, https://si.imgix.net/e4b72cd7/uploads/origins/20475791-e9dc-4fc7-8b9e-7703352bf467?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=71cf1691d634538ad0c9c00de1523d2c 2x, https://si.imgix.net/e4b72cd7/uploads/origins/20475791-e9dc-4fc7-8b9e-7703352bf467?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a11f1af37a495a865b49dbacb05a03a6 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1780035, "client_id": 3530401, "nc": 17}, {"path": "/@Ypz9F/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/328c0fd2/uploads/origins/ad670fc4-72fd-46b0-b377-f51d1acb81e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=91af9db5ed95c558ccd9e1d2c59d9001", "srcset": "https://si.imgix.net/328c0fd2/uploads