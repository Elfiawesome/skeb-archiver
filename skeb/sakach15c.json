.net/b531fdd7/requests/249165_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c9ef8b0f70f057dd0fd40c8318a05dd2", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b531fdd7/requests/249165_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6b3c3d569391a3e95efb7ab17d03beae", "src_set": ""}, "body": "ジャンク品きりたんがとても好きでリクエストしました。\n\nジャンク品きりたんと同じ世界観で誘拐された紲星あかりが爆乳ふたなりにされ改造。\n四肢を取られハンティングトロフィーの様に壁に飾られて1時間ごとに絶頂拷問が自動的に行われて下品な喘ぎ声を発するイラストをお願いします。\nもしよろしければ元のマスターに助けを求めて泣き叫ぶ姿と内部データまでいじられて今のご主人様に媚びる姿もお願いします。", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakach15c/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 17830, "client_id": 116390, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ff5d062c/requests/175933_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2f89d160194847e9b6238a50a6cc012c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ff5d062c/requests/175933_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=86beb43793b2cbf5f18e6a064971fde5", "src_set": ""}, "body": "東北きりたん型ボイスロイドが生産されていく中で品質を確認するために無作為に選ばれたかわいそうなきりたんが耐久試験を受けている様子をお願いします。\n一糸纏わぬ姿で手足を拘束されて機械で寸止めされたり電流が流れたりする状態が「長時間」続いています。耐久試験なので一定時間が経つまでどうなっても止まらないしきっと数時間で終わるほど生易しいものでもない気がします。よろしくお願いします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sakach15c/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 17830, "client_id": 116390, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2fb226ed/requests/93010_1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w