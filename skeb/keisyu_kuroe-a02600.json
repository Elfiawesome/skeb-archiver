w=200&h=200&blur=200&s=12a4515a34f4691a3490828ed80a199d, https://si.imgix.net/97a53dcb/uploads/origins/6c8c7ffa-1a35-483b-b0e6-2f28ec0a0102?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=059ae8007d81fac0265585bdd6cc2769 2x, https://si.imgix.net/97a53dcb/uploads/origins/6c8c7ffa-1a35-483b-b0e6-2f28ec0a0102?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ab8458a69c9ae63305bb4fcec7af3ddc 3x"}, "body": "はじめまして、こんにちは！貴方の絵がだいすきです！\nこのOC2人のイラストをお願いしてもよろしいでしょうか。\n服の資料が少なくてすみません。服のアレンジはご自由にしてください。\nポーズや構図はお任せいたします。\nよろしくお願いいたします。\n\nA(金髪/男/177cm)▶魔法使い。優しい。爽やかな笑顔。\nB(黒髪/男/160cm)▶人間。シニカル、理性的な人。\n二人は森の家で一緒に暮らしている\n\nhttps://drive.google.com/drive/folders/1L3wpZROAedeAGj3jZ67RaX4QgXjVpq5_?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@keisyu_kuroe/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2451546, "client_id": 300885, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8013fbe6/uploads/origins/42ed5bc7-3d97-42b3-ac6c-54987e6c1129?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86067abb9f386c51537ea998e5973170", "srcset": "https://si.imgix.net/8013fbe6/uploads/origins/42ed5bc7-3d97-42b3-ac6c-54987e6c1129?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=86067abb9f386c51537ea998e5973170, https://si.imgix.net/8013fbe6/uploads/origins/42ed5bc7-3d97-42b3-ac6c-54987e6c1129?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa17600a5c9dec06b6be442c5c08e8e8 2x, https://si.imgix.net/8013fbe6/uploads/origins/42ed5bc7-3d97-42b3-ac6c-54987e6c1129?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3be80e4998c57b5e20cd528d193d5a3a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8013fbe6/uploads/origins/42ed5bc7-3d97-42b3-ac6c-54987e6c1129?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b893df8a5aac21869a498bf4fc9fc59", "srcset": "https://si.imgix.net/8013fbe6/uploads/origins/42ed5bc7-3d97-42b3-ac6c-54987e6c1129?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1b893df8a5aac21869a498bf4fc9fc59, https://si.imgix.net/8013fbe6/uploads/origins/42ed5bc7-3d97-42b3-ac6c-54987e6c1129?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=595e1ed1b335b4836fceef4de606b1e4 2x, https://si.imgix.net/8013fbe6/uploads/origins/42ed5bc7-3d97-42b3-ac6c-54987e6c1129?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4c06944c0cf0cd329753b2caa90d93ad 3x"}, "body": "こんにちは。skebに戻ってきてくれてうれしいです!私と友達のグリークOCの写真をリクエストしてもいいでしょうか？\n\n■私のOC: https://i.imgur.com/Dota4E4.jpg\nエレガントで成熟したカリスマ的な女性。まっすぐな性格で、正義感が強い。但し、大切な人にだけは優しい一面を見せ、いじめるのが好き。とても男前で頼もしい女性です。\n- イヤリングは必ず保管してください。\n\n友人のOC（160cm）：https://imgur.com/a/HzTR4rL\n混沌の神に仕える巫女。真面目な性格。  でも、かわいいと思ったものには、ちょっとだけ元気で楽観的な一面も。\n- 赤い刺青のマークも忘れずに。\n- 太ももの赤いリボンは、身を守るお守りです。\n\nそれぞれの神様が対立しているにも関わらず、仲の良い二人。\n\nこの作品のやり方がとても好きです！https://skeb.jp/@keisyu_kuroe/works/2 なので、もし同じようなものを作っていただけたら、とても嬉しいです！(笑)  一般的にはギリシャ神話やファンタジーのような感じがいいです!\n\nキャラの髪型や服装など、着せ替えやアクセサリー、スタイリングは自由にしてください。  ファンタジーの絵がとても好きなので、私と友達のキャラの衣装もデザインしていただけるととても嬉しいです。でも、必ずしも必要ではありません。\n\nポーズ、BG、服装、全てお任せします!自由に描いてください全部お任せします！（笑\n\nよろしくお願いします", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@keisyu_kuroe/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2451546, "client_id": 1157853, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0de01898/uploads/origins/1907b840-3d2e-42c4-871a-375c68638d25?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=276d32d94ee4bf57d3d4e79c59b9d87d", "srcset"