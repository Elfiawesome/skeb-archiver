b Little Bug」のアコースティックカバー用イラスト（https://www.youtube.com/watch?v=1fwJ8H5wWCU）。\n- .psdファイルでキャラクターと背景を分けてください。\n- できれば16:9の比率で映像に使用されることが望ましい\n\n[イラストで追加する要素]を\n- アコースティックギターを弾きながらマイクで歌っているようなキャラクターを描いてほしいです。曲のテーマと合うようにしてください。\n- ポーズや衣装はお好みでどうぞ！\n- できれば、目を閉じて歌っているバージョンと、目を開けて歌っているバージョンをお願いします。\n\nこのイラストはクレジットを入れてyoutube/SNSで使用させていただきます！ありがとうございました、そして素敵な一日をお過ごしください！\n\nhttps://drive.google.com/drive/folders/15GJXoTI6UoyLyj_yOcKQTWxbPjZlqB6J?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ino_matome/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1804815, "client_id": 1528065, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3a969ca8/uploads/origins/76fa89c2-43e4-46a6-a151-d7f8d036b60e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5195ff9b0def7cbb6110a110f2adcff", "srcset": "https://si.imgix.net/3a969ca8/uploads/origins/76fa89c2-43e4-46a6-a151-d7f8d036b60e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a5195ff9b0def7cbb6110a110f2adcff, https://si.imgix.net/3a969ca8/uploads/origins/76fa89c2-43e4-46a6-a151-d7f8d036b60e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=084664613117a09ca0b6c6b049dc8bd4 2x, https://si.imgix.net/3a969ca8/uploads/origins/76fa89c2-43e4-46a6-a151-d7f8d036b60e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dd55e27941861e1f586bd7c2e8cd595d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3a969ca8/uploads/origins/76fa89c2-43e4-46a6-a151-d7f8d036b60e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0e69ac5992cefc2842bc699b3b46e390", "srcset": "https://si.imgix.net/3a969ca8/uploads/origins/76fa89c2-43e4-46a6-a151-d7f8d036b60e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=