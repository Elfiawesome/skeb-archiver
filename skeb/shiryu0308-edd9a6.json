}, {"path": "/@shiryu0308/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1385891, "client_id": 1852468, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d1938c4/uploads/origins/9e39c170-8f43-4ffd-a623-8347832d8892?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b135ae6d0cbcdd9962418b3f2c7f6b59", "srcset": "https://si.imgix.net/8d1938c4/uploads/origins/9e39c170-8f43-4ffd-a623-8347832d8892?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b135ae6d0cbcdd9962418b3f2c7f6b59, https://si.imgix.net/8d1938c4/uploads/origins/9e39c170-8f43-4ffd-a623-8347832d8892?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b60efc1789c714290b21eb90d48b4b3 2x, https://si.imgix.net/8d1938c4/uploads/origins/9e39c170-8f43-4ffd-a623-8347832d8892?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ee38de9871a0b1d56aa6a467a26f497 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d1938c4/uploads/origins/9e39c170-8f43-4ffd-a623-8347832d8892?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ad1fb3b951a969bc6a687443a8b3f70", "srcset": "https://si.imgix.net/8d1938c4/uploads/origins/9e39c170-8f43-4ffd-a623-8347832d8892?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ad1fb3b951a969bc6a687443a8b3f70, https://si.imgix.net/8d1938c4/uploads/origins/9e39c170-8f43-4ffd-a623-8347832d8892?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c51cd71c47683465133d8130dc81cdf4 2x, https://si.imgix.net/8d1938c4/uploads/origins/9e39c170-8f43-4ffd-a623-8347832d8892?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0a28e2931094e9a7e3a25295a3c8c1a6 3x"}, "body": "こんにちは、私はあなたのアートワークが本当に大好きです！あなたのデザインした人間以外の生き物はとてもクールです。もし可能であれば、私のオリジナルキャラクターのデザインをお願いしたいです。\n\n彼は不気味な非人間的な生き物で、人間の外見を模倣しています。生き物に同情はしないが、どこか素朴で可愛らしい。顔と体幹は真っ白で、口の中は黒くなっています。擬態が不完全なため、手足は滑らかで白と黒のグラデーションになっており、本来の姿と同じである。\n\n自分の「肌」に触れた生き物の生命力を一気に吸収することができ、尻尾を使った狩りを好む。彼の周りにいる生物は、最初は強化され、生命力を感じるが、すぐに滅んでしまう。狩りをしないときは、袖の下に手を隠し、無防備なふりをすることが多い。\n\n彼の「本物」を拡張して、彼の真の姿をメタ的に進化させるようなデザインはいかがでしょうか？かっこよさや怖さを感じる要素を自由に追加してください。白と黒を基調とし、虹色に輝く神秘的なエネルギーが感じられるようなデザインにしていただければと思いますが、それ以外のアイデアも歓迎します。\n\nhttps://drive.google.com/drive/folders/1i5D5W-L1PRcud0l5jSHsEatNZGZWuZIC?usp=sharing", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shiryu0308/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1385891, "client_id": 1023720, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5bfa0605/uploads/origins/a95f8c06-5fbf-49ea-b945-210876fd537b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1499b2560c685a69d94e2c8d14bde3ab", "srcset": "https://si.imgix.net/5bfa0605/uploads/origins/a95f8c06-5fbf-49ea-b945-210876fd537b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1499b2560c685a69d94e2c8d14bde3ab, https://si.imgix.net/5bfa0605/uploads/origins/a95f8c06-5fbf-49ea-b945-210876fd537b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76cba99bb7b5a868f0f403c392d6f6d2 2x, https://si.imgix.net/5bfa0605/uploads/origins/a95f8c06-5fbf-49ea-b945-210876fd537b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dbed509df25b8b808a79a01cb721ff5f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5bfa0605/uploads/origins/a95f8c06-5fbf-49ea-b945-210876fd537b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b22b6c8178dd39c8cf0c4b1fc503902d", "srcset": "https://si.imgix.net/5bfa0605/uploads/origins/a95f8c06-5fbf-49ea-b945-210876fd537