ts. (We will of course give credit where credit is due.)\nThank you in advance for your consideration.", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Ojaga_moi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2555446, "client_id": 2018010, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f6e7cb12/uploads/origins/c0da27ed-56fa-4bce-8fc4-1c21cd4de668?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e544bbaa9a6b7571b941447358118dbc", "srcset": "https://si.imgix.net/f6e7cb12/uploads/origins/c0da27ed-56fa-4bce-8fc4-1c21cd4de668?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e544bbaa9a6b7571b941447358118dbc, https://si.imgix.net/f6e7cb12/uploads/origins/c0da27ed-56fa-4bce-8fc4-1c21cd4de668?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=10f8f922e7387273902499ada67276d5 2x, https://si.imgix.net/f6e7cb12/uploads/origins/c0da27ed-56fa-4bce-8fc4-1c21cd4de668?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a0903b226b68ab01368e2e619971e5c4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f6e7cb12/uploads/origins/c0da27ed-56fa-4bce-8fc4-1c21cd4de668?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10d5525e14a7514c0945e13e816cd71c", "srcset": "https://si.imgix.net/f6e7cb12/uploads/origins/c0da27ed-56fa-4bce-8fc4-1c21cd4de668?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=10d5525e14a7514c0945e13e816cd71c, https://si.imgix.net/f6e7cb12/uploads/origins/c0da27ed-56fa-4bce-8fc4-1c21cd4de668?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=993c1b0eb9154ba9e9e6ee8f4e148c73 2x, https://si.imgix.net/f6e7cb12/uploads/origins/c0da27ed-56fa-4bce-8fc4-1c21cd4de668?bg=