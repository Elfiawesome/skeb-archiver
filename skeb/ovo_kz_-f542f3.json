bp&fit=crop&crop=top&w=200&h=200&blur=200&s=a63c1455480b94dd8b585497a2eda7a2, https://si.imgix.net/d32ab371/uploads/origins/26705279-fe23-4d67-81e5-376045c43584?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ab4a0dc8cccdcac0b4a4fb1120bb2369 2x, https://si.imgix.net/d32ab371/uploads/origins/26705279-fe23-4d67-81e5-376045c43584?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=15eab1abf5a41288339fbdff199dd6cd 3x"}, "body": "はじめまして、VTuberのニコラ・A・シャルロットと申します。\n今回はサムネイルなどの用途のイラストをお願いしたく、ご連絡させていただきました。\n\n三面図がないため、立ち絵のみで大変申し訳ないのですが参考資料URLに入れさせていただきました。\n\n(グッズ製作・販売など直接的に金銭が発生する用途では使用いたしません)\n\nサムネイル用途で使用することが多くなると思いますので、可能であればPSD形式でいただけると嬉しいです。背景等と分けていただけると助かります。\n\nポーズ指定は特にございません。\n\nよろしければ描いていただけると嬉しいです。\n\nhttps://www.dropbox.com/scl/fi/n1cwyubbpbpigg8wvmqfm/.png?rlkey=x8ixsutpukij5zkraqoei2suc&dl=0", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ovo_kz_/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3021985, "client_id": 3306927, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d9117eb/uploads/origins/ce83e50b-f4fa-40be-acdb-8a3a42492339?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff1ec47bb14be470995bda3062837851", "srcset": "https://si.imgix.net/8d9117eb/uploads/origins/ce83e50b-f4fa-40be-acdb-8a3a42492339?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ff1ec47bb14be470995bda3062837851, https://si.imgix.net/8d9117eb/uploads/origins/ce83e50b-f4fa-40be-acdb-8a3a42492339?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8ad8f3bf6b15d52cf4a50ca72c7f131d 2x, https://si.imgix.net/8d9117eb/uploads/origins/ce83e50b-f4fa-40be-acdb-8a3a42492339?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9107c68d06b1d22efd793a3db3c4293c 3x"}, "duration": nul