3c-4a57-9b29-b6876b6e09ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f539d6943ae98934a537d1f3b85caabd", "srcset": "https://si.imgix.net/9e1b4175/uploads/origins/f68149dd-083c-4a57-9b29-b6876b6e09ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f539d6943ae98934a537d1f3b85caabd, https://si.imgix.net/9e1b4175/uploads/origins/f68149dd-083c-4a57-9b29-b6876b6e09ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d3f0557df80aad2078143cc9b9649692 2x, https://si.imgix.net/9e1b4175/uploads/origins/f68149dd-083c-4a57-9b29-b6876b6e09ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b692d722833dd743a869bd152d4ea84f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e1b4175/uploads/origins/f68149dd-083c-4a57-9b29-b6876b6e09ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0326f08e6d2d3a314236a55a55fde68", "srcset": "https://si.imgix.net/9e1b4175/uploads/origins/f68149dd-083c-4a57-9b29-b6876b6e09ae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c0326f08e6d2d3a314236a55a55fde68, https://si.imgix.net/9e1b4175/uploads/origins/f68149dd-083c-4a57-9b29-b6876b6e09ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=34f060bf65facdfb082bc3fbf226acb6 2x, https://si.imgix.net/9e1b4175/uploads/origins/f68149dd-083c-4a57-9b29-b6876b6e09ae?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b87b862a2761902afd17d513cf2c6881 3x"}, "body": "初めての依頼失礼致します。\n\n依頼内容はVtuber愛乃芽咲夜さんのファンアートになります。\nskebでのファンアート依頼については愛乃芽咲夜さんから許可を頂いております。\n\n使用用途\n・収益化済のチャンネルでの配信サムネイル\n・Xへの投稿とSNS上での使用\n・FANBOX等の壁紙配布\n・上記の内容で愛乃芽咲夜さんが使用する事を許可して頂けると助かります。\n\nデータ形式\n・PSDデータまたは、PNGデータで頂けるとありがたいです。\n・人物のみ(背景透過済)があるとありがたいです。\n\n要望\n・愛乃芽咲夜さんが宇宙猫のような顔をしているSDイラスト。\n・難しい場合は服装や髪型等も愛乃芽咲夜さんだとわかる範囲でなら変えて頂いても構い