r.com/a/AJQo7QT)は「Mei」に付き添う妖怪です。仮面を外して人間に変身することができる。ツンデレでお茶目な性格ですが、「芽衣」を慌てさせるのが一番の楽しみです。芽衣よりも身長が高いので、芽衣をからかうのが好きなのだとか。\n\nこれをTwitterに投稿する予定ですが、必ずタグ付けしますので、よろしくお願いします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yytiaoync9/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1159932, "client_id": 783698, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1d89959e/uploads/origins/aadcc333-4ba7-4a40-b613-974a0bdb5da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d8509563e5ec697a3fe98a1e5f229a4", "srcset": "https://si.imgix.net/1d89959e/uploads/origins/aadcc333-4ba7-4a40-b613-974a0bdb5da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d8509563e5ec697a3fe98a1e5f229a4, https://si.imgix.net/1d89959e/uploads/origins/aadcc333-4ba7-4a40-b613-974a0bdb5da8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c78c4adb8f905f2c55eaf546609cebec 2x, https://si.imgix.net/1d89959e/uploads/origins/aadcc333-4ba7-4a40-b613-974a0bdb5da8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73884d70b4a3abfed96b75244afa7476 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d89959e/uploads/origins/aadcc333-4ba7-4a40-b613-974a0bdb5da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c26b11d3e3354c24508cd387fc4b1a1", "srcset": "https://si.imgix.net/1d89959e/uploads/origins/aadcc333-4ba7-4a40-b613-974a0bdb5da8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3c26b11d3e3354c24508cd387fc4b1a1, https://si.imgix.net/1d89959e/uploads/origins/aadcc333-4ba7-4a40-b613-974a0bdb5da8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=64b8ec00d70c96d43ac962a5f72ce3ae 2x, https://si.imgix.net