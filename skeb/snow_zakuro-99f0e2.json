っておりましたので依頼させていただきます。\nうちの柚葉についてある程度ご存知かもしれませんが、恐縮ながら改めてキャラ概要含めて記載しておきます。\n\n・キャラ\n冬木柚葉(うちの子)\n\n・キャラ概要\n年齢:16歳(JK1)\n身長:150cm\n性格:向こう見ず、楽観的\n\n・依頼内容\n依頼内容になりますが、ゆきさんの絵の雰囲気が好みですので基本的にほぼおまかせします。ゆきさんがうちの柚葉に似合いそうだと思った服装やポーズ、構図で構いません。\nもし、おまかせが困るようでしたら、ゴスロリでぺたんと女の子座りしている柚葉でお願いします。\n\n・注意点\n手首にアクセサリーをしていますが、基本的に付けなくて大丈夫です。\n髪にインナーカラーは付いていません。基本的に黒髪で、光の具合でぼんやりと紫が見える程度です。\n髪のインテークは意識して付ける必要はありません。\n\n以上です。\nご検討の程、よろしくお願いいたします。\n\nhttps://twitter.com/kore_ha_nani/status/1615594721489072129?t=8nieiSi1_QZcrz_hpzclgw&s=19", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@snow_zakuro/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2305430, "client_id": 79045, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7f914c9b/uploads/origins/7a07912e-70d1-488b-a525-30a683794cd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f8e0a8b336bbd45dad774a5ce4cb0f9", "srcset": "https://si.imgix.net/7f914c9b/uploads/origins/7a07912e-70d1-488b-a525-30a683794cd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1f8e0a8b336bbd45dad774a5ce4cb0f9, https://si.imgix.net/7f914c9b/uploads/origins/7a07912e-70d1-488b-a525-30a683794cd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a9f837f0f9663c3973159142d5c3c9ec 2x, https://si.imgix.net/7f914c9b/uploads/origins/7a07912e-70d1-488b-a525-30a683794cd0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f7c8c42ce827a2ed3b85280684f2776 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7f914c9b/uploads/origins/7a07912e-70d1-488b-a525-30a683794cd0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1cab55d9a7611e1236da2316d2cf89c7", "srcset": "https://si.imgix.net/7f914c9b/uploads/origins/7a07912e-70d1-488b-a525-30a683794c