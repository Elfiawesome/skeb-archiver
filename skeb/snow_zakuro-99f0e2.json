fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0aa9b20e872ecd03e0ed0238b133d210 2x, https://si.imgix.net/19832df9/uploads/origins/75836541-5db6-4f0a-8c2f-dec44fb4947d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=128a06cdf5488ebf64342ad9c57f7651 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 2305430, "client_id": 3286831, "nc": 128}, {"path": "/@snow_zakuro/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2305430, "client_id": 769953, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/41b8c87e/uploads/origins/ecb734c8-b99f-423d-9b17-a8b19999e343?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3219d804a2fb14cd034c65062337d7b", "srcset": "https://si.imgix.net/41b8c87e/uploads/origins/ecb734c8-b99f-423d-9b17-a8b19999e343?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3219d804a2fb14cd034c65062337d7b, https://si.imgix.net/41b8c87e/uploads/origins/ecb734c8-b99f-423d-9b17-a8b19999e343?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f6c46598054c65b2c2f0a9e5d4bf5600 2x, https://si.imgix.net/41b8c87e/uploads/origins/ecb734c8-b99f-423d-9b17-a8b19999e343?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=77b5b24bf1d990c51767ce88e2e2f33a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/41b8c87e/uploads/origins/ecb734c8-b99f-423d-9b17-a8b19999e343?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82cb35d65983d7e6459c48bcd8de78ef", "srcset": "https://si.imgix.net/41b8c87e/uploads/origins/ecb734c8-b99f-423d-9b17-a8b19999e343?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=82cb35d65983d7e6459c48bcd8de78ef, https://si.imgix.net/41b8c87e/uploads/origins/ecb734c8-b99f-423d-9b17-a8b19999e343?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=097d1d0b95488a4414b9bb398e2d50ba 2x, https://si.imgix.net/41b8c87e/uploads/origins/ecb734c8-b99f-423d-9b17-a8b19999e343?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a3b6cedb72d32998d4eaf1b360c8bb58 3x"}, "body": "白雪ざくろ様、リクエスト失礼します。\nアピールを送って頂きありがとうございます！もしよろしければお願いしたいと思いリクエストさせて頂きます！\n\nお題はアピールで頂いた通り「ロングヘアのデュラハンの女の子」です。\n以下詳細を記しておりますので、内容ご確認の上でご検討・ご対応頂ければ幸いです。\n色んなクリエイターの方の発想力・想像力・創作力にお任せしたいので、詳細文のほとんどは他の方と同じ内容になっております。その点ご容赦くださいませ。\nご都合が合わない等ということがありましたら遠慮なくキャンセルしてください。\n\n【詳細】\n・髪の長さは頭３つ分かそれ以上の長さが好ましいです。長い髪を描くとなるとご負担がかかると思いますが宜しくお願いします。\n\n・ヘアアレンジに関しては、お団子やシニヨンなどのまとめ髪系は避けてください。\n　髪の長さが分かる状態であれば、一部分や全体を結ぶ・巻く（ウェーブやカール等）・編み込むなどのアレンジはOKです。キャラのイメージに合わせてお好みで決めてください。\n\n・服装に関してはキャラに合わせてお好みでお願いします。\n\n・首の表現に関しては\n　①肌色で塗る\n　②タートルネックのような首元が隠れる・襟のある服装や画角・構図の関係で見えなくする\n　③アクセサリーやチョーカー等による着飾り・装飾品で隠す\n　などの方法を用いたマイルドな表現をお願いします。別アイデアでも構いません。\n　ただし、性的表現や猟奇的表現・「首から炎や煙が出ている」という表現は避けてください。\n　首部分を描かれる場合は頭側と体側に半々に分かれるように描かれていると嬉しいです。\n\n・頭の持ち方・位置・扱いについては、過去に私がリクエストして描いて頂いた子たち（https://skeb.jp/@hima_ttsu）やSkebの該当キーワードの検索のURL（下記参照）を記載するので、そちらをアイデアの参考にして頂くか、「こういうのもアリでは…？」と思えばそちらでも構いません。\n\n・可能であれば描いて頂いた際の没ラフや、創作時のコンセプト・こだわりポイント等を書いて頂けると嬉しいです！\n\n・納品はPSD形式でお願いします。\n\n・ご不明点等があった際はお好みで判断して描いて下さい。\n\n長文になりましたが、内容以上になります。\nお忙しい中恐縮ですが、お時間のある時に是非ご検討くださいませ。\n\nhttps://skeb.jp/search?q=%22%E3%83%87%E3%83%A5%E3%83%A9%E3%83%8F%E3%83%B3%22&t=works&menu=1&artwork=1", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@snow_zakuro/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2305430, "client_id": 397760, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a52edac8/uploads/origins/e692a3fb-9a8f-4cb1-a6b0-b7131358381b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b45c3fc57db9b0cc051410e79533cf8", "srcset": "https://si.imgix.net/a52edac8/uploads/origins/e692a3fb-9a8f-4cb1-a6b0-b7131358381b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9b45c3fc57db9b0cc051410e79533cf8, https://si.imgix.net/a52edac8/uploads/origins/e692a3fb-9a8f-4cb1-a6b0-b7131358381b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=214b96fb185bf0f07b4f8631066612ce 2x, https://si.imgix.net/a52edac8/uploads/origins/e692a3fb-9a8f-4cb1-a6b0-b7131358381b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a383430c213cae56b4671c0d94724b06 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a52edac8/uploads/origins/e692a3fb-9a8f-4cb1-a6b0-b7131358381b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e76a16d6a7c6aaef497f4fe9e8f32ab1", "srcset": "https://si.imgix.net/a52edac8/uploads/origins/e692a3fb-9a8f-4cb1-a6b0-b7131358381b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e76a16d6a7c6aaef497f4fe9e8f32ab1, https://si.imgix.net/a52edac8/uploads/origins/e692a3fb-9a8f-4cb1-a6b0-b7131358381b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=63e90165eaf86e636afcac9d93864340 2x, https://si.imgix.net/a52edac8/uploads/origins/e692a3fb-9a8f-4cb1-a6b0-b7131358381b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=233cc8d64543c420c846cce0ca4d521f 3x"}, "body": "初めまして、この度はアピールいただきありがとうございます。先生のイラストを拝見し、とても好きな描き方だったためリクエストしたく申し上げます。\n先生にDのアトリエ様より３Dモデルキャラクター「陽だまりのアニマ」のイラストをリクエストいたします。ポーズ等については、先生にお任せいたします、ご提案いただきました構図で拝見したく存じます。何卒、ご検討のほどよろしくお願いいたします。\n\nhttps://booth.pm/ja/items/2333042\n\nhttps://booth.pm/ja/items/2333042", "nc": 145, "word_count": 0, "transcoder": "image", "creator_ac