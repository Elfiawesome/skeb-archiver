&marky=415&txt64=6pKm6pK37722776e776X6pK36pKm4oaSNjY2&txtclr=fff&txtfont64=QXZlbmlyLUJsYWNr&txtfit=max&txtalign=middle%2Ccenter&txtsize=60&txtshad=10&auto=format%2Ccompress&fit=crop&crop=top&w=1200&h=630&s=edbeb41cf60c90eadc009a819467fd4e", "skills": [{"genre": "art", "default_amount": 8000}], "payment_methods": {"credit_cards": {"jcb": {"nsfw": true}, "master_card": {"nsfw": true}, "visa": {"nsfw": true}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@666__GaLa/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 515609, "client_id": 1999047, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6bd8c31a/uploads/origins/8116f81a-6643-47c1-a73d-75b129103e67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2148eb28629a92fc23f34e70ff029a5a", "srcset": "https://si.imgix.net/6bd8c31a/uploads/origins/8116f81a-6643-47c1-a73d-75b129103e67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2148eb28629a92fc23f34e70ff029a5a, https://si.imgix.net/6bd8c31a/uploads/origins/8116f81a-6643-47c1-a73d-75b129103e67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2df1a3dd7cce06bb28b0e03722242b95 2x, https://si.imgix.net/6bd8c31a/uploads/origins/8116f81a-6643-47c1-a73d-75b129103e67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d9451d4071739aee46d4f9e6b8cdc3f0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6bd8c31a/uploads/origins/8116f81a-6643-47c1-a73d-75b129103e67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98882732a1c75fbe0b875d77a263ca1c", "srcset": "https://si.imgix.net/6bd8c31a/uploads/origins/8116f81a-6643-47c1-a73d-75b129103e67?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=98882732a1c75fbe0b875d77a263ca1c, https://si.imgix.net/6bd8c31a/uploads/origins/8116f81a-6643-47c1-a73d-75b129103e67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=40b67405d2ab1b5772c7f2384309127c 2x, https://si.imgix.net/6bd8c31a/uploads/origins/8116f81a-6643-47c1-a73d-75b129103e67?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=259fa7c3a5982509a3433514ec02e54c 3x"}, "body": "Hi Gara-sensei!\n\nAfter looking at your cool art, I decided I would like to ask you to draw an illustration of an evil robotic counterpart of my lynx character (they are genderless), inspired by the relationship between Metal Sonic and Sonic.\n\nHere are some references of my character:\nhttps://drive.google.com/file/d/1gMdinCAuLbVgAMgwUuC5rE4ymZ4HPCOA/view?usp=sharing\n\nhttps://drive.google.com/file/d/1nDRJR85zxIk2OoGC0zxD-Qb9kxzx1wJR/view?usp=sharing\n\nhttps://drive.google.com/file/d/15sca5SwGS_Gc0Zctlid3UoSLLbpPJbEr/view?usp=sharing\n\nI would like the design to be a taller, sharper, and more angular version of the original. The face should be a lynx skull–shaped faceplate (maybe with engraved occult or gothic symbols/runes), with dark eye sockets and glowing eyes. The body could have cracks in the armor, along with partially scratched-off hazard stripes. A worn serial number (“LNX-666”) should be visible (for example on one of the thighs), with the last 6 almost erased.\n\nThe arms are damaged, with the outer plating broken open so spiked metallic bones are exposed. The character should have sharp fingers and sickle-shaped metal claws on the feet. Please keep the spiked collar and add spiked bracelets. Visible cables may be placed like veins. A glowing symbol or core in the chest would look nice.\n\nA dark gothic outfit is suggested. Integrated weapons would be welcome if they fit the design.\n\nIf possible, I would love to have a full-body illustration of the character.\n\nPlease feel free to simplify or adjust any elements as needed or even add things if you think they look cool!\nThank you very much for your time and thanks for considering! ^^/\n\n\nこんにちは、Gara-sensei！\n\nあなたのとても素敵な作品を拝見して、ぜひイラストのご依頼をしたいと思いました。\n私の**オリジナルのリンクス（獣人）キャラクター（性別なし）**の、\n**Metal Sonic と Sonic の関係性をイメージした「邪悪なロボット版カウンターパート」**を描いていただけたら嬉しいです。\n\nこちらが元キャラクターの参考資料です：\nhttps://drive.google.com/file/d/1gMdinCAuLbVgAMgwUuC5rE4ymZ4HPCOA/view?usp=sharing\n\nhttps://drive.google.com/file/d/1nDRJR85zxIk2OoGC0zxD-Qb9kxzx1wJR/view?usp=sharing\n\nhttps://drive.google.com/file/d/15sca5SwGS_Gc0Zctlid3UoSLLbpPJbEr/view?usp=sharing\n\nデザインとしては、元のキャラクターよりも背が高く、鋭く、角ばったシルエットを想定しています。\n顔はリンクスの頭骨を模したフェイスプレートで、オカルト／ゴシック風の紋様やルーンの刻印が入っていても素敵だと思います。\n目の部分は暗い眼窩になっており、その奥で不気味に光る目が見えるイメージです。\n\nボディには意図的に修復されていない装甲の亀裂があり、\n半分削れた警告ストライプ（ハザードストライプ）が残っているような感じを希望しています。\nまた、「LNX-666」という摩耗したシリアルナンバー（太ももなどに配置）があり、\n最後の「6」はほとんど消えかかっている表現だと嬉しいです。\n\n腕は損傷しており、外装が破れて棘のある金属製の骨格が露出しています。\n指は鋭く、足には鎌のような形状の金属製の爪を持たせたいです。\n元のスパイク付き首輪はそのまま残し、スパイク付きのブレスレットを追加してください。\nケーブル類は血管のように配置されていると面白いと思います。\n胸部にはコアや魂を思わせる発光するシンボルがあると嬉しいです。\n\n衣装はダークなゴシック調を想定しています。\nデザインに合うようであれば、内蔵武装を加えていただいても構いません。\n\n可能であれば、キャラクターの全身が分かるフルボディイラストを希望しています。\n\n要素が多いため、簡略化や調整、またはデザインの追加などはご自由に行ってください。\nご検討いただきありがとうございます。どうぞよろしくお願いいたします！ ^^/", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@666__GaLa/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 515609, "client_id": 942313, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d9fbbe0/uploads/origins/2a748e93-e901-450a-8ec9-7d6dc5aafb19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3811ac3b9613a0090d62937f939f86c3", "srcset": "https://si.imgix.net/8d9fbbe0/uploads/origins/2a748e93-e901-450a-8ec9-7d6dc5aafb19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3811ac3b9613a0090d62937f939f86c3, https://si.imgix.net/8d9fbbe0/uploads/origins/2a748e93-e901-450a-8ec9-7d6dc5aafb19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3c7e50d2a2a89e6ffb72d267c39583d7 2x, https://si.imgix.net/8d9fbbe0/uploads/origins/2a748e93-e901-450a-8ec9-7d6dc5aafb19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=66a9be9465cf403cd17b3529410c788f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d9fbbe0/uploads/origins/2a748e93-e901-450a-8ec9-7d6dc5aafb19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=614d7b2655e50848bcfa41be7ac5c9b9", "srcset": "https://si.imgix.net/8d9fbbe0/uploads/origins/2a748e93-e901-450a-8ec9-7d6dc5aafb19?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=614d7b2655e50848bcfa41be7ac5c9b9, https://si.imgix.net/8d9fbbe0/uploads/origins/2a748e93-e901-450a-8ec9-7d6dc5aafb19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a735ade6099859c00716b8c9920a23c6 2x, https://si.imgix.net/8d9fbbe0/uploads/origins/2a748e93-e901-450a-8ec9-7d6dc5aafb19?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=95318aaa7186eb6d5d5dc03dc46a6285 3x"}, "body": "お久しぶりです、枯れ葉と申します。\nこの度我が家の企画キャラの死神ゼオの大人肉体版をリクエストさせていただきたく思います。\n雨の降る廃墟になった村のような場所で赤い大鎌(血などで赤いわけではなく素材の色が赤い金属のようなイメージです)を肩に担ぎ、試すような笑みを浮かべながら崩れた壁の一部のような所に座っている構図でお願いいたします。\nゼオは死神ではありますが人の「生」に興味を持っていて、命を奪うようなことはせず人の手助けをしたり試練を与えたりするキャラなので、出会った人間にそういった興味から接触している場面のイメージです。\n体つきは引き締まってはいるもののマッチョとは言えない程度(以前描いていただいたユキヒョウお兄さんのようなあの感じが理想です)で、腰布の隙間から脚がちら見えしていると嬉しいです。\n余談ではありますがゼオの本来の姿は「頭が犬科の骸骨、つまり犬獣人のガイコツが黒い靄を纏っていて、その靄が死神のローブのようなシルエットを作り出していて、眼窩の所に目のような赤い光点がある」というイメージなので、もし可能ならその姿のようなものを後ろあたりに描いていただけると幸いです\nご一考のほど、よろしくお願いいたします。\n\nhttps://twitter.com/KarehaGz/status/1398056251792105479?t=zmCPvOeB1mlTa8xrWBfUZA&s=19", "n