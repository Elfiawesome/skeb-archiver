らその洗練さと洒脱さによりインチキショタをやっているところはあります\n\nありていに主観的な感想をのべるとこうです\n\n少年をよそおいて壮年とあり\n騎手をよそおいてただの人\n人をよそおいて妖怪となり\n彼は耽美、いわんや衒学\n\nただ幻影(ファントム)となって夢となす\n\nしんしば/あー。俺はですねー。ジョッキーでもDjでもないですよ。うーんどうかな。まーいいんじゃないの？\n\nえっ 俺を描いてくれるの？それは嬉しいなぁ……\n\nhttps://twitter.com/unagipiesen/status/1270668273240076291", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [{"path": "/@Reala_k/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 18674, "client_id": 496550, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce3108eb/uploads/origins/f263c6d0-4fe7-4b2b-afa5-738a774c5db9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c43f121ee3f9770d80804c4364358b18", "srcset": "https://si.imgix.net/ce3108eb/uploads/origins/f263c6d0-4fe7-4b2b-afa5-738a774c5db9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c43f121ee3f9770d80804c4364358b18, https://si.imgix.net/ce3108eb/uploads/origins/f263c6d0-4fe7-4b2b-afa5-738a774c5db9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=93dec92f5ddc16ef0e53cd38a636eee7 2x, https://si.imgix.net/ce3108eb/uploads/origins/f263c6d0-4fe7-4b2b-afa5-738a774c5db9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ca0d7bdf1e8e48f5cf5f5f9bbeac23e 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce3108eb/uploads/origins/f263c6d0-4fe7-4b2b-afa5-738a774c5db9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0877bfeb184f59b9bc359bf94b596949", "srcset": "https://si.imgix.net/ce3108eb/uploads/origins/f263c6d0-4fe7-4b2b-afa5-738a774c5db9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0877bfeb184f59b9bc359bf94b596949, https://si.imgix.net/ce3108eb/uploads/origins/f263c6d0-4fe7-4b2b-afa5-738a774c5db9?bg=%23fff&auto=f