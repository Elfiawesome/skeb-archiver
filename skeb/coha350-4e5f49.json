思いますが、すいせいさんを依頼させていただきたいです。\n\n\n【服装】\n半袖、ショート丈でお臍が露わになったワンオフショルダーのトップス\n資料のようなセパレートパンツ\n\nそれぞれの服装の色はお手数ですがお任せで。\nすいせいさんの髪型は、セーラー服を着ている時のロングヘアーで。\n\n【シチュエーション・ポーズ】\n上記の服装で、ウィンクしながらギャルピースをしているすいせいさんをお願い致します。\n\n服装などがすいせいさんに似合わないなどあれば、キャンセルして頂いて構いません。\nご検討よろしくお願いいたします。\n\nhttps://item.rakuten.co.jp/bellemarvelous/27954/?iasid=07rpp_10097___eq-ly7umc10-6m-37a9cb2c-29ce-43ef-b97f-028059c26d37", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@coha350/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2521807, "client_id": 3309676, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2f811d3e/uploads/origins/1fc9b840-7636-494f-bff1-18ba00a53146?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04e3877c79b0ab5c29b44cfb1c4dd3ab", "srcset": "https://si.imgix.net/2f811d3e/uploads/origins/1fc9b840-7636-494f-bff1-18ba00a53146?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=04e3877c79b0ab5c29b44cfb1c4dd3ab, https://si.imgix.net/2f811d3e/uploads/origins/1fc9b840-7636-494f-bff1-18ba00a53146?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4feac41942ef756ed48a81f712dcba58 2x, https://si.imgix.net/2f811d3e/uploads/origins/1fc9b840-7636-494f-bff1-18ba00a53146?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f1a45a0e35ce8bc9df0f7ed090a87358 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2f811d3e/uploads/origins/1fc9b840-7636-494f-bff1-18ba00a53146?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e637b901a3b5a7f626b8b1b6843c574c", "srcset": "https://si.imgix.net/2f811d3e/uploads/origins/1fc9b840-7636-494f-bff1-18ba00a53146?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e637b901a3b5a7f626b8b1b6843c574c, https: