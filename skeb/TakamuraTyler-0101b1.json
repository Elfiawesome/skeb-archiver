s/1726942786308690173?t=qfyyiOy5OHcYp6k3q0mMqA&s=19\n\n【漫画の希望シチュエーション】\n・「ハワイのようなどこかオシャレな海外の海辺で2人が楽しく1日水着でデートする」\n海辺と指定しましたが、あくまでイメージで、海辺の近くの露店や水中等、ご自由に描いて欲しいです。\n\n【水着のデザインについて】\n・2人の水着のデザインは、「真理子は巨乳かつおへそが横に割れる程度のむちむち体型」「要は鍛えているのでそれなりに筋肉がある体型」ということを前提に、全てタカムラさんにお任せします。ご自由にお描き下さい。\n\n色々と指定しましたが、私も私のフォロワーもタカムラさんの事が好きなのでどんな漫画でも嬉しいです！\n宜しくお願いします。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@TakamuraTyler/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1983868, "client_id": 2227281, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f9402a16/uploads/origins/02e9ee54-2595-4073-9e4f-879102b8df26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ecbf7c70b81cdc0592700ecbb7ccf09", "srcset": "https://si.imgix.net/f9402a16/uploads/origins/02e9ee54-2595-4073-9e4f-879102b8df26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0ecbf7c70b81cdc0592700ecbb7ccf09, https://si.imgix.net/f9402a16/uploads/origins/02e9ee54-2595-4073-9e4f-879102b8df26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae12ce9652ff4bf8ebfa1bcb39a377a1 2x, https://si.imgix.net/f9402a16/uploads/origins/02e9ee54-2595-4073-9e4f-879102b8df26?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c82d809fbbccc9107d883788bc789629 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f9402a16/uploads/origins/02e9ee54-2595-4073-9e4f-879102b8df26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a76cf168859c8e5cde646153c3d0ef5c", "srcset": "https://si.imgix.net/f9402a16/uploads/origins/02e9ee54-2595-4073-9e4f-879102b8df26?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a76cf168859c8e5cde646153c3d0ef5c, https://si.imgix.net/f9402a16/uploads/origins/