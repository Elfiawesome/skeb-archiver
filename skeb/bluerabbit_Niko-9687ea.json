らみ、ガラス壁が破壊寸前になるほどギッチギチに満たされてしまう。\n※構図(研究室内・ガラス部屋など)につきましては、Ref_lab1, Ref_lab2を参考にしてください。\n※上記の差分同様、その他要素はすべてお任せいたします。\n※もし可能であれば、上記と同様に2匹のワイプ表現の追加、擬音あり(なし)verを作成していただけますと幸いです。\n\n[参考資料およびキャラシート]\nhttps://drive.google.com/drive/folders/1a0F4gkmBykEA4CRZoJzpXborqb364YcX?usp=sharing\n\n拙い文章となってしまい申し訳ございませんが、よろしくお願いいたします！", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bluerabbit_Niko/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 382285, "client_id": 33015, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e7932216/uploads/origins/1cf6f4e6-14f1-4916-9d7d-92fc457b8681?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c124cae95b297f5b71110eebd0af284", "srcset": "https://si.imgix.net/e7932216/uploads/origins/1cf6f4e6-14f1-4916-9d7d-92fc457b8681?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6c124cae95b297f5b71110eebd0af284, https://si.imgix.net/e7932216/uploads/origins/1cf6f4e6-14f1-4916-9d7d-92fc457b8681?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b7a7b3ab77d7345c27a7c76382b08504 2x, https://si.imgix.net/e7932216/uploads/origins/1cf6f4e6-14f1-4916-9d7d-92fc457b8681?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=04a46af3aee3e411a81006e4fc16f9b1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e7932216/uploads/origins/1cf6f4e6-14f1-4916-9d7d-92fc457b8681?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff4312dd634396b8ff14cdb42749eca7", "srcset": "https://si.imgix.net/e7932216/uploads/origins/1cf6f4e6-14f1-4916-9d7d-92fc457b8681?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ff4312dd634396b8ff14cdb42749eca7, https://si.imgix.net/e7932216/uploads/origins/1cf6f4e6-14f1-4916-9d7d-92f