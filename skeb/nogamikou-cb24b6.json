1459479466741145601?s=20&t=fZHmmN8l7CgRkvupRXMLBA\n\nテーマ：一緒に添い寝\n　　　　横向きに寝転んでいる構図が嬉しいです。\n\nその他表情、構図等はのがみ様にお任せいたします。\n\n【使用用途】\n・SNSでの掲載\n・配信・動画内での使用/サムネイル画像\n上記にて使用させていただきたく可能であれば\n人物と背景、サインを別レイヤーにて頂戴できますと幸いです。\n\n\nお忙しいところ恐縮ですが、\nご検討宜しくお願い致します。\n\n\n熊野ふぁい　Twitter\nhttps://twitter.com/phay_kumano", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nogamikou/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 16434, "client_id": 1283175, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b94b3503/uploads/origins/8f3872cd-f328-4a29-8bec-ebbdf92b6d45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7a6527273ce4b9bf2b5f94fb8cac41c", "srcset": "https://si.imgix.net/b94b3503/uploads/origins/8f3872cd-f328-4a29-8bec-ebbdf92b6d45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7a6527273ce4b9bf2b5f94fb8cac41c, https://si.imgix.net/b94b3503/uploads/origins/8f3872cd-f328-4a29-8bec-ebbdf92b6d45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=784fe1173a8037f260fc39f3a22e3ebf 2x, https://si.imgix.net/b94b3503/uploads/origins/8f3872cd-f328-4a29-8bec-ebbdf92b6d45?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ce4cf7bb5bab090f40e01bb172d0612a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b94b3503/uploads/origins/8f3872cd-f328-4a29-8bec-ebbdf92b6d45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d56de65d69980504458773642bd55954", "srcset": "https://si.imgix.net/b94b3503/uploads/origins/8f3872cd-f328-4a29-8bec-ebbdf92b6d45?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d56de65d69980504458773642bd55954, https://si.imgix.net/b94b3503/uploads/origins/8f3872cd-f328-4a29-8bec-ebbdf92b6d45?bg=%23fff&auto=