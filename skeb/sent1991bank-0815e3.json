2d-98fe-dd576dd03a97?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=88bfad561d72b46a89d0c2d27f9e10b4 3x"}, "body": "はじめまして！『牝のあなぐら』と『肉ゲーム』が好きすぎるので依頼に参りました。依頼内容としては『牝のあなぐら』のキャラで『肉ゲーム』の女性上位エッチをしてもらうという感じです。\nキャラ：『牝のあなぐら』のゴブリン少年とゴブリンが変化した女性（ギザ歯メカクレ）\nシチュ：野外で元ゴブリン女に襲われる（襲わせている）ゴブリン少年。メカクレ状態は維持でお願いします。\n\n1ページ目：元ゴブリン女に背面騎乗位されるゴブリン少年（すぐ中出してしまう）\n2ページ目：別の元ゴブリン女に後背位で注ぎ込む（元ゴブリン女は「オッ元気イイナッ」とか余裕の感じです）\n3ページ目：騎乗位でのしかかられて中に射精してるゴブリン少年、元ゴブリン女からは「元気いい坊主で嬉シイゾ♡巣でも頑張レヨ」と笑顔で予告\n\nという余裕たっぷりの元ゴブリン女に可愛がられる（自分からも攻めるが余裕で受け止められる）というシチュですね。よければよろしくお願いします！", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sent1991bank/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5c7a4dbb/uploads/origins/bd34b6b9-3005-4f75-83f4-eb8c43212523?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b41f84d20ba868dcfab74ac5ff43328d", "srcset": "https://si.imgix.net/5c7a4dbb/uploads/origins/bd34b6b9-3005-4f75-83f4-eb8c43212523?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b41f84d20ba868dcfab74ac5ff43328d, https://si.imgix.net/5c7a4dbb/uploads/origins/bd34b6b9-3005-4f75-83f4-eb8c43212523?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=59cc73c380abbdec4f7891c7a677d410 2x, https://si.imgix.net/5c7a4dbb/uploads/origins/bd34b6b9-3005-4f75-83f4-eb8c43212523?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=64732e2e6e507381f10d308b6e933574 3x"}, "private": true, "genre": "comic", "tipped": true, "creator_id": 802269, "nc": 176}, {"pa