r、Pixivにて素敵なイラストに惹かれ、リクエストを送らせて頂きました。\n「水着エイシンフラッシュさん」や「部屋着なファル子とフラッシュさん」のイラストが特に好きです\n\n聖園ミカさんの水着のファンアートを描いて頂きたいです。ただし、スクール水着以外の水着でお願いします！\nその他は構図や服装含め、先生のおすきなように描いて頂いて大丈夫です！\n\n【使用用途】\nDiscord、Twitterサブアカウントのアイコンに使用したいです(個人利用のみです)。\n\n【その他】\n人物・背景等がレイヤー分け出来るPSDデータで頂けると有難いです。\n\n以上、ご検討よろしくお願い致します。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@etesumsom/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1539996, "client_id": 362402, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/41e7f628/uploads/origins/cddf6525-c9c8-45ae-8886-6b82cb3a66bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cca33905244a9494883235fec4488fd7", "srcset": "https://si.imgix.net/41e7f628/uploads/origins/cddf6525-c9c8-45ae-8886-6b82cb3a66bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cca33905244a9494883235fec4488fd7, https://si.imgix.net/41e7f628/uploads/origins/cddf6525-c9c8-45ae-8886-6b82cb3a66bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=42cbadeb2d2bc880a0347479f1f9cc9e 2x, https://si.imgix.net/41e7f628/uploads/origins/cddf6525-c9c8-45ae-8886-6b82cb3a66bd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=38a7ffa1c05babf9b3ba6f9b21a4f51c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/41e7f628/uploads/origins/cddf6525-c9c8-45ae-8886-6b82cb3a66bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77ca51471dd57a2cf3e2de8e56d2d090", "srcset": "https://si.imgix.net/41e7f628/uploads/origins/cddf6525-c9c8-45ae-8886-6b82cb3a66bd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=77ca51471dd57a2cf3e2de8e56d2d090, https://si.imgix.net/41e7f628/uploads/origins/cddf6525-c9c8-45ae-8886-6b82cb3a66bd?bg=%23fff&auto=