n\nhttps://www.dropbox.com/scl/fo/ma93e1xzfc799mwz1uh3t/ADVOfFY3SjIoPJomnyFHAO8?rlkey=085h8bkz6e9m25wtf55ra6np2&dl=0", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@non_kujoe/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3895578, "client_id": 2060511, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/767d8afb/uploads/origins/3cbf6761-e848-40e9-9cdb-5272b4206774?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5ab1fc7765919dcbfed7c04a2292762", "srcset": "https://si.imgix.net/767d8afb/uploads/origins/3cbf6761-e848-40e9-9cdb-5272b4206774?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b5ab1fc7765919dcbfed7c04a2292762, https://si.imgix.net/767d8afb/uploads/origins/3cbf6761-e848-40e9-9cdb-5272b4206774?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ac115ffd0242cd976293ff54d38998bd 2x, https://si.imgix.net/767d8afb/uploads/origins/3cbf6761-e848-40e9-9cdb-5272b4206774?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c9d55ada8fd180c5078e72050494ecf0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/767d8afb/uploads/origins/3cbf6761-e848-40e9-9cdb-5272b4206774?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd50a6b8f35c69b6a120fae0479ac625", "srcset": "https://si.imgix.net/767d8afb/uploads/origins/3cbf6761-e848-40e9-9cdb-5272b4206774?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bd50a6b8f35c69b6a120fae0479ac625, https://si.imgix.net/767d8afb/uploads/origins/3cbf6761-e848-40e9-9cdb-5272b4206774?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ac5e743c21b536ce62cdaa878bc1c7a5 2x, https://si.imgix.net/767d8afb/uploads/origins/3cbf6761-e848-40e9-9cdb-5272b4206774?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6d837bf29f7f562d0def103bcb8d4c69 3x"}, "body": "あなたの作品が大好きです。イラストがとても美しいですね。私のNLオリジナルキャラクター（OC）のイラストを描いていただけないでしょうか。お引き受けいただければ、大変ありがたく思います。\n参考資料はすべて以下のリンクにまとめてあります。どうぞご自身のスタイルで私のOCを描いてください。\n私のオリジナルキャラクターの服装は、お好きなものを描いていただいて構いません。もしよろしければ、新しい衣装をデザインしていただいても結構です。\nハーマンの顔の傷については、簡略化しないでください。彼の戦術装備を描く場合、ヘルメットに関しては、暗視ゴーグルを描いても描かなくても構いません。 ボディアーマーの空いている部分については、弾倉（mag）を詰めてください。描く際は「Herman-other」のイラストを参考にしてください。彼にはタトゥーがありますが、描く場合は簡略化していただいて構いません。\nアナは小柄でスレンダー、肌色は明るいブロンズ色です。衣装を描く際は「Ana-衣装」を参考にしてください。\n依頼内容に不適切な点があれば、遠慮なく再送してください。私のオリジナルキャラクターに興味がない場合は、直接キャンセルしていただいて構いません。よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1YI4oVgxJeN1kx77BKMZ-GPPLeeeICYTN", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@non_kujoe/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3895578, "client_id": 992450, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5ff344a4/uploads/origins/b22c83a6-2385-47ed-9aa7-9dcf024b1f48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b34225bbd911516cb951a9666b6f4270", "srcset": "https://si.imgix.net/5ff344a4/uploads/origins/b22c83a6-2385-47ed-9aa7-9dcf024b1f48?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b34225bbd911516cb951a9666b6f4270, https://si.imgix.net/5ff344a4/uploads/origins/b22c83a6-2385-47ed-9aa7-9dcf024b1f48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=dd782678018075ba9a5271853df149dc 2x, https://si.imgix.net/5ff344a4/uploads/origins/b22c83a6-2385-47ed-9aa7-9dcf024b1f48?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=60effd34ddc06781c4acaba5117d5547 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5ff344a4/uploads/origins/b