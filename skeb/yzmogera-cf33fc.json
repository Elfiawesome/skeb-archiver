a0b-4599-971c-022f9225b7d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ad2c0d3a55965d34f2ca30715f1bb3a", "srcset": "https://si.imgix.net/675b28e1/uploads/origins/b5bef90c-ea0b-4599-971c-022f9225b7d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ad2c0d3a55965d34f2ca30715f1bb3a, https://si.imgix.net/675b28e1/uploads/origins/b5bef90c-ea0b-4599-971c-022f9225b7d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ab968279f6aedc96fdf4a11dd222c842 2x, https://si.imgix.net/675b28e1/uploads/origins/b5bef90c-ea0b-4599-971c-022f9225b7d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35bdd3fdde2dd249d6249e3602a1277e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/675b28e1/uploads/origins/b5bef90c-ea0b-4599-971c-022f9225b7d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2eedd6453b292482fdc27d59b9c3f2b", "srcset": "https://si.imgix.net/675b28e1/uploads/origins/b5bef90c-ea0b-4599-971c-022f9225b7d7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f2eedd6453b292482fdc27d59b9c3f2b, https://si.imgix.net/675b28e1/uploads/origins/b5bef90c-ea0b-4599-971c-022f9225b7d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=483c98be609984d93b4f608712ea936c 2x, https://si.imgix.net/675b28e1/uploads/origins/b5bef90c-ea0b-4599-971c-022f9225b7d7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2da5eccbb2c86004523a4cdb5a73b61d 3x"}, "body": "はじめてリクエストをお送りします。\n以下のようなエロSSをお願いさせていただければと存じます。\n\n■キャラクター\n・グランブルーファンタジー\nレオナ\n\n■シチュエーション\n・依頼を受けて魔物討伐に向かったグランとレオナだが、魔物が断末魔に放った催淫攻撃がレオナを庇ったグランにあたり、勃起が収まらなくなってしまう（ついでに理性も無くす）\n・自責の念に駆られたレオナが手コキで鎮めるが、若い雄の臭いにあてられたレオナはつい手についた精液を口にしてしまう。その結果、グランの催淫は収まったものの、今度はレオナに効果が移ってしまう（グランは一晩眠ってこの時の記憶を忘れてしまう）。\n・依頼から帰って以降、レオナは露出の多い服を着るようになり、隙を見てはフェラ素振りや手コキ素振りなどでグランを誘惑するように。夜に自分の部屋を訪ねてくるようメッセージを残す。\n・レオナの部屋にやってきたグランを淫語手コキ、パイズリフェラ、スパイダー騎乗位などで搾り取る。\n\n前半についてはシチュエーションに至るための経緯なので、後半に重点を置いていただければ幸いです。\nいつも（別名義ですが）Fantiaで拝見させていただいている作品のように、♡喘ぎやオホ声、淫語等を大量に盛っていただけますようお願いいたします。\nレオナについては文章も絵も非常に少ないため、リクエストをお受けいただけると大変うれしいです。\n何卒ご検討をよろしくお願いいたします。", "nc": 184, "word_count": 8461, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@yzmogera/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 828250, "client_id": 117695, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c394bcdb/uploads/origins/076b4a6c-8b7b-4c9e-9224-f785126d92e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c01ba493432974fc4bed035e59182bc8", "srcset": "https://si.imgix.net/c394bcdb/uploads/origins/076b4a6c-8b7b-4c9e-9224-f785126d92e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c01ba493432974fc4bed035e59182bc8, https://si.imgix.net/c394bcdb/uploads/origins/076b4a6c-8b7b-4c9e-9224-f785126d92e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e1b65ac57d36f4f8c4dac752e0d47cde 2x, https://si.imgix.net/c394bcdb/uploads/origins/076b4a6c-8b7b-4c9e-9224-f785126d92e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=719f0bb6dc06be0d393d6085fa6370ed 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c394bcdb/uploads/origins/076b4a6c-8b7b-4c9e-9224-f785126d92e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ed5ff261a2d69ceac6bd7f2798be243", "srcset": "https://si.imgix.net/c394bcdb/uploads/origins/076b4a6c-8b7b-4c9e-9224-f785126d92e0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3ed5ff261a2d69ceac6bd7f2798be243, https://si.imgix.net/c394bcdb/uploads/origins/076b4a6c-8b7b-4c9e-9224-f785126d92e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5b3527e62a2f56160f25774043cfcfa4 2x, https://si.imgix.net/c394bcdb/uploads/origins/076b4a6c-8b7b-4c9e-9224-f785126d92e0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=24218c2b418c608020c74d8df1d7410f 3x"}, "body": "先日は大ボリュームのグラブルエロテキストありがとうございました。\nまたリクエストさせていただきます。\n\n【内容：グラブル繁殖牧場騎空団】 \n　前回と同じく、グランのガキ繁殖牧場と化した騎空団でリクエストします。\n　キャラはシュラ、フロレンス、ヘルエス、エルバハでお願い致します。\n　※４人全員にボテ腹セックス、出産アクメシチュを出して頂くようお願いいたします。\n\n【ネタ案（使えそうであれば入れてください）】\n　・シュラ・フロレンス\n　　３０過ぎで結婚や子を持つことを期待されプレッシャーを感じていたフロレンス。\n　　以前同じ悩みを抱えていたシュラに相談したところ、二人一緒に繁殖妻となり、\n　　将来それぞれの祖国の英雄となるガキを何人もひり出し牝として最高の幸せを感じる。\n　　※シュラは、以前（https://skeb.jp/@yzmogera/works/2）書いて頂いた設定\n　　　（まんこ管理秘書）を引き継いでいます。\n\n　・ヘルエス・エルバハ\n　　真王になってしまったグランの心労を癒してあげたいと思い、いつでも性欲・繁殖欲解消可能な\n　　ロイヤルオナホに自ら志願。その結果アイルスト王族血統のガキを大量にひり出した\n　　また、アイルストの将来を担う優秀な騎士を繁殖するため、グランの相手をするよう命じられた\n　　エルバハもノイシュと２０以上年の離れた恥かきっ子を何人もひり出した。", "nc": 170, "word_count": 14048, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@yzmogera/works/7", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/26c23027/uploads/origins/54d6060a-55b2-486d-8c40-b88761b0cd77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c6423559bd8f4360b3ac11464b37fa7", "srcset": "https://si.imgix.net/26c23027/uploads/origins/54d6060a-55b2-486d-8c40-b88761b0cd77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9c6423559bd8f4360b3ac11464b37fa7, https://si.imgix.net/26c23027/uploads/origins/54d6060a-55b2-486d-8c40-b88761b0cd77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=92d8c9d59c054d3d913817bca9ed642a 2x, https://si.imgix.