299b4bb16 2x, https://si.imgix.net/1d09ba45/uploads/origins/bd7d0ca5-b636-4ed4-a5db-25103a9179b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5471fa819450c2c8e06557ebdc0b8028 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d09ba45/uploads/origins/bd7d0ca5-b636-4ed4-a5db-25103a9179b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42385da7740d5eb663e8e8467ab7f0f6", "srcset": "https://si.imgix.net/1d09ba45/uploads/origins/bd7d0ca5-b636-4ed4-a5db-25103a9179b2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=42385da7740d5eb663e8e8467ab7f0f6, https://si.imgix.net/1d09ba45/uploads/origins/bd7d0ca5-b636-4ed4-a5db-25103a9179b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=02fd1256df5f6c33846d5daabb01dae2 2x, https://si.imgix.net/1d09ba45/uploads/origins/bd7d0ca5-b636-4ed4-a5db-25103a9179b2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0c661e36fe2606c5e7d8166897d90c48 3x"}, "body": "前回は大ボリュームのグラブルSSを書いて頂き、本当にありがとうございました。\nまたリクエストさせていただきます。\n\nジャンル：グランブルーファンタジー（ＮＳＦＷ）\n内容：エイレアとアラサーエルーン達がグランに完全屈服して孕み便所妻になる\n\nプロット案：\n仲間になったエイレアが、団長が女の扱いを知っているのかと心配になり\n同じ種族で年齢も近いアラサーエルーン達に相談する（ユイシスのため）。\nアラサーエルーン達は含み笑いを浮かべて、深夜団長の部屋に来ればわかると伝える。\n言われた通りにエイレアが深夜に団長の部屋に来ると、普段からは想像もつかないような\n下品な声をあげ、舌を出し白目をむいてイキまくっているアラサーエルーン達がいた。\n混乱するエイレアに、グランは気に入った女性はすべてチンポで屈服させ孕ませてきたと\nアラサーエルーン達が教える。\n出会った時からエイレアにチンイラしていたグランは、強引にエイレアを抱き寄せ\n激しくセックスした。\nその後、ボテ腹になったエイレアとアラサーエルーン達がグランとセックスしていた。\nエイレアはイキまくって薄れていく意識の中で、ユイシスよりも多く団長のガキを\nひり出すと固く決意した。\n\n※アラサーエルーン達は、ゆずもげらさんが「このキャラ絶対に『一回り下の雄に完全屈服❤\n　種付けピストンしてもらうためなら何でもしちゃいます』と言い放つ性欲ギトギト孕みたがり\n　便所妻になるな」と思っているアラサーエルーン２人をお願いします。\n※プロット案はあくまで提案で、内容に合っていればゆずもげらさんの好きなように書いてください。\n※いつものアヘ顔オホ声淫語全開でお願いします。", "nc": 169, "word_count": 9990, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@yzmogera/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 828250, "client_id": 42533, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/37edcb89/uploads/origins/a8a2a047-071e-49fd-bbb3-71b492020932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fb37500337906fa29ac728c9be818db", "srcset": "https://si.imgix.net/37edcb89/uploads/origins/a8a2a047-071e-49fd-bbb3-71b492020932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8fb37500337906fa29ac728c9be818db, https://si.imgix.net/37edcb89/uploads/origins/a8a2a047-071e-49fd-bbb3-71b492020932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ba68205e00af43c5a5c67dc17efe8126 2x, https://si.imgix.net/37edcb89/uploads/origins/a8a2a047-071e-49fd-bbb3-71b492020932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ad5c138e6b3f0c62890c1d979743ea03 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/37edcb89/uploads/origins/a8a2a047-071e-49fd-bbb3-71b492020932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0da6a66cb30cfe1ad80b8297826ba3ab", "srcset": "https://si.imgix.net/37edcb89/uploads/origins/a8a2a047-071e-49fd-bbb3-71b492020932?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0da6a66cb30cfe1ad80b8297826ba3ab, https://si.imgix.net/37edcb89/uploads/origins/a8a2a047-071e-49fd-bbb3-71b492020932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ac1d08a68649b5e4958e78fc01c77858 2x, https://si.imgix.net/37edcb89/uploads/origins/a8a2a047-071e-49fd-bbb3-71b492020932?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=124e1e51b413d91a4cff963e59bf5186 3x"}, "body": "デカパイ乳ガキロリババア(数百歳)が、幼い頃から拾って育てていた息子同然の若い男(デカ魔羅)のオナニーをわざと邪魔しまくりつつ誘惑しまくって、わからせレイプ誘導する話が見たいです！できればロリババア視点の語りで！\n\nロリババアの設定↓\n・数百歳。現代を生きる妖怪で、人があまり寄り付かない神社とかに住んでる感じ。\n・たまたま拾った人間の男児を親代わりに育ててきたが、高校生くらいに育って逞しくなった義息子の身体と魔羅に屈服したくてたまらなくなっている。\n・「くふふ♥︎○○やねぇ♥︎」「あらぁ…♥︎えらいことになっとるなぁ♥︎」みたいな京ことば？関西弁？な口調。\n・一人称は「儂」とか「わらわ」とか、「ウチ」とかでもいいです。これが合うなと思ったものをご自由にどうぞ。\n・男のことは「坊(ボン)♥︎」とか「小僧♥︎」とか「童(わっぱ)♥︎」とか、そういう雰囲気の名前で呼ぶ感じ(どれでもお好きな呼び方にしてくださって構いません)。　チンポをハメられて屈服させられた後は「旦那様♥︎」とかに変わる感じだと嬉しいですね…。「旦那はん♥︎」でもいいです。\n\n見たいシーン↓\n・息子のオナニーをこっそり覗き見て逞しい魔羅に発情するロリババア。激しい手コキと既に何発も出した跡とかで絶倫っぷりを確信し、自分があのチンポに屈服させられることを妄想する。\n\n・それから、息子がオナニーできないように常に辺りをうろついたり同じ部屋にいるようにしながら生活するロリババア。\n\n・寒いとかなんとか理由をつけて布団に潜り込んでデカ乳を押し付けながら一緒に寝る。\n\n・そんなことを何日か続けている内に息子の自分を見る目がオスのそれになっているのを感じるロリババア。そこで買い物に行って来ると言って外出するフリをし、ようやくオナニーできると息子が致し始めたところで「財布忘れてしもうたぁ～♥︎」と部屋に突入する。\n\n・フル勃起チンポに顔を近づけて、「おぉ怖い怖い♥︎」「このデカ魔羅でウチのちっちゃい膣ほじられたら大変なことになってまうなぁ～？♥︎」「レイプされたら絶対屈服してまうわぁ♥︎」とか言ったり、「種付けされないように熱々のデカチンポ様、冷まして大人しくさせんと…♥︎ふーっ♥︎ふーっ♥︎」とロウソクに息を吹きかけるみたいな感じで勃起チンポをフーフーする。\n\n・そのまま息子がオカズに使ってたロリババア物のエロ本のセリフを棒読み朗読して挑発したり？(冗長になりそうここはならなくていいです)\n\n・挑発の甲斐あって理性飛んだ息子にデカすぎる乳をガッツリ掴まれ、汚い声でオホるロリババア。口だけは私たちは親子だからやめろみたいなことを言うが、嬉しそうにニタニタ笑うのが止められないので全然説得力がなく、そのまま種付けオナホレイプ。\n　ここ数日誘惑してたこととかを白状させられ、謝罪しながら何発も孕ませ膣内射精を食らう。\n\n・身体がチンポに負けたことで(妖怪なので)チンポ好みに体質が変化し、母乳が出るようになる。膣をハメられながら乳首を吸われ、「あかん♥︎鬼の乳を吸ったらアンタも鬼になってまうで♥︎」「何百年も♥︎永遠に交尾漬け♥︎うひ♥︎」とか言う。\n\n・完全に男のことを旦那様と認め、屈服宣言して祝言を挙げる。\n\n・できれば後日談みたいな感じで、完全屈服した後の鬼ロリババアがひたすら旦那様にオナホ扱いされて孕まされる交尾も見たいです。\n二人きりで延々とハメ潰してもいいですし、ととさまにメロメロな実娘オナホが既に産まれていてハーレムになってるとかでもいいです。", "nc": 57, "word_count": 9960, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@yzmogera/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 828250, "client_id": 117695, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ed44ce3b/uploads/origins/124aaf5b-4a77-4771-8aa0-f5b96fb70be2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f8e851c2ee6b779c73167dfb811f75ed", "srcset": "https://si.imgix.net/ed44ce3b/uploads/origins/124aaf5b-4a77-4771-8aa0-f5b96fb7