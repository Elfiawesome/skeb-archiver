{"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@yzmogera/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 828250, "client_id": 3050702, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/43696d34/uploads/origins/ab9f5829-de3b-400e-8bc9-cf81310c3de6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5330eedaf63c6016871983e2e65c22bd", "srcset": "https://si.imgix.net/43696d34/uploads/origins/ab9f5829-de3b-400e-8bc9-cf81310c3de6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5330eedaf63c6016871983e2e65c22bd, https://si.imgix.net/43696d34/uploads/origins/ab9f5829-de3b-400e-8bc9-cf81310c3de6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=afbb6c8d475424d24bc5c5c0754a6fd9 2x, https://si.imgix.net/43696d34/uploads/origins/ab9f5829-de3b-400e-8bc9-cf81310c3de6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=374b430331865030af2a58a81a0fce26 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/43696d34/uploads/origins/ab9f5829-de3b-400e-8bc9-cf81310c3de6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=167b967c39fe5090408e9655c196de43", "srcset": "https://si.imgix.net/43696d34/uploads/origins/ab9f5829-de3b-400e-8bc9-cf81310c3de6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=167b967c39fe5090408e9655c196de43, https://si.imgix.net/43696d34/uploads/origins/ab9f5829-de3b-400e-8bc9-cf81310c3de6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=59425fccb503accd18f69f71e538bcc7 2x, https://si.imgix.net/43696d34/uploads/origins/ab9f5829-de3b-400e-8bc9-cf81310c3de6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=40506347f4aa93456b3524c87d4091aa 3x"}, "body": "ゆずもげらさんの書くどスケベSS大好きです\n\n下記設定で一作お願い出来ますか？\n\nスケベ描写、淫語センスどれも大好きなので思う存分やって頂ければと思います\n\n魔改造琴葉茜＆葵二人とイく二泊三日セックス旅\n\nマスター\n・外見は20前半\n・そこそこ立派なイチモツを持つ青年（18くらい）\n・重めの仮性包茎であり、勃起しても先端がちょっと見えるだけ、カリのハリ具合は見事なもの\n・造精・射精機能を増強している\n\n茜ちゃん\n・外見は11程度、無乳、華奢な腰回り\n・きりたんよりも若干幼いつるぺたイカ腹ボディに換装されており、極上名器と子宮プラグイン搭載\n・最新版淫語データベースインストール済のロリコン向けハイエンド型\n・三回目のロールアウト記念に葵ちゃんを産ませてもらった\n・マスター呼称→マスター、ウチのダンナ\n・葵ちゃん呼称→葵\n※葵ちゃんへは、ママ・姉の顔を使い分ける\n\n葵ちゃん\n・外見は18〜19程度、Oカップ、きゅっとした丸尻\n・マスターの精子と茜ちゃんの卵子で構成されたボディを培養槽で急速成長させたわがままボディ、茜ちゃん譲りの極上名器\n・茜ちゃんより歳上の外見だがロールアウトしてたった1年\n・マスターと茜とはセックスもする仲良し兄姉妹という認識だが、同時に二人が父母であることも理解している\n※例）お姉ちゃんばっかりパパとシてずるい！\n・マスター呼称→マスター、パパ\n・葵ちゃん呼称→お姉ちゃん、ママ（マスターと二人きりの時だけ）\n\n流れイメージ\n〇　南国のリゾート施設に到着、親子に間違われる（葵ちゃんがママ）\n\n〇　ロッジに荷物を下ろしビーチに行く三人\n　過激にすぎる水着を着た二人の身体のどスケベさの紹介＆マスターの股間のご立派さの紹介\n　母がイタコの息子ずんだもんに「とんでもないのがいるのだ」と騒がれる葵ちゃん（誇らしげ）\n\n〇夕食後、力尽きるまで部屋でヤりまくる三人\n※四時間くらい\n\n〇ロッジのプールサイドの椅子で朝からセックスを楽しむマスターと葵ちゃん\n\n〇人気のない岩場で青姦するマスターと茜ちゃん\n\n〇ロッジのソファで休みながら二人にWフェラを受けるマスター\n\n〇ビーチを見渡すと結構ハメを外している主人とボイロが多いため、\n・仰向け全裸で恥じらう葵ちゃんにサンオイルを塗りながら正常位するマスター\n・周囲のいやらしい目つきを浴びながら茜ちゃん主導の騎乗位杭打ちピストンを堪能するマスター\n\n〇結局この日もハメまくりで、帰りの飛行機に遅刻しかけるのであった\n\n\nあくまで大筋なのでこの方がいいと思ったらガンガン変えて下さい", "nc": 168, "word_count": 10715, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@yzmogera/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": true, "creator_id": 828250, "client_id": 117695, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/11727c67/uploads/origins/f0ea564f-f10c-461c-9b12-cefba78687cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f6fd187fa9744cd09211fc204ba12fb", "srcset": "https://si.imgix.net/11727c67/uploads/origins/f0ea564f-f10c-461c-9b12-cefba78687cd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8f6fd187fa9744cd09211fc204ba12fb, https://si.imgix.net/11727c6