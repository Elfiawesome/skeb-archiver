申し上げたいのはこちらのオリキャラ狐娘の万里香（まりか）という子です。\n狐耳と尻尾・赤メガネ・アホ毛、そしてちょっぴりツリ目な目つきが特徴的な、160cmくらいの身長の子です。\n本とか、動物や花、星空のような自然をぼーっと見るのが大好きな子です。\n性格的には、ちょっと人見知りで照れ屋ですので人前では余計にクールっぷりしてるけどまた寂しがり屋のちょっと面倒くさい感じです。一人の時や知り合いの前では表情が緩めてちょっと豊かになる感じです。\nこれだけではちょっと説明が足りないと思いますので設定と設定画など、ご参考できそうなものを下のURLにまとめております。\n\nこの娘でてーれあ様の絵柄でのイラストをどうかお願いしたいです。\n衣装は設定画のうちの一つで、スタイルが良い感じで、日常の１シーンって感じってのはどうでしょうか？髪の毛を結んでるシーンとか！他のポーズでも大丈夫です！\nご検討くださいませ！\n\nお忙しい中、要件のみで申し訳ありません。\n応援しております！\n\nhttps://drive.google.com/drive/folders/1kVcp6B8dzGYFGpFb9spMTyDnz0TzyM7Q?usp=sharing", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@terea236565905/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3716403, "client_id": 806358, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1d97d374/uploads/origins/07324447-ea40-49f2-9ced-80ce2e257eda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4325b9bee7fbe7254bc5a1f55766a46c", "srcset": "https://si.imgix.net/1d97d374/uploads/origins/07324447-ea40-49f2-9ced-80ce2e257eda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4325b9bee7fbe7254bc5a1f55766a46c, https://si.imgix.net/1d97d374/uploads/origins/07324447-ea40-49f2-9ced-80ce2e257eda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5d720df2be29e570195f892ee272bbda 2x, https://si.imgix.net/1d97d374/uploads/origins/07324447-ea40-49f2-9ced-80ce2e257eda?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d0d9d03a9d9578f79891eab78885c299 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d97d374/uploads/origins/07324447-ea40-49f2-9ced-80ce2e257eda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=68078e9fb6d82863b477eb89e04fc91e", "srcset": "https://si.imgix.net/1d97d374/uploads/origins/07324447-ea40