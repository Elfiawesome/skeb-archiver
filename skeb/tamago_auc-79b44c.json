00&h=200&blur=200&s=a230a353fefc201b6ed279d249ba2241 3x"}, "body": "はじめまして。たまごと申します。\n以前フォロワーがdamaさんに音楽依頼をされた際に聴いて、私も是非damaさんに楽曲を作って貰いたいと思い、skebさせて頂きました。\n\n今回お願いしたいのは、私のオリジナルキャラクターの「キミィ」のイメージBGMです。\n天真爛漫で好奇心旺盛な性格をした、星の魔法を使う魔女のタマゴである少女で、メスの白ウサギ「ヤバウサ」を相棒としております。\n細かな設定等や、彼女の物語については以下のURLを参考にして頂けると助かります。\n( https://suc.au-chronicle.jp/web/sheets/c/f1773bd16d7034696230fbfa36dd887c )\n( https://suc.au-chronicle.jp/web/sheets/c/fa3a4bdb3f93913cd9476314636dbc15 )\n\n音楽のジャンルはファンタジーな世界に合うケルト音楽をベースにお願いしたいです。また性格が天真爛漫で好奇心旺盛なので、ゆっくりとしたテンポよりは疾走感のあるテンポの方が好ましいです。\n\nご検討頂けたら幸いです、どうぞよろしくお願い致します。\n\nhttps://suc.au-chronicle.jp/web/sheets/c/f1773bd16d7034696230fbfa36dd887c", "nc": 128, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@harufuyu_auc/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 411702, "client_id": 3352214, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ac53b316/uploads/origins/65d78c12-305f-431b-a509-2128d0533156?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09edbb37390051c512caf91bce14b4a7", "srcset": "https://si.imgix.net/ac53b316/uploads/origins/65d78c12-305f-431b-a509-2128d0533156?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09edbb37390051c512caf91bce14b4a7, https://si.imgix.net/ac53b316/uploads/origins/65d78c12-305f-431b-a509-2128d0533156?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=27e0528f23e42072e9d43f32c8afecad 2x, https://si.imgix.net/ac53b316/uploads/origins/65d78c12-305f-431b-a509-2128d0533156?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=421fcf6032ecf2201de948db7c3f0fea 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ac53b316/uploads/origins/65d78c12-305f-431b-a509-2128d0533156?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8f0a36e839b9a42011823573272e5a0", "srcset": "https://si.imgix.net/ac53b316/uploads/origins/65d78c12-305f-431b-a509-2128d0533156?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8f0a36e839b9a42011823573272e5a0, https://si.imgix.net/ac53b316/uploads/origins/65d78c12-305f-431b-a509-2128d0533156?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5356f96893d13847c7618810ecc54e9a 2x, https://si.imgix.net/ac53b316/uploads/origins/65d78c12-305f-431b-a509-2128d0533156?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a33b87b3a7a67c8fd99e02a1d7497907 3x"}, "body": "いつもXでかえはりの羊様のイラストを拝見しております。\nキラキラで可愛らしい絵柄がとても好みで、キャラクターデザインや衣装のデザインも大大大好きなので、今回依頼させて頂きました。\n\n今回描いていただきたいキャラクターは私のOCです。現在はブラウザゲームの「英雄クロニクル」を中心に活動しております。\n\nイメージカラーは「黄色」です。\n天真爛漫で好奇心旺盛な性格をした、魔女の卵である少女です。\n細かな設定やキャラクターデザインに関しては、下記のURLで確認していただけると有難いです。\n\n衣装は是非かえはりの羊様にデザインして頂けたらと思っております。もし難しければ、参考資料の衣装で大丈夫です。\n\n構図等は全てお任せいたします。\nご検討頂けたら幸いです、どうぞよろしくお願い致します。\n\nhttps://suc.au-chronicle.jp/web/sheets/c/e03f2d126a805a978acb1438cdc55d89\n\nhttps://suc.au-chronicle.jp/web/sheets/c/e03f2d126a805a978acb1438cdc55d89", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ichthy0stega/works/44", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1733299, "client_id": 3352214, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1fb35654/uploads/origins/43abae4d-0cba-4009-8cbe-58cfe9842c77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0988a1972ffbfb1e9af8ff98be2fedf8", "srcset": "https://si.imgix.net/1fb35654/uploads/origins/43abae4d-0cba-4009-8cbe-58cfe9842c77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0988a1972ffbfb1e9af8ff98be2fedf8, https://si.imgix.net/1fb35654/uploads/origins/43abae4d-0cba-4009-8cbe-58cfe9842c77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f3773ed307973f6d7a1347ff5cdd85f9 2x, https://si.imgix.net/1fb35654/uploads/origins/43abae4d-0cba-4009-8cbe-58cfe9842c77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39a6dd91ad92e4d95c5dd45f15656376 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1fb35654/uploads/origins/43abae4d-0cba-4009-8cbe-58cfe9842c77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83e49f872eb64869d29b8d6e6102639f", "srcset": "https://si.imgix.net/1fb35654/uploads/origins/43abae4d-0cba-4009-8cbe-58cfe9842c77?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83e49f872eb64869d29b8d6e6102639f, https://si.imgix.net/1fb35654/uploads/origins/43abae4d-0cba-4009-8cbe-58cfe9842c77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2123e72cbe55d6aa708aa15be984cc9b 2x, https://si.imgix.net/1fb35654/uploads/origins/43abae4d-0cba-4009-8cbe-58cfe9842c77?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2a0b661b611369577afbf5dad16749e4 3x"}, "body": "はじめまして、たまごと申します。\n今回初めてskeb依頼させて頂くので、至らないところございましたら、申し訳ございません。\nいつも井口病院先生のうさぎさんイラストに癒されております。\n今回、skeb依頼受付中とのことで、リクエストを送らせて頂きました。\n大変お忙しいとは思いますが、どうかよろしくお願い致します。\n\n今回描いて頂きたいキャラクターは、オリジナルキャラクターの「キミィ\nとその相棒である「ヤバウサ」です。\n【キミィ】\n・魔女の女の子（外見年齢10代前半）\n・性格：天真爛漫で好奇心旺盛\n・キャラモチーフ：卵（＋ひよこ）\n【ヤバウサ】\n・白うさぎの女の子（ネザーランドドワーフのフロスティのイメージ）\n・元々は「暴食の魔獣ハラペコス」という魔獣だったけど、色々あって今の姿に。\n・キャラモチーフ：愛兎（こちらのリンクより愛兎が見れます。）（https://x.com/tamago_kimmy/status/1759904699262910627?s=46&t=emdxPp0ZNLrEtMc-2ntKYg）(https://x.com/tamago_kimmy/status/1759904936102608908?s=46&t=emdxPp0ZNLrEtMc-2ntKYg)\n以下のリンクにて、細かな設定やイラストがありますのでご確認していただけると幸いです。\n（https://suc.au-chronicle.jp/web/sheets/c/d04ad37b52906a416f201f5dd2a0b9fd）\n使用用途は、スマートフォンでの壁紙使用。XやDiscord等でのSNS使用、個人観賞目的での使用。（ポスターカードに印刷したり、アクリルキーホルダーもしくはアクリルスタンドとして作成する予定です。）\n\nキミィがウサギ化して、ヤバウサと仲良く遊んでいる感じで描いて頂きたいです。その他はすべて先生にお任せしたいと思っております。\n\nご検討のほど、よろしくお願い致します。\n\nhttps://suc.au-chronicle.jp/web/sheets/c/d04ad37b52906a416f201f5dd2a0b9fd", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": [{"id": 38515, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ろこ🐿🍀✤8/23（日）COMITIA157_え64b", "screen_name": "roko_pallet", "avatar_url": "https://pbs.twimg.com/profile_images/1674561478027018241/Tdnt2SHU.jpg", "header_url": "https://pbs.twimg.com/profile_banners/870625248567115776/1688081508/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 0}, {"id": 323832, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "👓めがねいずむ👓️", "screen_name": "meganeizm_twi", "avatar_url": "https://pbs.twimg.com/profile_images/2078770045493407744/042L8yRc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1232248870475747328/1777542847/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 574873, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ユイ", "screen_name": "auc_yui", "avatar_url": "https://pbs.twimg.com/profile_images/1476214823705018376/C6bDxiWz.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2254565840/1658412051/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3