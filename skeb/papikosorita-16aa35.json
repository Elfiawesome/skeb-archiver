00&s=1ee297958aadff8c76d51c02f3f4ab56, https://si.imgix.net/b2ff737b/uploads/origins/0efb31f9-f3cb-46e4-8e8d-deb441f49418?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9ca17246a16accca4f7e76dabaa3a2cb 2x, https://si.imgix.net/b2ff737b/uploads/origins/0efb31f9-f3cb-46e4-8e8d-deb441f49418?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a73a4bd57db6ffba7b10aca980522253 3x"}, "body": "はじめまして！\nSkebの新着作品を眺めていたところ、Kさぶ様のかわいい絵柄に一目惚れして今回リクエストを送らせていただきました。\n今回お願いしたいのは、個人Vtuberのねこらっぴぃさんです。\n（Skeb依頼の許可済）\n\n【構図、衣装等】\n・構図Kさぶ様におまかせします\n・衣装は参考リンクの公式衣装を参照ください（見えない箇所は想像で描いていただいて構いません）\n・画面に対して頭や左右が切れない構図だと嬉しいです\n・イメージとしては明るい元気っ子、PONなところもある頑張り屋 の子です\n（活動としては任天堂のゲーム配信や歌枠が多い）\n\n【納品形態】\n・可能であれば、キャラクターとその他が分かれたpsdファイルが望ましいです\n\n【使用用途】\n・ねこらっぴぃさんにデータを送り、SNSやYoutube等でのプロモーション活動に使用していただく可能性があります\n・その他個人での壁紙等への個人利用を考えています\n\nご検討の程よろしくお願いします。\n\nhttps://x.com/Nekorappii/status/2058835464837374133\n\nhttps://x.com/Nekorappii/status/2076313963416141828?s=20\n\nhttps://www.youtube.com/channel/UCo4Guh1TZ7lMooLA-Z44IEQ", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@papikosorita/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4003837, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f0405476/uploads/origins/d80057c9-dc63-4825-b1c6-89628fba8c07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5aa77aec10cc2557eff46f83d28ff5e0", "srcset": "https://si.imgix.net/f0405476/uploads/origins/d80057c9-dc63-4825-b1c6-89628fba8c07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5aa77aec10cc2557eff46f83d28ff5e0, https://si.imgix.net/f0405476/uploads/origins/d80057c9-dc63-4825-b1c6-89628fba8c07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e43b2eb31f57b7b2cd3a60e7ca2a6cea 2x, https://si.imgix.net/f0405476/uploads/origins/d80057c9-dc63-4825-b1c6-89628fba8c07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0e6c004a0d76decba02ae4ba862e29c1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f0405476/uploads/origins/d80057c9-dc63-4825-b1c6-89628fba8c07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db49a17d3c7d554cc14c09e8745d3e65", "srcset": "https://si.imgix.net/f0405476/uploads/origins/d80057c9-dc63-4825-b1c6-89628fba8c07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=db49a17d3c7d554cc14c09e8745d3e65, https://si.imgix.net/f0405476/uploads/origins/d80057c9-dc63-4825-b1c6-89628fba8c07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=155f6e408d7f7ffc8fddabcd57daa095 2x, https://si.imgix.net/f0405476/uploads/origins/d80057c9-dc63-4825-b1c6-89628fba8c07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=10e2862f1aa7d6963d1acd3400fe2071 3x"}, "body": "はじめまして！\nとっても可愛くて、表情が魅力的で動きのあるイラストが素敵で、是非私のOCも描いていただけないかと思い、リクエストをお送りさせていただきました🙂‍↕️✨\n\n私のOCの資料と衣装デザインの参考資料のリンクを下記に添付させていただきます！\n髪型の理想はOC資料①・②・③・⑤(ロングヘアにサイドツインテール)のような感じなのですが、可愛くなりそうであれば他のロングヘア・ボブ？・サイドツインテールのような感じでも大丈夫です！\n\n衣装は特に特定のものは決まっていないので、OC資料や衣装デザイン資料からご参考にしていただき、可愛く描いていただけますと幸いです🙇🏻‍♀️🤍\n\n何卒よろしくお願いいたします！\n\n【OC参考資料】 https://drive.google.com/drive/folders/1LfreuqfkJtcwNXAGGGRyh5Ot-dULL9Sv 【衣装デザイン参考資料】https://drive.google.com/drive/folders/1aen9bcwIIPa1Qde5GSfney_7oCT-qR5h", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@papikosorita/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 4003837, "client_id": 2654030, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1664e07e/uploads/origins/bf5a4f3e-d17b-4a7d-be73-d185583fb5ab?bg=%23fff&auto=form