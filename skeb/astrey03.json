227-89da-8777016605bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d4e31ca3aa3c0857fd857dc44ae18d2", "srcset": "https://si.imgix.net/4bab2b5f/uploads/origins/63c01b6d-09d5-4227-89da-8777016605bb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5d4e31ca3aa3c0857fd857dc44ae18d2, https://si.imgix.net/4bab2b5f/uploads/origins/63c01b6d-09d5-4227-89da-8777016605bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=54b47d0ad02ac55e71e91e5456fcd8b1 2x, https://si.imgix.net/4bab2b5f/uploads/origins/63c01b6d-09d5-4227-89da-8777016605bb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d31bfb1d9d34644dd511352cb4c57aef 3x"}, "body": "リクエストお願いします。\n魔物に敗北後、拘束され新たに生まれた魔物の巣として飼われてしまう可哀そうなシャルロットちゃんをお願いします\n資料有\n\n●バックストーリーイメージ(あくまでイメージ)\n・目覚めると拘束されてることに気が付き暴れる\n・足元の卵から魔物が誕生\n・パニックになり何とか追い払おうとするが拘束状態では碌な抵抗もできず膣内に侵入\n・シャルロットは魔物の巣として飼われる\n\n\n●魔物造形希望\n・足が細い触手状のムカデ\n\n●魔物の生態\n・捕らえた女性の腸内や膣に潜り込み生活(複数匹)\n・媚薬を注入し愛液(魔力)を吸収し成長\n・時折外に出ては胸(母乳)やクリを刺激し魔力吸収\n\n\n●構図希望\nやや下からアングルで脚メイン\n魔物を脚にぐるぐるに巻き付けてほしい\n※構図的に可能でしたら開いた卵描写\n\n・状況\n敗北後シャルロットは産まれてくる魔物の巣として飼われる\n周囲は触手肉壁の部屋\nシャルロットは両手拘束＆片足吊り＆つま先立ちのポーズで拘束\n足元には無数の卵(エイリアンの卵のイメージ)\n\nそうぞよろしくお願いします。\n\nhttps://www.dropbox.com/scl/fo/sig7l6xc6xsjbq9xio2j9/ALgWkswJrnmE3tdto2yGhzY?rlkey=b54eqexs7sdvg4yefjdyp2xxe&st=5l0frojo&dl=0", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@astrey03/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d54a7c7c/uploads/origins/fcd61b6f-8445-47d7-adc9-df51e1b6278c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b44ee5a0afb8b2e683234767eeb63bff", "srcset": "https://si.imgix.net/d54a7c7c/uploads/origins/fcd61b6f-8445-47d7-adc9-df51e1b6278c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b44ee5a0afb8b2e683234767eeb63bff, https://si.imgix.net/d54a7c7c/uploads/origins/fcd61b6f-8445-47d7-adc9-df51e1b6278c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=16a36144ccc825fb471f4c6820f7fd75 2x, https://si.imgix.net/d54a7c7c/uploads/origins/fcd61b6f-8445-47d7-adc9-df51e1b6278c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=88c1d029f014413c09f14e2038913beb 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 862527, "client_id": 32395, "nc": 177}, {"path": "/@astrey03/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 862527, "client_id": 1102741, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/61552b51/uploads/origins/ce900716-534f-4bb7-b6b1-9d2590eb98f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98607ca7397ac475e1780bd7bb8fd7f5", "srcset": "https://si.imgix.net/61552b51/uploads/origins/ce900716-534f-4bb7-b6b1-9d2590eb98f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=98607ca7397ac475e1780bd7bb8fd7f5, https://si.imgix.net/61552b51/uploads/origins/ce900716-534f-4bb7-b6b1-9d2590eb98f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1fbdb04e23a754f50321cd17a6a59e99 2x, https://si.imgix.net/61552b51/uploads/origins/ce900716-534f-4bb7-b6b1-9d2590eb98f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d7a209cbe08960b67ce4d52b988487e9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/61552b51/uploads/origins/ce900716-534f-4bb7-b6b1-9d2590eb98f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a533bb8c588feef2f021a38e56c96ed9", "srcset": "https://si.imgix.net/61552b51/uploads/origins/ce900716-534f-4bb7-b6b1-9d2590eb98f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a533bb8c588feef2f021a38e56c96ed9, https://si.imgix.net/61552b51/uploads/origins/ce900716-534f-4bb7-b6b1-9d2590eb98f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4cc5b63d61c8928e028772a5c87a794a 2x, https://si.imgix.net/61552b51/uploads/origins/ce900716-534f-4bb7-b6b1-9d2590eb98f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2b23ec3a312c94dc15cd7d450defcdd9 3x"}, "body": "リクエストお願いします。\nシチュは捕えられた祓魔少女シャルロットが軟体質のフェイスハガーのような低級魔蟲の苗床にされるもの。服はゲームの「大浴場でクラスメイトに凌辱される」みたく破れボロボロ。仰向けで大きく開かれた四肢は肉腫にそれぞれヒジやヒザが見えなくなるほど深々と呑み込まれるように拘束されています。\n蟲の生殖器がシャルロットの秘部から抜かれ精液を溢れさせるところからスタート。すでに何回も出産させられ身体は精液で酷く汚れもなお何度も犯される様を描いていただきたいです。\n何卒よろしくお願いします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@astrey03/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 862527, "client_id": 521249, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f89f897/uploads/origins/b373c07d-854f-47d0-be72-7f41cf7fcdd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8a695837199da889dd2b88387243c74", "srcset": "https://si.imgix.net/3f89f897/uploads/origins/b373c07d-854f-47d0-be72-7f41cf7fcdd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d8a695837199da889dd2b88387243c74, https://si.imgix.net/3f89f897/uploads/origins/b373c07d-854f-47d0-be72-7f41cf7fcdd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19f8aeaeb085e3639dfa4eace5650fc0 2x, https://si.imgix.net/3f89f897/uploads/origins/b373c07d-854f-47d0-be72-7f41cf7fcdd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=86acd810be8c91fb48aafcd4e614e4ba 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f89f897/uploads/origins/b373c07d-854f-47d0-be72-7f41cf7fcdd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f0244bc310198e70d6abbb92236f9f4", "srcset": "https://si.imgix.net/3f89f897/uploads/origins/b373c07d-854f-47d0-be72-7f41cf7fcdd5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f0244bc310198e70d6abbb92236f9f4, https://si.imgix.net/3f89f897/uploads/origins/b373c07d-854f-47d0-be72-7f41cf7fcdd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=27ee67b1ae943c879e20cac3671cf96f 2x, https://si.imgix.net/3f89f897/uploads/origins/b373c07d-854f-47d0-be72-7f41cf7fcdd5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa8b0fd6003dbfc760e963a962050ab6 3x"}, "body": "暁せんべい様\n\nお世話になります。今回リクエストを送らせていただきました。\n暁せんべい様も日頃描かれていらっしゃる、祓魔少女シャルロットのイラストをお願いできますでしょうか？\n\n膝上が浸かるほどの水深の水路の中を探索していたシャルロット。\nそこへ水中から飛び出してきた数匹の魚型の魔物が襲いかかり、水に足を取られて素早く動くことのできない隙を突かれてしまう。\n太ももや、聖衣越しの胸に吸いついたり、ショーツに潜り込み女性器の中へ侵入してくる魔物達相手に抵抗しようとするも、ぬめる身体をくねらせる魚を引き剥がすことができない。\n刺激に悶え、バシャバシャと上がる水飛沫に濡れながらシャルロットは責められ続ける……そんな場面を描いたイラストをお願いしたいです。\n構図や表情といった細かい指定はございませんので、暁せんべい様にお任せしたいと思います。\n\nご都合が合えば、どうか御検討いただけますと幸いです。恐縮ですが宜しくお願い致します。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@astrey03/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 862527, "client_id": 33118, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89986418/uploads/origins/fcafba65-79da-4a9f-9269-ae38df13024b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91db9ba9bf00ef73dba0cface2f093f0", "srcset": "https://si.