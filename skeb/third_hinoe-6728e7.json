不穏な屋内などの場面を盛り込んでいただけますと嬉しいです。ただし、あまり作業工数の増加が著しいとして予算に大きく響くようでしたら、彩度の低い無機的なグラデーション背景程度で大丈夫です。\n\n今回のご依頼の希望仕様条件は、以上のものとなります。\n何卒ご精査のほど、よろしくお願い申し上げます。\n\n芹沢 時雨", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [{"path": "/@91__PPP/works/225", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2545158, "client_id": 637886, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6aa9588c/uploads/origins/26072780-20f9-4648-a6f7-f8531c9efe4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39adaaa27dd5a0bf68479f702b5a9a72", "srcset": "https://si.imgix.net/6aa9588c/uploads/origins/26072780-20f9-4648-a6f7-f8531c9efe4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=39adaaa27dd5a0bf68479f702b5a9a72, https://si.imgix.net/6aa9588c/uploads/origins/26072780-20f9-4648-a6f7-f8531c9efe4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=11416bf6cbae87ce53c6633ba096f57e 2x, https://si.imgix.net/6aa9588c/uploads/origins/26072780-20f9-4648-a6f7-f8531c9efe4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c95eabc00a0488b6ab0b7a6db2f0fbed 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6aa9588c/uploads/origins/26072780-20f9-4648-a6f7-f8531c9efe4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=650a59da43f0c45c8f60d64d990c3b34", "srcset": "https://si.imgix.net/6aa9588c/uploads/origins/26072780-20f9-4648-a6f7-f8531c9efe4c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=650a59da43f0c45c8f60d64d990c3b34, https://si.imgix.net/6aa9588c/uploads/origins/26072780-20f9-4648-a6f7-f8531c9efe4c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=04fb36ea3a243cbb48672e60d6280ae3 2x, https://si.imgix