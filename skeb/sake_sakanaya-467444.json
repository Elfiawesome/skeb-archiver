/origins/2075caf4-16ce-4366-98e1-2934f15dd963?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=617044851cbc01f10fc6c60f7db9f4fe, https://si.imgix.net/90bc2f94/uploads/origins/2075caf4-16ce-4366-98e1-2934f15dd963?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=531a0dad73649f975868cbec80439dee 2x, https://si.imgix.net/90bc2f94/uploads/origins/2075caf4-16ce-4366-98e1-2934f15dd963?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0ee0c1fd72abbf6bcce78453dc1fb3f8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/90bc2f94/uploads/origins/2075caf4-16ce-4366-98e1-2934f15dd963?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=104efcf768a45e7d3b9782cff60cc2b9", "srcset": "https://si.imgix.net/90bc2f94/uploads/origins/2075caf4-16ce-4366-98e1-2934f15dd963?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=104efcf768a45e7d3b9782cff60cc2b9, https://si.imgix.net/90bc2f94/uploads/origins/2075caf4-16ce-4366-98e1-2934f15dd963?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1d69c8eef595702ce7b9cfabfeac5ef0 2x, https://si.imgix.net/90bc2f94/uploads/origins/2075caf4-16ce-4366-98e1-2934f15dd963?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5abf9c75fb2a0833301fea8223231194 3x"}, "body": "初めまして。\n肴屋様の描くイラストがとても好きでこの度依頼させて頂きました。\n今回依頼するのはVtuberのトォルさんのイラストになります。(本人及び担当イラストレーター許可済)\n\n構図やポーズ、シチュエーションなどの希望▼\n・衣装　衣装2　　\n・構図　詳しい構図はおまかせで描いていただきたいですが、可能であれば表情は参考資料内にある肴屋様の過去イラストの様な表情でお願い致したいです。\n使用用途▼\nトォルさんがYoutube配信でのサムネイルや、イラストタグなどTwitter上での宣伝で使用する許可を頂きたいです。\nそして許可を頂ける場合には宛名の後ろに⭐︎などのマークを付けて貰いたいです。マークが無い場合には上記の用途には使用致しません。また可能であれば背景透過とPSDも頂けると助かります。\n\n何卒ご検討の方よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/15Ld9oG0dSEA_JuSrTj9yAwB_YcDrfSr6?usp=drive_link", "nc": 128, "word_count": 0, "transcoder"