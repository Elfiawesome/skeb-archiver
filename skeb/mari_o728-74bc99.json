&txtsize=30&txt=PRIVATE&s=c2c1527f0114b0e05bc6bb3310e83b7b 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2786786, "client_id": 168140, "nc": 144}, {"path": "/@mari_o728/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2786786, "client_id": 2788033, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/92b632e6/uploads/origins/16bdbba0-b853-41a2-904e-95421e3a3dd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad285061e02dbce1d300fb85b36aacb4", "srcset": "https://si.imgix.net/92b632e6/uploads/origins/16bdbba0-b853-41a2-904e-95421e3a3dd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad285061e02dbce1d300fb85b36aacb4, https://si.imgix.net/92b632e6/uploads/origins/16bdbba0-b853-41a2-904e-95421e3a3dd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fd0a1879b70a11f8db11e08ec303b6c4 2x, https://si.imgix.net/92b632e6/uploads/origins/16bdbba0-b853-41a2-904e-95421e3a3dd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=816fc892628723856e1205bde9e0f2fa 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/92b632e6/uploads/origins/16bdbba0-b853-41a2-904e-95421e3a3dd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae7d018c7685ed3e123397d1ad6aa624", "srcset": "https://si.imgix.net/92b632e6/uploads/origins/16bdbba0-b853-41a2-904e-95421e3a3dd1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae7d018c7685ed3e123397d1ad6aa624, https://si.imgix.net/92b632e6/uploads/origins/16bdbba0-b853-41a2-904e-95421e3a3dd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=23d195c1db36bfb062322218f07534a0 2x, https://si.imgix.net/92b632e6/uploads/origins/16bdbba0-b853-41a2-904e-95421e3a3dd1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=408a61f51d379f376e08aa6d9a415fa4 3x"}, "body": "はじめましてVTuber活動中の花咲すみれと申します。\n毬麻様の描く女の子のもちっとした肌の質感とフリルの表現に一目惚れしました！\n\n是非私自身のファンアートを描いて頂きたくご連絡致しました\nデザインは以下URLでご確認ください\n\nhttps://drive.google.com/file/d/1kVq7rFCwYtBGBVj3POP1cy5VSu8-5QT9/view?usp=drivesdk\n\n異国のお姫様で、超ポジティブ/明るい/清楚/庶民派などの要素がキャラのイメージです。\n\n以下3点は強い希望です。\n・髪/耳は見切れず、耳＋耳の中の花は脱着不可なのでついたまま希望\n※注意ケモ耳があるため人の耳はありません\n・背景部分に何か描かれていた場合はサイン入りサインなし。背景透過ver.もいただけると助かります！\n・おしり/腿まで映る縦長のイラスト希望\n\n↓以下可能であれば希望\n・全体的に布多めでフリルのたっぷりついた雰囲気に合うカラーのミニ丈通常メイド服(胸元の装飾お任せ)\n・髪飾りは服に合うものをお任せ\n・お洋服を邪魔しない髪型(毛量多め)\n・毬麻様の描かれたこちらのイラストの構図が理想です↓\nhttps://drive.google.com/file/d/1OUtVvskypQBbHv12R-kDtdXDqlQzdg5K/view?usp=drivesdk\n・手の位置/ポーズはピース以外でお任せ\n・スカートはめくれていますが中にフリルのついたかぼちゃパンツを履いている。\n※毬麻様の描くおしりがかわいいのでパンツが見えるように描いて頂いても構いません。\n・瞳はハイライト多めでキラキラ希望\n・驚いた顔と笑顔の差分を頂けると嬉しいです(驚いた顔優先)\n\n希望内容はもちろん無視していただいても構いません！毬麻様が可愛い！と思うように楽しく描いて頂ければ幸いです。\n\n頂いたイラストはツイートや配信、サムネイル、FUNBOXなど配信活動の一環として利用させて頂く予定です。\n\n可能であればグッズ化をさせて頂きたいです、その際は毬麻様のお名前/IDを表面に小さく記載致します。\nグッズ化は必須ではありません、納品のサイン入り画像内サインの最後に☆☆と記載して頂ければ納品頂いた全ての画像グッズ化は絶対にしません。\n\nよろしくお願い致します。\n\nhttps://drive.google.com/file/d/1UQsf6oJDO-yM_GNyte1NeMgBTGGMO8AU/view?usp=drivesdk", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@mari_o728/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2786786, "client_id": 2711333, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b7ce4b13/uploads/origins/b08840c9-3d0a-4f3e-a8bb-064ec1c5b68a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7365c052bfa1e26c3b8d30bb2390ba2f", "srcset": "https://si.imgix.net/b7ce4b13/uploads/origins/b08840c9-3d0a-4f3e-a8bb-064ec1c5b68a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7365c052bfa1e26c3b8d30bb2390ba2f, https://si.imgix.net/b7ce4b13/uploads/origins/b08840c9-3d0a-4f3e-a8bb-064ec1c5b68a?bg=%2