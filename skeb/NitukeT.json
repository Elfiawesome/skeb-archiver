igins/acf2b0a8-b712-4f3c-988b-600244022bee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ad4380a82a54c6b8fd9c5a21a779d4b8, https://si.imgix.net/3c95665e/uploads/origins/acf2b0a8-b712-4f3c-988b-600244022bee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=28658169fc922cca403b5c63d37b9c5c 2x, https://si.imgix.net/3c95665e/uploads/origins/acf2b0a8-b712-4f3c-988b-600244022bee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d9c18d77ec508f80123db676d1e1cfc6 3x"}, "body": "こんにちは！私のロボトミー・コーポレーションのエージェント2人を、あなたのスタイルで描いていただけないでしょうか。あなたの絵はとてもクールです！1人目はメイソンです。彼はジャスティティアの使い手です。施設内で起こる暴力に無関心な、ストイックな青年です。これは彼がタイムループの存在を認識しているためです。そのため、彼の視線は虚ろなのです。\n\n2人目はオデリーです。この若い女性は明るく陽気な性格で、アブノーマリティが血を流すのを見るのが好きです。ミミクリーを深く理解しているため、改良版を使用しています。スプライトのように、よくウインクしています。\n\nまた、彼らは兄妹です！『セカンド・トランペット』の戦闘シーンでは、二人が並んで戦う様子を描いてほしいです。武器を構え、戦闘開始前に短い言葉を交わしているような構図でお願いします。よろしくお願いします！\n\nhttps://drive.google.com/drive/u/1/folders/19c9R2nYu3njW-iAEpqEkX58Zy5fxv8nN", "nc": 25, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NitukeT/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2091882, "client_id": 3471578, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/80c2314e/uploads/origins/f78fceba-4891-4911-861f-54d6c33af101?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=faa657e9d2b837b0c4027ea342c15119", "srcset": "https://si.imgix.net/80c2314e/uploads/origins/f78fceba-4891-4911-861f-54d6c33af101?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=faa657e9d2b837b0c4027ea342c15119, https://si.imgix.net/80c2314e/uploads/origins/f78fceba-4891-4911-861f-54d6c33af101?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=33d0e4487675e34d36f0d5e541d41fc9 2x, https://si.imgix.net/80c2314e/uploads/origins/f78fceba-4891-4911-861f-54d6c33af101?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8fe548b7bc85eb366b287e452cbefeae 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80c2314e/uploads/origins/f78fceba-4891-4911-861f-54d6c33af101?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a44764bfbeea30db0454e522f50d487f", "srcset": "https://si.imgix.net/80c2314e/uploads/origins/f78fceba-4891-4911-861f-54d6c33af101?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a44764bfbeea30db0454e522f50d487f, https://si.imgix.net/80c2314e/uploads/origins/f78fceba-4891-4911-861f-54d6c33af101?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6c54836466c9bbf48c428c462fc94fae 2x, https://si.imgix.net/80c2314e/uploads/origins/f78fceba-4891-4911-861f-54d6c33af101?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=da5d0f35694eb5941baaa2cd656787a5 3x"}, "body": "こんにちは〜🙌🙌 いつも素敵なイラストを拝見させて頂いてます〜！\n 今回は、CoC「吠日怪界」の自陣を描いていただきたくリクエストを送らせて頂きました。 \nそれぞれの資料は下に添付しておきますので参考にして頂ければ幸いです。  \n\n構図イメージですが、昼間の特殊捜査課室内で暇そうに談笑しているようなものがいいです。 黒髪の方が開け放った窓の外を眺めながら煙草をふかしていて、隣で赤髪の子が窓もしくは窓枠にもたれかかって何か話しかけているような光景を想像しています。 \nざっくりとしたイメージなので、細かな部分は描きやすいように調整していただいて構いません。\n黒髪の方は然程表情豊かではないのですが、相棒と話している時くらいは表情が緩んでいるのではないかなと思います。赤髪の子は普段から愛想がよくて笑顔が素敵です。近すぎない距離感で親しげな様子を描いて頂けると嬉しいです。 \n\n  につけさんの描くふたりを見られるのをすごく楽しみにしています！どうかよろしくお願いします🙏🙇‍♀️ \n暑い日が続きますので体調にはよく気をつけてご自愛くださいませ〜🍀\n\nhttps://drive.google.com/drive/folders/12PtBqHqnqdmgnc7FIWVgZKZh0JCl2C_I", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@NitukeT/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2091882, "client_id": 1852607, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f8bc6911/uploads/origins/48df45a3-a62e