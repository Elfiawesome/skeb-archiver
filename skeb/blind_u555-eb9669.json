e3\u3057\u3051\u308c\u3070\u30ad\u30e3\u30f3\u30bb\u30eb\u3057\u3066\u5927\u4e08\u592b\u3067\u3059\uff01\n\n \u25bc\u53c2\u8003\u30ea\u30f3\u30af\u3067\u306f\u3001\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u8a2d\u5b9a\u306a\u3069\u3001\u7d75\u306e\u53c2\u8003\u60c5\u5831\u3092\u3054\u89a7\u3044\u305f\u3060\u3051\u307e\u3059\u3002  \n\n\u25bc\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306a\u3069\uff1a \n\u7537=D\uff0c\u5973=R\n \u300e\u30cf\u30f3\u30ac\u30fc\u30fb\u30b2\u30fc\u30e0\u300f\u3084\u300e\u30d0\u30c8\u30eb\u30fb\u30ed\u30ef\u30a4\u30a2\u30eb\u300f\u306e\u3088\u3046\u306a\u30b5\u30d0\u30a4\u30d0\u30eb\u30b2\u30fc\u30e0\u3092\u821e\u53f0\u306b\u3057\u305f\u7269\u8a9e\u3067\u3059\u3002 \u4e8c\u4eba\u306f\u30c1\u30fc\u30e0\u30e1\u30a4\u30c8\u3002 (\u3061\u3087\u3063\u3068\u66d6\u6627\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u304c...)\n\u30ed\u30b1\u5730\u306f\u4e3b\u306b\u68ee\u306e\u4e2d\u3067\u3059\u3002 \n\u3069\u3061\u3089\u308230\u6b73\u524d\u5f8c\u6210\u719f\u3057\u305f\u5927\u4eba! D\u306f\u7b4b\u8089\u8cea\uff08\u30ed\u30b7\u30a2\u4eba\uff09\u3001R\u306f\u307d\u3063\u3061\u3083\u308a\u7cfb\u3002 \nD\u306f\u6d3b\u767a\u306a\u5584\u4eba\u3092\u88c5\u3063\u305f\u6bba\u4eba\u9b3c\u3001R\u306f\u4eba\u898b\u77e5\u308a\u3057\u3084\u3059\u304f\u3001\u751f\u304d\u6b8b\u308b\u305f\u3081\u306b\u82e6\u52b4\u3057\u3066\u3044\u308b\u5916\u79d1\u533b\u3002 \n\u3088\u308a\u65e5\u5e38\u7684\u306a\u5834\u5408\uff1aD\u304c\u89aa\u5bc6\u306a\u4ea4\u6d41\u3092\u59cb\u3081\u3001R\u306f\u305d\u306e\u4e3b\u5c0e\u6a29\u306b\u5727\u5012\u3055\u308c\u3001\u6065\u305a\u304b\u3057\u304c\u308b\u3067\u3057\u3087\u3046\u3002\uff08\u7b11vs\u8d64\u9762...\uff09 \n\u3088\u308a\u6016\u3044\u5834\u5408\uff1aD\u304c\u60aa\u5f79\u306e\u9854\u3092\u6652\u3059\u2190\u3053\u308c\u3092\u77e5\u3063\u3066\u30b7\u30e7\u30c3\u30af\u3092\u53d7\u3051\u308bR\u3002\uff08\u5727\u5012\u3055\u308c\u308b\u304b\u3082\u3057\u308c\u306a\u3044\u3057\u3001\u5f7c\u3068\u5bfe\u5cd9\u3059\u308b\u3053\u3068\u306b\u306a\