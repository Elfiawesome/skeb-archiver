釈を盛り込んで頂いて差し支えないです。\n\n\n背景/小物を描き添える際は以下を参考にして下さい。\n\n・デフォルト衣装に関連し、バーにありそうなもの(シェイカーなど)\n・獏をモチーフにしていることに関連し、寝室・ベッド付近にありそうなもの(枕など)\n・動物のマレーバクに関係あるもの(ぬいぐるみ等)", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sai_408v_v/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 816193, "client_id": 1179877, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9dc0c43d/uploads/origins/60c5e0e8-6013-4727-affe-a991c1106ce6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59b5697c6f05acc352293dea61e0be7e", "srcset": "https://si.imgix.net/9dc0c43d/uploads/origins/60c5e0e8-6013-4727-affe-a991c1106ce6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59b5697c6f05acc352293dea61e0be7e, https://si.imgix.net/9dc0c43d/uploads/origins/60c5e0e8-6013-4727-affe-a991c1106ce6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=56a7f2da44d70326772ae35a9da8a8ee 2x, https://si.imgix.net/9dc0c43d/uploads/origins/60c5e0e8-6013-4727-affe-a991c1106ce6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f52de54bb2b3b4c6a5f2f3bb48a1cdc7 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9dc0c43d/uploads/origins/60c5e0e8-6013-4727-affe-a991c1106ce6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b835350a25c38f137a79e08db1a96c18", "srcset": "https://si.imgix.net/9dc0c43d/uploads/origins/60c5e0e8-6013-4727-affe-a991c1106ce6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b835350a25c38f137a79e08db1a96c18, https://si.imgix.net/9dc0c43d/uploads/origins/60c5e0e8-6013-4727-affe-a991c1106ce6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f8f1e75bd8d54b972aee18a2d68c3697 2x, https://si.imgix.net/9dc0c43d/upl