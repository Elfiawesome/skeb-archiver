んが描いた衣装を着た姿で描いてください！ 武器の有無は任意です。その他の詳細はご自由に！\n\nよろしくお願いします！ 🥰\n\nhttps://drive.google.com/drive/folders/1FTIZFjZKNxk1HYXR-VmYy254yPNW8Xfk", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ishiyakio/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3497045, "client_id": 1198454, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1052aba3/uploads/origins/cf512585-3bb7-4269-bd1d-24409af40b8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53b193fd718ee5c01fac01db04a7243e", "srcset": "https://si.imgix.net/1052aba3/uploads/origins/cf512585-3bb7-4269-bd1d-24409af40b8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=53b193fd718ee5c01fac01db04a7243e, https://si.imgix.net/1052aba3/uploads/origins/cf512585-3bb7-4269-bd1d-24409af40b8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=feaee18383a33b5becffd8433ee7e810 2x, https://si.imgix.net/1052aba3/uploads/origins/cf512585-3bb7-4269-bd1d-24409af40b8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=584d753b15dda2f0ebf288860d164723 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1052aba3/uploads/origins/cf512585-3bb7-4269-bd1d-24409af40b8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ea4217deafcb75b04cb2cf55eab0c0b", "srcset": "https://si.imgix.net/1052aba3/uploads/origins/cf512585-3bb7-4269-bd1d-24409af40b8b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2ea4217deafcb75b04cb2cf55eab0c0b, https://si.imgix.net/1052aba3/uploads/origins/cf512585-3bb7-4269-bd1d-24409af40b8b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b090d5627d3a93ef82e4ac54618e8289 2x, https://si.imgix.net/1052aba3/uploads/origins/cf5