ction=a", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": []}, "price_history": {"art": [{"amount": 10000, "recorded_at": 1774022768.196986}]}, "custom": {}}