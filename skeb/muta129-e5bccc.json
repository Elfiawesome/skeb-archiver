服装は全裸、表情は薄ら笑い寄りで\n・構図はこんな感じで（https://imgur.com/a/DswOBLA）\n　おまんこの肉厚ビラビラをつまんで御開帳。\n・乳首は貴方様の作品（https://skeb.jp/@muta129/works/8）の大きさ2倍、乳輪はそのまま、色合いは色素が沈着している感じで（頼光ぐらいで、https://skeb.jp/@muta129/works/10）。\n・陰毛は髪色に近い色、濃い目で毛が立つぐらいのボリューム、尻毛もあり\n・両穴とも使い込まれて色素が沈着している\n・ビラビラは大きく肥大化し黒ずんでいる\n・膣口は緩めで中のヒダが見えている\n・まん汁も垂らす\n・修正は黒線で\n\n注文が色々と多いですが、御検討頂ければ幸いです。\nよろしくお願いします。\n\nhttps://twitter.com/tsubame_sizimi/media", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@muta129/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2020891, "client_id": 670108, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f82bbdcb/uploads/origins/cf77eb6a-ebbd-4656-a5a3-bfabbc464ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfc998bab2aaeba3baabcc6a9883f6fd", "srcset": "https://si.imgix.net/f82bbdcb/uploads/origins/cf77eb6a-ebbd-4656-a5a3-bfabbc464ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cfc998bab2aaeba3baabcc6a9883f6fd, https://si.imgix.net/f82bbdcb/uploads/origins/cf77eb6a-ebbd-4656-a5a3-bfabbc464ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=666668fff4f82615ec3d7af52ce1ddbb 2x, https://si.imgix.net/f82bbdcb/uploads/origins/cf77eb6a-ebbd-4656-a5a3-bfabbc464ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=182bc62899756552f61aabaedfc12baf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f82bbdcb/uploads/origins/cf77eb6a-ebbd-4656-a5a3-bfabbc464ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f50b1483e1baed367d05c79911417e0c", "srcset": "https://si.imgix.net/f82bbdcb/uploads/origins/cf77eb6a-ebbd-4656-a5a3-bfabbc464ad0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f50b1483e1baed367d05c79911417