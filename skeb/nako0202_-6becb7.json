す！是非描いていただきたいです！\n\nキャラクターについてです！\n３２歳男性の中学校の養護教諭です。\n身長180㎝で紺色の襟足が跳ねた髪形です。\n厚めの前髪で右額を隠す様にしていて左側にヘアピンをつけています。ハイライト少な目の真っ黒な瞳をしており口元に手を当てる癖があります。ピンク色やかわいいキャラクターなどが好きです。\n保健室に休みにきた生徒に優しくお話したり、「内緒ですよ？」とお菓子をあげたりしていることが多いです！\n容姿などはこちらをご参照くださいhttps://drive.google.com/drive/folders/1F2uKe5ZjKmbvZYR0nlC3Cdr4jD93pXKL?usp=drive_link\n\n構図などはすべてお任せします。よろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1F2uKe5ZjKmbvZYR0nlC3Cdr4jD93pXKL?usp=drive_link", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nako0202_/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3376907, "client_id": 1196514, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/29a9a933/uploads/origins/a270c46a-a371-44da-8e49-197f5cf79327?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03214cc520b190ca91ad42bc5b0e74ea", "srcset": "https://si.imgix.net/29a9a933/uploads/origins/a270c46a-a371-44da-8e49-197f5cf79327?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=03214cc520b190ca91ad42bc5b0e74ea, https://si.imgix.net/29a9a933/uploads/origins/a270c46a-a371-44da-8e49-197f5cf79327?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=eaca72d17c36aabf7ead14e961080aea 2x, https://si.imgix.net/29a9a933/uploads/origins/a270c46a-a371-44da-8e49-197f5cf79327?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e997edebbcb33efd0290d6f3f5376df2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/29a9a933/uploads/origins/a270c46a-a371-44da-8e49-197f5cf79327?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6184162b919410cd0a9bf5fe48247084", "srcset": "https://si.imgix.net/29a9a933/uploads/origins/a270c46a-a371-44da-8e49-197f5cf79327?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&