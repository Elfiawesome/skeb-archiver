=top&w=200&h=200&blur=200&s=7d053f4475a072ed840e1095f527d64b 3x"}, "body": "こんにちは！私の名前はHaibridVTです！好きなように私を描いて欲しい！僕はただクールなアートを手に入れて、アーティストをサポートしたいだけなんだ！だから、もし僕を描いてくれるなら、このリファレンスパッケージを使ってね。\n\nhttps://imgur.com/a/0eCAt28\n\n空は無限大だ。ただ一つお願いしたいのは、女の子、C～Dカップ、キュートかセクシー、髪や目のカラーパレットは変えないでほしい！背景は透明だと嬉しいですが、必須ではありません！\n\n火」の部分は、Soulfire/The Essence of My Very Soulのつもりです :3", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@matz_no_e/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3598827, "client_id": 2107759, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3006577f/uploads/origins/1cd5f8eb-6f96-4551-a982-566ae496213b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea9c17b4eebc7e10830285495b559f09", "srcset": "https://si.imgix.net/3006577f/uploads/origins/1cd5f8eb-6f96-4551-a982-566ae496213b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ea9c17b4eebc7e10830285495b559f09, https://si.imgix.net/3006577f/uploads/origins/1cd5f8eb-6f96-4551-a982-566ae496213b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6fcc00f1006b3a10e03fe5247e8b121c 2x, https://si.imgix.net/3006577f/uploads/origins/1cd5f8eb-6f96-4551-a982-566ae496213b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=710b80c3bc2220c576a7c108dd1ab44a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3006577f/uploads/origins/1cd5f8eb-6f96-4551-a982-566ae496213b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b69c945a9de88f9ea60dacbf2144968", "srcset": "https://si.imgix.net/3006577f/uploads/origins/1cd5f8eb-6f96-4551-a982-566ae496213b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8b69c945a9de88f9ea60dacbf2144968, https://si.imgix.net/3006577f/uploads/origins/1cd5f8eb-6f96-4551-a982-566ae496213b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e8b1006117c8f58b5e984f76e2b25e38 2x, https://si.imgix.net/3006577f/uploads/origins/1cd5f8eb-6f96-4551-a982-566ae496213b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=da4d7cb963631e238d20220dffbaecd0 3x"}, "body": "こんにちは！あなたの作風がとても好きなので、FFXIVのOCロキシの依頼をしたいです。このアートに使われている柔らかい色が大好きです。https://skeb.jp/@matz_no_e/works/2\n\nLoxiは、ギルとコントロールを愛する、シャープでスタイリッシュなビジネスウーマンです。彼女は自信に満ち、計算高く、鋭い笑みを浮かべたり、好奇心に満ちたまなざしを向けたりする。冷酷ではない。\n\n緑色の瞳とパステルピンクの髪、毛先には小さな白いハイライトが入っている。\n\nポーズ - あなた次第。もっとキュートで自信に満ち溢れたポーズを少し提案します（セクシーではありません）。\n\n参考：https://imgur.com/a/duOMaMS\n\nありがとう！\n\nhttps://imgur.com/a/duOMaMS", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@matz_no_e/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3598827, "client_id": 2049215, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c7fc1361/uploads/origins/f412ea04-7411-47e7-839f-f04290cf6d5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6178fa81f83207f63ac0ae506573edf8", "srcset": "https://si.imgix.net/c7fc1361/uploads/origins/f412ea04-7411-47e7-839f-f04290cf6d5b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6178fa81f83207f63ac0ae506573edf8, https://si.imgix.net/c7fc1361/uploads/origins/f412ea04-7411-47e7-839f-f04290cf6d5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0bee2c2a4ca198dfbd3badd585ae19bb 2x, https://si.imgix.net/c7fc1361/uploads/origins/f412ea04-7411-47e7-839f-f04290cf6d5b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=429786ed941855964ecfccfb745f143c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c7fc1361/uplo