1a5ab6b8-8e73-451b-9e38-9f08b84cce80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=905df39da977958405cb0620e680cd5d 2x, https://si.imgix.net/e400aa70/uploads/origins/1a5ab6b8-8e73-451b-9e38-9f08b84cce80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b74eed2d04bb2b480f3f0ad4653ce993 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e400aa70/uploads/origins/1a5ab6b8-8e73-451b-9e38-9f08b84cce80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=073e06d1766017c65137885609cfcc27", "srcset": "https://si.imgix.net/e400aa70/uploads/origins/1a5ab6b8-8e73-451b-9e38-9f08b84cce80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=073e06d1766017c65137885609cfcc27, https://si.imgix.net/e400aa70/uploads/origins/1a5ab6b8-8e73-451b-9e38-9f08b84cce80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1114cb315080c15d865cd74c813f2123 2x, https://si.imgix.net/e400aa70/uploads/origins/1a5ab6b8-8e73-451b-9e38-9f08b84cce80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ad676bbf87a9fddf107725b783aae74c 3x"}, "body": "(まいくろ)^2様、こんにちは。\n\nモモミド心音サンドイッチ素晴らしかったです！！\n\nありがとうございます！！\n\n新たに見てみたいシチュエーションが浮かんだので再び依頼させて頂きます。\n\nキャラクター\nブルーアーカイブの朱城ルミ(幼女)\n\n希望するシチュエーション\n同棲している先生をスケスケな裸エプロン姿で出迎えるルミ。ルミは蠱惑的な笑みを浮かべながら上目遣いで抱き着いてきた。ご飯にする？お風呂にする？それとも…えっち、しちゃう？と先生に問いかけてくるルミ。彼女の期待するような心臓の鼓動が伝わってくる。先生のおちんちんの昂りをお腹で感じるルミ。壁に手をついたルミを後背位（立ちバック）で犯す先生。エプロンの横から手を入れて左胸に触れている。（手のひらで鼓動を感じる描写）壁側から見た視点のルミがバックで犯されている描写、結合部のアップ視点を可能なら入れて欲しいです。ルミの絶頂と同時に先生も射精。(まいくろ)^2様のえっちな擬音の使い方が凄く好きなのでpixivに投稿されていたフブキのようにとくっ♡とくっ♡と精液が腟内や子宮に注がれている擬音や描写とおちんちんを引き抜いて逆流した精液が溢れ出てくるところを描写して欲しいです。最後にルミがエプロンをたくし上げて先生のおちんちんを胸に押し付けイッた後の余韻の残るバクバクな鼓動をおちんちんの先っぽにに感じさせて再び勃起させ二回戦目をさせようとしているところで終了という感じでお願いします。\n\n可能であれば前回のように心臓（心音）の描写があると嬉しいです。指定した箇所以外は(まいくろ)^2様を信頼してお任せします。アドリブも歓迎します。描写が難しい部分は改変して頂いても構いません。\n\n以上の内容で受けて頂ける場合はよろしくお願いします。\n\n以下は過去に依頼した作品になります。\n心臓の描写の参考にして下さい。\n\nhttps://skeb.jp/@puyochocolate/works/121\n\nhttps://skeb.jp/@mokuu__/works/9\n\nhttps://skeb.jp/@sksk_sou/works/156", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@fymicrowave/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2769611, "client_id": 582146, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b74d065d/uploads/origins/cdd87b1d-4dc6-4afb-904a-09df7d758157?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef6987a70d86e0b7431b34ca67e6aa2b", "srcset": "https://si.imgix.net/b74d065d/uploads/origins/cdd87b1d-4dc6-4afb-904a-09df7d758157?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef6987a70d86e0b7431b34ca67e6aa2b, https://si.imgix.net/b74d065d/uploads/origins/cdd87b1d-4dc6-4afb-904a-09df7d758157?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4b24d71eac9132affa303a6c0025e61b 2x, https://si.imgix.net/b74d065d/uploads/origins/cdd87b1d-4dc6-4afb-904a-09df7d758157?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c50d64843903a624310f224f467b6e46 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b74d065d/uploads/origins/cdd87b1d-4dc6-4afb-904a-09df7d758157?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20cca879660f7428315fd3715beac97b", "srcset": "https://si.imgix.net/b74d065d/uploads/origins/cdd87b1d-4dc6-4afb-904a-09df7d758157?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20cca879660f7428315fd3715beac97b, https://si.imgix.net/b74d065d/uploads/origins/cdd87b1d-4dc6-4afb-904a-09df7d758157?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d3010f27b0645335