889/uploads/origins/9ffa715f-9add-49d8-9027-fb33eb5a54ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27da3a772301de791d9aa7bb009808fc", "srcset": "https://si.imgix.net/28928889/uploads/origins/9ffa715f-9add-49d8-9027-fb33eb5a54ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27da3a772301de791d9aa7bb009808fc, https://si.imgix.net/28928889/uploads/origins/9ffa715f-9add-49d8-9027-fb33eb5a54ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=787f86e2013e9870449c86581bb0bd58 2x, https://si.imgix.net/28928889/uploads/origins/9ffa715f-9add-49d8-9027-fb33eb5a54ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7901381804cd85f6840c10206d457c14 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28928889/uploads/origins/9ffa715f-9add-49d8-9027-fb33eb5a54ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dfa0feeaddc4ae4d353c097ad17fd72d", "srcset": "https://si.imgix.net/28928889/uploads/origins/9ffa715f-9add-49d8-9027-fb33eb5a54ed?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dfa0feeaddc4ae4d353c097ad17fd72d, https://si.imgix.net/28928889/uploads/origins/9ffa715f-9add-49d8-9027-fb33eb5a54ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b88cfa16266216960e37082a30637d47 2x, https://si.imgix.net/28928889/uploads/origins/9ffa715f-9add-49d8-9027-fb33eb5a54ed?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9995f12c38402d0d265397621a1fefce 3x"}, "body": "Please draw my character, her name is Meh.\nThe character will include elements such as sheep, moon, futon, succubus, etc.\nHeight: 123cm\n\nSome of your previous drawings are\nFapta https://twitter.com/nmr22kt4n/status/1251462938029785089\nis close to the height that I would like to request.\n\nPlease draw her gaze here.\nPlease draw her belly, groin, and fingers up to the knees.\nThe character's body is light-emitting, with edges ranging from peach to purple, etc.\nThe background color should be dark (night, dream, starry sky).\nOther poses are left up to the artist.\n\nA simple full-body image is shown in the URL below.\nOther images\nhttps://www.pixiv.net/artworks/70796264\nhttps://www.pixiv.net/artworks/99298409\nhttps://twitter.com/gomames/status/1043101142081724416\n\nCapture about the costume\nThe sleeves are filled with glittery gasses reminiscent of the Milky Way\nThe curly hair on the left shoulder has tips that look like a burning candle\nThe white fluff at the tip of the cape is tearing and drifting like a cloud.\n\n\n-Personality\nHe has a quiet and calm personality, and always looks a little sleepy.\nHe behaves like a quiet child of about 10 years old.\nHis behavior is harmless, and he is most averse to hostility from outside.\nHe has a small appetite for food, preferring milk, nuts and chocolate.\n\n-Setting Ability...\nMeh is a kind of fairy or demon that lives in people's memories.\nShe has a pale luminescent rim and usually floats and moves about.\nShe is a mixture of peaches, alcohol, milk, and dried bedding.\nShe wears a light sweet scent that can throw off one's guard.\n\nIt can induce drowsiness in those whom it embraces or touches and keeps in contact with its skin.\ndream, enter into it, and interfere with the creature's memories\nIt maintains its presence by slipping in information about itself.\n\nThe fluid or blood secreted from the body is like condensed milk or milk\nThe fluids and blood secreted from the body are like condensed milk or milk, which not only toughens the body of the person to whom it is given, but is also mildly addictive.\n\nhttps://www.pixiv.net/artworks/99333545", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nmr22kt4n/works/2", "private_thumbnail_image_urls":