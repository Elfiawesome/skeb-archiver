ads/origins/165074eb-e3f0-4cbf-b68a-55022f07eb39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77e0982d9f6473890f746129fc8325e9", "srcset": "https://si.imgix.net/1bf05896/uploads/origins/165074eb-e3f0-4cbf-b68a-55022f07eb39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=77e0982d9f6473890f746129fc8325e9, https://si.imgix.net/1bf05896/uploads/origins/165074eb-e3f0-4cbf-b68a-55022f07eb39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=207c87410098a0540d26dd4d17dee1a6 2x, https://si.imgix.net/1bf05896/uploads/origins/165074eb-e3f0-4cbf-b68a-55022f07eb39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=73523d07fc374ef75c49c98219a7ba44 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1bf05896/uploads/origins/165074eb-e3f0-4cbf-b68a-55022f07eb39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae0230817c78847224d1556714260415", "srcset": "https://si.imgix.net/1bf05896/uploads/origins/165074eb-e3f0-4cbf-b68a-55022f07eb39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae0230817c78847224d1556714260415, https://si.imgix.net/1bf05896/uploads/origins/165074eb-e3f0-4cbf-b68a-55022f07eb39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a2ddcec0c8ed50b2bd7cafba700dced1 2x, https://si.imgix.net/1bf05896/uploads/origins/165074eb-e3f0-4cbf-b68a-55022f07eb39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a5f38ad0f9b41bc14bff76c81b639922 3x"}, "body": "「五等分の花嫁」の二乃と三玖をリクエストします。\n\n日中の御堂の中。白い光が漏れる格子戸をバックに、巫女服の二乃と三玖は主人の前に並んで立ち、白衣の胸元がはだけて胸は露出、袴を両手で捲り上げた姿を正面から見た（主人視線のイラスト）姿。\n胸の大きさは前回のリクエストと同じ大きさで、全身、または最低でも膝下あたりまでの描画をお願いします。\nまた反転ツールを利用していただいてもいいので、顔の角度をのぞいておよそ左右対称の二人の姿をお願いします。\n\n表情：二乃は怒りの感情が交じりながらも二人共羞恥と快感で頬を赤く染めている。二乃は主人の方を見、三玖は主人から少し視線を、顔をそらしている\n髪型：資料左絵参照\n服装：巫女服｛白衣、緋袴、白靴下、草履（資料左絵参照）｝。前回描かれた首輪、それに絵馬を引っ掛けている。リード紐なし。\n色違いになっている白衣の袖紐は描いて欲しい。\n\n首の後ろで結び留めるタイプ（ホルターネック）の光沢のあるパットなし黒ビキニ（資料中央絵参照）を着用。紐は首の後ろに回さず、ペロンと布が捲れないように紐を口で咥えて押さえている。\nさらに黒ビキニはＡＢどちらかの設定で。\nＡ　ビキニに乳首の陰影が浮き立っている\nＢ　両の乳首を刺激する卵型のローターがそれぞれビキニと乳肌の間に挟まり、ビキニに乳首とローターの陰影が浮き立って、コードがビキニの外に伸びている\n\nショーツの着用なし。\n二人共、太腿（片側または両方）にナイフホルスター装着し、各3～5個ローターのリモコンがセットされている。\n袴の前面を両手でお尻の付け根あたりまで捲りあげている（資料右絵参照・性器の描写なし）。二人とも片方は自分の袴を、もう片方（相手側に位置する）の手は相手の袴を捲っている。\n秘部から太腿のリモコンに伸びているローターのコードが見えている。\nショーツの着用なし。\n\n性具など小道具の色はお任せ。\n\n絵馬に文字有り無しの差分\n　文字有り：「ザーメン大好き❤　孕ませてっ❤」　「オナホ妻として躾けてっ❤❤」\n\nhttps://drive.google.com/file/d/1o7cOAx2qdX2ibjE8YHpZOx-1_wumI25v/view?usp=share_link", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sizuku_kiyono/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 922167, "client_id": 943341, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/42bbafab/uploads/origins/c09a353e-2786-407c-a4ab-1dfc44e030e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30879db32687da76668746cca490342d", "srcset": "https://si.imgix.net/42bbafab/uploads/origins/c09a353e-2786-407c-a4ab-1dfc44e030e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=30879db32687da76668746cca490342d, https://si.imgix.net/42bbafab/uploads/origins/c09a353e-2786-407c-a4ab-1dfc44e030e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d6ce77df7b56c42cc6e7612391871f46 2x, https://si.imgix.net/42bbafab/uploads/origins/c09a353e-2786-407c-a4ab-1dfc44e030e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d44f92f8b2088ecfdbc161da8efa11d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/42bbafab/uploads/origins/c09a353e-2786-407c-a4ab-1dfc44e030e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2698aafc9564a1afe9661dda350f4189", "srcset": "https://si.imgix.net/42bbafab/uploads/origins/c09a353e-2786-407c-a4ab-1dfc44e030e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2698aafc9564a1afe9661dda350f4189, https://si.imgix.net/42bbafab/uploads/origins/c09a353e-2786-407c-a4ab-1dfc44e030e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e58428dd545bfeef43e4a9a5ca645738 2x, https://si.imgix.net/42bbafab/uploads/origins/c09a353e-2786-407c-a4ab-1dfc44e030e9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=46f603e19e1bd1344ccda161466d70fc 3x"}, "body": "「五等分の花嫁」の二乃と三玖をリクエストします。\n\nお互いの胸を押し付けて身を寄せる姿（資料左絵に近い構図）\n最低でも腰から上までの描画をお願いします。\n\n二人は恥ずかしげに頬を赤らめ（二乃は怒りの感情が交じっている）、カメラ目線。\n\n服装は原作の制服（二乃：白ブラウスに黒の上着。三玖：白ブラウスに青のセーター、ヘッドホンなし）\n革製の首輪を装着（色はお任せ）\n\n胸は原作より大きく（資料左絵、またはMURASAKIのサイズくらいのバランス）\n\nブラウスの胸元のボダンを外し、剥き出しの乳房。むぎゅっと強く胸を押し付け合い、乳首、乳輪を隠している。\nまた露出、はだけ具合はA～Cのいずれか可能なもので\nA：胸の露出あり\nB：胸、肩の露出あり\nC：胸、肩、背中の露出有り\n\n二人とも片方の手は相手の肩に手を回している\n\nhttps://drive.google.com/file/d/1D4oVQ7p2fP57AKqLv-VN02O6RlXwV0nE/view?usp=sharing", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sizuku_kiyono/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 922167, "client_id": 556750, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/13d26fbc/uploads/origins/e8dde6af-aa98-4b5e-ac7c-7abcd5132580?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d48d5416ca76010e2ac7ef0a791d45e", "srcset": "https://si.imgix.net/13d26fbc/uploads/origins/e8dde6af-aa98-4b5e-ac7c-7abcd5132580?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d48d5416ca76010e2ac7ef0a791d45e, https://si.imgix.net/13d26fbc/uploads/origins/e8dde6af-aa98-4b5e-ac7c-7abcd5132580?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&