gins/561e0c1d-1b46-49a8-b6b1-1dd409def184?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a4dee54a93f2e6a87092386424d6452", "srcset": "https://si.imgix.net/4305cfbb/uploads/origins/561e0c1d-1b46-49a8-b6b1-1dd409def184?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1a4dee54a93f2e6a87092386424d6452, https://si.imgix.net/4305cfbb/uploads/origins/561e0c1d-1b46-49a8-b6b1-1dd409def184?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a1f5302022fef1a7acfa511c6659077 2x, https://si.imgix.net/4305cfbb/uploads/origins/561e0c1d-1b46-49a8-b6b1-1dd409def184?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2194343cd679595bc58f1a9b180453cc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4305cfbb/uploads/origins/561e0c1d-1b46-49a8-b6b1-1dd409def184?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4eb65c664d56ff664b32844377bfe05e", "srcset": "https://si.imgix.net/4305cfbb/uploads/origins/561e0c1d-1b46-49a8-b6b1-1dd409def184?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4eb65c664d56ff664b32844377bfe05e, https://si.imgix.net/4305cfbb/uploads/origins/561e0c1d-1b46-49a8-b6b1-1dd409def184?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=370b0f627348cae1b5d760728d4ca0c8 2x, https://si.imgix.net/4305cfbb/uploads/origins/561e0c1d-1b46-49a8-b6b1-1dd409def184?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=71a5f626f9fa129509b0671be9d8f8b0 3x"}, "body": "Twitter等で使用するアイコン/ヘッダの依頼となります。宜しくお願いします。\n\n○キャラ\nSoundVoltexの氷雪ちゃんとオルトリンデ\n\n○シチュエーション\nボルテ学園の学園祭でメイド喫茶をやっているというシチュエーションで、メイド服を着た二人が並んでいる絵\n\n○構図、服装など\n・メイド喫茶なのでもちろんメイド服\n→メイド服のイメージは参考URLを参照願います。一般的なものよりえっちなテイストにしてもらえるといいと思います。\n\n・並んだ二人でハートマークを作る\n→こちらもイメージは参考URLを参照下さい。\n\n・オルトリンデは赤縁のアンダーリムを着用\n\n・胸は盛り気味に\n→ここは可能なら