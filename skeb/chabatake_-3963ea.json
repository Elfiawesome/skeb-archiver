scover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@chabatake_/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1939323, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8a2924e1/uploads/origins/97f5bbb9-986b-4df6-be90-dab54e842226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcf294a83052a044b0d722abd069a07e", "srcset": "https://si.imgix.net/8a2924e1/uploads/origins/97f5bbb9-986b-4df6-be90-dab54e842226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bcf294a83052a044b0d722abd069a07e, https://si.imgix.net/8a2924e1/uploads/origins/97f5bbb9-986b-4df6-be90-dab54e842226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f4b428b86cbe2c5618f0b24833f16d05 2x, https://si.imgix.net/8a2924e1/uploads/origins/97f5bbb9-986b-4df6-be90-dab54e842226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c56f95dcfc23a9ae8a378009caa42261 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8a2924e1/uploads/origins/97f5bbb9-986b-4df6-be90-dab54e842226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d8f9de85cb31bb2155189feac2e5407", "srcset": "https://si.imgix.net/8a2924e1/uploads/origins/97f5bbb9-986b-4df6-be90-dab54e842226?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d8f9de85cb31bb2155189feac2e5407, https://si.imgix.net/8a2924e1/uploads/origins/97f5bbb9-986b-4df6-be90-dab54e842226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3873401322d2efd6527347211cb9282b 2x, https://si.imgix.net/8a2924e1/uploads/origins/97f5bbb9-986b-4df6-be90-dab54e842226?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3131dc57ae96d0af459be721bf27a96d 3x"}, "body": "茶畑ゆのみ様\n他の依頼をさせて頂いている中大変恐縮ですが、\nもう一つ依頼させて頂けないでしょうか？\n\n＜依頼内容＞\n経産婦な紲星あかり(萌)ちゃんにパイズリしてもらってるイラストをお願いします。\n可能であればあかり萌ちゃんはボテ腹だと嬉しいです。\n\n＜設定＞\n赤ちゃんにおっぱいをあげていたあかり萌ちゃんに\n欲情したマスターがお願いしてパイズリしてもらっているという場面をお願いします。\n\n出産して間もなく(ボテ腹なら安定期に入っていない等の理由で)、体に負担がかかるため挿入などはできず、\nでもマスターに応えたいから小さなおっぱいで頑張って尽くしてくれる感じでお願いします。\n\n＜構図＞\n服は上からはだけて(脱いで)おり、おっぱいとお腹が露出している。\nスレンダー体型でおっぱいはぺったんこで乳首も小さいと嬉しいです。\n\n男性の股間ぐらいの背丈で、少し胸を突き出しているような構図でお願いします。\n視点はお任せします。主観視点でも横からの視点でも描きやすいように描いてください。\n\n＜セリフ＞\n「もう…赤ちゃんにごはんあげてたところだったのに」のような赤ちゃんについて言及したセリフや、\n「早くしないと幼稚園に遅れちゃう」或いは「…今日も幼稚園休んじゃうおっか」\n等のようなセリフがあると嬉しいです。\n\n＜その他＞\n・赤ちゃんの描写はなくて大丈夫です。セリフの中での言及されていれば十分です。\n・母乳の描写もなくて大丈夫です。\n\n~~~~~~~\n以上です。\n今回も大変趣向に偏っております。\nまた、他の依頼をしているということもありご多忙かと思いますので、\nキャンセルなり、お値段が釣り合わなければ再送依頼していただければ対応します。\n\nどうぞよろしくお願いいたします。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@chabatake_/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1939323, "client_id": 626297, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/85ad995f/uploads/origins/87a43ee5-520c-4ec3-99a1-e0109553649b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0e942251d31ce9ac34a3a707a6216db", "srcset": "https://si.imgix.net/85ad995f/uploads/origins/87a43ee5-520c-4ec3-99a1-e0109553649b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a0e942251d31ce9ac34a3a707a6216db, https://si.imgix.net/85ad995f/uploads/origins/87a43ee5-520c-4ec3-99a1-e0109553649b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0d2610fc71668e8a5186d43ee24883b 2x, https://si.imgix.net/85ad995f/uploads/origins/87a43ee5-520c-4ec3-99a1-e0109553649b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=585d40ae75830f775f496a1e2c980edf 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/85ad995f/uploads/origins/87a43ee5-520c-4ec3-99a1-e0109553649b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3b3963f81d929526fcbbc17cbd14c26", "srcset": "https://si.imgix.net/85ad995f/uploads/origins/87a43ee5-520c-4ec3-99a1-e0109553649b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3b3963f81d929526fcbbc17cbd14c26, https://si.imgix.net/85ad995f/uploads/origins/87a43ee5-520c-4ec3-99a1-e0109553649b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=841cea9d1f2edf57bb46f1bcc923bd12 2x, https://si.imgix.net/85ad995f/uploads/origins/87a43ee5-520c-4ec3-99a1-e0109553649b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ef6e51a1b2a728119261342338be94e1 3x"}, "body": "茶畑ゆのみ様\n\n前回は素晴らしいチルノさん大妖精さんをありがとうございました。\n今回も先生に同じ二人を、黒インナー姿でお願いしてもよろしいでしょうか？\n\n先生の他のリクエストでも描かれていましたが\nhttps://www.pixiv.net/artworks/84267147\nこちらのアイちゃんつめあわせで描かれているような\n黒のインナー（ボディスーツ）にトップスを着た姿で\nチルノさんと大妖精さんをリクエストいたします。\n\nトップスを含めた全体の服装は先生の描きやすい、描きたいデザインで問題ございません\nその他構図やシチュエーションについてもお任せでお願いしたく存じます。\n\n念の為再度二人の資料URL等を記載いたします。\nhttps://twitter.com/ARINOMI7/status/1549022259926695938\n　二人の身長体格は同じ位(強いて言えば チルノさん≧大妖精さん)\n　体付きは薄いスレンダー体型で、お胸も差が無く二人ともそろって無乳系のイメージです\n\nもしよろしければご検討下さいますよう、何卒お願い申し上げます。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@chabatake_/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1939323, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eeabbaba/uploads/origins/6128c708-6c7d-478e-a683-0b301b1d22ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4aba4e97639390b02d5e2f2cb89ff0b0", "srcset": "https://si.imgix.net/eeabbaba/uploads/origins/6128c708-6c7d-478e-a683-0b301b1d22ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4aba4e97639390b02d5e2f2cb89ff0b0, https://si.imgix.net/eeabbaba/uploads/origins/6128c708-6c7d-478e-a683-0b301b1d22ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5c51bab43b8b233d87cbfb447f5b3ca6 2x, https://si.imgix.net/eeabbaba/uploads/origins/6128c708-6c7d-478e-a683-0b301b1d22ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2aef8c130ffb747ded650ac3b355cc6c 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eeabbaba/uploads/origins/6128c708-6c7d-478e-a683-0b301b1d22ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d411964deb7f631d386450117b0f5c85", "srcset": "https://si.imgix.net/eeabbaba/uploads/origins/6128c708-6c7d-478e-a683-0b301b1d22ee?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d411964deb7f631d386450117b0f5c85, https://si.imgix.net/eeabbaba/uploads/origins/6128c708-6c7d-478e-a683-0b301b1d22ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4829fa3640f69c3142a3d663af1f55bd 2x, https://si.imgix.net/eeabbaba/uploads/origins/6128c708-6c7d-478e-a683-0b301b1d22ee?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dc1716bf64e42b9fee5ae90c00ef5fca 3x"}, "body": "いつも楽しみにしております。\n少し前に挙げられていた\n「【Skeb】月読アイちゃんでボテ腹騎乗位シチュ」、その直後の「アイちゃん」が最高でした！\n近しい内容になってしまうかもしれませんが良ければ依頼させて頂けたらと存じます。\n\n＜内容＞\nボテ腹アイちゃんがたくし上げてお腹とすじを見せてくれているシチュエーションをお願いします。\n\nいつもの園児服(?)。\n座った状態で、あまり恥じらわずにたくし上げ、ボテ腹を見せつけており、\n元気そうだったり幸せそうな表情で、お腹の大きさや子供についてお腹を見せつけながら会話している。\nスカートの下は何も履いておらずすじも丸見えになってしまっている。\n\n恥じらっていないのは無知が理由ではなく、\n「お前がこんなに(ボテ腹)したんたぞ」とか\n散々見たことに言及するセリフがあると嬉しいです。\n\n＜差分＞\nもし可能であれば恥じらっていないアイちゃんをすじを触って恥じらわせる場面があると嬉しいです。\n(男性の描写は腕のみ等、簡略化していただいて構いません。)\n\n以上です。\n表情など差分を要求している形になっております。\nお値段等釣り合わなければ再送依頼等していただければ対応いたします。\n\nどうかよろしくお願いします。", "nc": 169, 