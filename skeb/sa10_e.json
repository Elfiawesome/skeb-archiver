お借りしたお相手への共有、お相手側でのSNSへの投稿等や上記の使用。\n\nPSDファイルで納品お願いします。\n宛名なしも別ファイル(png可)にて納品お願いします。\nまたサインと宛名につきましてはPSDレイヤーで別々にon/off出来ると嬉しいです。\n\n[設定・資料]\n\n小生意気な後輩系で人見知りの内弁慶です。\nキャラクターについては資料URLをご参照ください。\n※人の耳はありません。最後に尻尾を忘れてないか確認してください。\n\n翠ちゃん資料_251028\nhttps://drive.google.com/drive/folders/1eTlmqneZq4eoO7CBC2KxD83Z0dlHvml2?usp=sharing\n\n笠鬼聖ちゃん資料\nhttps://x.com/party_room/status/1734289774834524397?s=46&t=49HaRTLeBNak9CMmAM4iYg\n\nhttps://www.dropbox.com/scl/fo/40axbnqwbr4yewofvjn6u/APQg6diHSbP8UH6eD6uRwWQ?rlkey=2qge3eixys9mq07wwaddc003i&st=6o40cqia&dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sa10_e/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3828814, "client_id": 2799018, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d0ca009/uploads/origins/e578f646-b4de-4e40-ba50-0446a2bf0d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d34b00dfecd4ae58feb2f4bae014ba3d", "srcset": "https://si.imgix.net/4d0ca009/uploads/origins/e578f646-b4de-4e40-ba50-0446a2bf0d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d34b00dfecd4ae58feb2f4bae014ba3d, https://si.imgix.net/4d0ca009/uploads/origins/e578f646-b4de-4e40-ba50-0446a2bf0d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa53197ff8857817d0f91f6fd898c146 2x, https://si.imgix.net/4d0ca009/uploads/origins/e578f646-b4de-4e40-ba50-0446a2bf0d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92548890eabb6b393be25dcf655058df 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d0ca009/uploads/origins/e578f646-b4de-4e40-ba50-0446a2bf0d2e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=294df018b07f77e6e0345f130d0358a6", "srcset": "https://si.imgix.net/4d0ca009/uploads/origins