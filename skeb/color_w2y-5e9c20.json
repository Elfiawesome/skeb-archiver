で使用させていただく可能性があります。\nまた、今後この楽曲に歌詞を付け、歌として制作・使用させていただく可能性もあります。\n\nぜひご検討いただけますと幸いです。\nどうぞよろしくお願いいたします。", "nc": 128, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@color_w2y/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "music", "tipped": false, "creator_id": 3896688, "client_id": 4017098, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1916449287082573824%2FJpRkjsP4.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acb6c1f21d412044cf8f7c46529d6d93", "srcset": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1916449287082573824%2FJpRkjsP4.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=acb6c1f21d412044cf8f7c46529d6d93, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1916449287082573824%2FJpRkjsP4.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d0f0f6a3a23cd46705d24b213ee3288 2x, https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1916449287082573824%2FJpRkjsP4.jpg?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d61c96fe3488757e4a149be45134c1f0 3x"}, "preview_url": "https://fcdn.skeb.jp/uploads/outputs/d9b9edac-b86b-4c37-9623-0476b795542d?response-content-disposition=inline&Expires=1795563401&Signature=Un99ab~bjLL0FQtQg~ywr5Bz4HnF3pmuWUISD~~V7vyB9oY4aVdf2XWBrJgTRoLNZBBhSFuY4rDaQxix2T1vtJx0T-1-2kD3Zqu1Jl~v1GRoOq6U6cqkJldQd7CdfpgsLwvE0BYRwcFgFbA0jfCswy03HyAydJYVjI--mW8fhHMWG6trJ-2i-awttn11kfd9aOhlhH7fr3~CH9dTddr2HFD4JNLfSOV5ZqDp~LQF2qDoGVIhj6wOpcB4bARx4w9u28wvtxQxp1rUInqVhCtly-VHB08rdrjlXyNIZqc0hab4Qzc6WopD-Jh8AykGr3teV6FYHg7AY0xRfQk-gGzJ-A__&Key-Pair-Id=K1GS3H53SEO647", "duration": 89, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%