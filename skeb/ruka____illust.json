たいです\n背景がある場合は背景とキャラクターを分けたものを納品していただけると大変助かります！\n\n■キャラクター詳細\n・マーメイドです\n・元気でおバカなキャラです\n・イメージカラーは水色と赤です\n\nご縁がありましたらどうかよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1Ov4penW6Mo9fkt_VViVTYhkHTht4mr6W?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 592919, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ろく（だしじお）", "screen_name": "roku3358", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fwebpublic-cb03aa15-4eaf-4f84-af1c-e5816b60eb00.webp&avatar=1", "header_url": null, "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 129}, {"id": 1381029, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "suzuno", "screen_name": "suzuno3110", "avatar_url": "https://pbs.twimg.com/profile_images/1745636408021434368/kkrfwyqv.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1396366491704991753/1752055384/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "skills": [{"genre": "art"}], "nc": 1}, {"id": 2598228, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ななたぬき@skeb募集中", "screen_name": "nanatanunyan", "avatar_url": "https://pbs.twimg.com/profile_images/1708707855526977536/1kIpKn1X.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2872209146/1759364782/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 5, "skills": [{"genre": "art"}], "nc": 33}, {"id": 3534349, 