ff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=236410fcd9d60234d165b384cd0c5f81", "srcset": "https://si.imgix.net/9cff1728/uploads/origins/42315d91-5b9a-42f7-99ac-a7dde2ef0672?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=236410fcd9d60234d165b384cd0c5f81, https://si.imgix.net/9cff1728/uploads/origins/42315d91-5b9a-42f7-99ac-a7dde2ef0672?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2bef082160acab20cf2567710706f390 2x, https://si.imgix.net/9cff1728/uploads/origins/42315d91-5b9a-42f7-99ac-a7dde2ef0672?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4d746db513aae6d59fc74fc8fad4f823 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9cff1728/uploads/origins/42315d91-5b9a-42f7-99ac-a7dde2ef0672?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f623750464ffc0ec662bf60325d0f7e2", "srcset": "https://si.imgix.net/9cff1728/uploads/origins/42315d91-5b9a-42f7-99ac-a7dde2ef0672?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f623750464ffc0ec662bf60325d0f7e2, https://si.imgix.net/9cff1728/uploads/origins/42315d91-5b9a-42f7-99ac-a7dde2ef0672?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cb373c8796b374cf4f385995d99431ca 2x, https://si.imgix.net/9cff1728/uploads/origins/42315d91-5b9a-42f7-99ac-a7dde2ef0672?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=163323ea5fcd6dfaa4045b7129504b88 3x"}, "body": "いつもお世話になっております！\n\n今回、もし可能であれば「miniscape eudemonics」もしくは「overlap:Q」関係の絵をご依頼したいです。\nシチュエーション、構図等は全ておまかせいたしますのでお好きに描いてください。\nあの世界観がもう一度見たい！という願望からのリクエストです。でもシリアス寄りだと……大変に喜びます……。\n言いつつ使えるキャラクターが限られてしまうとは思うのですが、4651さんのNPCのみor我が家のキャラクター使用していただく……も描きやすいようにで大丈夫です。\n\n以上、お手すきの折にご検討いただけますと幸いです。\nどうぞよろしくお願いいたします。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_