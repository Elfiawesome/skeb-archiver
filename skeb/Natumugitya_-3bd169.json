imgix.net/a23a65c6/uploads/origins/bc107c1f-2989-4170-b1ab-04b079d0036e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4657a9ed94190e11ef9b05b1f4c3d9ba, https://si.imgix.net/a23a65c6/uploads/origins/bc107c1f-2989-4170-b1ab-04b079d0036e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b4fe2e995c169791de972b64ba84dc07 2x, https://si.imgix.net/a23a65c6/uploads/origins/bc107c1f-2989-4170-b1ab-04b079d0036e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=260676c1e0cd3e68a86274302e61804c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a23a65c6/uploads/origins/bc107c1f-2989-4170-b1ab-04b079d0036e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2246019025123868a325ca544679d7f8", "srcset": "https://si.imgix.net/a23a65c6/uploads/origins/bc107c1f-2989-4170-b1ab-04b079d0036e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2246019025123868a325ca544679d7f8, https://si.imgix.net/a23a65c6/uploads/origins/bc107c1f-2989-4170-b1ab-04b079d0036e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7da8f5e5bcf09e31a6dd96705cb8a0e1 2x, https://si.imgix.net/a23a65c6/uploads/origins/bc107c1f-2989-4170-b1ab-04b079d0036e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b1a97ecbc120c6f42ded3ee2ac3078ed 3x"}, "body": "こんにちは、はじめまして。作品を描いていただけないでしょうか。\n\n作品は2人のキャラクターが朝食を共にするものです。名前は「スヴェトラーナ」と「ブルータス」です。\n\nFate/Stay NightやFGOをご存知ですか？もしそうなら、二人の関係がマスターとサーヴァントであることをご存じだろう。スヴェトラーナはロシア人の少女で、彼女のサーヴァントであるローマ人のブルータスという男の主人である。二人はお互いに遊び好きで楽しい雰囲気を持っている。ブルータスはよく彼女の胸に目をやり、彼女は自信ありげにからかうようなそぶりを見せるが、肉体関係はない。\n\nスヴェトラーナ：https://drive.google.com/file/d/13F5Mme6ALr9iJW87XPQDAnvSTSntZJPc/view?usp=drive_link\n\nブルータス: https://drive.google.com/file/d/1y-EL3ZIkXK0RpAZnw2Va1gAhM6jufbmt/view?usp=drive_link\n\n二人が分け合って食べているのは、彼女が自分で作った「シルニキ」というロシア料理だ。チーズケーキを揚げた小さなパンケーキのようなものだ。料理の写真を提供します。\n\n\"シルニキ\": https://drive.google.com/drive/folders/1zc-XOUb2786lpggOcE_XLwvdShPAHcZ-?usp=sharing\n\nそれぞれ4～6個の \"シルニキ \"が皿に盛られている。すでに食べられたものもあるかもしれない。\n\n彼らはまた、一緒にウォッカを飲むのを楽しんでいる。二人ともウォッカのグラスを持っており、ボトルもテーブルの上に見える。\n\nウォッカのボトル：https://drive.google.com/file/d/1Ah0wsWSvLr1g3vOgo0JVb78d2bvmbW5A/view?usp=drive_link\n\n朝食は1945年のヨーロッパの素敵なアパートで行われる。念のため言っておくが、背景を含めたいのであれば、現代的な電化製品は入れないこと。\n\nこの瞬間は、ストレスフルな状況から解放され、食事をしながらお互いの時間を楽しむ。\n\nご検討ありがとうございました。", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Natumugitya_/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3155741, "client_id": 41262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b5088468/uploads/origins/e53aa154-a95a-4412-8e18-9277a35f5136?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c1ae907425f8c0147f615c59a10811b", "srcset": "https://si.imgix.net/b5088468/uploads/origins/e53aa154-a95a-4412-8e18-9277a35f5136?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9c1ae907425f8c0147f615c59a10811b, https://si.imgix.net/b5088468/uploads/origins/e53aa154-a95a-4412-8e18-9277a35f5136?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2055719ba8fb6a49807ceefc93d3b411 2x, https://si.imgix.net/b5088468/uploads/origins/e53aa154-a95a-4412-8e18-9277a35f5136?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a4bd9ec4397fffdf6ea8650541b674b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b5088468/uploads/origins/e53aa154-a95a-4412-8e18-9277a35f5136?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab1884e55fe9f7e80665e43e55712349", "srcset": "https://si.imgix.net/b5088468/uploads/origins/e53aa154-a95a-4412-8e18-9277a35f5136?