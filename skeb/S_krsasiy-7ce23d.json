f-a27cd321d43d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c66c7c7b3a5f0b768b016743a133ae7, https://si.imgix.net/2f4f95e1/uploads/origins/c690eda2-bbb5-4aac-88ff-a27cd321d43d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=381fd6e4626dcc620b225c3353df61bd 2x, https://si.imgix.net/2f4f95e1/uploads/origins/c690eda2-bbb5-4aac-88ff-a27cd321d43d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=d4bfdf194085a32232256a0b27f6edd0 3x"}, "body": "オリジナルキャラクター（コテキャ）のイラストをお願いいたします。\n\n構図やシチュエーションは先生にお任せしたいです。\n先生の描かれるイラストが大好きなので、いつもの先生らしい世界観で描いていただけたらとても嬉しいです。\n\n個人的には、しっかり塗り込まれたイラストよりも、ラフ感のある白黒メインの表現に部分的な差し色が入るような雰囲気が好みです。\nただ、こちらも参考程度で大丈夫です。\n\nキャラクターの特徴\n・ダウナー系のお姉さん\n・ストレートロング（髪型詳細はお任せ）\n・ぱっつん前髪\n・黒髪ベース（紫のインナーやメッシュがあると嬉しいです）\n・かなり色白\n・大きめの猫目\n・アイライン強め、束感まつ毛\n・ピアス\n　左耳：アンテナヘリックス2個、ロブ2個\n　右耳：ロブ1個\n　舌ピアス1個（写っていてもいなくても大丈夫です）\n・服装は黒メインで雰囲気に合うものなら何でも大丈夫です\n・ネイルは黒オンリーネイル\n\nイメージモチーフ\n黒猫／骨／ホラー／日本人形／ドール／包帯／ゴシック／V系／悪魔／堕天使\n\n上記はあくまで参考程度で、先生の作品や雰囲気が本当に大好きなので、私のキャラクター要素から先生が自由に想像してくださった姿を見てみたいです。\n細かなこだわりは特にありませんので、先生の解釈で描いていただけたら嬉しいです。\n宛名に関しては平仮名、カタカナ、英語問いません、作品の雰囲気に会うような形で大丈夫です！\n\nどうぞよろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@S_krsasiy/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3758886, "client_id": 3513509, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9c2c7bf/uploads/origins/001c7257-ec0f-4e23-b8ce-0bab5eaeda89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b45f2810db9b740431a1ce76cca70947", "srcset": "https://si.imgix.net/a9c2c7bf/uploads/origins/001c7257-ec0f-4e23-b8ce-0bab5eaeda89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b45f2810db9b740431a1ce76cca70947, https://si.imgix.net/a9c2c7bf/uploads/origins/001c7257-ec0f-4e23-b8ce-0bab5eaeda89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=156d14b5aa18b969eaa4c33fdd69f3e7 2x, https://si.imgix.net/a9c2c7bf/uploads/origins/001c7257-ec0f-4e23-b8ce-0bab5eaeda89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6d668eac10704659eb5e0328760f69ab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9c2c7bf/uploads/origins/001c7257-ec0f-4e23-b8ce-0bab5eaeda89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0fb7d5276b05c206f7a8df08bf896ffb", "srcset": "https://si.imgix.net/a9c2c7bf/uploads/origins/001c7257-ec0f-4e23-b8ce-0bab5eaeda89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0fb7d5276b05c206f7a8df08bf896ffb, https://si.imgix.net/a9c2c7bf/uploads/origins/001c7257-ec0f-4e23-b8ce-0bab5eaeda89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8e4e73c2371afdb5d619ba3eb24c55e0 2x, https://si.imgix.net/a9c2c7bf/uploads/origins/001c7257-ec0f-4e23-b8ce-0bab5eaeda89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fe76e61f2749d2c26f9a07a02b6bada0 3x"}, "body": "こんにちは！ソーシャル・メディアであなたのアートワークを見つけ、とても気に入りました^^あなたのイラストのいくつかは、私のキャラクターの伝承を思い起こさせたので、ぜひ一緒に仕事をしたいと思いました〜。\n\n私のキャラクターはかつて天使でしたが、天界から追い出されました。彼は悪魔と交流することを禁じられていたので、高位の天使たちは彼の翼を切り落として持ち去った。翼があった背中には傷跡が残った。この出来事の後、彼は悪魔となった。\n\nリクエストです：\n私のキャラクターを、翼を切り落とされたばかりのイラストで描いていただけませんか？表情の一部が手で隠れるような感じで。顔はまだ見えます。彼は動揺して怒っているでしょう。切り落とされた羽は地面に落ちていて、羽毛が散らばっていてもいい。服のデザインはあなた次第です。\n\nリファレンスには、私がとても気に入ったあなたのアートをいくつか載せました！\n\nhttps://drive.google.com/drive/folders/1PVH6xwDddW3CDX9UKcOE61FUeZzy-r8m", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@S_krsasiy/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3758886, "client_id": 2581549, "vtt_url": null, "t