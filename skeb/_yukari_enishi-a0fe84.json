er.me/page/6885bcf122301 でご覧いただけますが、作りながら公開し、追加・変更を繰り返して完成を目指しているものとなりますので、以下に「今後変更の可能性が低い設定」を列挙いたしました。こちらのみを参考に曲のイメージを膨らませていただいて構いません。\n\n\n・タイトル：ZENOS（ゼノス）\n・舞台：潮汐ロックされた地球型惑星\n・ルクス（昼の世界）：科学文明・SF風 / 住民は金髪・青眼\n・ノクス（夜の世界）：術文明・中世ヨーロッパ風 / 住民は黒髪・黒眼\n・2つの世界は「トワイライト・ゾーン」によって隔絶されている\n・ルクス側主人公は「ソル」（男性・40代後半〜50代前半）\n・ノクス側主人公は「サヨ」（女性・20代半ば）\n・2人が出会うことで物語が動き始め、惑星の真実が明らかになる\n\n\n▼お願いしたい楽曲のイメージ\n\n・ゲームの「タイトルBGM」のような尺・雰囲気\n・SFよりもファンタジー寄り、穏やかで優しい曲調\n・静かにゆっくりと物語が動き始めるイメージ\n・ループ対応\n\n\n▼楽曲の使用について\n\n完成した楽曲は、主に創作のモチベーション維持のために個人で聴かせていただく予定ですが、もしご許可いただけるようであれば、ZENOSのページにて「世界観をイメージして作っていただきました」とご紹介をさせていただきたいと考えております。ご検討いただけましたら幸いです。\n\nhttps://privatter.me/page/6885bcf122301", "nc": 16, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": true}, {"path": "/@SousakuChun/works/61", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 611, "client_id": 1899, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b314c8e5/uploads/origins/a227e9e1-4a99-4fcf-8fa8-97fc1f198c52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67a703037923f36b5e4ffd8507650b5b", "srcset": "https://si.imgix.net/b314c8e5/uploads/origins/a227e9e1-4a99-4fcf-8fa8-97fc1f198c52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=67a703037923f36b5e4ffd8507650b5b, https://si.imgix.net/b314c8e5/uploads/origins/a227e9e1-4a99-4fcf-8fa8-97fc1f198c52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0c864776a7f7775f7729bd5e754efc58 2x, https://si.imgix.net/b314c8e5/uploads/origins/a227e9e1-4a99-4fcf-8fa8-97fc1f198c52?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=242e1b9a90fac4f3dfd75501bff2645c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b314c8e5/uploads/origins/a227e9e1-4a99-4fcf-8fa8-97fc1f198c52?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200