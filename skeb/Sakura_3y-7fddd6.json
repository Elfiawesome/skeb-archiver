&fit=crop&crop=top&w=200&h=200&s=e9364be09239b5faa0d862824f8f2eb9, https://si.imgix.net/27573b74/uploads/origins/89e065c9-dbff-41c3-b4a7-b6b72ca58e6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c121d07b5c6840de1afe806cc7657b9 2x, https://si.imgix.net/27573b74/uploads/origins/89e065c9-dbff-41c3-b4a7-b6b72ca58e6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8a57ecb899f0a32ded373e4b11b5a32 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/27573b74/uploads/origins/89e065c9-dbff-41c3-b4a7-b6b72ca58e6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4eaa0682af5a1809aacfec443b3830ed", "srcset": "https://si.imgix.net/27573b74/uploads/origins/89e065c9-dbff-41c3-b4a7-b6b72ca58e6e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4eaa0682af5a1809aacfec443b3830ed, https://si.imgix.net/27573b74/uploads/origins/89e065c9-dbff-41c3-b4a7-b6b72ca58e6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d5ef3c2dc388f8b8ca17b5e7f21f6372 2x, https://si.imgix.net/27573b74/uploads/origins/89e065c9-dbff-41c3-b4a7-b6b72ca58e6e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8afc69d31b4220cd459705b04d4c5ad2 3x"}, "body": "櫻倉様\n\n初めましてこんにちはこんばんは\n初めて櫻倉様のイラストを拝見させていただいたときとても素晴らしい絵を描いていて依頼してみたいなと思い、今回依頼の募集を開始したとのことでしたので下記内容にて依頼させていただきます。\n\n【以下内容】\n\n・キャラクター：逢坂茜（オンゲキ）\n・衣装：シュータドレス（下記にて詳細説明します）\n\nこちらのキャラクターはSEGA社のアーケード音楽ゲーム「オンゲキ」内に登場するキャラクターです。キャラクターについて軽く説明しますとハチャメチャな性格でいつもトラブルばかり引き起こしてくれるけどいざというときには頼りになる生徒会長です。（参考ＵＲＬにもプロフィールが記載してあるのでそちらもご覧ください。）\n\n衣装については参考ＵＲＬを確認していただきたいのですが、制服と赤い軍服が見えると思いますが今回は赤い軍服でお願いします。（衣装チェンジをクリックしていただければ全体がよく見えます。）\n\nちなみに帽子に小さな文字が書いてありますが「President!」と書いてあります。\n\n構図につきましては仁王立ちして腕を組んでる感じでお願いします。\n表情はかっこいい感じに仕上げてもらえばと思います。（参考ＵＲＬのような表情でもＯＫです）\n\n一応かっこよく強者感があるイメージで描いていただければと思います。\n\n背景については燃え上がる炎がバックにある感じでお願いします。（背景はもし可能であればつけていただければなので無しでも構いません。）\n\n太もも（だいたい膝と腰の中間くらい）より上が見えていれば全体を描いていただく必要はありません。\n\nなお参考ＵＲＬで何か宙に浮かんでいるのはロケットランチャーですがこちらを描くかは完全にお任せします。\n\nもしご縁がございましたらよろしくお願い致します。\n\nhttps://ongeki.sega.jp/character/1120/", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sakura_3y/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1925243, "client_id": 62494, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d635d799/uploads/origins/44a0cf76-cedf-430d-9fcd-84110e7ed1a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc51ed99c9fa419aac3bf054b12b4fd0", "srcset": "https://si.imgix.net/d635d799/uploads/origins/44a0cf76-cedf-430d-9fcd-84110e7ed1a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bc51ed99c9fa419aac3bf054b12b4fd0, https://si.imgix.net/d635d799/uploads/origins/44a0cf76-cedf-430d-9fcd-84110e7ed1a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=230de8f57e0e5798414d7d9c176abd77 2x, https://si.imgix.net/d635d799/uploads/origins/44a0cf76-cedf-430d-9fcd-84110e7ed1a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c1f3aa7064711039e1dda12e32982994 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d635d799/uploads/origins/44a0cf76-cedf-430d-9fcd-84110e7ed1a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e41371585755471d646607500aea24a8", "srcset": "https://si.imgix.net/d635d799/uploads/origins/44a0cf76-cedf-430d-9fcd-84110e7ed1a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e41371585755471d646607500aea24a8, https://si.imgix.net/d635d799/uploads/origins/44a0cf76-cedf-430d-9fcd-84110e7ed1a4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200