髪や顔が見切れない構図だと大変助かります。\n・人物と背景を分けたデータで納品いただけますと幸いです。(psd可)\n\n【参考資料】\nhttps://drive.google.com/drive/folders/1k8IKgKhD6pivKCX3fTyVdP3L09olmX8d\n\n\nお忙しいところ恐縮ですがご検討のほどよろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsurup0210/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3447214, "client_id": 866592, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/eb9a657f/uploads/origins/49c4f6cc-ee31-4fb8-878a-0a14c3eb7164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=891daf1631bb7b6b8a122fcae4283409", "srcset": "https://si.imgix.net/eb9a657f/uploads/origins/49c4f6cc-ee31-4fb8-878a-0a14c3eb7164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=891daf1631bb7b6b8a122fcae4283409, https://si.imgix.net/eb9a657f/uploads/origins/49c4f6cc-ee31-4fb8-878a-0a14c3eb7164?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=987cdae7a065369c73cbfb94a47cc33f 2x, https://si.imgix.net/eb9a657f/uploads/origins/49c4f6cc-ee31-4fb8-878a-0a14c3eb7164?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7937605a7707e69102c0102f11bb5829 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/eb9a657f/uploads/origins/49c4f6cc-ee31-4fb8-878a-0a14c3eb7164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37a2b5d360d5f8188dedd74c50015904", "srcset": "https://si.imgix.net/eb9a657f/uploads/origins/49c4f6cc-ee31-4fb8-878a-0a14c3eb7164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37a2b5d360d5f8188dedd74c50015904, https://si.imgix.net/eb9a657f/uploads/origins/49c4f6cc-ee31-4fb8-878a-0a14c3eb7164?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b6bbcd253c473add32a6bbfcb8b3767d 2x, https://