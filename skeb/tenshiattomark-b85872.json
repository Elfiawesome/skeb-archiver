願いします！", "nc": 8, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 121955, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "Kariage", "screen_name": "kuro1415", "avatar_url": "https://pbs.twimg.com/profile_images/1871714331467161600/8-qfyHbs.jpg", "header_url": "https://pbs.twimg.com/profile_banners/114061363/1711643203/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "correction"}], "banned": false, "nc": 1}, {"id": 937883, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "多加那ｳｫﾆ", "screen_name": "WoNi_o_o_", "avatar_url": "https://pbs.twimg.com/profile_images/1735317765001760768/3jLZmwWQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1299126326272565251/1706490644/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "voice"}, {"genre": "art"}], "banned": false, "nc": 128}, {"id": 2944138, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "kou_", "screen_name": "kou_mgmg", "avatar_url": "https://pbs.twimg.com/profile_images/1979414653487734784/I_nT4bsM.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1640761641284538368/1720688270/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 3033447, "creator": true, "nsfw_acceptable": fa