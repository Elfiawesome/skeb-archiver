くお願いします！", "nc": 25, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 228025, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "🍀リーリヤ・オリガレイラ💀", "screen_name": "Liliya_Mesyats", "avatar_url": "https://pbs.twimg.com/profile_images/1737777799841337344/8oDQOvFs.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1163641354653618178/1711885403/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "voice"}, {"genre": "correction"}], "banned": false, "nc": 145}, {"id": 937883, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "多加那ｳｫﾆ", "screen_name": "WoNi_o_o_", "avatar_url": "https://pbs.twimg.com/profile_images/1735317765001760768/3jLZmwWQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1299126326272565251/1706490644/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 120, "skills": [{"genre": "voice"}, {"genre": "art"}], "banned": false, "nc": 129}, {"id": 2289087, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "アポロ20号", "screen_name": "ApolLo_choco_", "avatar_url": "https://pbs.twimg.com/profile_images/1961143390470537216/czWGFnnS.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1468210255129903108/1757884354/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 1}, {"id": 2468019, "cr