願いします！", "nc": 153, "word_count": 0, "transcoder": "audio", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": []}, "price_history": {"voice": [{"amount": 3000, "recorded_at": 1774048644.006123}, {"amount": 4000, "recorded_at": 1779858486.545334}, {"amount": 3000, "recorded_at": 1780574110.847812}, {"amount": 4000, "recorded_at": 1781257244.443622}, {"amount": 3000, "recorded_at": 1781872585.640128}]}, "custom": {}}