コンにすることを気にせず描いていただきたいです。\n\n付け加えたり、変更したり、大歓迎です。\n\nお忙しいところ申し訳ありません。難しい場合キャンセルお願いします。\nご検討よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1-j1QLRIIQQjijQGm-10wL5GG1nW0GoXx", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@o22_r0/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3015235, "client_id": 3606322, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/779c88b0/uploads/origins/9d448524-6b3e-422c-a3c2-6e6eaba0f97f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a796fe528789d9a1dccc17f92426674e", "srcset": "https://si.imgix.net/779c88b0/uploads/origins/9d448524-6b3e-422c-a3c2-6e6eaba0f97f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a796fe528789d9a1dccc17f92426674e, https://si.imgix.net/779c88b0/uploads/origins/9d448524-6b3e-422c-a3c2-6e6eaba0f97f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e2d1983e9c62899958b7be59bdafab00 2x, https://si.imgix.net/779c88b0/uploads/origins/9d448524-6b3e-422c-a3c2-6e6eaba0f97f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1e0e504bb6c2dd408a6d84f98333f1e8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/779c88b0/uploads/origins/9d448524-6b3e-422c-a3c2-6e6eaba0f97f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c05474b43f661ab52ab3aa569eaefb1", "srcset": "https://si.imgix.net/779c88b0/uploads/origins/9d448524-6b3e-422c-a3c2-6e6eaba0f97f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5c05474b43f661ab52ab3aa569eaefb1, https://si.imgix.net/779c88b0/uploads/origins/9d448524-6b3e-422c-a3c2-6e6eaba0f97f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7f284bd29ec8ca653c3f3a5d31a7730e 2x, https://si.im