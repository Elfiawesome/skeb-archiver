ipped": true, "creator_id": 886361, "client_id": 76368, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f05e8920/uploads/origins/0e084223-3324-4a6d-abaa-59991dfb69d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cdb37eb90c77041944e7dc72eb8ceb51", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f05e8920/uploads/origins/0e084223-3324-4a6d-abaa-59991dfb69d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=087d41ff1ea62cbad52c69ea62e63a88", "src_set": ""}, "body": "こんにちは！Fateの玉藻の前です。Fateの玉藻の前が光のコヤンスカヤと闇のコヤンスカヤの両方を飲み込んでお腹がとても大きくなっている絵をお願いします。また、胸は通常よりも大きく、乳首が露出しているものを希望します。\n\n斉藤さんの描く狐娘も大好きなので、ぜひ玉藻を描いてほしいです。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Vore66291335/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 886361, "client_id": 549620, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1bbe5abe/uploads/origins/05973fb3-31e0-4e93-9612-7a75838ebae1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=81ec74eb54936ecbf2939d18a2148c2a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1bbe5abe/uploads/origins/05973fb3-31e0-4e93-9612-7a75838ebae1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9e851fc8411ca3636814394fe043418d", "src_set": ""}, "body": "竹林に迷い込んだ子供3人を食べちゃった影狼さんを、透過差分も合わせてお願いします！", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Vore66291335/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 886361, "client_id": 549620, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/23d9d38d/upload