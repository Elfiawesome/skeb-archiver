200&h=200&blur=200&s=df1475317066c2bd4efed430f33603c0 3x"}, "body": "お初にお目にかかります。\n東方projectの八雲藍を描いていただきたいです。\n10年以上前に描かれていたようなので今描いたらどんな風になるのか気になっています。\nNSFWな絵にするかどうかは任せます。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tamineko/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/4264df7a/uploads/origins/c916d249-8cd6-4df5-8d4e-e3745993db57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d436f66fcdcfe5fe775e6a89008f769", "srcset": "https://si.imgix.net/4264df7a/uploads/origins/c916d249-8cd6-4df5-8d4e-e3745993db57?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d436f66fcdcfe5fe775e6a89008f769, https://si.imgix.net/4264df7a/uploads/origins/c916d249-8cd6-4df5-8d4e-e3745993db57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=71fd71182279475c52e6c3f44ead4b73 2x, https://si.imgix.net/4264df7a/uploads/origins/c916d249-8cd6-4df5-8d4e-e3745993db57?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7f0d548b2748432c97c6c211cb1717d8 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 24338, "nc": 49}, {"path": "/@tamineko/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 24338, "client_id": 1711848, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f3f63db7/uploads/origins/73c5037f-9a55-46f9-8bfa-1fb1486ea84d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa8b70d9f8b97dd9c8b2e38c0d3ee7ec", "srcset": "https://si.imgix.net/f3f63db7/uploads/origins/73c5037f-9a55-46f9-8bfa-1fb1486ea84d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa8b70d9f8b97dd9c8b2e38c0d3ee7ec, https://si.imgix.net/f3f63db7/uploads/origins/73c5037f-9a55-46f9-8bfa-1fb1486ea84d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aef43f6cd667f18cae085209b8a29ded 2x, https://si.imgix.net/f3f63db7/uploads/origins/73c5037f-9a55-46f9-8bfa-1fb1486ea84d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c06496fb8eb1bb6470e9ab4b6f21ab91 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f3f63db7/uploads/origins/73c5037f-9a55-46f9-8bfa-1fb1486ea84d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=000c9fbca768fe74513677b26e408f7c", "srcset": "https://si.imgix.net/f3f63db7/uploads/origins/73c5037f-9a55-46f9-8bfa-1fb1486ea84d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=000c9fbca768fe74513677b26e408f7c, https://si.imgix.net/f3f63db7/uploads/origins/73c5037f-9a55-46f9-8bfa-1fb1486ea84d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b66d801df3c5460750aa9567c745f41f 2x, https://si.imgix.net/f3f63db7/uploads/origins/73c5037f-9a55-46f9-8bfa-1fb1486ea84d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=293831253653af4ac992123200b5e6b0 3x"}, "body": "初リクエストとなりますが、どうかご検討を宜しくお願いいたします。\n\n【登場人物】\n主人公：ウォーザードのレオ（腰布有り。ブーツあり。パンツなし。）相手：黒レオ（全裸）\n\n【シチュエーション】\n・深い森の中（でも昼）\n・黒レオのバックハグ状態からのキス責め（口を開かせて舌を絡ませようとキスで攻め立てている）\n・レオは目と口を閉じささやかな抵抗をしているが、下半身は正直にそそり立っている\n\n【ストーリー】\n深い森の中。\nレオは黒レオに背後から襲われ抱き締められ、身動きが取れない状態でした。\n黒レオの右手はレオの肉棒を腰布越しに、じわじわといたぶる様にゆっくりと上下に動かしています。\nそして左手はレオの左胸をもみしだいていて、その中指はレオの乳首をコリコリと弄んでいます。\nレオはその拘束から逃れようと、右手で黒レオの右手首を掴みかすかな抵抗を試み、左手は何かに助けを求める様に空に手を伸ばしています。\nレオは快感と屈辱から目を閉じ、顔を右後ろに背けようとします。\nですがそこには黒レオの容赦ないキスの攻撃が待ち構えていました。\n黒レオは、レオの口を開かせようとレオの唇をじゅるじゅると嘗め回します。\n「んうぅーーー！！」\nレオはせめてもの防御のつもりか、口を固く閉じます。\nが、黒レオは構わず唇を容赦なく嘗め回します。\n黒レオはレオのささやかな抵抗をこう解釈します。\n「マジで嫌なら力ずくで逃げ出すはずさ。お前の”下”は全く正直だぜ。本当は気持ち良くて堪らないんだ。お前は唇を開かせてくれる程のキスが欲しいんだ。そうだろ？」\n黒レオの思いに答えるように、レオの肉棒はどんどん硬く高くそそり立っていきます。\nやがて、\n「ぐあぁぁーーーーっ！」\n悲鳴と共にレオは絶頂に達し、大量の精子を発射します。\n悲鳴と共に口が開かれたのを黒レオは見逃しませんでした。\nすかさず自らの舌をレオの舌にじゅるじゅると音を立てて絡めます。\n「んっんうぅう！！」\n果てた瞬間にさらなる快感が口内に広がるのを感じたレオに抵抗する力は残っておらず、\n両手はぐったりと垂れ下がってしまっています。\n抵抗する力を無くし、全重心が黒レオに委ねられます。\n黒レオはそれを受け止め、「よしよし、いっぱい出たな。えらいぞ」と、\n優しく唇を何度も何度もチュッチュッと、音を立てて重ねていくのでした。\nレオはバックハグの状態で唇を奪われたまま、意識を無くしていき終わります。\n\n文章でシチュエーションを伝える技術が拙い為に、このような駄文となってしまいました。ご容赦ください。\n可能であれば、差分で「抵抗している状態」「達している状態」「達した後ぐったり脱力、キスされるがまま」を描いて頂ければ幸いです。\nご都合が悪ければ、タミネコさんの判断で省いて下さっても構いません。\n台詞においても、入れる、入れない、内容の変更についてはタミネコさんの判断にゆだねます。\n\n改めまして、お忙しい中時間を取らせてしまう事申し訳なく思いますが、どうかご検討の程よろしくお願いいたします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@tamineko/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 24338, "client_id": 328876, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/72f754cd/uploads/origins/55d5d408-19a1-448e-ae73-e30cb7160ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c882c270e901f744cc457f24d2feb56", "srcset": "https://si.imgix.net/72f754cd/uploads/origins/55d5d408-19a1-448e-ae73-e30cb7160ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c882c270e901f744cc457f24d2feb56, https://si.imgix.net/72f754cd/uploads/origins/55d5d408-19a1-448e-ae73-e30cb7160ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2f880a145dd17a7e3d62a4b0d1e64c8 2x, https://si.imgix.net/72f754cd/uploads/origins/55d5d408-19a1-448e-ae73-e30cb7160ef4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4936954b1e60e40e88b39e41b1a4dd56 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_