39-82bc-42f59853f4ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1317eb6e0c915eac03f4186ad9fed0e4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/66263454/uploads/origins/c011b45b-222f-4339-82bc-42f59853f4ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5fa26a3bfebece87254d286aa481fe25", "srcset": "https://si.imgix.net/66263454/uploads/origins/c011b45b-222f-4339-82bc-42f59853f4ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5fa26a3bfebece87254d286aa481fe25, https://si.imgix.net/66263454/uploads/origins/c011b45b-222f-4339-82bc-42f59853f4ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f1f8181ba9c6902faf7a6e526ddd99de 2x, https://si.imgix.net/66263454/uploads/origins/c011b45b-222f-4339-82bc-42f59853f4ec?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f048069c7611f0cde9047d7b3758188d 3x"}, "body": "TRPGの自探索者Aがいます。\n\n別シナリオで、20歳になる息子を作成しました。Aが29歳の時点で5歳だったので、その息子と同じ時間軸だとAは44歳になっているはずです。\n\nその、44歳になったAを書いて頂けたらと思います。\n\nいあきゃらのキャラシを添付致しますので、御検討お願いいたします。\n\nよろしくお願いします！！！！！！！！！！！！！！！！！！！！！！！！！！！！！！\n\n鷹山 隼斗 - いあきゃら\nhttps://iachara.com/view/5386975\n\n参考:その息子\n多々良 鳩理(たたら はとり) - いあきゃら\nhttps://iachara.com/view/8088948\n\n\n\n追記:描いて頂きたいキャラクターは鷹山 隼斗になります。44歳時点の職業はフリーライターで、ある人物を追っています。大切な物は親友との思い出の石が入った小瓶で、キーホルダーにしていつも持ち歩いています。大切な親友を失った原因の男を殴るために今までの生活を捨ててきました。それなりに荒んだ生活を送っていますが、元雑誌の編集者であり顔が良いので何とかなっています。見窄らしい格好ではなく、苦労を重ねて年齢より老けてみえる感じでお願いしたいです。自分によく似た息子がいます。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shiba_chi4/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2230284, "client_id": 2739233, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dae68d7f/uploads/origins/9da55a46-9842-