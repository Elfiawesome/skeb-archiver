igins/b2e42fe7-0f77-46eb-840d-1db15b899f30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f06cbea1a874f5cc1c1f9f9b6e19bcd1 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/36a93f32/uploads/origins/b2e42fe7-0f77-46eb-840d-1db15b899f30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23f0d6e587bb671c3491c3bbc8d2737d", "srcset": "https://si.imgix.net/36a93f32/uploads/origins/b2e42fe7-0f77-46eb-840d-1db15b899f30?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23f0d6e587bb671c3491c3bbc8d2737d, https://si.imgix.net/36a93f32/uploads/origins/b2e42fe7-0f77-46eb-840d-1db15b899f30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6e47e1e97aad3cd5eeb26cc63cd8a245 2x, https://si.imgix.net/36a93f32/uploads/origins/b2e42fe7-0f77-46eb-840d-1db15b899f30?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e2f6a5b15063e6288e8c14acb11b78b3 3x"}, "body": "初めまして！\nリクエスト可能でしたらお願いします。\n\nお仕置き系が好きなので学生が先生に怒られてお尻叩きの罰を受けるシーン。\n\n水泳の授業で女子生徒(スク水)4人が遅刻をしてしまい先生から罰で竹刀でお尻を叩かれる。\n\n1人が壁に手をついてお尻を突き出して叩かれている。\nめっちゃ痛そうな表情で必死に耐えている。\n残りの生徒達は縦に並んで順番を待っている。\n耐えられるか心配な生徒や、みんなの前で恥ずかしそうな様子。\n\nよろしくお願いします。\n\n初めてなので金額はそのままですがアップ必要なら対応します。", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sonnano_ari/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 175906, "client_id": 17545, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/51eda569/uploads/origins/79cd1a8a-2a2f-4aef-8531-0b62294e265a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2482862c6849107fd827c291e3cef1d8", "srcset": "https://si.imgix.net/51eda569/uploads/origins/79cd1a8a-2a2f-4aef-8531-0b62294e265a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2482862c6849107fd827c291e3cef1d8, https://si.imgix.net/51eda569/uploads/origins/79cd1a8a-2a2f-4aef-8531-0b62294e265a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ceed05c5a0d8099b7a9f220efe658131 2x, https://si.imgix.net/51eda569/uploads/origins/79cd1a8a-2a2f-4aef-8531-0b62294e265a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9a4f745626a474628c60f8b9c0306452 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/51eda569/uploads/origins/79cd1a8a-2a2f-4aef-8531-0b62294e265a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c035f31124ae7d5cdb824498b41b87e", "srcset": "https://si.imgix.net/51eda569/uploads/origins/79cd1a8a-2a2f-4aef-8531-0b62294e265a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6c035f31124ae7d5cdb824498b41b87e, https://si.imgix.net/51eda569/uploads/origins/79cd1a8a-2a2f-4aef-8531-0b62294e265a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f1add18add6e0ee4a08d954d658d30f4 2x, https://si.imgix.net/51eda569/uploads/origins/79cd1a8a-2a2f-4aef-8531-0b62294e265a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b4a4d25d634ac08b7c25341d773c1c2a 3x"}, "body": "はじめまして、先生がたまに描くロリ巨乳が好きですので依頼させていただきます。\n\n女の子は「金髪みつあみおさげのそばかす芋娘（Pixivの「＃12 tegakiまとめ」の芋娘ちゃんをよりロリにしてさらにがっつり巨乳にした感じです）」で、竿役は「黒髪気弱な少年（15歳くらい）」でおねがいします。\n\nシチュは「『親が経営してるアパートの家賃を滞納しているという外国人母子家庭』の様子を見に行った大家の息子の少年、母親はおらずロリ巨乳の娘が出てきて『追い出さないでくれたらコレしてアゲル』と色仕掛けされ、誘われるままに舐められ挟まれ童貞を奪われ生中出しまでしちゃう」という感じでお願いします。\n「家賃催促する気はなくむしろ母子家庭の状況が心配なので、気の優しい息子に様子を見させてプレッシャーを与えないようにした大家」と「キュートなお兄ちゃん（大家の息子）はワタシのおっぱい見てるしスキみたい♡おねがいもあるし仲良くしマース♡というロリ巨乳」という感じのユルくて明るいエロでお願いできればと。\nロリ巨乳の子のロリ度は『メスガキ琉愛那ちゃん』くらいかもう少し幼くてもオッケーです。おっぱいはばるんばるん揺れるくらいあるというかなりアンバランスな感じですね。竿役の少年はすらっとした体形か少し筋肉質くらいでお願いします。\n\n大分細かくなりましたが、よければよろしくお願いいたします！", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sonnano_ari/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 175906, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22496f80/uploads/origins/54d3a85c-1a30-485d-9d1c-06c63833e735?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b148b94ad0dd5279a997538715f4ea32", "srcset": "https://si.imgix.net/22496f80/uploads/origins/54d3a85c-1a30-485d-9d1c-06c63833e735?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b148b94ad0dd5279a997538715f4ea32, https://si.imgix.net/22496f80/uploads/origins/54d3a85c-1a30-485d-9d1c-06c63833e735?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0b33404f9a0599d7d779cb36f539ad0d 2x, https://si.imgix.net/22496f80/uploads/origins/54d3a85c-1a30-485d-9d1c-06c63833e735?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1835487968f743a8c669f64286fcac61 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22496f80/uploads/origins/54d3a85c-1a30-485d-9d1c-06c63833e735?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a313285e31c7c01f00cb1867d673099", "srcset": "https://si.imgix.net/22496f80/uploads/origins/54d3a85c-1a30-485d-9d1c-06c63833e735?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a313285e31c7c01f00cb1867d673099, https://si.imgix.net/22496f80/uploads/origins/54d3a85c-1a30-485d-9d1c-06c63833e735?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0d65c12a8275586ad0a7390e705455bf 2x, https://si.imgix.net/22496f80/uploads/origins/54d3a85c-1a30-485d-9d1c-06c63833e735?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9de6653f09b688c83a94ddc62070bfcd 3x"}, "body": "初めまして\n以前投稿されたインピオセックスバトルがとても素晴らしい作品だった為、その続きをご依頼させていただきたくご連絡させていただきました。\n\n・設定\n星選手がCクラスに上がり破竹の勢いで連勝を上げる中、マイ選手とのリベンジマッチがセッティングされる 。\n(お互いに身長や胸、性器など相応に成長させていただけると嬉しいです 特に勇星選手はCクラスの中でもダントツのサイズのズル剥け巨根で、この武器で女子選手を一方的にイかせまくっていたという設定でお願いします) \nルールは前回と同じく3回絶頂で敗北\n\n・試合展開\n勇星選手、前回と同じくディープキスでマイ選手を捉えるも、キスの訓練をしていたマイ選手にキスを正面から受けられ、ディープキスでカウンターを仕掛ける。\nキスの攻防の末、マイ選手のキステクに耐えられず勇星選手射精。\n\nその後対面で手コキ手マン勝負を仕掛ける両者。流れに乗るマイ選手が少し優勢だがお互い限界を迎える直前勇星選手がキス攻め、更に空いてる手で乳首攻めをし、三点攻めに移行。\n結局マイ選手と勇星選手は同時絶頂を迎えるが、マイ選手はマジイキしてしまい放心状態に。\nその後リング中央で放心状態のマイ選手に、勇星選手は松葉崩しの体位で挿入し抽挿、マジイキ後でろくに抵抗できないマイ選手は簡単にイカされてしまう。\n互いに残り一度しか絶頂出来ず後がない中、対面座位に移行。\n互いに抱きあいながら、勇星選手は膣ゴン突き高速ピストン、マイ選手は腟内の締めつけとグラインドカウンターで決着をつけようとする。\n数十分続いた攻防の最後は、タッチの差で勇星選手が先に腟内に射精、腟内に出された快感でマイ選手もイッてしまいますが、判定の結果先に相手をイかせたマイ選手の勝ちという結果に。\n\nその後勝者のインタビューでは試合に負け萎えてる勇星選手のちんこに素股で跨りながらインタビューを受けるマイ選手と、余韻で敏感になり素股だけで精液を漏らしてしまう勇星選手\n\n\nという感じでお願いします。\nセックスバトルでお馴染みのお二方の実況もお願いします。\nスケブでのご依頼が初めてなので何かと至らないところがあると思いますが何卒よろしくお願いいたします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sonnano_ari/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 175906, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8adbb63d/uploads/origins/d7b4b022-a4ff-4f3a-95e5-ba19297bb22b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07ad1e5c237dff76538f3739a9b72d91", "srcset": "https://si.imgix.net/8adbb63d/uploads/origins/d7b4b022-a4ff-4f3a-95e5-ba19297bb22b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=07ad1e5c237dff76538f3739a9b72d91, https://si.imgix.net/8adbb63d/uploads/origins/d7b4b022-a4ff-4f3a-95e5-ba19297bb22b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=04a2f71b65d6d7439be6aa752f3add31 2x, https://si.imgix.net/8adbb63d/uploads/origins/d7b4b022-a4ff-4f3a-95e5-ba19297bb22b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3868b701b7dc5ebe39b2f17ec1f9e60 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8adbb63d/uploads/origins/d7b4b022-a4ff-4f3a-95e5-ba19297bb22b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f97d47e3e389517d4328e8b2b52c93fe", "srcset": "https://si.imgix.net/8adbb63d/uploads/origins/d7b4b022-a4ff-4f3a-95e5-ba19297bb22b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f97d47e3e389517d4328e8b2b52c93fe, https://si.imgix.net/8adbb63d/uploads/origins/d7b4b022-a4ff-4f3a-95e5-ba19297bb22b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6bd22f1d1109344670f4588a7bb1bf3f 2x, https://si.imgix.net/8adbb63d/uploads/origins/d7b4b022-a4ff-4f3a-95e5-ba19297bb22b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b73c70fcb6f01ff65e6dbfa1bd857377 3x"}, "body": "もっと全裸学校転校生の入学写真\n全身、頭から足の指まで全裸。全裸とパイパンと金髪のシャルロット・デュノアそっくり女性の先生と飛鳥乃真理絵先生の言うよると、ペニスか膣を隠していけません。壁と背景はスタジオで写真室舞台です。壁は体長線があって、全生徒はカメラー向かって一線を立つ男性と女性生徒は\n\n5-1\n一つの業\nCOMPLETSの「もうすぐもうすぐ夏休み」からキャラ\n東野千春 (女子)\n岩村舞子 (女子)\nサトシ・ムセキ（男子、転校生の案内人）\nシャルロット・デュノア（先生）\n二つの業\nCOMIC LO 2006年6月、7月号出版物\n嶺本八美の「二人の友達」からキャラ\n宮口早苗 (女性)\n新家瑛太  (男性)\n飛鳥乃ルミナ（女子、転校生の案内人）\nシャルロット・デュノア（先生）\n5-2\n三つの業\nCOMPLETSの「野外学習」からキャラ\n神泉茜 (女子)\n江木真奈美 (女子)\n小狼李君（男子、転校生の案内人）\n飛鳥乃真理絵（先生）\n四つの業\n綺堂館の綺堂無一の「小さな生活2, 4」からキャラ\n立花章介 (男性)\n姫川響鬼 (女性)\n飛鳥乃茅菜（女子、転校生の案内人）\n飛鳥乃真理絵（先生）\n\n早苗ちゃんと瑛太君と章介君と響鬼だけは恥ずかしくても、他の生徒嬉しく、ワクワクしている。\nステージの下にある標示板は先生によって、「裸谷学校5-1秋学期転校生」か「裸谷学校5-2秋学期転校生」を描いている。\n\n男女のカップル転校生場合、腕と二人きりそばを抱き格好だ。つまり、お互い腕を後ろから他人肩の下で手を抱くと、体の前は視聴者へ向く。\n各業は立ちなからセックス差分も要求している。\n談話として、氏名の紹介、好悪、いい学生になりたい感情や、セックスとちんぽとおまんこが気持ちいいや、ザーメンが美味しそうや、COMPLETSからキャラは元の学校も全裸キャンプがあり、案内人は立派な責任の者でえらいや、なぜ前大人がこんなのを隠れて、狡いだ。\nキャラ相談情報サイト\nwww.complets.co.jp/complet's/mnatu.html\nwww.complets.co.jp/complet's/yagai.html\nhitomi.la/reader/12988.html#11\nhitomi.la/doujinshi/%E3%81%A1%E3%81%84%E3%81%95%\nPSDお願い", "nc": 161, 