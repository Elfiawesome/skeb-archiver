2ad-4d06-8297-51cbaf3050ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=81075b7a45b2fbbc2552cbc05e0b0bf9 2x, https://si.imgix.net/ccb515fb/uploads/origins/5b4ebd84-52ad-4d06-8297-51cbaf3050ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=e801cef8c8959f30f99ac31db06e3d00 3x"}, "body": "こんにちは！おジルさんの絵で自創作キャラの「卯島渉」(資料URL右側)を見てみたいです！ \n\n男性/24歳/173cm\n幼馴染を想って詐欺に手を染めたり魔法少女に変身する力を手に入れたりした男。\n捻くれてクールぶろうとするが振り回されやすく、性根は世話焼きなツッコミ気質。\n卑屈で自分の弱さを自覚しているため強そうな人の気配に敏感。\n\nおジルさんの格好いい絵もコミカルな絵も好きなので雰囲気や構図などはお任せします！\n\nご都合に合いましたら何卒よろしくお願いします。\n\nhttps://64.media.tumblr.com/3818d0d8ea93a44c9ddc62a0b0fdbeb0/c09e4021f742f911-4c/s1280x1920/bbcacaf503a41781c71619935b340186b6d3fafb.jpg", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gilles2147/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 8516, "client_id": 1529089, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/22b10282/uploads/origins/816d8f0a-6498-445a-820b-bf2cc0a82951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0149a2355431c1ee13432855aab0446a", "srcset": "https://si.imgix.net/22b10282/uploads/origins/816d8f0a-6498-445a-820b-bf2cc0a82951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0149a2355431c1ee13432855aab0446a, https://si.imgix.net/22b10282/uploads/origins/816d8f0a-6498-445a-820b-bf2cc0a82951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b17eb92fbcd68d8cd72a1a7cd6fe4735 2x, https://si.imgix.net/22b10282/uploads/origins/816d8f0a-6498-445a-820b-bf2cc0a82951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=538e615a4404cced34c4249f41a7b1bd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/22b10282/uploads/origins/816d8f0a