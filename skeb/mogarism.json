top&w=200&h=200&blur=200&s=78bd841f157a222afb109ce0a54a047c, https://si.imgix.net/1c293c58/uploads/origins/1d492f0e-f497-4994-9c76-2935b739edbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9d012108ab4d81a6992d9d2743e93589 2x, https://si.imgix.net/1c293c58/uploads/origins/1d492f0e-f497-4994-9c76-2935b739edbe?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8f0065a7b2cbe33372792842d636434d 3x"}, "body": "Kayo/花夜𓏲𓎨C107火曜(東ナ09ab)先生、どうも、お邪魔してすみません。私はあなたの作品が大好きなので、僭越ながらご依頼してもよろしいでしょうか? \n名前： ヴィーナス（Venus Flytrap）\n種族： 人型食虫植物（ひとがた しょくちゅうしょくぶつ）\n血液： 青色（あおろ）\n身長：153CM\n能力： 獲物（えもの）に「安全（あんぜん）」という幻覚（げんかく）を見せる催眠（さいみん）ガスを分泌（ぶんぴ）し、その隙（すき）に捕食（ほしょく）を行う。\n職業： 殺し屋（ころしや）\n外見の特徴：普段は冷静で無表情ですが、狩りの瞬間だけ瞳孔が黒から淡いピンク色に変化します。\n舌は蛇のように分かれ、口元には小さな牙が見えます。髪は蔓のように自発的に動き、感情や食欲が揺らぐと、生き物のように伸びていきます。\n\n感想をもとに自由に描いていただければ幸いです。作品は商業的に使用されません。\n\nありがとうございます\n\nhttps://drive.google.com/drive/folders/1lQidcAiwWqRxHgnl7SCglgZMBopbvVwr?usp=sharing", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mogarism/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 5031, "client_id": 710805, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2a88085a/uploads/origins/499a292a-051c-4f7f-9a13-033899b01e00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b8769ec79224c7fac339196b3cae7b2", "srcset": "https://si.imgix.net/2a88085a/uploads/origins/499a292a-051c-4f7f-9a13-033899b01e00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4b8769ec79224c7fac339196b3cae7b2, https://si.imgix.net/2a88085a/uploads/origins/499a292a-051c-4f7f-9a13-033899b01e00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=aa0412531ada7474d0b91d4a1d1ec8b6 2x, https://si.imgix.net/2a88085a/uploads/origins/499a292a-051c-4f7f-9a13-033899b01e00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2406c44a60277a5ff139881141f1f5c3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2a88085a/uploads/origins/499a292a-051c-4f7f-9a13-033899b01e00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cca855a2c132a2ba81cdf7a08a6a6bc5", "srcset": "https://si.imgix.net/2a88085a/uploads/origins/499a292a-051c-4f7f-9a13-033899b01e00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cca855a2c132a2ba81cdf7a08a6a6bc5, https://si.imgix.net/2a88085a/uploads/origins/499a292a-051c-4f7f-9a13-033899b01e00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7a12717ab47dd135ebd617b37425fc52 2x, https://si.imgix.net/2a88085a/uploads/origins/499a292a-051c-4f7f-9a13-033899b01e00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=df237ed8c49c39c5ed918de3bb21e104 3x"}, "body": "こんにちは、先生！\n\nSkebのキャンセル、ツイッターの投稿も拝見しました。お元気で、新年をお迎えのことと思います。\n\n可能であれば、やはりこの2人のキャラクターを描いていただきたいです。\n\n舞台はスルタンから逃げながら隠遁生活を送る二人の盗賊。彼らは不老不死の聖水を盗むが、それは殺人よりも重い罪である。二人はパートナーとして国をまたいで旅をする。舞台は『FFXIV』のトラル大陸や漫画『マギ』に似ている。\n\n使ってほしいキャラクターの衣装は[☀🌊]フォルダにあります。\n\nカイ (💥 194cm)\n太陽族から脱走したトラブルメーカー。金と喧嘩と快楽が大好き。粗野だが有能な青年で、多くの人を惹きつける。\n生意気で恥知らずな悪人。\nのんびり屋。\nあまり一箇所に留まらない。人生のすべてを経験するのが好き。\n子供っぽくアサをからかったりいちゃついたりするのが好きだが、アサの誠実さにはいつも驚かされる。アサはカイにもっといい人間になりたいと思わせる。\n\nアサ (🌊 183cm)\n雨の部族出身。部族を救うために不老不死の水を盗む。秘密主義だが、穏やかで優しい。\n義理堅く、信頼でき、機知に富んでいる。子供や祖母によくなつく。\n他人とうまく付き合い、期待を裏切らない。\nカイのことを狂人だと思っているが、彼のリズムに流されることは厭わない。アサはカイのふざけた態度に寛容である。カイはアサに未知のチャンスに挑戦する意欲を与える。\n\n詳細はお任せします。ありがとうございました！\n\nhttps://drive.google.com/drive/folders/15S2g3c_TH809FtBdsz8OtsypGPRoxVTZ?usp=sharing", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mogarism/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 5031, "client_id": 1421963, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8821bd5d/uploads/origins/7cc8806f-ab59-4b36-b5cc-e4bdc0a3752d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e76b2dcac23f916dcb113a2ab7b70530", "srcset": "https://si.imgix.net/8821bd5d/uploads/origins/7cc8806f-ab59-4b36-b5cc-e4bdc0a3752d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e76b2dcac23f916dcb113a2ab7b70530, https://si.imgix.net/8821bd5d/uploads/origins/7cc8806f-ab59-4b36-b5cc-e4bdc0a3752d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9248047ea83f854553b9798307320d44 2x, https://si.imgix.net/8821bd5d/uploads/origins/7cc8806f-ab59-4b36-b5cc-e4bdc0a3752d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8092caadf57dd17ecc288698e293d751 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8821bd5d/uploads/origins/7cc8806f-ab59-4b36-b5cc-e4bdc0a3752d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd3910c0e05c9ecc99e3b03552028ea9", "srcset": "https://si.imgix.net/8821bd5d/uploads/origins/7cc8806f-ab59-4b36-b5cc-e4bdc0a3752d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd3910c0e05c9ecc99e3b03552028ea9, https://si.imgix.net/8821bd5d/uploads/origins/7cc8806f-ab59-4b36-b5cc-e4bdc0a3752d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=23363644c9a76de33fc92a545aa8537e 2x, https://si.imgix.net/8821bd5d/uploads/origins/7cc8806f-ab59-4b36-b5cc-e4bdc0a3752d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6d7ab733547c12e71a39c7562bfde836 3x"}, "body": "こんにちは、私はあなたの作品がとても好きで、依頼を送りたいと思っています！\n\n私のOC: https://drive.google.com/drive/folders/1XTA6MrEOMuZ0oPM3FA9nvnvf_Md1HgF7\n\n条件カラーでも白黒でも構いません。背景とインタラクションは自由。背景は飾りでも自然でも構いません。\n傘を描く場合は、白髪の男性が傘を持つようにしてください。\n\nおすすめキーワード：水滴、紫陽花、青、雨、和柄\n\n日本の架空の都市伝説。雨の日になると街角に無造作に現れる。うっかり目を合わせてしまうと、後をつけてきて、存在しない旅館への道を尋ねてくる。正しい答えを言えなかったり、黙っていると死んでしまう。\n\n昔、彼らは普通の人だった。\nある雨の日、彼らは休息と食事のために宿に立ち寄ったが、食事中に毒殺された。犯人は見つからず、彼らは今日までさまよい続けている。\n\n白髪の男（180センチ）：黒髪の男の使用人。いつも優しい笑顔を浮かべている。\n黒髪の男（170センチ）：人気茶屋の主人。穏やかでまじめ、笑顔を見せない。\n\n主従関係にありながら、互いに尊敬の念を抱いている。\n\nありがとう！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mogarism/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/376ce7a2/uploads/origins/a833701a-0ada-47f0-8246-40dfadb3124d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9560947b61c68c51028de81e8cbc64e2", "srcset": "https://si.imgix.net/376ce7a2/uploads/origins/a833701a-0ada-47f0-8246-40dfadb3124d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=9560947b61c68c51028de81e8cbc64e2, https://si.imgix.net/376ce7a2/uploads/origins/a833701a-0ada-47f0-8246-40dfadb3124d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=736c919450bcefd8970327e4fca077af 2x, https://si.imgix.net/376ce7a2/uploads/origins/a833701a-0ada-47f0-8246-40dfadb3124d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3f882504ba60f23817b7d5146cd80b52 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 5031, "client_id": 3549581, "nc": 129}, {"path": "/@mogarism/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 5031, "client_id": 3527041, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.