: {"nsfw": true}, "visa": {"nsfw": true}, "discover": {"nsfw": true}, "american_express": {"nsfw": true}}}, "acceptable_only_public": false, "tip_acceptable": true, "yearly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@mogarism/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 5031, "client_id": 203995, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b6ab7944/uploads/origins/455a35f1-cdf0-466b-9759-f086f25b59e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50dcb8c666ad7dcff63f2160adbfb526", "srcset": "https://si.imgix.net/b6ab7944/uploads/origins/455a35f1-cdf0-466b-9759-f086f25b59e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=50dcb8c666ad7dcff63f2160adbfb526, https://si.imgix.net/b6ab7944/uploads/origins/455a35f1-cdf0-466b-9759-f086f25b59e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4bebb09200a27df726abe6bcedda5c4d 2x, https://si.imgix.net/b6ab7944/uploads/origins/455a35f1-cdf0-466b-9759-f086f25b59e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=876a0046526a32b68c9cc9f91aec8e54 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6ab7944/uploads/origins/455a35f1-cdf0-466b-9759-f086f25b59e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e360e1f406ef92f26b3aac488bbde7f9", "srcset": "https://si.imgix.net/b6ab7944/uploads/origins/455a35f1-cdf0-466b-9759-f086f25b59e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e360e1f406ef92f26b3aac488bbde7f9, https://si.imgix.net/b6ab7944/uploads/origins/455a35f1-cdf0-466b-9759-f086f25b59e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9e08b938aec9fce02d2abfb3d4d770ba 2x, https://si.imgix.net/b6ab7944/uploads/origins/455a35f1-cdf0-466b-9759-f086f25b59e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3d954bedaf8d676f501475de71750b70 3x"}, "body": "中邑故一さま、はじめまして。\n繊細ながら力強い線、洗練された美しい色遣いと陰影、世界観が感じられる素晴らしいセンスに惹かれました。\n\n今回は自創作で使用しているOCカップルのイラストをリクエストさせていただきたいです。\n世界観は、異形(死霊やアンデッドなどのイメージです)と戦うホラー寄りの和風現代ファンタジーです。\n用途は個人・非商用の範囲です。製作者様を明記の上でご依頼した作品としてSNSやネット上に掲載させていただく可能性があります。その際、文字入れやトリミングなど最低限の加工も行う場合があります。\n\n\n【希望】\n・和風、かっこいい、綺麗なイメージのイラスト。\n・カラーイラスト希望です。\n・OC二人が一緒に戦っているあるいはお互いを想っているような様子。その場に一緒にいる構図でなくてもイラスト的に一枚に収まる形で大丈夫です。\n・背景は抽象的なイメージで大丈夫です。\n・“カラス”“梅の花”“桜の花”“黎明”などの要素を取り入れてもらえると嬉しいです。\n\nOC1（黒髪の男性）\n・表情は無表情で鋭い雰囲気、微かに険しい顔つき。\n・服装のベースは和装(紋付羽織袴)。アレンジはお好きにしていただけると嬉しいです。\n・武器は弓か刀、どちらかを持っている。特にデザインは決まっていないのでお好きにデザインしてください。\n\nOC2（白髪の女性）\n・OC1のことを信頼し大事に想っていることがわかる態度。\n・服装は着物、桜柄。\n・一応刀を扱いますが、癒しの力も使うので刀は持っていなくても構いません。\n・真剣な表情、あるいは少し憂いたような表情など、シチュエーションにあわせて自由に。\n\n最終的には、先生の描きたいイメージにお任せいたします。楽しく自由に描いていただければと思います。\n\nお手隙おかけし恐縮ですが、不都合がありましたら遠慮なくキャンセルや再送をお願いいたします。\n以上です、お忙しいところリクエストを読んでいただきありがとうございました！\n\nhttps://drive.google.com/drive/folders/1q-yZUUCtPw_OiHuIUStxO05E9xuE4A1f", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mogarism/works/17", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d7953957/uploads/origins/a3b84b7d-8e25-444b-973e-bf37a2fd90f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6f60bb4967c89d1163e3667f7c96c9e2", "srcset": "https://si.imgix.net/d7953957/uploads/origins/a3b84b7d-8e25-444b-973e-bf37a2fd90f1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=6f60bb4967c89d1163e3667f7c96c9e2, https://si.imgix.net/d7953957/uploads/origins/a3b84b7d-8e25-444b-973e-bf37a2fd90f1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=cro