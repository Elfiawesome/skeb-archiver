er.com/LightPenis/status/1141739113982201856", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@LightPenis/works/29", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 563352, "client_id": 1562358, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/77d0a98e/uploads/origins/17a0dd4f-a4e8-4822-ad1e-224630cb035f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4afe2ddfbe10c4a4209f95b4f9114589", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/77d0a98e/uploads/origins/17a0dd4f-a4e8-4822-ad1e-224630cb035f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c013b4338a37e02cea0c0c7273219a3e", "src_set": ""}, "body": "以前別の方のリクエストで描かれていた光とPの情事を覗き見てしまった雪美の作品（https://skeb.jp/@LightPenis/works/6）がめっちゃ好みです。もし可能ならばこの続きのifをお願いします。\nなんやかんやあって覗いているのがPにもバレた雪美。自分もやってみたいと2人に混ざって3P。\n光は雪美の隣でフェラの仕方を教えてあげる。2人でPの竿を一緒に舐めたりして欲しい。\n2人に向かってぶっかけてお互いの顔に付いた精液を舐め合う2人が見たいです。\n本番は雪美にはまだ早いとして無し。もし入れてもらえるようでしたら光がPとしているのを見ながら股をいじる雪美の図をお願いします。\nこの内容で問題なければよろしくお願いします。\n\nhttps://skeb.jp/@LightPenis/works/6", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@LightPenis/works/28", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/0abfd3ed/uploads/origins/962dbc44-5b10-45d3-848b-c42774edfd27?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f54240362a156c59d013e5d824196d5a", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 563352, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 48, "word_count": 0, "transcoder": "", "creator_