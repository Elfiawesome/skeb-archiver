9e6a58/uploads/origins/51a281c9-5d6b-4706-90ba-71c699258ba8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6d372d2375ed338cdd8297326d0b3c46", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/029e6a58/uploads/origins/51a281c9-5d6b-4706-90ba-71c699258ba8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=eed475945ab807da2ea19677d2ccb183", "src_set": ""}, "body": "はじめまして、小林です！あなたのアートスタイルが大好きです！\n\n私のオリジナルキャラクターを描いていただけませんか？\n彼は暗殺者であるエイリアンです。彼はスナイパーです。\nロック、お菓子作り、スケッチ、ナイフが好き。\n性格は、おしゃべり、いたずら好き、ちょっとおかしい、ヤンデレ。\nテーマは、血、ナイフ、銃、黒い狼など。\n\nできれば、クールでドラマチックなアクションポーズがあれば嬉しいです！ポーズや構図はおまかせします。\n\nいずれにせよ、お読みいただきありがとうございました！\n\nhttps://drive.google.com/drive/folders/1KMWnebYWR9qLmqqg6TmAzDJjJyxVEibY?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 328140, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "となか/関コミ▶C-27", "screen_name": "kuroiidononaka", "avatar_url": "https://pbs.twimg.com/profile_images/1613888856918745093/FyJ5aGmm.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1104961483803308032/1586931164/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 160}, {"id": 1057632, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "07", "screen_name": "sobakonattou07", "avatar_url": "https://pbs.twimg.com/profile_images/1844812683226619904/4AKjeuiK.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2552540090/1728678149/1500x500", "appeal_receivable": true, "popular_creator_rank": 18, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_e