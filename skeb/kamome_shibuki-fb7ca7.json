夜はSFメカのヒロインに変身して犯罪や怪獣と戦う。\n\nアリッサの能力については、体力、防御力、スピードがメカスーツによって強化されている。腕のビーム砲には展開する剣がついている。腰にはビーム・サーベルもついている。不可視のエネルギー・フィールドが彼女の体を防御する。\n\n***重要\n彼女の目の色はシアンであり、首のクリスタルと同じ色であることに注意してください。髪と瞳の色は異なっており、似ているわけではない。\n\nイラスト\nイラストはアクションシーンで、彼女の体も表現しています。魔法少女っぽい変身シーンでもOK。Google Driveにアクションシーンの参考資料があります。具体的な構図はお任せします。\n\nフォーマットはPSDを希望します。\nよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1ewBrz7R5KudjnTx8l87MJZL2umQ9xNap?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kamome_shibuki/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/5a2316c0/uploads/origins/2cd5cd4e-4b6b-4c8a-91c7-14a7da2509df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b50ca4c4c3fccf9df6fc5923161e3ed7", "srcset": "https://si.imgix.net/5a2316c0/uploads/origins/2cd5cd4e-4b6b-4c8a-91c7-14a7da2509df?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b50ca4c4c3fccf9df6fc5923161e3ed7, https://si.imgix.net/5a2316c0/uploads/origins/2cd5cd4e-4b6b-4c8a-91c7-14a7da2509df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fbb608118e1548b0a9fe948f24a32b26 2x, https://si.imgix.net/5a2316c0/uploads/origins/2cd5cd4e-4b6b-4c8a-91c7-14a7da2509df?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=4d0ff7bbae2ab2f23f064d03cfa3a5be 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 2908847, "client_id": 2800436, "nc": 144}, {"path": "/@kamome_shibuki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": t