t%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c4c5b2ccb85d5ca78cb39b5b559bd1f5, https://si.imgix.net/943deebf/uploads/origins/7c81531f-676e-4d03-8dfe-76db998ceda1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4a5e184b41dacd5c4b4cb77cae77f7c6 2x, https://si.imgix.net/943deebf/uploads/origins/7c81531f-676e-4d03-8dfe-76db998ceda1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=551cfca68634548006e3bd1ae5911944 3x"}, "body": "老师好！！在这里刷到了您的摸鱼页很喜欢风格，如果可以的话想约一下双人互动页！如果价格不合适也可以调整！\n是两个角色的向导哨兵au，一位叫林晓，一位叫吴令枫，详细设定都在链接里，尤其是那张名称叫问卷的图对角色概括写的比较简单易懂，可以参考看看！\n想看的互动有掐脖子（吴掐林，林在很嚣张不屑的笑着）、林玩吴头发、咬吴的手指、类似的…您也可以根据资料随意发挥！感觉部分氛围会偏黑暗压抑点？不过主要看您的感想和发挥！！\n如果愿意考虑一下就太好了！！感谢！\n参考链接：https://drive.google.com/drive/folders/1-1J80GxTZWqev_qTOMCTWVoNLukmqA-S", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@IcelandCrow/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2912142, "client_id": 1205508, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/73afa3d7/uploads/origins/7ffb017e-3e1d-4db4-aad5-efd609b41707?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=734fc00d8c64be88c90ef9d607cca9da", "srcset": "https://si.imgix.net/73afa3d7/uploads/origins/7ffb017e-3e1d-4db4-aad5-efd609b41707?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=734fc00d8c64be88c90ef9d607cca9da, https://si.imgix.net/73afa3d7/uploads/origins/7ffb017e-3e1d-4db4-aad5-efd609b41707?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=54be642f84d57441301016b938fa9ae4 2x, https://si.imgix.net/73afa3d7/uploads/origins/7ffb017e-3e1d-4db4-aad5-efd609b41707?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c2d52b380b453ad852e2a81dffa19114 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/73afa3d7/uploads/origins/7ffb017e-3e1d-4db4-aad5-efd609b41707?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3dd30e425a6299b7e9244eb69798b785", "srcset": "https://si.imgix.net/73afa3d7/uploads/origins/7ffb017e-3e1d-4db4-aad5-efd609b41707?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3dd30e425a6299b7e9244eb69798b785, https://si.imgix.net/73afa3d7/uploads/origins/7ffb017e-3e1d-4db4-aad5-efd609b41707?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f59c801ab345f50877f875a58c5cae12 2x, https://si.imgix.net/73afa3d7/uploads/origins/7ffb017e-3e1d-4db4-aad5-efd609b41707?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=548d5b389ee6ebd4dec24f2342a40fe0 3x"}, "body": "你好，我非常喜欢你的多互动插画，比如 https://skeb.jp/@IcelandCrow/works/3 ！我想让我的朋友和我的原创角色在一起。他们在霍格沃茨魔法学院上学。\n\n他们是远亲表兄弟。没有人知道他们之间真正的血缘关系，因为他们每次都会改变答案，但他们仍然把对方当作家人。\n\n罗塞塔（女）（170 厘米）：\n她是一个半吸血鬼，幻想着与其他人之间的浪漫。怪人。\nhttps://sta.sh/27d8zuuvyxn?edit=1\n\n克罗诺斯（男）（168 厘米）：\n他是一个无忧无虑的家伙，总是面带微笑，随波逐流。\nhttps://sta.sh/0uk79g3f5c5\n\n关系：\n-罗塞塔很有钱，会给克罗诺斯花钱，给他买零食和玩具。\n-他们通常不怀好意，一起搞恶作剧\n-他们很亲热，并倾向于以家庭的方式表现出来（例如，拥抱、搂抱等）\n-他们喜欢看 Shoujo 漫画，因为这是 Rosetta 的爱好\n-傻傻的、健康的（柏拉图式的）\n谢谢", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@IcelandCrow/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2912142, "client_id": 2715214, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2d49b338/uploads/origins/3550f543-f647-47d5-94b4-4764b0c50c7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5df58efb91edea47fcbd5d257f50f779", "srcset": "https://si.imgix.net/2d49b338/uploads/origins/3550f543-f647-47d5-94b4-4764b0c50c7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5df58efb91edea47fcbd5d257f50f779, https://si.imgix.net/2d49b338/uploads/origins/3550f543-f647-47d5-94b4-4764b0c50c7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=19d1bc0c290d1bef4fe8c7aad82f2adc 2x, https://si.imgix.net/2d49b338/uploads/origins/3550f543-f647-47d5-94b4-4764b0c50c7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=59e86558e71c4fe973498d220292f2e6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2d49b338/uploads/origins/3550f543-f647-47d5-94b4-4764b0c50c7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8e167dc8237a312575afad758456ee2", "srcset": "https://si.imgix.net/2d49b338/uploads/origins/3550f543-f647-47d5-94b4-4764b0c50c7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b8e167dc8237a312575afad758456ee2, https://si.imgix.net/2d49b338/uploads/origins/3550f543-f647-47d5-94b4-4764b0c50c7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6996b1a8121dc69c9924a7b11f2b1503 2x, https://si.imgix.net/2d49b338/uploads/origins/3550f543-f647-47d5-94b4-4764b0c50c7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7bd12bfbdd5c7b29716864275fc59e6a 3x"}, "body": "早上好！很喜欢老师的画风，想向您投递一份单人摸鱼页的委托，如果觉得我投的价格不合适的话，也可以改价格。\n\n奥托是一名出色的法师，在历史悠久的学府就读。他能力很强，性格孤傲，因为长着一对奇异的旋角，一直被别人敬而远之，也常被别人议论。但其实即使存在一些表面上的尊重和礼仪，他也并没有真正地看得起大多数周围的人。和他天才一般的音律、法术天赋一样广为人所知的是他傲慢的性格。\n\n角色相关信息我放在链接里了。我希望能出现火焰和音符的元素。如果您能接受这份委托，我会感激不尽！\n\nhttps://drive.google.com/drive/folders/1-5X7ENRnsriOEzhRaJppCfAtjBP9n0f9\n\nhttps://drive.google.com/drive/folders/1-5X7ENRnsriOEzhRaJppCfAtjBP9n0f9", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@IcelandCrow/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2912142, "client_id": 18708, "vtt_url": nul