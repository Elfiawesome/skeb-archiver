imgix.net/3022bb36/uploads/origins/1dfd66b5-24f9-494a-9395-58278fd5431f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf896ccb8eb9b00b54c0a1b5adb5127d", "srcset": "https://si.imgix.net/3022bb36/uploads/origins/1dfd66b5-24f9-494a-9395-58278fd5431f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cf896ccb8eb9b00b54c0a1b5adb5127d, https://si.imgix.net/3022bb36/uploads/origins/1dfd66b5-24f9-494a-9395-58278fd5431f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=740aa4f495b6a85e153c646b1d5d1f26 2x, https://si.imgix.net/3022bb36/uploads/origins/1dfd66b5-24f9-494a-9395-58278fd5431f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dc42ed2f87b6128ac45ef138ccaa81b6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3022bb36/uploads/origins/1dfd66b5-24f9-494a-9395-58278fd5431f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c27e05196a5de6732974222772002db3", "srcset": "https://si.imgix.net/3022bb36/uploads/origins/1dfd66b5-24f9-494a-9395-58278fd5431f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c27e05196a5de6732974222772002db3, https://si.imgix.net/3022bb36/uploads/origins/1dfd66b5-24f9-494a-9395-58278fd5431f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fddfc25ddffdffb3308509e4a97fdb4b 2x, https://si.imgix.net/3022bb36/uploads/origins/1dfd66b5-24f9-494a-9395-58278fd5431f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a13828f27fa97413d141f70ca360c0bb 3x"}, "body": "こんにちは～！あなたのイラスト、すごくかわいいと思います！🤍 ぜひイラストの依頼をさせていただきたいです！\n\nポーズや表情はお任せしますが、参考になるものがあれば、私のリファレンスフォルダにいくつか用意してありますので、必要ならご覧ください :)\n\n私のVTuberについて：\n彼女の名前はGloomです。 『大耳夜鷹』にインスパイアされた鳥の少女で、サバイバルホラーゲームのような雰囲気を持っています。最初は内気で、甘えん坊で、少し不器用な印象ですが、親しくなると遊び心があり、からかい好きで、愛らしい「妹」のような感じで少しわがままな一面も持ち合わせています。\n\n特徴：\n* 顔にほくろが2つ\n*‼️バストサイズが非常に小さい‼️\n* 大きな目\n* 身長：149 cm\n* 牙\n\nビジュアルキーワード：レトロサバイバルホラーゲーム、PSX、サイレントヒル、境界空間、ダークファンタジー、中二病、バイオハザード、エルデンリング、鳥かご、鎖、足枷、ウィアードコア\n\n使用用途：ソーシャルメディア、ストリーミング、またアーティストの許可が得られれば、グッズへの使用も可能です。\n\n参考資料：\nhttps://drive.google.com/drive/folders/1tPe3ItmPzebBpSGUktc80Yd914caGr62?usp=drive_link", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shimon1200/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3964368, "client_id": 585480, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/30a74dc0/uploads/origins/634dec43-e7cb-4562-8e12-150441211137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a63ae51a4bd4934330199a12a575986", "srcset": "https://si.imgix.net/30a74dc0/uploads/origins/634dec43-e7cb-4562-8e12-150441211137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6a63ae51a4bd4934330199a12a575986, https://si.imgix.net/30a74dc0/uploads/origins/634dec43-e7cb-4562-8e12-150441211137?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0af630418184e5d89b481828f32836b9 2x, https://si.imgix.net/30a74dc0/uploads/origins/634dec43-e7cb-4562-8e12-150441211137?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=cef0fc1ba1885fc3beabe9ae4a4c34fd 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/30a74dc0/uploads/origins/634dec43-e7cb-4562-8e12-150441211137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59c83158670dbd83dbab99f0bf0d1dc0", "srcset": "https://si.imgix.net/30a74dc0/uploads/origins/634dec43-e7cb-4562-8e12-150441211137?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=59c83158670dbd83dbab99f0bf0d1dc0, https://si.imgix.net/30a74dc0/uploads/origins/634dec43-e7cb-4562-8e12-150441211137?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4c567fba8c03ebd8e6a58b08074669e5 2x, https://si.imgix.net/30a74dc0/uploads/origins/634dec43-e7cb-4562-8e12-150441211137?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=08cfc3a1ba734a700c4277cf9211b384 3x"}, "body": "こんにちは！私は「COMFY」という名前の、英語を話すVTuberです。\n\n私のキャラクターを描いてください。彼女は小さな天使のような猫です。身長140cm。胸は平らです。\n壁紙として使うため、画像の縦横比は16:9にしてください。\n構図は自由です。アイデアが必要な場合は、ゲームをしている姿、食事をしている姿、寝ている姿、あるいは雲の上にいる姿などを描いても構いませんが、コンセプトはあなたにお任せします。好きなものを自由に描いて楽しんでください！あなたが作り出す風景が本当に大好きです。\n\nこのイラストは、クレジットを明記した上で、SNS、Twitch、YouTubeで使用させていただきたいです。また、私のチャンネル登録者の方々がパソコンの壁紙として使えるよう、無料の壁紙として提供したいと考えています。\n\nhttps://i.imgur.com/i7q3ZTM.jpeg", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shimon1200/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3964368, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/915200ba/uploads/origins/84d13fbc-20a4-4e02-ae3e-18211ae6c3c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6eb0f3e65b9c6125b55b3ac0c1ff7297", "srcset": "https://si.imgix.net/915200ba/uploads/origins/84d13fbc-20a4-4e02-ae3e-18211ae6c3c8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=6eb0f3e65b9c6125b55b3ac0c1ff7297, https://si.imgix.net/915200ba/uploads/origins/84d13fbc-20a4-4e02-ae3e-18211ae6c3c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=bec3a5a682ca91f9659d440fdac3ef6b 2x, https://si.imgix.net/915200ba/uploads/origins/84d13fbc-20a4-4e02-ae3e-18211ae6c3c8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ab657abd9f42f7974523ab0c8ed2fae2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/915200ba/uploads/origins/84d13fbc-20a4-4e02-ae3e-18211ae6c3c8?bg=