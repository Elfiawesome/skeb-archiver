s=6d5835b4ab0d1d319f09bab31a67bd55 3x"}, "body": "こんにちは！\n普段喜夛口さんの作品を見ています、いつも応援しています！\n今回は私の代理キャラクターを描いていただきたく、依頼させていただきました。\nイラストについては、代理キャラクターの描写以外に特別な指定はありませんので、全て喜夛口さんにおまかせしたいと思っております。\n以下に代理キャラクターの資料を添付致しましたので、ご確認ください。\nよろしくお願いいたします！\n\nhttps://twitter.com/haka03nn/status/1701553604350591336?t=54COSJ5Eptkhv_xoln85Bg&s=19\n\nhttps://twitter.com/haka03nn/status/1701553604350591336?t=54COSJ5Eptkhv_xoln85Bg&s=19", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Yagikanshi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 580191, "client_id": 2408911, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/52110cff/uploads/origins/6e846002-df7b-457e-89b3-8ed4eec81aba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fedff8cb79f1040e588952854fadd398", "srcset": "https://si.imgix.net/52110cff/uploads/origins/6e846002-df7b-457e-89b3-8ed4eec81aba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fedff8cb79f1040e588952854fadd398, https://si.imgix.net/52110cff/uploads/origins/6e846002-df7b-457e-89b3-8ed4eec81aba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df173c74632a9710a14cb0dacb85e3a8 2x, https://si.imgix.net/52110cff/uploads/origins/6e846002-df7b-457e-89b3-8ed4eec81aba?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7463638fb23db2ae706666fd91211029 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/52110cff/uploads/origins/6e846002-df7b-457e-89b3-8ed4eec81aba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8a1c882dd4a9b9979db31ca03af2204", "srcset": "https://si.imgix.net/52110cff/uploads/origins/6e846002-df7b-457e-89b3-8ed4eec81aba?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f8a1c882dd