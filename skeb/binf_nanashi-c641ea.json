&fit=crop&crop=top&w=200&h=200&blur=200&s=958badd8c6f1b58fabc33e34269a261c 3x"}, "body": "お久しぶりです。前に依頼したのFGO玉藻の前 、膨乳破裂　https://skeb.jp/@binf_nanashi/works/8　件ではありがとうございました。\n\nまたFGOのキャラで、今度はパッションリップ（衣装は第一再臨　https://w.atwiki.jp/f_go/pages/2000.html　）での膨乳破裂をリクエストします。\n\n詳細ですが、以前描かれていたパッションリップちゃん膨腹https://x.com/binf_nanashi/status/972813276366094336/photo/1　の活用で自分自身でポンプを使い膨乳破裂をする内容で\n↑の玉藻の前の時みたく何段階かの膨乳を頼みたいです。、服の上から空気を注入し、寝転んで注入するじゃなく膨腹の時みたいに起きて注入して欲しいです。\nパッションリップ自体元々胸が大きいですが、膨らませる前提で胸を少し小さくしても構いません。\n破裂するまでは衣装は破れず胸がキツイ状態でムチムチ、パッツパツの膨乳を見たいです。\nセリフや効果音などお任せします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@binf_nanashi/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": false, "creator_id": 10290, "client_id": 2182131, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c791c43/uploads/origins/b4b08335-d839-41c2-8e45-f2223eb3230b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3146477dc5c7730a27e9c8f46c204789", "srcset": "https://si.imgix.net/2c791c43/uploads/origins/b4b08335-d839-41c2-8e45-f2223eb3230b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3146477dc5c7730a27e9c8f46c204789, https://si.imgix.net/2c791c43/uploads/origins/b4b08335-d839-41c2-8e45-f2223eb3230b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e5e924145603cfa00efbc9db5d9ed03 2x, https://si.imgix.net/2c791c43/uploads/origins/b4b08335-d839-41c2-8e45-f2223eb3230b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6220379fc7439340388d9e36ccf77f40 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c791c43/uploads/origins/b4b08335-d839-41c2-8e45-f2223eb3230b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9b4b89474a2fee055c1aa5bb224764a", "srcset": "https://si.imgix.net/2c791c43/uploads/origins/b4b08335-d839-41c2-8e45-f2223eb3230b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9b4b89474a2fee055c1aa5bb224764a, https://si.imgix.net/2c791c43/uploads/origins/b4b08335-d839-41c2-8e45-f2223eb3230b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=87f8417d007f500817cd2ae5aee074ea 2x, https://si.imgix.net/2c791c43/uploads/origins/b4b08335-d839-41c2-8e45-f2223eb3230b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0903a7e5fe33a3002a851d5d1789dcad 3x"}, "body": "ななしさんこんばんは、よろしければリクエスト大丈夫なんでしょうか？\nオリキャラのイグの膨体コミックを描いて欲しいです。\n【イグ参考 VroidHub(3D)】\nhttps://hub.vroid.com/characters/849142613549969404/models/8453283823448680719\n\nシチュエーションは、本を整理していた竜娘ちゃんが空気呪文系統のいたずらされた本に気づいて分別して置いておき席を外したところ、この世界について何も知らないイグが本を開けてしまい、呪文が作動してお尻から空気が入り始めて、お腹がパンパンに膨らんでいき、膨体して最終的に破裂してぐるぐる目で倒れてる所を竜娘ちゃんに発見される感じでお願いしたいです。\n\n表情はイグは膨体等に慣れてはいないので少し苦しい感じでお願いしたいです。\n\n腹、胸、尻、両足、両腕等の膨らむ感じはお任せします。\n\n破裂に関してはグロい感じではなく単純に破れる感じでお願いしたいです。\n\n衣装は何か着せたい物があればそれでも大丈夫です。\n\nそれと最後にイグが竜娘ちゃんに包帯巻かれてる感じのがあると嬉しいです、厳しければ無くても大丈夫です。\n\n分かりづらい説明すいません、よろしければご検討お願いします！", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@binf_nanashi/works/17", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e4654010/uploads/origins/27fe6a01-7250-4242-9942-17b7dab6984c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3127ade5f230f6c2abb540c91261176a", "srcset": "https://si.imgix.net/e4654010/uploads/origins/27fe6a01-7250-4242-9942-17b7dab6984c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3127ade5f230f6c2abb540c91261176a, https://si.imgix.net/e4654010/uploads/origins/27fe6a01-7250-4242-9942-17b7dab6984c?bg=%23fff