た騎馬戦の絵の続きをお願いしたいです\n場面としては、前回の勝負が決まった瞬間をお願いします\n構図としては、片方の赤組の子の帽子を取るも、もう片方の赤組の子に帽子を取られる\nまたは、なんとか頑張って両方の赤組の子の帽子を取るという感じでお願いします\n表情は、帽子を取られる方は、涙目で帽子を取った方の子を見る感じで、\n両方の帽子を取った方は、嬉しそうに笑顔で喜んでる感じでお願いします\nまた、差分的な形でフキダシで赤組の子の表情も書いて頂けたら嬉しいです\nフキダシの方は、帽子を取られた子は涙目で驚いてる表情で、取った子は嬉しそうに喜んでる感じでお願いします\n今回も描いて頂けたら嬉しいです！", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kunajob/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2661414, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ea61f831/uploads/origins/64715f7f-f6fc-4f72-bdf1-647f429322e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61524dfbfbd4993665dd29cbf821bb59", "srcset": "https://si.imgix.net/ea61f831/uploads/origins/64715f7f-f6fc-4f72-bdf1-647f429322e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61524dfbfbd4993665dd29cbf821bb59, https://si.imgix.net/ea61f831/uploads/origins/64715f7f-f6fc-4f72-bdf1-647f429322e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ae98cfbe93fa8bd7a42e24331aad1f93 2x, https://si.imgix.net/ea61f831/uploads/origins/64715f7f-f6fc-4f72-bdf1-647f429322e3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d356a5c510a21e799675aeb2e95f6579 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ea61f831/uploads/origins/64715f7f-f6fc-4f72-bdf1-647f429322e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=726372ad7408f764085e4563db3bb4b4", "srcset": "https://si.imgix.net/ea61f831/uploads/origins/64715f7f-f6fc-4f72-bdf1-647f429322e3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=726372ad7408f764085e4563db3bb4b4, https://si.imgix.net/ea61f831/uploads/origins/64715f7f-f6fc-4f72-bdf1-647f429322e3?bg=%23fff&auto=format%2Ccompress&