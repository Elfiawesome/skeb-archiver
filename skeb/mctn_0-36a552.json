せします！\n\n注：参考シートには、私のキャラクターの「アホ毛」が2本追加されています！これに加え、先のとがったヘアインテークや編み込みのヘッドバンドも描いていただけると嬉しいです。よろしくお願いします！！\n\n別の表情・トグル・PSD・透明ファイル = OKです。\n可能であれば、キャラクターのイラストと背景を別々のレイヤーに分けてください。\n\nご依頼いただきありがとうございます！\n\nhttps://drive.google.com/drive/u/4/folders/1qbVei8Fw7fkW4R5HHbs00iEsc39eUXIg", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 289469, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "きつね の子", "screen_name": "4ox", "avatar_url": "https://cdn.bsky.app/img/avatar/plain/did:plc:vs5ft4qdtkjaxgpwuamtusat/bafkreic5vithz7bfviqnslepaudkphlbdx2cjr7dsho5gp5bvs7ejsw4qu", "header_url": "https://cdn.bsky.app/img/banner/plain/did:plc:vs5ft4qdtkjaxgpwuamtusat/bafkreicgmq4gesat62nh4re36sg43l6rqnzzjik3met4tbqs2cdsgp6gpe", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 4, "complete_expiration_days": 14, "skills": [{"genre": "art"}], "banned": false, "nc": 128}, {"id": 663892, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "コバヤシ⁉️", "screen_name": "iaia_58", "avatar_url": "https://pbs.twimg.com/profile_images/1879864942024916993/qF118kpe.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1668309895777763328/1759167662/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 50, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "video"}], "banned": false, "nc": 16}, {"id": 1636717, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "siDo_ご依頼.Skeb受付中", "screen_name": "siDo_262", "avatar_url": "https://pbs.twimg.com/profile_images/1951687431285288960/JC5_FErV.jpg", "header_url": "https://pbs.twimg.com/prof