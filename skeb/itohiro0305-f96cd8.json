d2-52e4-46bb-9df5-aac35fef8c54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f51e3c251472c2e5f63b4cfa4aef1689 2x, https://si.imgix.net/ad57df4d/uploads/origins/483223d2-52e4-46bb-9df5-aac35fef8c54?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=291f862b31a4f49aeb014f4bb869a253 3x"}, "body": "\u524d\u56de\u306f\u7d20\u6575\u306a\u7d75\u3092\u3042\u308a\u304c\u3068\u3046\u3054\u3056\u3044\u307e\u3057\u305f\uff01\n\n\u300cDragons rides a Crew Dragon\u300d\n(\u82f1\u8a9e\u8868\u8a18\u304c\u6b63\u3057\u3044\u304b\u5206\u304b\u308a\u307e\u305b\u3093\u304c\u97fb\u3092\u8e0f\u3093\u3067\u30c0\u30b8\u30e3\u30ec\u3063\u307d\u3044\u30c6\u30fc\u30de\u306b\u3057\u3066\u307f\u307e\u3057\u305f)\n\u9f8d\u4eba\u3068\u7adc\u4eba\u304c\u5b87\u5b99\u670d(\u8239\u5185\u4e0e\u5727\u670d)\u3092\u7740\u7528\u3057\u3066SpaceX\u793e\u306eCrew Dragon\u306e\u30b3\u30af\u30d4\u30c3\u30c8\u3067\u30b7\u30fc\u30c8\u306b\u5ea7\u3063\u3066\u30ea\u30d5\u30c8\u30aa\u30d5(\u767a\u5c04)\u3092\u5f85\u3063\u3066\u3044\u308b\u3068\u3044\u3046\u7d75\u3092\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\u9f8d\u4eba\u306f\u6c11\u9593\u5b87\u5b99\u65c5\u884c\u8005\u3067\u30ca\u30de\u30ba\u9aed\u306e\u6771\u6d0b\u9f8d\u30bf\u30a4\u30d7(\u8cc7\u6599\u53c2\u8003)\n\u7adc\u4eba\u306f\u8239\u9577(\u30ad\u30e3\u30d7\u30c6\u30f3)\u3067\u897f\u6d0b\u7adc\u30bf\u30a4\u30d7\u306e\u30a4\u30e1\u30fc\u30b8\u3067\u3059\u3002\n\u30b3\u30af\u30d4\u30c3\u30c8\u306e\u30bd\u30ea\u30c3\u30c9\u306a\u8fd1\u672a\u6765\u7684\u96f0\u56f2\u6c17\u3002\n\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u306e\u7dca\u5f35\u3068\u8208\u596e\u304c\u611f\u3058\u3089\u308c\u308b\u76ee\u306e\u8f1d\u304d\u3068\u8868\u60c5\u3001\u305d\u3046\u3044\u3063\u305f\u611f\u60c5\u8868\u73fe\u3068\u96f0\u56f2\u6c17\u304c\u611f\u3058\u3089\u308c\u308b\u65b9\u5411\u6027\u3067\u304a\u9858\u3044\u3067\u304d\u305f\u3089\u3068\u601d\u3044\u307e\u3059\u3002\n\u4eca\u56de\u3082\u9854\u3092\u3088\u304f\u898b\u305f\u3044\u306e\u3067\u30d8\u30eb\u30e1\u30c3\u30c8\u6709\u7121\u3001\u3042\u3068\u30d0\u30a4\u30b6\u30fc\u8d8a\u3057\u306b\u898b\u3048\u308b\u8868\u60c5\u304c\u51c4\u304f\u597d\u304d\u306a\u306e\u3067\u30d0\u30a4\u30b6\u30fc\u306e\u4e0a\u3052\u4e0b\u3052\u5dee\u5206\u3092psd\u3067\u9802\u3051\u308c\u3070\u5b09\u3057\u304f\u601d\u3044\u307e\u3059\u3002\n\u305d\u308c\u3067\u306f\u3088\u308d\u3057\u304f\u304a\u9858\u3044\u3057\u307e\u3059\u3002\n\n\u30b7\u30c1\u30e5\u30a8\u30fc\u30b7\u30e7\u30f3\n\u30ea\u30d5\u30c8\u30aa\u30d5\u307e\u3067\u3042\u3068\u6570\u5206\u3001\u30ab\u30a6\u30f3\u30c8\u30c0\u30a6\u30f3\u7d9a\u884c\u4e2d\u306e\u30b3\u30af\u30d4\u30c3\u30c8\u3067\u30b7\u30fc\u30c8\u306b\u56fa\u5b9a\u3055\u308c\u5f85\u6a5f\u3059\u308b\u7adc\u4eba\u3068\u9f8d\u4eba\u3002\n\u767a\u5c04\u64cd\u4f5c\u306f\u30d5\u30eb\u30aa\u30fc\u30c8\u306a\u306e\u3067\u7279\u306b\u3059\u308b\u4e8b\u306f\u7121\u3044\u304c\u9577\u5e74\u306e\u7d4c\u9a13\u3067\u3064\u3044\u3064\u3044\u30bf\u30c3\u30c1\u30d1\u30cd\u30eb\u3092\u64cd\u4f5c\u3057\u3066\u8a08\u5668\u306e\u6570\u5024\u3092\u78ba\u8a8d\u3057\u3066\u3057\u307e\u3046\u7adc\u4eba\u30ad\u30e3\u30d7\u30c6\u30f3\u3002\n\u540c\u3058\u304f\u4f55\u3082\u3059\u308b\u4e8b\u304c\u7121\u304f\u7dca\u5f35\u3092\u6301\u3066\u4f59\u3057\u3066\u3044\u308b\u6c11\u9593\u5b87\u5b99\u65c5\u884c\u8005\u3067\u3042\u308b\u9f8d\u4eba\u3002\n\u3042\u3061\u3053\u3061\u898b\u56de\u3057\u3066\u3044\u308b\u3068\u30b3\u30af\u30d4\u30c3\u30c8\u306e\u9685\u3063\u3053\u306b\u30ab\u30e1\u30e9\u30ec\u30f3\u30ba\u3092\u767a\u898b\u3001\u7ba1\u5236\u5ba4\u3068\u306e\u9023\u7d61\u7528\u30ab\u30e1\u30e9\u3060\u3068\u601d\u3044\u8fbc\u307f\u622f\u3051\u3066\u30d4\u30fc\u30b9\u30b5\u30a4\u30f3\u3092\u8fd4\u3059\u3002\n\u305d\u308c\u304c\u4e2d\u7d99\u7528\u30e9\u30a4\u30d6\u30ab\u30e1\u30e9\u3067\u5168\u4e16\u754c\u306b\u4e2d\u7d99\u3055\u308c\u3066\u3044\u308b\u3068\u3082\u601d\u308f\u305a\u306b\u2026\u3068\u3044\u3046\u60f3\u50cf\u3067\u4f9d\u983c\u6587\u3092