works": [{"path": "/@sigma_r18g/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3529428, "client_id": 3230918, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5b2baa17/uploads/origins/7c71c85f-7017-4109-8d9a-b3d5b38060de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad5d293f5a55fc9c1d82212bed5fc223", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5b2baa17/uploads/origins/7c71c85f-7017-4109-8d9a-b3d5b38060de?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=84f6a13cf54b8f527487273621061017", "src_set": ""}, "body": "こんにちは！『Age of Empires II』のアステカ文明の少年イーグルウォリアーのイラストを依頼したいです。キャラクターの服装は以下の画像を参考にしてください：\nhttps://ibb.co/F4y8d1C3\nhttps://ibb.co/nsXwqQLs\nその他のキャラクターの特徴はあなたにお任せします。小さな男の子として描いてください（裸足がベストです）。\n\n画像の内容は、この小さな戦士がスペイン人の火縄銃で脚を撃たれて負傷し、捕らえられた後、スペイン式の螺旋絞め（ガロット）で絞め殺されるというものです。\n（参考：\nhttps://www.pixiv.net/artworks/128897420\nhttps://www.pixiv.net/artworks/127720650\nhttps://www.pixiv.net/artworks/133946305\nこれらのポーズはどれも素晴らしいと思うので、自由に選んでください）。\n\n彼が絞首台で苦しみ、痙攣し、処刑人に強制的に手コキされて射精し、最終的に失禁する様子を見たいです。どうもありがと", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@sigma_r18g/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3529428, "client_id": 3230918, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce88d7c5/uploads/origins/d8bfc8f1-2bb5-4723-beee-5570a0b7f570?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0b1e2410037b4bd13b750c148e50e245", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce88d7c5/uploads/origins/d8bfc8f1-2bb5-4723-beee-5570a0b7f570?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95aad1ecbb547c94b2eff4d1857d18b8", "src_set": ""}, "body": "こんにちは！私は『プラント vs. ゾンビ 3 （Plants vs. Zombies 3)』のキャラクターであるネイト（Nate）を描いた、一連の差分付きイラストを依頼したいと思います！\n\n彼のキャラクター設定は、以下の画像を参考にしてください：\n\nhttps://ibb.co/pvjy4YfF\nhttps://ibb.co/TMp86WGD\nhttps://ibb.co/TDmFD3Fj\nhttps://ibb.co/gLV7sbW8\n\n画像の内容はおおよそ次の通りです：\n\nネイトが誘拐され、服を脱がされた状態で刑罰用のベッドに寝かされています。服は脇に投げ捨てられ、手足は大の字に広げられて縛られ、首にはロープがかけられています。誘拐犯は彼を脅します。「次に手コキで刺激を与えたときに射精したら、ロープを締めてゆっくり窒息死させる」と。ネイトの反対を無視し、彼らは「自願承諾書」にサインするよう強要します。ただし、サインではなく、赤い印泥を使って無理やり彼の片足の足跡を紙に押させました。\n\n挑戦が始まりました。最初、ネイトは我慢していましたが、誘拐犯が突然彼の注意がそれた隙に足の裏をくすぐったり舐めたりする攻撃を仕掛けます。苦しい葛藤の末、彼は誘拐犯があらかじめ用意していた瓶の中に射精してしまい、挑戦に敗れました。\n\nその状況に直面し、ネイトは必死に許しを乞い、絶望の涙を流します。しかし、誘拐犯は彼を解放せず、ロープを締め上げながら、悪趣味にも足枷を外し、彼が死にゆく中で足をバタつかせる様子を楽しみます。同時に、手コキの動作も止めません。\n\n最後、ネイトが最後の痙攣を起こすと、残りの白い液体が瓶を満たし、ネイトの失禁とともに、処刑台の上には尿の水たまりが広がりました。\n\n処刑者たちは彼の遺体を運び去り、処刑台には尿の水たまりと精液の入った瓶、そして可愛らしい足跡が押された「自願承諾書」だけが残されました。\n\n終わり。", "nc": 170, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 318432, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ガッツン@『好淫、矢のごとし!』DL配信中!", "screen_name": "gattsun", "avatar_url": "https://pbs.twimg.com/profile_images/1104770376607850497/G3Svy2xu.png", "header_url": "https://pbs.twimg.com/profile_banners/145612554/1615398775/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 32}, {"id": 350081, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "かねこくん", "screen_name": "omiyacha", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fwebpublic-5f453a84-48d5-475d-8004-617232a9fa83.png&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/7b1abde9-8025-47a9-8772-c1ca0742af31.webp", "appeal_receivable": 