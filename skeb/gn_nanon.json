t", "tipped": true, "creator_id": 94842, "client_id": 2190505, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1d6dfd87/uploads/origins/42ad814a-59bd-4350-a748-ff9da18409a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=795364fcdd5483d53da3119549e294ba", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1d6dfd87/uploads/origins/42ad814a-59bd-4350-a748-ff9da18409a4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=88363e8e3f16420ed347973a1ff33939", "src_set": ""}, "body": "下記のとおり、リクエストしたく存じます。\nご検討の程、よろしくお願いいたします。\n\n【キャラクター】\nビキニ・ウォリアーズの「メイジ」をお願いします。\n帽子はとった状態でお願いします。\nキャラ及び帽子の中の髪型は、別添参考資料のとおりです。\nマイナーなキャラ、ジャンルで既出作品が少ないので、別件で依頼したイラストを念のため参考添付します。\n\n【シチュエーション】\n地下の拷問部屋で赤い縄で全裸緊縛され、三角木馬に跨らされているイラストをお願いします。緊縛方法は別添のとおりにお願いします。\n\n【差分希望（金額の範囲内で可能であれば）】\nボールギャグ、乳首クリップのあり・なし\n\n【参考資料】\n・キャラ：https://bikini-warriors.com/anime/chara/c003.php\n・帽子の中（髪型）：http://bikini-warriors.com/figure/f04.php\n　　　　　　　　 ：http://bikini-warriors.com/figure/f07.php\n・緊縛方法（机に縛り付けられている点は無視してください。）\n：https://www.pixiv.net/artworks/123593580\n・別件で依頼した同キャラのイラスト：https://skeb.jp/@mumumu_seijin/works/54", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gn_nanon/works/142", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a434da68/uploads/origins/0ee535dc-b72f-42ac-ad13-a77ecd465dc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05b73d1077a7bd7e4682d04b9827f752", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 94842, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 176, "word_count": 0, "transcoder": "", "creator_