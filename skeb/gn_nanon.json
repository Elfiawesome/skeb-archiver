arly_report_client_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@gn_nanon/works/155", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 94842, "client_id": 40712, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e02fe2da/uploads/origins/7a43703a-8462-4330-8667-5b5d0eeac6da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a7beeb0bf40e011d8e39650671177f4c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e02fe2da/uploads/origins/7a43703a-8462-4330-8667-5b5d0eeac6da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=60028e49678fdb076b3aeda62d00ae6e", "src_set": ""}, "body": "銀髪メイドちゃん(https://www.pixiv.net/artworks/131331925)がとても好みだったので、よりハードな内容なのですが別のシチュも見たくリクエストさせていただきました。\n\n▪️衣装\n•足はサイハイブーツからレザーのガーターベルトに赤いハイヒールパンプスに変更。足以外はおまかせ\n•ハイヒールはかなり高くし、靴の割には描き込む感じ\n\n▪️シチュエーション\n初対面の来客にSMプレイで性奉仕\n•大きく分けて、パンツ留めバイブと竿役描写のセックスの2シーン\n•体位はヒール立ちで腰を振る体位、(立ちバックやしゃがみ立ちの騎乗位、テーブルの上にしゃがみ立ちの後背位などの何か)\n•拘束は鎖付きの首輪、アームバインダー、足に拘束具などハードめに。できればペニスギャグの差分も\n•バイブは太め\n•セックスでは竿役も描写で鎖を引っ張り竿は大きめ\n•苦しそうに拘束から逃れようとしてるが嫌がってはおらずむしろもっと欲しいと思っている\n•結構高いハイヒールのため立っているのがやっとの状態だが、むしろハイヒールを気に入っている\n\n▪️構図\n•ハイヒール全体(特にヒール部分)まではっきり見える\n•竿役の竿は深めに挿入で僅かに見える程度\n\n▪️台詞\n解釈違いあれば自由に変えて構わないのですが、従順ながら客の予想以上に経験豊富でより嗜虐を求める台詞をお願いします。\nバイブ:\n竿役「いや〜、こんな可愛いメイドさんがお客さんにSMプレイさせてくれるなんて最高だよ」\nメイド「ん、んぁ、、んぐぅ」\n竿役「必死に抵抗してもバイブ抜けないね〜wせめてボールギャグ外してあげるよw」\nメイド「ぷはっ、だ、大丈夫です、頑張っても全然動けないの嫌じゃないですから」\n竿役「良いね、興奮してきたし挿入れるよ」\n\nセックス:\nメイド「あん、あんっ、ん、他のお客様よりチンポ大きっ、お腹苦しいっ」\n竿役「苦しくても動けないね〜、もうハイヒールで立ってられないかな？」\nメイド「い、いえ、これくらいは慣れてます」\nメイド「むしろ、その、他のお客様とのセックスではもっとキツめに拘束してもらってまして...」\n竿役「なに他の男とのセックス経験話してるの？悪い子はアームバインダーもっと締め付けちゃうよ」\nメイド「あぁ、もっと、良いです！」\n竿役「じゃ、これも良いよね？」\nメイド「あ、ペニスギャグ、はい、結構好きで他のお客様にもよく付けてセックスしてもらってます」\n竿役「だから今は俺がご主人様だろ、おらっ」\nメイド「んんっ、ん〜！んん〜！」\n\n細かく恐縮なのですがご検討の程よろしくお願いします", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gn_nanon/works/154", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d8d2f99c/uploads/origins/a2e583ba-1364-4946-b91d-40e41cad641a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3cdc2b70a39e597591dd6f35e73376b6", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 94842, "client_id": 3469411, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@gn_nanon/works/153", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fd793442/uploads/origins/1580bbc7-52a1-4b3f-a840-249bb7406a14?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a94d101315df4dab5ff8ba099eca639f", "src_set": ""}, "private": true, "genre": "comic", "tipped": true, "creator_id": 94842, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@gn_nanon/works/152", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/3e6bd8d6/uploads/origins/bf32dd0e-1af1-467f-abf2-7e4fac8b670b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=53c16d45bc62708b78c65d83da3d1aa8", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 94842, "client_id": 3168232, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore"