beb2a-5888-48f1-916f-56e6dc26bf8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2ff209e61560d7834f185c5e067a3c85, https://si.imgix.net/f5ffd3c3/uploads/origins/3c8beb2a-5888-48f1-916f-56e6dc26bf8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=733cb7d9c055d585d1ea3a3921452279 2x, https://si.imgix.net/f5ffd3c3/uploads/origins/3c8beb2a-5888-48f1-916f-56e6dc26bf8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=04a4a9dc18403a3f88be365f7195c9f9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f5ffd3c3/uploads/origins/3c8beb2a-5888-48f1-916f-56e6dc26bf8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=729d9eed35c02cd7f221f74f49abe1b7", "srcset": "https://si.imgix.net/f5ffd3c3/uploads/origins/3c8beb2a-5888-48f1-916f-56e6dc26bf8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=729d9eed35c02cd7f221f74f49abe1b7, https://si.imgix.net/f5ffd3c3/uploads/origins/3c8beb2a-5888-48f1-916f-56e6dc26bf8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2f5648c8df400748d4e74f353c44a677 2x, https://si.imgix.net/f5ffd3c3/uploads/origins/3c8beb2a-5888-48f1-916f-56e6dc26bf8d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3643e34597e2a9ae92ec6e2dbbf45c90 3x"}, "body": "はに丸様こんにちは。\n今回は創作BLのお話を書いていただきたくリクエストを送らせていただきました。\n\n★可能であればNSFW要素が欲しいです。\n左右は決めてないので想像しやすい方でお書きください。\n\n【世界観】\n魔王が討たれ、魔王城が滅びたことで人間と魔族の長きにわたる戦争は終結した。\n戦争の英雄の1人である魔法使いは戦いにおいて大きな活躍を果たし、国王や人々から絶大な信頼を得ていた。\nしかし、魔王城が滅ぼされた際兵士たちが幼い魔王の子を発見。魔族の血筋を断つべきと判断し殺害しようとする。\nこれを目の当たりにした魔法使いは子供に罪はないと庇い「もし彼が害をなすような存在に育つなら自らの手で止める」と誓い、その養育と監視を引き受けた。\n魔族を根絶したい国王はこれに怒りを覚えるが、魔法使いへの恩義から最終的に彼を追放する形で事態を収めた。\n以降、魔法使いと魔王の子は立ち入り禁止区域となった森の奥深くにある古びた屋敷で森に潜む魔物や魔族たちと穏やかに暮らしている。\n森には魔法使いが張った結界があり、人間が容易に立ち入ることはできない。しかし、魔法使いは時折容姿を変えて街へ出かけ日用品を調達したり、旅の息抜きを楽しんだりしている。\n\n\n【登場人物】\n① 魔法使い\n名前:セリオ・ラディアス\n種族: 人間\n性別: 男\n年齢: 500〜 \n身長:177\n性格:\n長命ゆえに達観しており、飄々とした性格。自称天才。実際強い。\n基本的には気まぐれで自由奔放だが、魔王に対しては保護者のような姿勢を見せる。\n人をからかうのが好きで、時折お茶目な一面を見せるが、必要な時には頼れる大人として振る舞う。常にニコニコしていて開眼するタイプの糸目。\n隠し事が多くミステリアス。\nいけない子だねとか言うタイプです。\n\n背景:\n若い頃、不老不死の呪いを外部から受け、それ以来、当時の容姿のまま500年近く生きている。\n長い間、呪いを解くために旅と研究を続けていたが、魔王の子と出会ったことで「彼を見送るまでは、この森で穏やかに過ごそう」と考えるようになった。\n結界で森への人間の侵入を防いでいる。\n\n一人称:僕\n二人称:君 \nダルヴァン:ダルヴァン、魔王様\n\n\n② 魔王（魔王の子）\n名前:ダルヴァン・ノクタリア\n種族: 魔族\n性別: 男\n年齢:100〜150\n身長:185\n性格:\n一見無愛想で冷徹に見えるが、実は根が優しく、部下である魔物や魔族たちには甘い。\n家族を戦争で失った過去から、人間に対して強い憎悪を抱いていたが、魔法使いと共に暮らす中で、少しずつその気持ちが和らぎつつある。(ネタばらしされるまで魔法使いを助けてくれたいい人だと思い込んでいる)\n魔法使いに深く懐いており、恋愛感情に近い特別な想いを抱いているが、それが何なのか自覚していない。\n自分の気持ちには非常に鈍感で、周囲から指摘されても理解しないことが多い。\n森に住む魔族や魔物たちを統率している。\n魔王の血筋を引いているため、潜在的な力は非常に強いが、自分の力を制御することを恐れており、実力の大半を封じている。\n\n一人称:私\n二人称:貴方(その他時と場合に合わせて)\nセリオ:先生、セリオさん、セリオ\n\n\n③ メイドと執事（従者たち）\n種族: 魔族\n役割:\n屋敷内の家事や雑務を担当しており、魔法使いや魔王の子の世話を焼くことを喜びとしていたりいなかったり…。\n主従関係に忠実だが、時折魔法使いの気まぐれや魔王の子の鈍感さに振り回されている。\n\n④ 手下や部下たち\n種族: 魔族・魔物\n役割:\n森に潜む魔物や魔族たちで、屋敷の外で森全体の警備や巡回を行っている。\n魔王の子を「主」として慕っており、彼の命令に忠実。\n\n※魔族や魔物の中には魔法使いを受け入れられない者もいる。\n\n以上が設定になります。\n不明な点がございましたらご自由に解釈していただけると幸いです。\n\n\n【使用用途】\n・個人鑑賞\n・1部の内容をイラストにしSNSに上げる可能性があります。\n\n【その他】\n・形式に指定はありません。\n・創作初心者のため、設定に矛盾や誤りがあるかもしれません。その場合は作品内でご自由に変更していただいて構いません。\n\n最後までお読みいただきありがとうございました。金額や内容に問題がありましたら再送要請をお願い致します。\nお手数おかけしますがご検討のほど、よろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1jYCDLus6N7Ji_PJyvVwB7lKxuDriDQtD", "nc": 184, "word_count": 191, "transcoder": "text", "creator_acceptable_same_genre": false}, {"path": "/@hanimary_h/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "novel", "tipped": false, "creator_id": 2704243, "vtt_url": null, "thumbnail_image_urls": {"src": "https://skeb-avatar.imgix.net/https%3A%2F%2Fpbs.twimg.com%2Fprofile_images%2F1714835653878493184%2FaHvI3fSF.jpg?blend64=aHR0cHM6Ly9za2ViLWF2YXRhci5pbWdpeC5uZXQvfnRleHQ_&blendalpha=100&blendalign=center&blendmode=normal&blendsize=inherit&bg=%23fff&auto=fo