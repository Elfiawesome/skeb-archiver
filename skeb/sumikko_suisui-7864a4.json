s=fa3f334a7c36308c2c0e2de694f90bfa", "srcset": "https://si.imgix.net/440ce5e8/uploads/origins/3bd567e9-b434-46a5-bb8d-c207a807666c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fa3f334a7c36308c2c0e2de694f90bfa, https://si.imgix.net/440ce5e8/uploads/origins/3bd567e9-b434-46a5-bb8d-c207a807666c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cc1c54ee8bf0cf966a9ec10979b10e25 2x, https://si.imgix.net/440ce5e8/uploads/origins/3bd567e9-b434-46a5-bb8d-c207a807666c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c84963b53a03a9b4abfc1c1f732d5cbe 3x"}, "body": "こんばんは、ちょこと申します。  \n新着とXにてすみっこ様の作品を拝見し、淡く柔い色合いの絵柄や雰囲気に惹かれリクエストを送らせて頂きました。  \n私とフォロワーのキャラクター2名を描いて頂けないでしょうか。  \n以下、リンクにて作画資料と補足設定を添付しております。   \n\n▽希望  \n基本的に構図等全てすみっこ様の解釈にお任せしたいので自由に描いていただけますと幸いです。  \nURL内フォルダには2パターンの衣装がありますので描くシチュエーションや内容等に合わせてお選び頂けますと幸いです。   \n\n資料の不備や金額不足などありましたら対応しますので、お忙しいかとは思いますがご検討頂けますと幸いです。  \nよろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/10Qbk1dcWSGo2DPR-XrZroGOaOIK8JSbb", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sumikko_suisui/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3397874, "client_id": 2587657, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9fab086a/uploads/origins/c0aac341-997b-4959-ad3c-efda3c0961b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a53ce0b50a8c980aebd685012c379b7f", "srcset": "https://si.imgix.net/9fab086a/uploads/origins/c0aac341-997b-4959-ad3c-efda3c0961b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a53ce0b50a8c980aebd685012c379b7f, https://si.imgix.net/9fab086a/uploads/origins/c0aac341-997b-4959-ad3c-efda3c0961b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5795b6f6c4d98aa549d7621474c8d27 2x, https://si.img