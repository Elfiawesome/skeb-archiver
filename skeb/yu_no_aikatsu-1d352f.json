w": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/28f7cf3f/uploads/origins/cb17aeb3-1fa8-49c3-a8d0-34825ec7c4b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95394e7e3cfcf23db328bc23432afea9", "srcset": "https://si.imgix.net/28f7cf3f/uploads/origins/cb17aeb3-1fa8-49c3-a8d0-34825ec7c4b1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95394e7e3cfcf23db328bc23432afea9, https://si.imgix.net/28f7cf3f/uploads/origins/cb17aeb3-1fa8-49c3-a8d0-34825ec7c4b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8c4b25bec639da6efcb747a55910786d 2x, https://si.imgix.net/28f7cf3f/uploads/origins/cb17aeb3-1fa8-49c3-a8d0-34825ec7c4b1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=63e2bd1dfbb259f9f48ce101c8bfb427 3x"}, "body": "はじめまして！日々作品拝見しております！\nとってもキュートで、なおかつセクシーな女の子の絵柄に魅了されております...\n\n今回は「ワッチャプリマジ！」のゲーム筐体における\n弊マイキャラのイラストを依頼させて頂きたくおもいます。\n\n(容姿資料:https://www.dropbox.com/s/ynal82m64inwo7h/sample_yuno.jpg?dl=0)\n(衣装資料:https://www.dropbox.com/s/govonltfmx7zir8/sample_matsuri_3150.jpg?dl=0)\n衣装は資料として添付させて頂きました、アニメ41話でまつりちゃんが着用していた「私達さいこう3150バイブス」でお願いします。\n\n(構図資料:https://www.dropbox.com/s/mjzoskp7yfyc40t/dsc_0631.jpg?dl=0)\n構図ラフというか線画をご用意させていただきました。\nアオリ構図でぺたんと座り、胸の前で手を伸ばして組んでいる感じになります。スカートがぶわっと流れてる感じに。\n表情は見上げる感じで朗らかな笑顔、バストはご覧の通り大きめで...\n彩色や仕上げレベルはコストに見合う感じでお任せいたします！\nよろしくお願いいたします...", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AiCE_star/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 645053, "client_id": 371231, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6f28475/uploads/origins/62987aa0-a789-4283-b235-7dc5ae3d1810?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d25e1e84309db7c628874467c52c02ca", "srcset": "https://si.imgix.net/c6f28475/uploads/origins/62987aa0-a789-4283-b235-7dc5ae3d1810?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d25e1e84309db7c628874467c52c02ca, https://si.imgix.net/c6f28475/uploads/origins/62987aa0-a789-4283-b235-7dc5ae3d1810?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d0f4fda5788b5acbf9cd673b3b774243 2x, https://si.imgix.net/c6f28475/uploads/origins/62987aa0-a789-4283-b235-7dc5ae3d1810?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8062a3a778b5a1c67e852bc15cb443e1 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6f28475/uploads/origins/62987aa0-a789-4283-b235-7dc5ae3d1810?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=031f605eb8e2e48697dbee4a18aa3c11", "srcset": "https://si.imgix.net/c6f28475/uploads/origins/62987aa0-a789-4283-b235-7dc5ae3d1810?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=031f605eb8e2e48697dbee4a18aa3c11, https://si.imgix.net/c6f28475/uploads/origins/62987aa0-a789-4283-b235-7dc5ae3d1810?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=f865efce6556d8e909121b529d348d94 2x, https://si.imgix.net/c6f28475/uploads/origins/62987aa0-a789-4283-b235-7dc5ae3d1810?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2210383d938b8d216604b107a3d5c1a3 3x"}, "body": "お世話になっております！ゆうのです！\n今回は夏休み合わせということで、昨年に続く水着イラストのご依頼させて頂きます！\n\n登場人物は御マイキャラのあぃすちゃん、浦上茶月さんのマイキャラのはなよちゃん、弊マイキャラのゆうの。\nテーマは「夏の浜辺で水遊び、飛沫に濡れながら目一杯はしゃぐ3人」といった感じです。\n今回こちらからの構図指定はあえてさせて頂かず、そちらの自由なイマジネーションでやって貰えたらと思います！\n「とびきりキュートで楽しそうに、加えてほんのりセクシーに(ポロリもある...？ない...？ないよ！！)」みたいな感じで仕上げて貰えたら嬉しいです。\n\n水着のデザインですが、あぃすちゃんとゆうのは昨年の作品と同じ(レインボーベリーパルフェがベースのデザイン)、\nはなよちゃんのは、可能でしたら茶月さん御本人に希望をお伺いしてもらい\nそのデザインに基づき作画をして貰えたら...！！\n\n3人同画面構図だったり、他にも様々大変な部分ばかりですけれども\nコストが許す範囲で仕上げて下さると幸いです。よろしくおねがいします", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@little_colors/works/55", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 373931, "client_id": 371231, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/910a3706/uploads/origins/ffea2daa-38b6-441a-a7d6-cfbc9fd5038d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc42b0a5270f89b1ab95e9fa1ede4bf7", "srcset": "https://si.imgix.net/910a3706/uploads/origins/ffea2daa-38b6-441a-a7d6-cfbc9fd5038d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cc42b0a5270f89b1ab95e9fa1ede4bf7, https://si.imgix.net/910a3706/uploads/origins/ffea2daa-38b6-441a-a7d6-cfbc9fd5038d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=32c83e9e0971ab0a9922ec5c5aa63f53 2x, https://si.imgix.net/910a3706/uploads/origins/ffea2daa-38b6-441a-a7d6-cfbc9fd5038d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=328646dbeecd769d571fceaad36ddb34 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/910a3706/uploads/origins/ffea2daa-38b6-441a-a7d6-cfbc9fd5038d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c242b7fea5f3e406eb335dbda7376d04", "srcset": "https://si.imgix.net/910a3706/uploads/origins/ffea2daa-38b6-441a-a7d6-cfbc9fd5038d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c242b7fea5f3e406eb335dbda7376d04, https://si.imgix.net/910a3706/uploads/origins/ffea2daa-38b6-441a-a7d6-cfbc9fd5038d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=356d90d1514a3565ba0a4d55a754e85c 2x, https://si.imgix.net/910a3706/uploads/origins/ffea2daa-38b6-441a-a7d6-cfbc9fd5038d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=75d70ce79554d94c12d51a3d066f330f 3x"}, "body": "毎度お世話になっております！作品楽しませていただいております。\n今回も軽めの募集ということで、センシティブでない一般イラストの依頼をさせて頂きたいと思います。\n\n以前依頼致しました、弊マイキャラの全身立ち絵の依頼をさせてください。\n(弊マイキャラの資料はこちらになります)\nhttps://www.dropbox.com/s/zswhbrhb6ez7vwk/DSC_8922.JPG?dl=0\n今回もポーズの構図ラフをご用意させて頂きました。\nhttps://www.dropbox.com/s/widxizpjmzd8in7/dsc_9217.jpg?dl=0\n元気よくピースサインをつくっている感じで、スカートが軽く捲れて下着が覗いている感じになってます。\n合わせて衣装(カラフルパレードコーデ)の資料も添付いたします。\nhttps://www.dropbox.com/s/wz69wnxgu415u3w/1464070564001.jpg?dl=0\n胸は以前の依頼同様大きめで、躍動感ある感じにして貰えると嬉しいです。\n可能であればグッズ化して手元に保存したいので、足元までの全身を描画して下さればと思います。\n元気溢れる明るい感じの作品にして下されば...よろしくおねがいします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@AiCE_star/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 645053, "client_id": 371231, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4fdfc027/uploads/origins/b19f88e7-1312-4b7a-ad4b-28ee8555a577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69a8a25a3fade8a37688cc7c11d9f8cb", "srcset": "https://si.imgix.net/4fdfc027/uploads/origins/b19f88e7-1312-4b7a-ad4b-28ee8555a577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=69a8a25a3fade8a37688cc7c11d9f8cb, https://si.imgix.net/4fdfc027/uploads/origins/b19f88e7-1312-4b7a-ad4b-28ee8555a577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e28b6a0b5a75de43a3b3ade8bb43f353 2x, https://si.imgix.net/4fdfc027/uploads/origins/b19f88e7-1312-4b7a-ad4b-28ee8555a577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=98bd0bc3f2131a20a2fa4e46bfe1e7ff 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4fdfc027/uploads/origins/b19f88e7-1312-4b7a-ad4b-28ee8555a577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6fcc24d962ef2df71113944f6524c0c3", "srcset": "https://si.imgix.net/4fdfc027/uploads/origins/b19f88e7-1312-4b7a-ad4b-28ee8555a577?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6fcc24d962ef2df71113944f6524c0c3, https://si.imgix.net/4fdfc027/uploads/origins/b19f88e7-1312-4b7a-ad4b-28ee8555a577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0f4b927c6830c338c8f566947e221ab5 2x, https://si.imgix.net/4fdfc027/uploads/origins/b19f88e7-1312-4b7a-ad4b-28ee8555a577?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=48cdd9fb5f7f7087493b690ed1d3efe2 3x"}, "body": "お世話になっております！ゆうのです！\n先日はお祝いありがとうございました〜！\nで、かねてからご用意していた次のご依頼なのですが、季節がずれてしまったので\n今回新たなお題でご依頼させて頂きます！\n\n今回は、御マイキャラのあぃすちゃん、\n浦上茶月さんのマイキャラ・はなよちゃん、\nそれと弊マイキャラのゆうのの3人でお花見を楽しんでいる、という構図を描き起こさせて頂きました。\n(https://www.dropbox.com/s/0ql5bdojuebq88q/dsc_8242.jpg?dl=0)\nひとまずご用意させていただいた構図なのですけど、下記のコンセプトを表現する過程で\nそちらのほうで大きく構図を変更しても構いません！見栄え重視で好きに変えてしまってください。\n\n<コンセプトとか>\n満開の桜の下、シートの上にたくさんのお弁当を広げてお花見を楽しむ3人\nはなよちゃんはペットボトルを持ってきたらしく、しゃがみこんでそれを並べている\nあぃすちゃん、ゆうのはそれを出迎えるように楽しそうに笑い掛ける\n画面中央に色とりどりのお弁当が豪華に広がる感じに(メニュー、デザインはお任せ致します、大変だとは思いますが...)\n背景には、色鮮やかな桜の咲く様が映り込んで、春うららかな季節を感じられるように\n<衣装>\nあぃすちゃん:ドリームアカデミー制服\nはなよちゃん:四ツ星学園一般制服\nゆうの:四ツ星学園幹部制服\nお弁当や桜にコストがかかるぶん、衣装は抑えめに致しました...\n恐らく初描きになるであろうはなよちゃんは、先の同人誌「MY MEMORIES」の表紙のデザイン準拠でお願いします(お胸のサイズも...)\n\n3人同画面構図だったり、他にも様々大変な部分ばかりですけれども\nコストが許す範囲で仕上げて下さると幸いです。よろしくおねがいします", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@AiCE_star/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 645053, "client_id": 371231, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a5fd895/uploads/origins/21ee3336-7b86-4750-80dc-ff25d1dff7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75dfa25ec89f5ca414a6070db83956a6", "srcset": "https://si.imgix.net/1a5fd895/uploads/origins/21ee3336-7b86-4750-80dc-ff25d1dff7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=75dfa25ec89f5ca414a6070db83956a6, https://si.imgix.net/1a5fd895/uploads/origins/21ee3336-7b86-4750-80dc-ff25d1dff7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0437fbbfb4acead0e1aef2451ee7a7cb 2x, https://si.imgix.net/1a5fd895/uploads/origins/21ee3336-7b86-4750-80dc-ff25d1dff7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ddd98044f99691c3c9b9ae747673f82b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a5fd895/uploads/origins/21ee3336-7b86-4750-80dc-ff25d1dff7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd9771c16522aa5c903cc2092f09ae95", "srcset": "https://si.imgix.net/1a5fd895/uploads/origins/21ee3336-7b86-4750-80dc-ff25d1dff7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd9771c16522aa5c903cc2092f09ae95, https://si.imgix.net/1a5fd895/uploads/origins/21ee3336-7b86-4750-80dc-ff25d1dff7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7b85f7a838726f46334b37f314791ee1 2x, https://si.imgix.net/1a5fd895/uploads/origins/21ee3336-7b86-4750-80dc-ff25d1dff7e4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4e07dadf5c3bc4fe99d1955a5860d7c9 3x"}, "body": "先はほんとうに素晴らしい作品をありがとうございました！\nかわいいあぃすちゃんを再び見たくなったので、今回年末テーマで依頼させて頂きます。\nまたもコスト過多かも...😭見合わない部分は省略などで調整お願いします...\n\n<全体の構図>\nhttps://www.dropbox.com/s/12yzt4keelqe6sr/dsc_7429.jpg?dl=0\nこちらに構図ラフを用意させて頂きました。\nクリスマスシーズンに合わせて、御マイキャラのあぃすちゃんと\n弊マイキャラのゆうのとで、クリスマスツリーの飾り付けをしている構図となります。\nゆうのは台に乗っかり、ツリーの飾り付けに集中している感じ\nあぃすちゃんは買い出しから帰ってきた仲間のアイドルちゃん達に出迎えの笑顔を向ける感じになります(めちゃくちゃキュートな笑顔でお願いします！)\n\n<衣装・細かい指定等>\nhttps://www.dropbox.com/s/gv8cetwx2zru8bs/dsc_7408.jpg?dl=0\nhttps://www.dropbox.com/s/yw12sn1at6r77a5/screenshot_20211008-171637.png?dl=0\n衣装は色々探した結果、アニメ「アイカツスターズ！」のクリスマス回に登場したサンタ衣装が\n肩見せでとてもかわいかった🥰ので、そちらの資料を添付致します。\n胸の膨らみを強調、谷間が見える感じ、スカートは短めで太もも強調な感じにして下さると嬉しいです🥰\nhttps://www.dropbox.com/s/7729rb3ku54aaw0/screenshot_20211008-103046.png?dl=0\n装飾は可能であれば、レインボーベリーパルフェをイメージした何かを付けてくださると嬉しいですが...コストの関係もあり無理には申せません😭\n\nツリーの装飾や背景に関しては、これまたコストの関係で無理が申せないのですが\nコストの範囲内でクリスマスっぽく、アイカツっぽく！！をテーマに色々付けてくださると有り難いです。\n(ぼくの推しキャラである小春ちゃんぽいのや、あぃすさんの推しっぽいなにかもついてると嬉しいかなぁ...)\n\nかなりセンスが問われる難しい依頼ですが、クリスマスに間に合えば大丈夫ですので！\nゆっくりお待ちさせて頂きます...", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@niwatori0048/works/63", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 65659, "client_id": 371231, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/97c0f66a/uploads/origins/ad316113-bde2-45a6-82e4-f409f4edd708?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=036ffbffb605a368f0186789ed8bc6fb", "srcset": "https://si.imgix.net/97c0f66a/uploads/origins/ad316113-bde2-45a6-82e4-f409f4edd708?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=036ffbffb605a368f0186789ed8bc6fb, https://si.imgix.net/97c0f66a/uploads/origins/ad316113-bde2-45a6-82e4-f409f4edd708?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=abad62aff7533d669523b136ff5b24b5 2x, https://si.imgix.net/97c0f66a/uploads/origins/ad316113-bde2-45a6-82e4-f409f4edd708?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=667c111d0f62a00abddfe5d704d6a851 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/97c0f66a/uploads/origins/ad316113-bde2-45a6-82e4-f409f4edd708?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9b4e89c9f0ecadd111e9e2a33117873f", "srcset": "https://si.imgix.net/97c0f66a/uploads/origins/ad316113-bde2-45a6-82e4-f409f4edd708?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=20