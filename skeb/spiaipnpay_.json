ranscoder": "", "creator_acceptable_same_genre": false}, {"path": "/@spiaipnpay_/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/7e5f1c7b/uploads/origins/2beadc55-2530-4ba6-b7b8-067e944c6add?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fb865e9a8a09498142b909e9e3931619", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2681589, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@spiaipnpay_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2681589, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/be9a7c4c/uploads/origins/72e16aa5-2f85-4841-92a4-e01a54a49f53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7530871826dd3e871f6bf0ecf3761366", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/be9a7c4c/uploads/origins/72e16aa5-2f85-4841-92a4-e01a54a49f53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=acba33c2f542700b5e1f60771615163c", "src_set": ""}, "body": "初めまして。歌い手活動を行おうと思っているふさくと申します。\n\ntwitterで拝見し、skebの作品に魅了されたので依頼させていただきたいと思いました。\n\n以下の依頼内容をご確認いただき、ご検討いただけますと幸いです。\n\n・使用用途　SNSでの使用。今のところ収益化は考えていません。\n\n・構図\nお送りさせていただくピンク髪の子が、困って少し涙を流しそうになっているところを書いていただきたいです。\n\n写っているところが見切れないようにして頂きたいです。\n\n表情差分もあればうれしいですが、難しいようでしたら大丈夫です。\n\n\n背景や文字がある場合は、できるのでしたら、分けたものもいただきたいです。\n無理でしたら大丈夫です。\n\n・見た目　\nピンク髪の子は男の子です。\n目の右下にハートがあります。\n\n参考\nhttps://lit.link/fusaku\n\nhttps://lit.link/fusaku", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@spiaipnpay_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2681589, "client_id": 3143978, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c51c24fb/uploads/origins/cb4b2265-3e58-42c7-b97a-3e20d1757780?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20c140c72c2d43368ed9a1bf560e6ff3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c51c24fb/uploads/origins/cb4b2265-3e58-42c7-b97a-3e20d1757780?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1bdc42f7ceb69b11cfa11e0d6b52486b", "src_set": ""}, "body": "TwitterやYouTubeで活動しています。\nユウイと申します。\n活動に使用できるイラストをリクエストさせてください。構図やポーズ、服装など詳細はお任せします。\n\n【参考資料】\nhttps://twitter.com/Yu_u_i_611/status/1764196160812855642\n\n身長170cmくらいの日本人男性です。\n\n丸いメガネをかけています。\n細いフレームです。\n\n髪は紫色です。\n\n瞳は赤色です。\n瞳にはハイライトがありません。\n\n肌は白くて、日焼けしていない不健康な感じです。全体的に痩せています。\n\n資料だと服は紫色のスウェットですが、服は描きやすいものに変更しても構いません。\n紫以外だと黒色の服を好みます。\n\nポケモンのゲンガーが好きなので、できたら一緒に書いて頂きたいです。二次創作や版権物をNGにしている場合は人物のみで大丈夫です。\n\n活動に使用するため、背景を透過してください。\n\n活動での使用や印刷、グッズ化等についてNGな場合は使用できない用途について記載したデータを一緒に納品して頂けると助かります。", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@spiaipnpay_/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2681589, "client_id": 2676124, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/81e6484f/uploads/origins/2d66dea7-07c7-4585-9273-889b95f16ab8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=95f5552719bd66877c445a1d2067bc0a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/81e6484f/uploads/origins/2d66dea7-07c7-4585-9273-889b95f16ab8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1468c2de67892dfa15a113c0d97fb858", "src_set": ""}, "body": "ぱっぴさんこんにちは！\nぱっぴさんの可愛らしく柔らかそうでもちもちな絵柄と美味しそうな塗りが大好きなので、いつかskebお願いしてみたいと思っていました。\n\n今回お願いしたいのは「実験台δは青に微笑む」自陣の黄金ダスクくんと日野ひまです。\n\n黄金くんのみ資料を持ち合わせていなかったため、ひまのみ資料を添付します。\n\n服装や構図等全てお任せいたします。ぱっぴさんの解釈でご自由に描いていただけたら私が嬉しいです。\n使用用途は個人鑑賞となります。\n\nご検討いただけますと幸いです。\nご縁があればどうぞよろしくお願いします。\n\nhttps://www.dropbox.com/scl/fo/fp0tl2hvvubconzfdcu3o/h?rlkey=ssxiowyh0wtb1nhk8ijqb6v5n&dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 1357217, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "yrb🥨", "screen_name": "Y0323_", "avatar_url": "https://pbs.twimg.com/profile_images/1697117270177353728/cs23jSgw.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1110538805604343809/1681615901/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 7, "skills": [{"genre": "art"}], "nc": 145}, {"id": 1997549, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "536", "screen_name": "torasaburo_36", "avatar_url": "https://pbs.twimg.com/profile_images/1837004699138170880/kNYauMYA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1697590389262467072/1754277100/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}, {"genre": "correction"}], "nc": 144}, {"id": 2063435, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "なじ︎︎まる", "screen_name": "najimaru_0228", "avatar_url": "https://pbs.twimg.com/profile_images/1955801996864503808/tu-V9SEE.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1072710295888351232/1676221