-8de.notion.site/11d749b94f3f4d6e9063b6766a719c93?pvs=4", "nc": 17, "word_count": 5973, "transcoder": "text", "creator_acceptable_same_genre": true}, {"path": "/@pt_1768/works/2", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/fb3aed79/uploads/origins/9d4d0cc5-03c3-4059-ace1-85248a5113d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3ba432cb95ae01e456e97efa2b9b4e39", "srcset": "https://si.imgix.net/fb3aed79/uploads/origins/9d4d0cc5-03c3-4059-ace1-85248a5113d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3ba432cb95ae01e456e97efa2b9b4e39, https://si.imgix.net/fb3aed79/uploads/origins/9d4d0cc5-03c3-4059-ace1-85248a5113d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d10934651bb53f19ae582bc5c52fc188 2x, https://si.imgix.net/fb3aed79/uploads/origins/9d4d0cc5-03c3-4059-ace1-85248a5113d4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7cdcd3f2ce2ac4c25f4fd470425ebc36 3x"}, "private": true, "genre": "novel", "tipped": true, "creator_id": 1488073, "client_id": 742836, "nc": 17}, {"path": "/@pt_1768/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e67cd371/uploads/origins/4034ff63-f4e7-4354-8be2-439c34d88cb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7d1f9a6dff1440478966d5d1c61896ef", "srcset": "https://si.imgix.net/e67cd371/uploads/origins/4034ff63-f4e7-4354-8be2-439c34d88cb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w