ts/237078_13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=265a8fc9b63ff975dae3150b13b2589d, https://si.imgix.net/13fc0041/requests/237078_13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d52e004eb06a6c747d751ed317d64b13 2x, https://si.imgix.net/13fc0041/requests/237078_13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=150d40c5eb1dfe54286ef9969d43b4c6 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/13fc0041/requests/237078_13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e9dd7d153e0076d33bd3ee9a892151c", "srcset": "https://si.imgix.net/13fc0041/requests/237078_13?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2e9dd7d153e0076d33bd3ee9a892151c, https://si.imgix.net/13fc0041/requests/237078_13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=10150ac80215186381159c597259de85 2x, https://si.imgix.net/13fc0041/requests/237078_13?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1baf272eb01b5a7a597d26f42a0465b7 3x"}, "body": "お疲れ様です。\ntwitchで使用するエモートスタンプを2個依頼したいです。\n自分のTwitterアイコンの「だんご」をまるまるとかわいらしく描いていただけるとなおうれしいです。\n一つ目は、だんごが飛びだしていって下部に「HI」という文字（〇三←こんな感じで飛ばしてください）、二つ目は、だんごが片目ウインクしていて、手はサムズアップ（右手か左手化はどちらでも構いませんが、ｂ←みたいな感じで、手はそんなに現実の人間に忠実にしないでください）、文字だと「（I＜）b」みたいな感じで想定しています。\nこれもまた下部に「GL」とつけてほしいです。\nだんごの色なのですが、基本的に緑色（抹茶に近い）を想定しています。目はお任せしますが、あまり現実のような感じではないものが好みです。（某カ〇ビィのような感じがベストですが、大きさの関係上わかりづらくなりそうならここは気にしないでください。）\n「HI」と「GL」の文字色は、一応山吹色に黒い縁であると視認性が向上してよいと考えています。また、文字のフォント等は指定等はありませんが、細い文字より太い文字のほうがこれもまた視認性が上がると思います。\n最後に、エモートスタンプのサイズは28×28なので、このサイズでも見やすいようなごちゃっとしていないものを希望します。\n注文が多く大変申し訳ございません。何卒よろしくお願いします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 432637, "creator": tr