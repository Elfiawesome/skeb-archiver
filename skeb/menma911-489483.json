uploads/origins/843c3844-d2d3-4bcd-9bff-f7aef73843ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8509ea65c794a3c81a5f5c59cdb2a1cd 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/061072e8/uploads/origins/843c3844-d2d3-4bcd-9bff-f7aef73843ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c08a54f8fb866f29cf31bc7bfdbfcd86", "srcset": "https://si.imgix.net/061072e8/uploads/origins/843c3844-d2d3-4bcd-9bff-f7aef73843ab?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c08a54f8fb866f29cf31bc7bfdbfcd86, https://si.imgix.net/061072e8/uploads/origins/843c3844-d2d3-4bcd-9bff-f7aef73843ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1bb0a619b4384bf14cc82a2b26af793f 2x, https://si.imgix.net/061072e8/uploads/origins/843c3844-d2d3-4bcd-9bff-f7aef73843ab?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9d205bc7deafd805b16f508ba196c4fb 3x"}, "body": "前回は可愛らしいシロナさんのイラスト(https://skeb.jp/@menma911/works/1)をありがとうございました。\n\n今回は、おとなのおねえさん(https://twitter.com/menmaTF/status/1173474688359489536)のイラストを2カットお願いします。\n\n◆1カット目 シチュエーション\n精神が幼児退行し、前回リクエストのシロナさんのようにベビー服と紙オムツという格好のおねえさんが、失禁してしまった不快感から涙目になりながら立っている。\n\n服のデザインはシロナさんと同じ、紙オムツのデザインは資料URL先のモデルの女の子のようなピンク色。失禁した事でお知らせサインは黄色になっている。\n\n◆2カット目　シチュエーション\n構図・体勢・服装等は1カット目と同じ。\n不安を紛らわす為に、右手の親指をおしゃぶりしている。涙目はそのまま。\nオムツのシルエットは1カット目よりも尿を吸って膨らんだ状態になっている。\n\n以上となります。よろしくお願いします。\n\nhttps://www.torepanman.jp/ja/home.html", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@menma911/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 129155, "client_id": 371393, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4b777e53/uploads/origins/2f23938d-7841-4404-99b8-cb0969f6c2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca4377d2db7c3514e900dd8e0f5ab8d8", "srcset": "https://si.imgix.net/4b777e53/uploads/origins/2f23938d-7841-4404-99b8-cb0969f6c2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ca4377d2db7c3514e900dd8e0f5ab8d8, https://si.imgix.net/4b777e53/uploads/origins/2f23938d-7841-4404-99b8-cb0969f6c2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f04ad9598bbe360a7a3f3a7fada951ba 2x, https://si.imgix.net/4b777e53/uploads/origins/2f23938d-7841-4404-99b8-cb0969f6c2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c50afce429a5cb37d0c385dc62fd419e 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4b777e53/uploads/origins/2f23938d-7841-4404-99b8-cb0969f6c2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab15812e279380540a6265ce3a3816d4", "srcset": "https://si.imgix.net/4b777e53/uploads/origins/2f23938d-7841-4404-99b8-cb0969f6c2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ab15812e279380540a6265ce3a3816d4, https://si.imgix.net/4b777e53/uploads/origins/2f23938d-7841-4404-99b8-cb0969f6c2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=225cc8ff77899f4a93cebad744e949a8 2x, https://si.imgix.net/4b777e53/uploads/origins/2f23938d-7841-4404-99b8-cb0969f6c2b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=18b3b8c6ee5e622e160300656597624f 3x"}, "body": "お待たせいたしました。\n\nブルーベリーに変身して慌てる若い女性のイラストをお願いしたいです。教室から逃げ出そうとしたところ、膨らんだ体がドア枠に引っかかってしまう。キャラクターは、傲慢で自信家なタイプです。おてんば娘かパンクかもしれません。彼女は上級生と思われる日本のカジュアルな制服を着ている。シャツ、ネクタイ、スカート、レギンス、そしてショートヘアかボーイッシュな髪型。\n\n現在変身中で、お腹、腰、胸は熟して膨らんでいる。肌は青く、表情は恐怖と興奮をコントロールしたような表情をしている。服は傷んでおり、汁が漏れているようなシミもある。\n\n構図は全身で、イラストを縁取るのはドアである。被害者はドアの内側から部分的に膨らんでいる。きしみやうめき声などの効果音も評価できる。外枠が白の場合もあります。\n\nご要望がお気に召さない場合は、遠慮なくお断りください。悪気はないのですが。\n\n私は、あなたの創造性と変身をテーマにしたイラストの多様性を楽しんでいます。私の意見としては、あなたは恐怖と屈辱をとても上手に表現していると思います。これが、私があなたに依頼することを決めた理由です。\n\n参考までにリンク先を添付しておきます。気軽な参考資料としてご利用ください。この同人誌は2002年発行と非常に古いものです。この話がインターネット上で公開されると、ファンやアーティストの支持を得ることになった。長い年月を経た今でも、このフェティッシュはニッチな人気を誇っている。\n\nhttps://drive.google.com/drive/folders/14wCXh07Dh6JT6rhel_R3tU_0nQLyjdwR?usp=share_link", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@menma911/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 129155, "client_id": 462569, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/62bfde85/uploads/origins/70222b7c-fd25-4696-a461-8a993a9ef445?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17a341212637509691ae0dc26aef2fc4", "srcset": "https://si.imgix.net/62bfde85/uploads/origins/70222b7c-fd25-4696-a461-8a993a9ef445?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=17a341212637509691ae0dc26aef2fc4, https://si.imgix.net/62bfde85/uploads/origins/70222b7c-fd25-4696-a461-8a993a9ef445?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f1b26de8da9d61ca09f6aa824422e43f 2x, https://si.imgix.net/62bfde85/uploads/origins/70222b7c-fd25-4696-a461-8a993a9ef445?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=92bdac8961dff604460861d7fa10e27d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/62bfde85/uploads/origins/70222b7c-fd25-4696-a461-8a993a9ef445?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3effa332918ba21310cdf07ed1af8d70", "srcset": "https://si.imgix.net/62bfde85/uploads/origins/70222b7c-fd25-4696-a461-8a993a9ef445?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3effa332918ba21310cdf07ed1af8d70, https://si.imgix.net/62bfde85/uploads/origins/70222b7c-fd25-4696-a461-8a993a9ef445?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3e871fbf78cf131daa7ee590be8393fa 2x, https://si.imgix.net/62bfde85/uploads/origins/70222b7c-fd25-4696-a461-8a993a9ef445?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f4fb1c027ef035e48419f04fe641c9b0 3x"}, "body": "A two part dangan ronpa image. Makoto Naegi is strapped to a chair in Junko Enoshima's clothing. He is errect but struggling. There is a metalic mould of junko's face in front of him. It then cuts to after it closed on him, he has an exact copy of her face now, and is drooling and crying in equal measure as he becomes very horny from it. \n\n二部構成のダンガンロンパの画像です。苗木誠は江ノ島淳子の服を着て椅子に縛り付けられている.彼は直立していますが、苦労しています。目の前には順子の顔の金型が。彼は今、彼女の顔の正確なコピーを持っており、それから非常に角質になるので、よだれを垂らして泣いています.", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@menma911/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 129155, "client_id": 280452, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/537be681/uploads/origins/d55f9d50-2144-4017-bda1-bf5d1692cdb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4149edd5c247ccc86809e7ba4abe1472", "srcset": "https://si.imgix.net/537be681/uploads/origins/d55f9d50-2144-4017-bda1-bf5d1692cdb5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4149edd5c247ccc86809e7ba4abe1472, https://si.imgix.net/537be681/uploads/origins/d55f9d50-2144-4017-bda1-bf5d1692cdb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7b06062412a6b83c948e7e98e8e3637f 2x, https://si.imgix.net/537be681/uploads/origins/d55f9d50-2144-4017-bda1-bf5d1692cdb5?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a879d12ec7790d4f286aa1a34b52f674 3x"}, "duration": null, "nsfw": 