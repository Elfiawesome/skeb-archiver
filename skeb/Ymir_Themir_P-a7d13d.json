2&fit=crop&crop=top&w=200&h=200&s=68607ac2cf61f4ee716749d40c824d9a 2x, https://si.imgix.net/7c9af2b4/requests/137317_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=19cf6c46589cbfe203d189c195618a51 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7c9af2b4/requests/137317_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6c965cff5622f5e43a783b6e7cd7307", "srcset": "https://si.imgix.net/7c9af2b4/requests/137317_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d6c965cff5622f5e43a783b6e7cd7307, https://si.imgix.net/7c9af2b4/requests/137317_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=039478d2cfa2ae70b3a3f33b42e81949 2x, https://si.imgix.net/7c9af2b4/requests/137317_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=43375015702247256a4bcc9c13aef3a2 3x"}, "body": "いつもTwitterでイラストを拝見しております。毒茶と申します。\nこの度はヨシカ様に弊アカウントのアイコンに使用しているオリジナルキャラクターのR18イラストの作成を依頼したいと思い、ご連絡差し上げました。\n\n今回作成を依頼するイラストのキャラクターとシチュエーションの詳細は以下の通りになります。\n\n◯キャラクター\n名前:ドクちゃん\n年齢:20代前半\n容姿:近眼でツーポイントでメタルフレームの眼鏡を掛けており、教師をしているため上は白のブラウスで下は黒のタイトスカートです\n髪型:腰までストレートに伸びた黒髪で、前髪はセンターで分けておでこを出しています\n体型:身長は160cm台前半、胸やお尻は並です\n特徴:\n・いつもペカーと気が抜けた笑顔ですが実はちょっとした闇を抱えてます\n・有能そうに見えてポンコツです\n・すぐに調子に乗っては失敗します\n・夜は11時には眠くなります\n\n◯シチュエーション\n激務に疲れ果て身をやつしたドクちゃんが救いを求めた先は偶然仕事帰りに繁華街で発見したマッサージ店だった。\n施術台にうつ伏せになりスーツ姿のまま背中を揉まれると\n初めは男性に身体を触られることに若干の不安を抱きながらも\nすぐにその温かく大きな手の感触に初めてのマッサージなのにうっかりうとうとするドクちゃん。\nそう、彼女は長時間労働で既に心身ともに疲弊し切っていたのだ。(ここまであらすじです)\n\n“「それでは前も失礼しますねー」の声と共に\n身体を起こされ施術台に座るドクちゃん\n背後から伸びる施術師のゴツゴツした手がブラウスのボタンを手際よく外していく\n「へ…？ぇ…？あ、はい…？」\n施術師はさも当然のごとくブラジャーを上にずらすとドクちゃんの張りのある乳房を自然な手つきで揉み込んでいく\n「…？えっと…？これ胸は…？え…？んっ…？」\n「ちょっと手が当たりますけどどうしても痛かったら止めるので言ってくださいねー」\n「あ、ありがとう…ございます？？？」\n(あれ…？これズレて…見えてる…？？でも後ろからだし…大丈夫…？？？)\n困惑し多くの？を浮かべるものの、それまでは完全に普通の快適な施術であったことと、マッサージ店の経験自体が無いため抗議できずそのまま「そういうもの」としてされるがまま受け入れてしまうドクちゃん”\n\n以上の“”内が今回依頼する内容になります。\nご検討頂けると幸いです。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Ymir_Themir_P/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f69ecd51/requests/110162_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd1038be22a93a6ebea55ce656e5b34a", "srcset": "https://si.imgix.net/f69ecd51/requests/110162_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=cd1038be22a93a6ebea55ce656e5b34a, https://si.imgix.net/f69ecd51/requests/110162_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=caafbe0db69107eeaf9f063311899246 2x, https://si.imgix.net/f69ecd51/requests/110162_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=7c0a9c6760343426b352b1be56232145 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 519898, "client_id": 74949, "nc": 163}, {"path": "/@Ymir_Themir_P/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 519898, "client_id": 569054, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/38b79f29/requests/109253_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7c6c7b9ac446afced15cd4fdf5e5ebe", "srcset": "https://si.imgix.net/38b79f29/requests/109253_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7c6c7b9ac446afced15cd4fdf5e5ebe, https://si.imgix.net/38b79f29/requests/109253_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=cr