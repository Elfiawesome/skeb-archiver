-4643-b2fa-cd93057027d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=05f69c86bf9a7c4f12b9a28e5d4201f6, https://si.imgix.net/d5605d73/uploads/origins/2927dc11-c9f5-4643-b2fa-cd93057027d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=53e89b5f532d68039f31ebb6d465292e 2x, https://si.imgix.net/d5605d73/uploads/origins/2927dc11-c9f5-4643-b2fa-cd93057027d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=eac0f8e5fd5cee32ccd88dbf8eafbb8c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d5605d73/uploads/origins/2927dc11-c9f5-4643-b2fa-cd93057027d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=447716405a0fd87e6b84051bf5a36a0f", "srcset": "https://si.imgix.net/d5605d73/uploads/origins/2927dc11-c9f5-4643-b2fa-cd93057027d0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=447716405a0fd87e6b84051bf5a36a0f, https://si.imgix.net/d5605d73/uploads/origins/2927dc11-c9f5-4643-b2fa-cd93057027d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5cd76997c14978110f89e0c0f49746f7 2x, https://si.imgix.net/d5605d73/uploads/origins/2927dc11-c9f5-4643-b2fa-cd93057027d0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=404d23e65130afe03567bfe2ebebc15d 3x"}, "body": "兎莉うり子様\n\n初めまして！個人Vtuberの白河ノさくらと申します。\nSkebでたまたまイラストをお見かけして、兎莉様の描くイラストが大変私の好みで可愛らしいと思った為、リクエストさせていただきます。\n\n今回のリクエストでは、自分を描いていただきたいです。\n\n◎構図：兎莉様のイメージでおまかせしたいです。（サムネイル等に使用したいので、可能でしたら髪の毛の先や指の先等があまり見切れていないと助かります。）\n◎衣装：兎莉様のイメージでおまかせしたいです！コレというものが無ければ、自分の通常衣装でも大丈夫です。すこし複雑な衣装で申し訳ないので、多少の簡略化や改変も可です。（衣装に関する詳細は、資料URLや以下の詳細加筆にてご確認いただけたらと思います。）\n◎形式：背景透過が可能なPSDファイル等であると非常に助かります。\n◎用途：機会があり可能でしたら、今後の活動（主にサムネイルやアイコン、グッズ等）に使用したいと考えております。（その際は、兎莉うり子様のお名前を明記させていただきます。）\n\n☆私の姿詳細（わかりにくい箇所など加筆）\n・九尾で神様な2.5次元Vtuber及びVcreator、名を「白河ノさくら」と申します。\n・髪色：白っぽいピンクで、毛先には赤みがあります。ハイライトは黄みがかっています。\n・髪型：後ろ髪がわかりにくいのですが、ハーフアップをしています。また両サイドが三編みされています。（SAOのアスナと同じような感じですね）\n・顔①：右目（黄金色の瞳）の斜め下に泣きぼくろがあります。\n・顔②：左目（紅色の瞳）に被さるように赤い紋様が入っています。\n・顔③：両目尻に紅を入れています。舞妓さん等がやっているアレです。\n・身長：高下駄(10cm）を含めて158cm。\n・装飾：耳は描いていただきたいですが、尻尾・羽衣に関しては、有無はおまかせします。\n・雰囲気：今回表情指定は特にありませんが、ぽやっとした表情をしていることが多いです。\n※参考Youtubeチャンネル：https://www.youtube.com/c/sacura0610\n\n自分的にわかりやすいようにまとめてみましたが、不明瞭でしたらすみません。\nどうぞよろしくお願いいたします…！\n\n白河ノさくら🌸\n\nhttps://twitter.com/sacura0610", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@retasuwokue2022/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2236468, "client_id": 846315, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/355beff8/uploads/origins/6242f3e0-424b-4412-96bf-68c2c659d042?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfcb130bbe21bc55c4e7946e67b5862f", "srcset": "https://si.imgix.net/355beff8/uploads/origins/6242f3e0-424b-4412-96bf-68c2c659d042?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bfcb130bbe21bc55c4e7946e67b5862f, https://si.imgix.net/355beff8/uploads/origins/6242f3e0-424b-4412-96bf-68c2c659d042?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76ae9cab457bd1573b9282ff9771be82 2x, https://si.imgix.net/355beff8/uploads/origins/6242f3e0-424b-4412-96bf-68c2c659d042?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=4e2a7b5c0fdd4d3e281e7cc11bbe99c3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/355beff8/uploads/origins/6242f3e0-424b-4412-96bf-68c2c659d042?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b4166da82f6bfd7f426af6ea489f071c", "srcset": "https://si.imgix.net/355beff8/uploads/origins/6242f3e0-424b-4412-96bf-68c2c659d042?bg=%23fff&auto=format%2Ccompr