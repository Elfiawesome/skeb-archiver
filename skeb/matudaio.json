ff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=150996316399d2658bcb16a3183a13a8", "src_set": ""}, "body": "はじめまして！\nアイドルマスターシンデレラガールズの緒方智絵里ちゃんと綾瀬穂乃香ちゃんをお願いします。\n智絵里ちゃんは[ホワイト・ハピネス]\nhttps://imas.gamedbs.jp/cgss/images/ZFVT8yAKdvebUih1_mdaldhAI91FcO34zeHabAsyeCg.jpg?1447915675\n穂乃香ちゃんは[ドキドキ☆チャレンジ]\nhttps://imas.gamedbs.jp/cgss/images/1azKXkuapQ8fLq6ylR7Bqa2TdzVn7V4TBf-jhgaxhQM.jpg?1447915675\n以上の服装でお願いします。ほかはおまかせします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@matudaio/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 751553, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fcbc2043/uploads/origins/eeffa47c-653c-40ee-8f4a-9bd7061c9ea6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1ac15a501b9217bd53b63414402d901c", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fcbc2043/uploads/origins/eeffa47c-653c-40ee-8f4a-9bd7061c9ea6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b9dce8dbdcbefb78ab1c88ae3e9cbc23", "src_set": ""}, "body": "わびさび先生、いつもイラストを拝見させていただいております。\n此度はSkebのイラストの募集を開始されておりましたので依頼させていただきました。\n<リクエスト内容>\n緒方智絵里と久川颯が仲良く手をつないで遊園地で笑顔でデートしている様子を描いていただけないでしょうか？\n私服の色合いは智絵里はピンク、颯は水色のコーデでお願いいたします\n\nよろしくお願いいたします", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@matudaio/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 751553, "client_id": 1416553, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0b3bddb9/uploads/origins/bd10e1ab-7ed8-4feb-ab51-531f965be9e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b4be35c0ef5ccc83ed5955107307ee55", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0b3bddb9/uploads/origins/bd10e1ab-7ed8-4feb-ab51-531f965be9e9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a8512d2fb2438de97f9cd446c9d913c2", "src_set": ""}, "body": "初リクエスト失礼します！\nみほゆき（小日向美穂ちゃんと姫川友紀ちゃん）を描いていただきたいのですが、想像力が足りずシチュエーションが思いつきませんでした！！！！\nそこで、わびさびさんが考えられるとても仲良しな二人組らしい事をするみほゆきのイラストをお願いしたいです。\n内容はライブ中の2人の仲良さそうなアクションでも良いですし、オフの日の仲良しな日常のようなシーンでも、なんならお互いが同じ学校に通うとっても仲良しな昔からの幼馴染の設定でも、構いません。殆どなんでもありです。\n衣装の指定ももちろんありませんが、もしお互いの名前を呼び合うセリフを入れることがあるのであれば、『友紀ちゃん←→美穂』でお願いします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@matudaio/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 751553, "client_id": 505030, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/89bab3ee/uploads/origins/e0e73045-c7d0-4dd9-9ea8-81e047c74d2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f71adcdf9eed76da71bd926b86619e3e", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/89bab3ee/uploads/origins/e0e73045-c7d0-4dd9-9ea8-81e047c74d2c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=410bc6772ad537e9c0421064a0e146b5", "src_set": ""}, "body": "五十嵐響子ちゃんと島村卯月ちゃんに何度も(響子と卯月はセリフだけの登場で大丈夫です)イかされる小日向美穂ちゃんをお願いします。\n\nふとももにイった数を書いて欲しいです(5〜8回くらいの数を正の字で)\nおもちゃ使ってイかされてるシーンがみたいです(吸引バイブだとうれしいです)\nなんか百合でいちゃいちゃしてるとうれしいです！！\n\n今回は漫画でお願いします！もし宜しければご検討のほどお願いします！", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@matudaio/works/21", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 751553, "client_id": 624707, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e2227b86/uploads/origins/c4269dd6-ecfe-4bc0-be7f-09e8c091fe39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65de17d229720b8b9f5967429597bef8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e2227b86/uploads/origins/c4269dd6-ecfe-4bc0-be7f-09e8c091fe39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=37cb7f7df5f9e446215624ae575be641", "src_set": ""}, "body": "こんばんは！リクエストさせてください…！\nわびさびさんの絵が大好きで、誰を描いてもらうかすごく悩んだのですが、もし良かったら私の好きなビタースイート・タイムの衣装の小日向美穂ちゃんと、憧れへのステップの衣装の乙倉悠貴ちゃんを描いて頂きたいです…！！\n等身大でも、デフォルメでも大丈夫なので、描きやすい方でお願いします！\nよろしくお願い致します！", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@matudaio/works/20", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 751553, "client_id": 1834055, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c8eb2936/uploads/origins/15d4364e-e471-434b-8749-eaef2f5e52d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=437e909671101b8d670b2789e7b0bcbd", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c8eb2936/uploads/origins/15d4364e-e471-434b-8749-eaef2f5e52d4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a54ed6d3e38be2d2588f16dbe535142e", "src_set": ""}, "body": "いつもイラスト拝見させてもらってます。\nシンデレラガールズの小日向美穂さんと緒方智絵里さんがテーマパークでデートしてるようなイラストをお願いしたいです。\n美穂（くまさん帽子）、智絵里（うさぎさん帽子）を被せてもらえたら喜びます。\n\nご検討のほどよろしくお願いします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 125724, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "しろたけ", "screen_name": "shirotake", "avatar_url": "https://pbs.twimg.com/profile_images/1668963475991957505/ndkPe0Hs.jpg", "header_url": "https://pbs.twimg.com/profile_banners/107746