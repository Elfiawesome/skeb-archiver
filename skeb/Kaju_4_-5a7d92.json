rop=top&w=200&h=200&blur=200&s=08e4501d2b732f0ecf6c4b9d1dd07ad8", "srcset": "https://si.imgix.net/8bdc7b14/uploads/origins/32ebdd7f-3c84-4727-bae3-9922a706121d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=08e4501d2b732f0ecf6c4b9d1dd07ad8, https://si.imgix.net/8bdc7b14/uploads/origins/32ebdd7f-3c84-4727-bae3-9922a706121d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=46f20fc4c4a40cadd05c8749e21f37d0 2x, https://si.imgix.net/8bdc7b14/uploads/origins/32ebdd7f-3c84-4727-bae3-9922a706121d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4bc3ba6f58ff2eb84eb063f23178c898 3x"}, "body": "いつも良いイラストを見させていただいております。\nイラストをリクエストさせていただきます。\n\n・キャラ\nhttps://x.com/Kaju_4_/status/2040555757033365913のサッカー少女\n\n・構図など\n右側にサッカーユニフォームを着たこの子の健全な感じのイラストをお願いします。\n左側は上半身はサッカーユニフォームを着た状態、下半身は脱げている状態で、露出した股間を見せつけるようなM字開脚スタイルで、腰ヘコしながら、ディルドを突っ込まれて絶頂している感じでお願いします。\n\n・その他\nカラーでお願いいたします。また、もしよろしければ、左側のイラストの差分として、ディルドを突っ込まれる前のような感じのイラストを描いていただけますとうれしいです。\n\n上記以外のことにつきましては、最も良いという形でお任せいたします。\n\nご検討のほど、よろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kaju_4_/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3957814, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7d5e0d7c/uploads/origins/20be4303-0b69-4bca-b594-41f8c93be9c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70852a78045e4f8041c69b3e1b285fd2", "srcset": "https://si.imgix.net/7d5e0d7c/uploads/origins/20be4303-0b69-4bca-b594-41f8c93be9c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=70852a78045e4f8041c69b3e1b285fd2, https://si.imgix.net/7d5e0d7c/uploads/origins/20be4303-0b69-4bca-b594-41f8c93be9c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=df4dfaf06ed3f72591bce0fe3417aa7b 2x, https://si.imgix.net/7d5e0d7c/uploads/origins/20be4303-0b69-4bca-b594-41f8c93be9c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3a2fc92913a558037e2c5a1831b5bc82 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7d5e0d7c/uploads/origins/20be4303-0b69-4bca-b594-41f8c93be9c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01ddcf865eebf9d1ac69424d74977d9a", "srcset": "https://si.imgix.net/7d5e0d7c/uploads/origins/20be4303-0b69-4bca-b594-41f8c93be9c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=01ddcf865eebf9d1ac69424d74977d9a, https://si.imgix.net/7d5e0d7c/uploads/origins/20be4303-0b69-4bca-b594-41f8c93be9c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ccf87775d983360b320c39fa25cbe3f3 2x, https://si.imgix.net/7d5e0d7c/uploads/origins/20be4303-0b69-4bca-b594-41f8c93be9c0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bd963d8a1dd579997caa01d79fbb8d06 3x"}, "body": "はじめまして！いつも可愛らしい（そしてスケベな）イラストを楽しみに拝見しています。\n\nよその子の依頼は大丈夫でしょうか？\nsakifox氏（https://x.com/saki_fox）のごすメイ（https://dic.pixiv.net/a/ごすメイ、https://www.pixiv.net/users/110061/artworks/ごすメイ）を描いて頂きたいです。\n※skeb等で氏のうちの子を依頼する許可を頂いています。\n※参考リンク先で不健全絵も描かれている子なので参照される際にはご注意ください。\n\n健全とスケベイラストの組み合わせで、ただただ可愛い健全なメイド服姿と、発情してオナニーしている姿を描いていただきたいです。\n1つのイラストに両方の姿を納める場合、それぞれ単独で切り出したファイルも頂けると助かります。\n\n用途としてsakifox氏には透かし無し・無劣化の画像を共有したく、差し支えなければ自分から個別にファイルを提供させていただきます。\n\nそれではご検討をよろしくお願いいたします。", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Kaju_4_/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3957814, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e4ecd6f7/uploads/origins/ee944032-21a5-495e-894c-731d0a26dc06?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=