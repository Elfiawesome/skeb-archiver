由に調整してください。\n\nこの怪物はこれを基に作られるのだろう。もしかしたらオービーがこれ、あるいはこれに似たものに変身するのかもしれない。 https://x.com/saiminator/status/1913961277749178692/photo/1\n\nもしこのアイデアがお気に召さない場合は、遠慮なく却下してください。読んでいただきありがとうございました！", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@barux_baruda/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1413594, "client_id": 385329, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a9fbf4d0/uploads/origins/59bcc99f-589e-4dd6-9031-13de4339d602?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25da1632ac7baec0f509f1668c25aaf4", "srcset": "https://si.imgix.net/a9fbf4d0/uploads/origins/59bcc99f-589e-4dd6-9031-13de4339d602?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25da1632ac7baec0f509f1668c25aaf4, https://si.imgix.net/a9fbf4d0/uploads/origins/59bcc99f-589e-4dd6-9031-13de4339d602?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=efa483bd1e622ce2614e558979c18714 2x, https://si.imgix.net/a9fbf4d0/uploads/origins/59bcc99f-589e-4dd6-9031-13de4339d602?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9e9454a30e27625ccaf11eebd71136a6 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a9fbf4d0/uploads/origins/59bcc99f-589e-4dd6-9031-13de4339d602?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0f7a123c76cdde5fdfde24fa5496bf1", "srcset": "https://si.imgix.net/a9fbf4d0/uploads/origins/59bcc99f-589e-4dd6-9031-13de4339d602?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0f7a123c76cdde5fdfde24fa5496bf1, https://si.imgix.net/a9fbf4d0/uploads/origins/59bcc99f-589e-4dd6-9031-13de4339d602?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=bdbb101ebde1c9224c894683352a932c 2