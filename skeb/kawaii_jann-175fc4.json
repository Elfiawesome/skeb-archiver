e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=aa7a2633732153739dee2b795c711042 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/63829e3a/uploads/origins/a532ff22-3698-4905-b77e-080b21f9d4e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9851374b102d3d1d1ea98154357b0af", "srcset": "https://si.imgix.net/63829e3a/uploads/origins/a532ff22-3698-4905-b77e-080b21f9d4e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e9851374b102d3d1d1ea98154357b0af, https://si.imgix.net/63829e3a/uploads/origins/a532ff22-3698-4905-b77e-080b21f9d4e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d03cb8871e17f99410cf7880127022ec 2x, https://si.imgix.net/63829e3a/uploads/origins/a532ff22-3698-4905-b77e-080b21f9d4e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c381097a0f1e06ce14a2eb81a9a4a5b4 3x"}, "body": "はじめまして。\n主にYouTubeで配信活動をしている、神代 れいん（かみしろ れいん）といいます。\n\n活動に使用するイラストをお願いしたいと思い、リクエストさせていただきました！\n今回は可能であれば一緒に活動しているメンバーと「２人」でのイラストをお願いさせていただきたいです。\nご検討いただけますと幸いです。\n\n\n〘使用箇所〙\nYouTube(サムネイル、配信、動画等)　・・・収益化済み\nTwitter(ヘッダー、アイコン、ツイートなど）\nご制作いただいたイラストはグッズや配信サムネ等で利用をしたく、 商用利用を許可いただきたいです。\nNGな場合はお手数ですがリクエストをキャンセルをお願いいたします。\n\n\n〘人物詳細〙\n・１人目・・・神代　れいん（かみしろ　れいん）\n参考動画（【 神代れいん 】Vtuber一問一答自己紹介【 新人Vtuber 】）\n⇒https://youtu.be/nZGH3UuIydc\nTwitter\n⇒https://twitter.com/rain_kamishiro\n\n・２人目・・・昊澄　ミィロ（そらとう　みぃろ）\n参考動画（【 昊澄ミィロ 】Vtuber一問一答自己紹介【 新人Vtuber 】）\n⇒https://www.youtube.com/watch?v=PllrpZnociw\nTwitter\n⇒https://twitter.com/miiro316316\n\n参考資料\n⇒https://drive.google.com/drive/folders/1KGi1cXHsj7Ag4kPFV2tTKQM9gWN8mDSI?hl=ja\n\n\n〘希望イメージ〙\n・『マイクを持って歌っている２人』をお願いできたらと思います。\n・ハンドマイク、スタンドマイクはどちらでも構いません。\n・ライブで歌っているような、一緒に仲良く、楽しそうな構図をお願いいたします。\n・全体的なイメージとしては、『ミィロ⇒かっこよく、れいん⇒かわいく』か、『双方かっこいい』イメージです。\n・背景もお描きいただけるのであれば、ライブ会場のようなイメージだとうれしいです。\n・画像向きはお任せいたしますが、可能であれば全身、難しければ上半身腰まであるとうれしいです。\n\n\n〘納品データ〙\n可能な限りレイヤーを分けてPSDデータ、難しいようであればPNGデータで差分を分けていただ\n\nhttps://drive.google.com/drive/folders/1KGi1cXHsj7Ag4kPFV2tTKQM9gWN8mDSI?hl=ja", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1252870, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "シロネコバン", "screen_name": "shiro_neko_ban", "avatar_url": "https://pbs.twimg.com/profile_images/1473996618743828482/NesCh48G.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1383329374233976835/1640263155/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}], "banned": false, "nc": 17}, {"id": 1426666, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ねぎ(原稿中)", "screen_name": "negi_post_", "avatar_url": "https://pbs.twimg.com/profile_images/1937872725751762944/6XHpuSGQ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1322826512/1686145678/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 144}, {"id": 2372367, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "めづ", "screen_name": "happyy_coc", "avatar_url": "https://pbs.twimg.com/profile_images/1526170692940574720/SRrkOtLc.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1526164964397813760/1657018100/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "comple