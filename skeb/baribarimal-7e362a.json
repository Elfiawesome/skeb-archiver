1-17bb-49d6-aa34-7ef030a0e55b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b1137fce40bdbdb8844240a2e357148", "srcset": "https://si.imgix.net/b0c9e6f2/uploads/origins/2b20e531-17bb-49d6-aa34-7ef030a0e55b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b1137fce40bdbdb8844240a2e357148, https://si.imgix.net/b0c9e6f2/uploads/origins/2b20e531-17bb-49d6-aa34-7ef030a0e55b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b5323a585e9ebecf5dc87be3f84a56ec 2x, https://si.imgix.net/b0c9e6f2/uploads/origins/2b20e531-17bb-49d6-aa34-7ef030a0e55b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b275fd98e0d0cc3aa20c4c060e4986c5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b0c9e6f2/uploads/origins/2b20e531-17bb-49d6-aa34-7ef030a0e55b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1cb34c071d1b3a939329c45d2e42d78a", "srcset": "https://si.imgix.net/b0c9e6f2/uploads/origins/2b20e531-17bb-49d6-aa34-7ef030a0e55b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1cb34c071d1b3a939329c45d2e42d78a, https://si.imgix.net/b0c9e6f2/uploads/origins/2b20e531-17bb-49d6-aa34-7ef030a0e55b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=04df48aa36b4803b2b494b0c0b071048 2x, https://si.imgix.net/b0c9e6f2/uploads/origins/2b20e531-17bb-49d6-aa34-7ef030a0e55b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ce0795b2e6ab23d933fb84bc0dfb25bd 3x"}, "body": "お世話になっております。先日も大変ありがとうございました。前回【 https://skeb.jp/@baribarimal/works/10 】のようなテイストでシェリンダの衣装チェンジを是非お願いしたく、再度依頼させていただきます。\n\n今回は任意のデザインのスポーツビキニ姿にてお願い出来ればと存じます。シチュエーションとしては自身らの拠点である城内での鍛錬の直前や最中、といった感じです。柔軟等のウォーミングアップをしていたり、汗だくで休憩／衣装の食い込みを直していたり、と切り取る場面はお任せいたします。基本的にメイクはバチバチにキメていただいてOKです。\n\n素晴らしい女体と御尊顔の描きっぷりを存分に発揮していただきたいため、衣装はシンプルなもので、またボディラインもお好きに出していただいて構いません。同様の理由から、小物(刀・飲料・タオル、等々)の作画をお願いするということもございません。\n\n尚、非常に差出がましいですが、舞台設定上現代日本を想起させるようなオブジェクト等の描写はお控えいただけますと幸いです。(背景はふわっと何となくそれらしく、で差支えございません。)\n\n【備考】\n　・シェリンダ以外のキャラクター描写は勿論不要です。\n　・キャラクターの雰囲気、身体的特徴は(ネイルカラーも含め)過去納品分に準じていただけますと幸いです。\n　・その他、特に記載の無い点はばりまる様のセンスに一任させていただきます。\n\n以上、色々と細かく申し訳ございませんが、ご検討の程何卒宜しくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1Afl5NRsMDvNrdsE_8PeCZLEKpEmq3nbn?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@baribarimal/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3528948, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8eda6445/uploads/origins/057073e8-97ca-4964-9da1-910cf1b6cc00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b156bd7d20a43162ac7dc2743b7653b2", "srcset": "https://si.imgix.net/8eda6445/uploads/origins/057073e8-97ca-4964-9da1-910cf1b6cc00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b156bd7d20a43162ac7dc2743b7653b2, https://si.imgix.net/8eda6445/uploads/origins/057073e8-97ca-4964-9da1-910cf1b6cc00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d650ad8ccbdd096a560f6a53d0339d53 2x, https://si.imgix.net/8eda6445/uploads/origins/057073e8-97ca-4964-9da1-910cf1b6cc00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c25051ef7b782904844b4a8fd8bb2d36 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8eda6445/uploads/origins/057073e8-97ca-4964-9da1-910cf1b6cc00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c299e876cb53f900e3872292bbca9c5e", "srcset": "https://si.imgix.net/8eda6445/uploads/origins/057073e8-97ca-4964-9da1-910cf1b6cc00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c299e876cb53f900e38722