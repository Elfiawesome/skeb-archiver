0&h=200&blur=200&s=06adcc5e27f6fda3579085c705ccfbb5", "srcset": "https://si.imgix.net/77217b5c/uploads/origins/8e406d36-a2d4-4abd-ac23-30cc9e7e7c00?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=06adcc5e27f6fda3579085c705ccfbb5, https://si.imgix.net/77217b5c/uploads/origins/8e406d36-a2d4-4abd-ac23-30cc9e7e7c00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=205a940389a1709a8e55cb1fc5e11723 2x, https://si.imgix.net/77217b5c/uploads/origins/8e406d36-a2d4-4abd-ac23-30cc9e7e7c00?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ecfac87381b229186f1f7fb4ce08d13a 3x"}, "body": "初めまして。\nocのホエクス君とアロン君を描いて頂きたいです。\n\n2人は腹違い、同い年の兄弟です。お互い黙認しています。2人共好意を抱いていますが、嫌われることを恐れて想いを伝えていません。直接身体に触れることを躊躇しますが、心は繋がっています。\n\nそれぞれ別の悪魔と契約しており、ホエクスはアロンの命を助ける為右目を売り、アロンはホエクスとの相思相愛を願って毎日血を売っています(精神を病んでいるのではなく、血を出すための致し方ない傷です)。\n\n出身国はロシア、ユダヤの血が入っています。しんしんと雪降る、自然に囲まれた閑静な街で暮らしています。霞がかった音のない世界です。\n\n見た目の共通特徴として、左目下に3つホクロ\n、カジュアルな服よりクラシックな服が好ましいです。\n\nホエクスは少し体格良く、垂れ目に吊り眉、右眼はありません。普段は眼帯をしています。髪型は短かったりオールバックだったり…、好きに描いて欲しいです。心が傷ついた描写で、身体にヒビが入ります。\n\nアロン君は細身。下まつげとピアス、大量の自傷痕があります。猫耳のようにサイド髪をかき上げています。襟足、前髪が少し長いです。\nよろしくお願いします。\n\nhttps://drive.google.com/drive/folders/1l1M5iSXkUNr-xAlzvO-5r6-51m3wgd8r", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 565998, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "エガキゴウ", "screen_name": "nouka_suitai", "avatar_url": "https://pbs.twimg.com/profile_images/1608420853938802688/SBzZRSLo.jpg", "header_url": "https://pbs.twimg.com/profile_banners/729347287558725633/1709088739/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 25}, {"i