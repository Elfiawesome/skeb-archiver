ix.net/3986b736/uploads/origins/9aedd266-e97e-41fd-a10c-0cc4cfa27ce0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=c480fa499be49bd560feaa28b70bfdc2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3986b736/uploads/origins/9aedd266-e97e-41fd-a10c-0cc4cfa27ce0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0473b001e4637d4ee9a0b5c206ebfdae", "srcset": "https://si.imgix.net/3986b736/uploads/origins/9aedd266-e97e-41fd-a10c-0cc4cfa27ce0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0473b001e4637d4ee9a0b5c206ebfdae, https://si.imgix.net/3986b736/uploads/origins/9aedd266-e97e-41fd-a10c-0cc4cfa27ce0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=966a03ff9c75776b6cdbaf423aee42fb 2x, https://si.imgix.net/3986b736/uploads/origins/9aedd266-e97e-41fd-a10c-0cc4cfa27ce0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=61806e6c3341c7696badd3c9ba7dbee9 3x"}, "body": "はじめまして！アピールありがとうございます。\n\nそれではビル街で急に140m級に巨大化してしまったももありというのでお願いできますでしょうか？\n桃華ちゃまは「まあ！」といった感じでちょっとびっくりはしたけどワクワクしてる感じ、ありすちゃんは「なんですかこれ！？どうなってるんですか？？？」と涙目で慌ててる感じの対比でお願いします。\n\n仔細お任せしますが、巨大娘を初めて描かれる方は下記の失敗が散見されますので注意してみてください。\n・宙に浮いている、もしくは地面に埋まっているように見える。\n・背景から浮いていて合成っぽく見える。\n・遠近法にしか見えない。\n\nよろしくお願いしますm(_ _)m", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@_peke_peke_s/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3733729, "client_id": 1125178, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e8ba2c27/uploads/origins/aba9d599-ddfd-4e53-b462-676ce655f3d2?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&s=911cffe9db7af666a5aac064dd1c22c1", "srcset": "https://si.imgix.net/e8ba2c27/uploads/origins/aba9d599-ddfd-4e53-b462