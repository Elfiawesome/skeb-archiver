二人を描いていただきたいです。\n二人は兄妹で、どちらも殺し屋です。二人ともかなり性格が悪いキャラクターです。\n\n二人とも目の下に赤いほくろがありますので、ご確認いただけますと幸いです。\n男性キャラクターは、短髪で描いていただけますと幸いです。\n構図やポーズなどは先生のお任せでお願いいたします。\n個人鑑賞用としてご依頼させていただきます。\nどうぞよろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/1KFrXMuy0e1EOoaaMbdnWpbcj7rH3l3-e", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@KEIKONICS/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3976437, "client_id": 2326632, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aa6ba302/uploads/origins/95647cb2-c90f-4b88-a69a-9ba9b93bf439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26147c76acf95f2d125bb12bc288f6c2", "srcset": "https://si.imgix.net/aa6ba302/uploads/origins/95647cb2-c90f-4b88-a69a-9ba9b93bf439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=26147c76acf95f2d125bb12bc288f6c2, https://si.imgix.net/aa6ba302/uploads/origins/95647cb2-c90f-4b88-a69a-9ba9b93bf439?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d1235cf6b5803e80ffbdf062176f5ad3 2x, https://si.imgix.net/aa6ba302/uploads/origins/95647cb2-c90f-4b88-a69a-9ba9b93bf439?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=3bd086014021b083695c48944b9ae7ed 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aa6ba302/uploads/origins/95647cb2-c90f-4b88-a69a-9ba9b93bf439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd850d22b301c68fde7488caab18ff72", "srcset": "https://si.imgix.net/aa6ba302/uploads/origins/95647cb2-c90f-4b88-a69a-9ba9b93bf439?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd850d22b301c68fde7488caab18ff72, https://si.imgix.net/aa6ba302/uploads/origins/95647cb2-c90f-4b88-a69a-9ba9b93bf439?bg=%23fff&auto=format%2Ccompress&fm=webp&