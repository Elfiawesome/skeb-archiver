憶がないため、親しげな暁雪を煩わしく思っておりすげなくあしらいますが、なぜか親しみを感じている自分を不思議に思うこともあります。  \n\n・容姿資料: https://drive.google.com/drive/folders/1Vse92N1hmC0pIWTdMSNukBZ1f_zjwXV8\n\n ご検討よろしくお願いします。", "nc": 137, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1335278, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "虚旧式✦", "screen_name": "Kyokyusiki", "avatar_url": "https://pbs.twimg.com/profile_images/1660196979908186114/56cBGGKA.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1314171897794314240/1755319517/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 60, "skills": [{"genre": "comic"}, {"genre": "art"}], "banned": false, "nc": 145}, {"id": 1686210, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "yoni/よに", "screen_name": "yoni_bixid", "avatar_url": "https://cdn.bsky.app/img/avatar/plain/did:plc:dycivmpnup56b4wsosvkwqls/bafkreiasoj6jowwpjh2jqe7mo74zawgvipynapu2iamg4kljhjjkvf3u3u", "header_url": "https://cdn.bsky.app/img/banner/plain/did:plc:dycivmpnup56b4wsosvkwqls/bafkreicehj2ml4beo5xyiwtdiujwztw7kjimaqzb7g7rlwfpnu3xqwf3my", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 90, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 2286402, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "弐藤(ニトー)", "screen_name": "nitonato03", "avatar_url": "https://pbs.twimg.com/profile_images/1943314364544516096/30d0CqND.png", "header_url": "https://pbs.twimg.com/profile_banners/1002911985892188160/1715949192/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_mast