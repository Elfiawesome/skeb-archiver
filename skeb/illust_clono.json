=top&w=200&h=200&s=77a0a21a270fb25cef829722260acd52", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d4a169b5/uploads/origins/636ca758-ee5c-47c7-b59e-110548e937d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b08ddc756341176b8a7840f816daad96", "src_set": ""}, "body": "こんにちは！私はあなたのスタイルが大好きです。あなたのスタイルが大好きで、ぜひ依頼したいと思っています。\n私たちのファイナルファンタジーXIVのキャラクターを描いていただけると嬉しいです。一人はバニーガールで、もう一人はバットガールです。\n\n参考画像のように、お菓子やお茶を飲みながらくつろいでいるところを描いてほしいですね。\n\n参考資料\n\nSiadena - バニーガール。\nhttps://imgur.com/a/pIoM14l\n\nホドレツ - コウモリ娘。\nhttps://imgur.com/a/szV6Qnh\n\n参考画像。\nhttps://imgur.com/a/6huRTRK\n\n背景、表情、ポージング、衣装はお任せください。\n\nご検討、ご協力ありがとうございました。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@illust_clono/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 523500, "client_id": 398841, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/31449b82/uploads/origins/875ee6cd-39ad-4ac6-ac2f-c6ccd2f41983?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=16ec7fdab0ff462301b574693f877ad3", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/31449b82/uploads/origins/875ee6cd-39ad-4ac6-ac2f-c6ccd2f41983?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2857ce2504bb371ac554492ef36cabe0", "src_set": ""}, "body": "素晴らし過ぎる作品、いつもありがとうございます！\n冒険家エアリアと新米冒険者くんの行き先が少しだけ見てみたくなったので、よろしければ受理ご検討お願いします。\n\n●内容\nhttps://pbs.twimg.com/media/E28945xVoAMeFnp?format=jpg&name=large\n酒場での出会いからの続き。\n新米冒険者くんに声をかけ、パーティを組んだエアリアと少年の冒険シチュ。\n\n●人物\n1人は資料URLの冒険者エアリア。\n面倒見が良いお姉さんタイプらしく、前衛として素早い身のこなしと盾捌きで敵の攻撃を集めて受け流す役割を担う。\n剣の扱いも巧みで冒険者としての知識も豊富な頼れるお姉さん。\n\nもう1人は酒場で張り紙を見ていた新米冒険者な少年。\n戦闘スタイル、外見ともにお任せします。\nエアリアの導きで成長してゆき、将来は大きな事を成し遂げそう…！\n\n●詳細\n下記の３つのシチュから描いてみたいのを選んでチャレンジお願いします。\n\n・戦闘シーン（イメージは↓）\nhttps://pbs.twimg.com/media/EwjDK8cVEAAAyYp?format=jpg&name=large\n敵に囲まれたエアリアと少年が共闘するシチュ。\n敵はモンスターでも野盗でもOK。\n\n・買い物シーン\n武具屋にて少年の装備を整えてあげるエアリア、というシチュ。\n\n・探検シーン\n洞窟にて、松明を片手に歩く少年とエアリア。\nクエストを受けて洞窟を探検してるシチュ。\n\n●補足\nいずれも詳細はお任せ。\n描いてみたいシチュをご自由にお願いします。\n\nhttps://twitter.com/er114_k/status/1385941804361519112?s=21", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@illust_clono/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 523500, "client_id": 398841, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c98a8dba/uploads/origins/6e61cb46-a7e8-466e-9a78-a96323b7d317?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa75b9c9e8978905ef45ae50396f3063", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c98a8dba/uploads/origins/6e61cb46-a7e8-466e-9a78-a96323b7d317?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8cec33db34750ab90bbaef7b9c44e04", "src_set": ""}, "body": "前回の魔導士フレアの魔法屋さんお買い物イラスト、最高でした！\n何やら呟きで酒場にチャレンジしたいと仰ってたので、私から下記内容でリクエストさせて頂きます。\n\n●内容\nファンタジー世界。\n冒険者達の集まる酒場（冒険者ギルドが運営していてクエストも受けられる）と冒険者の女性。\n\n●人物\n資料URLの女性冒険者エアリア。\n冒険者としては中級以上の実力者で、面倒見がよく新米の指導や皆があまり手をつけないクエストにも積極的な頼れる優しいお姉さん剣士。\n\n●詳細\nエアリアが壁に貼り出されたクエストの紙を眺めていたり、座って食事をしていたり、とにかく『冒険者の酒場でのひととき』というテーマで自由にお願いします。\n\nhttps://twitter.com/er114_k/status/1385941804361519112?s=21", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@illust_clono/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/72e847d6/uploads/origins/9ce6987b-c156-4aa2-8601-2884024b5e93?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2f779a39e