ってたりとかしたらより過去改ざんされた感じが強く出るかなぁ、というのもふと想像いたしました……\nこの先どんどん妄想が高まってしまいそうなので説明は一旦ここまでに致します、もし気が向きましたらよろしくお願いします……!!", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@taro_tf/works/1", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a23a3a23/requests/64930_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b66405c00ae32da7c0aaa37447b4c1d9", "srcset": "https://si.imgix.net/a23a3a23/requests/64930_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b66405c00ae32da7c0aaa37447b4c1d9, https://si.imgix.net/a23a3a23/requests/64930_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=1d58cd0417e5c1d769576e62ef80ad67 2x, https://si.imgix.net/a23a3a23/requests/64930_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bbf2ec50356f77162723533cda8e1809 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 338067, "client_id": 60347, "nc": 35}], "sent_works": [], "similar_creators": [{"id": 50700, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "羊谷 日辻 (ひつじたに ひつじ)", "screen_name": "hitsuji_aries", "avatar_url": "https://pbs.twimg.com/profile_images/2057105429700964352/l1eyHbCC.png", "header_url": "https://pbs.twimg.com/profile_banners/864256820/1726686011/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "nove