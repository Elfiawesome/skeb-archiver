to=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8431265ae0981f743a6706765a07fd41, https://si.imgix.net/58453fb0/uploads/origins/b58c231d-0544-4161-a662-160b1f6b9133?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=cde2e058955d7448c10df1099a76baf1 2x, https://si.imgix.net/58453fb0/uploads/origins/b58c231d-0544-4161-a662-160b1f6b9133?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=20c181a3e195c9fc2108a8f907e47b7e 3x"}, "body": "あなたの作品が大好きで、僕と友だちの絵をリクエストしたいんだけど、円卓に座って一緒にコーヒーを飲んで笑っているところを描いてくれないかな。\n\nBloopはアングラーフィッシュのVtuberで、彼女の頭のルアーと尻尾を作品に入れてください。\n\nPristineは蝶のキツネのvtuberで、彼女の頭の横に蝶がいます。\n\nHynuunは金髪のコーヒーショップオーナーです。\n\n私のカフェの背景を入れたので、私たちがここにいるかのように描いてください。\n\nhttps://drive.google.com/drive/folders/1TMv9FMVmQkYGgkufUDM2eeegEOR4tv51?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@abcdyubo/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3519359, "client_id": 1825355, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cedc60a0/uploads/origins/99e7824a-36aa-4690-a386-2c305d954af3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00b6aa9db0df9981f19c8cb1dc43a635", "srcset": "https://si.imgix.net/cedc60a0/uploads/origins/99e7824a-36aa-4690-a386-2c305d954af3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00b6aa9db0df9981f19c8cb1dc43a635, https://si.imgix.net/cedc60a0/uploads/origins/99e7824a-36aa-4690-a386-2c305d954af3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7e8fef6c399a0e6cf7e4f8bfa99ba6c8 2x, https://si.imgix.net/cedc60a0/uploads/origins/99e7824a-36aa-4690-a386-2c305d954af3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=487971594f20b7faddc2a68750cb071f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cedc60a0/uploads/origins/99e7824a-36aa-4690-a386-2c305d954af3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40d52785539bd35bc10f4c666e214328", "srcset": "https://si.imgix.net/cedc60a0/uploads/origins/99e7824a-36aa-4690-a386-2c305d954af3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=40d52785539bd35bc10f4c666e214328, https://si.imgix.net/cedc60a0/uploads/origins/99e7824a-36aa-4690-a386-2c305d954af3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1de62c68441940d35c1d97fb4533c7bf 2x, https://si.imgix.net/cedc60a0/uploads/origins/99e7824a-36aa-4690-a386-2c305d954af3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fd886eca0f758b2fe2b287edf0790d6b 3x"}, "body": "𓂺様\n\n金額を間違えておりましたので再送失礼致します。\n\n先日はアピールありがとうございます！遅くなってしまいましたが、是非私のキャラクターを描いて頂きたいです。\n\n\n〖キャラクター詳細〗\n\nキャラクターや世界観のモチーフや引退競走馬と馬術競技です。\n\nキャラ①\n身長：168cm\nイメージカラー：黄色・青\n\n優しくてマイペースなふんわりとした性格。\n多くの名声と共にこの世を去った親の背中を追い続けてきたが、父と同じ景色を見ることなくレースを引退。\nその後は自分が自分らしくあれる場所を見つけ、仲間と新たな夢に向かって走り続けている。\nキャラ②に振り回されつつも楽しい日々を過ごしている。\n\n\n\nキャラ②\n身長：156cm\nイメージカラー：赤・ピンク\n\n好奇心旺盛でいつも元気なおてんば娘。お嬢様気質なところもある。\n3年間レースで走り続けた後に引退、キャラ①と共にある日を境に暮らし始めた。\n引退後もなお、憧れの父に追いつくという夢を叶えるために新たな舞台でも毎日ひたむきに努力している。\n\n\n＊頭頂部のボリュームがある所の内側部分のみ毛が白いです。 \n\n\n\n✤2人の衣装について\n今回は立ち絵の服装ではなく、『衣装デザイン画』と記載の資料を参考にイラストを制作していただきたいです。\n不明な点などは𓂺様の方で補完頂けますと幸いです。\n\n\nキャラクターシートもドライブに同梱しておりますので、こちらもご参考下さい。\n\n\n〖構図〗\n衣装の華やかさを活かして、詳細はお任せさせて頂きます。\n\n\nよろしくお願い致します！\n\nhttps://drive.google.com/drive/folders/102eUHjQl_w9j_S3yteK9FptjS4TBYsp3", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 1876328, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "よひこ", "screen_name": "yohikooooo", "avatar_url": "https://pbs.twimg.com/profile_images/1964880241308082177/FkBs8Fea