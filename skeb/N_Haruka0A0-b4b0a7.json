77-4e2f-a349-f98902434737?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5df7db8a3bba56bcd39f2d6effc26e65", "srcset": "https://si.imgix.net/1baeb96d/uploads/origins/2c26ba63-3077-4e2f-a349-f98902434737?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5df7db8a3bba56bcd39f2d6effc26e65, https://si.imgix.net/1baeb96d/uploads/origins/2c26ba63-3077-4e2f-a349-f98902434737?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=630ab51315aa9f804db81f6dbf754593 2x, https://si.imgix.net/1baeb96d/uploads/origins/2c26ba63-3077-4e2f-a349-f98902434737?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=3b07d9e1c37439234b0e19a641860a2e 3x"}, "body": "こんにちは。私は『My Happiness ≠ Her Happiness』のファンなのですが、お願いがあります！\n\n『My Happiness ≠ Her Happiness』とその続編に登場するヒロイン、ヤヒロとユキコをリクエストしたいと思います。\n\nシナリオは一人称視点で、仕事から帰宅し、ドアを開けると、ヤヒロとユキコが「お帰り、ダーリン！」という定番のセリフで、色気たっぷりに出迎えてくれるという設定です。 「夕食は？ それともお風呂？ それとも私？」\n\nという定番のセリフで、色っぽく出迎えてくれるという設定です。\n\nユキコには白いタオルを手に持ち、そのセクシーな体をかろうじて覆うように胸や体に押し当ててほしいです。\n\nヤヒロには「ヌードエプロン」を着用してほしいです。そのエプロンからは、胸がセクシーに覗き出ているような状態にしてください。\n\nこのシーンに台詞を追加する場合、すべてのテキストは日本語のままでも構いません。\n\n台詞について \nヤヒロとユキコ：「お帰りなさい、ダーリン！」\nヤヒロ：「夕食食べる？」\nユキコ：「お風呂に入る？」\nヤヒロとユキコ：「それとも私たち？」\n\n細かい部分はすべてお任せします！", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@N_Haruka0A0/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 102275, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/12109705/uploads/origins/19ee7284-d1f9-4898-ade8-40b376a1581e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=683bfdf2d342e9af9ce08d7e5e679dd3", "srcset": "https://si.imgix.net/12109705/uploads/origins/19ee7284-d1f9-4898-ade8-40b376a1581e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=683bfdf2d342e9af9ce08d7e5e679dd3, https://si.imgix.net/12109705/uploads/origins/19ee7284-d1f9-4898-ade8-40b376a1581e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=785400bfda238b04633b5d80f0f284cb 2x, https://si.imgix.net/12109705/uploads/origins/19ee7284-d1f9-4898-ade8-40b376a1581e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=21720ce3e52bf47b135314aa362481e9 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/12109705/uploads/origins/19ee7284-d1f9-4898-ade8-40b376a1581e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac38fab15759e0cc425a0779c5dac2b7", "srcset": "https://si.imgix.net/12109705/uploads/origins/19ee7284-d1f9-4898-ade8-40b376a1581e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ac38fab15759e0cc425a0779c5dac2b7, https://si.imgix.net/12109705/uploads/origins/19ee7284-d1f9-4898-ade8-40b376a1581e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e3c36a4d0667e5cad7452d8633dedc17 2x, https://si.imgix.net/12109705/uploads/origins/19ee7284-d1f9-4898-ade8-40b376a1581e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=140df2f957a7a8c752c9a566d67586e8 3x"}, "body": "うなぎ様\nリオのイラスト最高でした。\n更にリオシリーズとしてお願いしたいです。\n\n▪︎キャラクター\nSurvive4 リオ\n\n▪︎描いていただきたいイラスト\n勝手な妄想で恐縮ですが、陰湿なある男に雇われたエロガキ達がリオに悪戯するシチュでお願いしたいです。（自分でやるとツグヒトにボコボコにされるためエロガキ達に報酬で頼んだみたいなイメージです。男も物陰から見て撮影してます）\n\nリオはガキ達に手伝いを頼まれて快く付いて行った感じです。\nまた肉体労働だと思い、緑のジャケットは脱いだ状態でお願いしたいです。\n\n\n可能なら2コマ構成のイラストでお願いしたく・・・\n\n正面からの図（隠れて撮影している男目線）\n1コマ目\n・肩幅くらいに足を開き、立っているリオ。\n・後ろのエロガキの1人にスカートを捲られ、パンモロ（豪快にスカートを持たれて捲られている）\n・驚き固まり、恥ずかしい表情\n\n2コマ目\n・パンツを膝上くらいまで降ろされていて、股間露出。\n・更にエロガキ達により、前のエロガキには股間を弄られ、後ろのエロガキからはカンチョーを同時にされている。\n・思わず感じ、更に男の存在に気づいたリオの表情。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@N_Haruka0A0/works/4", "private_thumbnail_image