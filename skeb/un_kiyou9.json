32-0f99-408b-bb9a-c44c6811e9b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27921e61c588dd0f981ebfdc52c3399e", "srcset": "https://si.imgix.net/b23758fd/uploads/origins/df3bd032-0f99-408b-bb9a-c44c6811e9b4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=27921e61c588dd0f981ebfdc52c3399e, https://si.imgix.net/b23758fd/uploads/origins/df3bd032-0f99-408b-bb9a-c44c6811e9b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=215fd58560d88c411d4070a5fc7c36fa 2x, https://si.imgix.net/b23758fd/uploads/origins/df3bd032-0f99-408b-bb9a-c44c6811e9b4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f75a7dd96b7e350ed27ba8ff1433c59e 3x"}, "body": "こんにちは！あなたのイラストは本当に素晴らしく、すぐに目を奪われました！私のキャラクターを描いていただけませんか？彼の名前はリオ（\"Rio\"）で、私が創作した種族です。周囲の人の思考を感知できる能力を持つ熱帯の猫です。\n\nキャラクター：リオは誇り高く自信に満ちた狩人であり盗賊です。自分が最高中の最高だと自負し、その腕前を自慢し、自らに挑戦することを好みます。実際、彼の技術は素晴らしいものの完璧ではありません。普段は怠け者で気ままに振る舞いますが、良い挑戦が現れると非常にやる気になります。もしリオが苛立ちや屈辱を感じると、非常に苛烈な態度を取るため、単独行動を好みます。\n\nキャラクター参考: https://imgur.com/a/rio-NB51hZPリオが熱帯のビーチでくつろぐ情景を想像しました。ハンモックで休んでいるか、木にもたれかかっているかもしれません。砂は白く、植物は鮮やかな緑色です。リオは澄んだ水と青空を見つめ、そこに何が待ち受けているのか考えを巡らせています。 \n\n私が思い描いた環境のタイプです。建物や人工構造物の痕跡は一切描かないでください。ただしハンモックや小さな部族の小屋は構いません。全体的に熱帯の雰囲気を保ちつつ、背景の詳細な描写はご判断にお任せします：https://drive.google.com/drive/folders/1WoZa3f5kJVRZubiiak8en19p1s96zaNm?usp=sharing\n\n背景の描写が困難な場合、または指定枚数では不足する場合は、再送依頼いただくか、背景なしでリオのみを描いてください。その際は、彼の個性が伝わるポーズが望ましいです。ご配慮いただきありがとうございます。", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@un_kiyou9/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3865895, "client_id": 3635016, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/41b3054f/uploads/origins/1a008d6a-e8a5-4c24-b2a2-78e81c466a36?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3008097c3