g.com/media/HS-gcmrbQAAShM2?format=jpg&name=4096x4096\n\nフレアちゃんが158cmで、めらちゃんが149cmなので、それなりの身長差がある感じです\n\n■構図\n細部構図や背景、二人のポーズは先生にお任せします。膝上辺り、もしくは太もも辺りまで描いてくれると嬉しいです\nめらちゃんがデビューしたばかりなので、実際二人の絡みがまだありませんが、炎繋がりで二人の並びが見てみたいなと思います、今回依頼させていただきました\n\n依頼内容は以上です、かなり雑なリクエストですみません\nご検討のほどよろしくお願いします", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@pon47606461/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3994552, "client_id": 3465736, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cbc98f28/uploads/origins/48000d03-89a5-4198-a4fe-51c2f19c4a84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f9681dca243fc3e3e3a2afab6cadc21", "srcset": "https://si.imgix.net/cbc98f28/uploads/origins/48000d03-89a5-4198-a4fe-51c2f19c4a84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7f9681dca243fc3e3e3a2afab6cadc21, https://si.imgix.net/cbc98f28/uploads/origins/48000d03-89a5-4198-a4fe-51c2f19c4a84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5f7bfee6f4ab9fb266d8a18a901be177 2x, https://si.imgix.net/cbc98f28/uploads/origins/48000d03-89a5-4198-a4fe-51c2f19c4a84?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1ca7bcca4903b017523a6bc541ead7fe 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cbc98f28/uploads/origins/48000d03-89a5-4198-a4fe-51c2f19c4a84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90934fce3b0c9c99d83d3dd59e037012", "srcset": "https://si.imgix.net/cbc98f28/uploads/origins/48000d03-89a5-4198-a4fe-51c2f19c4a84?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90934fce3b0c9c99d83d3dd59e037012, https://si.imgix.net/cbc98f28/uploads/origins/48000d03-89a5-4198-a4fe-51c2f19c4a84?bg=%23fff&auto=format%2