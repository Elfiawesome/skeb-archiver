fe235/uploads/origins/ccbd257f-368d-454a-b4da-867fbda6798e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1821d0eda6f26854808be3732303568d, https://si.imgix.net/b4bfe235/uploads/origins/ccbd257f-368d-454a-b4da-867fbda6798e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=46a667803f22706568757ea2b9ac344e 2x, https://si.imgix.net/b4bfe235/uploads/origins/ccbd257f-368d-454a-b4da-867fbda6798e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8c160192076d4bb07872ce204fa25639 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b4bfe235/uploads/origins/ccbd257f-368d-454a-b4da-867fbda6798e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87a44466f9b7bde7f4525ff4e716cc80", "srcset": "https://si.imgix.net/b4bfe235/uploads/origins/ccbd257f-368d-454a-b4da-867fbda6798e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=87a44466f9b7bde7f4525ff4e716cc80, https://si.imgix.net/b4bfe235/uploads/origins/ccbd257f-368d-454a-b4da-867fbda6798e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5ff8a53e5bc731a34a50b688b3a4bbcd 2x, https://si.imgix.net/b4bfe235/uploads/origins/ccbd257f-368d-454a-b4da-867fbda6798e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=fadd1254c1822a29942ea803ee875289 3x"}, "body": "足が40本ある多脚ケモノタウルを見てみたい！(昆虫じゃないけど）\n\n解剖学的には、2本の腕、2本の前脚、38本の後脚があり、それぞれの脚の間にフルサイズの胴体があるようなキャラクターにしたい。詳しくは以下のドキュメントをご覧ください。\n\nhttps://cdn.discordapp.com/attachments/749476684662833255/1104320790406627458/Taurtrain_anatomy_reference.doc\n\nさらに、上半身の胴体の比率は、下半身の胴体に比べて極端に小さくしてほしい。説明のメモが以下にあります。\n\nhttps://cdn.discordapp.com/attachments/749476684662833255/1188133816800395314/Taurtrain_anatomy_note_-_Extreme_Proportion.docx\n\n以下の点に重点を置く：\n- 適切な解剖学（例えば、前脚と後脚の違いなど）\n- 全身と脚のほとんど（できればすべて）を見せること。\n- 蹄など他の脚よりも肉球や爪が好ましい。\n\n上記すべてを満たした上で、以下のどれでもかまわない：\n- クリーチャー\n- デザイン\n- ポーズ", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ketaru923/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 32144, "client_id": 794875, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1a391d21/uploads/origins/7421a680-7718-4ff9-b37d-f404c918e57c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b1da238950cc8e5b98a243b7c5eacb8", "srcset": "https://si.imgix.net/1a391d21/uploads/origins/7421a680-7718-4ff9-b37d-f404c918e57c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=3b1da238950cc8e5b98a243b7c5eacb8, https://si.imgix.net/1a391d21/uploads/origins/7421a680-7718-4ff9-b37d-f404c918e57c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1583723c7a5ea94941760daeb48395c4 2x, https://si.imgix.net/1a391d21/uploads/origins/7421a680-7718-4ff9-b37d-f404c918e57c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f70f3287793a3736716688df014863e4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1a391d21/uploads/origins/7421a680-7718-4ff9-b37d-f404c918e57c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d31b6b8906bf4ef1b1ddd0ebd6517a67", "srcset": "https://si.imgix.net/1a391d21/uploads/origins/7421a680-7718-4ff9-b37d-f404c918e57c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d31b6b8906bf4ef1b1ddd0ebd6517a67, https://si.imgix.net/1a391d21/uploads/origins/7421a680-7718-4ff9-b37d-f404c918e57c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=95d601032220e547848b770147bee9a6 2x, https://si.imgix.net/1a391d21/uploads/origins/7421a680-7718-4ff9-b37d-f404c918e57c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=