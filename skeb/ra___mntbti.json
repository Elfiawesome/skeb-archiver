=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f72c0b00cef75de80d6b3ecc0cc82df4", "src_set": ""}, "body": "らーめんたべたい先生、こんにちは。\n以前くるさんのイラストを描いていただき、本当にありがとうございました！\n\n今回は、自分用のキャラクターイラストをお願いしたくリクエストさせていただきました。\nずっと前に簡単なイメージをアプリで作成し、それをアイコンに使っていたのですが、ぜひ先生の素敵な絵柄で正式なイラストとして描いていただきたいと思いました。\n\n【キャラクター資料】\n参考画像：https://drive.google.com/drive/folders/1ST60BintvfVwFD7E2F3oUJf1W7NU9SFr\n\n髪型や色味は参考画像をベースにしつつ、全体的なポーズ、雰囲気やデザインは先生に自由にアレンジしていただけると嬉しいです！！\n\n【用途】\nTwitterのアイコンなどの個人使用\n\n構図や表情、服装などすべておまかせいたします。\nらーめんたべたい先生にお願いできることをとても楽しみにしております。どうぞよろしくお願いいたします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ra___mntbti/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3514008, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d423813c/uploads/origins/985a1111-7c5c-4638-a47d-1bda42da3a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e40f24f2ed014ccfde9db2ca83915375", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d423813c/uploads/origins/985a1111-7c5c-4638-a47d-1bda42da3a6f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=13ce3a8f57dbac90be734ec66d54d863", "src_set": ""}, "body": "老师您好，很喜欢您的画风，想邀请您为我的OC绘制作品！\n如果可以希望是半身类型！https://drive.google.com/drive/folders/1xkSUV1tcYlnN9aOp_bWCfTTSWDm7tugK", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ra___mntbti/works/25", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3514008, "client_id": 3293535, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9c7fb5c3/uploads/origins/1596ae23-f386-44d9-a3ee-813d115f6a69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b3a9e886047711da8c1060153e19d3ca", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9c7fb5c3/uploads/origins/1596ae23-f386-44d9-a3ee-813d115f6a69?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8ae4da8ad50bcd8d17333f2e6560f3b9", "src_set": ""}, "body": "はじめまして\n\nXにてきらきらとしたかわいいイラストを見かけて一目惚れし、リクエストいたしました。\n\n▼内容\n・Vtuberの「ライファ」さんのイラスト\n・ポーズや背景、構図はお任せします\n・髪型は下記の参考URL内にある「02_髪型資料.jpg」の「片目隠れ」と「二つ結び」の組み合わせだと嬉しいです\n・装飾や服装等自由にアレンジいただいて問題ないです\n\n▼参考\n・猫形のヘアピンとチョーカーがあります\n・年齢は17歳ですが見た目は14歳くらいです（童顔）\n・前髪にはうっすら黄色メッシュがあります\n・魚のぬいぐるみは人物と瞬きが逆です\n（ライファさんの目が開いているとき、魚の目は閉じている）\n・植物が好きで恥ずかしがり屋で控えめな性格です\n\n▼使用用途\nX等のSNS、収益化済みのYoutubeのサムネイル等での使用、\nFANBOXでの公開（ネットプリント、壁紙配布等）に使用される可能性があるので\nキャラクターと背景を透過ファイルで分けていただけると大変ありがたいです。\n\nお忙しいところ大変恐縮ですが、よろしければご検討何卒よろしくお願いいたします…！\n\nhttps://drive.google.com/drive/folders/1HpiQH1BabzjHNCLBFaAvoE_03WVRQCp8?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ra___mntbti/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3514008, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/87f3a081/uploads/origins/6727c501-2c16-439d-80e6-8abca17c6217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00a448f08569af7d431841745529ec2d", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/87f3a081/uploads/origins/6727c501-2c16-439d-80e6-8abca17c6217?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=066d249185fe5d234a36a0fd4ae184a3", "src_set": ""}, "body": "はじめまして。\nいつもXで素敵なえむちゃんのイラストを拝見し、とても楽しく見ています。\n\nこのたび、個人JP/EN Vtuber「marichanduh」さんのイラストをお願いしたく、ご連絡しました。\nhttps://x.com/marichanduh\n\n【キャラ詳細】\n参考資料はこちらをご参照ください：\nhttps://drive.google.com/drive/folders/17VVNCa4e8MDCtpuqA2fI9qzQ9VgRXZmL?usp=sharing\n\n元気で楽しそうに描いてもらえるのならば、構図等はお任せしたいです。\n\nイラストの使用用途については、ご本人がSNSでの投稿や配信などで使えればと思います。\n可能でしたら背景透過データもいただけるとうれしいです。\nご検討よろしくお願いいたします。\n\nhttps://drive.google.com/drive/folders/17VVNCa4e8MDCtpuqA2fI9qzQ9VgRXZmL?usp=sharing", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ra___mntbti/works/23", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3514008, "client_id": 3295592, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d3b51f16/uploads/origins/c7849e52-5471-41b7-be07-00f580c529fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8b5a76f46869441c6ce482db98417468", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d3b51f16/uploads/origins/c7849e52-5471-41b7-be07-00f580c529fd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=85151e8a128ce49a3c9ce8717c2ad91f", "src_set": ""}, "body": "こんにちは、はじめまして。\n先生のご作品を以前より拝見しており、いつも心惹かれております。\nこのたび、ご縁がありましたら、ぜひイラストをお願いしたくリクエストを送らせていただきました。\n\n構図やポーズ、背景などの詳細は、すべて先生のご判断にお任せいたします。\n作品は個人での鑑賞およびSNSでの使用を目的としており、商用利用は一切いたしません。\n\nご多忙のところ恐縮ではございますが、\nご検討いただけましたら幸いです。何卒よろしくお願い申し上げます🙇‍♀️\n\nhttps://drive.google.com/drive/folders/1Ezb2BumEF57cUSDAYn1PgxK-lb3rfMWa?usp=drive_link", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ra___mntbti/works/22", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3514008, "client_id": 388437, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/91251f42/uploads/origins/a2abaa98-5497-478f-8df9-4e1baa393f98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=48c759639b41cd5b73dba9d5e3827e0a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_t