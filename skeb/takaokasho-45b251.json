は閃の軌跡のレンとミリアムの素敵なイラストを描いていただきましてありがとうございました。\n\n大変恐縮なのですが再度リクエストを送らせていただきます。\n\nリクエストの内容なのですが、黎の軌跡と言う作品に登場する成長したレンが、正面に向かってキスをせがんでいるイラストをリクエストさせていただきます。\n\n前回の表情が凄く可愛かったので、今回も両目を閉じた状態で唇を少し突き出すように描いていただいて、唇にツヤを出していただけると嬉しいです。\n\n大変恐縮なのですが、お礼の言葉などは入れていただかなくて結構です💦\n\nhttps://www.falcom.co.jp/kuro/character/renne.html", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@takaokasho/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1367985, "client_id": 437897, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/57172505/uploads/origins/b88783f9-a6b4-48a4-8d67-f74de6390cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7523213b619389f5dca4a3e1c1c8764f", "srcset": "https://si.imgix.net/57172505/uploads/origins/b88783f9-a6b4-48a4-8d67-f74de6390cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7523213b619389f5dca4a3e1c1c8764f, https://si.imgix.net/57172505/uploads/origins/b88783f9-a6b4-48a4-8d67-f74de6390cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0770145888eabba5715ca145cabcaae 2x, https://si.imgix.net/57172505/uploads/origins/b88783f9-a6b4-48a4-8d67-f74de6390cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=fff9fc3b421ece128d58311d864292e4 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/57172505/uploads/origins/b88783f9-a6b4-48a4-8d67-f74de6390cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=534bad7b63b0b7d1f624e2f209913687", "srcset": "https://si.imgix.net/57172505/uploads/origins/b88783f9-a6b4-48a4-8d67-f74de6390cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=534bad7b63b0b7d1f624e2f209913687, https://si.imgix.net/57172505/uploads/origins/b88783f9-a6b4-48a4-8d67-f74de6390cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d4e107bbc9f030368d2a16cf6b0bbae4 2x, https://si.imgix.net/57172505/uploads/origins/b88783f9-a6b4-48a4-8d67-f74de6390cc1?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=a649b70016fdd03b95365797ba11ee35 3x"}, "body": "初めまして、イラストの可愛さと、スペちゃんがキスをせがんでいるイラストに惹かれてリクエストを送らせていただきました。\n\nリクエストの内容なのですが、閃の軌跡と言う作品に登場するレンと言うキャラクターとミリアムと言うキャラクターが、正面に向かってキスをせがんでいるイラストをリクエストさせていただきます。\n\n目は両目とも閉じて唇を少し突き出すように描いていただいて、唇にツヤを出していただけると嬉しいです。\n\n下記がミリアムの資料URLで、ミリアムは左の水色の髪のキャラクターになります。\n\nhttps://www.curtain-damashii.com/item/towelket_hajimari01/\n\nhttps://www.falcom.co.jp/sen4/character/renne.html", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@takaokasho/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1367985, "client_id": 307340, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e0cced83/uploads/origins/d2539e9d-6f8b-43c0-b4dd-fddb03656745?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e73cd446c29b9634dcfb299a2da4a20e", "srcset": "https://si.imgix.net/e0cced83/uploads/origins/d2539e9d-6f8b-43c0-b4dd-fddb03656745?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e73cd446c29b9634dcfb299a2da4a20e, https://si.imgix.net/e0cced83/uploads/origins/d2539e9d-6f8b-43c0-b4dd-fddb03656745?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0f105a672cdb6b9bc5336d677d4be827 2x, https://si.imgix.net/e0cced83/uploads/origins/d2539e9d-6f8b-43c0-b4dd-fddb03656745?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=614aad4dee1e6b7a3f4f4fbf6f5aef0b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e0cced83/uploads/origins/d2539e9d-6f8b-43c0-b4dd-fddb03656745?bg=%23