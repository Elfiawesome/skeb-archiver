txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b18561d51e00d90b6f7e0f5a48f7a697", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 2530346, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@z_xuu2/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2530346, "client_id": 976914, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e95d76d6/uploads/origins/36c149bf-2841-455e-8b6a-68a398e775c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1383e0efba5982b095399435292df9eb", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e95d76d6/uploads/origins/36c149bf-2841-455e-8b6a-68a398e775c5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=14e64f0359659880560724a84382aadd", "src_set": ""}, "body": "ご依頼をさせていただきます。\n内容は、けものフレンズからムチムチなジャガーさんのパンケーキピッツァをお願いいたします。\n以前描かれておりましたパンケーキピッツァができるまでの工程がとても素敵でしたのでこちらのジャガーさんバージョンをお願いいたします。\n服装は、フレンズの服でお願いします。\n可能でしたら色を付けていただきたいです。\nご検討のほどよろしくお願いいたします。\n\nhttps://x.com/z_xuu2/status/1897891586966798739?t=cMvJEE2vOPUOs0wOf3-lkA&s=19", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@z_xuu2/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2530346, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/96aff967/uploads/origins/ed35899a-88fb-43d3-b4b3-789753f3ba32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=83e13c67d18eb2fcac9ee53efcc47e44", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/96aff967/uploads/origins/ed35899a-88fb-43d3-b4b3-789753f3ba32?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=affa274484190d2268df8ebf942515f7", "src_set": ""}, "body": "お世話になります。以前TSタマちゃんのリクエストをしたものです。\n前回の作品が大変良かったので、後日談エピソードをお願いします！\n\n■登場人物\n・TSタマちゃん＆同僚\n前回と同一人物。定期的にセックスする仲になってる。\n\n・ピーチパンサー\nご都合主義の導入担当。えっちなおもちゃも扱ってるショップ店員。\n\n■流れ\n前回から数週間～数か月後くらいの時期。\n\n同僚が遠方部署への出張でしばらく不在にしており、発散できないムラムラを押し殺しながら業務をしているTSタマちゃん。突如現れたピチパンに欲求不満を見抜かれ、新商品の試供品という名目でバイブを強引に渡される。\n\n仕事を終え自室に帰った後、処分に困って持って帰って来たバイブを開封。黒光りするカリ高で反り返った凶悪な巨根のシルエットに思わず子宮がキュンとする。\n\nギリギリ残っている元男としての矜持で「自分でメスの部分弄って発散するのは流石に...」と逡巡して処分を考えるが、凶悪な形状のバイブからどうしても意識が離せず、「一回水着の上から当ててみるだけ...」と言い訳してオナニー開始。\n\nちょろいのでメスの本能に抗えず、「スイッチを入れてみるだけ...」→「先っちょだけ...」→「根元まで...」と、あれよあれよという間に堕ちていき、最終的に乳をまろび出して乳首イジりながら、一番気持ちいい膣奥をトントン刺激してメスの快感を貪る本気オナニーへ突入。\n(このへんの自分に言い訳しながらズルズルとセルフメス堕ちする描写を重点的にお願いします！！！)\n\n深イキ間近で背後の扉が開いて、出張帰りの同僚が入ってくる。（男同士の頃から距離感が変わらないのでノックもしない）絶叫するタマちゃん。\n\n反射的に水着を直して振り返り、平静を装って誤魔化そうとするが、\n・紅潮して息が上がって目は泳いでる。\n・太ももに愛液が垂れてる。\n・バイブは入りっぱなしで、水着のクロッチ部分にクッキリとバイブの形が浮いてるし、振動音が響いてる。\n・一瞬で納めきれなかった片乳が出しっぱなし。\nと、バレバレの隠しきれてなさ。一瞬でオナバレ。\n\n「このあとメチャクチャセックスした」的なヒキで〆。\n\n\n長くなりましたが、構成的に入れるのが難しいシーンや情報、文章で分かりづらい部分などはそちらの判断で省いたり、適宜編集してもらって大丈夫です。\nご検討の程よろしくお願いします！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@z_xuu2/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2530346, "client_id": 19206, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/26bf66d8/uploads/origins/2171dde4-f905-4560-9ecc-664de8a18f6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=90123b7d885c65f84b960e71b659d42a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/26bf66d8/uploads/origins/2171dde4-f905-4560-9ecc-664de8a18f6c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b748ed59c477a07527c927444bab3ffd", "src_set": ""}, "body": "前回は部族トラさん達の漫画をありがとうございました。堪能いたしました。\n\n　今回は交尾をせがみ、ヒトオスにアピールする部族トラさんのカラーイラストをお願いいたします。\n　二人の姿は前回と同様に褐色肌に陰毛、アームカバーとソックス、そして紋様をお願いいたします（腰蓑はお任せいたします）\n　ポーズ、構図、紋様のデザインなどはお任せいたします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@z_xuu2/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "comic", "tipped": true, "creator_id": 2530346, "client_id": 19206, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/da0f8d46/uploads/origins/af5cb9fe-682e-4210-919b-9625bbb4b55d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d74a4dc103efe4cbd465f7b71ab4bbb3", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/da0f8d46/uploads/origins/af5cb9fe-682e-4210-919b-9625bbb4b55d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cda95ada7571a904431b30be00eb39e1", "src_set": ""}, "body": "いつもエモかったりエロかったりするイラストと漫画を楽しませてもらっております。\n　今回無人島漂着部族化トラアニマルガールの漫画を依頼します。\n\n・登場人物、無人島での格好\nベンガルトラ、アムールトラ\n腰蓑、腰蓑と同じ作りの胸隠し（途中から無し）、アームカバーとソックス、褐色、紋様、陰毛。\n\nヒトオス（パークスタッフ）\n腰蓑のみ、褐色、紋様、陰毛（なくても大丈夫です）。\n\n・流れ\n　セルリアン（ボスクラス）の襲撃により乗船していたフェリーが沈没、避難誘導やセルリアンと戦闘をしていた3人のみ逃げ遅れ、気がつくと無人島の砂浜に漂着。\n　都合よく温暖な気候で食料や水が豊富にあるため「救助はゆっくり待とう」となるもののいつまで経っても救助は来ず。（ここまでは概要が分かる程度の表現で大丈夫です）\n↓\n　時が経ち着ていた服がボロボロになったため草で腰蓑と胸隠しを作りそれで生活することになる３人、日焼けで褐色肌になり、島内で見つけた白い顔料を使いノリで身体に紋様をつけ始める。\n↓\n　ほぼ全裸のような格好に我慢できるわけもなく隠れてオナニーしていたヒトオスをトラの2人が（性的に）襲う。\n↓\n　その日からトラの2人も腰蓑のみになり、3人は昼夜場所問わずヤりたい時にヤり、口でもアナルでも使いたい所を使う爛れた生活が始まった。\n↓\n　そしてトラの2人（できればボテ腹でお願いします）はヒトオスの上で騎乗位と顔騎で性を貪り「この生活がずっと続いてほしい」と願うのであった。\n\n　以上が流れになりますが細部（体位やポーズなど）についてはお任せいたします。また\n　紋様についてはシンプルな丸や線などの組み合わせで大丈夫です。\n　また「褐色肌」とは書きましたが褐色であることが分かればカラーでなくとも大丈夫です。\n\n　ニッチなシチュになり恐縮ですがどうぞご検討のほどよろしくお願いします。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@z_xuu2/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2530346, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a15f7b2b/uploads/origins/56a0cd62-fcc1-4811-8e1a-0fdf969d6d34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e4139f927c4ab548486bef70aef92e9b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a15f7b2b/uploads/origins/56a0cd62-fcc1-4811-8e1a-0fdf969d6d34?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b6980da34ece932a160ffc295026cc57", "src_set": ""}, "body": "お世話になっています。\nモブショタがデカいKもVのお姉さんの裸体で精通するおねショタ漫画をお願いします。\n\n■登場人物\n〇少年\n大人しい性格のモブメカクレショタ。低学年～中学年くらい。KもVパスタさんの親戚かなんか。性知識は乏しい。\n\n〇KもVからsmhi🦊・usk🦇・grr🐱の三人\n珍しいゲストにテンションが上がり、少年をチヤホヤとかわいがりたがる三人。\n下記イラストくらいを目安に、三人とも高身長でガタイもデカい大人の女体をイメージして描いて頂きたいです。\n参考：\nhttps://twitter.com/z_xuu2/status/1642417953701531649/photo/1\nhttps://twitter.com/z_xuu2/status/1646413215742705667/photo/1\n陰毛が画面に映るタイミングがあれば、\nsmhi：整えてる。薄め。\ngrr：整えているが濃いめ。\nusk：剃り跡有りのパイパン。\nの想定でお願いします。\n\n■流れ\n夏休みかなんかにゲストとしてパークに遊びに来て、多忙なパスタさんの代わりにKもVのフレンズに面倒を見てもらってる少年。一日中遊んで、宿泊施設の大浴場(オープン前なので貸し切り)で一緒にお風呂に入る事に。\n（この辺の導入はざっくりシチュさえ掴めれば、ごく短めに省いてもらっても大丈夫です。）\n↓\n少年をまだ性的な事に興味が無い年頃だと思っているので、裸体を隠そうともせず遠慮なくスキンシップしてくる三人。目の前で無防備に晒される成熟した乳房や女性器に、少年は無自覚ながら性的興奮を感じて戸惑う。\n↓\n様子のおかしい少年をのぼせたと勘違いしたsmhi。一緒にお風呂からあがろうとするが、二人で足を滑らせ、仰向けに転んだ少年に顔面騎乗する体勢で転倒。\n↓\n突然顔面に押し付けられた女性器の感触に、勢いよくノーハンド暴発射精。三人に見られながらの精通。\n↓\nエピローグ。少し気まずい空気の風呂あがり後。申し訳なさそうにする少年を、照れながらも優しく気遣ってフォローする三人の描写で〆。\n\nざっくり流れを汲んでいただければ、設定や心情などは作中で詳しく説明せずともOKです。どちらかと言えば細かい説明描写より画面の女体密度優先で。\n細部は描きやすいように変更・削減などして頂いても大丈夫です。\nご検討よろしくお願いします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@z_xuu2/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2530346, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4d446ca1/uploads/origins/03a99a27-b35b-4f46-a21e-ecce51275cf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bacde6f191580f261ab7a7bccf136f6a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4d446ca1/uploads/origins/03a99a27-b35b-4f46-a21e-ecce51275cf9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bca8651bb73f5c699e49439db74429b0", "src_set": ""}, "body": "お世話になります。甲子園さんの描くTSネタが好きです。\n元ヒトオスパークスタッフのTSアゴヒゲアザラシが、強引なセックスを通じてメスである事を分からせられるエロ漫画を描いて頂けないでしょうか。\n\n■登場人物\n・TSアゴヒゲアザラシ(以下TSタマちゃん)\nサンドスターの事故かなんかで不本意にアニマルガール化した元ヒトオスパークスタッフ。元に戻る方法の研究待ちでアニマルガール姿のままスタッフ勤務。豊満なメスの身体。パイパン。性自認は男。\n\n・同僚モブヒトオス(以下同僚)\nTSタマちゃんのヒトオス時代からの同僚。童貞。\n\n※人物像としてざっくり捉えて頂ければ、必ずしも作中で上記の情報を説明する必要はありません。\n\n■流れ\n同僚からオカズになって欲しいと必死に頼まれるTSタマちゃん。童貞根性っぷりに爆笑しながら承諾。同僚を小バカにしながらも水着を脱いでおっぱい揉ませたり、まんこ見せつけたり、指を挿入れさせたりと、男同士ふざけあうようなノリで色々とサービスする。\nしかし理性が保たなくなった同僚から強引に押し倒されて膣に挿入される。慌ててやめさせようとするが、アニマルガールの膂力でもなぜか上手く抵抗できない。\n犯される最中、心の中で本能的に「女としてオスに無理やり抱かれる喜び」を感じている事を自認。(元)オスの意地で必死に否定しようとするが本能的な悦びには勝てず「身体だけでなく内面までメスに変わってしまっている事」を否応無しに理解させられ悔しがる。\nラストはシリアスになりすぎないよう、正気に戻った二人の事後の痴話喧嘩コマで〆。\n\n細部の表現などは描きやすいように変えてもらって大丈夫です。\n尺や金額的に厳しければキャンセル頂いて問題ありません。どうぞよろしくお願いします。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@z_xuu2/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2530346, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9e5a1aa5/uploads/origins/8c496be1-6cae-4f2c-931a-2d31c615e1ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8644aa718b087edc4edfa2a41b93008f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9e5a1aa5/uploads/origins/8c496be1-6cae-4f2c-931a-2d31c615e1ec?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=22f694d86c482c4c721781dc92d03fdf", "src_set": ""}, "body": "こんにちは。以前お題箱にも投げさせていただいたリクエストなのですが、Twitterで描かれてた下記のイラストが大変性癖に刺さったので、こんな感じの腐れ縁な距離感のsmrsを描いて頂きたいです。\nhttps://x.com/z_xuu2/status/1615701661196120066?s=20\n\n・詳細\nセックス直前の土壇場になって日和り出すシチュ。\n既に全裸で寝かされ、正常位の体勢でまんこに亀頭が触れてる状態のsmrs。あとはもう挿れるだけの土壇場も土壇場になって「...やっぱ挿れるのまた今度にしない？」みたいな事を言いだす。「成り行きでなし崩し的にエッチとか良くないしさー」みたいな適当な言い訳をひとしきりして、最後にはバツが悪そうに「実はエッチとかするの初めてで...ちょっと怖いし...」とビビってる事をカミングアウトする。\n\n形式としては甲子園さんの描きやすい形式で自由に描いて頂けたらと思います。(一枚絵・漫画など)\nセリフなどはざっくりニュアンスを捉えて頂ければ自由に改変して頂いて問題ありません。\n指定のない部分や文章で分かりずらい部分はすべてお任せします。\nご検討よろしくお願いします。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 3738, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ダンナ　Skebやっています", "screen_name": "karatekikku", "avatar_url": "https://pbs.twimg.com/profile_images/1927355721521262592/BOsppe7v.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1615921440766955520/1748319769/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 161}, {"id": 109670, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ねぉんあいす。", "screen_name": "Neon_Ice", "avatar_url": "https://pbs.twimg.com/profile_images/1874144470209617925/18ALxje4.jpg", "header_url": "https://pbs.twimg.com/profile_banners/2315862942/1735665741/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "correction"}], "nc": 177}, {"id": 292475, "creato