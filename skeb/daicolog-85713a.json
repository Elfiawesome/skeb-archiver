x.net/52faa401/uploads/origins/67734ada-439e-4742-9d58-8c74349cb3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ee3b4bb6f5b1379a4f8c638a52a4a80", "srcset": "https://si.imgix.net/52faa401/uploads/origins/67734ada-439e-4742-9d58-8c74349cb3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5ee3b4bb6f5b1379a4f8c638a52a4a80, https://si.imgix.net/52faa401/uploads/origins/67734ada-439e-4742-9d58-8c74349cb3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=397cc056654f2432228cf6fa24c3c9f3 2x, https://si.imgix.net/52faa401/uploads/origins/67734ada-439e-4742-9d58-8c74349cb3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a5af831d2d2f84174caebe9617e5ec44 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/52faa401/uploads/origins/67734ada-439e-4742-9d58-8c74349cb3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f39e4bb5965ce6115da80c5d6eeec54", "srcset": "https://si.imgix.net/52faa401/uploads/origins/67734ada-439e-4742-9d58-8c74349cb3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f39e4bb5965ce6115da80c5d6eeec54, https://si.imgix.net/52faa401/uploads/origins/67734ada-439e-4742-9d58-8c74349cb3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=313fbe81d24a6a1a2132431c112b80b9 2x, https://si.imgix.net/52faa401/uploads/origins/67734ada-439e-4742-9d58-8c74349cb3f7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2d4bc964e5b9add62129db3c4da3c9d0 3x"}, "body": "さんでー様、初めまして。\nうちの子「すずしろ」と「だいこん」（ミニキャラでもOK）を描いていただけませんか？\n私のゲーム配信チャンネルの看板娘たちです。\n\n露出が多い衣装ですが、清らかに活動していますので、健康的に健全なイメージでお願いします。ポーズ・衣装のアレンジ等はすべてお任せします（もし構図に迷ったら、二人がゲームを遊んでいる様子を描いていただけると嬉しいです）。\n\n■資料\nhttps://drive.google.com/file/d/1TI2xw0yXdOXNT-ZRf0TMIDF3J0B0vCi3/view?usp=sharing\n\n■使用用途（こ