n\nペニス、睾丸、乳房が見える限り、彼女の鎧の他の部分を描きたい場合は、あなたの裁量で残すことができる。\n\n以下の2つのシナリオのいずれかで彼女を描いてください。\n\n最初の選択肢は、ほとんど裸で玉座の上でくつろいでいる彼女を描くことです。\n\nあるいは、敗北して捕らえられた女性冒険者の視点から、支配的な姿勢で鑑賞者の上に立っている彼女を描くこともできます。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1-DjUdjkVq1AD4vkfyIPG3tQf8ruQBQ_a?usp=sharing", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@futidori65489/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3117814, "client_id": 927476, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2090677d/uploads/origins/42b76776-f842-4a93-8c07-5caed359c90c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4880c461a6c235289c1242d255dec05c", "srcset": "https://si.imgix.net/2090677d/uploads/origins/42b76776-f842-4a93-8c07-5caed359c90c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4880c461a6c235289c1242d255dec05c, https://si.imgix.net/2090677d/uploads/origins/42b76776-f842-4a93-8c07-5caed359c90c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4469c338a58289c423ef31ee1eee3109 2x, https://si.imgix.net/2090677d/uploads/origins/42b76776-f842-4a93-8c07-5caed359c90c?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f3038b777609ab9e80a858770633d540 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2090677d/uploads/origins/42b76776-f842-4a93-8c07-5caed359c90c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65d571bb25281ccc9dcf570d5d470647", "srcset": "https://si.imgix.net/2090677d/uploads/origins/42b76776-f842-4a93-8c07-5caed359c90c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=65d571bb25281ccc9dcf570d5d470647, https://si.imgix.net/2090677d/uploads/origins/42b76776-f842-4a93-8c07-5caed359c90c?bg=%23fff&auto=form