ふわした銀白色の髪\n・羊の耳と角がある（人間の耳がない）\n・中性的な見た目で、やや女性的な印象\n・首元の赤いリボンがトレードマーク（リボンは他の位置〔ヘアタイ、アームバンドなど〕でも可）\n\n参考資料には別衣装や別テーマの案もございますので、そちらをご使用いただくか、先生のお好きなように新しくデザインしていただけますと嬉しいです。\n\n衣装や髪型（エクステの追加・長さ変更など）については、作家様のお好みに合わせて自由に変更・簡略化していただいて大丈夫です。全体の構図や演出もお任せいたします。\n\n内容不備や金額が不足している場合は、アピールをお送りください。デザインメモ、没ラフや下描きなどがあればPSDに残したままにしていただけると嬉しいです。\n\n長いお願いをお読みいただき、またご検討いただきありがとうございます！\n\nhttps://drive.google.com/drive/folders/1_7wTl6FJONAFtQdBVHH4NZrUZuTNs3xx?usp=sharing", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "sent_works": [], "similar_creators": [{"id": 2481921, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "chiko.", "screen_name": "10chiko05", "avatar_url": "https://pbs.twimg.com/profile_images/1581347468628721665/LODNRv6J.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1581342429361291265/1758305402/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 45, "skills": [{"genre": "art"}], "banned": false, "nc": 9}, {"id": 2613797, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "もちおはぎ(倖)", "screen_name": "mochihagi_gnsn", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fwebpublic-76e09d7e-f160-4cca-8f0c-63559860f6ba.webp&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/webpublic-8b42a402-a7d8-47f9-9fdf-d374421c6919.webp", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 20, "complete_expiration_days": 60, "skills": [{"genre": "art"}, {"genre": "comic"}], "banned": false, "nc": 33}, {"id": 3105623, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "色葉ꕤ︎︎"