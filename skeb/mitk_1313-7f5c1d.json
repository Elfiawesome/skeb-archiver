キギリと申します。\n素敵なイラストを拝見し、是非とも描いて頂きたくなりました。\nもし宜しければ、うちの子の不散紅葉と、友人の子の陽媛さんのイラストをお願いします。\n陽媛さんとの許可は取ってあります。\n\n〇シチュエーション\n紅葉と陽媛の2人が顔を赤らめながら抱きしめ合った状態。キスの手前。\n次いで、そこからキスをしている。\n\n両方は不可能であれば、キスをしている状態をお願いします。\n\n〇キャラクター\n紅葉と陽媛はリンク先を参照。\n服装はリンク先のイラストでお願いします。\n\n〇二人の関係性\n恋人\n\n〇宛名\n宛名別レイヤーでお願いします。\n\n〇その他\nその他の細かい点はお任せします。\n\n御一考いただければ幸いです。\n\nhttps://blog.goo.ne.jp/hinata21_001/e/b210fceda813d17ae7b7464434a1d68e", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@mitk_1313/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1695861, "client_id": 1668798, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/154ae525/uploads/origins/d6b91b6c-5136-4c70-b36f-2e93c8528be0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fae0d009e2ac86b6bcac832776f41ef1", "srcset": "https://si.imgix.net/154ae525/uploads/origins/d6b91b6c-5136-4c70-b36f-2e93c8528be0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fae0d009e2ac86b6bcac832776f41ef1, https://si.imgix.net/154ae525/uploads/origins/d6b91b6c-5136-4c70-b36f-2e93c8528be0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=70b19161c3b3c10549cf8a13cfb1f99b 2x, https://si.imgix.net/154ae525/uploads/origins/d6b91b6c-5136-4c70-b36f-2e93c8528be0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7aec3746602a92b2aed0358cfbaf6f39 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/154ae525/uploads/origins/d6b91b6c-5136-4c70-b36f-2e93c8528be0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa1e5eaca70dfd5ee6557071f6c8e5f7", "srcset": "https://si.imgix.net/154ae525/uploads/origins/d6b91b6c-5136-4c70-b36f-2e93c8528be0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa1e5eaca70dfd5ee65570