き、ロゴ追加、等)をお許し願います。\n・上述加工の都合上、背景とキャラとをレイヤー分離した.psd形式での作画をお願いします。\n\nhttp://ducaneko.starfree.jp/img/241024_ducaneko_reference.png", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@haohaoniihao/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 855935, "client_id": 627197, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0c2ec6a6/uploads/origins/2fd40db7-d7bd-4f72-b849-e2c4266f1951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7c7cf24f7bf1b44cc77b5d55101713d", "srcset": "https://si.imgix.net/0c2ec6a6/uploads/origins/2fd40db7-d7bd-4f72-b849-e2c4266f1951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7c7cf24f7bf1b44cc77b5d55101713d, https://si.imgix.net/0c2ec6a6/uploads/origins/2fd40db7-d7bd-4f72-b849-e2c4266f1951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3f36382079ef1267ad35c7248a6efded 2x, https://si.imgix.net/0c2ec6a6/uploads/origins/2fd40db7-d7bd-4f72-b849-e2c4266f1951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=bf17bc563412154ac010c5c22363c53b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0c2ec6a6/uploads/origins/2fd40db7-d7bd-4f72-b849-e2c4266f1951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3b055d29c350db7bc021c54867e634e", "srcset": "https://si.imgix.net/0c2ec6a6/uploads/origins/2fd40db7-d7bd-4f72-b849-e2c4266f1951?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f3b055d29c350db7bc021c54867e634e, https://si.imgix.net/0c2ec6a6/uploads/origins/2fd40db7-d7bd-4f72-b849-e2c4266f1951?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=02600884ac9cd981862d599833f59fe2 2x, https://si.imgix.net/0c2ec6a6/uploads/origins/2fd40db7-d