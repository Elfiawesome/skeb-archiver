4b0d8647e2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=83947a1d8f1bc5562744e265a08bb1f4, https://si.imgix.net/577e3091/uploads/origins/3e0b64ab-ea43-4376-b6d6-dd4b0d8647e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=29aede29ffa6ee3caeef59eb8b9b74f8 2x, https://si.imgix.net/577e3091/uploads/origins/3e0b64ab-ea43-4376-b6d6-dd4b0d8647e2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b6d33289605e38a114eb05fb99fb4d78 3x"}, "body": "辰川はるかさん、こんにちは\n\nウサギのVTuber、ココブンと申します。\nはるかさんの描く男の子のイラスト、本当に大好きです！ 私のオリジナルキャラクター（OC）のVTuberのイラストを依頼したいのですが、夏のビーチを舞台にしたキャラクターのイラストをお願いしたいです。 \n\n服装：スピード水着を着用\nポーズ：水鉄砲を持っている状態で、それ以外のポーズは自由にお任せします\n\nこのイラストはSNS（Twitter）への投稿に使用します。可能であれば、背景が透明なPNGバージョンも併せてご提供いただけると助かります。ご検討いただき、本当にありがとうございます！\n\nhttps://drive.google.com/drive/folders/1CHNL5xKKG6s0AGx2OdQwXM9vm1Y9nbJe?usp=sharing", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@47haruka/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 422422, "client_id": 136776, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7ce24443/uploads/origins/2f12c30b-b827-4b68-97e8-3026256d3893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=058849bdb30edd67e6c19a721b5851b1", "srcset": "https://si.imgix.net/7ce24443/uploads/origins/2f12c30b-b827-4b68-97e8-3026256d3893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=058849bdb30edd67e6c19a721b5851b1, https://si.imgix.net/7ce24443/uploads/origins/2f12c30b-b827-4b68-97e8-3026256d3893?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2221755f5d9a8eb5fd00929026e38ab3 2x, https://si.imgix.net/7ce24443/uploads/origins/2f12c30b-b827-4b68-97e8-3026256d3893?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9994423a825b65bd60873d97c8e9f617 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7ce24443/uploads/origins/2f12c30b-b827-4b68-97e8-3026256d3893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb527636fd35686eccd4aeeb3ea8d931", "srcset": "https://si.imgix.net/7ce24443/uploads/origins/2f12c30b-b827-4b68-97e8-3026256d3893?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb527636fd35686eccd4aeeb3ea8d931, https://si.imgix.net/7ce24443/uploads/origins/2f12c30b-b827-4b68-97e8-3026256d3893?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7ac15739f1f176fddd91268b9284411c 2x, https://si.imgix.net/7ce24443/uploads/origins/2f12c30b-b827-4b68-97e8-3026256d3893?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4d4a49198c9b23fa36f6c91f20cb87d0 3x"}, "body": "はじめまして。Skebの受付を開始してくださり、とても嬉しく思っています。\nいつも先生が描かれる魅力的なショタ作品を、楽しく拝見しております。\nもしよろしければ、今回は「ケモショタ」の創作に挑戦していただけないでしょうか。ご無理のない範囲でご検討いただけますと幸いです。\n具体的なリクエスト内容は以下の通りですので\n\n私のオリジナルキャラクター（OC）のR-18イラストをお願いいたします。\n【OCの参考資料】\nhttps://drive.google.com/drive/u/0/folders/1l4UASpLhosDPUqdagrXT841Sn4BvtNxX\n【服裝・構圖の参考資料】\nhttps://drive.google.com/drive/u/0/folders/1JqnVEbmqHYKHXN7LutUYWPcngyTthWGc\n【シチュエーション・性描写の希望】\n・保健体育の授業（性教育など）を受けている最中の、うちの子のリアクションを描いてほしいです。\n・授業の内容に好奇心を刺激され、こっそり下着（パンツ）の中に手を潜り込ませ、自分の陰茎（ペニス）を触ってしまっている様子。\n・興奮のあまり、先走り汁（愛液）が大量に溢れ出て下着がぐっしょりと濡れてしまっている描写をお願いします。\n・最終的にペニスを露出させ、初めての射精（初射精）に至り、荒い息を吐きながら（喘ぎながら）恍惚としている表情や姿を描いていただきたいです。\n\n可能であれば、PSD形式での納品をお願いいたします。承認していただけましたら大変嬉しいです。\n\nhttps://drive.google.com/drive/u/0/folders/1Y-OsNakI9fyDFE15W52jeCG7Mr9IYX4h\n\nhttps://drive.google.com/drive/u/0/folders/1Y-OsNakI9fyDFE15W52jeCG7Mr9IYX4h", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@47haruka/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 422422, "client_id": 3976243, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/deeb34e9/uploads/origins/f9791f45-3d93-496d-8d69-42eb3a7bbdc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eadab40829c0d6a92a135b566ae549c6", "srcset": "https://si.imgix.net/deeb34e9/uploads/origins/f9791f45-3d93-496d-8d69-42eb3a7bbdc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eadab40829c0d6a92a135b566ae549c6, https://si.imgix.net/deeb34e9/uploads/origins/f9791f45-3d93-496d-8d69-42eb3a7bbdc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=96fa79ba868cb2564e0c376dc8645e8a 2x, https://si.imgix.net/deeb34e9/uploads/origins/f9791f45-3d93-496d-8d69-42eb3a7bbdc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d4c638f03118bfaad3c3ed136f3ed7f7 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/deeb34e9/uploads/origins/f9791f45-3d93-496d-8d69-42eb3a7bbdc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12218f4cd6aba718d9bb87f54cd2d2f9", "srcset": "https://si.imgix.net/deeb34e9/uploads/origins/f9791f45-3d93-496d-8d69-42eb3a7bbdc7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=12218f4cd6aba718d9bb87f54cd2d2f9, https://si.imgix.net/deeb34e9/uploads/origins/f9791f45-3d93-496d-8d69-42eb3a7bbdc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0a7ce8b4e48fbd9a80e0785574a5cc5f 2x, https://si.imgix.net/deeb34e9/uploads/origins/f9791f45-3d93-496d-8d69-42eb3a7bbdc7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c4518134e36a34c26c677e7116cd79a6 3x"}, "body": "tatukawaさん、こんにちは！あなたの作品、特に男の子の下着の描き方が大好きです！私のオリジナルキャラクター、ブリーフを履いたウサギのショタで、ペニスの部分が少し膨らんでいるようなキャラクターを描いていただけませんか？彼は元気でやんちゃな性格です。このイラストは個人的な楽しみや、SNSのプロフィール画像として使いたいと思っ