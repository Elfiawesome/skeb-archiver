人で使うので無しで大丈夫です。\n作成可能であれば、個人利用の為作成は夫婦の分（予備込み）4-5枚の作成予定になります。\n妻が特にぬまじろうさんのメルフィーのプレイマットを愛用してますので雰囲気はそのような感じだと有難いですが可能な範囲で結構です、よろしくお願い申し上げます。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@stkymy58/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2090395, "client_id": 1089138, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/937b2a74/uploads/origins/6fdb6830-cc18-465d-b43e-c4f566a551c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7c1e84b84cc7bd4e6a7bf3628a9832b", "srcset": "https://si.imgix.net/937b2a74/uploads/origins/6fdb6830-cc18-465d-b43e-c4f566a551c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f7c1e84b84cc7bd4e6a7bf3628a9832b, https://si.imgix.net/937b2a74/uploads/origins/6fdb6830-cc18-465d-b43e-c4f566a551c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a62d2d86c60bac3b1aecbb4e0416628b 2x, https://si.imgix.net/937b2a74/uploads/origins/6fdb6830-cc18-465d-b43e-c4f566a551c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2be54e4a51fcc5520ee1403eb83ff3ab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/937b2a74/uploads/origins/6fdb6830-cc18-465d-b43e-c4f566a551c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efee45f9601c8f2fca44ee8ba2abefb9", "srcset": "https://si.imgix.net/937b2a74/uploads/origins/6fdb6830-cc18-465d-b43e-c4f566a551c2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=efee45f9601c8f2fca44ee8ba2abefb9, https://si.imgix.net/937b2a74/uploads/origins/6fdb6830-cc18-465d-b43e-c4f566a551c2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e59229420bc824cccbdcdb38f949615b 2x, https://si.imgix.net/937b2a74/uploads/origins/6fd