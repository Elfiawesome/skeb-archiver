l_appeals_count": 0, "received_works": [{"path": "/@aono_leo1/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3663922, "client_id": 3642826, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/bc984178/uploads/origins/d19ad041-8cd6-47c5-95d6-90c4fbbf31c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=f1ee87a94f3002289a8fa4809b775ba4", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/bc984178/uploads/origins/d19ad041-8cd6-47c5-95d6-90c4fbbf31c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a679ad414cb1685d6c20e4feb4c8df73", "src_set": ""}, "body": "青野れお様\n初めまして！素敵なイラストを拝見させて頂いたのでよろしければ依頼をさせて頂きたく連絡いたしました。\n\n私の推しているVTuber様がファンアートを募集していたので、その依頼になります。\n\n～～～～～～～～～～～～\n\n【キャラクター】\n夢乃むぅこ様(@mooko2020)\n\n【利用目的】\n１．個人観賞・SNS投稿および紹介\n２．夢乃むぅこ様ご本人にファンアートとしてプレゼント。またその際にご本人の使用(各種SNS、収益化済み配信等による活動内利用)の可能性もあるため、そのご許可も頂きたいです。\n\n夢乃むぅこ様にメガネを合わせて頂ければ、服装やポーズなどは青野様にお任せ致します！\n\n金額が少なければ、依頼可能額で再送依頼くださいませ。\n難しければキャンセルいただいて構いません。\n\n【納品データ】\npngとpsdで背景がある場合は透過有り／無しでお願いします。\n\n【参考資料】\n夢乃むぅこ様LitLink、立ち絵有り、イラストの代理依頼歓迎の記載有り\n→https://lit.link/mooko2020\n\n夢乃むぅこ様_Xアカウント\n→https://x.com/mooko2020\n\n夢乃むぅこ様youtube Channel\n→https://www.youtube.com/@YumenoMooko/featured\n\n～～～～～～～～～～～～\n\n依頼内容は以上です。\nご検討頂けますよう、よろしくお願い致します。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aono_leo1/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/bee162fb/uploads/origins/bccd6092-e228-465d-9f8b-3f36a0bdddc1?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=2e4c63edfea263dd48df8e41aa66d6f3", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3663922, "client_id": 1758434, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@aono_leo1/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3663922, "client_id": 202590, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/59a7131b/uploads/origins/ac1296c9-ce7d-4a27-bae2-c88da4a027c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef172f733b9d9b216556092d9b9fcad9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/59a7131b/uploads/origins/ac1296c9-ce7d-4a27-bae2-c88da4a027c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa9db1af9d7271e467273ff078a2c764", "src_set": ""}, "body": "オリキャラちゃんが可愛いので一枚お願い出来ればと思います。\n\n下記のリクエストはもし、ご自身の作風にそぐわない、また描くことに抵抗があるなどありましたら、キャンセルして頂けばと思います。\n\n・リクエストしたいイラスト\nオリキャラちゃんで金ビキニ、ビールを持った宣伝ポスター風のイラストをお願いします。\n(ビールポスターで検索して頂ければ新旧さまざま出てくると思いますが、その点の指定はありません)\n「まぁ、夏だからね」のイラストを拝見する限り水着は少し恥ずかしいという感じのある子と思いましたので、ポスターという体裁で笑顔ながらも、恥ずかしくぎこちない感じにして下さい\n(うちの子はこういうシチュエーションだとこういう感じだろうな、とお考えがある場合はそれでも結構です)\n\n・ビールの銘柄については架空のもので結構です。\n\n・全身の描写は不要ですが、ビキニ部分については上下描いて頂きたいです。(構図上全身が見える、という場合は全身描いて頂ければ結構です)\n\n以上になります。指定の不明な部分や曖昧な点がありましたら、その点自由に描いて頂いて結構です。\nよろしくお願いいたします。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aono_leo1/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3663922, "client_id": 74921, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f31d8b69/uploads/origins/d6950a3e-4491-4eb9-bd09-814473849471?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=433ae2b99ac5a120b84e0a28e25566c9", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f31d8b69/uploads/origins/d6950a3e-4491-4eb9-bd09-814473849471?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1c52a9df2d1f091c0eec7dcd94ac4d1b", "src_set": ""}, "body": "はじめまして、青野先生の綺麗な色の塗り方と健康的な美少女のイラストが好みでリクエスト送らせていただきました。\n\n◆キャラクター\nドールズフロントライン  グリズリーMK.V\n　(二枚目にキャラ資料でいちおう負傷姿の画像を貼ってますが、描いていただく姿は一枚目の通常姿でお願いします)\n①キャラ設定・性格\n人間に酷似した戦術人形という戦闘用アンドロイド\n一見クールですが、面倒見の良い快活なお姉さん系キャラクター。警察官的な職にもついています\n\n■構図・シチュエーション\nグリズリーがカップコーヒーを持ちながらドーナツ(資料4枚目)を資料3枚目のアメリカの警察官のように食べている様子を描いて頂きたいです。\n\n◆その他ポイント・要望\n①縦イラストでお願いします\n②全身イラストではなくホットパンツと太ももが半分見えるぐらいまででお願いします(以前描かれていた「まぁ、夏だからね、」水着イラストに近い感じで)\n③背景の有無はお任せします\n\nジャンル外のキャラクターかもしれませんが、承認のご検討よろしくお願い致します。\n\nhttps://x.com/dacwtiiiam58829/status/1954167499039379818?s=46&t=gw2fdmP6R4QXQI_Cwo1mBw", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@aono_leo1/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3663922, "client_id": 1612447, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c6f42d3e/uploads/origins/589fef9b-a85d-4aad-b48d-8b73d16e7be7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7e4e2843d159d0225f8d46b6fe93eb2a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c6f42d3e/uploads/origins/589fef9b-a85d-4aad-b48d-8b73d16e7be7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e8e8c88e6f5a2aa89f72df287e7ff133", "src_set": ""}, "body": "リクエスト失礼します。\nVtuberの汀御景さんのイラストを描いていただきたく連絡させていただきました。 \n\n三面図、キービジュアルなど\nhttps://x.com/migiwa_mikage/status/1862837279347360174?s=46\n固定キャラポイント：薄い胸。真っ平らです。肋がうっすら浮く程度に全体的にスレンダーに描いていただきたいです。\n青色のイラストがとても素敵なので、青いイラストをお願いします。カワセミの青は光の加減によって色が変わるので、お好きな青色でお願いします。\n\nポーズ・表情・構図など細かなリクエストはないので描きやすいお姿でお願いします。\n\nお手数おかけいたしますが、ご検討の程よろしくお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 362356, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "FISHBONE塩爺@依頼募集中", "screen_name": "BAKETSU_DX", "avatar_url": "https://pbs.twimg.com/profile_images/1951615739200516097/tVJGEqeI.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1017673362183602176/1739964892/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 1}, {"id": 1962549, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "白りんご", "screen_name": "shiro_ringochan", "avatar_url": "https://pbs.twimg.com/profile_images/1749639773948694528/KWp-AXLH.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1373783487824601089/1742253030/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 48}, {"id": 2133550, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "開け子", "screen_name": "teataeko", "avatar_url": "https://pbs.twimg.com/profile_images/1724099954497777664/ceDzJDWt.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1399536605468135424/1671815304/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 144}, {"id": 2443513, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "河原", "screen_name": "kwhr_a", "avatar_url": "https://pbs.twimg.com/profile_images/1038441215237