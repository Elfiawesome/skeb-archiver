=200&h=200&s=161024a3157e1ca6d0d1edea71977ab5", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3bdf3676/uploads/origins/ec9f37d2-967f-4317-ae0f-0e2e4edbd05e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dea2e665054aa81063687e204a7b7b11", "src_set": ""}, "body": "どりっぷ様はじめまして。\nVtuberの紗々羅と申します\n\n知人Vtuberさんを描かれているイラストを拝見いたしましてぜひ紗々羅を描いていただきたいと思いリクエストさせていただきました。\n\n-使用用途-\n動画、配信サムネイル、グッズ等、SNS\nで使用させていただきたいです。 \n許可をいただける場合、承認をしていただければと思います。 \nまた、キャラクターと背景とサインで分けていただけたらとおもいます。\n\n-構図-\n魔法少女が好きなので、魔法を使っているような構図にしていただきたいです。\n可能でしたら全身入れていただきたいです。服は軍服ロリ(参考資料添付いたします)でお願いします。\n\n表情はかっこいい系にしていただきたいです。\n\n-備考-\n完成しましたらTwitterのメンションとファンアートタグで呟いていただけると嬉しいです。 (添付資料の方にタグ載せてます)\n\n問題ないようでしたらぜひお受けしていただけましたら幸いです。\nよろしくお願いいたします\n\nhttps://twitter.com/sasarachann3/status/1602977574426058752?s=46&t=6y1h8iVuE5t4Yev0HNY4_w", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miko/works/18", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1329745, "client_id": 2503899, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/38373803/uploads/origins/d53dfb5a-0424-4e37-a8d1-67398ab5b749?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ba99f4bd943b6bf544c0db3221ef8eb0", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/38373803/uploads/origins/d53dfb5a-0424-4e37-a8d1-67398ab5b749?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=aa325076039f8909a89f25041347c6b2", "src_set": ""}, "body": "はじめまして！こんにちは！いつも可愛くてかっこいいイラスト楽しませてもらっています！ 初めての絵のリクエストですので欠けてる部分があるかもしれませんが、一次創作のリクエストさせていただきます！  URLの男の子お願いします！\n\n つり目でめんどいことに巻き込まれることが多いので困った表情や汗をかくことが多いです！  バストサイズ～フルサイズの間でお願いします！サイズ以外は特に指定はありませんので描きやすいように描いていただければ！ \n\n 靴とかの細かい部分はアレンジしてもらっても構いません！よろしくお願いします！\n\nhttps://drive.google.com/file/d/1Fo__9uyhWIGo9oQOSNBHg8i2NTOxShCx/view?usp=drivesdk", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miko/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1329745, "client_id": 570939, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa0f52c2/uploads/origins/bb84d949-cb23-4df7-884b-b5ab77439811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e5d26447cbe0f787012b4bcbb3bd8f07", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa0f52c2/uploads/origins/bb84d949-cb23-4df7-884b-b5ab77439811?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f280cdbe22e3011e2e23145d14cc0c8", "src_set": ""}, "body": "どりっぷ様初めまして\nVtuberのあらいねこと申します\n\nTikTokいつも拝見させて頂いてます、、！\nどりっぷ様のイラストがとても素敵で是非あらいねこを描いていただきたいと思いリクエストさせて頂きました\n\n構図等はお任せします\n2枚お願いさせていただく予定なので\nどちらかをメイド服(参考資料添付します)\nもう1枚を普段着(メイド服以外ならコスプレっぽい衣装でも何でも大丈夫です)で描いていただけたら嬉しいです、、！\n普段着の方は髪型等も変更していただいて構いません\n\n手錠を持っている子のメイキングがとても好きなので、小物を持たせていただけたら嬉しいです\n\n表情は笑顔にはしないで頂けたら幸いです\nまた、活動のサムネイル等で使いたいと思っているので\n表情差分もあったらとても嬉しいです、、！\n\n1.キャラクター設定\n引きこもりで、家でメイド服を着て配信をしているねこもどき(猫耳と人間の耳どちらもあります)の女の子\n顔に感情を出すことが苦手ですが、中身は結構おバカです\nゲームとお絵描き、なにより話すことが大好きな子です\n\nサインや背景等は別レイヤーで、\n人物のみの透過画像作っていただけたらと思います。\n\n参考資料\nhttps://twitter.com/c_alxo/status/1588199983681241089?s=46&t=Keyc12HT8VU5ySUMkrneRQ\n\nその他\nhttps://twitter.com/c_alxo/status/1581214794312716288?s=46&t=VQrdlpn0SuxjsHT_Z2UVmg\n\n使用用途\nSNS/動画や配信のサムネイル/個人的な鑑賞/\n\n問題ないようでしたらぜひ受けていただけたら幸いです\nよろしくお願い致します", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@miko/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1329745, "client_id": 2204599, "vtt_url": null, "th