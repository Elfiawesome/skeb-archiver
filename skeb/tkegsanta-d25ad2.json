dia/DTqJQGtV4AAGU2X.jpg\n\n以上、よろしくお願いします。\n\nhttps://www.youtube.com/watch?v=KHBwef7qTYc", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tkegsanta/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 623877, "client_id": 190591, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/02c8e201/requests/241743_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=069fb6ced14047664c55970dd89e3312", "srcset": "https://si.imgix.net/02c8e201/requests/241743_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=069fb6ced14047664c55970dd89e3312, https://si.imgix.net/02c8e201/requests/241743_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c69071f0b17eb93d07a05d2b43719d9 2x, https://si.imgix.net/02c8e201/requests/241743_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=edd270872789797e10a7ecd53b868af3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/02c8e201/requests/241743_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb6574f0a35aae7baf67f5ccc41c6c52", "srcset": "https://si.imgix.net/02c8e201/requests/241743_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb6574f0a35aae7baf67f5ccc41c6c52, https://si.imgix.net/02c8e201/requests/241743_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e29302f7d8683d5c17ac456cbc803cf8 2x, https://si.imgix.net/02c8e201/requests/241743_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=198241bde5a993afcdfa1196f81edccd 3x"}, "body": "はじめまして。\ntakaegusantaさんが考える最高にカッコいいスーパーロボットの頭部を描いて頂きたいです。\nできましたら前後二分割で描いてもらいたいです。\nぜひ御検討の程よろしくお願いします。", "nc": 16, "word_count": 0, "transcoder": "image", "creat