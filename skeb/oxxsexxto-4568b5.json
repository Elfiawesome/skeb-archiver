e1-0301745a995a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cf84c0ffc38c98f2cc8b50eed264d730, https://si.imgix.net/ed58c44a/uploads/origins/a7e5bdb1-cf1b-4d40-8de1-0301745a995a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ecfce75cc9a5255f83f9f4f372b1bdb1 2x, https://si.imgix.net/ed58c44a/uploads/origins/a7e5bdb1-cf1b-4d40-8de1-0301745a995a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=6bdd2ad9e1c33dee9c9465d046663f2f 3x"}, "body": "狐の嫁入りイラストをお願いします\n\n表情　結婚式を控え、はにかみつつも嬉しそう、又は幸せそうに微笑んでる\n(上記に限らず、幸せそうな雰囲気であれば大丈夫です。)\n\n特徴　けもみみ(キツネ耳)\n\n髪のスタイル　おまかせします\n髪の色　狐のイメージ色でおまかせします。白狐等も可\n\n服装　白無垢\n　(白色又は、少し黄色味のある白色等。お好きな他色を薄く混ぜ可。模様等もご自由に)\n\n使用しないで欲しい物のお願い\n(小物や背景、装飾品での使用は可)\n綿帽子(頭の被り物)　なし　(ケモミミが隠れるため。半透明のものは可)\n赤色和傘の所持　なし　(人物より目立つため)\n狐のお面の装着　なし　(顔が隠れるため。斜め掛けや所持は可。狐面と猫面の違いにご注意)\n\nその他の装飾品や小物等はおまかせします\n\n季節　春～秋\n（季節は参考のため、冬でも大丈夫です）\n天候　天気雨又は、雨上がりの晴れ　\n（天候も参考情報です。気にせず自由に描いてください。夜間の狐火などの描写も可です。）\n\n構図、解像度はおまかせします\n\n使用用途\nSkeb規約に準拠、キツネ関連の振興で使用(広報、配布物製作、地域の祭り等、非商用に限る)\n\n展覧用のため、宛名はナシでお願いします\n\n参考資料等\nhttps://twitter.com/pinsuke_m/status/1459135013924978694\n稲穂、巻物、宝珠、鍵の他、狐などの描写も歓迎です\n\n上記の各種設定にとらわれず、お好きなように自由に描いても大丈夫です。\n（狐の花嫁以外に、女性+白無垢+狐面所持　などでも可です）\n\nご検討お願いします", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@oxxsexxto/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1460511, "client_id": 438366, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/33123cfb/uploads/origins/e6f474b1-8e12-463c-877d-c9d84c8b8eae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e74da4a485566924c2c1e817d3602b88", "srcset": "https://si.imgix.net/33123cfb/uploads/origins/e6f474b1-8e12-463c-877d-c9d84c8b8eae?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e74da4a485566924c2c1e817d3602b88, https://si.im