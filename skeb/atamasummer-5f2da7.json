g=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=72a19bf272f9b5fd0a89e3d8a7e39f8c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/09106b4e/uploads/origins/ac299959-1019-4abf-8736-79cab332d637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d24ba32fdb95ef72ed31824a98dabc83", "srcset": "https://si.imgix.net/09106b4e/uploads/origins/ac299959-1019-4abf-8736-79cab332d637?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d24ba32fdb95ef72ed31824a98dabc83, https://si.imgix.net/09106b4e/uploads/origins/ac299959-1019-4abf-8736-79cab332d637?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=fdd0d6ac119d1176f7d8b4b226025003 2x, https://si.imgix.net/09106b4e/uploads/origins/ac299959-1019-4abf-8736-79cab332d637?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=99a7b8d17c42cb54ee92e6030dde6609 3x"}, "body": "こんにちは、はじめまして！あなたの可愛らしい画風にとても感銘を受けたので、『東方プロジェクト』の清蘭と鈴瑚のイラストを依頼したいと思っています。\n構図は、二人が背中合わせで、肘を組み合って（かつぎ合い）いるシーンを希望します。\n参考画像は以下の通りです。\nhttps://x.com/hey36253625/status/1723662568563380665（2枚目の画像）\nhttps://www.pixiv.net/artworks/20885065\n\n表情については、元気いっぱいの清蘭は嬉しそう・楽しそうな表情を、運動が苦手な鈴瑚は恥ずかしそう・戸惑ったような表情を浮かべています。\nもしこの依頼に興味を持ってくだされば幸いです。\nよろしくお願いします！", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@atamasummer/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3761251, "client_id": 367168, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/cade86c2/uploads/origins/4ffb782a-3a07-4a9f-a99d-152430d1fee7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88301d858d06b66ba64628616eb3dd08", "srcset": "https://si.imgix.net/cade86c2/uploads/origins/4ffb782a-3a07-4a9f-a99d-152430d1fee7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=88301d858d06b66ba64628616eb3dd08, https://si.imgix.net/cade86c2/uploads/origins/4ffb782a-3a07-4a9f-a99d-152430d1fee7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=584628712e615ac36c29f9bc8465c158 2x, https://si.imgix.net/cade86c2/uploads/origins/4ffb782a-3a07-4a9f-a99d-152430d1fee7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=35297f2c1773a67e9881753ab3a2b702 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/cade86c2/uploads/origins/4ffb782a-3a07-4a9f-a99d-152430d1fee7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cf0fce8b0b1e66c4376f459b4252016", "srcset": "https://si.imgix.net/cade86c2/uploads/origins/4ffb782a-3a07-4a9f-a99d-152430d1fee7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5cf0fce8b0b1e66c4376f459b4252016, https://si.imgix.net/cade86c2/uploads/origins/4ffb782a-3a07-4a9f-a99d-152430d1fee7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=58cc3e47c18f90f1fb8baee8ef13046f 2x, https://si.imgix.net/cade86c2/uploads/origins/4ffb782a-3a07-4a9f-a99d-152430d1fee7?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9e524ac8cad3892f58d1b4afc9a6a433 3x"}, "body": "こんにちは。\n東方ではなく申し訳ないのですが、\nアズールレーンより、デ・ゼーヴェン・プロヴィンシェンをお願いします。\n\n使用用途はタブレットの壁紙に使いたいと考えているので、横長のサイズにて作成をお願いしたいです。\n\n肌面積の多いキャラですが、えっちな感じではなくかわいい雰囲気にしていただけると嬉しいです。\n艤装(キャラの左右に浮かんでいる装備)については難しければ省いていただいて大丈夫です。\n髪型について詳細な資料が見当たらなかったので、申し訳ないのですがなんかいい感じでお願いします。\n\nその他の構図やポーズについてはおまかせします。\n是非よろしくお願いします。\n\n参考資料\nhttps://x.com/azurlane_staff/status/1914282215036670015?s=20", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@atamasummer/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": tru