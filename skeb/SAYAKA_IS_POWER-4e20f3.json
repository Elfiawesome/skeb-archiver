子です！目の横にアイラインのような可愛い黒い線があって、お口のところに口紅のように茶色く模様があるところも可愛いです！お鼻がサーモンピンクで可愛いです！お顔の模様がシンメトリーで美意識の高さを感じます！またお顔が小さくてお目目が大きいです！お目目の色がシャインマスカットみたいに綺麗です！可愛いです！お顔はまん丸です！おててもお腹も真っ白です！上から見ると鯖の模様が多く見えますが、下から見ると白の部分が殆どです！かしこまって正座してる時の体のラインが美しいのですが、まったりお触りしてる時のお餅のような柔らかい曲線も素晴らしいと思います！頭を撫でられるのは好きですが肉球やお腹を触るとブチギレます！ﾑｴｰｰって鳴きます！他の子と比べてめちゃくちゃ鳴くタイプの猫です！攻撃方法はひっかきとかみつきの二種類で、ひっかきつつそのまま噛みつきに移行するコンボで大ダメージを与えることができます！キルクールタイムは3秒くらいしかないです！\n長々と書きましたが、自分の飼い猫の容姿については資料用URLをご参照ください！よろしくお願いします！！\n\nhttps://twitter.com/dueglenburn/status/1457259556669583369?s=21", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@SAYAKA_IS_POWER/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 607053, "client_id": 794985, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9418887a/uploads/origins/6cdad6d8-a76e-4edb-b9bd-cc85084c6b07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=880e56c66066986fc3db7518188158c3", "srcset": "https://si.imgix.net/9418887a/uploads/origins/6cdad6d8-a76e-4edb-b9bd-cc85084c6b07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=880e56c66066986fc3db7518188158c3, https://si.imgix.net/9418887a/uploads/origins/6cdad6d8-a76e-4edb-b9bd-cc85084c6b07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6c5343afc5c1e45ffcbbba592e7bb2e1 2x, https://si.imgix.net/9418887a/uploads/origins/6cdad6d8-a76e-4edb-b9bd-cc85084c6b07?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ea65df772f3bdc73adb51fcd09fba67b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9418887a/uploads/origins/6cdad6d8-a76e-4edb-b9bd-cc85084c6b07?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2fe822fce0536bcd7d8fed05a7912dca", "srcset": "https://si.imgix.net/9418887a/uploads/origins/6cdad6d8-a7