rmat%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f132376c87b02accce869fa677943996", "srcset": "https://si.imgix.net/8880d543/uploads/origins/e58cb747-396d-4407-91bf-cafff8111a96?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f132376c87b02accce869fa677943996, https://si.imgix.net/8880d543/uploads/origins/e58cb747-396d-4407-91bf-cafff8111a96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dfc9fde386256c3d6d27cb48b3fb5f44 2x, https://si.imgix.net/8880d543/uploads/origins/e58cb747-396d-4407-91bf-cafff8111a96?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=13b3f6bc0b670e1649c1b1895c8817df 3x"}, "body": "レンゾクビットです。前回は秋手形リクエストを描いていただきありがとうございました！\n\n今回のリクエストですが、\n\n顔の真ん中に真っ赤な紅葉(手形)の付いた、ウマ娘のセイウンスカイをお願いします！ 差分で、いつも描いていただいてる両頬モミジもお願いします！\n\n(手形の色や質感は前回と同じでお願いします)\n\n今回は秋リクエストではないので、背景やシチュエーションはおまかせします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@DlTakashida/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1330780, "client_id": 422626, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b2f81b8d/uploads/origins/c94da233-b135-4fe4-8c48-b2197fb39890?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8cb059e9e3d808430ca020b47a6c3e5", "srcset": "https://si.imgix.net/b2f81b8d/uploads/origins/c94da233-b135-4fe4-8c48-b2197fb39890?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c8cb059e9e3d808430ca020b47a6c3e5, https://si.imgix.net/b2f81b8d/uploads/origins/c94da233-b135-4fe4-8c48-b2197fb39890?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=cb1548011583133382009c7816dab9ce 2x, https://si.imgix.net/b2f81b8d/uploads/origins/c94da233-b135-4fe4-8c48-b2197fb39890?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=84a8792c42e78505a68d9e8f7f4c5660 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b2f81b8d/uploads/origins/c94da233-b135-4fe4-8c48-b2197fb39890?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fbface9a89f2a07541462f60020677b5", "srcset": "https://si.imgix.net/b2f81b8d/uploads/origins/c94da233-b135-4fe4-8c48-b2197fb39890?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fbface9a89f2a07541462f60020677b5, https://si.imgix.net/b2f81b8d/uploads/origins/c94da233-b135-4fe4-8c48-b2197fb39890?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=56bb07d470911e0d9bd117c35f7b3ce3 2x, https://si.imgix.net/b2f81b8d/uploads/origins/c94da233-b135-4fe4-8c48-b2197fb39890?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=7dc7004ce6b53943fb53c8d8940a7ee6 3x"}, "body": "レンゾクビットです！\n季節は秋に突入しました。\n秋のシーズンは9月1日〜11月30日、秋といえば紅葉！紅葉といえば手形！\n私の性癖の本領発揮のシーズンとも言えるでしょう！\nそこで！\n今回は秋を感じる秋手形リクエストを送らせていただきます！\n今回のリクエストに関しては、こちらの方で手形に対する様々な指定をさせていただきます。\n今回描いていただきたい手形は、いつもの両頬モミジとは違う、顔面の真正面に真っ赤で大きい紅葉(手形)が一つ付いているといった感じです。\n(イメージ的には、往復ビンタではなく、相撲で言う張り手を食らわしたと言った方がいいでしょう)\n手のひらの中心が鼻の先に来る感じの張り手ビンタです。\n跡が付くと、親指と小指はほっぺたの上部分、人差し指から薬指の先端は眉毛orおでこ、手のひらの下の部分は上唇を覆う形になります。\n手形の感じは漫画やアニメ調のべったりな感じで、色は紅葉が一番熟した状態の色、紅葉シーズン終盤近くに見られる、ザ・赤と言ったような濃い赤色の紅葉になります。\nリアルな手形の感じは意識せず、頬に付いた時と同様の赤いべったり手形が一枚顔の真ん中に鎮座している感じでお願いします。\n本物の紅葉にも負けない、存在感のある一枚の紅葉(手形)をビターンと張り付けてください！！\n\n内容ですが、\n\n顔の真ん中に真っ赤な紅葉(手形)の付いた、ウマ娘のメイショウドトウをお願いします！\n差分で、いつも描いていただいてる両頬モミジもお願いします！\n可能であれば、背景も秋らしい感じてお願いします！\n(秋シーズン納品が嬉しいです)", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@DlTakashida/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 1330780, "client_id": 422626, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f822e4f4/