s&fm=webp&fit=crop&crop=top&w=200&h=200&s=100cca43cea8df963b517d988da6fe1b", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9739efe8/uploads/origins/aadab1c8-d294-4ec8-a38b-c64f078bb489?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6ee9da00fb2b77a1f10a64e64f380559", "src_set": ""}, "body": "かやのさん、はじめまして！こんばんは🌛\nかやのさんの絵で私のocがぜひ見たくリクエストを送らせていただきました…！おまかせでお好きなように描いていただけたら幸いです💗\n\n◾︎OC\n穏やかで優しい女の子です。焦げ茶の胸くらいまでの髪、ぱっちり〜垂れくらいの目\n\nモチーフ絵文字:🍑🌷\n(詳しい画像等は資料リンク内に添付しております◎)\n\n私服はガーリーからスポーティ、カジュアル、古着系などなんでも着ます。\n\nかやのさんのお洋服のセンスが大好きなので今回は服装等はかやのさんにお任せさせていただきたく思います🥲 (念の為資料内に普段の私服の例を入れておりますが、気にせず描いていただいて大丈夫です☀️ イメージ等の参考にしていただければ幸いですᐢ ; ˙̫ ; ᐢ)\n\nもし可能でしたら服装アレンジしていただけるととても嬉しいです‎！ㅜ.ㅜ (髪型もお好きなようにしていただいて大丈夫です！)\n\n◾︎使用用途\n個人鑑賞、キャラクター資料への使用、sns(鍵垢内)での投稿、アイコン等\n\nお好きに描いていただけたら幸いです。以上の内容にてよろしければご検討頂けましたら幸いです！🌸\n\nhttps://photos.app.goo.gl/9THBWK7EiCzrsjSV7", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kayanon_no/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/acdad927/uploads/origins/21010373-25ba-4add-adeb-7c0a67fbed55?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=48ae5c7f9f7f65be3cab447e49316682", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3628615, "client_id": 2611740, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 128, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kayanon_no/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3628615, "client_id": 3470752, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/83a71ada/uploads/origins/b0f22469-8a64-4010-833e-64f4c030f2aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=668ede19932766d2a8240d0aa329f3d8", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/83a71ada/uploads/origins/b0f22469-8a64-4010-833e-64f4c030f2aa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0f3399a67e78ed6fa64e9bff61cc10a4", "src_set": ""}, "body": "はじめまして。さやすけと申します。\nTwitter（現X）にて、いつも楽しくイラストを拝見させていただいております。\nこの度「skebを、依頼したいッ！」という欲が爆発したため、メッセージを送信させていただきます。\n\n【依頼内容】\n・クトゥルフ神話TRPGにて使用するキャラクターの立ち絵（全身）\n\n【用途】\n・オンラインセッションでの使用\n　※描いていただいたものを参考に、自身がミニキャラなどを描く可能性があります。\n\n【詳細】\n・名前\n　唐草 瑠璃（女/24歳/医者）\n・容姿\n　髪：橙～明るい茶。肩に着く程度の長さ。毛先がカールしている。\n　目：蕩けるような黄金色　※蜂蜜イメージ\n　服装：仕事着。（参考URLで高校生時代の制服および私服を着用。）\n　任意：白衣。\n・性格\n　パンケーキ愛好家/自己中心的\n・表情＆ポーズ\n　はんなり、しっかり系\n\n参考URL内の「新たに得た経験・知識」欄にはネタバレがあります。ご注意ください。\n\n\n以上、ご検討のほどよろしくお願いいたします。\n\nhttps://iachara.com/view/6425042", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@kayanon_no/works/4", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d41d1b87/uploads/origins/6434b36d-3ad1-4162-9502-eeabf086a7b6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=439391169e07d30a35ca63dcf01660f0", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 3628615, "client_id": 2241603, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 16, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kayanon_no/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/70fd9ccb/uploads/origins/bdee6dda-5ca8-4424-8e5a-794b9c3cb347?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=dba356991a7d70450b5c0d1d16dc02ec", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 3628615, "client_id": 2949292, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 0, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@kayanon_no/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3628615, "client_id": 2279334, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6aa88d74/uploads/origins/a869cf08-506a-4d9d-8832-d2570e0d10ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c244ad35088cf73435f4333d9500f30a", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6aa88d74/uploads/origins/a869cf08-506a-4d9d-8832-d2570e0d10ce?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af182250d81702fbd8e1b51312f7d9d5", "src_set": ""}, "body": "かやのさんこんにちは🌱まなむと申します₍ᐢ‥ᐢ₎ ♡\n\nデレマスきっかけでかやのさんを知り、以来ひっそりとイラストを拝見させていただいておりましたꪔ̤̥‪ ‪‪ෆ ‪ ̖́ いつも素敵なイラストをありがとうございます(*ˊˋ*)  \n\nご依頼してうちの子も描いていただけたらな〜なんて思っていたところ、Skebを依頼できると知り駆けつけました🐾\n\n\n【リクエスト内容】\nおまかせでお願いします✊🏻かわいく、甘めのイメージですとうれしいです🎀‎‎💌🍒\nかやのさんの衣装デザインが大好きなので、可能であれば、全身で、衣装＆髪型デザインorアレンジをしていただけたらとっても嬉しいです❣️\nこちらの衣装まとめ、本当にだいすきです🫶🏻🫶🏻 https://x.com/kayanon_no/status/1923354252790874496?s=46&t=H3BF3KlBx3wbGRDh0qNF_w\n\nまた、参考までに、他にも特に好きなイラストを挙げさせていただきます‎૮ᐡᵕ̤ ·̫ ᵕ̤ᐡა\n\nhttps://x.com/kayanon_no/status/1921540824849875361?s=46&t=H3BF3KlBx3wbGRDh0qNF_w\n\nhttps://x.com/kayanon_no/status/1927689401842168215?s=46&t=H3BF3KlBx3wbGRDh\n\nhttps://x.com/kayanon_no/status/1885314672607584547?s=46&t=H3BF3KlBx3wbGRDh0\n\n\n【うちの子について】\nうさぎとイースターモチーフのオリジナルキャラクターです🐇