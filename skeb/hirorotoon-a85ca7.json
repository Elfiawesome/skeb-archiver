=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e06d16e803340ac4451eb630f04034c8 2x, https://si.imgix.net/45432d00/uploads/origins/d2e197b1-0465-4e20-b39c-e883eb6d4ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=ddc765a4f6d2d091fa87d07c170a200b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/45432d00/uploads/origins/d2e197b1-0465-4e20-b39c-e883eb6d4ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c0f9582b27baa0f2a70257114420869", "srcset": "https://si.imgix.net/45432d00/uploads/origins/d2e197b1-0465-4e20-b39c-e883eb6d4ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c0f9582b27baa0f2a70257114420869, https://si.imgix.net/45432d00/uploads/origins/d2e197b1-0465-4e20-b39c-e883eb6d4ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4be49a5f67eb9c69b82a7f63aaba1607 2x, https://si.imgix.net/45432d00/uploads/origins/d2e197b1-0465-4e20-b39c-e883eb6d4ee6?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8faf90715d469e1b49580bb17375faad 3x"}, "body": "また会ったね。\n\n最近、ガールズ＆パンツァーの公式グッズで、ビールの泡でヒゲを作った逸見エリカの絵がありました。その絵がとてもかわいかったので、それをイメージしたイラストをお願いしたいです。\n\n逸見エリカ、赤星小梅、緋田エマの3人がKMMのビアホールにいるイラストが欲しいです。トリオはドイツ風のドレスを着ています。ビールの泡で作った口ひげはそれぞれ違うスタイル。一行は陽気だ。エリカと小梅はお互いの口ひげを見て笑っている。エマは資料にあるような変顔をしている。\n\n口ひげのスタイルを表にしました。各女の子がどのヒゲを付けているか、選んでもらおう。\n\nありがとうございました！\n\nhttps://drive.google.com/drive/folders/1LANdciKBMUA-DBuyQWYX64exGQ6nkEvS?usp=sharing", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@hirorotoon/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3134465, "client_id": 316915, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/643788d9/uploads/origins/06ae0c68-8fc0-4880-9633-12edd794346f?bg=%23fff