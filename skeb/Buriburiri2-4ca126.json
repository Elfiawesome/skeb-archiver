ab-4bf9-b1b7-3c295cf0df8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d16442e97ccc48ad262c9bf73cf2223", "srcset": "https://si.imgix.net/2ef8a450/uploads/origins/78213fb9-24ab-4bf9-b1b7-3c295cf0df8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8d16442e97ccc48ad262c9bf73cf2223, https://si.imgix.net/2ef8a450/uploads/origins/78213fb9-24ab-4bf9-b1b7-3c295cf0df8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=e0395e342794f886c5081ab76b136007 2x, https://si.imgix.net/2ef8a450/uploads/origins/78213fb9-24ab-4bf9-b1b7-3c295cf0df8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b47366198f03657cdbe9b0814a8b90fe 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2ef8a450/uploads/origins/78213fb9-24ab-4bf9-b1b7-3c295cf0df8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e24b917f587f7282e79f1440c60c59ea", "srcset": "https://si.imgix.net/2ef8a450/uploads/origins/78213fb9-24ab-4bf9-b1b7-3c295cf0df8e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e24b917f587f7282e79f1440c60c59ea, https://si.imgix.net/2ef8a450/uploads/origins/78213fb9-24ab-4bf9-b1b7-3c295cf0df8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9dac491e1f9189aabda13fd177a18d07 2x, https://si.imgix.net/2ef8a450/uploads/origins/78213fb9-24ab-4bf9-b1b7-3c295cf0df8e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=db9323a0cbe15aef46b324fd8c124122 3x"}, "body": "快便さん太郎🔞様\n初めまして。\n快便さん太郎🔞様の描くメス男子が大好きで、日ごろから拝見させていただいています。\n\n今回、オリキャラをリクエストさせていただきたいです。\n筋肉、銀髪、ウルフカット、タレ目、ツリ眉な外見で誰にでも明るく優しい男です。こちらからキャラデザご確認ください。↓\nhttps://drive.google.com/drive/folders/17Y2dgG2I1dss82R8P2tXxddS36smlNTy?usp=sharing\nこちらのキャラをメス男子にしていただきたいです。前にツイートされていた、メス父のイラストが大好きなのでそちらに近いイメージでお願いします。シチュエーション的には日常っぽく、しかし表情や仕草、体つきが明らかに今までと違ってどこか女性らしく、「あんなに強くて優しくて逞しかった人が知らない間にこんなに無様にメス堕ちしちゃうなんて…」と脳破壊される感じです。\n可能であれば、体つきをできるだけムチムチにしていただけると嬉しいです。\nよろしくお願いいたします。", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Buriburiri2/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 942820, "client_id": 106153, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/37eed3e9/uploads/origins/69b86487-c045-4d0e-a507-0eea60be67f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14d58ff16824a0e58d063c32a31e1fef", "srcset": "https://si.imgix.net/37eed3e9/uploads/origins/69b86487-c045-4d0e-a507-0eea60be67f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=14d58ff16824a0e58d063c32a31e1fef, https://si.imgix.net/37eed3e9/uploads/origins/69b86487-c045-4d0e-a507-0eea60be67f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=fe8ef239c60939f711121068ca9f02dc 2x, https://si.imgix.net/37eed3e9/uploads/origins/69b86487-c045-4d0e-a507-0eea60be67f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0b08071933aa2c24a1d018d0f308014c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/37eed3e9/uploads/origins/69b86487-c045-4d0e-a507-0eea60be67f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c77bb82a26caeac46cc89f4388a7d08", "srcset": "https://si.imgix.net/37eed3e9/uploads/origins/69b86487-c045-4d0e-a507-0eea60be67f2?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=0c77bb82a26caeac46cc89f4388a7d08, https://si.imgix.net/37eed3e9/uploads/origins/69b86487-c045-4d0e-a507-0eea60be67f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=61913846ce75c7f16bd79b676b6329b6 2x, https://si.imgix.net/37eed3e9/uploads/origins/69b86487-c045-4d0e-a507-0eea60be67f2?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0e879e499bcdb924bd36854d34334eaf 3x"}, "body": "前回はありがとうございました！また再開していたのでリクエスト失礼します。\n普段の画像欄にあるモノクロの漫画(複数カット？)形式みたいなかんじも好きなので大丈夫でしたらそちらでお願いします！\n\n内容↓\n先輩が机の下に落ちたモノを取ろうとするなりで尻をつきだしていたら、ムラムラで機嫌が悪そうな後輩に尻を叩かれて困惑してるみたいな内容\n\nイライラしてる後輩、デカ尻を叩く描写(パァンみたいな音)、困惑してる先輩、があればシチュエーションは何でもいいです\n\n登場人物、二人\n・先輩→ワイシャツ出しっぱネクタイ、デカ尻\nhttps://drive.google.com/drive/folders/1GcPG1-QOf4zdS0rVsP_Qd5x1kG-M6hNr \n服装や雰囲気は前のと同じで大丈夫ですが、髪型は片目隠れの緑髪でお願いします。\n\n・後輩→赤髪でジャージで無表情、怒は顔に出る。小柄で童顔のショタ(ではない)\n\n\n共有の資料(キャラデザが古かったりします)\nhttps://drive.google.com/drive/folders/1LgkRYhp52jEDgxFnpIqcdiK2aDtw6njM?usp=sharing", "nc": 24, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Buriburiri2/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 942820, "client_id": 584710, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/409f92c3/uploads/origins/4505ecad-ea8d-4fad-a3fd-1dd852f154da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa143aafeacc4c84b54a983c2142ca65", "srcset": "https://si.imgix.net/409f92c3/uploads/origins/4505ecad-ea8d-4fad-a3fd-1dd852f154da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=aa143aafeacc4c84b54a983c2142ca65, https://si.imgix.net/409f92c3/uploads/origins/4505ecad-ea8d-4fad-a3fd-1dd852f154da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=76fd2dbb74adc160a7d53fcb49821fdb 2x, https://si.imgix.net/409f92c3/uploads/origins/4505ecad-ea8d-4fad-a3fd-1dd852f154da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=292346d26bc347ec3004ab1d1d4a853f 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/409f92c3/uploads/origins/4505ecad-ea8d-4fad-a3fd-1dd852f154da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9cf7ec368420bdf6966c9a1b2b165766", "srcset": "https://si.imgix.net/409f92c3/uploads/origins/4505ecad-ea8d-4fad-a3fd-1dd852f154da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9cf7ec368420bdf6966c9a1b2b165766, https://si.imgix.net/409f92c3/uploads/origins/4505ecad-ea8d-4fad-a3fd-1dd852f154da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=ef39af45e69d4a93131dec438edb3f2d 2x, https://si.imgix.net/409f92c3/uploads/origins/4505ecad-ea8d-4fad-a3fd-1dd852f154da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=20e6be44ae22812be08a96f3b0c019ee 3x"}, "body": "こんにちは、貴方の素敵な作品の数々を拝見させて頂きました！\n\nご依頼したい内容は、エリクシルといううちの子の白竜になります。\n\nこのすらっとした体長30メートル程の竜が、人間に捕らえられて見世物にされ、運動できないまま栄養の偏った餌を過剰に与えられ続けた結果、もう飛ぶことが出来ないくらいムチムチでブクブクな重そうで無様なお腹周りになって横たわっている姿をお願いできませんか？\n\nお腹一杯でも構わず強引に餌を食べさせられている雰囲気があると一層嬉しいです。\n直接的な拘束表現の有無はお任せできますか？\n\nシチュエーションはフレーバー要素ですので、竜本体を表現して頂けるだけで凄く嬉しいです！\n\nご参考用(竜の姿をデザインして頂きました)\nhttps://twitter.com/Haku17/status/1384089284525756431\n\nhttps://twitter.com/Haku17/status/1347503341094412288\n\nhttps://twitter.com/Haku17/status/1347506284275273728", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Buriburiri2/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 942820, "client_id": 947493, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3d200992/uploads/origins/8fa68a0d-13a7-4b12-a2e7-b5aaaff7d997?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b35e66e5d5272fb070e358d2cc77ef58", "srcset": "https://si.imgix.net/3d200992/uploads/origins/8fa68a0d-13a7-4b12-a2e7-b5aaaff7d997?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b35e66e5d5272fb070e358d2cc77ef58, https://si.imgix.net/3d200992/uploads/origins/8fa68a0d-13a7-4b12-a2e7-b5a