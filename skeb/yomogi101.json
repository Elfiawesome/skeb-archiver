ess&fm=webp&fit=crop&crop=top&w=200&h=200&s=d538f4579ec12790bab4b32e0f828b0c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a54e8c9b/uploads/origins/387ad218-1c0e-4b4a-93a6-fcd2a2eb2bcb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=af523d69f27171fffa49ceb179666fc5", "src_set": ""}, "body": "以前はガールフレンド(仮)の神楽坂砂夜のくすぐりを描いて頂きありがとうございました。\nサキュバス砂夜の続きな感じで、サキュバス達の住処に連れて帰られて快楽くすぐり責めを受け続ける日々を送っているシチュで見てみたいです。\n衣装は下記のURLでお願いしたいです。\n\nイメージとしては、毎日サキュバス達に群がられてある日は全身くまなくくすぐられ、ある日は胸を重点的に快楽責めで開発されて母乳が出るようにされ、ある日は腋を特に徹底的にくすぐられ、ある日は足裏と手のひらまでもくすぐられ\nのような感じで休ませてもらえず延々と毎日玩具にされてる感じが出るとありがたいです。\n\nそしてある日脱走を試みるもあっさりと捕まってしまい、罰として容赦も加減も絶対に一切せずに壊れるまで快楽くすぐりをして来る子供のサキュバス達に拘束されて徹底的に虐められる\n子供達それぞれ好きな部位(胸や手のひら等)があり特にそこを徹底的に壊れるまで責めてくる\n子供達全員から許してもらえれば罰は終わるけど誰一人として砂夜を許す子はおらず、むしろ気に入られてしまったのでその後何十日も快楽くすぐり責めを受け続けてしまうことがわかりながら終わる\nといった感じでお願いしたいです\n\n細部描きにくい点などありましたら好きにしてもらって大丈夫です。\n\n色んな差分を見てみたいので金額が上がっても大丈夫です\n\nとにかく全身をめちゃくちゃに快楽くすぐり責めされていれば助かります。\nご検討よろしくお願いします。\n\nhttps://gfkari.gamedbs.jp/girl/detail/78?_cid=10015868&_mid=275", "nc": 43, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yomogi101/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/15bb9b89/uploads/origins/ffd61240-0ad4-4844-bedb-d8d707de1ac6?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=198c89d513d81881c5099690c1323d25", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2354990, "client_id": 0, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 163, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yomogi101/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/da23c891/uploads/origins/ca059156-5844-454d-acd8-10353eaeaf3e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=0fe7992ea2b2d7438b973ea317f6d1db", "src_set": ""}, "private": true, "genre": "art", "tipped": false, "creator_id": 2354990, "client_id": 3206838, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 51, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yomogi101/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2354990, "client_id": 1034094, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/abbad17b/uploads/origins/68815342-fcbb-41e5-a5b9-0c6339e8f51c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=96e990b4b258f737dd67c8ab87c372ee", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/abbad17b/uploads/origins/68815342-fcbb-41e5-a5b9-0c6339e8f51c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5ba6f5c70640a6b6710e72b160ee90d6", "src_set": ""}, "body": "以前はガールフレンド(仮)の神楽坂砂夜のくすぐりを描いて頂きありがとうございました。\nまたガールフレンド(仮)の神楽坂砂夜をお願いしたくリクエストしました\n衣装は下記のURLでお願いしたいです。\n\nシチュエーションとしてはURLの服装を無理矢理着させられた時に本物のサキュバスに襲われて拘束されながら全身を快楽くすぐり責めされる。\n出来ればサキュバスは複数体いるとありがたいです。\nスペンス乳腺や乳首責め等の快楽責めも併せて入れていただけるとありがたいです。\n\n当初はくすぐり中心の責めをサキュバスの手と無数のマジックハンドのようなものから受ける。\nサキュバスに体を気に入られてしまって念入りに弱点をくすぐられる感じになって止めるように懇願するけど軽くスルーされる感じが出ると嬉しいです。\n最後はパンツとブラジャーを脱がされて目隠しをされて快楽責めもされる。\n胸はスペンス乳腺をグリグリする責めがあると嬉しいです。\nサキュバスに気に入られたせいで住処まで連れていかれて延々と責められる旨を伝えられて当然拒否するけどそれで止まるはずもなくこれからも延々と快楽くすぐり責めが続く雰囲気が出ると嬉しいです\n\n細部描きにくい点などありましたら好きにしてもらって大丈夫です。\nとにかく全身を快楽くすぐり責めされていれば助かります。\nご検討よろしくお願いします。\n\nhttps://gfkari.gamedbs.jp/girl/detail/78?_cid=10015868&_mid=275", "nc": 186, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yomogi101/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2354990, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b3088df6/uploads/origins/d09f393f-4f3d-48f2-9965-d3e7e8f533a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=27f1b9d8bca2a5970b15e3098bcc5851", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3088df6/uploads/origins/d09f393f-4f3d-48f2-9965-d3e7e8f533a5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2474ed07473e21c12da126dc238f3e64", "src_set": ""}, "body": "ガールフレンド(仮)の神楽坂砂夜をお願いします。\n衣装は下記のURLでお願いしたいです。\n\n内容は基本的にはよもぎ先生の作品のにとりにっき等のように大量のマジックハンドに群がられて全身を目茶苦茶にくすぐられる感じでお願いしたいです。\nスペンス乳腺や乳首責め等の快楽責めも併せて入れていただけるとありがたいです。\n\n当初はマジックハンドに群がられて、途中で新聞部の後輩もくすぐりに参加して全裸にされてから目隠しを付けられ、ローションガーゼでのクリ責めも加えられる感じでお願いしたいです。\n後輩には必死に助けを求めるけど後輩は適当なこと言って助ける気がなかったりする感じが出るとありがたいです。\n\n細部描きにくい点などありましたら好きにしてもらって大丈夫です。\nご検討よろしくお願いします\n\nhttps://gfkari.gamedbs.jp/girl/detail/78?_cid=10009029&_mid=275", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yomogi101/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2354990, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/88ddee67/uploads/origins/fbcc265a-b1bd-4a00-a34b-ec9b15984071?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d99622e2fe9e2a804b8f654d2c05c7a7", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/88ddee67/uploads/origins/fbcc265a-b1bd-4a00-a34b-ec9b15984071?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5f4a365e5bc4fa2bd0930fe3c14b3d7f", "src_set": ""}, "body": "原神の雷電将軍と八重神子の2人を裸にして思い切りくすぐって欲しいです\n泣いてお漏らしするくらいにくすぐって凛々しい顔を台無しにしてほしいです", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yomogi101/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2354990, "client_id": 224717, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1307a0cc/uploads/origins/4b94601f-0aeb-47a4-92d6-75a6275475c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d81f53dcd0e5a490c78dc2c58b14bc66", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1307a0cc/uploads/origins/4b94601f-0aeb-47a4-92d6-75a6275475c0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5203c4200608f2481b1ee6729dca568f", "src_set": ""}, "body": "初めまして！\n\n今、私の妄想の一つを満たすために、とあるシリーズの御坂美琴が能力の使えない異世界に飛ばされてしまい、様々なモンスターやトラップにくすぐられる物語を構築中です。よろしければ、その物語の一部を描いていただきたいです。\n\n今回は、私のリクエストに快く使わせてくださった灯火様の考案されたモンスターに、彼女がくすぐられる様子を描いていただきたいです。（許可: https://imgur.com/a/Ds2o02Y\n\nシチュエーション\n美琴は、元の世界に戻るために必要な魔法の宝石の1つが隠されているという海岸を探していた。周囲を探索したところ、洞窟の入り口を発見し、調査することにした。そこで、「クロスゴーレム」に捕まり、くすぐられる。\n\n服装\n美琴は参考URLの水着を着用しています。\n\nモンスター紹介\n十字架の形をした大きな魔物。その体を使って獲物を強力に捕らえ、体内に隠された多数のマジックハンドでくすぐることができる。その他にも、ブラシを用いたり、即席の目隠しで獲物の視界を封じたりと、様々なギミックを使うことがある。また、笑い悶えている被害者の体力を吸収し、抵抗する力を奪うと同時に、くすぐりに弱くする能力も持っている。さらに、閉じた脚の間に回転するブラシを挿入し、彼女の最も敏感な部分を激しくくすぐることができます。\n\n構図はお任せします。好きなように彼女をいじめてください。また、モンスターのデザインはある程度自由に変えていただいて結構です。\n\n最後に、セリフ付きの差分とセリフなしの差分をいただければと思います。\n\nご検討のほど、よろしくお願いいたします！\n\n参考URL\n\nhttps://imgur.com/a/Q21jjno", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yomogi101/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2354990, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/5fd596cf/uploads/origins/37787b46-61ba-434b-a827-f4364142999d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=df1c2094c745377d7f3c3b6a9e580025", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/5fd596cf/uploads/origins/37787b46-61ba-434b-a827-f4364142999d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c51c685ca1fd987c9c95c98fd7b37e87", "src_set": ""}, "body": "初めまして\nイラストが好みなのでリクエストさせていただきます\n\n【版権】\nアイドルマスターシンデレラガールズ\n\n【キャラクター】\nクラリス\n\n【構図】\n足と腕に子供達にのし掛かられくすぐられる\n\n【シチュエーション】\n教会でハロウィンのイベントを開催しており、お菓子を配り終えた所に子供達がお菓子を貰いに来る\nお菓子が無くなった事を伝えるとイタズラとして全身をくすぐられる\n\n他の細かいところはお任せします\n\nよろしければお願い致します", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yomogi101/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2354990, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ad284dc9/uploads/origins/0f0c4370-fa5d-4bd4-ae02-dbb8ee416c9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d1de446803351d7d39816e20422f2d9d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ad284dc9/uploads/origins/0f0c4370-fa5d-4bd4-ae02-dbb8ee416c9c?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1708da51decf607292b03800cffff100", "src_set": ""}, "body": "匿名でのリクエスト失礼します\n以前描いて頂いた こいしが何か悪さをしたせいで人里で見せ物状態で紫と幽々子に恥ずかしいお仕置きをされていじめられてしまうイラストがすごく良かったのでこちらのカラー化をお願いしてもよろしいでしょうか", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yomogi101/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2354990, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/39f12137/uploads/origins/68b1b3a8-aa81-4b32-b595-3a8401fd4445?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7563c1949648f593ad0cd77052bcf55", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/39f12137/uploads/origins/68b1b3a8-aa81-4b32-b595-3a8401fd4445?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0e9417c9f778ce52eaee7cb1e043cf8", "src_set": ""}, "body": "いつも素敵な作品楽しみに拝見させていただいております。もしよろしければ、以下の内容のリクエストをお願いできたらと思います。\n\n・キャラクター\n「ニセコイ 」の小野寺小咲\n(衣装は参考のURLの制服を着ていて、靴だけ脱がせてある状態。また、URLの画像だと白ハイソックスが少し短めに見えますが膝より少しだけ下くらいの丈感で描いていただけたらと思います)\n\n・参考のURL\n\nhttps://www.nisekoi.jp/1st/chara/\n(3番目の女の子)\n\n・シチュエーションのイメージ\nある日下校途中に何者かに誘拐され目を覚ますと身動きできないようガチガチに拘束されていて(拘束のイメージとしては座った状態で両腕はバンザイ、両脚は少し開いて伸ばした状態で手首足首や二の腕太腿あたりもしっかり固定)、彼女は自分の置かれている状況に整理がつかないまま腋・脇腹や白ハイソックスに包まれた足裏など全身を徹底的にくすぐられる。\n猛烈なくすぐったさを味わいつつも、最初は涙や涎を垂れ流しながら必死に笑わまいと我慢するがすぐに限界がきてなりふり構わず笑い悶える小咲。\nその後どれだけの時間がたっても解放されるどころかくすぐりの手が止まる気配もない。目隠しまで追加され、顔は涙や涎でぐしゃぐしゃの状態のまま辛そうに笑い狂いながら、必死に許しや助けを求めくすぐり地獄の中で悶えている。\n(可能であれば、できるだけ全身が見えるような構図だと嬉しいです。)\n\n\n長々と申し訳ありません。\nお手数おかけしますが、ご検討のほどよろしくお願い致します。", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yomogi101/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2354990, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/72239a5c/uploads/origins/80a1252d-b309-4bdb-bf93-4bfe885c65c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dc41fb1363cf97be9452b72f755679fc", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/72239a5c/uploads/origins/80a1252d-b309-4bdb-bf93-4bfe885c65c3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=26118cccb2752fa3c78b4134a216adb5", "src_set": ""}, "body": "古明地さとりを全裸でくすぐってほしいです\n最初は我慢するも能力を奪われて弱点がバレる\nそして我慢出来ずに爆笑していき大泣きしながら悶えるのが見たいです\n\n弱点は脇の下とお尻の割れ目希望\n乳首や割れ目は丸見えでも大丈夫ですっ", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yomogi101/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2354990, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/31d7c325/uploads/origins/e15fb1f5-4995-4651-8414-4771b8bdeff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=42047747db02aeba1dfdcf72ca929d98", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/31d7c325/uploads/origins/e15fb1f5-4995-4651-8414-4771b8bdeff5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45c2455cbaf97b58806d6905ea245a22", "src_set": ""}, "body": "よろしければ、ブルーガール(遊☆戯☆王VRAINS)のくすぐり責めイラストをお願いします。\n\n①キャラ：資料画像参照\n②構図概要：カラー縦１枚絵。また、キャラクターはなるべく大きめに描写頂けますと幸いです。\n③服装：着衣。ただカードホルダー(腰元)・Ai投射装置(手首)は描写不要。またブーツやソックスは脱がして素足にして下さい。\n④責め方：よもぎ様の作品でよくされているような、上から下まで大量のマジックハンドでくすぐり責めにして下さい。また、マジックハンドの色は白でお願いします。\n\n以上です、ご検討よろしくお願いします。\n\nhttps://i.imgur.com/kyNhwsm.jpg", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yomogi101/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2354990, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ee10770a/uploads/origins/930a30f4-b465-4a7e-bc03-3ebf21b55742?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8e99886ed3160dc0c906bc7b9f4f293c", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ee10770a/uploads/origins/930a30f4-b465-4a7e-bc03-3ebf21b55742?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=94fd51a5f4286006b960b6e4dc47f2e5", "src_set": ""}, "body": "匿名でのリクエスト失礼します\nキャラはこいしでシチュは何か悪さをしたせいで人里で見せ物状態で紫と幽々子に恥ずかしいお仕置きをされていじめられてしまう\n上記の理由で紫に弾幕勝負を仕掛けられ最初は格好付けるもあっさり負け全裸にされて拘束されてしまうこいし\nイラスト描写としてはここからでその状態で紫と幽々子にくすぐられてしまい無理矢理笑わされて恥ずかしくて悔しいのにクリや乳首をビンビンにフル勃起させてしまい更にはクリ、乳首、お股、アナルといった全ての弱点をいじられてオモチャにされ遊ばれてしまい、何度もイカされてしまう\n\nなるべくこいしが無様で格好悪い感じで紫や幽々子には羞恥を煽られたり馬鹿にされて揶揄われたりといった感じだと嬉しいです\n色々とすみませんがもしよろしければお願い致します", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 226884, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "糊@skeb", "screen_name": "nori003", "avatar_url": "https://pbs.twimg.com/profile_images/1527287748951801856/fgNGWbgB.jpg", "header_url": "https://pbs.twimg.com/profile_banners/67569567/1441761936/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 177}, {"id": 595808, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "秋草ぺぺろん@単行本「千夜子の秘密」発売中！", "screen_name": "yoshidan", "avatar_url": "https://pbs.twimg.com/profile_images/1156157829171990531/gNy9yYsc.png", "header_url": "https://pbs.twimg.com/profile_banners/43107045/1745902385/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 32}, {"id": 609953, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "nom", "screen_name": "NomChan_V2", "avatar_url": "https://pbs.twimg.com/profile_images/1727045790185725952/0uTe4xJ5.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1422950294753660