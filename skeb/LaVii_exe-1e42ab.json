・人物を透過できるように背景/サイン/人物/小物などを\n　別レイヤー(またはPSD形式)で納品をお願いしたいです。\n\nーーーーーーーーーーーーーーーーーーーー\n【参考キャラクターイメージ】\n・明るい性格で雰囲気は元気とお淑やかの中間です。\n・ゆったりとした話し方で、やわらかい笑い方が特徴です♪\n・本を読むことが好きでよく朗読やノベル系のゲームも行っています。\n・ホラーはゲームや怪談は得意ですが、心霊スポットなどはすごく苦手です！！！\n・普段は魔法と錬金術を使用してアトリエを営んでいます。\n\nーーーーーーーーーーーーーーーーーーーー\n\n依頼内容は以上です！\nもし金額等不足ある場合はお手数ですが変更お願いいたします！\nよろしくお願いいたします！\n\nhttps://drive.google.com/drive/u/1/folders/1CsjCt3jujND_2QZaEXSt2dbt7fJFkqnP", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@LaVii_exe/works/6", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e88877ae/uploads/origins/f9bc79ce-544c-498e-9734-ea83fe93dec4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b5458d0103bd53a9efd666ff92a887e9", "srcset": "https://si.imgix.net/e88877ae/uploads/origins/f9bc79ce-544c-498e-9734-ea83fe93dec4?bg=%23fff&fm=webp&auto=compress&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b5458d0103bd53a9efd666ff92a887e9, https://si.imgix.net/e88877ae/uploads/origins/f9bc79ce-544c-498e-9734-ea83fe93dec4?bg=%23fff&fm=webp&auto=compress&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=eb27ad578c2cadfbfc0d58ee890012d4 2x, https://si.imgix.net/e88877ae/uploads/origins/f9bc79ce-544c-498e-9734-ea83fe93dec4?bg=%23fff&fm=webp&auto=compress&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a2290aef7fe0a7328810e93de3eb3b87 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 3976409, "client_id": 2859615, "nc": 17}, {"path": "/@LaVii_exe/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3976409, "client_id": 3170864, "vtt_url": null