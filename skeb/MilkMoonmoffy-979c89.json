0585032?s=46&t=eDgV5EEhbE6ZWCV2JzTX3w\n\nhttps://www.youtube.com/watch?v=fy59qV6p1RQ&t=925s\n\n・リクエスト\n先生の作品(https://skeb.jp/@MilkMoonmoffy/works/2)のような感じで水着を着ている詩信さんをお願いできますでしょうか。\n水着は詩信さんのイメージカラーの黒赤もしくは白の水着もしくは両方の差分をお願いできますと幸いです。\nポーズや構図はお任せでお願いいたします。\n髪型はポニーテールの詩信さんをお願いできますでしょうか？\n\n人物の頭部、その左右が切れないようにお願いいたします。\n\nデータ形式は人物・背景・宛名のレイヤを分けてPSD形式でお願いいたします。\n\nご検討のほどよろしくお願い申し上げます。\nもし金額や不備などありましたら、アピールやリクエスト再送をお願いいたします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@MilkMoonmoffy/works/4", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 185299, "client_id": 1636804, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6ba6af4f/uploads/origins/d04ebab4-75ca-4959-9282-01c164c22ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49de789aa1da7ca0867a1aed25825414", "srcset": "https://si.imgix.net/6ba6af4f/uploads/origins/d04ebab4-75ca-4959-9282-01c164c22ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=49de789aa1da7ca0867a1aed25825414, https://si.imgix.net/6ba6af4f/uploads/origins/d04ebab4-75ca-4959-9282-01c164c22ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=77d23f88635aca62ad2cc5dfd3426118 2x, https://si.imgix.net/6ba6af4f/uploads/origins/d04ebab4-75ca-4959-9282-01c164c22ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=49cc7bd3d2a9921111af22ad9c068d81 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6ba6af4f/uploads/origins/d04ebab4-75ca-4959-9282-01c164c22ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c90c9b6fc035ed8f3f0ba7b37dc10b3", "srcset": "https://si.imgix.net/6ba6af4f/uploads/origins/d04ebab4-75ca-4959-9282-01c164c22ee9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c90c9b