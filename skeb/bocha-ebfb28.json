ompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ebb95dcfe83b4b2a041e2ad6b43101e3, https://si.imgix.net/f8a7c725/uploads/origins/90af31e5-6861-4813-9188-72531b6e8cb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1fb1895f29768326941560f7cf60aecd 2x, https://si.imgix.net/f8a7c725/uploads/origins/90af31e5-6861-4813-9188-72531b6e8cb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e1fd65dc3c1e4494ddf6374dbc28573 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f8a7c725/uploads/origins/90af31e5-6861-4813-9188-72531b6e8cb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8052e9dc3579e036b7c07c697ff15d21", "srcset": "https://si.imgix.net/f8a7c725/uploads/origins/90af31e5-6861-4813-9188-72531b6e8cb0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8052e9dc3579e036b7c07c697ff15d21, https://si.imgix.net/f8a7c725/uploads/origins/90af31e5-6861-4813-9188-72531b6e8cb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=99d291ca6a93c291f3b442f8cd71a700 2x, https://si.imgix.net/f8a7c725/uploads/origins/90af31e5-6861-4813-9188-72531b6e8cb0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4445aa1d90b119190e2c4976f3ac532e 3x"}, "body": "初めまして。\nぼちゃ様の描かれる愛らしい\nもちもちとしたケモノ耳キャラクターさんに\n一目惚れしてしまい、ご依頼させていただきました。\nよろしければこちらのキャラクター2名をチビ絵で描いていただきたいです。\n\nエミリオ・エニオ・ガレアーノ \n ピアスをしている方。 \n双子の兄。\nいつも涼やかな完全無欠の男だが、 弟の事になると過保護で神経質になり小言が多くなる典型的なブラコン。\n\n\n   セリフ例 \n「レオネル、またネクタイが曲がってるぞ。まったく…直す気はあるのかお前は」と、溜め息を付きながらも緩んでいる弟のネクタイをキチンと結び直す。 \n\n レオネル・エニオ・ガレアーノ \nニコニコしている方。 双子の弟。\n気さくで涼やか。気配り上手で人前で肩の力を抜かない兄に対して、 わざとだらしなく振る舞ったり兄の気を引いてリラックスさせようとする。\n\n セリフ例 \n「だってさ、俺が自分で完璧に結んじゃったら、エミリオがこうやって俺に構ってくれないだろ」とあっけらかんと笑う。\n\n\n  お互いに「エミリオ」、「レオネル」と名前呼び。 家族であり、無二の親友であり、世界で一番の理解者。周囲の目など気にせず、自然体で互いを最優先にしている距離が近すぎる兄弟。\n\n\n資料が敵組織の時のギスギスしているものしか無くて申し訳ありませんが、\n仲直り後の2人を想定しております。\n\n指定につきましては\n弟（レオネル）の方はロングコートじゃなく\nその下のベスト姿でお願いします。\n犬系のケモノ耳を着けてくださると嬉しいです。\n\n地雷などは無いためおまかせします。\nもしよろしければ是非よろしくお願いします。\n\nhttps://www.dropbox.com/scl/fo/g1gbwnp6jz77gqikku0w7/h?rlkey=3u3xe2bmr4do9nq8f2gco6t2o&st=4l3u9m9e&dl=0\n\nhttps://www.dropbox.com/scl/fo/g1gbwnp6jz77gqikku0w7/h?rlkey=3u3xe2bmr4do9nq8f2gco6t2o&st=4l3u9m9e&dl=0", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bocha/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4136080, "client_id": 2110517, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/aafd5462/uploads/origins/a364a5d1-8aff-4c82-a875-bdbd51e23f89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcfb77f5205dbef06f975f94e9eb236e", "srcset": "https://si.imgix.net/aafd5462/uploads/origins/a364a5d1-8aff-4c82-a875-bdbd51e23f89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=dcfb77f5205dbef06f975f94e9eb236e, https://si.imgix.net/aafd5462/uploads/origins/a364a5d1-8aff-4c82-a875-bdbd51e23f89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7a39aedd680094ccf4cf72ec462697e3 2x, https://si.imgix.net/aafd5462/uploads/origins/a364a5d1-8aff-4c82-a875-bdbd51e23f89?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=7d4ea3c7fe7d2231c3034690bbee0eab 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/aafd5462/uploads/origins/a364a5d1-8aff-4c82-a875-bdbd51e23f89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b5cd43d199ad056e60be7a780d3f89a5", "srcset": "https://si.imgix.net/aafd5462/uploads/origins/a364a5d1-8aff-4c82-a875-bdbd51e23f89?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b5cd43d199ad056e60be7a780d3f89a5, https://si.imgix.net/aafd5462/uploads/origi