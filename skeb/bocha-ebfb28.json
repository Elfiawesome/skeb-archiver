ix.net/c71a0a65/uploads/origins/5596dace-d882-4230-afa5-c324554ab5b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a47c8e1da2ea74104c773cce59422948", "srcset": "https://si.imgix.net/c71a0a65/uploads/origins/5596dace-d882-4230-afa5-c324554ab5b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a47c8e1da2ea74104c773cce59422948, https://si.imgix.net/c71a0a65/uploads/origins/5596dace-d882-4230-afa5-c324554ab5b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=18e1c6f4d37c739e0df9d69f805592b6 2x, https://si.imgix.net/c71a0a65/uploads/origins/5596dace-d882-4230-afa5-c324554ab5b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=39dc7d8d92b20b0918f7ff767c23d623 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c71a0a65/uploads/origins/5596dace-d882-4230-afa5-c324554ab5b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e1828a05d65fc10a3940d299c27178d", "srcset": "https://si.imgix.net/c71a0a65/uploads/origins/5596dace-d882-4230-afa5-c324554ab5b8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e1828a05d65fc10a3940d299c27178d, https://si.imgix.net/c71a0a65/uploads/origins/5596dace-d882-4230-afa5-c324554ab5b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8480e9e8ef16aa6d7a79db501c96e19a 2x, https://si.imgix.net/c71a0a65/uploads/origins/5596dace-d882-4230-afa5-c324554ab5b8?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=906d26173881de4a959a3541d9fbe04c 3x"}, "body": "ぼちゃ様\n(お優しくリクエスト再送のご要請を誠にありがとうございます…！😭🙏\n下記のキメラと書かせて頂いた部分を修正させて頂きました！あとメンシプのスタンプについてなのですが喜怒哀楽から1つではなく4種類を…やっぱりぼちゃ様に描いて頂きたいと思いまして！先ほどよりも金額を上げて再送させて頂きました！今一度、ご検討して頂けたら幸いです！)\n\n初めまして、YouTubeで個人Vtuberとして活動してる剱鬼フレイドと申します！\nXの方でぼちゃ様の描くポポンやキメラ達、最近ですと野菜ボンプ達を見て心の栄養、そして目の保養にさせて頂いております！\nこの度ぼちゃ様がskebを開かれたポストをお見かけしまして、リクエストを送らせて頂きました！\n\nリクエスト内容\n  ■【剱鬼フレイドのマスコット化】\n•自身をぼちゃ様のお力でもちもちフワフワなマスコット(猫系や獣系など)にして頂きたいです…！\n•マスコット化した姿でメンシプ用のスタンプもお願いさせて頂きたいです…！\nもしも描いて頂ける場合は【喜•怒•哀•楽】の4種を自由に描いて頂けたら幸いです！\n構図や表情、ポージング全てぼちゃ様にお任せいたします！\n\n・マスコット化して頂ける際もデザイン、構図、表情、ポージングなど全てぼちゃ様にお任せいたします！\n\n自身はゴツめの鬼な姿ではありますが\nぼちゃ様のお力で可愛くマスコット化して頂けたら幸いです！\n\n【下記からは設定や資料の説明などになります。\n描いて頂ける際の参考に少しでもなれば幸いです】\n\n▼剱鬼フレイドについて▼(キャラ設定的なもの)\n・究極の武を求め、己の拳、我流の豪剣を極めんとする剛力無双・鬼の武人\n・炎は自由自在に使用可能\n・仲間想いで武を重んじ、子供に好かれるような豪放磊落で兄貴分な性格\n\n ▼参考資料についての補足▼\n・マスコット化する際のデザインは【Live2Dの立ち絵】を参考に自由に考えて頂けたら幸いです！\n他にも色々と資料がありますが参考にして頂けたら幸いです！\n\n▼特徴 (マスコット化なので身長や体型などお気になさらずに描いて頂いて大丈夫です！)\n・身長2m、体重100kg超えのゴリマッチョ体系\n(体型の例・原神のファルカ.ゼンゼロの狛野真斗)\n・イメージカラー【赤・白・黒】\n・キャライメージ【武、和、鬼、炎、拳、剣】\n\n■使用用途：YouTubeチャンネル(収益化済み)におけるサムネイルや配信内、配信活動での使用\n X(Twitter)などのSNS(アイコンなど)での利用\n(スタンプも描いて頂ける場合はメンシプでの使用)\n\n ■形式：PNGもしくはPSDで可能でしたらお願いさせて頂きたいです！\n\n改めてご検討、どうかよろしくお願いいたします！\n\nhttps://drive.google.com/drive/mobile/folders/1jd4fvMraFgDMCReQX8sFYhHBHmTqaVQI?usp=drive_link&sort=13&direction&pli=1", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@bocha/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 4136080, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1f527ce9/uploads/origins/dacbf70c-d812-4709-ab7a-6f6f44deb720?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a89e9e33b71c869a435e4d09f81091a3", "srcset": "https://si.imgix.net/1f527ce9/uploads/origins/dacbf70c-d812-4709-ab7a-6f6f44deb720?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a89e9e33b71c869a435e4d09f81091a3, https://si.imgix.net/1f527ce9/uploads/origins/dacbf70c-d812-4709-ab7a-6f6f44deb720?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2a7a321dbf6f53122097b51b572d6f07 2x, https://si.imgix.net/1f527ce9/uploads/origins/dacbf70c-d812-4709-ab7a-6f6f44deb720?bg=%23fff&auto=format%2C