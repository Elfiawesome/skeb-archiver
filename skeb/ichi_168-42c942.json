い。難しい場合はお断りいただいて大丈夫です。\n\nご検討のほど、どうぞよろしくお願いいたします。", "nc": 9, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 37298, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "初白まみむ👾", "screen_name": "ko_cha_22", "avatar_url": "https://pbs.twimg.com/profile_images/2030996667038838786/J7-TyIGT.jpg", "header_url": "https://pbs.twimg.com/profile_banners/828583901392023553/1704788073/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 70, "skills": [{"genre": "art"}], "nc": 0}, {"id": 1175977, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "ハリ", "screen_name": "mu4no1ki", "avatar_url": "https://pbs.twimg.com/profile_images/1560836594709704704/wU70Qeu1.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1171756094365921280/1660990009/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 15, "complete_expiration_days": 50, "skills": [{"genre": "art"}], "nc": 33}, {"id": 2407774, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "けい🍆skeb募集中", "screen_name": "NASUBI_07", "avatar_url": "https://pbs.twimg.com/profile_images/1942787192897822722/6_tpOzZ0.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1370246997530218496/1727082850/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 10, "complete_expiration_days": 120, "skills": [{"genre": "art"}, {"genre": "comic"}], "nc": 177}, {"id": 2496364, "creator": true, "nsfw_acceptable": false, "acceptable": true, 