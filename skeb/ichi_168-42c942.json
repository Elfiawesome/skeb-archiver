fdb/uploads/origins/2e33d57b-d4af-483a-98a6-23fe4b022a53?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3982283d904fffb8d08e64140fbe7d4a, https://si.imgix.net/5828ffdb/uploads/origins/2e33d57b-d4af-483a-98a6-23fe4b022a53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a60814039b272705968ffdf0d2b7dd51 2x, https://si.imgix.net/5828ffdb/uploads/origins/2e33d57b-d4af-483a-98a6-23fe4b022a53?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=090d52b329a6bbb58becfbb980bbd7ac 3x"}, "body": "一六八様初めまして。\n個人VTuberの雲霧霖と申します。\n\n一六八様が描かれる仄暗くジメッとした雰囲気のイラストが大好きなので、skebをお願いしたくリクエストを送らせていただきました！\n\nお願いしたいのは私のV姿で、雰囲気や構図等は一六八様に全てお任せしたいです。\n私のモチーフは名前の漢字にも使っているように雲や雨、霧や雷などの悪天候になっています。\nもし作品の案として使えれば取り入れて頂けたらと思います。\n\nプロフ画像、SNSでの広報活動、収益化済みのYouTubeのサムネイルに使用する予定なので背景透過のデータも頂けると非常に助かります。\n三面図の資料を添付致しますのでこちらをご確認して頂けますと幸いです。\n\n男性をメインに描かれているので、女性のイラストは受け付けていないとの事であれば拒否して頂いて大丈夫です…！！\nお手隙の際にご確認の程よろしくお願い致します。\n\nhttps://drive.google.com/drive/folders/1_0ISP5efNy-0TSsarH8iQMAhGfd-0Kqi", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@ichi_168/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2685424, "client_id": 3252034, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a54f7736/uploads/origins/876c458e-3da1-4ae7-8d92-5cafd988c517?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20a0afa39a5811aa4a8d2a02c7afcee3", "srcset": "https://si.imgix.net/a54f7736/uploads/origins/876c458e-3da1-4ae7-8d92-5cafd988c517?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=20a0afa39a5811aa4a8d2a02c7afcee3, https://si.imgix.net/a54f7736/uploads/origins/876c458e-3da1-4ae7-8d92-5cafd988c517?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=5a8b14a669afe0e1873a22f1e8d4c39c 2x, https://si.imgix.net