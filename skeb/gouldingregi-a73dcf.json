ivate_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 100538, "client_id": 156214, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7643f2ba/requests/146343_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad7272ef1b5eb0ca168f40735d96d9c5", "srcset": "https://si.imgix.net/7643f2ba/requests/146343_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ad7272ef1b5eb0ca168f40735d96d9c5, https://si.imgix.net/7643f2ba/requests/146343_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=68614a669cc8fd618df9d62df01db1a6 2x, https://si.imgix.net/7643f2ba/requests/146343_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=df70142e3adfc33dfd0228e566596e6c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7643f2ba/requests/146343_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a385d1775876ca327626655ac1944f43", "srcset": "https://si.imgix.net/7643f2ba/requests/146343_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a385d1775876ca327626655ac1944f43, https://si.imgix.net/7643f2ba/requests/146343_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=23137d281597db2a41958ddb893ecbeb 2x, https://si.imgix.net/7643f2ba/requests/146343_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=74eab310e413868a2fb2666fd42401c4 3x"}, "body": "またしても前回は本当にありがとうございました…！\n\n今回は同じキャラクターで、戦場と兵士がバックで”戦争”がテーマのイラストをお願いできないでしょうか。\n\n「戦場で戦う王」という側面を表現できたら幸いです。戦闘場面でも指揮を執っているような場面でも、シチュの細かいところはおゾノタイダ先生のセンスにお任せいたします。\n\nただ、全身像というよりも顔や表情、仕草に注目を宛がったら嬉しいです。壁紙に使えるようなアス比が理想的です。\n\n流血表現もOKでしたら過激にならない程度でぜひともお願いしたいです…！\n\n今回オジロワシはスルーで大丈夫です。\nもし剣を描くのでしたら、グランブルーファンタジーというゲームの”ライトニング・サヴァイヴ”みたいな雰囲気の、長めの剣装備でお願いします。（アレンジはゾノタイダ先生のご自由にしていただいて構いません！）\n\n追加画像資料も少々ありますのでご確認いただければ幸いです。\n\nお手すきの際にご検討のほどよろしくお願いします。\n\nhttps://imgur.com/a/v0NlZdD", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gouldingregi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 100538, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f52c8844/requests/139394_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a334d8af9e2ded85bb86646ec37c1585", "srcset": "https://si.imgix.net/f52c8844/requests/139394_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a334d8af9e2ded85bb86646ec37c1585, https://si.imgix.net/f52c8844/requests/139394_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=16fa2fa2022ae86757828b5ae97aff72 2x, https://si.imgix.net/f52c8844/requests/139394_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=32737e2f2afc62464a8d6a180c5af849 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f52c8844/requests/139394_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3c0789339c4f3cdf4c7655df8b61df9", "srcset": "https://si.imgix.net/f52c8844/requests/139394_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c3c0789339c4f3cdf4c7655df8b61df9, https://si.imgix.net/f52c8844/requests/139394_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=1a3a0875a0919e3737e50103c3f95de0 2x, https://si.imgix.net/f52c8844/requests/139394_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=9e7f57897e2083b9086608c894eb1f84 3x"}, "body": "キャラはBBサマー(FGO)です。彼女は3rdアセンション、オルタナティブ(光肌)バージョンです。\n\nhttps://pbs.twimg.com/media/D8iW_foU0AEsHjv.jpg:large\n\nBBはこんな感じで足を横に倒して玉座に座っている https://i.pinimg.com/originals/7f/cf/a8/7fcfa8bc694b4132cf8a8a6782a7ff92.jpg\n\n邪悪な笑みを浮かべ、右手に聖杯を持っているBB。\n\n玉座の周りには、彼女のタコの腕が他の4つの聖杯を持っています。\n\nEnglish:\n\nThe character is BB Summer (FGO). She is in 3rd ascension, alternate (light-skinned) version: \n\nhttps://pbs.twimg.com/media/D8iW_foU0AEsHjv.jpg:large\n\nBB is sitting on a throne, with her legs over the side like this: https://i.pinimg.com/originals/7f/cf/a8/7fcfa8bc694b4132cf8a8a6782a7ff92.jpg\n\nBB has an evil smile, and is holding a holy grail in her right hand.\n\nAround the throne, her \"octopus arms\" are holding 4 other holy grails.", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gouldingregi/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 100538, "client_id": 156214, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/faee17c1/requests/118431_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=772c5f00c6dd2146d5123ede8383df37", "srcset": "https://si.imgix.net/faee17c1/requests/118431_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=772c5f00c6dd2146d5123ede8383df37, https://si.imgix.net/faee17c1/requests/118431_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=01889ed4fb80484ef264021424ef966b 2x, https://si.imgix.net/faee17c1/requests/118431_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8912c407bc292d6b864bc5e2c0706479 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/faee17c1/requests/118431_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=991e9e96bc6277cb8f42a247afbb6d8f", "srcset": "https://si.imgix.net/faee17c1/requests/118431_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=991e9e96bc6277cb8f42a247afbb6d8f, https://si.imgix.net/faee17c1/requests/118431_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=b5c1f8fd224015199ce839446d68d875 2x, https://si.imgix.net/faee17c1/requests/118431_0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b2b927edfa53102920963a17ef5ade47 3x"}, "body": "ゾノタイダ先生\n資料の追加も兼ねて、リクエストを再送信させていただきます…！\n\n【キャラ】\nグウェンゾライ（愛称グウェン）という名前で、古代ブリトンの北部の王にして幻術使いの魔術師という設定です。\n178cmの青年で、モチーフは霧と鷲（オジロワシ）。\n装備している剣は霧に変形したりします。\n\n寡黙そうに見えて、実は面倒見が良くて愛妻家。トラブルメーカーな義兄と実の弟たちに色々無茶ぶりされて、なんやかんやで付き合ってくれるタイプです。\n\nキャラデザは友人が描いてくれたスケッチと過去コミッションを資料リンクにてご参考いただければ幸いです。\n服装は見映え良いように先生がアレンジしていただいてもOKです！\n\n前回先生が描いてくださったうちの子の”アルウィン”とは血縁関係のキャラなので、髪型や顔の造形は彼の資料を参考にしていただければと思います。\nhttp://grimoire.sanctuary-inc.net/images/2020/07/03/arwyn-yusano-trim.png\n（顔と目の雰囲気は、このイラストが一番グウェンに近いかと考えています）\n\nhttps://i.imgur.com/w5i8VEg.jpg\n（髪型の参考用に）\n\nただし髪色と瞳の色は金髪・赤目でお願いします。\n妖精種の人外の血が混ざっていて、赤い瞳や瞳孔の形などで人外感を表現できればと考えています。\n体形は引き締まっていてもひょろくはない感じです。\n\n【詳細】\n霧のモチーフとゾノタイダ先生の作品”終戦”のような雰囲気が出ると嬉しいです。\n\n資料にもあるように、鳥（オジロワシ）の翼の形を思わせる焦げたボロボロなクロークを着ています。\n\n死者の魂を運ぶオジロワシを二羽飼っているという伝承があるので、もし余裕があればイラストの構図になんらかの形で登場させていただけると嬉しいです…！\n\nその他構図やポージングの細部はお任せいたします。\n\n【納品】\n納品は宛名が別レイヤーのPSDでお願いします。\n作品は今後Skebなどにて個人観賞用のコミッションの参考資料にする可能性があります。\nもし許可できないようでしたら、お手数をおかけしますがPSDのレイヤーで表記してくだされば幸いです。\n\n長々と失礼いたしました。お手すきの際にどうかご検討のほどよろしくお願いします！\n\nhttps://imgur.com/a/v0NlZdD", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@gouldingregi/works/3", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/26a91dba/requests/78051_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f8290f03d67e2ca38f5051eca065496c", "srcset": "https://si.imgix.net/26a91dba/requests/78051_0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE