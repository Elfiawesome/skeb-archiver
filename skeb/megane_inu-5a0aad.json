輪の赤い薔薇を付けている焔( https://app.box.com/s/f41ay418rpn20d0f9qnvt57rlpxat5y1)がルナールへ向けて手を伸ばしている所で、 二人の背景は結婚式場のような場所をお願いしたいです。  \n\n二人とも体毛が真っ白な為、白いドレスや白いスーツは中々にアレかと思いますが…  \n\n差分として夜の時間にホテルで今から子作りを行う瞬間の、二人とも真っ裸で舌を出している発情した表情(ルナールの胸は可能な限り大きく)と瞳にハートマークが入っているも希望です。  \n\nルナールのウエディングドレスや焔のスーツ、シチュエーションの雰囲気は以下に貼っている、「愛に出会い恋は続く」と言う楽曲の女性視点と男性視点の動画イラストのような雰囲気になります。  \n\n愛に出会い恋は続く　女性視点 https://youtu.be/TDpJAuxpfMs?si=iqMdhk20RD0lfXTy   \n\n愛に出会い恋は続く　男性視点 https://youtu.be/1oyfoRXyrK8?si=0dfOHN_kztdH_jIp  \n\nご多忙とは存じますがご検討いただけると幸いです。", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@megane_inu/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 14320, "client_id": 134098, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e265a027/uploads/origins/4c3752d6-357d-462e-acb9-87db33c3738f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09a52f185f1a30d21ee03964b2648258", "srcset": "https://si.imgix.net/e265a027/uploads/origins/4c3752d6-357d-462e-acb9-87db33c3738f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=09a52f185f1a30d21ee03964b2648258, https://si.imgix.net/e265a027/uploads/origins/4c3752d6-357d-462e-acb9-87db33c3738f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a0130b4e3ce4b58ed058c140b2ac14fb 2x, https://si.imgix.net/e265a027/uploads/origins/4c3752d6-357d-462e-acb9-87db33c3738f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=705fe4b841d583274d2ff3cf1f471a0f 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e265a027/uploads/origins/4c3752d6-357d-462e-acb9-87db33c3738f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e77c62c421b61f40b940ed161215b8a8", "srcset": "https://si.imgix.net/e265a027/uploads/origins/4c3752d6-357d-462e-acb9-87db33c3738