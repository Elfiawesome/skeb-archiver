、マスクのオンオフ差分があると嬉しいです。その他、ポーズや表情などはお任せで自由に決めていただければと思います。\n\n私自身、イラストの依頼が初めてで金額の相場などが分からずでして、不相応であればご返信いただけますと幸いです。\n\n何卒ご検討のほどよろしくお願いいたします。\n\nhttps://x.com/jobvampirecraft/status/1771310975087771802?s=46&t=6N9yCbzXU790LmiiVgIVEQ", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 159732, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "りせっとぼたん", "screen_name": "rasetsu001", "avatar_url": "https://pbs.twimg.com/profile_images/1176029495263813632/EtV6Ww1z.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1173757259651805184/1620121210/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 1}, {"id": 222940, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "キドリ", "screen_name": "yau5531", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fio%2Fwebpublic-ee31f795-7549-436b-ae2c-7f278bc43ba8.webp&avatar=1", "header_url": "https://media.misskeyusercontent.jp/io/webpublic-7562ddf5-0e95-4214-9ebc-89cf4ca1edb8.png", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 48}, {"id": 422266, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ゆきむらるい🦊skeb受付中!", "screen_name": "yukimura_88", "avatar_url": "https://pbs.twimg.com/profile_images/1852334536241418241/Utyw1gwu.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1109347549649879040/1695890895/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_maste