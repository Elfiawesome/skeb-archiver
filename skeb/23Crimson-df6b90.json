、マスクのオンオフ差分があると嬉しいです。その他、ポーズや表情などはお任せで自由に決めていただければと思います。\n\n私自身、イラストの依頼が初めてで金額の相場などが分からずでして、不相応であればご返信いただけますと幸いです。\n\n何卒ご検討のほどよろしくお願いいたします。\n\nhttps://x.com/jobvampirecraft/status/1771310975087771802?s=46&t=6N9yCbzXU790LmiiVgIVEQ", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 5281, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "日本円🍅", "screen_name": "japan_yen", "avatar_url": "https://pbs.twimg.com/profile_images/1463691549498548225/tZ9-0ng_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/124497868/1751854435/1500x500", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 177}, {"id": 8331, "creator": true, "nsfw_acceptable": true, "acceptable": false, "name": "moli", "screen_name": "moli0000", "avatar_url": "https://proxy.misskeyusercontent.jp/avatar.webp?url=https%3A%2F%2Fmedia.misskeyusercontent.jp%2Fmisskey%2F1680daad-9168-49c3-8944-c82851a6720f.jpg&avatar=1", "header_url": "https://media.misskeyusercontent.jp/misskey/06f6e32e-c6e5-4ee1-b3ab-9e8b9096b8c1.jpg", "appeal_receivable": true, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "banned": false, "nc": 49}, {"id": 954799, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "ᵤ ᵣ ₐ ᵢ", "screen_name": "uri07_", "avatar_url": "https://cdn.bsky.app/img/avatar/plain/did:plc:m4inj5ol7eyirnawmgckgk4x/bafkreibhakcu3yfwpcmfncfzhmzzmmlvy3ouao73mac3lbytxhyx7ifkxe", "header_url": "https://cdn.bsky.app/img/banner/plain/did:plc:m4inj5ol7eyirnawmgckgk4x/bafkreigi2ig7rqxxauopcm5mxz