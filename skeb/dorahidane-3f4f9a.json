いただけますと幸いです。\n\n用途はSNSでのご紹介や、他のイラストレーターさんに依頼する際に使用させてください。\nまた、いただいたデザインをもとに自分で3D衣装を作成したいと思っております。\nその際、3Dに落とし込むため細部のアレンジさせていただくことがあります。\nイラストをそのままグッズ化はいたしません。\n\nキャラクター\n・女性\n・身長140cm\n・髪色は白〜赤のグラデーション\n・目の色は黄色(琥珀色に近い)\n・赤いドラゴンをモチーフとしたVtuber\n・尖耳、まろ眉、口を大きく開けると牙あり\n・角、羽、尻尾あり\n・向かって右側の角(私にとっての左角)にだけ何か飾りをつけてください\n\n資料URLに画像や詳細のテキストを記載しました。\n\nよろしくお願いいたします。\n\nhttps://www.dropbox.com/scl/fo/i1angb2q1vmoxd10ic9mi/AJSJPyyq8rkiWnJm_4HHiEY?rlkey=dmc0sbx50cfb4x3gwkrhrp74i&st=063oii9p&dl=0", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@coobard/works/24", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1238137, "client_id": 767292, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/fa7d87a2/uploads/origins/4b94c188-91e4-447d-8ac4-5bb6772c51cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb7ff930041aa7ecf0c78d07bae4e69e", "srcset": "https://si.imgix.net/fa7d87a2/uploads/origins/4b94c188-91e4-447d-8ac4-5bb6772c51cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fb7ff930041aa7ecf0c78d07bae4e69e, https://si.imgix.net/fa7d87a2/uploads/origins/4b94c188-91e4-447d-8ac4-5bb6772c51cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=edd620c380c40ec3cc74fc606aeffec5 2x, https://si.imgix.net/fa7d87a2/uploads/origins/4b94c188-91e4-447d-8ac4-5bb6772c51cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=05f44e3f5bb26b06041063a26892706d 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/fa7d87a2/uploads/origins/4b94c188-91e4-447d-8ac4-5bb6772c51cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9bdbfc3375dc49ac46ac1d2e9626b2b1", "srcset": "https://si.imgix.net/fa7d87a2/uploads/origins/4b94c188-91e4-447d-8ac4-5bb6772c51cb?bg=%23fff&auto=format%2Ccomp