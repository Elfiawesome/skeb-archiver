&fit=crop&crop=top&w=200&h=200&s=78f710d6790b4481c127baf6d875b05f", "srcset": "https://si.imgix.net/7b843002/uploads/origins/d5ff7a16-273c-42af-a49f-f2c17ccc6600?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=78f710d6790b4481c127baf6d875b05f, https://si.imgix.net/7b843002/uploads/origins/d5ff7a16-273c-42af-a49f-f2c17ccc6600?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2e342bd7c431083ade5c5eb12f6d4779 2x, https://si.imgix.net/7b843002/uploads/origins/d5ff7a16-273c-42af-a49f-f2c17ccc6600?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e5c6d2c90f27c9877273c0c0d59e8d5b 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7b843002/uploads/origins/d5ff7a16-273c-42af-a49f-f2c17ccc6600?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f5ba8ed859853b0cba76169c7c0dcd4", "srcset": "https://si.imgix.net/7b843002/uploads/origins/d5ff7a16-273c-42af-a49f-f2c17ccc6600?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7f5ba8ed859853b0cba76169c7c0dcd4, https://si.imgix.net/7b843002/uploads/origins/d5ff7a16-273c-42af-a49f-f2c17ccc6600?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c8a73dd0e7a24b8fde2c07855730dc2a 2x, https://si.imgix.net/7b843002/uploads/origins/d5ff7a16-273c-42af-a49f-f2c17ccc6600?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=70d43904e2dae6336093d127324c620e 3x"}, "body": "Sorry for the inconvenience! I'm resending your request because the recommended amount has changed.\n\nI am requesting an original character illustration for me and my friend. Our anniversary is coming up soon.\nWe are childhood friends. They seem to be a tumultuous couple, but they care deeply for each other.\n\nThey have been together for a long time, so a vivacious illustration is fine! But I would like to leave the poses, scenarios, costumes, etc. to you. Feel free to draw the students as well.\n\nYou can draw them however you like!\n\nThere are more details at the link: https://e91nref.carrd.co/#ykz\n\nThank you for considering my request.\nBest regards!\n\nhttps://e91nref.carrd.co/#ykz", "nc": 144, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sirokomamaru/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 945164, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/208a9be1/uploads/origins/70da194d-01cf-457f-b5be-e54b369176a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc0b2be7310eb28003b8b458bb2f3b0c", "srcset": "https://si.imgix.net/208a9be1/uploads/origins/70da194d-01cf-457f-b5be-e54b369176a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=fc0b2be7310eb28003b8b458bb2f3b0c, https://si.imgix.net/208a9be1/uploads/origins/70da194d-01cf-457f-b5be-e54b369176a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9e03edfd43d89e5e03b51fdcbfa4c613 2x, https://si.imgix.net/208a9be1/uploads/origins/70da194d-01cf-457f-b5be-e54b369176a9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=778bef6cf48615e3a6b99ddaf5af6c3a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/208a9be1/uploads/origins/70da194d-01cf-457f-b5be-e54b369176a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb35d89263875075b689b63b794330b1", "srcset": "https://si.imgix.net/208a9be1/uploads/origins/70da194d-01cf-457f-b5be-e54b369176a9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bb35d89263875075b689b63b794330b1, https://si.imgix.net/208a9be1/uploads/origins/70da194d-01cf-457f-b5be-e54b369176a9?bg=%23fff&auto=format%2Ccompres