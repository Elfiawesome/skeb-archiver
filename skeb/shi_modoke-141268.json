せられる訳が無いけどライラちゃんは頭が少し残念なので……）\n構図的にはバストアップで、おっぱいを地面、またはビルなどの建物の屋上等に載せてこびとたちに作業してもらうようなシチュエーションになりますのでポーズはうつ伏せから少し上体を起こす体勢が、もしくは立ったままビルに抱きつくように寄りかかるポーズになると思いますが、どんなポーズかはお任せします！\n\nhttps://www.dropbox.com/sh/xp1p3h6r127mum6/AACuZHvvYfNS1uOk0Qj0n4r4a?dl=0", "nc": 160, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@shi_modoke/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1347396, "client_id": 2660909, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c4cce7c2/uploads/origins/f321bc65-67dc-4731-a881-d5563bcd6905?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a19483523fdfe9935925c2e9ccc8fe3", "srcset": "https://si.imgix.net/c4cce7c2/uploads/origins/f321bc65-67dc-4731-a881-d5563bcd6905?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5a19483523fdfe9935925c2e9ccc8fe3, https://si.imgix.net/c4cce7c2/uploads/origins/f321bc65-67dc-4731-a881-d5563bcd6905?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=42ae2b6b11fb16ed4b88d2dd1d0dbf20 2x, https://si.imgix.net/c4cce7c2/uploads/origins/f321bc65-67dc-4731-a881-d5563bcd6905?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=1c29c70d013062d9f559c3c2e0a205f4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c4cce7c2/uploads/origins/f321bc65-67dc-4731-a881-d5563bcd6905?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=061988f2b1e5f6f03819a84073ce78f7", "srcset": "https://si.imgix.net/c4cce7c2/uploads/origins/f321bc65-67dc-4731-a881-d5563bcd6905?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=061988f2b1e5f6f03819a84073ce78f7, https://si.imgix.net/c4cce7c2/uploads/origins/f321bc65-67dc-4731-a881-d5563bcd6905?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&cro