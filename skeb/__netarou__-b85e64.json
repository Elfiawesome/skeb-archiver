が映える構図を希望します。\n細かな希望としては手袋が肘近くまである長手袋にしていだきたい。\nまた、表情にキメ表情とはわわ羞恥顔の差分があると嬉しいです。\n\nこの依頼を検討していただき、本当にありがとうございます！\n\n衣装参考\nhttps://x.com/otmm/status/1056833716780064768\nhttps://www.pixiv.net/artworks/130591857\nhttps://www.pixiv.net/artworks/71510706\nhttps://www.pixiv.net/artworks/80988190\nhttps://www.pixiv.net/artworks/71395591\n\nhttps://x.com/otmm/status/1056833716780064768", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@__netarou__/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f0693c2e/uploads/origins/54b8330f-f9b3-48e8-b02f-2ab5b7b44ffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e2439fc85e6867388df433956071aeba", "srcset": "https://si.imgix.net/f0693c2e/uploads/origins/54b8330f-f9b3-48e8-b02f-2ab5b7b44ffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e2439fc85e6867388df433956071aeba, https://si.imgix.net/f0693c2e/uploads/origins/54b8330f-f9b3-48e8-b02f-2ab5b7b44ffa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=3b3c4077fb0684293f9e7c4cf4a01a98 2x, https://si.imgix.net/f0693c2e/uploads/origins/54b8330f-f9b3-48e8-b02f-2ab5b7b44ffa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=46881f60dac7d4e601ed7d916b46f863 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1818898, "client_id": 3308724, "nc": 1}, {"path": "/@__netarou__/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1818898, "client_id": 2561414, "vtt_url": nu