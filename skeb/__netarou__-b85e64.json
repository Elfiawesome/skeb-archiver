64e14/uploads/origins/36d14a7a-c9d2-4b84-bbea-6d52e9f02b39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ddf71aa888a1f445569e251b2423c4a9, https://si.imgix.net/d4964e14/uploads/origins/36d14a7a-c9d2-4b84-bbea-6d52e9f02b39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=281aaf038a5dc5a0bb920615a2143961 2x, https://si.imgix.net/d4964e14/uploads/origins/36d14a7a-c9d2-4b84-bbea-6d52e9f02b39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b0686cfada3ac594edef08b37dcf5746 3x"}, "body": "Hello! I love your drawings and would like to request one for my cover of this song : https://youtu.be/h5XQqKuek5A?si=ogzmI_iLDNKEuNsx\n\nI would like a similar composition and background like in the music video from above, but with my character. I would like for it to be an illustration with a video ratio please! (16:9)\n\nHere is my character REIRU : https://drive.google.com/file/d/1tRiTk_wOWoQFXKGAplo_oWoPGYu392Oe/view?usp=sharing\nShe has mint green hair and rainbow bangs. 2 strands of hair framing her face (one purple on the left side and one pink pastel on the right side). She has hazel, beige, brown eyes.\n\nYou can change her hairstyle however you would like to fit the outfit you will make. (Please do not change her haircolor.)\n\nI would like for her to have a traditional outfit like Yachiyo from Cosmic Princess Kaguya, you can choose the outfit but please do something in a similar vibe. You can choose the color and cut of the outfit to fit my character, I just want it to be Japanese traditional inspired like the theme of the movie if possible! \n\nPlease send the file with the background and assets separated from the character if possible. (transparent background character and the background separated)\nThank you!", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@__netarou__/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1818898, "client_id": 3308724, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d49452e3/uploads/origins/c54ca285-c8cb-43d0-9178-3d0305cf1b98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7368cbe16ba0544f7997efd3fc6ff275", "srcset": "https://si.imgix.net/d49452e3/uploads/origins/c54ca285-c8cb-43d0-9178-3d0305cf1b98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7368cbe16ba0544f7997efd3fc6ff275, https://si.imgix.net/d49452e3/uploads/origins/c54ca285-c8cb-43d0-9178-3d0305cf1b98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=b61c5d4d7e07453bf2c915206921597a 2x, https://si.imgix.net/d49452e3/uploads/origins/c54ca285-c8cb-43d0-9178-3d0305cf1b98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2012fb048efbd5451d792d008576d4a2 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d49452e3/uploads/origins/c54ca285-c8cb-43d0-9178-3d0305cf1b98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2260c20f232735bd428b9ba6bc33aad1", "srcset": "https://si.imgix.net/d49452e3/uploads/origins/c54ca285-c8cb-43d0-9178-3d0305cf1b98?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=2260c20f232735bd428b9ba6bc33aad1, https://si.imgix.net/d49452e3/uploads/origins/c54ca285-c8cb-43d0-9178-3d0305cf1b98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=53168b86fa4c2c7dfcd9f201928d2dd1 2x, https://si.imgix.net/d49452e3/uploads/origins/c54ca285-c8cb-43d0-9178-3d0305cf1b98?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b144915da446fdcf3b444315ac4e6ed6 3x"}, "body": "ねたろう様の絵柄がとても大好きなので、ぜひまた私の見た目で描いていただけたらと思いリクエストさせて頂きました。  \n\n【キャラクターについて】 \n綺麗なものとホラーゲームが好きな元人魚のお姉さんです。 \n優しめで穏やかなときと思い切り叫ぶときのギャップがあります。ホラーゲームを好んでいるが怖がりです。 \n\n【見た目の特徴】\n・正面から見て唇左下と右胸元にほくろあり\n・髪の色は藍色っぽい黒から紫へのグラデーション\n・瞳の色は藍色からサーモンレッドへのグラデーション\n・爪の色は青紫\n・人魚のヒレは必ず描いてほしい\n\n 【使用用途】\n・歌ってみた投稿\n・Xでのツイート時やアイコン\n・配信時のサムネイル \n\n【イラストについて】 \n｢おやすみ泣き声、さよなら歌姫｣の歌ってみた用イラストを描いていただきたいです。\n参考構図のように青空の下で風になびかれながら歌う様子をお願いします。\n背景は腰までで、人物のみ全身が希望です。\n\nまた、背景と人物を分けたPSDなどで納品いただけますようお願いいたします。\n\n【参考資料】\nhttps://drive.google.com/drive/folders/1jv7ZbvSnv_fdqGknIbZ67gCOL6CCUi9Q\n\nぜひご検討いただけますと幸いです。\nよろしくお願いいたします。", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@__netarou__/works/13", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/f1101917/uploads/origins/81683ee0-23af-494f-a332-ba1da9392c18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=52c19b9ca6be9f9e691791f0d7bc0fc5", "srcset": "https://si.imgix.net/f1101917/uploads/origins/81683ee0-23af-494f-a332-ba1da9392c18?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=52c19b9ca6be9f9e691791f0d7bc0fc5, https://si.imgix.net/f1101917/uploads/origins/81683ee0-23af-494f-a332-ba1da9392c18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=a1348933492a423a1d475d1b268e0445 2x, https://si.imgix.net/f1101917/uploads/origins/81683ee0-23af-494f-a332-ba1da9392c18?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=337742dae6fd1acb59722b2ba9eb243d 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 1818898, "client_id": 3308724, "nc": 16}, {"path": "/@__netarou__/works/12", "private_thumbnail_image_urls": null, "private": fals