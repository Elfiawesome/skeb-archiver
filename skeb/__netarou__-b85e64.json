と可能であればPNGのデータとしてもいただけたら幸いです。\nサイズに関してはおまかせいたします。\n\nリクエスト内容といたしましては以上となります。\n最後まで読んでくださりありがとうございます。\nお忙しい中恐れ入りますが、ご検討のほどよろしくお願いいたします。\n\n※Twitter\nhttps://x.com/Yumeri_ALP?t=eyBoHQ2rT3h57cNklWHxLA&s=09\n\n※youtube\nhttps://youtube.com/@YumeriALP?si=Ya5ulEo9cA3v-ojy", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@__netarou__/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1818898, "client_id": 2504804, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e48a8025/uploads/origins/70f54ee6-6807-4c26-bdea-2490434da58e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a778ef50227f9c421f9a77bdf6295cb", "srcset": "https://si.imgix.net/e48a8025/uploads/origins/70f54ee6-6807-4c26-bdea-2490434da58e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=0a778ef50227f9c421f9a77bdf6295cb, https://si.imgix.net/e48a8025/uploads/origins/70f54ee6-6807-4c26-bdea-2490434da58e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=59f4d4362677354cf9cfe034c1ba6a11 2x, https://si.imgix.net/e48a8025/uploads/origins/70f54ee6-6807-4c26-bdea-2490434da58e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dff1bd6127fa74186a1d6f3c07bd709c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e48a8025/uploads/origins/70f54ee6-6807-4c26-bdea-2490434da58e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1308fa14889f060a86a7efaae30c696", "srcset": "https://si.imgix.net/e48a8025/uploads/origins/70f54ee6-6807-4c26-bdea-2490434da58e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c1308fa14889f060a86a7efaae30c696, https://si.imgix.net/e48a8025/uploads/origins/70f54ee6-6807-4c26-bdea-2490434da58e?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr