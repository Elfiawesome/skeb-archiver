0&h=200&blur=200&s=c6b92346f15bc699131fcb1af51be122", "src_set": ""}, "body": "こんにちは\n\nあなたの最近の作品を見て素晴らしいと思ったので、僕のキャラクターも描いてほしいんだ。\n\nhttps://imgur.com/a/entia-WHa2nA6\n\nポーズは自由に決めてください。好きなように描いてください。\n\nありがとう。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsukinonishiki/works/3", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3509809, "client_id": 2106121, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/76515614/uploads/origins/3ecc0033-6391-411b-9976-803bc5dff1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9a9deb261c43ab8c053772b8d111fa24", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/76515614/uploads/origins/3ecc0033-6391-411b-9976-803bc5dff1b9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=7fd1b390f65c5b9638b1415333c9ded2", "src_set": ""}, "body": "月乃弐式様\nはじめまして！Vtuberのくくるす りあんと申します！\n作品一覧で魅力的なイラストを拝見し、是非私も描いて頂きたいと思いリクエストを送信させて頂きました。\n\n【依頼内容】\nVtuberとして活動している私のイラストを描いて頂きたいです。\n表情や服装やシチュエーション等全てお任せ致しますが、なるべく手が服の後ろ、背中に隠れる等を避けてもらえたら嬉しいです。ご無理の無い可能な範囲で大丈夫です💦\n\n主に配信内や動画・配信サムネイルに使用させて頂きたいので、衣服の端や髪など、途切れないように描写して頂けるとありがたいです。\n\nまた、キャラクターの透過をPSDで頂けたらとても嬉しいです・・・！\n\n【使用用途】\nYoutubeの配信関係・動画サムネやX(Twitter)など各種SNSで使用させて頂きたいです。\n\nVTuber（OC） へのイラストや使用用途がジャンル外、モデルが気に入らない等で却下して頂いても問題ございません。\n条件合いましたら何卒ご検討宜しくお願いします。\n\nhttps://drive.google.com/file/d/1Nj_Froa7lo1gMbQDfdPr1s2vJX9m7eAn/view?usp=drivesdk", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsukinonishiki/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3509809, "client_id": 1668612, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6e61fbf2/uploads/origins/fd2834ac-1e34-4cce-8c98-2a975a1df1e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=913ec8df9cdb176d64ef568507dc17c7", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6e61fbf2/uploads/origins/fd2834ac-1e34-4cce-8c98-2a975a1df1e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=23eb1435b6daada1a5b5490e0ff97539", "src_set": ""}, "body": "月乃弐式様、初めまして。\n\n今回Skebで上がっていたイラストを拝見させていただきまして、ぜひ私のキャラのファンアートを描いて頂きたく、ご依頼させて頂きました。\n\n以下依頼内容となります。\n\n■キャラ資料\nhttps://drive.google.com/drive/folders/1RTFr9uYGukv5vTEiudiyEfXPnXYuHdy-?usp=drive_link\n\n■使用目的\n配信及びSNSやグッズ・Ci-enでの使用など\n\n■テーマ、構図やポージング\n上記の資料キャラを元にサムネ・SNS・Ci-enなどを想定に月乃弐式様が描いてみたいポーズ・形式で自由形式にお願いしてもいいでしょうか？\n\n服装はデフォルトのものまたは着せたいもののオリジナルでも大丈夫です。\n\n髪型などは資料のものを元にお好きなもので使って頂ければと思います！\n\n以下、簡単な設定になります\n・男の娘（基本極貧乳の女の子ベースで大丈夫です）\n・小悪魔系+メスガキ要素\n・外見とは裏腹の艶めかしさ\n\n■その他\n\nサムネ以外でも活動目的で使わせて頂きたいとも思っています\nそのため、頭の先や横の髪の毛などは先が切れないように書いて頂ければ幸いです\n\nまたキャラのみの透過でも利用できるようPSDのデータでキャラのレイヤーだけが分かれていると非常に助かります。\n\n条件に問題なければ、何卒よろしくお願いいたします！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@tsukinonishiki/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3509809, "client_id": 2348046, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/83fd6d2c/uploads/origins/1941ca2d-a5c6-4f70-a0a9-b025a740e803?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=9336e409c72236845a90e0dd7fdf8590", "src_set": ""}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/83fd6d2c/uploads/origins/1941ca2d-a5c6-4f70-a0a9-b025a740e803?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b2aaf2eb18f97e542d65e44d12510a4", "src_set": ""}, "body": "AAA、本当にありがとう月乃弐式!!!!Twitterであなたのアートを見たので、せめてこれをお礼に送りたいと思ったの <3\n\nデザインもポーズも表現も自由にしてください！\