_visible": false, "total_appeals_count": 0, "received_works": [{"path": "/@yuu_chibititi/works/121", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 89352, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9fec4104/uploads/origins/6e3e3dc9-1376-48c6-8297-d321e8fa4eda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=40bce4ea77538085c4d377bd2bd0bebc", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9fec4104/uploads/origins/6e3e3dc9-1376-48c6-8297-d321e8fa4eda?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=cd09cb9c8a06ef51c89079010bc6285a", "src_set": ""}, "body": "こんにちは、私のオリジナルキャラクター、にこりの絵をリクエストしてもいいですか？  クマ耳と尻尾のついたオッパイロリです。\n\n男と合意の上でセックスしてほしい。  セックスの体位は騎乗位。  セックスの体位は騎乗位。  視点は正面からやや斜め。  にこりはボトムレスで、シャツのボタンを外して大きな胸を露出させている。  セックスの最中、彼女の胸は跳ね上がっていてほしい。  母乳も吹き出している。  股間は男のペニスがあるところで膨らんでいる。  彼女は快感に微笑み、片目を閉じている。\n\n2人が一緒にイクというバリエーションも追加してほしい。  にこりは両目を大きく見開き、口は丸く開いている。  舌は出していない。  ザーメンで満たされた彼女の股間のふくらみはわずかに大きくなっている。  さらに母乳が吹き出し、潮を吹いている。\n\n日本語の擬音は欲しいが、台詞は必要ない。\n\nありがとうございました！\n\nhttps://drive.google.com/file/d/1HNq5B7BPTCh1ptJoz9VZgWg5VVMpEbxT/view?usp=sharing", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuu_chibititi/works/120", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 89352, "client_id": 408354, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e6d1a580/uploads/origins/1fbc69b4-7c3a-4386-8714-5420160ce6e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=cb08e6d60923f7e1fba48b285a269030", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e6d1a580/uploads/origins/1fbc69b4-7c3a-4386-8714-5420160ce6e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8c7d4c265b3742d4e7a3166d2739c5c", "src_set": ""}, "body": "こんにちは！\n\nあなたの新しいキャラクター、マナを主人公にした作品をお願いしたいんです。\n\n彼女はとてもセクシーなので、巨大なモンスターと激しくハードコアなセックスをするところを見たいのです。そのモンスターは、とても大きければ何でもいいです（馬や悪魔など）。できるだけ大きくしてください。モンスターのチンコは、少なくともマナの胴体と同じ大きさでなければならないが、もっと大きくても構わない。\n\nマナはお腹をとんでもなく引き伸ばされた状態で犯されている。いくらクレイジーとはいえ、マナは飽くなきサキュバスのようで、もっともっととねだるエロティックな表情をしている。彼女の乳房はあちこちで揺れ動き、ミルクがものすごい勢いで吹き出す。やがてモンスターは大量にクンニし、マナの腹は妊娠しているように見えるまで膨れ上がる。マナのアソコは潮を吹く。\n\n昔のバチェと馬のアートやカンナとドラゴンのアートに似ているはずだが、できればもっと大きなモンスターで。\n\nおっぱいコキなどの追加シーンを希望される方のために価格を上げました。\n\nありがとうございました！\n\nhttps://www.pixiv.net/en/artworks/121944042", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuu_chibititi/works/119", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/291f266a/uploads/origins/119c1205-16e9-419e-90c0-5803b04d8164?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=bb5930cb9dbc0dec2192b951373507e0", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 89352, "client_id": 1182625, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 177, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yuu_chibititi/works/118", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 89352, "client_id": 53985, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0879c959/uploads/origins/df495288-f147-4eed-9661-fb8e9565573e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e381f3806e505ab9f638b476ce31d38b", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0879c959/uploads/origins/df495288-f147-4eed-9661-fb8e9565573e?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=5b8462794f90a60630607cec5abe9908", "src_set": ""}, "body": "お世話になっております、黒原レイです。\nもしよければ私のオリジナルキャラ「黒葉らいち」がドスケベウェディングドレスを着て、三人の花婿と新婚ラブラブえっちをしているイラストをお願いします。\n両側に立った二人の夫を手コキしつつ、もう一人を騎乗位で責めているような感じでお願いします。\nhttps://x.com/BlackRose_MMD2/status/1684563343363952641\n\nhttps://x.com/BlackRose_MMD2/status/1684563343363952641", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuu_chibititi/works/117", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/a75abfbd/uploads/origins/db63bbd0-a00e-4a1b-9219-e00be108bfe4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=03dc82e481e4f53550d3d359f5dcf42f", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 89352, "client_id": 1182625, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 160, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yuu_chibititi/works/116", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 89352, "client_id": 2488568, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/34939a1b/uploads/origins/916e6159-6899-4d11-aef6-1db1a42f8424?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ab22c7770390585317b0c35b7f87cfeb", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/34939a1b/uploads/origins/916e6159-6899-4d11-aef6-1db1a42f8424?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=74b3dcbd4aa382df194b40d3e46835c1", "src_set": ""}, "body": "こんにちは、私のキャラクター、ハニーをもう一度描いてもらえませんか？\nハートのネックレスと白いニーソックス以外は裸。男性の膝の上に座り、両手で携帯電話を持ち、子供向けビデオ（https://www.pixiv.net/artworks/112778809 のようなもの）を楽しそうに見ている。抜けた歯を見せて笑っている。男は詳しく見せる必要はない。彼は彼女とセックスしていて、彼女の両胸をつかんでいる。彼女の無邪気な表情と対照的に、胸を揉むのはかなり荒々しくしてほしい。\nありがとうございました。\n\nhttps://drive.google.com/drive/u/1/folders/16IPKiMP2Gioxb83qC3McYd-geWiyW7NQ", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuu_chibititi/works/115", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 89352, "client_id": 1118411, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/74773c7e/uploads/origins/a80fca43-6c06-4507-994d-8e70ebbc8c99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bbe171e21a34ccbd9916a03b61077e50", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/74773c7e/uploads/origins/a80fca43-6c06-4507-994d-8e70ebbc8c99?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=085f28cf7464a545912796f71d7db467", "src_set": ""}, "body": "また会ったね！\n\n私の羊の女の子が触手に孕まされるところを描いてくれませんか？彼女は触手の穴の中にいて、ザーメンまみれです。ザーメンがたくさん出るようにしてください！また、カウベルのついた首輪をしています。お好きなディテールを追加してください。\n\nありがとうございました！\n\n参考：https://drive.google.com/drive/folders/1tswHOPrvLRLi5eT-xSDkzhfj9QPJdc3G?usp=sharing", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuu_chibititi/works/114", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 89352, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a7a110c4/uploads/origins/d1e04250-3dc0-46e9-9a22-f30a44633cb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=381640ce74c328d7492edf88512fe2f8", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a7a110c4/uploads/origins/d1e04250-3dc0-46e9-9a22-f30a44633cb4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e0e0e4fb6b64b435b60dfa6e0de9d804", "src_set": ""}, "body": "以前こちら(https://skeb.jp/@yuu_chibititi/works/100)を頼んだ者です、デザインがめっちゃ好みだったので、\n前回と同じ子がお兄さんと一緒に露天風呂に入り騙されながら挿入され、胸を揉まれ過ぎて母乳が出たりや精液ボテになるまで中出しされ全身ドロドロになるまでしているのをお願いいたします", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuu_chibititi/works/113", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 89352, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/344a09f9/uploads/origins/fc62f465-67b7-4e5d-85ce-3662dd6f4322?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=61cc4c63beb342fa2c9e16a4522a03b9", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/344a09f9/uploads/origins/fc62f465-67b7-4e5d-85ce-3662dd6f4322?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=48b43c77b97ad2f9d4eb0dbec1e3504f", "src_set": ""}, "body": "この宇宙飛行士の女の子をもう一度描いてくれませんか？\nhttps://skeb.jp/@yuu_chibititi/works/103\n\n彼女は所属事務所に救出された。彼らはその生物をもっと研究したいと願っている。彼女は触手生物と一緒に裸でガラスの円筒に入れられている。彼女の手と胸はガラスに押しつけられ、落胆して外を眺めている。彼女の脚は生き物に飲み込まれ、さらに触手が彼女の腕、胴体、胸に巻きつく（https://www.pixiv.net/en/artworks/115577068 のように）。首には金属製の首輪があり、体の反応を測っている。手前には影のような人物やモニターが見える。\n\n2つのバージョンがある。最初のものでは、クリーチャーはおとなしく、彼女を直接襲っていない。\n\n2つ目のバージョンでは、科学者たちがわざと大きな音や光、電気で生き物を刺激する。それは彼女をより強く圧迫し、彼女の口とアソコに触手を挿入する。\n\nありがとう。", "nc": 185, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuu_chibititi/works/112", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 89352, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f246040c/uploads/origins/a26d62b7-1587-41b5-86f8-bfd695ecd149?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4d8224ceb84e5de09717949c75485b7a", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f246040c/uploads/origins/a26d62b7-1587-41b5-86f8-bfd695ecd149?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19a371e0eb0726bc74e3a55a3fa761d4", "src_set": ""}, "body": "バレンタインにちなんだ絵を描いてくれませんか？ねーたんとはなちゃんと一緒に。\nねーたんは小さな白いエプロン以外は裸で、泡立て器かヘラを持っている。はなちゃんは、赤いリボンをプレゼントのように巻いている以外は裸。胸にはチョコレートがついていて、ねえたんがそれを舐めあげている。\nありがとうございました。", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuu_chibititi/works/111", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 89352, "client_id": 2264792, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/273bb3e5/uploads/origins/6a91a63e-54a4-440b-82ad-441990e68dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=780313e5ea091c6b22f9a9510f7302e4", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/273bb3e5/uploads/origins/6a91a63e-54a4-440b-82ad-441990e68dbb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e90d2f87545ff73eedc108cf0551fe32", "src_set": ""}, "body": "描いてほしいのは、「あててのギャル」の藤ノ木寧々（ピンクの髪）。\n全裸でサウナに入って、楽しそうに笑っている。\n\nポーズや髪型はこれを参考にしてください（タオルは入れずに全裸です）https://1drv.ms/i/s!AoSz-gx1hbwFiIxkc5NS70IUVpv8ew?e=bevrnS。\nhttps://1drv.ms/i/s!AoSz-gx1hbwFh-s6XmzxoFqnzPx4vg?e=ey8P8Z このようなプロポーションにしてほしい。\nただし、必要であれば自由に調整してください。\n\n可能であれば、片方の乳房を手で持ち上げ、もう片方の手で下の汗を拭くバリエーションもお願いします。\nありがとうございました。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuu_chibititi/works/110", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/2ec4a75a/uploads/origins/3cb7fca0-3318-4f48-ad30-422956fc0744?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=05cbe38e1ede9037e2b8c6e1e8969154", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 89352, "client_id": 116715, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yuu_chibititi/works/109", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 89352, "client_id": 2629643, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/ce8607f6/uploads/origins/3695fd04-5c85-420c-a5c9-c88ffbe5bad8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5d12002a40ae96deb8d14cfe70de2c0f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/ce8607f6/uploads/origins/3695fd04-5c85-420c-a5c9-c88ffbe5bad8?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a75aafce8be73679e123e4fbf37ab0a9", "src_set": ""}, "body": "初めまして、モントブレチアと言う者です\nお見かけしてからご依頼してみたいと思い送らせていただきました\n\n キャラクター：シェスタ＆ステラ(オリジナルキャラクター)\n\n構図：立ち絵(全身)  \n\n背景：無し\n\n衣装\n[共通]\n牛柄のビキニ、長手袋、サイハイソックス(牛コス)\n\n[差分]\nシェスタ:牛柄のニプレス＆前貼り(ふたなり子なので)\n\nステラ:牛柄の極小マイクロビキニ(胸先が隠れるほどの面積)\n\n小物\n[共通]\nカウベル付きの首輪\n\n[差分]\n\nシェスタ:牛柄のtntnカバー、アナルプラグ(こちらは出来るのであれば)\n\nステラ:淫紋(こちらは差分時のみお願いします)\n\n胸の大きさ\nシェスタ:巨乳\nステラ:爆乳\n\n差分(巨乳症)\n\nシェスタ:爆乳(巨乳症)\n\nステラ:爆乳と超乳の中間(巨乳症＆サキュバス症)\n\nその他\nシェスタ:ふたなりですが袋は無く、竿のみ\n\nステラ:巨乳症＆サキュバス症時のみ淫紋があります\n\n※もしふたなりにご抵抗があるのなら無しでも構いません\n\n複雑なご依頼なのでご辞退なさっても構いません\n受けて頂ける場合、内容と割に合わないと思いならば再送をお願いします\n\n詳しい資料は下のURLからご確認ください\n\nhttps://x.com/nametake6025/status/1833133720594739308?s=46", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuu_chibititi/works/108", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 89352, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/33a983bb/uploads/origins/83cae942-9edb-4af3-9bb6-8a27a38932c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=885176b08ab663636ffa553b16bf57c7", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/33a983bb/uploads/origins/83cae942-9edb-4af3-9bb6-8a27a38932c7?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=70bc1d1409dd544f4b926fd660d90f63", "src_set": ""}, "body": "こんにちは！グランブルーファンタジーのヤイアとクムユのイラストをお願いします。\n-二人の女の子が横でパイズリをしています。\n-ヤイアは筋肉質でペニスが大きく見えやすい男性にパイズリをしています。彼女は嬉しそうに、そして興奮した表情をしている。\n-クムユは、胸の中に隠れている小さなペニスの弱い男にパイズリをしている。不満げな表情で、亞亞を羨ましそうに見ている。\n-背景はどうでもいいのですが、銭湯が似合いますね。\nありがとう！", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuu_chibititi/works/107", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/d3c154c8/uploads/origins/c06e04e3-7ebd-474c-b098-13ba20373161?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fd0c9e4991faf1a364561033aab47ad6", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 89352, "client_id": 1182625, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 32, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yuu_chibititi/works/106", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 89352, "client_id": 116715, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/b3729114/uploads/origins/f97a6c8b-50af-4cb2-912f-1169b582aa8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=976894b49341a90afe4af4d1aab7a003", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b3729114/uploads/origins/f97a6c8b-50af-4cb2-912f-1169b582aa8d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=3e030007243cc78f653a995ba28fc4b2", "src_set": ""}, "body": "ゆう様初めまして！VTuberのyoshino桜と申します！\nちっちゃくて可愛いイラストに惹かれリクエストに参りました！\n\nムチムチ爆乳なyoshino桜を描いていただきたいです！\n衣装は和風水着で、両手には1丁ずつハンドガンを持たせてください。\n髪型はセミロングかツインテールどちらかお任せします。\n表情はメスガキ感たっぷりのドヤ顔でお願いします。\nその他ポーズや背景はお任せします。\n注意事項としては体の特徴で人の耳はなく、狐耳がありますが尻尾はありません。\n\n完成品はpsd形式で背景やサインなどは別レイヤーもしくはファイルに分けていただけると大変助かります。\n宜しければ今後のVTuber活動において、SNSやYouTubeで告知画像や配信サムネに使用させて頂けたらと思います。\nご検討のほど宜しくお願い致します！\n\nhttps://x.com/VtuberYoshino/status/1665091170119335937", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuu_chibititi/works/105", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 89352, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9ded3ae6/uploads/origins/9f41e529-d02e-46aa-9bd4-90f72bdc0894?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=c6e579cd390515d0a03ab2e5f718bdaf", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9ded3ae6/uploads/origins/9f41e529-d02e-46aa-9bd4-90f72bdc0894?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=95a529d6f6764f3d429d3680d0b61d4b", "src_set": ""}, "body": "こんにちは、もしよろしければ、ハロウィンにちなんだねえたんとはなちゃんの画像をお願いしたいです。ハロウィンまでに完成する必要はありません。\nねーたんはセクシーなヴァンパイアの格好をして、赤と黒のマントを着て、小さな黒いパンティ（https://www.pixiv.net/artworks/8390303 のようなもの）をはいています。花ちゃんはミイラのコスチュームを着て、包帯で乳首と股間を覆っている（https://www.pixiv.net/artworks/93755209）。腕は頭の上で縛られている（https://www.pixiv.net/artworks/93824911）。\n2つのバージョン：\n1.ねーたんが遊び半分に首筋にキスし、胸を揉む(https://www.pixiv.net/artworks/99649926)。花ちゃんはくすぐったくて嬉しそう。\n2.ねーたんはもっと真剣に、唾液を垂らしながら首筋に吸い付く。包帯の下から花ちゃんのアソコに指を入れる（https://www.pixiv.net/artworks/103757007）。乳首からミルクが吹き出し、股間が濡れてきて、花ちゃんは興奮しているようだ。\n\nもちろん、構図や衣装など、自由に改変していただいて結構です。\nありがとうございました。", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuu_chibititi/works/104", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 89352, "client_id": 408354, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d2560964/uploads/origins/1638726c-5567-4588-8cfb-e6db487a4c05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a97ccf4847ae3caa9c7384c31d006549", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d2560964/uploads/origins/1638726c-5567-4588-8cfb-e6db487a4c05?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e87ca56c7c84221bff3021ee68adc542", "src_set": ""}, "body": "ネルコとブラックリバーのセックスシーンを描いてください。これらはアーティストSlugboxのものです。\n\n二人の姉妹が触手に犯されながらセックスしている。2人は完全にお互いに夢中になり、キスし、こすり、しゃぶり合っている。二人がセックスしている間、巨大な触手が二人の穴を犯す。触手は巨大で太いので、彼女たちの腹を大きく引き伸ばす。触手は大きすぎて女の子に入らないようなので、たくさん伸ばしてあげてください。乳首も犯される。\n\n二人ともカーヴィーだが、ネルコは少し太っているので、お腹を丸く、胸とお尻を大きくしてあげよう。ブラックリバーの逆さ乳首にも注目して。二人とも平均より大きな乳首でとても肉付きがいい。\n\n両姉妹はイクとミルクを撒き散らし始める。触手が中に大量に射精し、女の子のお腹を大きくして妊娠しているように見せる第2バージョンも入れてください。とても過激にしてください！彼女たちは大きなモンスターとのラフなセックスに慣れている。\n\nありがとう！\n\nhttps://www.dropbox.com/scl/fo/rx2et8027kizg59lwkwhf/h?rlkey=k92q4mokbfrhrunwe77rcj4qn&st=csvidoyr&dl=0", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuu_chibititi/works/103", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 89352, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d3f478be/uploads/origins/84309e6a-30f3-4d11-be7c-97bd00fd8643?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=eee3a2383fb2657d5617571471171c49", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d3f478be/uploads/origins/84309e6a-30f3-4d11-be7c-97bd00fd8643?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=fd77d3176391571212649792f553997f", "src_set": ""}, "body": "こんにちは、宇宙飛行士の女の子をもう一度描いてもらえませんか？触手の穴で「バッドエンド」のシナリオ。ポーズ：https://www.pixiv.net/artworks/102035766#4。手足を拘束された全裸で、穴の壁の中。正面から見て胸にフォーカス。\n\n違いがある画像。徐々に興奮し、敗北しているように見える。\n鋭い触手が乳首に突き刺さる。乳房がわずかに膨らみ（それほど大きくはない）、ミルクが漏れる。触手が乳房を何度も深く包み込み、ミルクが吹き出す（https://www.pixiv.net/artworks/83290969#3）。太い触手が股間を覆う(https://pixiv.net/artworks/72726664#2)。口に触手が挿入される。\n\n触手が乳を搾り出す。片方の乳房が大きな触手に掴まれる(https://pixiv.net/artworks/95698048)。もう片方の乳房は先端に透明な球根があり、触手が乳房と乳首を圧迫している(https://www.pixiv.net/artworks/77194595)。\n\n触手が彼女の目を覆い、シーンは暗くなる。\nありがとう。\n\nhttps://yuu.fanbox.cc/posts/8143343", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuu_chibititi/works/102", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 89352, "client_id": 854183, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/56178340/uploads/origins/68769545-f77b-44e2-92fe-5308163ae629?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4e94766703f3a86e4483bbefe26a60bb", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/56178340/uploads/origins/68769545-f77b-44e2-92fe-5308163ae629?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=1f909efe82843ed85a7b5783a6da937b", "src_set": ""}, "body": "ゆうさん、はじめまして。\n貴方の素敵な作品を拝見しぜひリクエストしたく思いましたので、以下の内容で依頼を出させていただきます。\nお眼鏡に適えばご対応いただけると幸いです。\n\n＜依頼概要＞\n上半身裸の巨乳少女のイラストを描いてください。\n\n＜キャラクター＞\n「田舎の男勝りな巨乳の少女」を、ゆうさんのセンスで作成してください。\nキャラクターのイメージは以下の通りです。\n・年齢は10歳ぐらい。\n・この半年ほどで胸のサイズが急成長して、片側だけでも頭ぐらいの大きさになっている。\n　外で遊び回るせいで、すでに少し垂れ気味になっている。\n・若者の少ない田舎住みのため年の近い友達は男子しかおらず、男勝りな性格に育った。\n・その男友達も数ヶ月前に引っ越してしまい、同じ小学校の生徒はこの少女1人だけになっている。このためか、あまり羞恥心がない。\n・髪は黒のベリーショートヘア。\n\n＜作品のシチュエーションなど＞\n・「親戚の大学生の青年が遊びに来たので、青年と一緒に女の子が川遊びをしていた」というシチュエーションでイラストを作成してください。\n・女の子は川遊びの休憩中で、川沿いで一休みしている。\n・女の子は白色のパンツのみ身につけた状態。パンツは濡れて肌に張り付いている。\n・女の子は仰向けに寝転がっていて、乳房は投げ出されたように左右に垂れている。\n・女の子は「久しぶりに一緒に遊ぶ相手がいてうれしい」「最近体が重くて前より疲れやすい」旨の話を青年としている。\n　可能であれば、会話している台詞を画面内に描いてください。\n・青年は画面内に描かれなくて問題ありません。女の子をメインに描いてください。\n\n＜備考＞\n・細かい部分は、ゆうさんの描きやすいように多少改変していただいても結構です。\n\nご検討いただけると幸いです。\nよろしくお願いします。", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuu_chibititi/works/101", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/8dc50df9/uploads/origins/9e19fe41-60ec-487e-bdd9-915e3827b215?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=059c4722987a8138780e7b695da19f29", "src_set": ""}, "private": true, "genre": "art", "tipped": true, "creator_id": 89352, "client_id": 1182625, "vtt_url": "", "thumbnail_image_urls": null, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": null, "body": "", "nc": 161, "word_count": 0, "transcoder": "", "creator_acceptable_same_genre": false}, {"path": "/@yuu_chibititi/works/100", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 89352, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/67ca90e8/uploads/origins/9ae3ae92-d331-489c-9ed6-fa3d869e6859?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5c4e4c45f9115811bced0c5defa57afe", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/67ca90e8/uploads/origins/9ae3ae92-d331-489c-9ed6-fa3d869e6859?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=4a1daaeec4a53297665485c0ba2b7b8b", "src_set": ""}, "body": "性知識の無い背中まである黒髪ロング紫目でお尻大きめの美脚の小学生ぐらいのロリ爆乳っ子が黒パンスト直履き姿で何度も中出しされ、ハート目アヘ顔で潮吹きしているのをお願いいたします", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuu_chibititi/works/99", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 89352, "client_id": 1118411, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2c22c4e5/uploads/origins/1c78c16c-f119-4805-a1ff-53da7d45d3e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=553b2a1b0459bb202dbd4c1a95844354", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2c22c4e5/uploads/origins/1c78c16c-f119-4805-a1ff-53da7d45d3e5?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ae9769eec5e4dbc49d7756836c3887f9", "src_set": ""}, "body": "また会ったね！\n\nあなたのスタイルで私のキャラクターの参考シートを描いてもらえますか？\n前回のリクエストで使っていただいたプロポーションが大好きです。\n\n参考：https://drive.google.com/drive/folders/1HPOvYeq2mq5UtA8xYKJB1jPxvxCGg6NC?usp=sharing\n\nありがとうございます！", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuu_chibititi/works/98", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 89352, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/683546c7/uploads/origins/aff981b8-b5d2-464d-9928-c42c1a6c8322?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a78749d3187dd3d422efeb68cc69109d", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/683546c7/uploads/origins/aff981b8-b5d2-464d-9928-c42c1a6c8322?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a03d09b81f5947491f3fb8b5c06f6a1f", "src_set": ""}, "body": "こんにちは、前回のかわいい宇宙服の女の子の続編を描いてくれませんか？\n異星で、触手の生えた生き物に出会います。触手だけが出ていればOKで、細かい背景は必要ありません。彼女の手足を拘束し、宇宙服の下に触手を侵入させる。触手はアソコ、ケツ、そしてヘルメットの下の口に挿入される。胸も保護ガラスの下で触手に乱暴に揉みしだかれる。\nありがとうございました。\n\nhttps://www.fanbox.cc/@yuu/posts/7501209", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuu_chibititi/works/97", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 89352, "client_id": 1455173, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/130f0a7f/uploads/origins/cbbecf48-042d-4789-b9d4-a6086b85ea22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=25940045d0b2cf518c783e75f8e984ca", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/130f0a7f/uploads/origins/cbbecf48-042d-4789-b9d4-a6086b85ea22?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9f9d56449f466c16854d7b68e517b6e0", "src_set": ""}, "body": "初めまして、絵柄とおっぱいがすごく好みだったので依頼しました\nhttps://www.pixiv.net/artworks/113140017\nこのイラスト(1枚目)の女の子のぷっくり乳頭の両乳首とお臍が拡張されてぽっかり穴になっているイラストをお願いします\nぷっくり乳首参考画像\nhttps://www.pixiv.net/artworks/107082787\n右側の乳首は乳栓(極太バイブ)を乳腺の奥まで詰めて、拡張された左側の乳首は大きく口を開いて内側を見せつける感じ、お臍もぽっかりと拡張してください\nhttps://www.pixiv.net/artworks/79237079#manga\n上のイラストくらいバイブ挿入してほしいです\n乳首の内側は綺麗なピンク色で膣のように愛液たっぷりでお願いします\nアングルはやや正面で左側の乳首が正面になる(サ参考画像と同じアングル)、両胸を両手の平で持ち上げ、恥ずかしそうな笑顔でこちらを誘惑する\n服装は2枚目の巫女服っぽい衣装(ノーパンノーブラ)で服の上からでも拡張済みと分かるくらい(体液で濡れる2箇所とプラグが主張している感じ)、差分で着衣、胸露出、裸、右胸の断面をお願いします\n背景は和風な寝室\nセリフで｢おっぱいとおへそ…どちらのおまんこを使ってくれますか？♡｣みたいなセリフをお願いします\n背景とセリフは無しでも構いません。\n胸は好みでしたら2周り程大きくても大丈夫です\n長文申し訳ありません。", "nc": 48, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuu_chibititi/works/96", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 89352, "client_id": 1118411, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6b0791d9/uploads/origins/5ad93feb-f22e-4117-a770-ea9a4fd7d839?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=59c4829dd6e7d613f490f4d8b874dfab", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6b0791d9/uploads/origins/5ad93feb-f22e-4117-a770-ea9a4fd7d839?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e2e78074808fc475b8f0571a905c3398", "src_set": ""}, "body": "こんにちは！僕は君のスタイルの大ファンなんだ。\n\n私の羊の女の子を描いてくれませんか？\n巨乳で子宮のタトゥーがあるロリです。\nオオカミとセックスしている彼女を描いてください！\nまた、ザーメンをたくさん出してください！\n\n参考：https://drive.google.com/drive/folders/1HPOvYeq2mq5UtA8xYKJB1jPxvxCGg6NC?usp=sharing\n\nありがとうございました！", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuu_chibititi/works/95", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 89352, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/7142b947/uploads/origins/c107ee95-489e-43c3-b936-d0623f258813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=b25b554e171a4b228218fee7c369ba15", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/7142b947/uploads/origins/c107ee95-489e-43c3-b936-d0623f258813?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=90c1fd584bbdfc655b4b1348d28fecf5", "src_set": ""}, "body": "こんにちは、もしご興味があれば、花ちゃんとねえたんを主人公にしたイースターをテーマにしたリクエストがあります（イースターまでに完成させる必要はありません）。花ちゃんは裸で大きなイースターバスケットの中に座っているか、ひざまづいています。フェイクの芝生とペイントされたイースターエッグが、彼女の周りのバスケットを満たしている（https://st.depositphotos.com/1606640/4727/i/950/depositphotos_47276261-stock-photo-colorful-easter-basket-with-plastic.jpg）。ねーたんはイースターバニーのキグルミを着ている。彼女は花ちゃんの胸にイースターエッグの模様（https://twitter.com/lewdamone/status/1378799569622958084 のように、どんな模様でもいい）を描いている。片方の胸はすでに完全に塗られている。ねーたんはもう片方の胸を持ち上げて（https://www.pixiv.net/artworks/39574927 のように）ペイントしている。\n\nもちろん、あなたが望むなら、どんな要素でも自由に修正してください（構図、衣装など）。\nありがとうございました。", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuu_chibititi/works/94", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 89352, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/c44c10df/uploads/origins/1c5ca54f-4fa3-4582-9e3c-7f43dcd8a192?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=def141e3597b693b290a9662bda3969f", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/c44c10df/uploads/origins/1c5ca54f-4fa3-4582-9e3c-7f43dcd8a192?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=22c5c3f81a28dffffb34bd5a9d334a4f", "src_set": ""}, "body": "こんにちは！\n\nうちのキツネの紅葉の写真を見てみたいです。https://static.f-list.net/images/charimage/32179617.png\nこんなポーズで https://i.imgur.com/xEuna7h.jpg\n\n紅葉はもっと背が低いので、多少の変更が必要かもしれません！\n\n柔らかく、遊び心のある表情がベストです。\n\n衣装も一部使用可能です！お直しや自作はご自由にどうぞ。\nhttps://static.f-list.net/images/charimage/32179619.png", "nc": 49, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuu_chibititi/works/93", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 89352, "client_id": 0, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a92dc1b/uploads/origins/3ab51ca7-9bab-49e0-9e51-630929cd4fbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=908807b1fa9e17852440f1c93edaa793", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a92dc1b/uploads/origins/3ab51ca7-9bab-49e0-9e51-630929cd4fbc?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ffa7025afc3a3d4ae65d0fcd56342e3d", "src_set": ""}, "body": "はじめまして。\n\nポケモンのリイリエとミヅキをロリ爆乳でお願いしたいです。ミヅキがリイリエのおっぱいを測りながら、パンツ一丁の二人を見てみたい。ミヅキは新しいサイズを読みながら感心した様子だ。リイリエは自分の胸が大きくなったことに誇りと興奮で顔をほころばせる。ミヅキよりずっと大きい。\n\nありがとうございます！\n\nhttps://www.deviantart.com/64smashmaster3ds/art/Pokemon-Sun-and-Moon-Lillie-and-Selene-825850853", "nc": 184, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@yuu_chibititi/works/92", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 89352, "client_id": 320271, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/8d41a501/uploads/origins/00805078-d784-44c6-87de-1e9ff9336769?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=ef5a18bf3ee872f5dde19c80fc37f4f1", "src_set": ""}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8d41a501/uploads/origins/00805078-d784-44c6-87de-1e9ff9336769?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b57a154cf9aea05b1dcf96548d22fa22", "src_set": ""}, "body": "https://skeb.jp/requests/1018394\n\nこのシリーズのキャラクターで後続作をリクエストします。\n自由にお願いします", "nc": 177, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "similar_creators": [{"id": 11016, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "天漸 雅", "screen_name": "tenzenmiyabi", "avatar_url": "https://pbs.twimg.com/profile_images/1035459061418881024/aUNJXvah.jpg", "header_url": "https://pbs.twimg.com/profile_banners/84584477/1635930643/1500x500", "appeal_receivable": false, "popular_creator_rank": 