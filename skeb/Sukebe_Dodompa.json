qXfUw?rlkey=5z14ymx6n71m6z3frr20imj5v&st=6mzkay85&dl=0", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sukebe_Dodompa/works/9", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2255542, "client_id": 88626, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/9f34a3e8/uploads/origins/add063d1-cf4c-4442-97c7-af392f8eeffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65942cfbb5a5d0cd432b38fdac37a9ad", "srcset": "https://si.imgix.net/9f34a3e8/uploads/origins/add063d1-cf4c-4442-97c7-af392f8eeffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=65942cfbb5a5d0cd432b38fdac37a9ad, https://si.imgix.net/9f34a3e8/uploads/origins/add063d1-cf4c-4442-97c7-af392f8eeffa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=9bf5c2bf707bce06b20fd03694fa5baf 2x, https://si.imgix.net/9f34a3e8/uploads/origins/add063d1-cf4c-4442-97c7-af392f8eeffa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0658137afd711c14dd059bc7385f1daa 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/9f34a3e8/uploads/origins/add063d1-cf4c-4442-97c7-af392f8eeffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=397356c9d144a7492b9fc2518f774720", "srcset": "https://si.imgix.net/9f34a3e8/uploads/origins/add063d1-cf4c-4442-97c7-af392f8eeffa?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=397356c9d144a7492b9fc2518f774720, https://si.imgix.net/9f34a3e8/uploads/origins/add063d1-cf4c-4442-97c7-af392f8eeffa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=5113068e60fe6f3238f2c89494a3d82f 2x, https://si.imgix.net/9f34a3e8/uploads/origins/add063d1-cf4c-4442-97c7-af392f8eeffa?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=967a6fae9d42ab25eca00f7c7ccef5d5 3x"}, "body": "こんにちは！偶然白濁んぱさんの同族化作品を見て、とても良かったので私も似たようなものをお願いしたいと思いました！\n\nできれば、私の二人のキャラクター、「エルザイム」と「ルモ」の二人がこの作品（https://skeb.jp/@Sukebe_Dodompa/works/6）のようにヤマオさんの同族で同族化したイラストをお願いします！\n\n二人はヤマオさんに吸収された後、同族になってきた状況です！\n種族と肌の色、そして性別はすべてヤマオさんと同じになり、この作品（https://skeb.jp/@Sukebe_Dodompa/works/6）で同族化したキャラクターのように、軽い筋肉と性器、そしてヤマオさんの耳ができた状態です！ （エルザイムの場合、もともと女性でしたが、同族化以来男性になったことをお願いします！）また、余談ですが二人の肌や目の色や柄などはいずれもヤマオさんと同じになりますが、髪型と髪の色は人間だった時のものを保つ方向にお願いしたいと思います！\n\nポーズの場合、二人が一緒に淫らなポーズでヤマオさんが眺める中、ヤマオさんに対する感謝と服従を誓う感じで、おまかせでお願いします！\n\n差分の場合、可能であれば二人の洗脳前後が連想される恥ずかしい表情と幸せな表情の二つを見たいです！\n\n最後に、各キャラクターの資料です！\nエルザイム：https://drive.google.com/drive/folders/1qKmFo7N5TpAV8_1Og5nbzgw9Z7JFiXsR?usp=sharing\nルモ：https://drive.google.com/drive/folders/1HdGOMk8zXpUHg-7xz4LB93DaRAxd1yKh?usp=sharing\n\n今回の状況では服装はないと思いますので、服装は無視していただき、ヘアスタイルと髪の色程度だけ確認していただければと思います！ \n\n確認していただきありがとうございます！できればありがとうございます、よろしくお願いします！", "nc": 57, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Sukebe_Dodompa/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2255542, "client_id": 22082, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/116d5288/uploads/origins/ba74da42-6e5f-4348-9a15-651abc071d29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=098b80050145f6cb60b822a27b3eec1e", "srcset": "https://si.imgix.net/116d5288/uploads/origins/ba74da42-6e5f-4348-9a15-651abc071d29?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=098b80050145f6cb60b822a27b3eec1e, https://si.imgix.net/116d5288/uploads/origins/ba74da42-6e5f-4348-9a15-651abc071d29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=72229f9a25e8c537844b791b342b14b5 2x, https://si.imgix.net/116d5288/uploads/origins/ba74da42-6e5f-4348-9a15-651abc071d29?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=c