ads/origins/8518c1c4-58c5-4c3a-ad18-4376524d1dd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2dee80af4ddd8772d7991e3a8c91e59a 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/562c3d3b/uploads/origins/8518c1c4-58c5-4c3a-ad18-4376524d1dd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e70c8f760048c9957c9b7542f27997ca", "srcset": "https://si.imgix.net/562c3d3b/uploads/origins/8518c1c4-58c5-4c3a-ad18-4376524d1dd9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e70c8f760048c9957c9b7542f27997ca, https://si.imgix.net/562c3d3b/uploads/origins/8518c1c4-58c5-4c3a-ad18-4376524d1dd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=6aec461ae10b9cbf4a33a21aacaff77d 2x, https://si.imgix.net/562c3d3b/uploads/origins/8518c1c4-58c5-4c3a-ad18-4376524d1dd9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f71e05fa777bd4ac03cd17f3ab225740 3x"}, "body": "じゃむ様\nはじめまして！なべぞこと申します。\n\nじゃむ様をXでお見かけした際、色の使い方光の入れる配色１つ１つが素敵でとても大好きと思いこの度はこちらでリクエストいたしました！\n\nこの子は私のOCで今後IRIAMというアプリで使用する予定です。\n\n▪️キャラ\n猫耳と尻尾が生えたミルクティーベージュと茶色の間ぐらいの頭にぴょことアホ毛が一本生えたふわふわ癖毛の女の子。\nイメージカラーはオレンジ。\n\n▪️衣装・ポーズ・構図\n資料を添付いたします。\n服や装飾は省いていただいてもお好きにアレンジして頂いても問題ございません。\nじゃむ様の思うままに描いて頂けたら幸いです！\n構図等もお任せいたします。\n\n▪️使用用途\nXやIRIAMのアイコン\nIRIAMでデビューした後のアクキーやデジタルクッズに使用する予定です。\n描いて頂いたイラストを加工はいたしません。\n今後配信用アカウントを作成した後、使用させて頂く際は必ずメンションいたします！\n\nご検討頂けますと幸いです。よろしくお願いいたします！\n\nhttps://drive.google.com/file/d/17MC52Rgp6OcNYJZvXPJENjP3EHjBVjjs/view?usp=drivesdk", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@jam_486/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3301201, "client_id": 2196662, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0adbb83b/uploads