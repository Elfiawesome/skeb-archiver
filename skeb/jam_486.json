段はうさぎのぬいぐるみになっているのですが、\n今回は人間モードということで…！\n\n服装はこちらのままでも、描きやすいようにアレンジしてしまっても、\nお好みでお願いできたらと思います！\nご縁がありましたらよろしくお願いいたします。", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 121519, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "まち Skeb募集中", "screen_name": "suamachi", "avatar_url": "https://pbs.twimg.com/profile_images/1722227277088649216/GNeUVkCl.jpg", "header_url": "https://pbs.twimg.com/profile_banners/4638436723/1770435648/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 144}, {"id": 1325685, "creator": true, "nsfw_acceptable": false, "acceptable": true, "name": "ねむも", "screen_name": "nemumo0", "avatar_url": "https://pbs.twimg.com/profile_images/1628491403100852224/E5GdjoBx.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1391478831731462146/1641294066/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 90, "skills": [{"genre": "art"}, {"genre": "novel"}, {"genre": "correction"}], "nc": 24}, {"id": 1397781, "creator": true, "nsfw_acceptable": false, "acceptable": false, "name": "ナガサキ", "screen_name": "osushi_kome", "avatar_url": "https://pbs.twimg.com/profile_images/1726889238384570368/T4nw0-yZ.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1331503373980319747/1623168124/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 90, "skills": [{"genre": "art"}],