%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=f8920b8ab6a3a765c6b9b836c727b776 3x"}, "body": "ふゆま先生\n\n度々のリクエスト、恐縮です。\n先生の絵柄が大好きになってしまいましたので、\nまたリクエストさせていただきます。\n\n以前からお願いさせていただいているvtuberさんが、\nこの度2月1日でデビュー1周年を迎えるため、そのお祝いファンアートを贈りたく、\n描いていただけないでしょうか？\n\nhttps://twitter.com/AmehokiYuki\nhttps://twitter.com/AmehokiYuki/status/1421696835131875335\nhttps://twitter.com/AmehokiYuki/status/1474545428129529859\n\n先生のセンスは信頼しておりますので、今回はポーズ、構図、その他諸々はお任せいたします。\n出来るだけ盛大なお祝いの主役として描いていただければ幸いです。\n\n一点だけお願いがあるとすれば、\n｢2022年2月1日｣の日付を書いていただき、\n｢1st Anniversary｣｢祝一周年｣など、一周年記念であることを明記していただければありがたいです。\n\nなお、今回もファンアートとしてプレゼントしたいので、\n配信・サムネ・Twitter等で使用されることをご了承ください。\nまた、サムネイル等の素材として使えるよう、\n本人部分のみの透過素材もご用意いただけると、ありがたいです。(PSDなど)\n\n※追伸※\n以前まで、私の名前もイラスト上に記載いただいておりましたが、\n今回は贈る意味合いが強いので、無しでお願いしたいです。\n\n※追伸2※\nサプライズ的に贈りたいので、仮に早く完成していただいても、\nTwitterなどで納品発表をいただくのは、2月1日の2～3日前に\nしていただけないでしょうか？\n\nよろしくお願いいたしますm(*_ _)m！\n\nhttps://twitter.com/AmehokiYuki", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@on_you_r_side/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1028791, "client_id": 1601170, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3f78658d/uploads/origins/21422b7f-00d9-42b1-87ab-71793475b2d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23adad83ec30fafc4757a4b242590d39", "srcset": "https://si.imgix.net/3f78658d/uploads/origins/21422b7f-00d9-42b1-87ab-71793475b2d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=23adad83ec30fafc4757a4b242590d39, https://si.imgix.net/3f78658d/uploads/origins/21422b7f-00d9-42b1-87ab-71793475b2d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=ad9d15044ec2965a269012857841cca3 2x, https://si.imgix.net/3f78658d/uploads/origins/21422b7f-00d9-42b1-87ab-71793475b2d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6df56561079e2022340f3902f01c451f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3f78658d/uploads/origins/21422b7f-00d9-42b1-87ab-71793475b2d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0c6a983abdaf110dcbcf4dec98f896a", "srcset": "https://si.imgix.net/3f78658d/uploads/origins/21422b7f-00d9-42b1-87ab-71793475b2d9?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a0c6a983abdaf110dcbcf4dec98f896a, https://si.imgix.net/3f78658d/uploads/origins/21422b7f-00d9-42b1-87ab-71793475b2d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=85e7d6c8271de6e3f2de68230445716e 2x, https://si.imgix.net/3f78658d/uploads/origins/21422b7f-00d9-42b1-87ab-71793475b2d9?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=cc03741c52a9c062109b1d84ee8702b6 3x"}, "body": "ふゆま先生\n\n先日来、ファンアートを描いていただき、ありがとうございます！\n先生の絵柄、大変気に入り、ファンになりました。\nついては、また描いていただきたいな、と思いまして…。\n\nまた同じ子の絵で恐縮なのですが、今回は私の性癖ド真ん中でリクエストさせていただきます。\n\n※前回までと同じ参考資料ですが、念の為に添付いたします。\nhttps://twitter.com/AmehokiYuki\nhttps://twitter.com/AmehokiYuki/status/1421696835131875335\n\nお願いしたい絵というのは、端的に言えば\n｢色気と愛情の圧｣\nを感じさせるイラストです。\nさらに言い換えてしまえば、ヤンデレです。\n\n私が今まで一番｢色気と愛情の圧｣を感じたのは、こちら(↓)のイラストです。\nhttps://images.app.goo.gl/GE789t936VywtKrP9\n［恋愛シンドローム］佐久間まゆ+\n\nこの構図、ポーズ、衣装等が良いという訳ではなく、\n私の感覚を共有していただきたいな、という思いで、上記イラストを掲示しました。\n\n衣装はデフォルトのものでもいいかな、と思っていますが、\n基本的に先生の思う｢色気と愛情の圧｣を表現していただければ結構です。\n先生が必要とお感じであれば、アクセサリーを外したり、衣装を大幅に変化させても結構です。\nただ、15禁以上になりそうなセンシティブな表現はおやめいただければ幸いです。\n\n今回は私の趣味全開のため、私のデスクトップ壁紙に使いたいと\n考えておりますので、アスペクト比１６：９くらいで\n収めていただけると助かります。\n(もし違っても、こちらで位置調整で対応しますので、深く気にされないでも結構です)\n\nなお、今回もFAとしてプレゼントしたいので、配信・サムネ・Twitter等で使用されることを\nご了承ください。\nまた、サムネイル等の素材として使えるよう、本人部分のみの透過素材もご用意いただけると\nありがたいです。\n\nお忙しいところに度々のリクエストで恐縮ですが、よろしくお願いいたします！\n\nhttps://twitter.com/AmehokiYuki", "nc": 128, "word_count": 0, "transcoder": 