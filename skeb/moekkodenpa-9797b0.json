が、可能であれば全体が好ましいです…\n\n表情…下舐めずり((SDも同様))\n\n〜希望蘭〜\n\n①等身と、SDどちらも描いて欲しいです。\n\n②可能であれば等身キャラとSDの別レイヤー差分もあると嬉しいですm(_ _)m\n\n完成したイラストはA4サイズにプリントして飾りたいと思っております…！\n\nそれと〜、、獣人化ルチアの髪色なのですが、\n【以前描いて頂いた髪色】か【橙色寄りの茶髪】どちらかで迷っておりまして…\nどちらの髪色にするかはもえ電様にお任せしてもよろしいでしょうか…？\n((もえ電様の配色は本当に神掛かっているので、どちらでも構いませんm(_ _)m))\n\n久しぶりのご依頼にドキドキしておりますが、どうかよろしくお願いいたします…m(_ _;)m", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@moekkodenpa/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 221038, "client_id": 1019916, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e537aa77/uploads/origins/83263140-51eb-422e-9cd7-6cf75047e44a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2da707ccb7d69e18e5567431c196e358", "srcset": "https://si.imgix.net/e537aa77/uploads/origins/83263140-51eb-422e-9cd7-6cf75047e44a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2da707ccb7d69e18e5567431c196e358, https://si.imgix.net/e537aa77/uploads/origins/83263140-51eb-422e-9cd7-6cf75047e44a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=6f193791ef3fff66671987f67e482d0e 2x, https://si.imgix.net/e537aa77/uploads/origins/83263140-51eb-422e-9cd7-6cf75047e44a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=192f614a124eec4705ae48b6d3a138ed 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e537aa77/uploads/origins/83263140-51eb-422e-9cd7-6cf75047e44a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45f8f95dc5c5fd9a84babbd3dad44530", "srcset": "https://si.imgix.net/e537aa77/uploads/origins/83263140-51eb-422e-9cd7-6cf75047e44a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=45f8f95dc5c5fd9a84babbd3dad44530, https://si.imgix.net/e537aa77/uploads/origins/8