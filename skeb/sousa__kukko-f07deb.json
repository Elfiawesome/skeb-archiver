55-ad7a-a7813446d775?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=5fa067fc14baf70019c5b4e36c84921a, https://si.imgix.net/b05282f5/uploads/origins/16bdbf33-2058-4155-ad7a-a7813446d775?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=73149a92de208737e24c047270b0b329 2x, https://si.imgix.net/b05282f5/uploads/origins/16bdbf33-2058-4155-ad7a-a7813446d775?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f743e642851c2d9e7fb4f9cdfef0da5 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b05282f5/uploads/origins/16bdbf33-2058-4155-ad7a-a7813446d775?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5cc8495ec8587458fc54d14a4e188c2", "srcset": "https://si.imgix.net/b05282f5/uploads/origins/16bdbf33-2058-4155-ad7a-a7813446d775?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=d5cc8495ec8587458fc54d14a4e188c2, https://si.imgix.net/b05282f5/uploads/origins/16bdbf33-2058-4155-ad7a-a7813446d775?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=3a50507f0c2c0de32da319c70cf0bc71 2x, https://si.imgix.net/b05282f5/uploads/origins/16bdbf33-2058-4155-ad7a-a7813446d775?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=469bb3dec6b9a2c378d7dfdb004f4d0e 3x"}, "body": "壽 様\nいつもお世話になっております、なっちです。\n手数料無料の機に乗じてぜひ今回の依頼物を壽様にお願いしたい…と思い参りました次第です。\n\n・某シナリオにて使用したオリジナルキャラクター2人を描いていただきたいです。\n①犬\n名前は「ポチ」。自身をニアの母と名乗っているが、ラブラドールレトリバーの覆面を被った立派な不審成人男性。明るくキャラキャラとした挙動ながらも、ニアが不安を感じたり危険の及ぶような事があれば冷静かつ優しく諭す一面を持ち合わせる。ニアを一番に尊び愛してくれる存在。\n②猫\n名前は「金子 爾愛(ｶﾈｺ ﾆｱ)」。ポチからはニアと呼ばれている。表情が乏しく警戒心の高い性格ながら、彼との交流で少しずつ笑顔を見せるようになった。ポチに抱きしめられるのが好き。\n\n・ポーズや構図、イラストの形式等も全てお任せします(1枚絵でもおモチでも！)。二人が笑顔で一緒にいる様子を描いてほしいです。\n・使用用途も特に決めておりませんが、頂いたものによっては個人での利用に留めたグッズ化を検討する可能性もございます。\n\n・参考資料は以下URLよりご確認ください。なおリンク先はシナリオが特定可能な情報が記載されています、あらかじめご了承ください。\nht