-8fa1-89a31460d090?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=dcf0f5c627b6a7ae9f82e56f0a192cc3 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8ad75896/uploads/origins/0e66dde8-931d-40a5-8fa1-89a31460d090?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b43be28225280924d2c11a2849248ecd", "srcset": "https://si.imgix.net/8ad75896/uploads/origins/0e66dde8-931d-40a5-8fa1-89a31460d090?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b43be28225280924d2c11a2849248ecd, https://si.imgix.net/8ad75896/uploads/origins/0e66dde8-931d-40a5-8fa1-89a31460d090?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=c13779dae421d0102c4d29e85071242e 2x, https://si.imgix.net/8ad75896/uploads/origins/0e66dde8-931d-40a5-8fa1-89a31460d090?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5d2bbd80ec5a4254c5f7aeb68731e8db 3x"}, "body": "はじめまして、むちぱん先生\n以前の月ノ美兎電車痴漢のイラストを拝見して、自分もリクエストしたいと思いました。\n\nキャラクター：月ノ美兎\nコスチューム：デフォルトの制服とロングヘアー\n\nシチュエーション：電車に乗っている時に、見知らぬ男子学生から痴漢を受ける月ノ美兎。騒ぎを起こしてテストに遅れたくないので無視していたが、パンツを下ろされ、背後から挿入され立ちバックでレイプされ、膣内射精される。\n\n構図：https://www.pixiv.net/artworks/29204830\nでお願いします。特にスカート、パンツは構図のような感じでお願いします。\n画像では左手で吊革を持ち、右手に物を持っていますが、ここらへんは書きやすいように改変してくださって構いません。\n背景は簡素なもので大丈夫です。\n\nイラストは2枚でお願いします。\n①性行為中\n男子学生は夢中になって腰を振っている。\n美兎は無反応だが、心の中で\n（電車内でセックスとか頭おかしいだろ・・・）\nと思っている。\n②膣内射精\nそのまま男子学生は美兎の膣内に射精。\n美兎は相変わらず無反応だが、心の中で\n（中に出しやがった・・・）\nと思っている。\n\nどうかよろしくお願いします。", "nc": 40, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@noah129999/works/10", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 479843, "client_id": 370746, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/50cac838/uploads/origins/99fc1f60-00db-48a3-b0be-192b59a814c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=391a290766625776ec94fd076a7baeab", "srcset": "https://si.imgix.net/50cac838/uploads/origins/99fc1f60-00db-48a3-b0be-192b59a814c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=391a290766625776ec94fd076a7baeab, https://si.imgix.net/50cac838/uploads/origins/99fc1f60-00db-48a3-b0be-192b59a814c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c8bec7599e1bb3c305c345b1055aaf4d 2x, https://si.imgix.net/50cac838/uploads/origins/99fc1f60-00db-48a3-b0be-192b59a814c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5ec592e77418743f2e3bb0f084a6779d 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/50cac838/uploads/origins/99fc1f60-00db-48a3-b0be-192b59a814c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7be5648b0f1abf49e3c08b24a0d140b", "srcset": "https://si.imgix.net/50cac838/uploads/origins/99fc1f60-00db-48a3-b0be-192b59a814c4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=e7be5648b0f1abf49e3c08b24a0d140b, https://si.imgix.net/50cac838/uploads/origins/99fc1f60-00db-48a3-b0be-192b59a814c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=8a3c590d2bc69ef2fc8f757fed7b8a0d 2x, https://si.imgix.net/50cac838/uploads/origins/99fc1f60-00db-48a3-b0be-192b59a814c4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b00944a30ef95a15e17fce7c42ba8f69 3x"}, "body": "はじめまして にじさんじのリゼ・ヘルエスタさんのイラストをお願いします。\n公務中にトイレに行かないために、自分の尿道にカテーテルを挿し、反対側をお尻の中に繋げて自分でおしっこを浣腸しているシチュでお願いします。\n衣装は新しく発表された公務服でお願いします。 椅子に座った状態でおしっこが浣腸され、感じるのを我慢している様子でお願いします。\nまた、おしっこがお尻の中に溜まっていく様子が見える断面図もお願いします。\nよろしくお願いします。", "nc": 176, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@noah129999/works/9", "private_t