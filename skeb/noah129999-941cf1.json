す\n\nhttps://img.game8.jp/6555739/7b890f5e8d18f20d01be9b9332813e5a.jpeg/show\n https://m.imgur.com/c7ag9kf\n\nhttps://hachinai.com/character/kawakita\n\n是非採用していただきたいポイントは\n\n・性器の結合部位が見える\n・河北は嬉しそうな表情をしている\n・河北の上半身は裸で制服の冬服のリボン(青色のリボン)だけ着けている\n・河北は水色のレースのエロいパンツを履いたままでずらし挿入をしている\n・主人公の竿は色が黒ずんだ茶色で巨根\n・河北は「おっ♡」「デカチンポきもちいい♡」「イグッ♡」「イグうううう♡♡」のような下品な台詞を言っている\n\n以上になります。\n\nそのほかの要素、構図はお任せします。\nもし御都合がよろしければお願いいたします！", "nc": 32, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@noah129999/works/8", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 479843, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/2bdec5d4/uploads/origins/505f85e7-e07c-4dbd-b5ed-003a7d3d8938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb3460e537a81764c495257b511d056f", "srcset": "https://si.imgix.net/2bdec5d4/uploads/origins/505f85e7-e07c-4dbd-b5ed-003a7d3d8938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=bb3460e537a81764c495257b511d056f, https://si.imgix.net/2bdec5d4/uploads/origins/505f85e7-e07c-4dbd-b5ed-003a7d3d8938?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=3e1227b088288005b0a3ba9c212184ee 2x, https://si.imgix.net/2bdec5d4/uploads/origins/505f85e7-e07c-4dbd-b5ed-003a7d3d8938?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e438af8798b071fcb06cd9b8f6bcc0d5 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/2bdec5d4/uploads/origins/505f85e7-e07c-4dbd-b5ed-003a7d3d8938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=689bbea6598c46a5982e2560104bd19f", "srcset": "https://si.imgix.net/2bdec5d4/uploads/origins/505f85e7-e07c-4dbd-b5ed-003a7d3d8938?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=689bbea6598c46a5982e2560104bd19f, https://si