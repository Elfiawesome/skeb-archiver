上げていらっしゃったコケツヅリくらいのイメージです。\n\nポーズや背景などの指定は特にありませんので、好きに描いていただいて問題ありません。\nなお、雪代のVTuber活動上で使用させていただく可能性がありますので、背景が透過されたものがあると嬉しいです。\n（動画の右下に出る小さなアイコンに設定する/サブSNSのアイコンにする、など）\n\nどうぞよろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1knqEowxHDc5VszyR0xK7CCHIw-tZSY9q?usp=drive_link", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@stone25shion/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2780419, "client_id": 2843826, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/4ab85c73/uploads/origins/5625afe8-0da9-4414-9227-123e2724fe7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7bab3ade3245edbf02bccec2bc86d92", "srcset": "https://si.imgix.net/4ab85c73/uploads/origins/5625afe8-0da9-4414-9227-123e2724fe7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d7bab3ade3245edbf02bccec2bc86d92, https://si.imgix.net/4ab85c73/uploads/origins/5625afe8-0da9-4414-9227-123e2724fe7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=7409d626c7692c03294c29a0b1a188eb 2x, https://si.imgix.net/4ab85c73/uploads/origins/5625afe8-0da9-4414-9227-123e2724fe7d?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=b981b539360a7607417681d73282a687 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/4ab85c73/uploads/origins/5625afe8-0da9-4414-9227-123e2724fe7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19ecb0da63aa2ab9266c1d9b57d1164a", "srcset": "https://si.imgix.net/4ab85c73/uploads/origins/5625afe8-0da9-4414-9227-123e2724fe7d?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=19ecb0da63aa2ab9266c1d9b57d1164a, https://si.imgix.net/4ab85c73/uploads/origins/5625afe8-0da9-4414-9227-123e2724fe7d?bg=%23fff&auto=format%2Ccompr