.net/b6968d19/uploads/origins/ca24d55c-947f-4101-b95f-47ed6ef5274a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00e4417de3c552189d09e2f902938f29", "srcset": "https://si.imgix.net/b6968d19/uploads/origins/ca24d55c-947f-4101-b95f-47ed6ef5274a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=00e4417de3c552189d09e2f902938f29, https://si.imgix.net/b6968d19/uploads/origins/ca24d55c-947f-4101-b95f-47ed6ef5274a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=767d104a6af7e3069d63158e304655f2 2x, https://si.imgix.net/b6968d19/uploads/origins/ca24d55c-947f-4101-b95f-47ed6ef5274a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9f2c9220743bc4b63199cd0353d9ee57 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/b6968d19/uploads/origins/ca24d55c-947f-4101-b95f-47ed6ef5274a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d6cb517c59def9a6288da0bf2e45734", "srcset": "https://si.imgix.net/b6968d19/uploads/origins/ca24d55c-947f-4101-b95f-47ed6ef5274a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8d6cb517c59def9a6288da0bf2e45734, https://si.imgix.net/b6968d19/uploads/origins/ca24d55c-947f-4101-b95f-47ed6ef5274a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=0657b173823466f8958df9df56cf13d8 2x, https://si.imgix.net/b6968d19/uploads/origins/ca24d55c-947f-4101-b95f-47ed6ef5274a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5fb7b83273c4a34f52131a3e05e002b6 3x"}, "body": "はじめまして。いつも素敵な作品を見ています。\n\n先生の绘柄がとても好きで、いつも楽しく見ています。\n\n今回は、先生に自分のオリジナルキャラクター、慕桖（Muxue）を描いてほしいと思い、リクエストを送ります。\n\n【キャラクター設定】\n\n· 名前：慕桖（ムーシュー / Muxue）\n\n· 種族：オオカミとドラゴンハーフ\n\n· 性格：明るく元気、活発\n\n· 少しだけドラゴンの血脈を引いていますので、特徴は先生の自由にアレンジしていただいて構いません\n\n· また、ぽってりとした可愛らしい感じを強調していただけると嬉しいです\n\nhttps://drive.google.com/drive/folders/1NUj1VwzQKADhZycig9HXIPnER5pKZz5C?usp=sharing\n\n【服装】\n\n· 白い半袖Tシャツ\n\n· 黒いショーツ\n\n【シーン・ポーズ・構図】\n\n公園の並木道をランニングまたは散歩しているMuxueを描いてほしいです。\n\n· 視点：ローアングル（下から見上げるような視点）\n視点の影響で、ショーツの下がほんの少しだけ見えそうになるようなニュアンスがあれば嬉しいです（「見えそうで見えない」くらいのさじ加減で大丈夫です）。\n\n動きはランニングでも散歩でも、先生のイメージで自由に決めていただいて結構です。\n\nよろしくお願いします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@wrb_7777/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3461119, "client_id": 2424682, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/65757fc4/uploads/origins/f0538bd1-f358-4051-93d0-b7dfdb34fe5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d47d669b058c104d401f2afbdff8004d", "srcset": "https://si.imgix.net/65757fc4/uploads/origins/f0538bd1-f358-4051-93d0-b7dfdb34fe5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d47d669b058c104d401f2afbdff8004d, https://si.imgix.net/65757fc4/uploads/origins/f0538bd1-f358-4051-93d0-b7dfdb34fe5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4766ee7eb2e12585f6efba1980e55249 2x, https://si.imgix.net/65757fc4/uploads/origins/f0538bd1-f358-4051-93d0-b7dfdb34fe5a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=68e5865ca96d99aace91ca30f9e16f28 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/65757fc4/uploads/origins/f0538bd1-f358-4051-93d0-b7dfdb34fe5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=934f3c37d0d3bc82766074503980c4ed", "srcset": "https://si.imgix.net/65757fc4/uploads/origins/f0538bd1-f358-4051-93d0-b7dfdb34fe5a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=934f3c37d0d3bc82766074503980c4ed, https://si.imgix.net/65757fc4/uploads/origins/f0538bd1-f358-4051-93d0-b7d