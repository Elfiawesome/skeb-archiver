93e956af2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfbc2ed86a31378d27aa1198373f649f", "srcset": "https://si.imgix.net/e76b6822/uploads/origins/ca204464-268d-40ab-bbe7-6a93e956af2b?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=bfbc2ed86a31378d27aa1198373f649f, https://si.imgix.net/e76b6822/uploads/origins/ca204464-268d-40ab-bbe7-6a93e956af2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=9af25ecbb39ecf48881e5ef1d4b20b8a 2x, https://si.imgix.net/e76b6822/uploads/origins/ca204464-268d-40ab-bbe7-6a93e956af2b?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ade25c8019a8b54cd801d6fb670e7e13 3x"}, "body": "リクエストさせて頂きます。\n古蜘蛛さんのダークな雰囲気のウララのイラストがとても好きなので、イラストを一枚お願いしたいと思います。\n\n服装は勝負服で、覚醒し強キャラになった状態。左目からピンク色の炎か電撃が出ていて、自身が勝利したレースの直後に顔を歪ませて勝ち誇っているような(雰囲気的には裏のスティルインラブのような)表情でお願いします。\n\n構図はお任せします。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@new_coun_desu/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 3122613, "client_id": 1960223, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1bbe9d01/uploads/origins/632a1537-5ae5-484b-93aa-57c0c952af90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a56103636bbbcd476876cdba1b070ff9", "srcset": "https://si.imgix.net/1bbe9d01/uploads/origins/632a1537-5ae5-484b-93aa-57c0c952af90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a56103636bbbcd476876cdba1b070ff9, https://si.imgix.net/1bbe9d01/uploads/origins/632a1537-5ae5-484b-93aa-57c0c952af90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=042d702adcc64a3709b53c6af51fe160 2x, https://si.imgix.net/1bbe9d01/uploads/origins/632a1537-5ae5-484b-93aa-57c0c952af90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f888b92bc92cd91ea6ec5a10b1f8ad69 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1bbe9d01/uploads/origins/632a1537-5ae5-484b-93aa-57c0c952af90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a96aa686deb624deb11a762eb8374541", "srcset": "https://si.imgix.net/1bbe9d01/uploads/origins/632a1537-5ae5-484b-93aa-57c0c952af90?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=a96aa686deb624deb11a762eb8374541, https://si.imgix.net/1bbe9d01/uploads/origins/632a1537-5ae5-484b-93aa-57c0c952af90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=daff8007f519b8c9b05bd43cad2abd88 2x, https://si.imgix.net/1bbe9d01/uploads/origins/632a1537-5ae5-484b-93aa-57c0c952af90?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=64d6805259249545e34cd0337597a9ad 3x"}, "body": "初めまして古蜘蛛さん。\n予てよ躍動感抜群、生命力溢れるウマ娘絵で着目させて頂いてました。\n抜群のアクション性雰囲気力と、衣装の質感表現力、そしてFGOユーザーでもあるようでしたので、もしよろしければ「ウマ娘のメジロアルダンに、FGOの源頼光／丑御前（アヴェンジャー）・第一再臨のコスプレ」をさせたイラストをお願いできるでしょうか。\n\n・衣装参考：源頼光／丑御前（FGO）\nhttps://fgogamemeister.com/archives/39506333.html\n（第一再臨はぴっちりタイツのものです）\n\n発想に至った経緯としては、ゲーム内のイベントにてアルダンさんが「源頼光になった空想をする」というエピソードがあったこと。また彼女の勝負服が黒ベースにグリーンをあしらう、丑御前（＝源頼光）を彷彿するカラーリングだったり、身を削る固有スキルと宝具同士……などなど、こじつけるに足る理由に個人的に盛り上がってしまったためです……。\n\n表情や構図・ポーズついては、古蜘蛛さんが思うアルダンさんのイメージのまま描いて頂けましたらOKです。\nお茶目だったりお淑やかだったり、時々カッコつけたがったり、はたまたシングレ張りに闘争心全開なレース中のテンションであったり等、古蜘蛛さんの解釈するアルダンさんの「らしい」振る舞いとリアクション描いて頂ければと思います！\nあくまで「着せ替えしたアルダンさん」を拝みたいので、コスプレ元になりきって描いて頂く必要はないです。（……というか丑御前なりきられると、アルダンさんが暗く病んじゃう感じになり、それは本意ではないです……ｗ）\n一応、コスプレ（衣装）がメインなので、なるべくなら全身が拝める構図にて、衣装姿を堪能させて頂ければ特に嬉しく思います……！\n\nキャラと衣装は自分の願望全開な組み合わせで恐縮ではありますが、それでも、ジャンルが分かり、画風の雰囲気もマッチし、ラインの出る衣装の質感も卓越していそう……などなどの理由からも、是非とも古蜘蛛さんのお手を振るって頂けましたら幸いです……！！\n何卒よろしくお願いいたします……！\n\nhttps://www.pixiv.net/artworks/115999216", "nc": 17, "word_count": 0, "transcoder": "image", "creator_acc