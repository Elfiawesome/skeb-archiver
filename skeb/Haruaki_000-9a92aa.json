ャボン玉は「中に閉じ込めたり」「上に乗ったり」「クッションのように抱き締める」など使用方法は自由に絡めてください\nまた、シャボン玉と絡みつつその他の加えたいシチュエーションなどがありましたらそちらもご自由に加えた想像力の溢れた内容にしていただけると幸いです\nシャボン玉との絡みイラストの資料などが必要でしたら同じく資料URLのツイートのリプライのイラストやこれまでの当方のリクエストなどをご参考にしてください\n\n\n以上が内容となります\nマニアックな内容でのご依頼となり申し訳ございません\nもしよろしければ何卒よろしくお願いいたします\n\nhttps://twitter.com/syabon09/status/1339556724034863104?t=gS8Qs4kwOIqEBQsTBSSlwg&s=19", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Haruaki_000/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 60318, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0419e955/uploads/origins/1be5e71d-1fd4-4450-9b0c-5ac5097eff51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91711b959fe5e2cff3578fb2b582579b", "srcset": "https://si.imgix.net/0419e955/uploads/origins/1be5e71d-1fd4-4450-9b0c-5ac5097eff51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91711b959fe5e2cff3578fb2b582579b, https://si.imgix.net/0419e955/uploads/origins/1be5e71d-1fd4-4450-9b0c-5ac5097eff51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5cc76c2fdf2a68b6595210ef001a26a 2x, https://si.imgix.net/0419e955/uploads/origins/1be5e71d-1fd4-4450-9b0c-5ac5097eff51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c1d61af18abc63150fce0b56ef72523 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0419e955/uploads/origins/1be5e71d-1fd4-4450-9b0c-5ac5097eff51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=567960e6fcc515ec7d4bd36e579fee75", "srcset": "https://si.imgix.net/0419e955/uploads/origins/1be5e71d-1fd4-4450-9b0c-5ac5097eff51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=567960e6fcc515ec7d4bd36e579fee75, https://si.imgix.net/0419e955/uploads/origins/1be5e71d-