863104?t=gS8Qs4kwOIqEBQsTBSSlwg&s=19", "nc": 161, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Haruaki_000/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 60318, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0419e955/uploads/origins/1be5e71d-1fd4-4450-9b0c-5ac5097eff51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91711b959fe5e2cff3578fb2b582579b", "srcset": "https://si.imgix.net/0419e955/uploads/origins/1be5e71d-1fd4-4450-9b0c-5ac5097eff51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=91711b959fe5e2cff3578fb2b582579b, https://si.imgix.net/0419e955/uploads/origins/1be5e71d-1fd4-4450-9b0c-5ac5097eff51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=a5cc76c2fdf2a68b6595210ef001a26a 2x, https://si.imgix.net/0419e955/uploads/origins/1be5e71d-1fd4-4450-9b0c-5ac5097eff51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6c1d61af18abc63150fce0b56ef72523 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/0419e955/uploads/origins/1be5e71d-1fd4-4450-9b0c-5ac5097eff51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=567960e6fcc515ec7d4bd36e579fee75", "srcset": "https://si.imgix.net/0419e955/uploads/origins/1be5e71d-1fd4-4450-9b0c-5ac5097eff51?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=567960e6fcc515ec7d4bd36e579fee75, https://si.imgix.net/0419e955/uploads/origins/1be5e71d-1fd4-4450-9b0c-5ac5097eff51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4228492381dc8f7dc34421aba92b1196 2x, https://si.imgix.net/0419e955/uploads/origins/1be5e71d-1fd4-4450-9b0c-5ac5097eff51?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=2e239a4da4b4e0c920d7688f8ba5e635 3x"}, "body": "初めまして。\n\nオリジナルキャラで、昔の農家の黒髪少女の緊縛イラストをリクエストしたいです。\n顔だち、髪型はお任せします。\n\n恰好\n野良着、もんぺ、足袋履きで、\n胸をだしてM字開脚縛りされています。\n表情は縛られて、涙ぐんでいる感じにしてほしいです。\n頭から爪先まで全身を、真正面からの構図を避けて描いてほしいです。\n\n服装\n野良着の色、模様は適当に、もんぺはウエストを紐で結ぶ袴式、色、模様は濃い紫系の縞、\n足袋は赤、足袋底は白にしてほしいです。\nもんぺイメージ\nhttps://www.dropbox.com/s/27dregu6fv4xgh3/ms.jpg?dl=0\n\n差分で、\n股間部分を、破られ、陰部に極太ディルドが挿入されて\n表情も苦しそうに目を閉じて泣き叫んでる状態もお願いします。\n\nつたない説明で恐縮ですが、説明不足な点、ポーズ、構図など\nアレンジしていただいて構いませんが、\n必ず、もんぺが破れていない状態と、破れた状態の2種を描いていただきたいです。\n\n以上ご検討の程宜しくお願い致します。\n\nhttps://www.dropbox.com/s/ufsxf93bzumt4k0/m.png?dl=0", "nc": 41, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@Haruaki_000/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 60318, "client_id": 1608326, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/3b460b66/uploads/origins/53d8f506-a59d-4f87-836f-3d6a588ae7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d74d75f740359a61be44a7bd68dc936", "srcset": "https://si.imgix.net/3b460b66/uploads/origins/53d8f506-a59d-4f87-836f-3d6a588ae7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7d74d75f740359a61be44a7bd68dc936, https://si.imgix.net/3b460b66/uploads/origins/53d8f506-a59d-4f87-836f-3d6a588ae7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=0d236bc346bdb9556b8b8bd816d518c9 2x, https://si.imgix.net/3b460b66/uploads/origins/53d8f506-a59d-4f87-836f-3d6a588ae7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=afe8635cb0190f200fc0cfebc8217e2c 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/3b460b66/uploads/origins/53d8f506-a59d-4f87-836f-3d6a588ae7cb?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=850ae702c2aa31df501fd8e7aa1ee137", "srcset": "https://s