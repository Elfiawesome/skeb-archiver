Lのリンク先にすべての参考資料があります。\n\n重要な詳細：髪の左側がとがっている、左目の下にほくろがある、いつも手袋をしている、口の右側に鋭い牙がある、右頬に傷がある。\n\nまた、YouTubeのサムネイルやSNSでのシェアに使いたいので、レイヤーごとに分けたpsdファイルを希望します。\n\nお引き受けいただけるようでしたら、よろしくお願いいたします！\n\nhttps://drive.google.com/drive/folders/1vbB6lep8PARvPGhZYSRUi0wssj3iO-rl?usp=sharing", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@kotenpankitsune/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 3112240, "client_id": 2102452, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1258ac19/uploads/origins/bff045f1-2f8c-45c5-8e00-686345c90f35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6350477c6031a0e0a0383f93b9052cb", "srcset": "https://si.imgix.net/1258ac19/uploads/origins/bff045f1-2f8c-45c5-8e00-686345c90f35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6350477c6031a0e0a0383f93b9052cb, https://si.imgix.net/1258ac19/uploads/origins/bff045f1-2f8c-45c5-8e00-686345c90f35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=99acc3d61d8a07022df636297afeb7a4 2x, https://si.imgix.net/1258ac19/uploads/origins/bff045f1-2f8c-45c5-8e00-686345c90f35?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=d8b725d30c322ab54a10ded73e1b2bfc 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1258ac19/uploads/origins/bff045f1-2f8c-45c5-8e00-686345c90f35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3824fa0e7c24ecff26a8400233d043d", "srcset": "https://si.imgix.net/1258ac19/uploads/origins/bff045f1-2f8c-45c5-8e00-686345c90f35?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b3824fa0e7c24ecff26a8400233d043d, https://si.imgix.net/1258ac19/uploads/origins/bff045f1-2f8c-45c5-8e00-686345c90f35?bg=%23fff&auto=format%2Ccompress&fm=