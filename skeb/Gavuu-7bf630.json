dpr=2&fit=crop&crop=top&w=200&h=200&s=883fe31175e195e5ed1372d707ce7096 2x, https://si.imgix.net/8a5c6366/uploads/origins/c2c7036a-fd83-4703-93ff-42f157e21d80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=6a9c8a5d17e9647187afd127df0e1c00 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8a5c6366/uploads/origins/c2c7036a-fd83-4703-93ff-42f157e21d80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e33946b50733a68afaba555a47b2940", "srcset": "https://si.imgix.net/8a5c6366/uploads/origins/c2c7036a-fd83-4703-93ff-42f157e21d80?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=6e33946b50733a68afaba555a47b2940, https://si.imgix.net/8a5c6366/uploads/origins/c2c7036a-fd83-4703-93ff-42f157e21d80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=904692b538ea366bfb6f68ca04cf8e44 2x, https://si.imgix.net/8a5c6366/uploads/origins/c2c7036a-fd83-4703-93ff-42f157e21d80?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=08906de6c94b29a1f7e206f17780b489 3x"}, "body": "GAVう様、初めまして。\nTwitterでの募集を見かけて、とても綺麗な絵柄だったので描いて貰いたいと思い、リクエストさせて頂きます！\n\n描いて頂きたいのは、配信アプリ「IRIAM」にて活動している「星影 雪良」という方です。\n本人からイラスト依頼の件の了承は頂いております。\n\n描いて欲しいのは、着物姿です。\nhttps://skeb.jp/@Gavuu/works/6\nこのイラストの髪型のように、まとめて簪などで刺しているような形にしていただけると嬉しいです。\nhttps://skeb.jp/@Gavuu/works/5\n着物はこのような形で着崩さずを優先に描いて欲しいのですが、もし差分がOKなら、このイラストのような着崩しているようなパターンも欲しいなと思っています。\n着物の色は、青、水色、白系統でお願いします。\n\n可能な範囲で全身が入っていると嬉しいですが、膝上などでも大丈夫です。\nその他構図はお任せ致します。\n\n使用用途は、本人へのプレゼント。そこからSNS、配信アプリIRIAM（収益化済み）、ヘッダーやアイコンリングなどの返礼品などです。\n納品のデータサイズはお任せ致します。\n納品形式はPSDファイルで、背景と人物、文字は別レイヤーにしていただけるととても助かります。\n\n金額不足などの場合は再送要求、依頼がGAVう様の意図にそぐわない場合はキャンセルをお願いします。\nご縁がありましたら、是非よろしくお願いします。\n\nhttps://x.com/hoshikage_yu_\nhttps://x.com/hoshikage_yu_/status/1835823940415168895", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Gavuu/works/12", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2417322, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/80d1df99/uploads/origins/aa296e55-2e86-46f0-88ca-f039e37612dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1457ca81723f3e597154b15d6b3bcf5", "srcset": "https://si.imgix.net/80d1df99/uploads/origins/aa296e55-2e86-46f0-88ca-f039e37612dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e1457ca81723f3e597154b15d6b3bcf5, https://si.imgix.net/80d1df99/uploads/origins/aa296e55-2e86-46f0-88ca-f039e37612dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=1d8565ed71284e30cdfffeedeccb5412 2x, https://si.imgix.net/80d1df99/uploads/origins/aa296e55-2e86-46f0-88ca-f039e37612dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2c9984a972cb40102c26847f42f659a3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/80d1df99/uploads/origins/aa296e55-2e86-46f0-88ca-f039e37612dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=110181ed65370e532fc619ec05da0eaa", "srcset": "https://si.imgix.net/80d1df99/uploads/origins/aa296e55-2e86-46f0-88ca-f039e37612dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=110181ed65370e532fc619ec05da0eaa, https://si.imgix.net/80d1df99/uploads/origins/aa296e55-2e86-46f0-88ca-f039e37612dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e92baf197b26b4236a923360772fc337 2x, https://si.imgix.net/80d1df99/uploads/origins/aa296e55-2e86-46f0-88ca-f039e37612dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=0922fbfad1eecf3d53908b7bd50e15b1 3x"}, "body": "やあ、僕は君のアートをとても楽しんでいるよ！\n\n僕のOCを描いてくれませんか？\nhttps://i.imgur.com/2oKMb98.jpeg\nhttps://i.imgur.com/Sjp1MPw.png\n\nこれにインスパイアされたドレスを着た彼女を描いてもらえますか？\nhttps://i.pinimg.com/736x/89/26/64/892664f8ce1a169422646208319035ae.jpg\n\n背景、ポーズ、表情は自由に決めてください！", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Gavuu/works/11", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2417322, "client_id": 3143432, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/6a0fc6fe/uploads/origins/4dbc9f70-39e4-407a-89e2-5d19888a3408?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6700620d2770d3c29ed45c3e64f79be", "srcset": "https://si.imgix.net/6a0fc6fe/uploads/origins/4dbc9f70-39e4-407a-89e2-5d19888a3408?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=a6700620d2770d3c29ed45c3e64f79be, https://si.imgix.net/6a0fc6fe/uploads/origins/4dbc9f70-39e4-407a-89e2-5d19888a3408?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d2b0808ba5fd6b5524ee494745350ba4 2x, https://si.imgix.net/6a0fc6fe/uploads/origins/4dbc9f70-39e4-407a-89e2-5d19888a3408?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=93f61bd85a5f60ad4d9b8e0275077670 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/6a0fc6fe/uploads/origins/4dbc9f70-39e4-407a-89e2-5d19888a3408?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8fb62e70614be11a06df8456f9766b1", "srcset": "https://si.imgix.net/6a0fc6fe/uploads/origins/4dbc9f70-39e4-407a-89e2-5d19888a3408?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c8fb62e70614be11a06df8456f9766b1, https://si.imgix.net/6a0fc6fe/uploads/origins/4dbc9f70-39e4-407a-89e2-5d19888a3408?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=2d79feb1734c52766be0d69aa18e1765 2x, https://si.imgix.net/6a0fc6fe/uploads/origins/4dbc9f70-39e4-407a-89e2-5d19888a3408?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=56e84e83d16b6817447807c63b9baebf 3x"}, "body": "GAVう🐼様こんばんは！みゅーと申します。\nYouTubeでVTuberとして活動しております。\n\nTwitterで素敵なイラストを拝見させていただき、絵柄がとっても好みだったので\nもし良ければ描いていただければと思い連絡させて頂きました。\n\n\n配信用サムネイルに使えそうなイラストを依頼させていただければと思います。\n(当方、みゅーあうろーらのイラストをお願いします。）\n\n衣装や構図、ポーズに関してはお任せします。当方の衣装でもよいですし何かしらのコスプレでも構いません。座っていても寝ていてもどのような角度でもかまいません。何かのボカロ曲モチーフでもOKです。GAVう🐼様の世界観で表現していただければと思います。\n（前髪は片目隠れでお願いします。）\n\nサムネイル等に使用予定ですので可能であれば広がった髪の毛が途中で切れないなどでしたら嬉しいです。\n（必須ではありませんが、太ももorお尻が映っていると嬉しいです！お任せします。）\n\n画像形式は透過PNGかPSDを頂ければ嬉しいです。\n\n\n用途はXでの投稿や収益化したライブ配信や動画、アイコンやヘッダー使用、ネットプリント、グッズ、ファンボックスなどのVTuberとしての活動で使用させていただければと思っております。\n\n立ち絵などの資料は下記URLから確認していただければと思います。\n\n\n\nスケブでの依頼は慣れていないので至らない点があると思いますが、よろしくお願いします。\n\n\n\n\n\n\n\n\n\n\nhttps://lit.link/mewaurora\n\nhttps://lit.link/mewaurora", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@Gavuu/works/10", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/ce99fda2/uploads/origins/e86f7643-4fc9-494a-b594-4998bdbb0639?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba1c2c5de7e4af73247fa3136bbb8868", "srcset": "https://si.imgix.net/ce99fda2/uploads/origins/e86f7643-4fc9-494a-b594-4998bdbb0639?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=ba1c2c5de7e4af73247fa3136bbb8868, https://si.imgix.net/ce99fda2/uploads/origins/e86f7643-4fc9-494a-b594-4998bdbb0639?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=fbbd13e49a34861ec67bb5e27b532db8 2x, https://si.imgix.net/ce99fda2/u