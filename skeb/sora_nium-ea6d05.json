c3196-23e0-4137-a47d-68d75aa481cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=79634c6170e6daeedfb807b61c08a080 2x, https://si.imgix.net/737700c3/uploads/origins/64cc3196-23e0-4137-a47d-68d75aa481cb?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=62cb247b9b6d6493f3bb7adbb6e0f2ae 3x"}, "body": "イングリッド（カプコン）がキャミィに下記資料のようにカーフスライサー（相手の膝裏に自分の足首等を挟んだ状態で相手の脚を折り曲げてふくらはぎを押しつぶす脚関節技です）をかけられながら後ろから脇腹等を執拗に殴られているイラストをお願いできますでしょうか。\nイングリッドは完全に戦意喪失して泣き叫んでいる。頭部から出血して髪が所々赤く染まっている。服は破れてボロボロ。顔のダメージ表現はあざと鼻血まででお願いします。脚の痛みが強調されるように「ミシミシ」「メリメリ」等の効果音を、脇腹付近には「ボスッ」「ドボォ」等の効果音をお願いできますでしょうか。。キャミィは表情を変えずに淡々と拳を振り下ろしている感じでお願いします。\n可能であれば別カットでイングリッドのふくらはぎにキャミイの足が食い込んでいる様子を描いてほしいです。\n台詞OKであれば脚の痛みに絶叫し、パンチにうめき声をあげながら必死に許しを請うているような台詞を入れていただきたいです。\n例「ぎゃああああー！おごっ！？やめっ…わ、わしの負けじゃあ！もうやめてくれえええ！」\n資料　https://www.youtube.com/watch?v=OTmqQ9jnr78&list=PLRl8LSOHjb8bkjBTXg57WH1NXkhRklgCO&index=37の4:32~", "nc": 42, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sora_nium/works/14", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 35563, "client_id": 912304, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/783af53d/uploads/origins/e31655e6-4baf-4880-a895-70bea94983da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d04a233f6bcf99006f6783b7e4299eb6", "srcset": "https://si.imgix.net/783af53d/uploads/origins/e31655e6-4baf-4880-a895-70bea94983da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d04a233f6bcf99006f6783b7e4299eb6, https://si.imgix.net/783af53d/uploads/origins/e31655e6-4baf-4880-a895-70bea94983da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4213254ec6d267f40052e410e660d9a0 2x, https://si.imgix.net/783af53d/uploads/origins/e31655e6-4baf-4880-a895-70bea94983da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=2e5bddfb01538ac52099b5909bdf2a92 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/783af53d/uploads/origins/e31655e6-4baf-4880-a895-70bea94983da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c8de3bba7659b057d0a4114655d2e82", "srcset": "https://si.imgix.net/783af53d/uploads/origins/e31655e6-4baf-4880-a895-70bea94983da?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8c8de3bba7659b057d0a4114655d2e82, https://si.imgix.net/783af53d/uploads/origins/e31655e6-4baf-4880-a895-70bea94983da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=db3ad15cfa91361c39a0b1d5e8b380d5 2x, https://si.imgix.net/783af53d/uploads/origins/e31655e6-4baf-4880-a895-70bea94983da?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=4fdb44d691ad20055f67a037c220047d 3x"}, "body": "こんにちは！先生が久しぶりにSKebを開いたという知らせを聞いて、できれば先生の絵をぜひ見たくてこのように申し込みます。 ということでリクエストします。 このように先生にまた申し込むことができて嬉しいです！もしよろしければ、今回も可能でしたら格闘ゲームのリョナ絵をお願いしたいです。鉄拳のリリとKOFのクーラをお願いしたいと思います。\n\nキャラクター : リリ(鉄拳)、クーラ(KOF)です。\n服装 : リリ- 鉄拳5~6までの白いドレスと白いブーツ衣装です。\nクーラ - KOF14~15の基本服装です。\n状況 : (添付画像を参照)\nリリの攻撃に大きな衝撃を受けてKOになったクーラは、嘔吐や涙を流しながら失禁し、けいれんを起こしています。クーラにリリは彼女の足の間でクーラの首を締めます。 リリはクーラをからかいながら余裕のある笑顔を見せます。 クーラはつらさにもがいてますが、何もできません。敗北した彼女は徐々に失神します。\nリリ : 余裕のある笑顔、「やっとこれくらい？」という感じで挑発するような笑いがいいですね 少女っぽい感じをよろしくお願いします。\n添付写真のように彼女の表情、体、特にブーツがよく見えたらいいですね\nパンツの色は白がいいですね。\nクーラ : 苦痛で苦しい表情、大量の涙と唾液(窒息の苦痛で苦しい表情になると良いです。)（涙と共に嘔吐と血があっても良いですよ）、そして股と底に失禁があるといいです。\nクーラの体や服に血やあざなどの若干のダメージ表現があってもいいです\n添付画像のように、彼女の表情と体がよく見えたらいいですね。\nできればクーラ に表情変化の差があったらいいんですけど（例えば両目をぎゅっと閉じた表情と両目を大きく開けて白目で目を上げて失神した目をした表情など）これは先生が負担になるならしなくても大丈夫です。 先生が良いと思う表情を描いてください！ あくまで先生の意見に従います\n添付された写真ではクーラの横のヘアが顎の上までくる長さですが リリのように顎下まで下がるくらいの長さで長くお願いします。\nよろしくお願いします！\n\nもし役に立つかと思って、リリとクーラの様々な角度の3dモデリングイメージスクリーンショットも一緒に添付します。\n\nリリ 3d, クーラ3d\nhttps://drive.google.com/file/d/1v1bBSqPLia1DqwGmfilWcFspylWDTFJ5/view?usp=sharing\n\nhttps://drive.google.com/file/d/12ZzvyEGuaXu5rl0XeFrHll_Jn9ZEwLUt/view", "nc": 58, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@sora_nium/works/13", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 35563, "client_id": 436397, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/e53ae3e0/uploads/origins/af4a2c2e-9b6e-468a-8bdf-65b1f6e66ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84173e39403b161e23417f84d7522451", "srcset": "https://si.imgix.net/e53ae3e0/uploads/origins/af4a2c2e-9b6e-468a-8bdf-65b1f6e66ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=84173e39403b161e23417f84d7522451, https://si.imgix.net/e53ae3e0/uploads/origins/af4a2c2e-9b6e-468a-8bdf-65b1f6e66ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=20a7f835de44c69356a277cb10b520bc 2x, https://si.imgix.net/e53ae3e0/uploads/origins/af4a2c2e-9b6e-468a-8bdf-65b1f6e66ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=e508b1923ff1f067f469028318b7cada 3x"}, "duration": null, "nsfw": true, "hardcore": true, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/e53ae3e0/uploads/origins/af4a2c2e-9b6e-468a-8bdf-65b1f6e66ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20d9fc5b3a0fee5569603623cf7041cf", "srcset": "https://si.imgix.net/e53ae3e0/uploads/origins/af4a2c2e-9b6e-468a-8bdf-65b1f6e66ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=20d9fc5b3a0fee5569603623cf7041cf, https://si.imgix.net/e53ae3e0/uploads/origins/af4a2c2e-9b6e-468a-8bdf-65b1f6e66ee0?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=a2b0a6fd9af967594e94fe307983c8be 2x, https://si.imgix.net/e53ae3e0/uploads/origins/af4a2c2e-9b6e-468a-8bdf-65b1f6e66e