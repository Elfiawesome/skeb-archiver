er.com/4Lx3NIDhg4XwECi/status/1696123362748280888\nコートは無しで。\n\nうちの子オリキャラについてです。\nhttps://greatbouquetpuppythings.tumblr.com/　（オリキャラ資料まとめ）\n特徴は金髪ボブ。目が黒白目。爪が黒い。筋肉質。高身長。\nオリキャラのイメージは都築栞みたいな敵女タイプです。\n胸の大きさも都築栞ぐらい大きくよろしくお願いします。\n説明以上となります。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@ilmamesi59432/works/5", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 2677516, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/a94c905c/uploads/origins/8580d3f4-099e-43eb-a0b4-a23648ebb7ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33ca65950a23bd6685c2d8e4a1bcab95", "srcset": "https://si.imgix.net/a94c905c/uploads/origins/8580d3f4-099e-43eb-a0b4-a23648ebb7ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=33ca65950a23bd6685c2d8e4a1bcab95, https://si.imgix.net/a94c905c/uploads/origins/8580d3f4-099e-43eb-a0b4-a23648ebb7ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=852bbad05b9c8c2c51364b6d40ecb9df 2x, https://si.imgix.net/a94c905c/uploads/origins/8580d3f4-099e-43eb-a0b4-a23648ebb7ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9681be7fab62eec957e3e421da147dce 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/a94c905c/uploads/origins/8580d3f4-099e-43eb-a0b4-a23648ebb7ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64a73ccacb90c1c0afa092194f4090f9", "srcset": "https://si.imgix.net/a94c905c/uploads/origins/8580d3f4-099e-43eb-a0b4-a23648ebb7ad?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=64a73ccacb90c1c0afa092194f4090f9, https://si.imgix.net/a94c905c/uploads/origins/8580d3f4-099e-43eb-a0b4-a23648ebb7ad?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=dabc1221