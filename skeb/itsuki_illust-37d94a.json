pKmKdUjc9l-KV3-afxyIQj_UH9YSNyIx/view?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@itsuki_illust/works/2", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 942080, "client_id": 2225041, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/25bba88e/uploads/origins/723bf03e-8ad8-4a36-a643-b57be790b881?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e82545b725e5b37df09c9ef00ed5fdfb", "srcset": "https://si.imgix.net/25bba88e/uploads/origins/723bf03e-8ad8-4a36-a643-b57be790b881?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=e82545b725e5b37df09c9ef00ed5fdfb, https://si.imgix.net/25bba88e/uploads/origins/723bf03e-8ad8-4a36-a643-b57be790b881?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=419ad4b2dd593ec871d6233f7c755653 2x, https://si.imgix.net/25bba88e/uploads/origins/723bf03e-8ad8-4a36-a643-b57be790b881?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=f8f4f03ace15e6675bd46180906923c8 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/25bba88e/uploads/origins/723bf03e-8ad8-4a36-a643-b57be790b881?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd03688deea5288e39d841a76b70e572", "srcset": "https://si.imgix.net/25bba88e/uploads/origins/723bf03e-8ad8-4a36-a643-b57be790b881?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=dd03688deea5288e39d841a76b70e572, https://si.imgix.net/25bba88e/uploads/origins/723bf03e-8ad8-4a36-a643-b57be790b881?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=d9065d14f46160e4280a0d1f9cadaee5 2x, https://si.imgix.net/25bba88e/uploads/origins/723bf03e-8ad8-4a36-a643-b57be790b881?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=af0685497fa5a07688788e5004d23062 3x"}, "body": "はじめまして，こんにちは．素敵なイラストを拝見しまして依頼させていただきました．よろしくお願いいたします．\n-----\nリクエストは女性のオリジナルキャラをお願いしたいです．\n\n◇年齢：20代\n◇女性の特徴：ウルフカット＋ポニーテール(丈はおまかせします)、ピアス、タトゥー多め(量はおまかせします)\n・髪型のイメージ\nhttps://jp.pinterest.com/pin/69805862969198477/\nhttps://jp.pinterest.com/pin/25684660372204518/\n◇服装：おまかせします。おへそは出していただけると嬉しいです。\nもし...可能であればトップレスの状態で髪等で上手い具合に隠れるようにしていただきたいです。(できないようであればこの文は無視で大丈夫ですm(_ _)m)\n◇構図：口角を少しクイっとしている感じでお願いします\n・構図のイメージ\nhttps://jp.pinterest.com/pin/3870349675591975/\n\n最後にPCの壁紙にしたいと考えていますので可能であれば縦横比を16:9でお願いしたいです．\n-----\nその他アレンジや好みで構いませんのでご検討よろしくお願いいたしますm(_ _)m", "nc": 1, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@itsuki_illust/works/1", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 942080, "client_id": 3617296, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/d1c7e0c5/uploads/origins/2f3bfb05-c974-48a2-82ff-b8cf62d9470a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a9d194e2e98a9ae02c57175124399c7", "srcset": "https://si.imgix.net/d1c7e0c5/uploads/origins/2f3bfb05-c974-48a2-82ff-b8cf62d9470a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=4a9d194e2e98a9ae02c57175124399c7, https://si.imgix.net/d1c7e0c5/uploads/origins/2f3bfb05-c974-48a2-82ff-b8cf62d9470a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=2ecad1f81273c9ae7bc62faa8a2d3678 2x, https://si.imgix.net/d1c7e0c5/uploads/origins/2f3bfb05-c974-48a2-82ff-b8cf62d9470a?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=0572d588e779d0b9f25f0fac1d6c7f73 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/d1c7e0c5/uploads/origins/2f3bfb05-c974-48a2-82ff-b8cf62d9470a?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=2