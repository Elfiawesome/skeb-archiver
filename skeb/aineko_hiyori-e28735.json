sh pink. My image color is also pink.\nHer eyes are pink and light blue.\nYou are free to change your hair style and clothes.\n\nPlease feel free to change the hair style and clothes.\nWe would appreciate it if you could provide us with a PSD or PNG format, with the background and the person separated.\nIt would be very helpful if you could also provide us with the head (ears) and tail so that they are not cut off,\n　It would be very helpful if you could make sure that the head (ears) and tail are not cut off, but we would appreciate it if you could make it as easy as possible for us to draw.\n\nI apologize for asking so much of you...\nI would be very happy if you could help me!\nThank you very much for your consideration.\n\nhttps://drive.google.com/drive/folders/1zqhfGXYc6e9xgPI7cSFtmEYSwQiSzwF5?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@usahana101/works/1362", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 2177354, "client_id": 3537042, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dfb193ac/uploads/origins/386456fe-4d53-4560-9167-0798422c7ec4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7383f28b9ab264a1ef36fd1f4e046d85", "srcset": "https://si.imgix.net/dfb193ac/uploads/origins/386456fe-4d53-4560-9167-0798422c7ec4?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7383f28b9ab264a1ef36fd1f4e046d85, https://si.imgix.net/dfb193ac/uploads/origins/386456fe-4d53-4560-9167-0798422c7ec4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=d61b86c5c3e74752256e11f2832b9fb5 2x, https://si.imgix.net/dfb193ac/uploads/origins/386456fe-4d53-4560-9167-0798422c7ec4?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=89d6f229b1a0ae360e859fb12e14bfd0 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_