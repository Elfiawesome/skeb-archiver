-46bf-8f0d-d304ac384f39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c8a88dee669513eb48c409f1ffef5e7", "srcset": "https://si.imgix.net/28114c15/uploads/origins/96e95aaf-e936-46bf-8f0d-d304ac384f39?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9c8a88dee669513eb48c409f1ffef5e7, https://si.imgix.net/28114c15/uploads/origins/96e95aaf-e936-46bf-8f0d-d304ac384f39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=61c2a2a0a69af331685aaeee3bb5dcd5 2x, https://si.imgix.net/28114c15/uploads/origins/96e95aaf-e936-46bf-8f0d-d304ac384f39?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=b408d189890538035cc6df382deff68b 3x"}, "body": "甘崎333様。以前もイラストをご依頼させていた非錠口です。以前は大変お世話になりました。\n今回も、作成中の同人誌の表紙絵をご依頼させていただきたいと思います。\n\n書いて頂きたいイラストは、少女☆歌劇レヴュースタァライトの一枚絵になっております。\n\n【サイズ】\n横向き、A4でお願いします。A4のイラストを真ん中で分けて表紙（A5）と裏表紙に分けて使用させていただきます。\n\n【背景】\n愛城華恋と神楽ひかりの部屋を、窓と机が奥に来るようにしてください。その上で、窓の左半分のカーテンは開けた状態で、イラストの両端にベットが描かれるようにしてください。また開いた窓からは、部屋の中に夕日の光が入りこんでいるようにお願いします。コントラストをしっかり描いて頂けると嬉しい限りです。\n\n【キャラクター】\n\n１、愛城華恋：左側ベッドの上で膝を抱えてうずくまっている体勢です。衣装はレヴュー衣装でお願いします。目は虚ろ気味で、神楽ひかりと目と目を合わせるようにお願いします。\n\n２、神楽ひかり：真ん中より左側に立って、愛城華恋を見下ろすように視線を向けてください。服装は、レヴュー衣装でお願いします。表情や目には決意がともっているようにお願いします。\n\n以下には、他の雑多な希望を箇条書きにしてあります。\n\n・納品物の拡張子：png、psdを希望します\n・解像度：お任せします。\n・納品物の使用用途一覧：\n１、同人誌の表紙（表紙、及び、あとがきに『甘崎333』と名義を記載の上利用）\n２、Twitter及びpixivなどSNSでの宣伝的利用（各ツイート、及び投稿物に『甘崎333』と名義を記載の上利用。ヘッダー、及びアイコンに利用した場合は、プロフィールに明記）\n３、BOOTHなど、頒布上必要なインターネットサイトへの掲載（概要欄にイラスト『甘崎333』と明記）\n\n依頼内容は以上となります。\nもし内容に問題がありませんでしたら、是非とも甘崎333様にイラストを描いて頂きたいと思っております。\n長文大変失礼いたしました。完成を心待ちにしております。", "nc": 145, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}, {"path": "/@333a2021/works/26", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 893912, "client_id": 1551262, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/87f84f0f/uploads/origins/1cb2e04e-e785-4dba-9375-6a9d96ac4ae3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0ce333dde462064fe302c3f8b4446a6", "srcset": "https://si.imgix.net/87f84f0f/uploads/origins/1cb2e04e-e785-4dba-9375-6a9d96ac4ae3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=d0ce333dde462064fe302c3f8b4446a6, https://si.imgix.net/87f84f0f/uploads/origins/1cb2e04e-e785-4dba-9375-6a9d96ac4ae3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=f0a50d36c47bf0cbf4c774c71069844f 2x, https://si.imgix.net/87f84f0f/uploads/origins/1cb2e04e-e785-4dba-9375-6a9d96ac4ae3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=56461702886b57537b4df4eaaaf818d3 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/87f84f0f/uploads/origins/1cb2e04e-e785-4dba-9375-6a9d96ac4ae3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ceaadef2c200cbecc09f5a2dfb5c2414", "srcset": "https://si.imgix.net/87f84f0f/uploads/origins/1cb2e04e-e785-4dba-9375-6a9d96ac4ae3?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=ceaadef2c200cbecc09f5a2dfb5c2414, https://si.imgix.net/87f84f0f/uploads/origins/1cb2e04e-e785-4dba-9375-6a9d96ac4ae3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=569af59f7b7b049562c9876d679be5d6 2x, https://si.imgix.net/87f84f0f/uploads/origins/1cb2e04e-e785-4dba-9375-6a9d96ac4ae3?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ff699e17d84ff20133c29b11f927d644 3x"}, "body": "甘崎333様。初めまして。\n今回は、私が作成中の同人誌の表紙絵を依頼させていただきます。\n\n書いて頂きたいキャラクターは、少女☆歌劇レヴュースタァライトの愛城華恋です。\n\n衣装はこちらの公式サイト（https://revuestarlight.com/animation/character/?id=karen）にございますレヴュー衣装で、かつ、青地と白地の部分を全て黒に変えてください。\n\nポーズは、胎児体制で左側に腕が来るようにして、目線を正面に（胎児体制の正面ではなく、画面の外側の私達側）に向けてください。また細部の注文が三点ございますが、１、両手で髪飾りの王冠（ヒビを入り）を持って、２、頬に貰い血が軽くついていて、３、瞳は弱弱しく虚ろに、でお願いします。\n\n構図は、バストアップで、目と王冠が良く見えるようにお願いします。一応、右下にロゴが入ります。\n\n色彩は暗めにお願いします。布地と金属光沢の差異のバランスはお任せします。甘崎333さんのイラストの中であれば、こちらのイラストが、一番私のイメージに近いです。（https://www.pixiv.net/artworks/91889482）\n\n以下には、他の雑多な希望を箇条書きにしてあります。\n\n・納品物の拡張子：png、psdを希望します\n・納品形式：他の納品差分に関わらず、png形式で、愛城華恋の透過図を頂きたいです。\n・背景：特に指定しませんが、書いて頂けるのであれば、劇場版の『皆殺しのレヴュー』の時の列車の上の舞台か、または、通常の木板の舞台の上を希望します。\n・解像度：お任せします。\n・サイズ：B5(182×257)を希望します。\n・納品物の使用用途一覧：\n１、同人誌の表紙（表紙、及び、あとがきに『甘崎333』と名義を記載の上利用）\n２、Twitter及びpixivなどSNSでの宣伝的利用（各ツイート、及び投稿物に『甘崎333』と名義を記載の上利用。ヘッダー、及びアイコンに利用した場合は、プロフィールに明記）\n３、BOOTHなど、頒布上必要なインターネットサイトへの掲載（概要欄にイラスト『甘崎333』と明記）\n\n依頼内容は以上となります。\nもし内容に問題がありませんでしたら、是非とも甘崎333様にイラストを描いて頂きたいと思っております。\n長文大変失礼いたしました。完成を心待ちにしております。", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": false}], "similar_creators": []}, "price_history": {"novel": [{"amount": 5000, "recorded_at": 1779885376.424272}], "correction": [{"amount": 1000, "recorded_at": 1779885376.424272}]}, "custom": {}}