xtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=f700c4fa9ce5d3762d129f67d5b9a4c0, https://si.imgix.net/6b5b3da1/uploads/origins/34bb931d-2850-4071-8508-bd3d453e8207?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=e12d0816a94ed48d40bb070cdc1b0c8b 2x, https://si.imgix.net/6b5b3da1/uploads/origins/34bb931d-2850-4071-8508-bd3d453e8207?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=b5db284baecaac12498f4e58a5d139ad 3x"}, "private": true, "genre": "art", "tipped": false, "creator_id": 245, "client_id": 66874, "nc": 160}, {"path": "/@takamichis112/works/15", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 245, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/f1bbdc44/uploads/origins/568fd63e-f58d-4021-896c-fdff5ba4616f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b80664ab29de882b58ee1915688fe76", "srcset": "https://si.imgix.net/f1bbdc44/uploads/origins/568fd63e-f58d-4021-896c-fdff5ba4616f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=2b80664ab29de882b58ee1915688fe76, https://si.imgix.net/f1bbdc44/uploads/origins/568fd63e-f58d-4021-896c-fdff5ba4616f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=21b358f86302158a2c88b01d07d239ac 2x, https://si.imgix.net/f1bbdc44/uploads/origins/568fd63e-f58d-4021-896c-fdff5ba4616f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=9d1013470bed3f9da760102158e92db0 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/f1bbdc44/uploads/origins/568fd63e-f58d-4021-896c-fdff5ba4616f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1077e416a732fb84c9d49ed827478a6", "srcset": "https://si.imgix.net/f1bbdc44/uploads/origins/568fd63e-f58d-4021-896c-fdff5ba4616f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f1077e416a732fb84c9d49ed827478a6, https://si.imgix.net/f1bbdc44/uploads/origins/568fd63e-f58d-4021-896c-fdff5ba4616f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=24ef2d9a2e8eff7556dc2f6c0860bb07 2x, https://si.imgix.net/f1bbdc44/uploads/origins/568fd63e-f58d-4021-896c-fdff5ba4616f?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=bbf5cb8cc12e6d315ba29da5774a674f 3x"}, "body": "PIXIVのアイドルちゃんが最高なのでリクエストさせてください。\n\n■キャラ\nくにおくんシリーズ長谷部和美\n公式https://www.kuniokun.jp/monogatari/introduction/\nhttps://skeb.jp/@hirotamasatane/works/82\nhttps://gelbooru.com/index.php?page=post&s=view&id=4911012&tags=hasebe_kazumi\nレトロゲーキャラで恐縮ですが、①睫毛の長い切れ長の目②紫みのある黒髪③赤スカートと黄色スカーフのセーラー服④顔のサイドの姫毛を押さえると雰囲気が出ます。前髪はぱっつん気味だけどぱっつんにしすぎず適度に乱れて眉が見えている。\n\n■シチュ\n元最強のスケ番がモブ不良に多勢に無勢され敗北、輪姦。胸は大きすぎない普通の美乳（C～D程度）。乳輪、乳首は小さ目薄ピンク、整っていない陰毛あり。下着は白の上品なレース系。\n\n■構図\nhttps://www.pixiv.net/artworks/101487424\n↑のアイドルちゃんのように、敗北後バックから着衣二穴輪姦。\nセーラー服とブラはたくし上げられ、胸露出。スカート、パンツは脱がされ、片足に引っかかっている。\n前後激しく突かれるも戦意は失っておらず、苦しげ歯を食いしばって耐えている。\n尻を何度も激しく叩かれ、思わず苦鳴が洩れる。手形も。\n\n別窓で、↓のような二穴断面図をぜひ。\nhttps://www.pixiv.net/artworks/81423759\n\nそして、時間経過を示す表情差分をお願いできないでしょうか。\n①（メイン）歯を食いしばり、悔しそうな片目ウインクのニラマレ顔\n「許さない…殺してやる」の台詞。\n②両目閉じ、無理やり感じさせられる切なげな雌顔\n（そんなっ…こんなやつらにっっ）の脳内台詞\n③瞳孔開き気味で舌出し絶叫。大量の涎で悲壮感溢れる敗北顔\n「あ゛っ！イクっ！！イクぅっっ！！！」\n④光のないアへ顔手前のレイプ目。口はだらしなく半開きでイラマ\n（あ…くにお…ごめ…ごめ…なさ…）の脳内台詞\n\n①→④で全身の精液、殴られたような痣（軽め）が増えていく。断面図は②③で子宮を押しつぶし、④は大量の精子が溢れている。\n\n細かくて恐縮ですが、女の子がとてもかわいいのでぜひお願いします。", "nc": 168, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takamichis112/works/14", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/b6d1e9a8/uploads/origins/4882c172-67d1-49ed-ac4c-1ca028b528ec?bg=%23fff&a