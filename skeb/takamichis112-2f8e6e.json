8aa3bc/uploads/origins/1f1662db-d2bc-40e7-ae44-920a181261ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=a43e6536506064bb2c68318500e63aa4 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/8a8aa3bc/uploads/origins/1f1662db-d2bc-40e7-ae44-920a181261ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8468ca9af332cbf9bbddbf43c6131515", "srcset": "https://si.imgix.net/8a8aa3bc/uploads/origins/1f1662db-d2bc-40e7-ae44-920a181261ac?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=8468ca9af332cbf9bbddbf43c6131515, https://si.imgix.net/8a8aa3bc/uploads/origins/1f1662db-d2bc-40e7-ae44-920a181261ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=4ca5741c5606adb945d104f426c48c61 2x, https://si.imgix.net/8a8aa3bc/uploads/origins/1f1662db-d2bc-40e7-ae44-920a181261ac?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=5f47229de3534b606f502b756fd97d2c 3x"}, "body": "以前はアリシアのリクエストを受けて頂きありがとうございました。\n\n今回は少女ウォーズというゲームアプリの徳川家康をお願い出来ればと思います。\n\n資料1\nhttps://www.inside-games.jp/app/otona_hamaru/\n\n資料2\nhttps://godapp.info/pai-touch/\n\n\nシチュレーションはサウナの中に閉じ込められて、のぼせたところをレ○プされる。\n\n衣類は下着姿(白にピンクのリボン)でブラは脱げかけており、胸が見えてしまっている。\n\n資料3(下着姿)\nhttps://www.pixiv.net/artworks/73001291\n\n①パンツをずらされ、正常位で挿入前(ハメ撮り視点)。のぼせており意識ははっきりとせず、瞳の中はぐるぐる目。汗をかいている。\n\n\n資料4(対位)\nhttps://skeb.jp/@yashdk52/works/33\n\n②挿入される\n\n③正気に戻るも奥まで突かれピストン、片手で胸を揉まれ感じている表情。(表情資料4参照)\n\n④中出しと同時にイカされる。\n\n要望が多くて申し訳ありませんが、もしよろしければお願いします！", "nc": 56, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takamichis112/works/12", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/079d4b36/uploads/origins/b81d2ee0-c273-4b7b-8aee-4e0d1349153f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtcl