&s=47a79140b60d50794aed7dcff0831787 2x, https://si.imgix.net/3a5a319f/uploads/origins/4000cbf6-fea1-487b-a4ff-21a406809557?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=ebb869a04432f36db5613cfe8ec68b3e 3x"}, "body": "はじめまして。\n描かれているイラストの趣向や肉感が素晴らしく、お忙しいなかではありますが是非ともと思いリクエストを送らせていただきます。\n\nゲーム「BORDER  BREAK」よりレジーナの陵辱イラストをお願いします。\n\n内容、構図\n・過去作のゼオラのイラストのようなI字バランスで拘束された状態での陵辱\n・衣装は資料URL１枚目のスタンダード版で袖を通しているジャケットは省略\n・服装は上はビキニがめくれてる程度で下は履いてはいるものの秘所が尻穴が見える程度のずらしまたは損傷(面倒であれば省略可）\n・背景は天井の照明に照らされた部屋と分かる程度の最小限の描写でOK\n\n希望差分\n・愛撫差分（手マン、後ろから尻穴を弄る描写　可能であれば胸揉みもしくは乳首弄り）\n・アソコと尻穴へのバイブ（手持ちもしくはピストンバイブ風の機械）挿入描写\n・何種類かの表情（睨み、目を閉じて堪える、目を見開いて喘ぎ、絶頂、ぐったり等）\n\n以上のものを手間と相談して可能な限りお願いします。\n\n愛撫や手持ちバイブによる竿役の描写は前腕辺りまでの最低限の描写でも構いません。\n\nいきなりで細かい要望が多くなってしまいましたが、ご検討のほどよろしくお願いします。\n\nhttps://twitter.com/notogoro/status/1318140918554218496", "nc": 169, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@takamichis112/works/17", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": true, "creator_id": 245, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/0df4cb71/uploads/origins/260abc90-bf23-499b-b17c-c8faffcb75dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57f8287a1776d9bcebc500744085701f", "srcset": "https://si.imgix.net/0df4cb71/uploads/origins/260abc90-bf23-499b-b17c-c8faffcb75dd?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=57f8287a1776d9bcebc500744085701f, https://si.imgix.net/0df4cb71/uploads/origins/260abc90-bf23-499b-b17c-c8faffcb75dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=4e7151efcfd830456a5e0681a55cbd3e 2x, https://si.imgix.net/0df4cb71/uploads/origins/260abc90-bf23-499b-b17c-c8faffcb75dd?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=8f1a990fac896273534a58aa525e9f98 3x"}, "duration": null, "nsfw": true, "hardcore": false, "consored_th