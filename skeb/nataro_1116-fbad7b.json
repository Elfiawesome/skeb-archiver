uration": null, "nsfw": true, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/894cd191/uploads/origins/7d1aac10-035c-446a-8b32-de6484233590?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ee8243a931ef85d25ff0d506ad86104", "srcset": "https://si.imgix.net/894cd191/uploads/origins/7d1aac10-035c-446a-8b32-de6484233590?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=9ee8243a931ef85d25ff0d506ad86104, https://si.imgix.net/894cd191/uploads/origins/7d1aac10-035c-446a-8b32-de6484233590?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=69a3d6742af51aae120b2182d3405879 2x, https://si.imgix.net/894cd191/uploads/origins/7d1aac10-035c-446a-8b32-de6484233590?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=8805f3c4a034a06090eda24fec84dd16 3x"}, "body": "艦これのFletcher(フレッチャー)に頭を撫でられながら膝枕で授乳手コキしてもらうところをお願いします。\n\nFletcherの表情は困り顔であやしているセリフを入れて欲しいです。\nセリフ例：「よしよし」「いいこいいこ」「しょうがないですねぇ」など\n上記の雰囲気に合っていれば、これ以外でも構いません。\n\n描きにくいところはアレンジしていただいても構いません。\n\n可能であれば、下記の差分を作成してほしいです。\n・射精\n・母乳の噴き出し\n・表情：母乳を吸われ感じている表情\n・表情：満足げな笑顔\n\n上記以外はお任せいたします。\n以上、よろしくお願いいたします。", "nc": 33, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@nataro_1116/works/16", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 322779, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/95749160/uploads/origins/d45f073d-ff13-4b8b-aa91-479938ba848f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1205000e2c9272bb8c82a8ff7bac9081", "srcset": "https://si.imgix.net/95749160/uploads/origins/d45f073d-ff13-4b8b-aa91-479938ba848f?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=1205000e2c9272bb8c82a8ff7bac9081, https://si.imgix.net/95749160/uploads/origins/d45f073d-ff13-4b8b-aa91-479938ba848f?bg=%23fff&au