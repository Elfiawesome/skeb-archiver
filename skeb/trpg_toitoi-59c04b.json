i.imgix.net/994c18b8/uploads/origins/5ede8482-c107-465e-8edd-7a50b421b877?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=c8cdf9ccf138cf64a20e955ad98af653 3x"}, "body": "こんにちは！\n私のキャラクターHanamar0uと彼女の友人Cristalyssが花畑にいるイラストを依頼したいです。\n\nシーンのアイデアはこんな感じです：\nCristalyssがHanamar0uの頭に新しく作った花冠を乗せる。\nHanamar0uは草原に座り、上着も着ず、満面の笑みを浮かべている。左腕に傷跡が見える。柔らかく、暖かく、平和な雰囲気だ。\n\nありがとうございました、これからもよろしくお願いします！\n\nhttps://drive.google.com/drive/folders/1T5pOI9UzFfPCLl_ntt17dQ7AeyOE2ian?usp=drive_link", "nc": 16, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@trpg_toitoi/works/7", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1407652, "client_id": 918596, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/dcfda111/uploads/origins/8d4feb44-8c99-4533-aa6f-5d917b08ab11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8aed9ef2361948cf52f4b81bd19e2b7a", "srcset": "https://si.imgix.net/dcfda111/uploads/origins/8d4feb44-8c99-4533-aa6f-5d917b08ab11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=8aed9ef2361948cf52f4b81bd19e2b7a, https://si.imgix.net/dcfda111/uploads/origins/8d4feb44-8c99-4533-aa6f-5d917b08ab11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=8b9d7b62004db4bba34d271944f6f0a0 2x, https://si.imgix.net/dcfda111/uploads/origins/8d4feb44-8c99-4533-aa6f-5d917b08ab11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=566c361f59c9d27666ab232fc5c8d936 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/dcfda111/uploads/origins/8d4feb44-8c99-4533-aa6f-5d917b08ab11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c611658f73a4dfe61ae9540abd19f8aa", "srcset": "https://si.imgix.net/dcfda111/uploads/origins/8d4feb44-8c99-4533-aa6f-5d917b08ab11?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=c611658f73a4dfe61ae9540abd19f8aa, https://si.imgix.net/dcfda111/uploads/origins/8d4feb44-8c99-4533-aa6f-5d917b08ab11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=35e05b0735e259442e1878ec19e51b73 2x, https://si.imgix.net/dcfda111/uploads/origins/8d4feb44-8c99-4533-aa6f-5d917b08ab11?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=1327ed61072780756ccca93a8fe1f610 3x"}, "body": "渡生つむぎ様\n\n前回はめちゃくちゃ可愛い最高のイラストありがとうございました！！\nすごく可愛いミニキャラまで…！！　大切に使用させていただいてます！！\nこの度、ぜひまた自キャラと相互フォロワーさんのキャラクターの一枚絵をお願いしたく、メッセージをお送りしました。\n\n使用用途は主に観賞用です。\nTwitter上で、つむぎ様のお名前を明記した上で掲載する可能性があります。\nまた、該当の相互フォロワーさんにはイラストデータを共有させていただきたいです。\n\nサイズ：2500pixel × 2500pixel 以上（縦長、横長、具体的なサイズなどは適宜お任せします）\n解像度：350dpi 以上\n\n▼女キャラクター（自キャラ）\n152㎝。15歳。お洒落や可愛いものが大好き。外の世界に憧れを抱いている。\n創作遊びが好きで、自分で物語を書いたり、服をデザインしたり、工作したりしている。将来は多分クリエイターかデザイナー。\n好奇心旺盛で夢見がちだが、頭の回転は速く博識。おじいちゃんがプレゼントしてくれた本を読むことが好き。\nイメージ：不思議の国のアリス\n\n▼男キャラクター（相互フォロワーさんのキャラ）\n170cm。16歳。明るく思ったことをハッキリと言う性格。\nやんちゃなわんこ系。ちょっとぶっきらぼう。かっこいいものが好き。\n面倒見のいいお兄ちゃんなところがあり世話焼きだが、相互さん曰く「デリカシーがない」そうです。\nイメージ：狩人、剣（お名前がラテン語の「剣」をもじったもの）\n\n▼キャラクターについて\n「My dear,“H”」のPC（女キャラ）とKPC（男キャラ）です。ケンカップル気味で、よく喧嘩に似たじゃれ合いをします。\n女キャラが少女漫画的シチュエーションを語る→男キャラ「は？お前そんなのが良いの？意味わかんねー」ときょとんとする→女キャラ「女心わかってなーい！」と怒る、というやり取りをよくします。\n男キャラは自分の気持ちに自覚あり、女キャラは自覚がない両片思い。現段階では淡い初恋ですが、そのうち付き合います。\n\nキャラクターの見た目は資料URLをご参照くださればと思います。\n（自キャラに関しては表情差分も入れました。参考までに…！）\n\nよろしければご検討くださいますと幸いです。\nご縁がありましたらどうぞよろしくお願いいたします…！\n\nhttps://drive.google.com/drive/folders/1zHxR0YBummeZV5EJHzeDX38YwTENs9k2?usp=sharing", "nc": 128, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@trpg_toitoi/works/6", "private_thumbnail_image_urls": null, "private": false, "genre": "art", "tipped": false, "creator_id": 1407652, "client_id": 1071076, "vtt_url": null, "thumbnail_image_urls": {"src": "https://si.imgix.net/1589b34e/uploads/origins/6a45f644-cdcc-483f-9dd3-92f542d24105?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7108e7dd1af31d33019d488916ae73c0", "srcset": "https://si.imgix.net/1589b34e/uploads/origins/6a45f644-cdcc-483f-9dd3-92f542d24105?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&s=7108e7dd1af31d33019d488916ae73c0, https://si.imgix.net/1589b34e/uploads/origins/6a45f644-cdcc-483f-9dd3-92f542d24105?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&s=c656f7c5ee0d03b86ec1cc3aaafa2224 2x, https://si.imgix.net/1589b34e/uploads/origins/6a45f644-cdcc-483f-9dd3-92f542d24105?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5f4c938be23e42f9e90560a90308c319 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/1589b34e/uploads/origins/6a45f644-cdcc-483f-9dd3-92f542d24105?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b744bd35bb70df2edc338c68cccb396a", "srcset": "https://si.imgix.net/1589b34e/uploads/origins/6a45f644-cdcc-483f-9dd3-92f542d24105?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=b744bd35bb70df2edc338c68cccb396a, https://si.imgix.net/1589b34e/uploads/origins/6a45f644-cdcc-483f-9dd3-92f542d24105?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=7617f6efff83e4f9c6887d29e74aab30 2x, https://si.imgix.net/1589b34e/uploads/origins/6a45f644-cdcc-483f-9dd3-92f542d24105?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=dd60edfbf616d02c43abec2f50a49e69 3x"}, "body": "渡生つむぎ様 \nいつも大変お世話になっております。 \n\n前回は素敵なイラストをありがとうございました。\nこの度も自探索者と相互さんの探索者のイラストをご依頼したく、メッセージをお送り致しました。\n\n■サイズ \nサイズはお任せします。 解像度は350dpi以上ですと嬉しいです。\n\n■用途 \nX（Twitter）上でつむぎ様のお名前を明記したうえで掲載させて頂く可能性があることと、 探索者のPLさんにはイラストをデータで共有させて頂きたいと思っております。\n\n■探索者について\n\n▽幼女(自探索者） \n名前:ルナリア\n130cmくらい/APP15\n白髪にインナーカラーは水色。瞳の色も水色です。\n典型的なおませさんです。ジャンカルロくんのことがとっても好きで、よくお嫁さんヅラをします。揶揄われて「あなたって人はー！」「デリカシーってものを知らないのかしら！？」といつもぷんぷんしています。\n\n▽男性\n名前:ジャンカルロ・デサンティス\n174cm/APP10\n表情の変化はあまりないですが、よくルナリアを揶揄ってくれます。ルナリアのわがままも (抱っこして！等)仕方ねえな……となんやかんで聞いてくれるらしいです。たまに微笑んでくれます。\n\n\n\n■概要\n「AE」というシナリオの神の子と誘拐犯です。\nおませなロリと寡黙なイタリア男で、大体ロリから矢印が向いています(ロリはよく頭を撫で回したり頬を揉んだりほっぺにキスしたりしますが、男性はされるがままでいてくれるようです)。\n\n\nシチュエーション等はお任せしますが、柔らかな雰囲気だと嬉しいです。描きやすいように描いていただけたらと思います。\n\nPCの見た目はURLをご参照ください。Googleドライブに資料を入れてあります。\n\n\nhttps://drive.google.com/drive/folders/1dO8DszuBoIaDPPbUjZ16--ACodTeeq7I?usp=sharing\n\nご縁がありましたらよろしくお願い申し上げます。\n\nつむぐ", "nc": 129, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@trpg_toitoi/works/5", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/47d8e446/uploads/origins/a88325ca-55fa-4d28-9d38-7110718e5521?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=497931385ac7254ca83cc6ba31feec45", "srcset": "https://si.imgix.net/47d8e446/uploads/origins/a88325ca-55fa-4d28-9d38-7110718e5521?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=497931385ac7254ca83cc6ba31feec45, https://si.imgix.net/47d8e446/uploads/origins/a88325ca-55fa-4d28-9d38-7110718e5521?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=01d8ed49b0ef533e29fa1be62dfc52ca 2x, https://si.imgix.net/47d8e446/uploads/origins/a88325ca-55fa-4d28-9d38-7110718e5521?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&px=200&txtfont=bold&txtshad=50&txtclr=FFFFFF&txtalign=middle%2Ccenter&txtsize=30&txt=PRIVATE&s=d2ebc5522f01ab00d0bf8e474f148930 3x"}, "private": true, "genre": "art", "tipped": true, "creator_id": 1407652, "client_id": 5