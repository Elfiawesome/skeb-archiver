な残酷さがあるようなイメージです\n\n二人が手を繋ぎ歩いているムービーをお願いできたらと思います。\nそれ以外でも是非朧様の作品を拝見して凄く作風が好ましかったのでお好きなように描いて頂けたらと思います。体格差、雰囲気の差がわかりやすいとより嬉しいです。(誇張した表現も可能です)\n\nもしよろしければご検討お願いいたします！\n\nhttps://drive.google.com/drive/u/0/folders/1WwejYUh_ddFnONCbSvte7A4sK43VJwua", "nc": 145, "word_count": 0, "transcoder": "video", "creator_acceptable_same_genre": true}], "sent_works": [], "similar_creators": [{"id": 514494, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "みくず", "screen_name": "gmkz_kawaii", "avatar_url": "https://pbs.twimg.com/profile_images/1936304795276787713/vnH5O-Jx.jpg", "header_url": "https://pbs.twimg.com/profile_banners/3238459595/1750446548/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 30, "complete_expiration_days": 60, "skills": [{"genre": "art"}], "nc": 32}, {"id": 1728641, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "むじ🔜UTFG", "screen_name": "mujimuji1010", "avatar_url": "https://pbs.twimg.com/profile_images/2012001653487255554/BmuY7az_.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1143875357675671552/1774090953/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_expiration_days": 3, "complete_expiration_days": 30, "skills": [{"genre": "art"}], "nc": 160}, {"id": 2377658, "creator": true, "nsfw_acceptable": true, "acceptable": true, "name": "なかむらあじの", "screen_name": "mmh444_nu", "avatar_url": "https://pbs.twimg.com/profile_images/1968886260656918528/cfZdWZeo.jpg", "header_url": "https://pbs.twimg.com/profile_banners/1038702996891160576/1689386994/1500x500", "appeal_receivable": false, "popular_creator_rank": null, "request_master_rank": null, "first_requester_rank": null, "deleted_at": null, "tip_acceptable_by": "all", "accept_