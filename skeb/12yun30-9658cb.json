2c2aef3fbfa5fbb3 2x, https://si.imgix.net/087a3307/uploads/origins/eb852789-a3ca-4bbc-8c45-8146e8476baf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&s=5e728f393778e993e8e0bb67f24ec95f 3x"}, "duration": null, "nsfw": false, "hardcore": false, "consored_thumbnail_image_urls": {"src": "https://si.imgix.net/087a3307/uploads/origins/eb852789-a3ca-4bbc-8c45-8146e8476baf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7e6b4220c0e108ce3d74eb0d5408053", "srcset": "https://si.imgix.net/087a3307/uploads/origins/eb852789-a3ca-4bbc-8c45-8146e8476baf?bg=%23fff&auto=format%2Ccompress&fm=webp&fit=crop&crop=top&w=200&h=200&blur=200&s=f7e6b4220c0e108ce3d74eb0d5408053, https://si.imgix.net/087a3307/uploads/origins/eb852789-a3ca-4bbc-8c45-8146e8476baf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=2&fit=crop&crop=top&w=200&h=200&blur=200&s=e1dadd85d41a24c1859f1a97d8f25a9f 2x, https://si.imgix.net/087a3307/uploads/origins/eb852789-a3ca-4bbc-8c45-8146e8476baf?bg=%23fff&auto=format%2Ccompress&fm=webp&dpr=3&fit=crop&crop=top&w=200&h=200&blur=200&s=aa591f931dd5379c64a827452e01b5c0 3x"}, "body": "再度ご依頼させて下さい。\n「天使たちの憂鬱」をSNSで拝見し作品の世界観に惹かれ、その他作品も拝見させて頂きました。\n描かれた人物の表情や雰囲気に魅了されyun様の描く絵を忘れる事が出来なくなりました。\n今回描いて頂ける可能性がある事を知りリクエストさせて頂きます。\n\n描いて頂きたいのは「ヴァンパイアの女性」です。\nコンセプトとしては「望まず手にしてしまった永遠の命。飢えに抗えない身体。抑えられない衝動の中、最愛の生命を奪ってしまった直後、高揚感から覚めつつも絶望的感に満ちていく瞬間」を描いて欲しいです\n\n性    別：女性\nその他：髪はロングで癖毛で無い方が好みです。                \n                またyun様の描く人物と指に惹かれます。\n                指先数本で唇に触れている感じでお願い出来たらと思います。\n                その他はお任せお願いしたいです。\n\n使用用途としては\n絵を部屋に飾りたいです。\nまた、宜しければ手持ちの財布とギターにプリントし使用させて頂ければと思います。\n勿論個人的な使用なので、他者に渡すことは絶対にありません。\n\nお願い出来れば幸いです。\n宜しくご検討お願い致します。", "nc": 0, "word_count": 0, "transcoder": "image", "creator_acceptable_same_genre": true}, {"path": "/@12yun30/works/11", "private_thumbnail_image_urls": {"src": "https://si.imgix.net/e820c7e8/uploads/origins/62a26e65-5c71-4f03-b7e3-ce58246d230f?bg=%23fff&auto=format%2Ccompress&fm=web